[; cx-stdlib/io — file and stream I/O. Bridges the streaming events
   API (spec/core/streaming.md).

   Full surface per spec/std-lib/io.md §3. Bodies forward to native
   primitives (vcx/code/stdlib_io.v) since filesystem effects are not
   expressible in pure CX. Tier-B, necessarily impure: every function is
   impure and every effect point is capability-gated (§7) — under the
   deny-by-default empty set each raises cx-err:CXER0271. close needs no
   capability. NOTE: this const and stdlib/io.cx are the same source —
   edit both. ]

[; §3.1 whole-file convenience ]
[?def read-file        scope=public impure [returns string]            ($path::string)                  [$io-read-file $path]]
[?def read-file-bytes  scope=public impure [returns bytes]             ($path::string)                  [$io-read-file-bytes $path]]
[?def read-file-lines  scope=public impure [returns [sequence string]] ($path::string)                  [$io-read-file-lines $path]]
[?def write-file       scope=public impure [returns null]              ($path::string $content::string) [$io-write-file $path $content]]
[?def write-file-bytes scope=public impure [returns null]              ($path::string $content::bytes)  [$io-write-file-bytes $path $content]]
[?def write-file-lines scope=public impure [returns null]              ($path::string $lines::[sequence string]) [$io-write-file-lines $path $lines]]
[?def edit-file        scope=public impure [returns null]              ($path::string $from::string $to::string) [$io-edit-file $path $from $to]]
[?def append-file      scope=public impure [returns null]              ($path::string $content::string) [$io-append-file $path $content]]
[?def append-file-bytes scope=public impure [returns null]             ($path::string $content::bytes)  [$io-append-file-bytes $path $content]]

[; §3.2 streaming handles ]
[?def open           scope=public impure [returns element] ($path::string $mode::string) [$io-open $path $mode]]
[?def open-with-opts scope=public impure [returns element] ($path::string $opts::map)    [$io-open-with-opts $path $opts]]
[?def close          scope=public impure [returns null]    ($handle::element)            [$io-close $handle]]

[; §3.3 stream operations ]
[?def read-bytes     scope=public impure [returns bytes]  ($handle::element $n::int)     [$io-read-bytes $handle $n]]
[?def read-line      scope=public impure [returns string] ($handle::element)             [$io-read-line $handle]]
[?def read-all       scope=public impure [returns string] ($handle::element)             [$io-read-all $handle]]
[?def read-all-bytes scope=public impure [returns bytes]  ($handle::element)             [$io-read-all-bytes $handle]]
[?def write-bytes    scope=public impure [returns null]   ($handle::element $b::bytes)   [$io-write-bytes $handle $b]]
[?def write-string   scope=public impure [returns null]   ($handle::element $s::string)  [$io-write-string $handle $s]]
[?def write-line     scope=public impure [returns null]   ($handle::element $s::string)  [$io-write-line $handle $s]]
[?def flush          scope=public impure [returns null]   ($handle::element)             [$io-flush $handle]]
[?def seek           scope=public impure [returns null]   ($handle::element $offset::int $whence::atom) [$io-seek $handle $offset $whence]]
[?def tell           scope=public impure [returns int]    ($handle::element)             [$io-tell $handle]]
[?def is-eof         scope=public impure [returns bool]   ($handle::element)             [$io-is-eof $handle]]

[; §3.4 lazy line iteration ]
[?def line-iter scope=public impure [returns [iterator string]] ($handle::element) [$io-line-iter $handle]]

[; §3.5 filesystem queries ]
[?def exists         scope=public impure [returns bool]     ($path::string) [$io-exists $path]]
[?def is-file        scope=public impure [returns bool]     ($path::string) [$io-is-file $path]]
[?def is-directory   scope=public impure [returns bool]     ($path::string) [$io-is-directory $path]]
[?def is-symlink     scope=public impure [returns bool]     ($path::string) [$io-is-symlink $path]]
[?def stat           scope=public impure [returns element]  ($path::string) [$io-stat $path]]
[?def size           scope=public impure [returns int]      ($path::string) [$io-size $path]]
[?def modified-time  scope=public impure [returns datetime] ($path::string) [$io-modified-time $path]]
[?def created-time   scope=public impure [returns datetime] ($path::string) [$io-created-time $path]]

[; §3.6 directory operations ]
[?def list-dir    scope=public impure [returns [sequence string]] ($path::string) [$io-list-dir $path]]
[?def make-dir    scope=public impure [returns null]   ($path::string)              [$io-make-dir $path]]
[?def make-dirs   scope=public impure [returns null]   ($path::string)              [$io-make-dirs $path]]
[?def remove      scope=public impure [returns null]   ($path::string)              [$io-remove $path]]
[?def remove-dir  scope=public impure [returns null]   ($path::string)              [$io-remove-dir $path]]
[?def remove-tree scope=public impure [returns null]   ($path::string)              [$io-remove-tree $path]]
[?def rename      scope=public impure [returns null]   ($from::string $to::string)  [$io-rename $from $to]]
[?def copy        scope=public impure [returns null]   ($from::string $to::string)  [$io-copy $from $to]]
[?def copy-tree   scope=public impure [returns null]   ($from::string $to::string)  [$io-copy-tree $from $to]]
[?def symlink     scope=public impure [returns null]   ($target::string $link::string) [$io-symlink $target $link]]
[?def readlink    scope=public impure [returns string] ($path::string)              [$io-readlink $path]]

[; §3.7 globbing ]
[?def glob      scope=public impure [returns [sequence string]]  ($pattern::string) [$io-glob $pattern]]
[?def glob-iter scope=public impure [returns [iterator string]]  ($pattern::string) [$io-glob-iter $pattern]]
[?def walk      scope=public impure [returns [iterator element]] ($root::string)    [$io-walk $root]]

[; §3.8 tempfile ]
[?def temp-file       scope=public impure [returns element] ($prefix::string $suffix::string) [$io-temp-file $prefix $suffix]]
[?def temp-dir        scope=public impure [returns string]  ($prefix::string)                 [$io-temp-dir $prefix]]
[?def system-temp-dir scope=public impure [returns string]  ()                                [$io-system-temp-dir]]

[; §3.9 file locking ]
[?def lock   scope=public impure [returns element] ($handle::element $kind::atom) [$io-lock $handle $kind]]
[?def unlock scope=public impure [returns null]    ($handle::element)             [$io-unlock $handle]]

[; §3.10 continuous filesystem watch (#128-B) — a recursive, real OS watch
   (inotify / FSEvents). watch-next BLOCKS until the next change; with an
   optional timeout (ms) it returns absence on expiry. An [change op=overflow]
   means the OS dropped events under load — rescan the tree. watch-close
   unblocks a parked watch-next. ]
[?def watch       scope=public impure [returns element] ($path::string)                   [$io-watch $path]]
[?def watch-next  scope=public impure [returns element] ($handle::element $timeout::int -1) [$io-watch-next $handle $timeout]]
[?def watch-close scope=public impure [returns null]    ($handle::element)                 [$io-watch-close $handle]]

[; co-located docs (seeded — refine in place). ]
[module-doc name=io
  [scope """File and stream I/O — whole-file reads and writes, streaming handles, line iteration, filesystem queries, directory operations, globbing, tempfiles, and advisory file locking. Whole-file operations materialize content in memory; streaming handles and lazy iterators process arbitrary-size inputs with bounded memory. Path arguments resolve via cx-stdlib/path. Every function is impure and capability-gated: read or write access is checked at the effect point and denied by default."""]]
[fn-doc name=read-file scope=public purity=impure
  [sig """-> string"""]
  [summary """Read an entire file as a UTF-8 string; raises on invalid UTF-8."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-file "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=read-file-bytes scope=public purity=impure
  [sig """-> bytes"""]
  [summary """Read an entire file as raw bytes, with no encoding check."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-file-bytes "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=read-file-lines scope=public purity=impure
  [sig """-> [sequence string]"""]
  [summary """Read an entire file as a sequence of lines."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-file-lines "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=write-file scope=public purity=impure
  [sig """-> null"""]
  [summary """Create or truncate a file and write a string; atomic via tempfile rename on POSIX."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:write-file "/tmp/out.txt" "hello"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=edit-file scope=public purity=impure
  [sig """-> null"""]
  [summary """Surgical in-place file edit: read, replace `from` with `to` (it MUST occur exactly once, else [err cx-err:CXER2903] and no write), and write back. The in-CX equivalent of the harness Edit tool — needs both read and write capabilities."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:edit-file "/tmp/out.txt" "old" "new"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=write-file-bytes scope=public purity=impure
  [sig """-> null"""]
  [summary """Create or truncate a file and write raw bytes."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/io']
[$io:write-file-bytes "/tmp/out.bin" [$bytes:from-string-utf8 "hi"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=write-file-lines scope=public purity=impure
  [sig """-> null"""]
  [summary """Create or truncate a file and write a sequence of lines."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:write-file-lines "/tmp/out.txt" ("a", "b", "c")]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=append-file scope=public purity=impure
  [sig """-> null"""]
  [summary """Append a string to a file, creating it if absent."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:append-file "/tmp/out.txt" "more"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=append-file-bytes scope=public purity=impure
  [sig """-> null"""]
  [summary """Append raw bytes to a file, creating it if absent."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/io']
[$io:append-file-bytes "/tmp/out.bin" [$bytes:from-string-utf8 "more"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=open scope=public purity=impure
  [sig """-> element"""]
  [summary """Open a file in the given mode and return a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:open "/var/log/app.log" "r"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=open-with-opts scope=public purity=impure
  [sig """-> element"""]
  [summary """Open a file with an options map (mode, encoding, buffer size, line terminator, atomic) and return a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:open-with-opts "/tmp/out.txt" [map mode="w" atomic=true]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=close scope=public purity=impure
  [sig """-> null"""]
  [summary """Close a file handle; idempotent, so closing twice is safe."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:close [$io:open "/var/log/app.log" "r"]]"""] [expect """[granted-harness: open a real handle then close releases it]"""]]
]
[fn-doc name=read-bytes scope=public purity=impure
  [sig """-> bytes"""]
  [summary """Read up to n bytes from a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-bytes [$io:open "/var/log/app.log" "r"] 16]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=read-line scope=public purity=impure
  [sig """-> string"""]
  [summary """Read one line from a stream handle, up to the line terminator; returns empty at EOF."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-line [$io:open "/var/log/app.log" "r"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=read-all scope=public purity=impure
  [sig """-> string"""]
  [summary """Read the remaining stream content as a string."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-all [$io:open "/var/log/app.log" "r"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=read-all-bytes scope=public purity=impure
  [sig """-> bytes"""]
  [summary """Read the remaining stream content as raw bytes."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:read-all-bytes [$io:open "/var/log/app.log" "r"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=write-bytes scope=public purity=impure
  [sig """-> null"""]
  [summary """Write raw bytes to a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:write-bytes [$io:open "/tmp/out.bin" "w"] [$bytes:from-string "hi"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=write-string scope=public purity=impure
  [sig """-> null"""]
  [summary """Write a string to a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:write-string [$io:open "/tmp/out.txt" "w"] "hi"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=write-line scope=public purity=impure
  [sig """-> null"""]
  [summary """Write a string followed by a line terminator to a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:write-line [$io:open "/tmp/out.txt" "w"] "hi"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=flush scope=public purity=impure
  [sig """-> null"""]
  [summary """Flush buffered writes on a stream handle to the underlying file."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:flush [$io:open "/tmp/out.txt" "w"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=seek scope=public purity=impure
  [sig """-> null"""]
  [summary """Move the stream position to an offset relative to start, current, or end."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:seek [$io:open "/var/log/app.log" "r"] 0 :start]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=tell scope=public purity=impure
  [sig """-> int"""]
  [summary """Report the current byte offset of a stream handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:tell [$io:open "/var/log/app.log" "r"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=is-eof scope=public purity=impure
  [sig """-> bool"""]
  [summary """Report whether a stream handle has reached end of file."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:is-eof [$io:open "/var/log/app.log" "r"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=line-iter scope=public purity=impure
  [sig """-> [iterator string]"""]
  [summary """Return a lazy, memory-bounded iterator over a handle's lines; closes the handle on exhaustion."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:line-iter [$io:open "/var/log/app.log" "r"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=exists scope=public purity=impure
  [sig """-> bool"""]
  [summary """Report whether a path exists."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:exists "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=is-file scope=public purity=impure
  [sig """-> bool"""]
  [summary """Report whether a path is a regular file."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:is-file "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=is-directory scope=public purity=impure
  [sig """-> bool"""]
  [summary """Report whether a path is a directory."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:is-directory "/var/log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=is-symlink scope=public purity=impure
  [sig """-> bool"""]
  [summary """Report whether a path is a symbolic link, without following it."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:is-symlink "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=stat scope=public purity=impure
  [sig """-> element"""]
  [summary """Return a structured element of a path's size, type, timestamps, permissions, and ownership."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:stat "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=size scope=public purity=impure
  [sig """-> int"""]
  [summary """Return a file's size in bytes."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:size "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=modified-time scope=public purity=impure
  [sig """-> datetime"""]
  [summary """Return a path's last-modified timestamp."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:modified-time "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=created-time scope=public purity=impure
  [sig """-> datetime"""]
  [summary """Return a path's creation timestamp."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:created-time "/var/log/app.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=list-dir scope=public purity=impure
  [sig """-> [sequence string]"""]
  [summary """List the entries of a directory."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:list-dir "/var/log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=make-dir scope=public purity=impure
  [sig """-> null"""]
  [summary """Create a single directory."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:make-dir "/tmp/newdir"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=make-dirs scope=public purity=impure
  [sig """-> null"""]
  [summary """Create a directory and any missing intermediate directories."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:make-dirs "/tmp/a/b/c"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=remove scope=public purity=impure
  [sig """-> null"""]
  [summary """Remove a single file."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:remove "/tmp/out.txt"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=remove-dir scope=public purity=impure
  [sig """-> null"""]
  [summary """Remove an empty directory."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:remove-dir "/tmp/newdir"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=remove-tree scope=public purity=impure
  [sig """-> null"""]
  [summary """Recursively delete a directory tree without following symlinks; refuses to delete a filesystem root."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:remove-tree "/tmp/a"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=rename scope=public purity=impure
  [sig """-> null"""]
  [summary """Rename or move a path from one location to another."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:rename "/tmp/a.txt" "/tmp/b.txt"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=copy scope=public purity=impure
  [sig """-> null"""]
  [summary """Copy a single file to a destination path."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:copy "/tmp/a.txt" "/tmp/b.txt"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=copy-tree scope=public purity=impure
  [sig """-> null"""]
  [summary """Recursively copy a directory tree to a destination path."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:copy-tree "/tmp/a" "/tmp/b"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=symlink scope=public purity=impure
  [sig """-> null"""]
  [summary """Create a symbolic link pointing at a target."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:symlink "/tmp/target" "/tmp/link"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=readlink scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the target a symbolic link points to."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:readlink "/tmp/link"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=glob scope=public purity=impure
  [sig """-> [sequence string]"""]
  [summary """Eagerly return all paths matching a glob pattern."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:glob "/var/log/*.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=glob-iter scope=public purity=impure
  [sig """-> [iterator string]"""]
  [summary """Lazily yield paths matching a glob pattern on demand."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:glob-iter "/var/log/*.log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=walk scope=public purity=impure
  [sig """-> [iterator element]"""]
  [summary """Lazily yield one dir-entry element per filesystem entry in recursive traversal order."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:walk "/var/log"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=temp-file scope=public purity=impure
  [sig """-> element"""]
  [summary """Create a fresh open temp file handle that auto-deletes on close."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:temp-file "pre" ".txt"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=temp-dir scope=public purity=impure
  [sig """-> string"""]
  [summary """Create a fresh empty temp directory and return its path; the caller cleans it up."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:temp-dir "pre"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=system-temp-dir scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the operating system's temp directory path."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:system-temp-dir]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=lock scope=public purity=impure
  [sig """-> element"""]
  [summary """Acquire a shared or exclusive advisory lock on a file handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:lock [$io:open "/tmp/out.txt" "w"] :exclusive]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=unlock scope=public purity=impure
  [sig """-> null"""]
  [summary """Release a lock held on a file handle."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:unlock [$io:open "/tmp/out.txt" "w"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=watch scope=public purity=impure
  [sig """-> element"""]
  [summary """Start a recursive OS filesystem watch (inotify / FSEvents) on a directory and return a watch handle. Real continuous notification, not polling."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:watch "/tmp/project"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=watch-next scope=public purity=impure
  [sig """-> element"""]
  [summary """Block until the next change under a watch handle and return [change path=… op=created|modified|deleted]. With an optional timeout (ms) returns absence on expiry. An [change op=overflow] means the OS dropped events under load — rescan the tree."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:watch-next [$io:watch "/tmp/project"] 1000]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=watch-close scope=public purity=impure
  [sig """-> null"""]
  [summary """Tear down a watch handle and unblock any watch-next currently parked on it. Idempotent."""]
  [example [code """[?lib 'cx-stdlib/io']
[$io:watch-close [$io:watch "/tmp/project"]]"""] [expect """cx-err:CXER0271"""]]
]
