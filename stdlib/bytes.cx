[- cx-stdlib/bytes — byte-level operations on the CXDM bytes scalar
   kind (spec/stdlib_bytes.md).

   Bodies bottom out in native bytes-* primitives (vcx/code/stdlib_bytes.v).
   The primitive names are bytes-prefixed so they never collide with the
   language-core builtin set (length / slice / head / concat / find / etc.). -]

[- §3.1 inspection -]
[?def length               scope=public pure [returns int]   ($b::bytes)                [$bytes-length $b]]
[?def at                   scope=public pure [returns int]   ($b::bytes $i::int)         [$bytes-at $b $i]]
[?def is-empty             scope=public pure [returns bool]  ($b::bytes)                [$bytes-is-empty $b]]
[?def equals               scope=public pure [returns bool]  ($a::bytes $b::bytes)       [$bytes-equals $a $b]]
[?def constant-time-equals scope=public pure [returns bool]  ($a::bytes $b::bytes)       [$bytes-ct-equals $a $b]]

[- §3.2 slicing + search -]
[?def slice        scope=public pure [returns bytes] ($b::bytes $start::int $end::int)        [$bytes-slice $b $start $end]]
[?def head         scope=public pure [returns bytes] ($b::bytes $n::int)                     [$bytes-head $b $n]]
[?def tail         scope=public pure [returns bytes] ($b::bytes $n::int)                     [$bytes-tail $b $n]]
[?def concat       scope=public pure [returns bytes] ($parts::[sequence bytes])             [$bytes-concat $parts]]
[?def repeat       scope=public pure [returns bytes] ($b::bytes $n::int)                     [$bytes-repeat $b $n]]
[?def find         scope=public pure [returns int]   ($haystack::bytes $needle::bytes)       [$bytes-find $haystack $needle]]
[?def contains     scope=public pure [returns bool]  ($haystack::bytes $needle::bytes)       [$bytes-contains $haystack $needle]]
[?def starts-with  scope=public pure [returns bool]  ($b::bytes $prefix::bytes)              [$bytes-starts-with $b $prefix]]
[?def ends-with    scope=public pure [returns bool]  ($b::bytes $suffix::bytes)              [$bytes-ends-with $b $suffix]]
[?def split        scope=public pure [returns [sequence bytes]] ($b::bytes $sep::bytes)      [$bytes-split $b $sep]]

[- §3.3 hex -]
[?def to-hex       scope=public pure [returns string] ($b::bytes)                         [$bytes-to-hex $b]]
[?def from-hex     scope=public pure [returns bytes]  ($s::string)                        [$bytes-from-hex $s]]
[?def to-hex-upper scope=public pure [returns string] ($b::bytes)                         [$bytes-to-hex-upper $b]]

[- §3.4 base64 -]
[?def to-base64       scope=public pure [returns string] ($b::bytes)                       [$bytes-to-base64 $b]]
[?def to-base64-url   scope=public pure [returns string] ($b::bytes)                       [$bytes-to-base64-url $b]]
[?def from-base64     scope=public pure [returns bytes]  ($s::string)                      [$bytes-from-base64 $s]]
[?def from-base64-url scope=public pure [returns bytes]  ($s::string)                      [$bytes-from-base64-url $s]]

[- §3.5 base32 -]
[?def to-base32   scope=public pure [returns string] ($b::bytes)                           [$bytes-to-base32 $b]]
[?def from-base32 scope=public pure [returns bytes]  ($s::string)                          [$bytes-from-base32 $s]]

[- §3.5.1 base58btc (Bitcoin alphabet) — multibase 'z' payload for did:key -]
[?def to-base58   scope=public pure [returns string] ($b::bytes)                           [$bytes-to-base58 $b]]
[?def from-base58 scope=public pure [returns bytes]  ($s::string)                          [$bytes-from-base58 $s]]

[- §3.6 compression -]
[?def gzip-compress            scope=public pure [returns bytes] ($input::bytes)             [$bytes-gzip-compress $input]]
[?def gzip-decompress          scope=public pure [returns bytes] ($input::bytes)             [$bytes-gzip-decompress $input]]
[?def zstd-compress            scope=public pure [returns bytes] ($input::bytes)             [$bytes-zstd-compress $input]]
[?def zstd-decompress          scope=public pure [returns bytes] ($input::bytes)             [$bytes-zstd-decompress $input]]
[?def zstd-compress-with-level scope=public pure [returns bytes] ($input::bytes $level::int)  [$bytes-zstd-compress-level $input $level]]

[- §3.7 binary packing -]
[?def pack   scope=public pure [returns bytes]          ($format::string $values::[sequence any]) [$bytes-pack $format $values]]
[?def unpack scope=public pure [returns [sequence any]] ($format::string $b::bytes)               [$bytes-unpack $format $b]]

[- §3.8 string conversion -]
[?def from-string-utf8     scope=public pure [returns bytes]  ($s::string)                 [$bytes-from-string-utf8 $s]]
[?def to-string-utf8       scope=public pure [returns string] ($b::bytes)                  [$bytes-to-string-utf8 $b]]
[?def to-string-utf8-lossy scope=public pure [returns string] ($b::bytes)                  [$bytes-to-string-utf8-lossy $b]]
[?def from-string-latin1   scope=public pure [returns bytes]  ($s::string)                 [$bytes-from-string-latin1 $s]]
[?def to-string-latin1     scope=public pure [returns string] ($b::bytes)                  [$bytes-to-string-latin1 $b]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=bytes
  [scope """Byte-level operations on the CX bytes scalar kind. Covers inspection and slicing, search, hex/base64/base32 encoding, gzip and zstd compression, fixed-width binary pack and unpack, and UTF-8/Latin-1 string conversion. All operations are pure with no I/O, and every result is a new immutable bytes value. For file and stream I/O see cx-stdlib/io."""]]
[fn-doc name=length scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the number of bytes in a bytes value."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:length [$bytes:from-hex "deadbeef"]]"""] [expect """4"""]]
]
[fn-doc name=at scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the byte value 0-255 at an index; raises if out of bounds."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:at [$bytes:from-string-utf8 "ABC"] 0]"""] [expect """65"""]]
]
[fn-doc name=is-empty scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a bytes value has zero length."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:is-empty [$bytes:from-hex ""]]"""] [expect """true"""]]
]
[fn-doc name=equals scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether two bytes values are byte-for-byte equal."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:equals [$bytes:from-hex "00ff"] [$bytes:from-hex "00ff"]]"""] [expect """true"""]]
]
[fn-doc name=constant-time-equals scope=public purity=pure
  [sig """-> bool"""]
  [summary """Compare two bytes values for equality in constant time, resistant to timing attacks."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:constant-time-equals [$bytes:from-hex "abcd"] [$bytes:from-hex "abcd"]]"""] [expect """true"""]]
]
[fn-doc name=slice scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Extract a half-open byte range; bounds clamp and negative indices count from the end."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:slice [$bytes:from-hex "00112233"] 1 3]]"""] [expect """'1122'"""]]
]
[fn-doc name=head scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Return the first n bytes."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:head [$bytes:from-hex "00112233"] 2]]"""] [expect """'0011'"""]]
]
[fn-doc name=tail scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Return the last n bytes."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:tail [$bytes:from-hex "00112233"] 2]]"""] [expect """'2233'"""]]
]
[fn-doc name=concat scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Concatenate a sequence of bytes values into one; raises if the result exceeds the length ceiling."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:concat ([$bytes:from-hex "0011"], [$bytes:from-hex "2233"])]]"""] [expect """'00112233'"""]]
]
[fn-doc name=repeat scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Concatenate n copies of a bytes value; raises if the result exceeds the length ceiling."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:repeat [$bytes:from-hex "ab"] 3]]"""] [expect """'ababab'"""]]
]
[fn-doc name=find scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the index of the first occurrence of a needle in the haystack, or -1 if absent."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:find [$bytes:from-string-utf8 "hello world"] [$bytes:from-string-utf8 "hello"]]"""] [expect """0"""]]
]
[fn-doc name=contains scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether the haystack contains the needle."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:contains [$bytes:from-string-utf8 "hello world"] [$bytes:from-string-utf8 "o w"]]"""] [expect """true"""]]
]
[fn-doc name=starts-with scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a bytes value begins with the given prefix."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:starts-with [$bytes:from-string-utf8 "hello"] [$bytes:from-string-utf8 "he"]]"""] [expect """true"""]]
]
[fn-doc name=ends-with scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a bytes value ends with the given suffix."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:ends-with [$bytes:from-string-utf8 "hello"] [$bytes:from-string-utf8 "lo"]]"""] [expect """true"""]]
]
[fn-doc name=split scope=public purity=pure
  [sig """-> [sequence bytes]"""]
  [summary """Split a bytes value on each occurrence of a separator."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$nth [$bytes:split [$bytes:from-string-utf8 "a,b,c"] [$bytes:from-string-utf8 ","]] 3]]"""] [expect """'c'"""]]
]
[fn-doc name=to-hex scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode bytes as a lowercase hexadecimal string."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:from-hex "deadbeef"]]"""] [expect """'deadbeef'"""]]
]
[fn-doc name=from-hex scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decode a hexadecimal string (either case) to bytes; raises on non-hex input."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:from-hex "deadbeef"]]"""] [expect """'deadbeef'"""]]
]
[fn-doc name=to-hex-upper scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode bytes as an uppercase hexadecimal string."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex-upper [$bytes:from-hex "deadbeef"]]"""] [expect """'DEADBEEF'"""]]
]
[fn-doc name=to-base64 scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode bytes as standard padded RFC 4648 base64."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:from-base64 [$bytes:to-base64 [$bytes:from-string-utf8 "hello"]]]]"""] [expect """'hello'"""]]
]
[fn-doc name=to-base64-url scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode bytes as URL-safe unpadded RFC 4648 base64."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-base64-url [$bytes:from-string-utf8 "hi"]]"""] [expect """'aGk'"""]]
]
[fn-doc name=from-base64 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decode a standard base64 string to bytes, tolerating padded or unpadded input; raises on malformed input."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:from-base64 [$bytes:to-base64 [$bytes:from-string-utf8 "hello"]]]]"""] [expect """'hello'"""]]
]
[fn-doc name=from-base64-url scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decode a URL-safe base64 string to bytes, tolerating padded or unpadded input; raises on malformed input."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:from-base64-url [$bytes:to-base64-url [$bytes:from-string-utf8 "hello"]]]]"""] [expect """'hello'"""]]
]
[fn-doc name=to-base32 scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode bytes as uppercase padded RFC 4648 base32."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:from-base32 [$bytes:to-base32 [$bytes:from-string-utf8 "hello"]]]]"""] [expect """'hello'"""]]
]
[fn-doc name=from-base32 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decode an RFC 4648 base32 string to bytes."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:from-base32 [$bytes:to-base32 [$bytes:from-string-utf8 "hello"]]]]"""] [expect """'hello'"""]]
]
[fn-doc name=to-base58 scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode bytes as a base58btc string (Bitcoin alphabet), the multibase 'z' payload used for did:key."""]
]
[fn-doc name=from-base58 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decode a base58btc string (Bitcoin alphabet) to bytes; raises on characters outside the alphabet."""]
]
[fn-doc name=gzip-compress scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compress bytes into a gzip frame (RFC 1952, default level 6)."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:length [$bytes:gzip-decompress [$bytes:gzip-compress [$bytes:from-hex ""]]]]"""] [expect """0"""]]
]
[fn-doc name=gzip-decompress scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decompress a gzip frame back to bytes; raises on malformed input."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:length [$bytes:gzip-decompress [$bytes:gzip-compress [$bytes:from-hex ""]]]]"""] [expect """0"""]]
]
[fn-doc name=zstd-compress scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compress bytes with zstd (RFC 8478, default level 3)."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:zstd-decompress [$bytes:zstd-compress [$bytes:from-string-utf8 "hello world"]]]]"""] [expect """'hello world'"""]]
]
[fn-doc name=zstd-decompress scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Decompress zstd-compressed bytes; raises on malformed input."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:zstd-decompress [$bytes:zstd-compress [$bytes:from-string-utf8 "hello world"]]]]"""] [expect """'hello world'"""]]
]
[fn-doc name=zstd-compress-with-level scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compress bytes with zstd at an explicit level from 1 to 22."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$bytes:zstd-decompress [$bytes:zstd-compress-with-level [$bytes:from-string-utf8 "hello world"] 22]]]"""] [expect """'hello world'"""]]
]
[fn-doc name=pack scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Pack values into bytes per a struct-style format string."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$nth [$bytes:unpack "<I" [$bytes:pack "<I" (1234)]] 1]"""] [expect """1234"""]]
]
[fn-doc name=unpack scope=public purity=pure
  [sig """-> [sequence any]"""]
  [summary """Unpack bytes into a sequence of values per a struct-style format string."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$nth [$bytes:unpack "<I" [$bytes:pack "<I" (1234)]] 1]"""] [expect """1234"""]]
]
[fn-doc name=from-string-utf8 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Encode a string to its UTF-8 byte representation."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:from-string-utf8 "abc"]]"""] [expect """'616263'"""]]
]
[fn-doc name=to-string-utf8 scope=public purity=pure
  [sig """-> string"""]
  [summary """Decode bytes as a UTF-8 string; raises on invalid UTF-8."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$nth [$bytes:split [$bytes:from-string-utf8 "a,b,c"] [$bytes:from-string-utf8 ","]] 3]]"""] [expect """'c'"""]]
]
[fn-doc name=to-string-utf8-lossy scope=public purity=pure
  [sig """-> string"""]
  [summary """Decode bytes as UTF-8, replacing each invalid run with U+FFFD; never raises."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:length [$bytes:from-string-utf8 [$bytes:to-string-utf8-lossy [$bytes:from-hex "ff"]]]]"""] [expect """3"""]]
]
[fn-doc name=from-string-latin1 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Encode a string to Latin-1 bytes for byte-clean round-trips."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:from-string-latin1 [$bytes:to-string-latin1 [$bytes:from-hex "00ff80"]]]]"""] [expect """'00ff80'"""]]
]
[fn-doc name=to-string-latin1 scope=public purity=pure
  [sig """-> string"""]
  [summary """Decode bytes as Latin-1, preserving every byte."""]
  [example [code """[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:from-string-latin1 [$bytes:to-string-latin1 [$bytes:from-hex "00ff80"]]]]"""] [expect """'00ff80'"""]]
]
