[- cx-stdlib/email — RFC 5322 + MIME multipart message parser and builder.

   Full v0.8.0 public surface per spec/std-lib/email.md §3. Bodies forward to
   native primitives (vcx/code/stdlib_email.v): RFC 5322 header unfolding,
   RFC 2047 encoded-word decode/encode, RFC 2046 multipart tree extraction,
   quoted-printable + base64 body decoding, RFC 5322 address-list (incl. group)
   parsing, RFC 5322 Date parsing, and RFC 3464 DSN lifting are not expressible
   in pure CX. parse / build / build-multipart / reply / forward return a
   [message …] element; emit returns bytes; the typed accessors reduce to
   string / bool / datetime / element / sequence. Errors are values
   (CXER1300..CXER1306, §6).

   NOTE: this const and stdlib/email.cx are the same source — edit both. -]

[- §3.1 parse and emit -]
[?def parse scope=public pure [returns element] ($bytes::bytes)  [$email-parse $bytes]]
[?def emit  scope=public pure [returns bytes]   ($msg::element)   [$email-emit $msg]]

[- §3.2 header inspection -]
[?def headers       scope=public pure [returns map]               ($msg::element)                [$email-headers $msg]]
[?def header        scope=public pure [returns string]            ($msg::element $name::string)   [$email-header $msg $name]]
[?def header-values scope=public pure [returns [sequence string]] ($msg::element $name::string)   [$email-header-values $msg $name]]

[- §3.2 typed accessors -]
[?def subject          scope=public pure [returns string]             ($msg::element) [$email-subject $msg]]
[?def from-addr        scope=public pure [returns element]            ($msg::element) [$email-from-addr $msg]]
[?def to-addrs         scope=public pure [returns [sequence element]] ($msg::element) [$email-to-addrs $msg]]
[?def cc-addrs         scope=public pure [returns [sequence element]] ($msg::element) [$email-cc-addrs $msg]]
[?def bcc-addrs        scope=public pure [returns [sequence element]] ($msg::element) [$email-bcc-addrs $msg]]
[?def date-header      scope=public pure [returns datetime]          ($msg::element) [$email-date-header $msg]]
[?def message-id       scope=public pure [returns string]            ($msg::element) [$email-message-id $msg]]
[?def in-reply-to      scope=public pure [returns string]            ($msg::element) [$email-in-reply-to $msg]]
[?def references       scope=public pure [returns [sequence string]] ($msg::element) [$email-references $msg]]
[?def list-unsubscribe scope=public pure [returns [sequence string]] ($msg::element) [$email-list-unsubscribe $msg]]

[- §3.3 body navigation -]
[?def parts        scope=public pure [returns [sequence element]] ($msg::element) [$email-parts $msg]]
[?def attachments  scope=public pure [returns [sequence element]] ($msg::element) [$email-attachments $msg]]
[?def text-body    scope=public pure [returns string]             ($msg::element) [$email-text-body $msg]]
[?def html-body    scope=public pure [returns string]             ($msg::element) [$email-html-body $msg]]
[?def is-multipart scope=public pure [returns bool]               ($msg::element) [$email-is-multipart $msg]]

[- §3.4 encoding helpers -]
[?def decode-encoded-word scope=public pure [returns string] ($s::string)                                  [$email-decode-encoded-word $s]]
[?def encode-encoded-word scope=public pure [returns string] ($s::string $charset::string $encoding::string) [$email-encode-encoded-word $s $charset $encoding]]

[- §3.5 address parsing and formatting -]
[?def parse-address       scope=public pure [returns element]            ($s::string)                  [$email-parse-address $s]]
[?def parse-address-list  scope=public pure [returns [sequence element]] ($s::string)                  [$email-parse-address-list $s]]
[?def format-address      scope=public pure [returns string]             ($addr::element)              [$email-format-address $addr]]
[?def format-address-list scope=public pure [returns string]             ($addrs::[sequence element])  [$email-format-address-list $addrs]]

[- §3.6 outgoing-message builder -]
[?def build           scope=public pure [returns element] ($parts::map)                                  [$email-build $parts]]
[?def build-multipart scope=public pure [returns element] ($parts::map $alternatives::[sequence element]) [$email-build-multipart $parts $alternatives]]

[- §3.7 reply and forward -]
[?def reply   scope=public pure [returns element] ($orig::element $parts::map) [$email-reply $orig $parts]]
[?def forward scope=public pure [returns element] ($orig::element $parts::map) [$email-forward $orig $parts]]

[- §3.8 delivery-status notifications -]
[?def parse-dsn       scope=public pure [returns element] ($msg::element)   [$email-parse-dsn $msg]]
[?def parse-dsn-bytes scope=public pure [returns element] ($bytes::bytes)   [$email-parse-dsn-bytes $bytes]]
[?def is-bounce       scope=public pure [returns bool]    ($dsn::element)   [$email-is-bounce $dsn]]
[?def is-hard-bounce  scope=public pure [returns bool]    ($dsn::element)   [$email-is-hard-bounce $dsn]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=email
  [scope """Parse and build RFC 5322 + MIME multipart email messages.

   The surface covers parsing inbound messages, inspecting headers and bodies, extracting attachments, decoding encoded-words and address lists, and building outgoing messages with text + HTML alternatives and attachments. Delivery-status (bounce) reports are lifted into structured form. Transport is out of scope — send/receive lives at the directive layer; this module is the data layer those transports produce or consume."""]]
[fn-doc name=parse scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse RFC 5322 bytes into a [message] element, decoding headers, bodies, and the multipart tree."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nTo: c@d.com\r\nSubject: Hi\r\n\r\nHello body\r\n"]]]
  [$email:is-multipart $msg]]"""] [expect """false"""]]
]
[fn-doc name=emit scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Re-encode a [message] element to canonical RFC 5322 bytes; same input emits byte-identical output."""]
  [example [code """[?lib 'cx-stdlib/email']
[?let [= $msg [$email:build {"from": "agent@example.com",
                            "to": "customer@example.com",
                            "subject": "Re: Invoice question",
                            "body": "Thank you for reaching out..."}]]
  [$email:subject [$email:parse [$email:emit $msg]]]]"""] [expect """'Re: Invoice question'"""]]
]
[fn-doc name=headers scope=public purity=pure
  [sig """-> map"""]
  [summary """Return all headers as a map of lowercased name to a [sequence string] of values."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nSubject: Hi\r\n\r\nbody"]]]
  [$count [$email:headers $msg]]]"""] [expect """2"""]]
]
[fn-doc name=header scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the first value of the named header (case-insensitive), or empty string if absent."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nSubject: Hi\r\n\r\nbody"]]]
  [$email:header $msg "subject"]]"""] [expect """'Hi'"""]]
]
[fn-doc name=header-values scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Return every value of the named header (case-insensitive), for multi-instance headers like Received."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Received: from a\r\nReceived: from b\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:header-values $msg "Received"]]"""] [expect """('from a', 'from b')"""]]
]
[fn-doc name=subject scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the Subject header with encoded-words decoded to UTF-8."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $crlf [$email:parse [$bytes:from-string-utf8 "Subject: Hi\r\n\r\nbody"]]]
  [?let [= $lf [$email:parse [$bytes:from-string-utf8 "Subject: Hi\n\nbody"]]]
    [$eq [$email:subject $crlf] [$email:subject $lf]]]]"""] [expect """true"""]]
]
[fn-doc name=from-addr scope=public purity=pure
  [sig """-> element"""]
  [summary """Return the first From address as an [address] element."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: John Doe <john@example.com>\r\n\r\nbody"]]]
  [$email:format-address [$email:from-addr $msg]]]"""] [expect """'John Doe <john@example.com>'"""]]
]
[fn-doc name=to-addrs scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Return all To addresses, expanding any RFC 5322 groups."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "To: a@x.com, b@x.com\r\nFrom: c@y.com\r\n\r\nbody"]]]
  [$count [$email:to-addrs $msg]]]"""] [expect """2"""]]
]
[fn-doc name=cc-addrs scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Return all Cc addresses, expanding any RFC 5322 groups."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: c@y.com\r\nCc: a@x.com\r\n\r\nbody"]]]
  [$count [$email:cc-addrs $msg]]]"""] [expect """1"""]]
]
[fn-doc name=bcc-addrs scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Return all Bcc addresses, expanding any RFC 5322 groups."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: c@y.com\r\nBcc: a@x.com, b@x.com\r\n\r\nbody"]]]
  [$count [$email:bcc-addrs $msg]]]"""] [expect """2"""]]
]
[fn-doc name=date-header scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Return the Date header parsed from RFC 5322 form into a datetime."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Date: Tue, 26 May 2026 14:30:00 +0000\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:date-header $msg]]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=message-id scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the Message-ID value with the surrounding angle brackets stripped."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Message-ID: <abc123@example.com>\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:message-id $msg]]"""] [expect """'abc123@example.com'"""]]
]
[fn-doc name=in-reply-to scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the In-Reply-To value with the surrounding angle brackets stripped."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "In-Reply-To: <def456@example.com>\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:in-reply-to $msg]]"""] [expect """'def456@example.com'"""]]
]
[fn-doc name=references scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Return the References threading chain as a sequence of message IDs."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "References: <a@x> <b@x>\r\nFrom: c@y.com\r\n\r\nbody"]]]
  [$count [$email:references $msg]]]"""] [expect """2"""]]
]
[fn-doc name=list-unsubscribe scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Return the URIs from the List-Unsubscribe header as a sequence."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "List-Unsubscribe: <https://x/u>, <mailto:u@x>\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$count [$email:list-unsubscribe $msg]]]"""] [expect """2"""]]
]
[fn-doc name=parts scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Return all body parts flattened (a single part for non-multipart messages)."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nContent-Type: text/plain\r\n\r\njust text"]]]
  [$count [$email:parts $msg]]]"""] [expect """1"""]]
]
[fn-doc name=attachments scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Return parts marked as attachments, each carrying filename, content-type, and decoded bytes."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nContent-Type: multipart/mixed; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nhi\r\n--B\r\nContent-Type: application/pdf\r\nContent-Disposition: attachment; filename=\"invoice.pdf\"\r\n\r\nPDF\r\n--B\r\nContent-Type: image/png\r\nContent-Disposition: attachment; filename=\"img.png\"\r\n\r\nPNG\r\n--B--\r\n"]]]
  [$count [$email:attachments $msg]]]"""] [expect """2"""]]
]
[fn-doc name=text-body scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the first text/plain part decoded to UTF-8, or empty if absent."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nContent-Type: multipart/alternative; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nplain text here\r\n--B\r\nContent-Type: text/html\r\n\r\n<p>html here</p>\r\n--B--\r\n"]]]
  [$email:text-body $msg]]"""] [expect """'plain text here'"""]]
]
[fn-doc name=html-body scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the first text/html part decoded to UTF-8 — raw and unsanitized; sanitize before rendering."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nContent-Type: multipart/alternative; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nplain text here\r\n--B\r\nContent-Type: text/html\r\n\r\n<p>html here</p>\r\n--B--\r\n"]]]
  [$email:html-body $msg]]"""] [expect """'<p>html here</p>'"""]]
]
[fn-doc name=is-multipart scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether the message body is a multipart tree rather than a single part."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nTo: c@d.com\r\nSubject: Hi\r\n\r\nHello body\r\n"]]]
  [$email:is-multipart $msg]]"""] [expect """false"""]]
]
[fn-doc name=decode-encoded-word scope=public purity=pure
  [sig """-> string"""]
  [summary """Decode an RFC 2047 encoded-word (Q or B) from its declared charset to UTF-8."""]
  [example [code """[?lib 'cx-stdlib/email']
[$email:decode-encoded-word "=?UTF-8?Q?Hello_=E4=B8=96=E7=95=8C?="]"""] [expect """'Hello 世界'"""]]
]
[fn-doc name=encode-encoded-word scope=public purity=pure
  [sig """-> string"""]
  [summary """Encode a string as an RFC 2047 encoded-word using the given charset and Q or B encoding."""]
  [example [code """[?lib 'cx-stdlib/email']
[$email:encode-encoded-word "Hi" "UTF-8" "Q"]"""] [expect """'=?UTF-8?Q?Hi?='"""]]
]
[fn-doc name=parse-address scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse a single address string into an [address] element."""]
  [example [code """[?lib 'cx-stdlib/email']
[$email:format-address [$email:parse-address "John Doe <john@example.com>"]]"""] [expect """'John Doe <john@example.com>'"""]]
]
[fn-doc name=parse-address-list scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Parse an address list into a sequence mixing [address] and [address-group] elements."""]
  [example [code """[?lib 'cx-stdlib/email']
[$count [$email:parse-address-list "alice@x.com, bob@y.com"]]"""] [expect """2"""]]
]
[fn-doc name=format-address scope=public purity=pure
  [sig """-> string"""]
  [summary """Format an [address] element back to its RFC 5322 mailbox string."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: John Doe <john@example.com>\r\n\r\nbody"]]]
  [$email:format-address [$email:from-addr $msg]]]"""] [expect """'John Doe <john@example.com>'"""]]
]
[fn-doc name=format-address-list scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a sequence of addresses and groups into an RFC 5322 address-list string."""]
  [example [code """[?lib 'cx-stdlib/email']
[$email:format-address-list [$email:parse-address-list "team: alice@x, bob@x;"]]"""] [expect """'team: alice@x, bob@x;'"""]]
]
[fn-doc name=build scope=public purity=pure
  [sig """-> element"""]
  [summary """Build a plaintext [message] from a parts map (from, to, subject, body, plus optional headers)."""]
  [example [code """[?lib 'cx-stdlib/email']
[?let [= $msg [$email:build {"from": "agent@example.com",
                            "to": "customer@example.com",
                            "subject": "Re: Invoice question",
                            "body": "Thank you for reaching out..."}]]
  [$email:subject [$email:parse [$email:emit $msg]]]]"""] [expect """'Re: Invoice question'"""]]
]
[fn-doc name=build-multipart scope=public purity=pure
  [sig """-> element"""]
  [summary """Build a multipart [message] from a parts map plus a sequence of alternative part elements."""]
  [example [code """[?lib 'cx-stdlib/email']
[?let [= $msg [$email:build-multipart {"from": "a@b.com", "to": "c@d.com", "subject": "x", "body": "plain"}
                ([part content-type="text/html" body="<p>rich</p>"])]]
  [$email:is-multipart $msg]]"""] [expect """true"""]]
]
[fn-doc name=reply scope=public purity=pure
  [sig """-> element"""]
  [summary """Build a reply to a message, preserving threading and prefixing the subject with Re:."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $orig [$email:parse [$bytes:from-string-utf8 "From: sender@x.com\r\nMessage-ID: <abc123@example.com>\r\nSubject: Question\r\n\r\nbody"]]]
  [?let [= $r [$email:reply $orig {"body": "Answer."}]]
    [$email:in-reply-to $r]]]"""] [expect """'abc123@example.com'"""]]
]
[fn-doc name=forward scope=public purity=pure
  [sig """-> element"""]
  [summary """Build a forward that wraps the original as a message/rfc822 attachment, prefixing the subject with Fwd:."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $orig [$email:parse [$bytes:from-string-utf8 "From: sender@x.com\r\nSubject: Report\r\n\r\nbody"]]]
  [?let [= $f [$email:forward $orig {"to": "dest@x.com", "body": "FYI"}]]
    [$email:subject $f]]]"""] [expect """'Fwd: Report'"""]]
]
[fn-doc name=parse-dsn scope=public purity=pure
  [sig """-> element"""]
  [summary """Lift an already-parsed delivery-status report into a structured [dsn] element."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: MAILER-DAEMON@mx\r\nContent-Type: multipart/report; report-type=delivery-status; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nfailed\r\n--B\r\nContent-Type: message/delivery-status\r\n\r\nReporting-MTA: dns; mail.example.com\r\n\r\nFinal-Recipient: rfc822; user@example.com\r\nAction: failed\r\nStatus: 5.1.1\r\nDiagnostic-Code: smtp; 550 no such user\r\n--B--\r\n"]]]
  [?let [= $dsn [$email:parse-dsn $msg]]
    [$email:is-bounce $dsn]]]"""] [expect """true"""]]
]
[fn-doc name=parse-dsn-bytes scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse raw bytes and lift the delivery-status report into a structured [dsn] element."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $dsn [$email:parse-dsn-bytes [$bytes:from-string-utf8 "From: MAILER-DAEMON@mx\r\nContent-Type: multipart/report; report-type=delivery-status; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nfailed\r\n--B\r\nContent-Type: message/delivery-status\r\n\r\nReporting-MTA: dns; mail.example.com\r\n\r\nFinal-Recipient: rfc822; user@example.com\r\nAction: failed\r\nStatus: 5.1.1\r\nDiagnostic-Code: smtp; 550 no such user\r\n--B--\r\n"]]]
  [$email:is-bounce $dsn]]"""] [expect """true"""]]
]
[fn-doc name=is-bounce scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether any recipient in the DSN failed or was delayed."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: MAILER-DAEMON@mx\r\nContent-Type: multipart/report; report-type=delivery-status; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nfailed\r\n--B\r\nContent-Type: message/delivery-status\r\n\r\nReporting-MTA: dns; mail.example.com\r\n\r\nFinal-Recipient: rfc822; user@example.com\r\nAction: failed\r\nStatus: 5.1.1\r\nDiagnostic-Code: smtp; 550 no such user\r\n--B--\r\n"]]]
  [?let [= $dsn [$email:parse-dsn $msg]]
    [$email:is-bounce $dsn]]]"""] [expect """true"""]]
]
[fn-doc name=is-hard-bounce scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether any recipient failed permanently with a 5.x.x status."""]
  [example [code """[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: MAILER-DAEMON@mx\r\nContent-Type: multipart/report; report-type=delivery-status; boundary=\"B\"\r\n\r\n--B\r\nContent-Type: text/plain\r\n\r\nfailed\r\n--B\r\nContent-Type: message/delivery-status\r\n\r\nReporting-MTA: dns; mail.example.com\r\n\r\nFinal-Recipient: rfc822; user@example.com\r\nAction: failed\r\nStatus: 5.1.1\r\nDiagnostic-Code: smtp; 550 no such user\r\n--B--\r\n"]]]
  [?let [= $dsn [$email:parse-dsn $msg]]
    [$email:is-hard-bounce $dsn]]]"""] [expect """true"""]]
]
