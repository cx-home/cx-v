[- cx-stdlib/env — environment variables, command-line arguments,
   process metadata. Full v0.8.0 surface per spec/stdlib_env.md §3.
   Bodies bottom out in native primitives (vcx/code/stdlib_env.v) since
   process state is inexpressible in pure CX. -]

[- §3.1 environment variables -]
[?def var      scope=public impure [returns [or string [sequence string]]] ($name::string) [$env-var $name]]
[?def vars     scope=public impure [returns map]               ()             [$env-vars]]
[?def has-var  scope=public impure [returns bool]              ($name::string) [$env-has-var $name]]

[- §3.1.1 typed defaults -]
[?def var-or-default scope=public impure [returns string] ($name::string $default::string) [$env-var-or-default $name $default]]
[?def var-int        scope=public impure [returns int]    ($name::string $default::int)    [$env-var-int $name $default]]
[?def var-float      scope=public impure [returns float]  ($name::string $default::float)  [$env-var-float $name $default]]
[?def var-bool       scope=public impure [returns bool]   ($name::string $default::bool)   [$env-var-bool $name $default]]
[?def var-required   scope=public impure [returns string] ($name::string)                 [$env-var-required $name]]

[- §3.2 command-line arguments -]
[?def argv       scope=public impure [returns [sequence string]] ()              [$env-argv]]
[?def parse-args scope=public impure [returns element]           ($spec::element) [$env-parse-args $spec]]
[?def flag       scope=public pure   [returns any]    ($parsed-args::element $name::string) [$env-flag $parsed-args $name]]
[?def positional scope=public pure   [returns string] ($parsed-args::element $name::string) [$env-positional $parsed-args $name]]
[?def remaining  scope=public pure   [returns [sequence string]] ($parsed-args::element)   [$env-remaining $parsed-args]]
[?def usage      scope=public pure   [returns string] ($spec::element)                    [$env-usage $spec]]

[- §3.3 process metadata -]
[?def pid             scope=public impure [returns int]    ()  [$env-pid]]
[?def ppid            scope=public impure [returns int]    ()  [$env-ppid]]
[?def executable-path scope=public impure [returns string] ()  [$env-executable-path]]
[?def cwd             scope=public impure [returns string] ()  [$env-cwd]]
[?def hostname        scope=public impure [returns string] ()  [$env-hostname]]
[?def username        scope=public impure [returns string] ()  [$env-username]]
[?def os-name         scope=public pure   [returns string] ()  [$env-os-name]]
[?def os-arch         scope=public pure   [returns string] ()  [$env-os-arch]]
[?def cpu-count       scope=public impure [returns int]    ()  [$env-cpu-count]]

[- §3.4 standard streams -]
[?def stdin  scope=public impure [returns element] ()  [$env-stdin]]
[?def stdout scope=public impure [returns element] ()  [$env-stdout]]
[?def stderr scope=public impure [returns element] ()  [$env-stderr]]

[- §3.5 process termination -]
[?def exit  scope=public impure [returns null] ($code::int)  [$env-exit $code]]
[?def abort scope=public impure [returns null] ()           [$env-abort]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=env
  [scope """Expose process-level metadata to CX code: environment variables, command-line arguments, and process identity.

   Read, list, and typed-default environment variables; parse argv into declarative flags and positionals; query process metadata such as PID, executable path, cwd, hostname, and OS/arch; reach the standard stream handles; and terminate the process. The environment is read-only from CX code — there are no setters. This is a Tier B runtime surface and is necessarily impure."""]]
[fn-doc name=var scope=public purity=impure
  [sig """-> [or string [sequence string]]"""]
  [summary """Read an environment variable, signaling absence (the empty sequence) when it is unset."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:var "CX_DEFINITELY_UNSET_VAR_XYZ_001"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=vars scope=public purity=impure
  [sig """-> map"""]
  [summary """Return all environment variables as a name-to-value map."""]
  [example [code """[?lib 'cx-stdlib/env']
[= [$env:vars] [$env:vars]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=has-var scope=public purity=impure
  [sig """-> bool"""]
  [summary """Report whether a variable is set, distinguishing set-to-empty from unset."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:has-var "CX_DEFINITELY_UNSET_VAR_XYZ_002"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=var-or-default scope=public purity=impure
  [sig """-> string"""]
  [summary """Read a variable, returning the supplied default when it is unset."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:var-or-default "CX_DEFINITELY_UNSET_VAR_XYZ_003" "fallback"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=var-int scope=public purity=impure
  [sig """-> int"""]
  [summary """Read a variable as an int, returning the default if unset or raising if set-but-unparseable."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:var-int "CX_DEFINITELY_UNSET_VAR_XYZ_004" 8080]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=var-float scope=public purity=impure
  [sig """-> float"""]
  [summary """Read a variable as a float, returning the default if unset or raising if set-but-unparseable."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:var-float "CX_DEFINITELY_UNSET_VAR_XYZ_005" 2.5]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=var-bool scope=public purity=impure
  [sig """-> bool"""]
  [summary """Read a variable as a bool (true/false/1/0/yes/no/on/off), returning the default if unset."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:var-bool "CX_DEFINITELY_UNSET_VAR_XYZ_006" true]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=var-required scope=public purity=impure
  [sig """-> string"""]
  [summary """Read a variable, raising a fault if it is unset."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:var-required "CX_DEFINITELY_UNSET_VAR_XYZ_007"]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=argv scope=public purity=impure
  [sig """-> [sequence string]"""]
  [summary """Return the raw command-line argument vector, with argv[0] as the executable path."""]
  [example [code """[?lib 'cx-stdlib/env']
[= [$env:argv] [$env:argv]]"""] [expect """true"""]]
]
[fn-doc name=parse-args scope=public purity=impure
  [sig """-> element"""]
  [summary """Parse argv against a spec into an [args] element of flags, positionals, and unparsed extras."""]
  [example [code """[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [flag name=verbose short=v type=bool]]]
  [$env-parse-args $spec ("prog", "--nope")]]"""] [expect """cx-err:CXER2501"""]]
]
[fn-doc name=flag scope=public purity=pure
  [sig """-> any"""]
  [summary """Look up a parsed flag value by name from a parse-args result."""]
  [example [code """[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [flag name=verbose short=v type=bool] [flag name=limit short=n type=int default=100]]]
  [?let [= $parsed [$env-parse-args $spec ("prog", "--verbose", "--limit", "10")]]
    [$env:flag $parsed "verbose"]]]"""] [expect """true"""]]
]
[fn-doc name=positional scope=public purity=pure
  [sig """-> string"""]
  [summary """Look up a parsed positional argument by name from a parse-args result."""]
  [example [code """[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [positional name=input-file type=string required=true]]]
  [?let [= $parsed [$env-parse-args $spec ("prog", "data.cx")]]
    [$env:positional $parsed "input-file"]]]"""] [expect """'data.cx'"""]]
]
[fn-doc name=remaining scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Return the leftover arguments not consumed by declared flags or positionals."""]
  [example [code """[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [positional name=first type=string]]]
  [?let [= $parsed [$env-parse-args $spec ("prog", "a", "b", "c")]]
    [$env:remaining $parsed]]]"""] [expect """('b', 'c')"""]]
]
[fn-doc name=usage scope=public purity=pure
  [sig """-> string"""]
  [summary """Render a human-readable usage string from an argument spec, for --help or parse failures."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[?let [= $spec [argspec [flag name=verbose short=v type=bool] [positional name=input-file type=string required=true]]]
  [$strings:is-empty [$env:usage $spec]]]"""] [expect """false"""]]
]
[fn-doc name=pid scope=public purity=impure
  [sig """-> int"""]
  [summary """Return the current process ID."""]
  [example [code """[?lib 'cx-stdlib/env']
[> [$env:pid] 0]"""] [expect """true"""]]
]
[fn-doc name=ppid scope=public purity=impure
  [sig """-> int"""]
  [summary """Return the parent process ID."""]
  [example [code """[?lib 'cx-stdlib/env']
[>= [$env:ppid] 0]"""] [expect """true"""]]
]
[fn-doc name=executable-path scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the filesystem path of the running executable."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:executable-path]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=cwd scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the current working directory."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:cwd]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=hostname scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the host machine name."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:hostname]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=username scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the name of the current user."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:username]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=os-name scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the operating-system name, such as linux or darwin."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:os-name]]"""] [expect """false"""]]
]
[fn-doc name=os-arch scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the CPU architecture, such as amd64 or arm64."""]
  [example [code """[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:os-arch]]"""] [expect """false"""]]
]
[fn-doc name=cpu-count scope=public purity=impure
  [sig """-> int"""]
  [summary """Return the logical CPU count, including hyperthreads."""]
  [example [code """[?lib 'cx-stdlib/env']
[> [$env:cpu-count] 0]"""] [expect """true"""]]
]
[fn-doc name=stdin scope=public purity=impure
  [sig """-> element"""]
  [summary """Return the standard-input stream handle, to pass to cx-stdlib/io for I/O."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:stdin]"""] [expect """[std-stream name=stdin fd=0]"""]]
]
[fn-doc name=stdout scope=public purity=impure
  [sig """-> element"""]
  [summary """Return the standard-output stream handle, to pass to cx-stdlib/io for I/O."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:stdout]"""] [expect """[std-stream name=stdout fd=1]"""]]
]
[fn-doc name=stderr scope=public purity=impure
  [sig """-> element"""]
  [summary """Return the standard-error stream handle, to pass to cx-stdlib/io for I/O."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:stderr]"""] [expect """[std-stream name=stderr fd=2]"""]]
]
[fn-doc name=exit scope=public purity=impure
  [sig """-> null"""]
  [summary """Flush pending I/O, run finalizers, and terminate the process with the given exit code."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:exit 0]"""] [expect """[subprocess-harness: child exits with status 0]"""]]
]
[fn-doc name=abort scope=public purity=impure
  [sig """-> null"""]
  [summary """Terminate the process immediately without flushing; use only for unrecoverable corruption."""]
  [example [code """[?lib 'cx-stdlib/env']
[$env:abort]"""] [expect """[subprocess-harness: child terminates via abort signal]"""]]
]
