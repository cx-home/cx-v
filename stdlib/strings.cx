[; cx-stdlib/strings — string inspection, search, transform.

   Full surface per spec/stdlib_strings.md §3. Every [?def]
   body bottoms out in a native primitive (vcx/code/stdlib_strings.v,
   `str-`-prefixed names so they never clash with a language-core
   builtin). CX strings are UTF-8; indexing / length / slicing are
   codepoint-aware (spec §2).

   NOTE: this const and stdlib/strings.cx are the same source — edit
   both. ]

[; §3.1 Inspection ]
[?def length          scope=public pure [returns int]    ($s::string)                  [$str-length $s]]
[?def length-bytes    scope=public pure [returns int]    ($s::string)                  [$str-length-bytes $s]]
[?def is-empty        scope=public pure [returns bool]   ($s::string)                  [$str-is-empty $s]]
[?def at              scope=public pure [returns string] ($s::string $i::int)           [$str-at $s $i]]
[?def slice           scope=public pure [returns string] ($s::string $start::int $end::int) [$str-slice $s $start $end]]
[?def reverse         scope=public pure [returns string] ($s::string)                  [$str-reverse $s]]

[; §3.2 Search ]
[?def contains        scope=public pure [returns bool]   ($s::string $needle::string)          [$str-contains $s $needle]]
[?def find            scope=public pure [returns int]    ($s::string $needle::string)          [$str-find $s $needle]]
[?def find-from       scope=public pure [returns int]    ($s::string $needle::string $from::int) [$str-find-from $s $needle $from]]
[?def rfind           scope=public pure [returns int]    ($s::string $needle::string)          [$str-rfind $s $needle]]
[?def starts-with     scope=public pure [returns bool]   ($s::string $prefix::string)          [$str-starts-with $s $prefix]]
[?def ends-with       scope=public pure [returns bool]   ($s::string $suffix::string)          [$str-ends-with $s $suffix]]
[?def count           scope=public pure [returns int]    ($s::string $needle::string)          [$str-count $s $needle]]
[?def find-all        scope=public pure [returns [sequence int]] ($s::string $needle::string)  [$str-find-all $s $needle]]

[; §3.3 Case ]
[?def upper           scope=public pure [returns string] ($s::string)                  [$str-upper $s]]
[?def lower           scope=public pure [returns string] ($s::string)                  [$str-lower $s]]
[?def title           scope=public pure [returns string] ($s::string)                  [$str-title $s]]
[?def case-fold       scope=public pure [returns string] ($s::string)                  [$str-case-fold $s]]
[?def swap-case       scope=public pure [returns string] ($s::string)                  [$str-swap-case $s]]
[?def upper-locale    scope=public pure [returns string] ($s::string $locale::string)   [$str-upper-locale $s $locale]]
[?def lower-locale    scope=public pure [returns string] ($s::string $locale::string)   [$str-lower-locale $s $locale]]

[; §3.4 Trim ]
[?def trim            scope=public pure [returns string] ($s::string)                        [$str-trim $s]]
[?def trim-start      scope=public pure [returns string] ($s::string)                        [$str-trim-start $s]]
[?def trim-end        scope=public pure [returns string] ($s::string)                        [$str-trim-end $s]]
[?def trim-chars      scope=public pure [returns string] ($s::string $chars::string)          [$str-trim-chars $s $chars]]
[?def trim-start-chars scope=public pure [returns string] ($s::string $chars::string)         [$str-trim-start-chars $s $chars]]
[?def trim-end-chars  scope=public pure [returns string] ($s::string $chars::string)          [$str-trim-end-chars $s $chars]]

[; §3.5 Split and join ]
[?def split           scope=public pure [returns [sequence string]] ($s::string $sep::string)         [$str-split $s $sep]]
[?def split-limit     scope=public pure [returns [sequence string]] ($s::string $sep::string $max::int) [$str-split-limit $s $sep $max]]
[?def split-lines     scope=public pure [returns [sequence string]] ($s::string)                     [$str-split-lines $s]]
[?def split-whitespace scope=public pure [returns [sequence string]] ($s::string)                    [$str-split-whitespace $s]]
[?def join            scope=public pure [returns string] ($parts::[sequence string] $sep::string)     [$str-join $parts $sep]]

[; §3.6 Replace ]
[?def replace         scope=public pure [returns string] ($s::string $from::string $to::string)       [$str-replace $s $from $to]]
[?def replace-first   scope=public pure [returns string] ($s::string $from::string $to::string)       [$str-replace-first $s $from $to]]
[?def replace-n       scope=public pure [returns string] ($s::string $from::string $to::string $n::int) [$str-replace-n $s $from $to $n]]
[?def replace-exactly scope=public pure [returns string] ($s::string $from::string $to::string)       [$str-replace-exactly $s $from $to]]

[; §3.7 Pad and repeat ]
[?def pad-start       scope=public pure [returns string] ($s::string $target::int $pad::string)   [$str-pad-start $s $target $pad]]
[?def pad-end         scope=public pure [returns string] ($s::string $target::int $pad::string)   [$str-pad-end $s $target $pad]]
[?def center          scope=public pure [returns string] ($s::string $target::int $pad::string)   [$str-center $s $target $pad]]
[?def repeat          scope=public pure [returns string] ($s::string $n::int)                    [$str-repeat $s $n]]

[; §3.8 Character class predicates ]
[?def is-ascii        scope=public pure [returns bool] ($s::string)  [$str-is-ascii $s]]
[?def is-digit        scope=public pure [returns bool] ($s::string)  [$str-is-digit $s]]
[?def is-alpha        scope=public pure [returns bool] ($s::string)  [$str-is-alpha $s]]
[?def is-alphanumeric scope=public pure [returns bool] ($s::string)  [$str-is-alphanumeric $s]]
[?def is-whitespace   scope=public pure [returns bool] ($s::string)  [$str-is-whitespace $s]]
[?def is-upper        scope=public pure [returns bool] ($s::string)  [$str-is-upper $s]]
[?def is-lower        scope=public pure [returns bool] ($s::string)  [$str-is-lower $s]]
[?def is-blank        scope=public pure [returns bool] ($s::string)  [$str-is-blank $s]]

[; §3.11 Locale-free numeric parsing — number for valid input, absence () otherwise ]
[?def to-number       scope=public pure [returns [or number [sequence number]]] ($s::string) [$str-to-number $s]]
[?def to-int          scope=public pure [returns [or int [sequence int]]]       ($s::string) [$str-to-int $s]]
[?def to-float        scope=public pure [returns [or float [sequence float]]]   ($s::string) [$str-to-float $s]]

[; §3.9 Format / interpolation ]
[?def format          scope=public pure [returns string] ($template::string $args::[sequence any])  [$str-format $template $args]]

[; §3.10 Encoding helpers ]
[?def escape-html     scope=public pure [returns string] ($s::string)  [$str-escape-html $s]]
[?def unescape-html   scope=public pure [returns string] ($s::string)  [$str-unescape-html $s]]
[?def escape-shell    scope=public pure [returns string] ($s::string)  [$str-escape-shell $s]]
[?def escape-json     scope=public pure [returns string] ($s::string)  [$str-escape-json $s]]
[?def escape-regex    scope=public pure [returns string] ($s::string)  [$str-escape-regex $s]]

[; co-located docs (seeded — refine in place). ]
[module-doc name=strings
  [scope """String inspection, search, and transformation for general text work. Covers length and character-class predicates, case conversion, find/contains/split/join, trim, replace, pad, runtime `format` templates, and escape helpers for HTML, shell, JSON, and regex. CX strings are UTF-8 and most operations are Unicode-aware: indexing, length, and slicing are codepoint-positioned, case folding follows Unicode tables, and predicates use Unicode categories. For byte-level work see cx-stdlib/bytes; for regex see cx-stdlib/re."""]]
[fn-doc name=length scope=public purity=pure
  [sig """-> int"""]
  [summary """Count the codepoints (Unicode scalar values) in a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:length "héllo"]"""] [expect """5"""]]
]
[fn-doc name=length-bytes scope=public purity=pure
  [sig """-> int"""]
  [summary """Count the UTF-8 bytes in a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:length-bytes "héllo"]"""] [expect """6"""]]
]
[fn-doc name=is-empty scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a string has zero length."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-empty ""]"""] [expect """true"""]]
]
[fn-doc name=at scope=public purity=pure
  [sig """-> string"""]
  [summary """Return the single-character substring at a codepoint position; raises if out of bounds."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:at "héllo" 1]"""] [expect """'é'"""]]
]
[fn-doc name=slice scope=public purity=pure
  [sig """-> string"""]
  [summary """Extract a half-open substring by codepoint range; bounds are clamped."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:slice "héllo" 1 4]"""] [expect """'éll'"""]]
]
[fn-doc name=reverse scope=public purity=pure
  [sig """-> string"""]
  [summary """Reverse a string by codepoint."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:reverse "héllo"]"""] [expect """'olléh'"""]]
]
[fn-doc name=contains scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a string contains the given substring."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:contains "foobar" "oba"]"""] [expect """true"""]]
]
[fn-doc name=find scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the codepoint index of the first occurrence of a substring, or -1 if absent."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:find "héllo" "llo"]"""] [expect """2"""]]
]
[fn-doc name=find-from scope=public purity=pure
  [sig """-> int"""]
  [summary """Find the first occurrence of a substring at or after a starting index, or -1 if absent."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:find-from "abcabc" "bc" 2]"""] [expect """4"""]]
]
[fn-doc name=rfind scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the codepoint index of the last (right-to-left) occurrence of a substring, or -1 if absent."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:rfind "abcabc" "bc"]"""] [expect """4"""]]
]
[fn-doc name=starts-with scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a string begins with the given prefix."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:starts-with "foobar" "foo"]"""] [expect """true"""]]
]
[fn-doc name=ends-with scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a string ends with the given suffix."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:ends-with "foobar" "bar"]"""] [expect """true"""]]
]
[fn-doc name=count scope=public purity=pure
  [sig """-> int"""]
  [summary """Count non-overlapping occurrences of a substring."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:count "aaaa" "aa"]"""] [expect """2"""]]
]
[fn-doc name=find-all scope=public purity=pure
  [sig """-> [sequence int]"""]
  [summary """Return the codepoint indices of every non-overlapping occurrence of a substring."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:find-all "abcabc" "bc"]"""] [expect """(1, 4)"""]]
]
[fn-doc name=upper scope=public purity=pure
  [sig """-> string"""]
  [summary """Upper-case a string using Unicode default case tables (locale-independent)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:upper "hello"]"""] [expect """'HELLO'"""]]
]
[fn-doc name=lower scope=public purity=pure
  [sig """-> string"""]
  [summary """Lower-case a string using Unicode default case tables (locale-independent)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:lower "HeLLo"]"""] [expect """'hello'"""]]
]
[fn-doc name=title scope=public purity=pure
  [sig """-> string"""]
  [summary """Title-case a string at Unicode UAX #29 word boundaries."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:title "jean-paul sartre"]"""] [expect """'Jean-Paul Sartre'"""]]
]
[fn-doc name=case-fold scope=public purity=pure
  [sig """-> string"""]
  [summary """Produce the canonical case-folded form for case-insensitive comparison."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:case-fold "STRAßE"]"""] [expect """'strasse'"""]]
]
[fn-doc name=swap-case scope=public purity=pure
  [sig """-> string"""]
  [summary """Swap the case of each cased character, upper to lower and lower to upper."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:swap-case "Hello World"]"""] [expect """'hELLO wORLD'"""]]
]
[fn-doc name=upper-locale scope=public purity=pure
  [sig """-> string"""]
  [summary """Upper-case a string with locale-aware rules (e.g. Turkish dotted-i)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:upper-locale "abc" "en"]"""] [expect """'ABC'"""]]
]
[fn-doc name=lower-locale scope=public purity=pure
  [sig """-> string"""]
  [summary """Lower-case a string with locale-aware rules (e.g. Turkish dotted-i)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:lower-locale "ABC" "en"]"""] [expect """'abc'"""]]
]
[fn-doc name=trim scope=public purity=pure
  [sig """-> string"""]
  [summary """Strip Unicode whitespace from both ends of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:trim "　 hi 　"]"""] [expect """'hi'"""]]
]
[fn-doc name=trim-start scope=public purity=pure
  [sig """-> string"""]
  [summary """Strip Unicode whitespace from the start of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:trim-start "   hi   "]"""] [expect """'hi   '"""]]
]
[fn-doc name=trim-end scope=public purity=pure
  [sig """-> string"""]
  [summary """Strip Unicode whitespace from the end of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:trim-end "   hi   "]"""] [expect """'   hi'"""]]
]
[fn-doc name=trim-chars scope=public purity=pure
  [sig """-> string"""]
  [summary """Strip any of the given characters from both ends of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:trim-chars "<<hi>>" "<>"]"""] [expect """'hi'"""]]
]
[fn-doc name=trim-start-chars scope=public purity=pure
  [sig """-> string"""]
  [summary """Strip any of the given characters from the start of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:trim-start-chars "xxhi" "x"]"""] [expect """'hi'"""]]
]
[fn-doc name=trim-end-chars scope=public purity=pure
  [sig """-> string"""]
  [summary """Strip any of the given characters from the end of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:trim-end-chars "hixx" "x"]"""] [expect """'hi'"""]]
]
[fn-doc name=split scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Split a string on each occurrence of a separator; empty separator splits every character."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:split "a,b,c" ","]"""] [expect """('a', 'b', 'c')"""]]
]
[fn-doc name=split-limit scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Split a string on a separator into at most max+1 segments."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:split-limit "a,b,c,d" "," 2]"""] [expect """('a', 'b', 'c,d')"""]]
]
[fn-doc name=split-lines scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Split a string into lines on LF, CRLF, or CR; a trailing empty line is dropped."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:split-lines "a\nb\r\nc\rd"]"""] [expect """('a', 'b', 'c', 'd')"""]]
]
[fn-doc name=split-whitespace scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Split a string on runs of Unicode whitespace, collapsing consecutive whitespace."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:split-whitespace "  a   b \t c  "]"""] [expect """('a', 'b', 'c')"""]]
]
[fn-doc name=join scope=public purity=pure
  [sig """-> string"""]
  [summary """Concatenate a sequence of strings, inserting the separator between each."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:join ("a", "b", "c") "-"]"""] [expect """'a-b-c'"""]]
]
[fn-doc name=replace scope=public purity=pure
  [sig """-> string"""]
  [summary """Replace every occurrence of a substring with another."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:replace "a.b.c" "." "-"]"""] [expect """'a-b-c'"""]]
]
[fn-doc name=replace-first scope=public purity=pure
  [sig """-> string"""]
  [summary """Replace only the first occurrence of a substring with another."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:replace-first "a.b.c" "." "-"]"""] [expect """'a-b.c'"""]]
]
[fn-doc name=replace-n scope=public purity=pure
  [sig """-> string"""]
  [summary """Replace at most the first n occurrences of a substring with another."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:replace-n "a.b.c.d" "." "-" 2]"""] [expect """'a-b-c.d'"""]]
]
[fn-doc name=replace-exactly scope=public purity=pure
  [sig """-> string"""]
  [summary """Fail-loud surgical replace: `from` MUST occur exactly once, else an [err cx-err:CXER2903] value (no silent no-op on a miss, no over-replace on ambiguity). The safety the harness Edit tool gives, for in-CX text edits."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:replace-exactly "a.b.c" "b" "X"]"""] [expect """'a.X.c'"""]]
]
[fn-doc name=pad-start scope=public purity=pure
  [sig """-> string"""]
  [summary """Left-pad a string with a fill string until it reaches the target width."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:pad-start "abc" 10 "0"]"""] [expect """'0000000abc'"""]]
]
[fn-doc name=pad-end scope=public purity=pure
  [sig """-> string"""]
  [summary """Right-pad a string with a fill string until it reaches the target width."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:pad-end "abc" 6 "."]"""] [expect """'abc...'"""]]
]
[fn-doc name=center scope=public purity=pure
  [sig """-> string"""]
  [summary """Center a string within the target width, padding both sides with a fill string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:center "hi" 6 "*"]"""] [expect """'**hi**'"""]]
]
[fn-doc name=repeat scope=public purity=pure
  [sig """-> string"""]
  [summary """Concatenate n copies of a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:repeat "ab" 3]"""] [expect """'ababab'"""]]
]
[fn-doc name=is-ascii scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every character is ASCII (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-ascii "hello"]"""] [expect """true"""]]
]
[fn-doc name=is-digit scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every character is a Unicode digit (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-digit "12345"]"""] [expect """true"""]]
]
[fn-doc name=is-alpha scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every character is a Unicode letter (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-alpha "abcDEF"]"""] [expect """true"""]]
]
[fn-doc name=is-alphanumeric scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every character is a Unicode letter or digit (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-alphanumeric "abc123"]"""] [expect """true"""]]
]
[fn-doc name=is-whitespace scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every character is Unicode whitespace (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-whitespace "  \t\n"]"""] [expect """true"""]]
]
[fn-doc name=is-upper scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every cased character is upper-case (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-upper "ABC"]"""] [expect """true"""]]
]
[fn-doc name=is-lower scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether every cased character is lower-case (empty string is true)."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-lower "abc"]"""] [expect """true"""]]
]
[fn-doc name=is-blank scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a string is empty or contains only whitespace."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:is-blank "   "]"""] [expect """true"""]]
]
[fn-doc name=format scope=public purity=pure
  [sig """-> string"""]
  [summary """Substitute positional and named placeholders in a template with the given args."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:format "Hello, {}! You have {} messages." ("Alice", 5)]"""] [expect """'Hello, Alice! You have 5 messages.'"""]]
]
[fn-doc name=escape-html scope=public purity=pure
  [sig """-> string"""]
  [summary """Escape the five HTML metacharacters & < > double-quote and single-quote."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:escape-html "<a href=\"x\">&'"]"""] [expect """'&lt;a href=&quot;x&quot;&gt;&amp;&#39;'"""]]
]
[fn-doc name=unescape-html scope=public purity=pure
  [sig """-> string"""]
  [summary """Decode numeric and HTML5 named character references back to text."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:unescape-html "a&hellip;b&mdash;c&copy;"]"""] [expect """'a…b—c©'"""]]
]
[fn-doc name=escape-shell scope=public purity=pure
  [sig """-> string"""]
  [summary """Quote a string for safe use as a single POSIX shell argument."""]
]
[fn-doc name=escape-json scope=public purity=pure
  [sig """-> string"""]
  [summary """Apply JSON string escapes to a string."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:escape-json "a\"b"]"""] [expect """'a\\"b'"""]]
]
[fn-doc name=escape-regex scope=public purity=pure
  [sig """-> string"""]
  [summary """Escape regex metacharacters so a string matches literally."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:escape-regex "a.b*c"]"""] [expect """'a\.b\*c'"""]]
]
[fn-doc name=to-number scope=public purity=pure
  [sig """-> [or number absence]"""]
  [summary """Parse a locale-free numeric string into a number — int for pure-integer syntax, float for fractional / exponent syntax. Surrounding whitespace is trimmed; a non-numeric input (trailing junk, grouping separators, empty) yields the absence channel () rather than a silent string passthrough, so callers branch with [?else]. For grouping / Unicode digits use cx-stdlib/locale."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:to-number "3.07"]"""] [expect """3.07"""]]
]
[fn-doc name=to-int scope=public purity=pure
  [sig """-> [or int absence]"""]
  [summary """Parse a locale-free integer string (optional sign, ASCII digits) into an int; fractional or exponent syntax ("3.07", "1e3") and non-numeric input yield the absence channel ()."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:to-int "42"]"""] [expect """42"""]]
]
[fn-doc name=to-float scope=public purity=pure
  [sig """-> [or float absence]"""]
  [summary """Parse any locale-free numeric string into a float ("5" -> 5.0); a non-numeric input yields the absence channel ()."""]
  [example [code """[?lib 'cx-stdlib/strings']
[$strings:to-float "5"]"""] [expect """5.0"""]]
]
