[- cx-stdlib/crypto — keyed / secret / authentication primitives
   (spec/std-lib/crypto.md). Security sibling of cx-stdlib/hash.

   Full v0.8.0 surface per spec/std-lib/crypto.md §3. Bodies forward to
   native primitives (vcx/code/stdlib_crypto.v) since HMAC / HKDF /
   keyed-BLAKE3 / AEAD / Ed25519 / X25519 / Argon2id are not expressible
   in pure CX. Keys / messages / MACs / salts / IKM / PRK / info / OKM /
   signatures / ciphertexts are all CXDM bytes (§2.1); convert hex/base64
   via cx-stdlib/bytes before passing in.

   Streaming HMAC carries an opaque [hmac-hasher …] element (§3.2). AEAD
   results are [aead algo=.. ciphertext=.. nonce=.. tag=..] (§3.7);
   keypairs are [keypair public=.. private=..] (§3.8). The four generating
   surfaces (aead-encrypt, ed25519-keypair, x25519-keypair, password-hash)
   are impure — they draw fresh randomness (§2.4). Errors are values
   (CXER3700/3701/3703/3704/3705/3706/3707, §5).

   NOTE: this const and stdlib/crypto.cx are the same source — edit both. -]

[- §3.1 HMAC single-shot -]
[?def hmac-sha256 scope=public pure [returns bytes] ($key::bytes $msg::bytes) [$crypto-hmac-sha256 $key $msg]]
[?def hmac-sha384 scope=public pure [returns bytes] ($key::bytes $msg::bytes) [$crypto-hmac-sha384 $key $msg]]
[?def hmac-sha512 scope=public pure [returns bytes] ($key::bytes $msg::bytes) [$crypto-hmac-sha512 $key $msg]]

[- §3.2 HMAC streaming -]
[?def hmac-new      scope=public pure [returns element] ($algo::string $key::bytes) [$crypto-hmac-new $algo $key]]
[?def hmac-update   scope=public pure [returns element] ($h::element $chunk::bytes) [$crypto-hmac-update $h $chunk]]
[?def hmac-finalize scope=public pure [returns bytes]   ($h::element)               [$crypto-hmac-finalize $h]]

[- §3.3 keyed-BLAKE3 -]
[?def blake3-keyed      scope=public pure [returns bytes] ($key::bytes $msg::bytes)                  [$crypto-blake3-keyed $key $msg]]
[?def blake3-mac-verify scope=public pure [returns bool]  ($key::bytes $msg::bytes $expected::bytes) [$crypto-blake3-mac-verify $key $msg $expected]]

[- §3.4 HKDF -]
[?def hkdf-extract scope=public pure [returns bytes] ($salt::bytes $ikm::bytes)               [$crypto-hkdf-extract $salt $ikm]]
[?def hkdf-expand  scope=public pure [returns bytes] ($prk::bytes $info::bytes $length::int)   [$crypto-hkdf-expand $prk $info $length]]
[?def hkdf         scope=public pure [returns bytes] ($ikm::bytes $salt::bytes $info::bytes $length::int) [$crypto-hkdf $ikm $salt $info $length]]
[?def hkdf-extract-sha512 scope=public pure [returns bytes] ($salt::bytes $ikm::bytes)             [$crypto-hkdf-extract-sha512 $salt $ikm]]
[?def hkdf-expand-sha512  scope=public pure [returns bytes] ($prk::bytes $info::bytes $length::int) [$crypto-hkdf-expand-sha512 $prk $info $length]]
[?def hkdf-sha512         scope=public pure [returns bytes] ($ikm::bytes $salt::bytes $info::bytes $length::int) [$crypto-hkdf-sha512 $ikm $salt $info $length]]

[- §3.6 verification contract -]
[?def hmac-verify scope=public pure [returns bool] ($algo::string $key::bytes $msg::bytes $expected::bytes) [$crypto-hmac-verify $algo $key $msg $expected]]

[- §3.7 AEAD -]
[?def aead-encrypt scope=public impure [returns element] ($algo::string $key::bytes $plaintext::bytes $aad::bytes) [$crypto-aead-encrypt $algo $key $plaintext $aad]]
[?def aead-decrypt scope=public pure   [returns bytes]   ($algo::string $key::bytes $aead::element $aad::bytes)    [$crypto-aead-decrypt $algo $key $aead $aad]]

[- §3.8 asymmetric -]
[?def ed25519-keypair      scope=public impure [returns element] ()                                    [$crypto-ed25519-keypair]]
[?def ed25519-sign         scope=public pure   [returns bytes]   ($private-key::bytes $msg::bytes)       [$crypto-ed25519-sign $private-key $msg]]
[?def ed25519-verify       scope=public pure   [returns bool]    ($public-key::bytes $msg::bytes $sig::bytes) [$crypto-ed25519-verify $public-key $msg $sig]]
[?def x25519-keypair       scope=public impure [returns element] ()                                    [$crypto-x25519-keypair]]
[?def x25519-shared-secret scope=public pure   [returns bytes]   ($private-key::bytes $peer-public-key::bytes) [$crypto-x25519-shared-secret $private-key $peer-public-key]]
[?def rsa-verify           scope=public pure   [returns bool]    ($public-key::element $msg::bytes $sig::bytes $opts::map {}) [$crypto-rsa-verify $public-key $msg $sig $opts]]
[?def ecdsa-verify         scope=public pure   [returns bool]    ($public-key::element $msg::bytes $sig::bytes $opts::map {}) [$crypto-ecdsa-verify $public-key $msg $sig $opts]]

[- §3.9 password hashing -]
[?def password-hash   scope=public impure [returns string] ($password::bytes $cost::element) [$crypto-password-hash $password $cost]]
[?def password-verify scope=public pure   [returns bool]   ($password::bytes $encoded::string) [$crypto-password-verify $password $encoded]]

[- §3.10 JWT / JWKS verification — fail-closed; verify-only -]
[?def jwt-verify scope=public pure   [returns element] ($token::string $key::element $now::datetime $opts::map {}) [$crypto-jwt-verify $token $key $now $opts]]
[?def jwks-fetch scope=public impure [returns element] ($jwks-uri::string $opts::map {})                          [$crypto-jwks-fetch $jwks-uri $opts]]
[?def jwks-parse scope=public pure   [returns element] ($json-text::string)                                       [$crypto-jwks-parse $json-text]]
[?def claim      scope=public pure   [returns element] ($claims::element $name::string)                          [$crypto-claim $claims $name]]
[?def jwk-by-kid scope=public pure   [returns element] ($jwks::element $kid::string)                             [$crypto-jwk-by-kid $jwks $kid]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=crypto
  [scope """Operations involving a key, a secret, or authentication. The security sibling of cx-stdlib/hash, which fingerprints public data: if it involves a key, a secret, or authentication it lives here; a bare fingerprint lives in hash. Covers HMAC, keyed-BLAKE3, HKDF, constant-time MAC verification, AEAD, Ed25519/X25519, Argon2id password hashing, and fail-closed JWT/JWKS verification. Keys, messages, MACs, and other byte material are all CXDM bytes — convert hex or base64 via cx-stdlib/bytes before passing in."""]]
[fn-doc name=hmac-sha256 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compute the HMAC-SHA-256 (RFC 2104) of a message under a key — 32 bytes, key of any length."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$crypto:hmac-sha256 [$bytes:from-string-utf8 "Jefe"] [$bytes:from-string-utf8 "what do ya want for nothing?"]]]"""] [expect """'5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843'"""]]
]
[fn-doc name=hmac-sha384 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compute the HMAC-SHA-384 (RFC 2104) of a message under a key — 48 bytes, key of any length."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$crypto:hmac-sha384 [$bytes:from-string-utf8 "Jefe"] [$bytes:from-string-utf8 "what do ya want for nothing?"]]]"""] [expect """'af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649'"""]]
]
[fn-doc name=hmac-sha512 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compute the HMAC-SHA-512 (RFC 2104) of a message under a key — 64 bytes, key of any length."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$crypto:hmac-sha512 [$bytes:from-string-utf8 "Jefe"] [$bytes:from-string-utf8 "what do ya want for nothing?"]]]"""] [expect """'164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737'"""]]
]
[fn-doc name=hmac-new scope=public purity=pure
  [sig """-> element"""]
  [summary """Start a streaming HMAC hasher for the named algorithm and key (sha256/sha384/sha512)."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:equals [$crypto:hmac-finalize [$crypto:hmac-update [$crypto:hmac-update [$crypto:hmac-new "sha256" [$bytes:from-string-utf8 "Jefe"]] [$bytes:from-string-utf8 "what do ya want "]] [$bytes:from-string-utf8 "for nothing?"]]] [$crypto:hmac-sha256 [$bytes:from-string-utf8 "Jefe"] [$bytes:from-string-utf8 "what do ya want for nothing?"]]]"""] [expect """true"""]]
]
[fn-doc name=hmac-update scope=public purity=pure
  [sig """-> element"""]
  [summary """Feed a chunk into a streaming HMAC hasher, returning a new hasher — the input is unchanged."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:equals [$crypto:hmac-finalize [$crypto:hmac-update [$crypto:hmac-update [$crypto:hmac-new "sha256" [$bytes:from-string-utf8 "Jefe"]] [$bytes:from-string-utf8 "what do ya want "]] [$bytes:from-string-utf8 "for nothing?"]]] [$crypto:hmac-sha256 [$bytes:from-string-utf8 "Jefe"] [$bytes:from-string-utf8 "what do ya want for nothing?"]]]"""] [expect """true"""]]
]
[fn-doc name=hmac-finalize scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Finish a streaming HMAC hasher and return the MAC — equal to the single-shot HMAC over the concatenated chunks."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:equals [$crypto:hmac-finalize [$crypto:hmac-update [$crypto:hmac-update [$crypto:hmac-new "sha256" [$bytes:from-string-utf8 "Jefe"]] [$bytes:from-string-utf8 "what do ya want "]] [$bytes:from-string-utf8 "for nothing?"]]] [$crypto:hmac-sha256 [$bytes:from-string-utf8 "Jefe"] [$bytes:from-string-utf8 "what do ya want for nothing?"]]]"""] [expect """true"""]]
]
[fn-doc name=blake3-keyed scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compute the keyed-BLAKE3 MAC of a message — exactly-32-byte key, 32-byte output."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:length [$crypto:blake3-keyed [$bytes:from-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"] [$bytes:from-string-utf8 "abc"]]]"""] [expect """32"""]]
]
[fn-doc name=blake3-mac-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify a keyed-BLAKE3 MAC in constant time — returns true on match, raises CXER3701 otherwise."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $k [$bytes:from-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"]] [?let [= $m [$bytes:from-string-utf8 "abc"]] [$crypto:blake3-mac-verify $k $m [$crypto:blake3-keyed $k $m]]]]"""] [expect """true"""]]
]
[fn-doc name=hkdf-extract scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Concentrate input keying material into a fixed-length SHA-256 PRK (HKDF-Extract, RFC 5869); empty salt allowed."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$crypto:hkdf-extract [$bytes:from-hex "000102030405060708090a0b0c"] [$bytes:from-hex "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"]]]"""] [expect """'077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5'"""]]
]
[fn-doc name=hkdf-expand scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Stretch a SHA-256 PRK into length bytes domain-separated by info (HKDF-Expand, RFC 5869)."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$crypto:hkdf-expand [$bytes:from-hex "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"] [$bytes:from-hex "f0f1f2f3f4f5f6f7f8f9"] 42]]"""] [expect """'3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865'"""]]
]
[fn-doc name=hkdf scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Derive length bytes of key material from one secret in a single SHA-256 extract-then-expand step (RFC 5869)."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$crypto:hkdf [$bytes:from-hex "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"] [$bytes:from-hex "000102030405060708090a0b0c"] [$bytes:from-hex "f0f1f2f3f4f5f6f7f8f9"] 42]]"""] [expect """'3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865'"""]]
]
[fn-doc name=hkdf-extract-sha512 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """HKDF-Extract over SHA-512 — concentrate input keying material into a 64-byte PRK."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $ikm [$bytes:from-hex "0b0b0b0b0b0b0b0b0b0b0b"]] [?let [= $salt [$bytes:from-hex "000102030405060708090a0b0c"]] [$bytes:length [$crypto:hkdf-extract-sha512 $salt $ikm]]]]"""] [expect """64"""]]
]
[fn-doc name=hkdf-expand-sha512 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """HKDF-Expand over SHA-512 — stretch a PRK into length bytes domain-separated by info."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $ikm [$bytes:from-hex "0b0b0b0b0b0b0b0b0b0b0b"]] [?let [= $salt [$bytes:from-hex "000102030405060708090a0b0c"]] [?let [= $info [$bytes:from-hex "f0f1f2f3f4f5f6f7f8f9"]] [$bytes:equals [$crypto:hkdf-sha512 $ikm $salt $info 42] [$crypto:hkdf-expand-sha512 [$crypto:hkdf-extract-sha512 $salt $ikm] $info 42]]]]]"""] [expect """true"""]]
]
[fn-doc name=hkdf-sha512 scope=public purity=pure
  [sig """-> bytes"""]
  [summary """One-shot HKDF over SHA-512 — extract-then-expand a secret into length bytes of key material."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $ikm [$bytes:from-hex "0b0b0b0b0b0b0b0b0b0b0b"]] [?let [= $salt [$bytes:from-hex "000102030405060708090a0b0c"]] [?let [= $info [$bytes:from-hex "f0f1f2f3f4f5f6f7f8f9"]] [$bytes:length [$crypto:hkdf-sha512 $ikm $salt $info 42]]]]]"""] [expect """42"""]]
]
[fn-doc name=hmac-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Recompute and compare an HMAC in constant time — returns true on match, raises CXER3701 otherwise, never false."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $k [$bytes:from-string-utf8 "secret"]] [?let [= $m [$bytes:from-string-utf8 "raw-body"]] [$crypto:hmac-verify "sha256" $k $m [$crypto:hmac-sha256 $k $m]]]]"""] [expect """true"""]]
]
[fn-doc name=aead-encrypt scope=public purity=impure
  [sig """-> element"""]
  [summary """Authenticated-encrypt plaintext with associated data (AES-256-GCM or ChaCha20-Poly1305), generating a fresh nonce per call."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $k [$bytes:from-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"]] [?let [= $pt [$bytes:from-string-utf8 "attack at dawn"]] [?let [= $ct [$crypto:aead-encrypt "aes-256-gcm" $k $pt [$bytes:from-string-utf8 "hdr"]]] [$bytes:equals [$crypto:aead-decrypt "aes-256-gcm" $k $ct [$bytes:from-string-utf8 "hdr"]] $pt]]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=aead-decrypt scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Verify the tag in constant time before returning any plaintext — auth failure raises CXER3704."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $k [$bytes:from-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"]] [?let [= $pt [$bytes:from-string-utf8 "attack at dawn"]] [?let [= $ct [$crypto:aead-encrypt "aes-256-gcm" $k $pt [$bytes:from-string-utf8 "hdr"]]] [$bytes:equals [$crypto:aead-decrypt "aes-256-gcm" $k $ct [$bytes:from-string-utf8 "hdr"]] $pt]]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=ed25519-keypair scope=public purity=impure
  [sig """-> element"""]
  [summary """Sample a fresh Ed25519 keypair — 32-byte public key and 32-byte private seed."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $kp [$crypto:ed25519-keypair]] [$bytes:length $kp@public]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=ed25519-sign scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Sign a message with an Ed25519 private key (RFC 8032) — deterministic per the standard."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $kp [$crypto:ed25519-keypair]] [?let [= $m [$bytes:from-string-utf8 "sign me"]] [$crypto:ed25519-verify $kp@public $m [$crypto:ed25519-sign $kp@private $m]]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=ed25519-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify an Ed25519 signature — returns true on success, raises CXER3705 on an invalid or malformed signature."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $kp [$crypto:ed25519-keypair]] [?let [= $m [$bytes:from-string-utf8 "sign me"]] [$crypto:ed25519-verify $kp@public $m [$crypto:ed25519-sign $kp@private $m]]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=x25519-keypair scope=public purity=impure
  [sig """-> element"""]
  [summary """Sample a fresh X25519 keypair for key exchange — both keys 32 bytes."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $kp [$crypto:x25519-keypair]] [$bytes:length $kp@public]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=x25519-shared-secret scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compute the 32-byte X25519 Diffie-Hellman shared secret — the natural ikm for hkdf."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $a [$crypto:x25519-keypair]] [?let [= $b [$crypto:x25519-keypair]] [$bytes:equals [$crypto:x25519-shared-secret $a@private $b@public] [$crypto:x25519-shared-secret $b@private $a@public]]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=rsa-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify an RSASSA-PKCS1-v1_5 signature (RFC 8017) backing the JWT RS256/384/512 families — true or raise."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$crypto:rsa-verify [rsa-public-key [n [$bytes:from-hex ""]] [e [$bytes:from-hex "010001"]]] [$bytes:from-hex "68656c6c6f2063782063727970746f"] [$bytes:from-hex ""] {hash: "sha256"}]"""] [expect """true"""]]
]
[fn-doc name=ecdsa-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify an ECDSA P-256 signature over a JOSE raw r-concat-s pair (RFC 7518 §3.4) backing JWT ES256 — true or raise."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[$crypto:ecdsa-verify [ec-public-key crv="P-256" [x [$bytes:from-hex "97d49c2f327683c64795ce33c7a8ea90b6ebc3d341fe3ece449d874d006019e4"]] [y [$bytes:from-hex "b29043a977e05ce76a0c6b38fd67a7644991166cbbd6ab6cd5d304a7cc6b83a3"]]] [$bytes:from-hex "68656c6c6f2063782063727970746f"] [$bytes:from-hex "5db3b4f367aa22dfa532452151d8a2bb9ecf0fdc968b82a0ad1ac5ed0b8a42cc15b1ce90768ccc59116297c0866874c416823cf92ed1d55b75ca828083d19920"] {curve: "P-256" hash: "sha256"}]"""] [expect """true"""]]
]
[fn-doc name=password-hash scope=public purity=impure
  [sig """-> string"""]
  [summary """Hash a password with Argon2id and a fresh salt, returning a self-describing PHC-string."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $enc [$crypto:password-hash [$bytes:from-string-utf8 "correct horse battery staple"] [argon2-cost memory-kib=65536 iterations=3 parallelism=4]]] [$starts-with $enc "$argon2id$v=19$"]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=password-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify a password against an Argon2id PHC-string — true on match, raises CXER3706 otherwise."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $pw [$bytes:from-string-utf8 "correct horse battery staple"]] [$crypto:password-verify $pw [$crypto:password-hash $pw [argon2-cost memory-kib=65536 iterations=3 parallelism=4]]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=jwt-verify scope=public purity=pure
  [sig """-> element"""]
  [summary """Fail-closed verify a JWT against a key set at a given time, returning a [claims] value or raising — never false, never unverified claims."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/time']
[$crypto:claim [$crypto:jwt-verify "eyJhbGciOiJSUzI1NiIsImtpZCI6InJzYS0xIiwidHlwIjoiSldUIn0.eyJpc3MiOiJodHRwczovL2lkcC5leGFtcGxlIiwic3ViIjoidXNlci0xIiwiYXVkIjoibXktYXBpIiwiZXhwIjoxNzAwMDAzNjAwLCJuYmYiOjE2OTk5OTk5OTAsImlhdCI6MTY5OTk5OTk5MH0.e4bn1A_a5Q0_4IZxKWipmmrUCCdmNkiTUs071mBMtMVXb68RGPtV2FTR1nRWvM3Zw2XTMuBsk_Y1HPinat_2JQkm3s90lltrErpYOky6Nwm6ha57BxQ0Sg5kWxuQF5KhWUqHzePIVDTfkr0WeN591nDTDn6VuajLaHn2pjXBsaJ0reT6mh6v40UQcBW-yy-XOfrsMeGVj_qZd1UmlE81XN957rjPENcPpH2E1SHfVhu3fQP3QZapxtdMADgWmryw_z5O2lDIIWb7miT0siXRCDjVEhDzKH6Hsf1aUPcYx9x44o1B5OBpX6z1uM1SP0qaOZu6x26H0AbHj84nIISE1A" [$crypto:jwks-parse "{\"keys\":[{\"kid\":\"rsa-1\",\"kty\":\"RSA\",\"alg\":\"RS256\",\"n\":\"jdwwBcaMZQLoSNYGNEm3l03HIQqpRIv0eqLUNUCkyv7ysVw4i6vZgdYxcdU0D3kSvUCIjH-icqk4PCDx5AwkeNp55Nqt6wKXDv9TH5pr-Wc3BWmZ1sEOEwyN8QlI8_5EpY3i1w5tysDdeFuiR7BOjpkD49RZzF0YajmocsB4_jXoZcldVNCOChXAbEfOw-BtjFJRN0N3EksymF4azkey8Q3rX07sXkRHavRfAOnowH119RL1V-Xmk_DUX8wSR-2zdlp8FxitJWPgbMmnszsTgEQrThTwsuMrndqzJ_nQ7HTnuK2LXEFmFwXw9NADspq2ZnQmZiN7CXnEYG8WCApzxw\",\"e\":\"AQAB\"},{\"kid\":\"ec-1\",\"kty\":\"EC\",\"crv\":\"P-256\",\"alg\":\"ES256\",\"x\":\"l9ScLzJ2g8ZHlc4zx6jqkLbrw9NB_j7ORJ2HTQBgGeQ\",\"y\":\"spBDqXfgXOdqDGs4_WenZEmRFmy71qts1dMEp8xrg6M\"},{\"kid\":\"ed-1\",\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"alg\":\"EdDSA\",\"x\":\"W7aFRt4kKu7VuwPv6oBWPpxSwy9jCzk2QqawxURsnsk\"}]}"] [$time:datetime 2023 11 14 22 13 20] {}] "iss"]"""] [expect """'https://idp.example'"""]]
]
[fn-doc name=jwks-fetch scope=public purity=impure
  [sig """-> element"""]
  [summary """GET a JWKS document over http and return a parsed [jwks] — non-2xx, transport fault, or non-JWKS body raises CXER3716."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[$crypto:jwks-fetch "https://idp.example/.well-known/jwks.json" {}]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=jwks-parse scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse already-fetched JWKS JSON into a [jwks] value — malformed or inconsistent alg/kty raises CXER3717."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?let [= $k [$crypto:jwk-by-kid [$crypto:jwks-parse "{\"keys\":[{\"kid\":\"rsa-1\",\"kty\":\"RSA\",\"alg\":\"RS256\",\"n\":\"jdwwBcaMZQLoSNYGNEm3l03HIQqpRIv0eqLUNUCkyv7ysVw4i6vZgdYxcdU0D3kSvUCIjH-icqk4PCDx5AwkeNp55Nqt6wKXDv9TH5pr-Wc3BWmZ1sEOEwyN8QlI8_5EpY3i1w5tysDdeFuiR7BOjpkD49RZzF0YajmocsB4_jXoZcldVNCOChXAbEfOw-BtjFJRN0N3EksymF4azkey8Q3rX07sXkRHavRfAOnowH119RL1V-Xmk_DUX8wSR-2zdlp8FxitJWPgbMmnszsTgEQrThTwsuMrndqzJ_nQ7HTnuK2LXEFmFwXw9NADspq2ZnQmZiN7CXnEYG8WCApzxw\",\"e\":\"AQAB\"},{\"kid\":\"ec-1\",\"kty\":\"EC\",\"crv\":\"P-256\",\"alg\":\"ES256\",\"x\":\"l9ScLzJ2g8ZHlc4zx6jqkLbrw9NB_j7ORJ2HTQBgGeQ\",\"y\":\"spBDqXfgXOdqDGs4_WenZEmRFmy71qts1dMEp8xrg6M\"},{\"kid\":\"ed-1\",\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"alg\":\"EdDSA\",\"x\":\"W7aFRt4kKu7VuwPv6oBWPpxSwy9jCzk2QqawxURsnsk\"}]}"] "ec-1"]] $k@kty]"""] [expect """'EC'"""]]
]
[fn-doc name=claim scope=public purity=pure
  [sig """-> element"""]
  [summary """Read a named claim from a verified [claims] value — absent yields the absence channel, never null."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/time']
[$crypto:claim [$crypto:jwt-verify "eyJhbGciOiJSUzI1NiIsImtpZCI6InJzYS0xIiwidHlwIjoiSldUIn0.eyJpc3MiOiJodHRwczovL2lkcC5leGFtcGxlIiwic3ViIjoidXNlci0xIiwiYXVkIjoibXktYXBpIiwiZXhwIjoxNzAwMDAzNjAwLCJuYmYiOjE2OTk5OTk5OTAsImlhdCI6MTY5OTk5OTk5MH0.e4bn1A_a5Q0_4IZxKWipmmrUCCdmNkiTUs071mBMtMVXb68RGPtV2FTR1nRWvM3Zw2XTMuBsk_Y1HPinat_2JQkm3s90lltrErpYOky6Nwm6ha57BxQ0Sg5kWxuQF5KhWUqHzePIVDTfkr0WeN591nDTDn6VuajLaHn2pjXBsaJ0reT6mh6v40UQcBW-yy-XOfrsMeGVj_qZd1UmlE81XN957rjPENcPpH2E1SHfVhu3fQP3QZapxtdMADgWmryw_z5O2lDIIWb7miT0siXRCDjVEhDzKH6Hsf1aUPcYx9x44o1B5OBpX6z1uM1SP0qaOZu6x26H0AbHj84nIISE1A" [$crypto:jwks-parse "{\"keys\":[{\"kid\":\"rsa-1\",\"kty\":\"RSA\",\"alg\":\"RS256\",\"n\":\"jdwwBcaMZQLoSNYGNEm3l03HIQqpRIv0eqLUNUCkyv7ysVw4i6vZgdYxcdU0D3kSvUCIjH-icqk4PCDx5AwkeNp55Nqt6wKXDv9TH5pr-Wc3BWmZ1sEOEwyN8QlI8_5EpY3i1w5tysDdeFuiR7BOjpkD49RZzF0YajmocsB4_jXoZcldVNCOChXAbEfOw-BtjFJRN0N3EksymF4azkey8Q3rX07sXkRHavRfAOnowH119RL1V-Xmk_DUX8wSR-2zdlp8FxitJWPgbMmnszsTgEQrThTwsuMrndqzJ_nQ7HTnuK2LXEFmFwXw9NADspq2ZnQmZiN7CXnEYG8WCApzxw\",\"e\":\"AQAB\"},{\"kid\":\"ec-1\",\"kty\":\"EC\",\"crv\":\"P-256\",\"alg\":\"ES256\",\"x\":\"l9ScLzJ2g8ZHlc4zx6jqkLbrw9NB_j7ORJ2HTQBgGeQ\",\"y\":\"spBDqXfgXOdqDGs4_WenZEmRFmy71qts1dMEp8xrg6M\"},{\"kid\":\"ed-1\",\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"alg\":\"EdDSA\",\"x\":\"W7aFRt4kKu7VuwPv6oBWPpxSwy9jCzk2QqawxURsnsk\"}]}"] [$time:datetime 2023 11 14 22 13 20] {}] "iss"]"""] [expect """'https://idp.example'"""]]
]
[fn-doc name=jwk-by-kid scope=public purity=pure
  [sig """-> element"""]
  [summary """Select a [jwk] from a [jwks] by key id — no match yields the absence channel."""]
  [example [code """[?lib 'cx-stdlib/crypto']
[?let [= $k [$crypto:jwk-by-kid [$crypto:jwks-parse "{\"keys\":[{\"kid\":\"rsa-1\",\"kty\":\"RSA\",\"alg\":\"RS256\",\"n\":\"jdwwBcaMZQLoSNYGNEm3l03HIQqpRIv0eqLUNUCkyv7ysVw4i6vZgdYxcdU0D3kSvUCIjH-icqk4PCDx5AwkeNp55Nqt6wKXDv9TH5pr-Wc3BWmZ1sEOEwyN8QlI8_5EpY3i1w5tysDdeFuiR7BOjpkD49RZzF0YajmocsB4_jXoZcldVNCOChXAbEfOw-BtjFJRN0N3EksymF4azkey8Q3rX07sXkRHavRfAOnowH119RL1V-Xmk_DUX8wSR-2zdlp8FxitJWPgbMmnszsTgEQrThTwsuMrndqzJ_nQ7HTnuK2LXEFmFwXw9NADspq2ZnQmZiN7CXnEYG8WCApzxw\",\"e\":\"AQAB\"},{\"kid\":\"ec-1\",\"kty\":\"EC\",\"crv\":\"P-256\",\"alg\":\"ES256\",\"x\":\"l9ScLzJ2g8ZHlc4zx6jqkLbrw9NB_j7ORJ2HTQBgGeQ\",\"y\":\"spBDqXfgXOdqDGs4_WenZEmRFmy71qts1dMEp8xrg6M\"},{\"kid\":\"ed-1\",\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"alg\":\"EdDSA\",\"x\":\"W7aFRt4kKu7VuwPv6oBWPpxSwy9jCzk2QqawxURsnsk\"}]}"] "ec-1"]] $k@kty]"""] [expect """'EC'"""]]
]
