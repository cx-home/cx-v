[- cx-stdlib/geo — WGS84 coordinate primitives.

   Full v0.8.0 public surface per spec/std-lib/geo.md §3. Bodies forward
   to native primitives (vcx/code/stdlib_geo.v): Haversine + Vincenty
   distance, bearing, bbox / polygon operations, OGC validity, WKT and
   GeoJSON I/O, and lat/lon normalization are not expressible in pure CX.

   Geometries are CXDM elements ([point] / [bbox] / [polygon] /
   [geometry-collection] / [feature]); coordinates are child elements so
   $p/lat resolves to the bare float. All coordinates are WGS84
   (EPSG:4326) decimal degrees (§1.1). Errors are values (CXER3600..3605,
   §5): invalid coordinate, Vincenty non-convergence, invalid polygon,
   malformed WKT / GeoJSON, unsupported geometry type.

   NOTE: this const and stdlib/geo.cx are the same source — edit both. -]

[- §3.1 construction -]
[?def point              scope=public pure [returns element] ($lat::float $lon::float)                                  [$geo-point $lat $lon]]
[?def bbox               scope=public pure [returns element] ($points::[sequence element])                               [$geo-bbox $points]]
[?def polygon            scope=public pure [returns element] ($outer::[sequence element])                                [$geo-polygon $outer]]
[?def polygon-with-holes scope=public pure [returns element] ($outer::[sequence element] $holes::[sequence [sequence element]]) [$geo-polygon-with-holes $outer $holes]]

[- §3.2 distance and bearing -]
[?def distance          scope=public pure [returns float]   ($a::element $b::element $unit::string)                     [$geo-distance $a $b $unit]]
[?def distance-vincenty scope=public pure [returns float]   ($a::element $b::element $unit::string)                     [$geo-distance-vincenty $a $b $unit]]
[?def bearing           scope=public pure [returns float]   ($a::element $b::element)                                    [$geo-bearing $a $b]]
[?def destination       scope=public pure [returns element] ($origin::element $bearing::float $distance::float $unit::string) [$geo-destination $origin $bearing $distance $unit]]

[- §3.3 bounding-box operations -]
[?def bbox-of         scope=public pure [returns element] ($points::[sequence element])      [$geo-bbox-of $points]]
[?def bbox-of-polygon scope=public pure [returns element] ($poly::element)                   [$geo-bbox-of-polygon $poly]]
[?def within-bbox     scope=public pure [returns bool]    ($p::element $bb::element)         [$geo-within-bbox $p $bb]]
[?def bbox-intersects scope=public pure [returns bool]    ($a::element $b::element)          [$geo-bbox-intersects $a $b]]
[?def bbox-area       scope=public pure [returns float]   ($bb::element $unit::string)       [$geo-bbox-area $bb $unit]]
[?def bbox-expand     scope=public pure [returns element] ($bb::element $by-meters::float)   [$geo-bbox-expand $bb $by-meters]]
[?def bbox-center     scope=public pure [returns element] ($bb::element)                      [$geo-bbox-center $bb]]

[- §3.4 polygon operations -]
[?def polygon-area      scope=public pure [returns float]   ($poly::element $unit::string)   [$geo-polygon-area $poly $unit]]
[?def polygon-perimeter scope=public pure [returns float]   ($poly::element $unit::string)   [$geo-polygon-perimeter $poly $unit]]
[?def polygon-centroid  scope=public pure [returns element] ($poly::element)                  [$geo-polygon-centroid $poly]]
[?def point-in-polygon  scope=public pure [returns bool]    ($p::element $poly::element)      [$geo-point-in-polygon $p $poly]]
[?def polygon-is-valid  scope=public pure [returns bool]    ($poly::element)                  [$geo-polygon-is-valid $poly]]
[?def polygon-is-closed scope=public pure [returns bool]    ($poly::element)                  [$geo-polygon-is-closed $poly]]

[- §3.5 normalization -]
[?def normalize-lat   scope=public pure [returns float]   ($lat::float)   [$geo-normalize-lat $lat]]
[?def normalize-lon   scope=public pure [returns float]   ($lon::float)   [$geo-normalize-lon $lon]]
[?def normalize-point scope=public pure [returns element] ($p::element)    [$geo-normalize-point $p]]
[?def normalize-bbox  scope=public pure [returns element] ($bb::element)   [$geo-normalize-bbox $bb]]
[?def is-valid-lat    scope=public pure [returns bool]    ($lat::float)   [$geo-is-valid-lat $lat]]
[?def is-valid-lon    scope=public pure [returns bool]    ($lon::float)   [$geo-is-valid-lon $lon]]

[- §3.6 WKT format -]
[?def parse-wkt  scope=public pure [returns element] ($s::string)     [$geo-parse-wkt $s]]
[?def format-wkt scope=public pure [returns string]  ($geom::element) [$geo-format-wkt $geom]]

[- §3.7 GeoJSON format -]
[?def parse-geojson  scope=public pure [returns element] ($s::string)     [$geo-parse-geojson $s]]
[?def format-geojson scope=public pure [returns string]  ($geom::element) [$geo-format-geojson $geom]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=geo
  [scope """Coordinate primitives without a new scalar kind — geometries are ordinary CXDM elements. Covers construction of points, bounding boxes, and polygons; distance and bearing (Haversine by default, high-precision Vincenty on demand); bounding-box and polygon operations including area, centroid, and point-in-polygon; WKT and GeoJSON format I/O; and longitude/latitude normalization. All coordinates are WGS84 (EPSG:4326) latitude and longitude in decimal degrees, with no reprojection or alternate coordinate systems."""]]
[fn-doc name=point scope=public purity=pure
  [sig """-> element"""]
  [summary """Construct a point from latitude and longitude; wraps out-of-range longitude and rejects bad latitude."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:point 37.7749 -122.4194]] $p/lat]"""] [expect """37.7749"""]]
]
[fn-doc name=bbox scope=public purity=pure
  [sig """-> element"""]
  [summary """Construct the minimum bounding box enclosing a sequence of points."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:bbox ([$geo:point 37.7 -122.5], [$geo:point 37.85 -122.35])]] $bb/min-lat]"""] [expect """37.7"""]]
]
[fn-doc name=polygon scope=public purity=pure
  [sig """-> element"""]
  [summary """Construct a polygon from an outer ring of points, auto-closing the ring if open."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:polygon-is-closed [$geo:polygon ([$geo:point 37.7 -122.5], [$geo:point 37.7 -122.4], [$geo:point 37.8 -122.4], [$geo:point 37.8 -122.5])]]"""] [expect """true"""]]
]
[fn-doc name=polygon-with-holes scope=public purity=pure
  [sig """-> element"""]
  [summary """Construct a polygon from an outer ring plus interior hole rings."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:polygon-is-closed [$geo:polygon-with-holes ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0]) (([$geo:point 2.0 2.0], [$geo:point 2.0 4.0], [$geo:point 4.0 4.0], [$geo:point 4.0 2.0], [$geo:point 2.0 2.0]))]]"""] [expect """true"""]]
]
[fn-doc name=distance scope=public purity=pure
  [sig """-> float"""]
  [summary """Great-circle distance between two points by the Haversine formula, in the given unit."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:distance [$geo:point 40.7128 -74.0060] [$geo:point 33.9416 -118.4085] "km"]"""] [expect """3944.0"""]]
]
[fn-doc name=distance-vincenty scope=public purity=pure
  [sig """-> float"""]
  [summary """High-precision ellipsoidal distance by Vincenty; may fail to converge for near-antipodal points."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:distance-vincenty [$geo:point 40.7128 -74.0060] [$geo:point 33.9416 -118.4085] "km"]"""] [expect """3960.0"""]]
]
[fn-doc name=bearing scope=public purity=pure
  [sig """-> float"""]
  [summary """Initial bearing from one point to another in degrees, where 0 is north."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:bearing [$geo:point 0.0 0.0] [$geo:point 0.0 1.0]]"""] [expect """90.0"""]]
]
[fn-doc name=destination scope=public purity=pure
  [sig """-> element"""]
  [summary """Compute the endpoint reached from an origin along a bearing for a given distance."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $d [$geo:destination [$geo:point 0.0 0.0] 0.0 100.0 "km"]] $d/lon]"""] [expect """0.0"""]]
]
[fn-doc name=bbox-of scope=public purity=pure
  [sig """-> element"""]
  [summary """Compute the minimum bounding box covering a sequence of points."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:bbox-of ([$geo:point 37.7 -122.5], [$geo:point 37.85 -122.35], [$geo:point 37.8 -122.4])]] $bb/min-lat]"""] [expect """37.7"""]]
]
[fn-doc name=bbox-of-polygon scope=public purity=pure
  [sig """-> element"""]
  [summary """Compute the bounding box enclosing a polygon."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:bbox-of-polygon [$geo:polygon ([$geo:point 37.7 -122.5], [$geo:point 37.7 -122.4], [$geo:point 37.8 -122.4], [$geo:point 37.8 -122.5])]]] $bb/min-lon]"""] [expect """-122.5"""]]
]
[fn-doc name=within-bbox scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a point lies inside a bounding box, handling antimeridian crossing."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:within-bbox [$geo:point 37.75 -122.45] [$geo:bbox ([$geo:point 37.7 -122.5], [$geo:point 37.85 -122.35])]]"""] [expect """true"""]]
]
[fn-doc name=bbox-intersects scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether two bounding boxes overlap."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:bbox-intersects [$geo:bbox ([$geo:point 0.0 0.0], [$geo:point 10.0 10.0])] [$geo:bbox ([$geo:point 5.0 5.0], [$geo:point 15.0 15.0])]]"""] [expect """true"""]]
]
[fn-doc name=bbox-area scope=public purity=pure
  [sig """-> float"""]
  [summary """Compute the area of a bounding box in the given unit."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:bbox-area [$geo:bbox ([$geo:point 5.0 5.0], [$geo:point 5.0 5.0])] "km2"]"""] [expect """0.0"""]]
]
[fn-doc name=bbox-expand scope=public purity=pure
  [sig """-> element"""]
  [summary """Grow a bounding box outward by a distance in meters on every side."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:bbox-expand [$geo:bbox ([$geo:point 37.7 -122.5], [$geo:point 37.85 -122.35])] 0.0]] $bb/min-lat]"""] [expect """37.7"""]]
]
[fn-doc name=bbox-center scope=public purity=pure
  [sig """-> element"""]
  [summary """Compute the center point of a bounding box."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $c [$geo:bbox-center [$geo:bbox ([$geo:point 0.0 0.0], [$geo:point 10.0 20.0])]]] $c/lat]"""] [expect """5.0"""]]
]
[fn-doc name=polygon-area scope=public purity=pure
  [sig """-> float"""]
  [summary """Compute geodesic polygon area on the WGS84 ellipsoid in the given unit; requires a valid polygon."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:polygon-area [$geo:polygon ([$geo:point 0.0 0.0], [$geo:point 0.0 1.0], [$geo:point 0.0 2.0], [$geo:point 0.0 0.0])] "km2"]"""] [expect """cx-err:CXER3602"""]]
]
[fn-doc name=polygon-perimeter scope=public purity=pure
  [sig """-> float"""]
  [summary """Compute the perimeter length of a polygon's outer ring in the given unit."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:polygon-perimeter [$geo:polygon ([$geo:point 5.0 5.0], [$geo:point 5.0 5.0], [$geo:point 5.0 5.0], [$geo:point 5.0 5.0])] "km"]"""] [expect """0.0"""]]
]
[fn-doc name=polygon-centroid scope=public purity=pure
  [sig """-> element"""]
  [summary """Compute the centroid point of a polygon."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $c [$geo:polygon-centroid [$geo:polygon ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0])]]] $c/lat]"""] [expect """5.0"""]]
]
[fn-doc name=point-in-polygon scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a point lies inside a polygon by ray-casting, accounting for holes."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:point-in-polygon [$geo:point 5.0 5.0] [$geo:polygon ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0])]]"""] [expect """true"""]]
]
[fn-doc name=polygon-is-valid scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a polygon passes the full OGC Simple Features validity check."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:polygon-is-valid [$geo:polygon ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0])]]"""] [expect """true"""]]
]
[fn-doc name=polygon-is-closed scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a polygon's rings are closed (each ring's first point equals its last)."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:polygon-is-closed [$geo:polygon ([$geo:point 37.7 -122.5], [$geo:point 37.7 -122.4], [$geo:point 37.8 -122.4], [$geo:point 37.8 -122.5])]]"""] [expect """true"""]]
]
[fn-doc name=normalize-lat scope=public purity=pure
  [sig """-> float"""]
  [summary """Clamp a latitude into [-90, 90] — an explicit, opt-in lossy clamp for raw numeric pipelines."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:normalize-lat 95.0]"""] [expect """90.0"""]]
]
[fn-doc name=normalize-lon scope=public purity=pure
  [sig """-> float"""]
  [summary """Wrap a longitude losslessly into [-180, 180], since longitude is cyclic."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:normalize-lon 190.0]"""] [expect """-170.0"""]]
]
[fn-doc name=normalize-point scope=public purity=pure
  [sig """-> element"""]
  [summary """Normalize a point's coordinates — wrap longitude and clamp latitude into range."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:normalize-point [$geo:point 45.0 190.0]]] $p/lon]"""] [expect """-170.0"""]]
]
[fn-doc name=normalize-bbox scope=public purity=pure
  [sig """-> element"""]
  [summary """Normalize a bounding box's coordinates into valid longitude and latitude ranges."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:normalize-bbox [$geo:bbox ([$geo:point 0.0 170.0], [$geo:point 10.0 190.0])]]] $bb/max-lon]"""] [expect """-170.0"""]]
]
[fn-doc name=is-valid-lat scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a latitude lies within [-90, 90]."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:is-valid-lat 45.0]"""] [expect """true"""]]
]
[fn-doc name=is-valid-lon scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a longitude lies within [-180, 180]."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:is-valid-lon 180.0]"""] [expect """true"""]]
]
[fn-doc name=parse-wkt scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse an OGC Well-Known Text string into a geometry element."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-wkt "POINT(-122.4194 37.7749)"]] $p/lat]"""] [expect """37.7749"""]]
]
[fn-doc name=format-wkt scope=public purity=pure
  [sig """-> string"""]
  [summary """Render a geometry element as an OGC Well-Known Text string."""]
  [example [code """[?lib 'cx-stdlib/geo']
[$geo:format-wkt [$geo:point 37.7749 -122.4194]]"""] [expect """'POINT(-122.4194 37.7749)'"""]]
]
[fn-doc name=parse-geojson scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse an RFC 7946 GeoJSON string into a geometry or feature element."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-geojson "{\"type\":\"Point\",\"coordinates\":[-122.4194,37.7749]}"]] $p/lat]"""] [expect """37.7749"""]]
]
[fn-doc name=format-geojson scope=public purity=pure
  [sig """-> string"""]
  [summary """Render a geometry or feature element as an RFC 7946 GeoJSON string."""]
  [example [code """[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-geojson [$geo:format-geojson [$geo:point 37.7749 -122.4194]]]] $p/lat]"""] [expect """37.7749"""]]
]
