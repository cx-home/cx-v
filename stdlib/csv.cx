[- cx-stdlib/csv — RFC 4180 + Excel-pragmatic CSV / TSV parse and emit.

   Full v0.8.0 public surface per spec/std-lib/csv.md §3. Bodies forward
   to native primitives (vcx/code/stdlib_csv.v): the quote-state tokenizer,
   dialect resolution, and RFC-4180 quoting are not expressible in pure CX.
   Rows round-trip to CXDM maps (header dialect) or positional arrays
   (headerless); all cell values are strings unless coerced via
   parse-with-schema. Errors are values, not control flow: under
   [on-error "collect"] a [csv-result [rows …] [errors …]] is returned.

   NOTE: this const and stdlib/csv.cx are the same source — edit both. -]

[- §3.1 parsing -]
[?def parse              scope=public pure [returns [sequence any]] ($s::string)                       [$csv-parse $s]]
[?def parse-with-dialect scope=public pure [returns [sequence any]] ($s::string $dialect::element)      [$csv-parse-with-dialect $s $dialect]]
[?def parse-with-schema  scope=public pure [returns [sequence any]] ($s::string $schema::map)          [$csv-parse-with-schema $s $schema]]

[- §3.2 emitting -]
[?def emit              scope=public pure [returns string] ($rows::[sequence any])                      [$csv-emit $rows]]
[?def emit-with-dialect scope=public pure [returns string] ($rows::[sequence any] $dialect::element)    [$csv-emit-with-dialect $rows $dialect]]

[- §3.3 built-in dialects -]
[?def dialects-builtin scope=public pure [returns map] ()                                              [$csv-dialects-builtin]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=csv
  [scope """Parse and emit CSV/TSV following RFC 4180 with Excel-pragmatic extensions. Rows round-trip between strings and CXDM records: a header dialect yields maps keyed by header strings, while a headerless dialect yields positional arrays. Dialect handling covers delimiter, quote, escape, and line-terminator, and cell values are strings unless coerced via a schema. Distinct from the cross-format CLI conversion path — this is the in-program library form."""]]
[fn-doc name=parse scope=public purity=pure
  [sig """-> [sequence any]"""]
  [summary """Parse CSV with the default headered dialect into a sequence of maps keyed by header strings."""]
  [example [code """[?lib 'cx-stdlib/csv']
[$count [$csv:parse "email,first_name,score\nalice@example.com,Alice,87"]]"""] [expect """1"""]]
]
[fn-doc name=parse-with-dialect scope=public purity=pure
  [sig """-> [sequence any]"""]
  [summary """Parse a string with a named or fully-specified dialect; the row shape follows the dialect header setting."""]
  [example [code """[?lib 'cx-stdlib/csv']
[?let [= $rows [$csv:parse-with-dialect "a\tb\n1\t2" [dialect [name "tsv"]]]]
      [= $row [$nth $rows 1]]
  $row/a]"""] [expect """'1'"""]]
]
[fn-doc name=parse-with-schema scope=public purity=pure
  [sig """-> [sequence any]"""]
  [summary """Parse CSV and coerce schema-named columns to typed values; absent columns stay strings."""]
  [example [code """[?lib 'cx-stdlib/csv']
[?let [= $rows [$csv:parse-with-schema "score\n87" {score: :int}]]
      [= $row [$nth $rows 1]]
  $row/score]"""] [expect """87"""]]
]
[fn-doc name=emit scope=public purity=pure
  [sig """-> string"""]
  [summary """Emit a sequence of record rows as CSV using the default dialect, quoting and escaping per RFC 4180."""]
  [example [code """[?lib 'cx-stdlib/csv']
[$csv:emit ({a: "1", b: "2"})]"""] [expect """'a,b
1,2
'"""]]
]
[fn-doc name=emit-with-dialect scope=public purity=pure
  [sig """-> string"""]
  [summary """Emit record rows as CSV/TSV using a named or fully-specified dialect."""]
  [example [code """[?lib 'cx-stdlib/csv']
[$csv:emit-with-dialect ({a: "1", b: "2"}) [dialect [name "tsv"]]]"""] [expect """'a	b
1	2
'"""]]
]
[fn-doc name=dialects-builtin scope=public purity=pure
  [sig """-> map"""]
  [summary """Return the seven built-in dialects (csv, tsv, psv, excel, excel-tab, unix, headless) keyed by name."""]
  [example [code """[?lib 'cx-stdlib/csv']
[$count [$keys [$csv:dialects-builtin]]]"""] [expect """7"""]]
]
