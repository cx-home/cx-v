[- cx-stdlib/ft — fulltext search with structured ranking.

   Full v0.8.0 public surface per spec/std-lib/ft.md §3. Bodies forward to
   native primitives (vcx/code/stdlib_ft.v): an inverted index, the
   UAX-#29 segmentation + Porter2 stemming pipeline, TF-IDF / BM25 scoring,
   boolean / phrase / field query evaluation, and snippet extraction are
   not expressible in pure CX. An Index is an opaque in-memory value
   ([ft-index handle=N]) rebuilt per program run (§1). Errors are values
   (CXER1200..CXER1204, §7).

   The custom-tokenizer path of index-with-opts (§4.4) applies a CX closure
   per doc and is handled by the env-aware native hook; all other surfaces
   route through the env-free primitive chain.

   NOTE: this const and stdlib/ft.cx are the same source — edit both. -]

[- §3.1 building an index -]
[?def index           scope=public pure [returns element] ($docs::[sequence any])              [$ft-index $docs]]
[?def index-with-opts scope=public pure [returns element] ($docs::[sequence any] $opts::map)   [$ft-index-with-opts $docs $opts]]

[- §3.2 searching -]
[?def search           scope=public pure [returns [sequence element]] ($idx::element $query::string $limit::int) [$ft-search $idx $query $limit]]
[?def search-with-opts scope=public pure [returns [sequence element]] ($idx::element $query::string $opts::map)  [$ft-search-with-opts $idx $query $opts]]

[- §3.3 store-integrated search -]
[?def search-store scope=public impure [returns [sequence element]] ($store::element $query::string $limit::int) [$ft-search-store $store $query $limit]]

[- §3.4 snippets -]
[?def snippet           scope=public pure [returns string] ($doc::any $query::string $context-chars::int) [$ft-snippet $doc $query $context-chars]]
[?def snippet-with-opts scope=public pure [returns string] ($doc::any $query::string $opts::map)          [$ft-snippet-with-opts $doc $query $opts]]

[- §3.5 tokenizer access -]
[?def tokenize scope=public pure [returns [sequence string]] ($text::string $language::string) [$ft-tokenize $text $language]]

[- §3.6 result helpers -]
[?def doc-ids  scope=public pure [returns [sequence string]] ($results::[sequence element]) [$ft-doc-ids $results]]
[?def score-of scope=public pure [returns float]             ($result::element)             [$ft-score-of $result]]

[- §3.7 index introspection -]
[?def index-stats scope=public pure [returns map] ($idx::element) [$ft-index-stats $idx]]

[- co-located docs (seeded — refine in place). -]
[module-doc name=ft
  [scope """In-program fulltext search with structured ranking and snippet generation. Builds a naive in-memory inverted index from a document set or a store, then runs a query language (keyword conjunctions, phrases, boolean operators, field restriction) ranked by TF-IDF (default) or BM25. The tokenization pipeline — Unicode word segmentation, case folding, stopword removal, and English stemming — runs entirely inside the process, with no persistent index and no external engine. The Index is an opaque in-memory value rebuilt per run."""]]
[fn-doc name=index scope=public purity=pure
  [sig """-> element"""]
  [summary """Build an Index over a sequence of documents using the default tokenization pipeline."""]
  [example [code """[?lib 'cx-stdlib/ft']
[$ft:index-stats [$ft:index ()]]"""] [expect """{doc-count: 0, term-count: 0, size-bytes: 0, languages: ()}"""]]
]
[fn-doc name=index-with-opts scope=public purity=pure
  [sig """-> element"""]
  [summary """Build an Index with explicit options for language, stopwords, stemmer, tokenizer, and fields."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index-with-opts ([doc [title "Database design"] [body "schemas and indexes"]]) {"fields" ("title")}]]
  [$ft:search $idx "body:schemas" 10]]"""] [expect """cx-err:CXER1202"""]]
]
[fn-doc name=search scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Run a query against an Index and return up to limit ranked result elements."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc "database design"], [doc "schema migrations"])]]
  [$ft:search $idx "" 10]]"""] [expect """()"""]]
]
[fn-doc name=search-with-opts scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """Search with options for scoring mode, limit, offset, min-score, and query tokenization."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="d1" "database one"], [doc id="d2" "database two"], [doc id="d3" "database three"])]]
  [$count [$ft:search-with-opts $idx "database" {limit: 2}]]]"""] [expect """2"""]]
]
[fn-doc name=search-store scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Build an Index from a store's documents and search it in one call."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?lib 'cx-stdlib/store']
[?let [= $store [$store:open "mem:///ft-conformance"]]
  [?let [= $_ [$store:put-doc $store [doc id="d1" "database design and analytics"]]]
    [$ft:doc-ids [$ft:search-store $store "database" 10]]]]"""] [expect """('d1')"""]]
]
[fn-doc name=snippet scope=public purity=pure
  [sig """-> string"""]
  [summary """Extract a context window around query matches, wrapping each match in <mark> tags."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?lib 'cx-stdlib/strings']
[$strings:contains [$ft:snippet [doc "the database design covers schemas and indexes"] "database" 80] "<mark>"]"""] [expect """true"""]]
]
[fn-doc name=snippet-with-opts scope=public purity=pure
  [sig """-> string"""]
  [summary """Extract snippets with options for context size, count, ellipsis, and mark delimiters."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?lib 'cx-stdlib/strings']
[$strings:contains [$ft:snippet-with-opts [doc "the database design covers schemas"] "database" {mark-prefix: "[[", mark-suffix: "]]"}] "[[database]]"]"""] [expect """true"""]]
]
[fn-doc name=tokenize scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Run the default pipeline over text and return its token sequence — useful for debugging alignment."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?lib 'cx-stdlib/strings']
[$contains [$ft:tokenize "the cat in the hat" "en"] "the"]"""] [expect """false"""]]
]
[fn-doc name=doc-ids scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """Extract the document IDs from a sequence of search results."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="d1" "database design and analytics"], [doc id="d2" "kitchen recipes for soup"])]]
  [$ft:doc-ids [$ft:search $idx "database" 10]]]"""] [expect """('d1')"""]]
]
[fn-doc name=score-of scope=public purity=pure
  [sig """-> float"""]
  [summary """Extract the relevance score from a single search result."""]
  [example [code """[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="d1" "database design"])]]
  [?let [= $results [$ft:search $idx "database" 10]]
    [$gte [$ft:score-of [$first $results]] 0.0]]]"""] [expect """true"""]]
]
[fn-doc name=index-stats scope=public purity=pure
  [sig """-> map"""]
  [summary """Report Index statistics — document count, term count, byte size, and languages."""]
  [example [code """[?lib 'cx-stdlib/ft']
[$ft:index-stats [$ft:index ()]]"""] [expect """{doc-count: 0, term-count: 0, size-bytes: 0, languages: ()}"""]]
]
