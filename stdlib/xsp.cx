[; cx-stdlib/xsp — the XAP Stream Protocol frame codec (spec/03-approved/xap/xsp.md).
   XSP carries XAP over any transport: a self-describing, self-delimiting frame
   [version · type · stream-id · principal-DID · flags · len · payload]. The
   payload is opaque bytes; the canonical binary encoding dogfoods CX `data-bin`.
   Identity is orthogonal to transport — the `principal` field names a DID
   (#26 / xap.md §22.1); verification & authorization are separate concerns.
   Bodies bottom out in the xsp-* native primitives (vcx/code/stdlib_xsp.v). ]

[; encode: a [frame type=… stream=… principal=… eos=…? binary=…? [payload V]]
   element → wire bytes. binary=true (default) data-bin-encodes the payload
   value; binary=false encodes a text (string) payload as UTF-8. ]
[?def encode      scope=public pure [returns bytes]    ($frame::element)  [$xsp-encode $frame]]

[; decode: ONE frame at offset 0 → a [frame …] element (attrs version/type/
   stream/principal/eos/binary/consumed + a [payload V] child). `consumed` is
   the total frame length, so a reader advances to the next frame. ]
[?def decode      scope=public pure [returns element]  ($bytes::bytes)    [$xsp-decode $bytes]]

[; decode-all: a buffer of concatenated frames → a [frames …] element whose
   children are the parsed [frame …] elements (navigable via $fs//frame /
   [$count $fs] / [?for]); a trailing partial frame is a [remainder …] child. ]
[?def decode-all  scope=public pure [returns element]  ($bytes::bytes)    [$xsp-decode-all $bytes]]

[; ── XSP-AUTH — the mutual proof-of-control handshake calculus ─────────────
   (spec/03-approved/xap/xap_identity_model.md §4). SIGMA-style signed ephemeral
   X25519 over four messages (hello → challenge → prove → confirm) riding
   ordinary XSP v1 frames on stream 0. Every function here is PURE — nonces
   and ephemeral keypairs are generated by the impure caller (crypto:
   x25519-keypair / random:crypto-bytes) and injected, the did.md §6 split.
   Bodies bottom out in xsp-auth-* natives (vcx/code/stdlib_xsp_auth.v). ]

[; auth-hello: build M1. $opts: nonce (32B), eph (32B X25519 pub), endpoint
   (string; '' on in-process channels), did? (initiator DID; absent =
   anonymous, §4.7). ]
[?def auth-hello      scope=public pure [returns element] ($opts::map)
  [$xsp-auth-hello $opts]]

[; auth-challenge: responder side — validate M1, build + sign M2. $opts:
   did (responder DID — never anonymous, N-IDENT-2), nonce (32B), eph (32B),
   key (32B Ed25519 seed), cb? (channel-binding bytes, default empty). ]
[?def auth-challenge  scope=public pure [returns element] ($m1::element $opts::map)
  [$xsp-auth-challenge $m1 $opts]]

[; auth-prove: initiator side — verify M2 (version, cb, responder signature),
   derive keys, build M3. $opts: eph-priv (32B), attach ([attach …] element),
   cb? (initiator's computed binding value), responder-key? (32B Ed25519 pub;
   required unless the responder DID resolves offline), did? + key?
   (initiator DID + seed; both absent = anonymous). ]
[?def auth-prove      scope=public pure [returns element] ($m1::element $m2::element $opts::map)
  [$xsp-auth-prove $m1 $m2 $opts]]

[; auth-confirm: responder side — verify M3 (tag; signature when a DID is
   claimed), build M4. $opts: eph-priv (32B), session (element to return),
   initiator-key? (32B pub), require-mutual? (bool — refuse anonymous). ]
[?def auth-confirm    scope=public pure [returns element] ($m1::element $m2::element $m3::element $opts::map)
  [$xsp-auth-confirm $m1 $m2 $m3 $opts]]

[; auth-finish: initiator side — verify M4's responder key-confirmation tag;
   returns [xsp-auth-established responder=… chan-id=… [session …]].
   $opts: eph-priv (32B). ]
[?def auth-finish     scope=public pure [returns element] ($m1::element $m2::element $m4::element $opts::map)
  [$xsp-auth-finish $m1 $m2 $m4 $opts]]

[; auth-transcript: the §4.4 transcript element (M2's [sig] stripped) —
   fixture/debug surface. ]
[?def auth-transcript scope=public pure [returns element] ($m1::element $m2::element)
  [$xsp-auth-transcript $m1 $m2]]

[; auth-keys: the §4.5 HKDF schedule → [xsp-auth-keys [tag-i][tag-r]
   [proof-i][proof-r][chan-id]]. Both sides derive identical values. ]
[?def auth-keys       scope=public pure [returns element] ($eph-priv::bytes $peer-eph::bytes $nonce-i::bytes $nonce-r::bytes)
  [$xsp-auth-keys $eph-priv $peer-eph $nonce-i $nonce-r]]

[; auth-verify: low-level transcript-signature check ($role initiator |
   responder; role=initiator requires the responder signature). ]
[?def auth-verify     scope=public pure [returns bool]    ($role::string $transcript::element $sig::string $key::bytes $responder-sig::string '')
  [$xsp-auth-verify $role $transcript $sig $key $responder-sig]]

[; auth-rotate / auth-rotate-verify: the §6.3 in-band did:web key-rotation
   continuity proof — the OUTGOING key signs the incoming DID bound to the prior
   channel id, so a verifier learns the new key's holder provably held the old.
   Paired with a fresh handshake under the new key, this is the dual-signed
   rotation that lets a live session + its streams survive a mid-session
   rotation; a failed verify is the caller's CXER-XSP-AUTH-ROTATE. ]
[; old-key is the outgoing verification key for a did:web rotator (resolve the
   old document first); pass empty bytes to force offline recovery for a
   self-describing did:key/did:peer old DID. ]
[?def auth-rotate        scope=public pure [returns element] ($old-seed::bytes $new-did::string $prior-chan::string)
  [$xsp-auth-rotate $old-seed $new-did $prior-chan]]
[?def auth-rotate-verify scope=public pure [returns bool]    ($rotation::element $old-did::string $old-key::bytes)
  [$xsp-auth-rotate-verify $rotation $old-did $old-key]]

[; auth-frame-check: the §4.8 post-handshake binding rule that demotes the
   XSP `principal` field to a checked label. Given the authenticated session
   principal and a decoded [frame …] (or a principal string), returns the
   principal the frame commits under: an empty (principal-len 0) frame INHERITS
   the session principal; a non-empty principal MUST equal it or the frame is
   rejected with CXER-XSP-AUTH-PRINCIPAL-MISMATCH (never reaches the bus). ]
[?def auth-frame-check  scope=public pure [returns string] ($session-principal::string $frame::element)
  [$xsp-auth-frame-check $session-principal $frame]]

[; auth-proof / auth-proof-verify: the §4.8 per-request possession proof for
   request/response transports — HMAC(key, counter-be8 ‖ sha256(frame)). ]
[?def auth-proof        scope=public pure [returns bytes] ($key::bytes $counter::int $frame::bytes)
  [$xsp-auth-proof $key $counter $frame]]
[?def auth-proof-verify scope=public pure [returns bool]  ($key::bytes $counter::int $frame::bytes $proof::bytes)
  [$xsp-auth-proof-verify $key $counter $frame $proof]]

[; co-located docs. ]
[module-doc name=xsp
  [scope """The XAP Stream Protocol frame codec — a self-describing, self-delimiting frame [version · type · stream-id · principal-DID · flags · len · payload] that carries XAP over any transport. The payload is opaque bytes and the canonical binary encoding dogfoods CX `data-bin`. Identity is orthogonal to transport: the `principal` field names a DID, while verification and authorization remain separate concerns."""]]
[fn-doc name=encode scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Encode a [frame …] element into wire bytes, data-bin-encoding the payload by default or UTF-8-encoding it when binary=false."""]
]
[fn-doc name=decode scope=public purity=pure
  [sig """-> element"""]
  [summary """Decode one frame at offset 0 into a [frame …] element whose `consumed` attr is the total frame length so a reader can advance to the next frame."""]
]
[fn-doc name=decode-all scope=public purity=pure
  [sig """-> element"""]
  [summary """Decode a buffer of concatenated frames into a [frames …] element whose children are the parsed [frame …] elements, with any trailing partial frame as a [remainder …] child."""]
]
[fn-doc name=auth-hello scope=public purity=pure
  [sig """-> element"""]
  [summary """Build the XSP-AUTH M1 hello from injected randomness (nonce, ephemeral X25519 public key), the dialed endpoint, and an optional initiator DID (absent = anonymous)."""]
]
[fn-doc name=auth-challenge scope=public purity=pure
  [sig """-> element"""]
  [summary """Responder side: validate M1 and build M2, signing the role-pinned transcript with the responder's Ed25519 seed — there is no anonymous responder."""]
]
[fn-doc name=auth-prove scope=public purity=pure
  [sig """-> element"""]
  [summary """Initiator side: verify M2 (selected version, channel-binding equality, responder transcript signature), derive the key schedule, and build M3 with the key-confirmation tag, the attach request, and — when a DID is claimed — the initiator transcript signature."""]
]
[fn-doc name=auth-confirm scope=public purity=pure
  [sig """-> element"""]
  [summary """Responder side: verify M3 (initiator tag; transcript signature when a DID is claimed; anonymous refused under require-mutual), then build M4 carrying the responder key-confirmation tag and the attach result session."""]
]
[fn-doc name=auth-finish scope=public purity=pure
  [sig """-> element"""]
  [summary """Initiator side: verify M4's responder key-confirmation tag and return the [xsp-auth-established …] report with the responder DID, channel id, and bound session."""]
]
[fn-doc name=auth-transcript scope=public purity=pure
  [sig """-> element"""]
  [summary """Assemble the signed transcript element — M1 verbatim plus M2 with its [sig] child stripped — the exact subject of both handshake signatures."""]
]
[fn-doc name=auth-keys scope=public purity=pure
  [sig """-> element"""]
  [summary """Derive the HKDF key schedule (confirmation tags, per-direction proof keys, channel id) from the ephemeral X25519 shared secret salted by both nonces; both sides derive identical values."""]
]
[fn-doc name=auth-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Low-level transcript-signature check for one role; the initiator role additionally covers the responder's signature (transcript closure)."""]
]
[fn-doc name=auth-rotate scope=public purity=pure
  [sig """-> element"""]
  [summary """Produce a §6.3 rotation continuity proof: the outgoing key signs the incoming DID bound to the prior channel id, attesting the new key's holder held the old."""]
]
[fn-doc name=auth-rotate-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify a rotation continuity proof against the outgoing key (offline-recovered from a did:key/did:peer old DID, or supplied for did:web)."""]
]
[fn-doc name=auth-frame-check scope=public purity=pure
  [sig """-> string"""]
  [summary """Enforce the §4.8 post-handshake binding: an empty-principal frame inherits the session principal; a non-empty principal must equal it or the frame is rejected — the rule that makes the XSP principal field a checked label, never an identity source."""]
]
[fn-doc name=auth-proof scope=public purity=pure
  [sig """-> bytes"""]
  [summary """Compute the per-request possession proof for request/response transports: HMAC(key, counter-be8 concatenated with sha256(frame-bytes))."""]
]
[fn-doc name=auth-proof-verify scope=public purity=pure
  [sig """-> bool"""]
  [summary """Verify a per-request possession proof in constant time; a counter below 1 never verifies."""]
]
