[; cx-stdlib/journal — append-only, hash-chained, tenant-partitioned event
   log + deterministic fold→state, built ON store (persistence) + hash (chain
   links) + crypto (snapshot signing). Thin: ordered append + fold + verify.

   A committed entry is a present [entry] VALUE; a failed-precondition append
   is [err]; an empty/out-of-range read is absence (); a verify of a corrupt
   chain is a present [verification valid=false …] FINDING (not [err]). The
   fold/replay/dry-run/snapshot/fold-from reducers MUST be pure (CXER4611).
   journal adds NO new capability — persistence is gated by store. ]

[?def open           scope=public impure [returns element]            ($store-url::string $tenant::string $opts::map {}) [$journal-open $store-url $tenant $opts]]
[?def attach         scope=public impure [returns element]            ($store::element $tenant::string $opts::map {})    [$journal-attach $store $tenant $opts]]
[?def close          scope=public impure [returns null]               ($journal::element)                                [$journal-close $journal]]
[?def append         scope=public impure [returns element]            ($journal::element $event::any $attribution::map)  [$journal-append $journal $event $attribution]]
[?def read           scope=public impure [returns element]            ($journal::element $seq::int $stream::string "")            [$journal-read $journal $seq $stream]]
[?def slice          scope=public impure [returns [sequence element]] ($journal::element $from::int $to::int $stream::string "") [$journal-slice $journal $from $to $stream]]
[?def since          scope=public impure [returns [sequence element]] ($journal::element $from::int $stream::string "")          [$journal-since $journal $from $stream]]
[?def query          scope=public impure [returns [sequence element]] ($journal::element $cxpath::path)                  [$journal-query $journal $cxpath]]
[?def head           scope=public pure   [returns element]            ($journal::element $stream::string "")                      [$journal-head $journal $stream]]
[?def streams        scope=public impure [returns [sequence element]] ($journal::element)                                [$journal-streams $journal]]
[?def fold           scope=public impure [returns any]                ($journal::element $fn $init::any $stream::string "")                 [$journal-fold $journal $fn $init $stream]]
[?def fold-slice     scope=public impure [returns any]                ($journal::element $fn $init::any $from::int $to::int $stream::string "") [$journal-fold-slice $journal $fn $init $from $to $stream]]
[?def fold-value     scope=public pure   [returns any]                ($entries::[sequence element] $fn $init::any)      [$journal-fold-value $entries $fn $init]]
[?def replay         scope=public impure [returns any]                ($journal::element $fn $init::any $opts::map {})   [$journal-replay $journal $fn $init $opts]]
[?def dry-run        scope=public impure [returns element]            ($journal::element $event::any $attribution::map $fn $init::any) [$journal-dry-run $journal $event $attribution $fn $init]]
[?def verify         scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-verify $journal $opts]]
[?def verify-slice   scope=public impure [returns element]            ($journal::element $from::int $to::int)            [$journal-verify-slice $journal $from $to]]
[?def snapshot       scope=public impure [returns element]            ($journal::element $fn $init::any $opts::map {})   [$journal-snapshot $journal $fn $init $opts]]
[?def snapshot-verify scope=public impure [returns element]           ($journal::element $snapshot::element)             [$journal-snapshot-verify $journal $snapshot]]
[?def fold-from      scope=public impure [returns any]                ($journal::element $snapshot::element $fn)         [$journal-fold-from $journal $snapshot $fn]]
[?def retain         scope=public impure [returns element]            ($journal::element $policy::map)                   [$journal-retain $journal $policy]]
[?def compact        scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-compact $journal $opts]]

[; co-located docs (seeded — refine in place). ]
[module-doc name=journal
  [scope """An append-only, hash-chained, tenant-partitioned event log and the deterministic projection of that log into state. Open or attach a journal over a `store` backend, `append` attributed events (each returning a committed `[entry]` with its sequence, content hash, and predecessor link), `read` / `slice` / `query` ranges, and `fold` the log into a state projection. The chain is deterministic — replayable, dry-runnable, and hash-verifiable — which is the entire reason it exists. `snapshot`, `retain`, and `compact` accelerate and bound replay as derived artifacts; they never edit the live chain, so append-only and chain integrity hold permanently."""]]
[fn-doc name=open scope=public purity=impure
  [sig """-> element"""]
  [summary """Open a journal over a `store` backend URL for one tenant, creating or attaching to its hash chain."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://acme" "acme"]]
  [$journal:append $j [do :refund] {actor: "ops" authority: "d-77"}]]"""] [expect """[entry seq=1 tenant=acme actor=ops authority=d-77 ts='epoch:00:00:01' prev-hash=b3:GENESIS hash=sha256:bdc6c60e64d8bc43a17fc1762633a915d8816ca2dffd429b45ce19dda82d6178 [event [do :refund]]]"""]]
]
[fn-doc name=attach scope=public purity=impure
  [sig """-> element"""]
  [summary """Attach a journal to an already-open `store` handle for one tenant, reusing its connection."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?let [= $s [$store:open "mem://r"]]
[?let [= $j1 [$journal:attach $s "acme"]]
[?let [= $a [$journal:append $j1 [a 1] {actor: "u" authority: "g"}]]
[?let [= $b [$journal:append $j1 [b 2] {actor: "u" authority: "g"}]]
[?let [= $c [$journal:close $j1]]
[?let [= $j2 [$journal:attach $s "acme"]]
  [$journal:verify $j2]]]]]]]"""] [expect """[verification valid=true checked-from=1 checked-to=2 head-hash='sha256:2bcb8230b14039e30cc935fb9af79aa4047d317167b0e6edb95e674a82b7e8c2']"""]]
]
[fn-doc name=close scope=public purity=impure
  [sig """-> null"""]
  [summary """Close the journal handle; subsequent operations on it raise CXER4612."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $x [$journal:close $j]]
  [$journal:append $j [a] {actor: "u" authority: "g"}]]]"""] [expect """cx-err:CXER4612"""]]
]
[fn-doc name=append scope=public purity=impure
  [sig """-> element"""]
  [summary """Commit an attributed event, returning the new `[entry]` with its seq, content hash, and predecessor link."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://acme" "acme"]]
  [$journal:append $j [do :refund] {actor: "ops" authority: "d-77"}]]"""] [expect """[entry seq=1 tenant=acme actor=ops authority=d-77 ts='epoch:00:00:01' prev-hash=b3:GENESIS hash=sha256:bdc6c60e64d8bc43a17fc1762633a915d8816ca2dffd429b45ce19dda82d6178 [event [do :refund]]]"""]]
]
[fn-doc name=read scope=public purity=impure
  [sig """-> element"""]
  [summary """Return the single `[entry]` at `seq`, or the absence channel if out of range."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b 2] {actor: "u" authority: "g"}]]
  [$journal:read $j 2]]]]"""] [expect """[entry seq=2 tenant=acme actor=u authority=g ts='epoch:00:00:02' prev-hash=sha256:f0d42b6c75733de803ac02bb66eecf005add595cadca2f7151f1c682ecb440d0 hash='sha256:2bcb8230b14039e30cc935fb9af79aa4047d317167b0e6edb95e674a82b7e8c2' [event [b 2]]]"""]]
]
[fn-doc name=slice scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return the entries with `from ≤ seq ≤ to` (inclusive, 1-based), in sequence order."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:slice $j 2 3]]]]]"""] [expect """([entry seq=2 tenant=acme actor=u authority=g ts='epoch:00:00:02' prev-hash='sha256:117af1f326b2d1ee4d4b56b66b3fa13dabfbc55045e4cc57740c7c5f026f163d' hash='sha256:9cd1fca3841e0ea3f6db09fc032c901cd1f9b84a7089ebb90c82753c06ef56aa' [event [b]]], [entry seq=3 tenant=acme actor=u authority=g ts='epoch:00:00:03' prev-hash='sha256:9cd1fca3841e0ea3f6db09fc032c901cd1f9b84a7089ebb90c82753c06ef56aa' hash='sha256:6c29ae866f4b35ead2bc4de4bb388382d1c4542ec46828c568a0d63f60117c43' [event [c]]])"""]]
]
[fn-doc name=since scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return the tail of the log from `from` to the current head."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
  [$journal:since $j 2]]]]"""] [expect """([entry seq=2 tenant=acme actor=u authority=g ts='epoch:00:00:02' prev-hash='sha256:117af1f326b2d1ee4d4b56b66b3fa13dabfbc55045e4cc57740c7c5f026f163d' hash='sha256:9cd1fca3841e0ea3f6db09fc032c901cd1f9b84a7089ebb90c82753c06ef56aa' [event [b]]])"""]]
]
[fn-doc name=query scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return the entries whose `[event …]` payload or envelope matches a CXPath filter."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [do :refund] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [note "hi"] {actor: "u" authority: "g"}]]
  [$journal:query $j "/event/do"]]]]"""] [expect """([entry seq=1 tenant=acme actor=u authority=g ts='epoch:00:00:01' prev-hash=b3:GENESIS hash=sha256:fcd34ab5565c2823273d24922fe5e7b53d3ffe02fd62695a99b214d409933c30 [event [do :refund]]])"""]]
]
[fn-doc name=head scope=public purity=pure
  [sig """-> element"""]
  [summary """Return the current head `[entry]`, or absence if the log is empty (pure — reads the cached head)."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
  [$journal:head $j]]"""] [expect """()"""]]
]
[fn-doc name=streams scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """List the distinct stream names present in the journal."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $a [$journal:append $j [x 1] {actor: "u" authority: "g" stream: "s1"}]]
[?let [= $b [$journal:append $j [x 2] {actor: "u" authority: "g" stream: "s1"}]]
[?let [= $c [$journal:append $j [y 1] {actor: "u" authority: "g" stream: "s2"}]]
  [$journal:streams $j]]]]]"""] [expect """('s1', 's2')"""]]
]
[fn-doc name=fold scope=public purity=impure
  [sig """-> any"""]
  [summary """Fold the whole log into a state projection with a pure reducer and initial value."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:fold $j [?fn ($a $e) [+ $a 1]] 0]]]]]"""] [expect """3"""]]
]
[fn-doc name=fold-slice scope=public purity=impure
  [sig """-> any"""]
  [summary """Fold a `from..to` range of the log into a state projection."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:fold-slice $j [?fn ($a $e) [+ $a 1]] 0 2 3]]]]]"""] [expect """2"""]]
]
[fn-doc name=fold-value scope=public purity=pure
  [sig """-> any"""]
  [summary """Fold an already-read entry sequence into state, without touching the journal."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $es [$journal:since $j 1]]
  [$journal:fold-value $es [?fn ($a $e) [+ $a 10]] 0]]]]]"""] [expect """20"""]]
]
[fn-doc name=replay scope=public purity=impure
  [sig """-> any"""]
  [summary """Deterministically re-execute the log into state, honouring replay options such as `at-seq`."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:replay $j [?fn ($a $e) [+ $a 1]] 0 {at-seq: 2}]]]]]"""] [expect """2"""]]
]
[fn-doc name=dry-run scope=public purity=impure
  [sig """-> element"""]
  [summary """Preview the state and `[entry]` an append would produce, without committing it."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
  [$journal:dry-run $j [b] {actor: "u" authority: "g"} [?fn ($a $e) [+ $a 1]] 0]]]"""] [expect """[dry-run [state 2] [entry seq=2 tenant=acme actor=u authority=g ts='epoch:00:00:02' prev-hash='sha256:117af1f326b2d1ee4d4b56b66b3fa13dabfbc55045e4cc57740c7c5f026f163d' hash='sha256:9cd1fca3841e0ea3f6db09fc032c901cd1f9b84a7089ebb90c82753c06ef56aa' [event [b]]]]"""]]
]
[fn-doc name=verify scope=public purity=impure
  [sig """-> element"""]
  [summary """Verify hash-chain integrity end to end, returning a `[verification]` finding (not an error on corruption)."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
  [$journal:verify $j {}]]]]"""] [expect """[verification valid=true checked-from=1 checked-to=2 head-hash='sha256:9cd1fca3841e0ea3f6db09fc032c901cd1f9b84a7089ebb90c82753c06ef56aa']"""]]
]
[fn-doc name=verify-slice scope=public purity=impure
  [sig """-> element"""]
  [summary """Verify hash-chain integrity over a `from..to` range."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:verify-slice $j 2 3]]]]]"""] [expect """[verification valid=true checked-from=2 checked-to=3 head-hash='sha256:6c29ae866f4b35ead2bc4de4bb388382d1c4542ec46828c568a0d63f60117c43']"""]]
]
[fn-doc name=snapshot scope=public purity=impure
  [sig """-> element"""]
  [summary """Fold the log up to a sequence into a signed, derived state checkpoint so fold need not re-run from genesis."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
  [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {sign: "false"}]]]"""] [expect """[snapshot tenant=acme at-seq=1 anchor-hash='sha256:117af1f326b2d1ee4d4b56b66b3fa13dabfbc55045e4cc57740c7c5f026f163d' hash-algo=sha256 sig-algo=none [state 1]]"""]]
]
[fn-doc name=snapshot-verify scope=public purity=impure
  [sig """-> element"""]
  [summary """Check a `[snapshot]` against the chain and against its own signature."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $bad [snapshot tenant=acme at-seq=1 anchor-hash="sha256:deadbeef" hash-algo=sha256 sig-algo=none [state 99]]]
  [$journal:snapshot-verify $j $bad]]]]"""] [expect """[snapshot-verification valid=false at-seq=1 reason=':anchor-mismatch']"""]]
]
[fn-doc name=fold-from scope=public purity=impure
  [sig """-> any"""]
  [summary """Reconstruct state fast: verify a snapshot, then fold only the tail of entries after it."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
[?let [= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {sign: "false" at-seq: 1}]]
[?let [= $full [$journal:fold $j [?fn ($a $e) [+ $a 1]] 0]]
[?let [= $fast [$journal:fold-from $j $snap [?fn ($a $e) [+ $a 1]]]]
  [equiv full=$full fast=$fast]]]]]]]]"""] [expect """[equiv full=3 fast=3]"""]]
]
[fn-doc name=retain scope=public purity=impure
  [sig """-> element"""]
  [summary """Record a prune-behind-a-snapshot `[retention]` policy and check its snapshot coverage; deletes nothing."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {signing-key: "0101010101010101010101010101010101010101010101010101010101010101" at-seq: 2}]]
  [$journal:retain $j {keep-after-seq: 2 snapshot: $snap}]]]]]"""] [expect """[retention boundary=2 covered-by-seq=2]"""]]
]
[fn-doc name=compact scope=public purity=impure
  [sig """-> element"""]
  [summary """Copy a snapshot plus the retained tail forward into a new segment, leaving the source chain intact."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://src" "acme"]]
[?let [= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[?let [= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[?let [= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
[?let [= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {signing-key: "0101010101010101010101010101010101010101010101010101010101010101" at-seq: 2}]]
[?let [= $ret [$journal:retain $j {keep-after-seq: 2 snapshot: $snap}]]
[?let [= $seg [$journal:compact $j {retention: $ret target: "mem://seg"}]]
  [$journal:verify $j {}]]]]]]]]"""] [expect """[verification valid=true checked-from=1 checked-to=3 head-hash='sha256:6c29ae866f4b35ead2bc4de4bb388382d1c4542ec46828c568a0d63f60117c43']"""]]
]
