[; cx-stdlib/journal — append-only, hash-chained, tenant-partitioned event
   log + deterministic fold→state, built ON store (persistence) + hash (chain
   links) + crypto (snapshot signing). Thin: ordered append + fold + verify.

   A committed entry is a present [entry] VALUE; a failed-precondition append
   is [err]; an empty/out-of-range read is absence (); a verify of a corrupt
   chain is a present [verification valid=false …] FINDING (not [err]). The
   fold/replay/dry-run/snapshot/fold-from reducers MUST be pure (CXER4611).
   journal adds NO new capability — persistence is gated by store. ]

[?def open           scope=public impure [returns element]            ($store-url::string $tenant::string $opts::map {}) [$journal-open $store-url $tenant $opts]]
[?def attach         scope=public impure [returns element]            ($store::element $tenant::string $opts::map {})    [$journal-attach $store $tenant $opts]]
[?def close          scope=public impure [returns null]               ($journal::element)                                [$journal-close $journal]]
[?def append         scope=public impure [returns element]            ($journal::element $event::any $attribution::map)  [$journal-append $journal $event $attribution]]
[?def read           scope=public impure [returns element]            ($journal::element $seq::int $stream::string "")            [$journal-read $journal $seq $stream]]
[?def slice          scope=public impure [returns [sequence element]] ($journal::element $from::int $to::int $stream::string "" $opts::map {}) [$journal-slice $journal $from $to $stream $opts]]
[?def since          scope=public impure [returns [sequence element]] ($journal::element $from::int $stream::string "" $opts::map {})          [$journal-since $journal $from $stream $opts]]
[?def query          scope=public impure [returns [sequence element]] ($journal::element $cxpath::path)                  [$journal-query $journal $cxpath]]
[?def source         scope=public impure [returns [sequence element]] ($journal::element $stream::string "")                     [$journal-source $journal $stream]]
[?def head           scope=public pure   [returns element]            ($journal::element $stream::string "")                      [$journal-head $journal $stream]]
[?def head-fresh     scope=public impure [returns element]            ($journal::element $stream::string "")                      [$journal-head-fresh $journal $stream]]
[?def subscribe      scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-subscribe $journal $opts]]
[?def seq-at         scope=public impure [returns element]            ($journal::element $ts::any $opts::map {})         [$journal-seq-at $journal $ts $opts]]
[?def streams        scope=public impure [returns [sequence element]] ($journal::element)                                [$journal-streams $journal]]
[?def fold           scope=public impure [returns any]                ($journal::element $fn $init::any $stream::string "" $opts::map {})                 [$journal-fold $journal $fn $init $stream $opts]]
[?def fold-slice     scope=public impure [returns any]                ($journal::element $fn $init::any $from::int $to::int $stream::string "") [$journal-fold-slice $journal $fn $init $from $to $stream]]
[?def fold-value     scope=public pure   [returns any]                ($entries::[sequence element] $fn $init::any)      [$journal-fold-value $entries $fn $init]]
[?def temporal-slice scope=public pure   [returns [sequence element]] ($entries::[sequence element] $opts::map {})       [$journal-temporal-slice $entries $opts]]
[?def upcast         scope=public pure   [returns [sequence element]] ($entries::[sequence element] $chain)              [$journal-upcast $entries $chain]]
[?def lineage-path   scope=public pure   [returns [sequence element]] ($claims::[sequence element] $from::string $to::string) [$journal-lineage-path $claims $from $to]]
[?def legal-holds    scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-legal-holds $journal $opts]]
[?def erase-subject  scope=public impure [effects [read] [write]] [returns element] ($journal::element $subject::string $attribution::map $opts::map {}) [$journal-erase-subject $journal $subject $attribution $opts]]
[?def ingest-stream  scope=public impure [effects [read] [write]] [returns element] ($journal::element $source::element $stream::string) [$journal-ingest-stream $journal $source $stream]]
[?def register-replica scope=public impure [effects [write]] [returns element] ($journal::element $id::string $opts::map {}) [$journal-register-replica $journal $id $opts]]
[?def deregister-replica scope=public impure [effects [write]] [returns element] ($journal::element $id::string $opts::map {}) [$journal-deregister-replica $journal $id $opts]]
[?def apply-erasures scope=public impure [effects [read] [write]] [returns element] ($journal::element $origin::element) [$journal-apply-erasures $journal $origin]]
[?def saga-run       scope=public impure [effects [read] [write]] [returns element] ($journal::element $saga-def::element $opts::map {}) [$journal-saga-run $journal $saga-def $opts]]
[?def saga-status    scope=public impure [returns element] ($journal::element $id::string $opts::map {}) [$journal-saga-status $journal $id $opts]]
[?def shred-generation scope=public impure [returns int]             ($journal::element)                                [$journal-shred-generation $journal]]
[?def overlaps       scope=public pure   [returns bool]               ($a::element $b::element)                          [$journal-overlaps $a $b]]
[?def contains-instant scope=public pure [returns bool]               ($a::element $instant::any)                        [$journal-contains-instant $a $instant]]
[?def replay         scope=public impure [returns any]                ($journal::element $fn $init::any $opts::map {})   [$journal-replay $journal $fn $init $opts]]
[?def dry-run        scope=public impure [returns element]            ($journal::element $event::any $attribution::map $fn $init::any) [$journal-dry-run $journal $event $attribution $fn $init]]
[?def verify         scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-verify $journal $opts]]
[?def verify-slice   scope=public impure [returns element]            ($journal::element $from::int $to::int)            [$journal-verify-slice $journal $from $to]]
[?def coherence      scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-coherence $journal $opts]]
[?def snapshot       scope=public impure [returns element]            ($journal::element $fn $init::any $opts::map {})   [$journal-snapshot $journal $fn $init $opts]]
[?def snapshot-verify scope=public impure [returns element]           ($journal::element $snapshot::element $opts::map {}) [$journal-snapshot-verify $journal $snapshot $opts]]
[?def fold-from      scope=public impure [returns any]                ($journal::element $snapshot::element $fn $opts::map {}) [$journal-fold-from $journal $snapshot $fn $opts]]
[?def resnapshot     scope=public impure [returns element]            ($journal::element $fn $init::any $snapshot::element $opts::map {}) [$journal-resnapshot $journal $fn $init $snapshot $opts]]
[?def retain         scope=public impure [returns element]            ($journal::element $policy::map)                   [$journal-retain $journal $policy]]
[?def compact        scope=public impure [returns element]            ($journal::element $opts::map {})                  [$journal-compact $journal $opts]]

[; co-located docs (seeded — refine in place). ]
[module-doc name=journal
  [scope """An append-only, hash-chained, tenant-partitioned event log and the deterministic projection of that log into state. Open or attach a journal over a `store` backend, `append` attributed events (each returning a committed `[entry]` with its sequence, content hash, and predecessor link), `read` / `slice` / `query` ranges, and `fold` the log into a state projection. The chain is deterministic — replayable, dry-runnable, and hash-verifiable — which is the entire reason it exists. `snapshot`, `retain`, and `compact` accelerate and bound replay as derived artifacts; they never edit the live chain, so append-only and chain integrity hold permanently."""]]
[fn-doc name=open scope=public purity=impure
  [sig """-> element"""]
  [summary """Open a journal over a `store` backend URL for one tenant, creating or attaching to its hash chain."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://acme" "acme"]]
  [$journal:append $j [do :refund] {actor: "ops" authority: "d-77"}]]"""] [expect """[entry seq=1 tenant=acme actor=ops authority=d-77 ts='1970-01-01T00:00:01Z' prev-hash='genesis:' payload='sha2-256:1c28ab1fd422c356d61afc4be98fe2ff836d21b306487a4d67a62b40fc762ec5' hash='sha2-256:902dfe8cf83616e030e70ec30429c632601d4bd29308b757049706a3afb218a4' [event [do :refund]]]"""]]
]
[fn-doc name=attach scope=public purity=impure
  [sig """-> element"""]
  [summary """Attach a journal to an already-open `store` handle for one tenant, reusing its connection."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?let [= $s [$store:open "mem://r"]]
[= $j1 [$journal:attach $s "acme"]]
[= $a [$journal:append $j1 [a 1] {actor: "u" authority: "g"}]]
[= $b [$journal:append $j1 [b 2] {actor: "u" authority: "g"}]]
[= $c [$journal:close $j1]]
[= $j2 [$journal:attach $s "acme"]]
  [$journal:verify $j2]]"""] [expect """[verification valid=true checked-from=1 checked-to=2 head-hash='sha2-256:1d4f5830f65cd9c6b37aa82309376cb3933b6ff91b7d0c7ef877d4403c9dabb0']"""]]
]
[fn-doc name=close scope=public purity=impure
  [sig """-> null"""]
  [summary """Close the journal handle; subsequent operations on it raise CXER4612."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $x [$journal:close $j]]
  [$journal:append $j [a] {actor: "u" authority: "g"}]]"""] [expect """cx-err:CXER4612"""]]
]
[fn-doc name=append scope=public purity=impure
  [sig """-> element"""]
  [summary """Commit an attributed event, returning the new `[entry]` with its seq, content hash, and predecessor link."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://acme" "acme"]]
  [$journal:append $j [do :refund] {actor: "ops" authority: "d-77"}]]"""] [expect """[entry seq=1 tenant=acme actor=ops authority=d-77 ts='1970-01-01T00:00:01Z' prev-hash='genesis:' payload='sha2-256:1c28ab1fd422c356d61afc4be98fe2ff836d21b306487a4d67a62b40fc762ec5' hash='sha2-256:902dfe8cf83616e030e70ec30429c632601d4bd29308b757049706a3afb218a4' [event [do :refund]]]"""]]
]
[fn-doc name=read scope=public purity=impure
  [sig """-> element"""]
  [summary """Return the single `[entry]` at `seq`, or the absence channel if out of range."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b 2] {actor: "u" authority: "g"}]]
  [$journal:read $j 2]]"""] [expect """[entry seq=2 tenant=acme actor=u authority=g ts='1970-01-01T00:00:02Z' prev-hash='sha2-256:69c69761d531660401aa7275810f13828b1db1430511243efbaddc053637311d' payload=sha2-256:e74783796d0d83dfce07552c3773cc9ab4f270fbeb19ada5438a363d79b08e18 hash='sha2-256:1d4f5830f65cd9c6b37aa82309376cb3933b6ff91b7d0c7ef877d4403c9dabb0' [event [b 2]]]"""]]
]
[fn-doc name=slice scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return the entries with `from ≤ seq ≤ to` (inclusive, 1-based), in sequence order."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:slice $j 2 3]]"""] [expect """([entry seq=2 tenant=acme actor=u authority=g ts='1970-01-01T00:00:02Z' prev-hash='sha2-256:83a013836d0939e47c191cd4a5c079e89fe2f1ecfee486f7da7db50fcdeb9b98' payload=sha2-256:ca0dff2eeeb428d9b948154b48f08f4957c2aa0b9c36f31410812c2943df3b74 hash=sha2-256:d0ff5f72f597fa548dc5e52dc2e65d474e18a5fae0b440d09e2c29901ac39ac5 [event [b]]], [entry seq=3 tenant=acme actor=u authority=g ts='1970-01-01T00:00:03Z' prev-hash=sha2-256:d0ff5f72f597fa548dc5e52dc2e65d474e18a5fae0b440d09e2c29901ac39ac5 payload=sha2-256:a1f3760d1baa325a1f6dc4dd0b659aae82fac0bcbc4c86d25dc8e2651e4c9769 hash=sha2-256:aea8756847199d3ffb540efb20ebfcc5d25f1b8a9396d66d1dfd14ca4b23952d [event [c]]])"""]]
]
[fn-doc name=since scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return the tail of the log from `from` to the current head."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
  [$journal:since $j 2]]"""] [expect """([entry seq=2 tenant=acme actor=u authority=g ts='1970-01-01T00:00:02Z' prev-hash='sha2-256:83a013836d0939e47c191cd4a5c079e89fe2f1ecfee486f7da7db50fcdeb9b98' payload=sha2-256:ca0dff2eeeb428d9b948154b48f08f4957c2aa0b9c36f31410812c2943df3b74 hash=sha2-256:d0ff5f72f597fa548dc5e52dc2e65d474e18a5fae0b440d09e2c29901ac39ac5 [event [b]]])"""]]
]
[fn-doc name=query scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return the entries whose `[event …]` payload or envelope matches a CXPath filter."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [do :refund] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [note "hi"] {actor: "u" authority: "g"}]]
  [$journal:query $j "/event/do"]]"""] [expect """([entry seq=1 tenant=acme actor=u authority=g ts='1970-01-01T00:00:01Z' prev-hash='genesis:' payload='sha2-256:1c28ab1fd422c356d61afc4be98fe2ff836d21b306487a4d67a62b40fc762ec5' hash=sha2-256:cf7b52e49ca5b3d13a97c4304790ab001c42130f15db55b91ce07a1bbceff7cc [event [do :refund]]])"""]]
]
[fn-doc name=source scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """Return one stream's retained committed entries in seq order — the journal-stream source-reference form for planar comprehensions (code.md 7.8)."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g" stream: "orders"}]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g" stream: "orders"}]]
[= $e3 [$journal:append $j [b 9] {actor: "u" authority: "g"}]]
  [$count [$journal:source $j "orders"]]]"""] [expect """2"""]]
]
[fn-doc name=head scope=public purity=pure
  [sig """-> element"""]
  [summary """Return the head `[entry]` from the handle's CACHED view, or absence if the log is empty. Makes NO freshness claim (stream 7 F1): under a second writer — another process on a local root, another client behind a read-only view — it may report a stale position with no signal; it satisfies neither `:read-your-writes` freshness nor a declared-fresh need. A caller that needs the durable head uses the distinct impure verb `head-fresh`."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
  [$journal:head $j]]"""] [expect """()"""]]
]
[fn-doc name=head-fresh scope=public purity=impure
  [sig """-> element"""]
  [summary """Return the head `[entry]` after re-resolving the durable head through the SUBSTRATE (stream 7 F1 — the declared-fresh head verb): a read-only local handle re-takes its private snapshot view from disk through the normal capability-gated open path; a remote-backed handle asks the daemon; mem:// answers the live instance. Impure by contract; absence on an empty stream, like `head`."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://cst-098" "acme"]]
[= $a [$journal:append $j [x 1] {actor: "u" authority: "g"}]]
[= $b [$journal:append $j [x 2] {actor: "u" authority: "g"}]]
[= $h [$journal:head $j]]
[= $hf [$journal:head-fresh $j]]
  [heads cached=$h/@seq fresh=$hf/@seq]]"""] [expect """[heads cached=2 fresh=2]"""]]
]
[fn-doc name=streams scope=public purity=impure
  [sig """-> [sequence element]"""]
  [summary """List the distinct stream names present in the journal. A tenant-wide composition over these streams is NOT a cut (stream 7 F8): each stream's head is snapshotted independently, with no cross-stream linearization claimed — a verifiable multi-stream cut is `:at-head-set`, the signed snapshot head-set."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $a [$journal:append $j [x 1] {actor: "u" authority: "g" stream: "s1"}]]
[= $b [$journal:append $j [x 2] {actor: "u" authority: "g" stream: "s1"}]]
[= $c [$journal:append $j [y 1] {actor: "u" authority: "g" stream: "s2"}]]
  [$journal:streams $j]]"""] [expect """(s1, s2)"""]]
]
[fn-doc name=fold scope=public purity=impure
  [sig """-> any"""]
  [summary """Fold ONE stream into a state projection with a pure reducer and initial value. A tenant-wide state composed from per-stream folds is NOT a cut (stream 7 F8): each stream's head snapshots independently, no cross-stream linearization is claimed — the verifiable cut is `:at-head-set` (the signed snapshot head-set)."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:fold $j [?fn ($a $e) [+ $a 1]] 0]]"""] [expect """3"""]]
]
[fn-doc name=fold-slice scope=public purity=impure
  [sig """-> any"""]
  [summary """Fold a `from..to` range of the log into a state projection."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:fold-slice $j [?fn ($a $e) [+ $a 1]] 0 2 3]]"""] [expect """2"""]]
]
[fn-doc name=fold-value scope=public purity=pure
  [sig """-> any"""]
  [summary """Fold an already-read entry sequence into state, without touching the journal."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $es [$journal:since $j 1]]
  [$journal:fold-value $es [?fn ($a $e) [+ $a 10]] 0]]"""] [expect """20"""]]
]
[fn-doc name=temporal-slice scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """The PURE bitemporal projection over already-materialized entries (stream 8, the fold-value twin): opts {at-seq: N} cuts on the TX axis; {valid-at: T} engages the as-of collapse (in-cut :correction targets drop across their whole extent, :amendment clamps its target's valid-to to the amender's valid-from) then keeps the entries whose half-open [from, to) contains T. Entries without valid-time vocabulary are valid always; shredded entries pass through visibly."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://bt-110" "acme"]]
[= $e1 [$journal:append $j [promo pct=10 valid-from="2026-08-01" valid-to="2026-08-05"] {actor: "u" authority: "g"}]]
[= $es [$journal:since $j 1]]
  [boundary at-from=[$count [$journal:temporal-slice $es {valid-at: "2026-08-01"}]] inside=[$count [$journal:temporal-slice $es {valid-at: "2026-08-04"}]] at-to=[$count [$journal:temporal-slice $es {valid-at: "2026-08-05"}]] before=[$count [$journal:temporal-slice $es {valid-at: "2026-07-31"}]]]]"""] [expect """[boundary at-from=1 inside=1 at-to=0 before=0]"""]]
]
[fn-doc name=upcast scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """The PURE upcaster seam over already-materialized entries (stream 21, the temporal-slice twin): applies a caller-supplied pure chain — an entry-to-entry projection — to every entry that carries an event payload. The chain's output supplies the payload only; the envelope is the journal's (rewriting seq= or hash= refuses CXER4642, dropping the payload refuses CXER4642). An entry the chain refuses is a loud CXER4641 naming seq, hash, and the declared schema — never absence, never a skip. Shredded entries pass through without chain application. The fold and replay opts take the same chain under {upcast: $chain}, composed BEFORE the valid-time projection."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://se-118" "acme"]]
[= $e1 [$journal:append $j [order id="A-1" total=107 schema="sha2-256:a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"] {actor: "svc" authority: "g"}]]
[= $e2 [$journal:append $j [order id="A-2" subtotal=90 tax=10 schema="sha2-256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2"] {actor: "svc" authority: "g"}]]
[= $up [?fn ($e)
  [?if [= $e/event/order/@schema "sha2-256:a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"]
    [then [entry seq=$e@seq hash=$e@hash
      [event [order id=$e/event/order/@id subtotal=[- $e/event/order/@total 10] tax=10 schema="sha2-256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2"]]]]
    [else $e]]]]
  [upcast v2-subtotals=[$journal:fold $j [?fn ($a $e) [+ $a $e/event/order/@subtotal]] 0 "" {upcast: $up}] raw-v2-only=[$journal:fold $j [?fn ($a $e) [+ $a [$sum $e/event/order/@subtotal]]] 0] pure-count=[$count [$journal:upcast [$journal:since $j 1] $up]]]]"""] [expect """[upcast v2-subtotals=187 raw-v2-only=90 pure-count=2]"""]]
]
[fn-doc name=lineage-path scope=public purity=pure
  [sig """-> [sequence element]"""]
  [summary """The lineage load (stream 21): validates a set of Lane-2 schema-lineage claims — each relating two schema content addresses under a closed relation set (:additive/:narrowing/:split/:merge) with an upcaster slot — FAIL-CLOSED: a duplicate edge, a cycle, or any pair of endpoints admitting two paths refuses CXER4643; then returns the claims along the UNIQUE from-to path in composition order. No covering path is the loud CXER4644 (lineage is directed). Same-endpoint queries return the empty (identity) chain."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $v1 "sha2-256:a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"]
[= $v2 "sha2-256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2"]
[= $v3 "sha2-256:c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3"]
[= $c12 [schema-lineage [from $v1] [to $v2] [relation :additive] [upcaster "sha2-256:u12u12"]]]
[= $c23 [schema-lineage [from $v2] [to $v3] [relation :split] [upcaster "sha2-256:u23u23"]]]
[= $c13 [schema-lineage [from $v1] [to $v3] [relation :additive] [upcaster "sha2-256:u13u13"]]]
[= $path [$journal:lineage-path ($c12, $c23) $v1 $v3]]
[= $hops [$count $path]]
[= $ambig [?fallback [$journal:lineage-path ($c12, $c23, $c13) $v1 $v3] [recover-with [context] [code $err@code]]]]
[= $gap [?fallback [$journal:lineage-path ($c12,) $v2 $v1] [recover-with [context] [code $err@code]]]]
  [probe hops=$hops [rels [?splice $path/relation]] [ambig $ambig] [gap $gap]]]"""] [expect """[probe hops=2 [rels [relation :additive] [relation :split]] [ambig [code 'cx-err:CXER4643']] [gap [code 'cx-err:CXER4644']]]"""]]
]
[fn-doc name=legal-holds scope=public purity=impure
  [sig """-> element"""]
  [summary """The hold-stream load (stream 20): a legal hold is a SIGNED Lane-2 [legal-hold] claim journaled to the reserved per-tenant cx:legal-hold stream — it binds from its journaled position onward. Placement is write-time enforced (the reserved stream records only well-formed signed claims; a malformed/unsigned append refuses CXER4620), and the load re-validates FAIL-CLOSED (a hold that cannot bind fails loud, never a skip). Returns [holds stream= head= count=] with one [hold seq= subject=|hash= signer= at=] per binding hold; opts {subject:|hash:} filter. head is the position the erase-subject precondition pins. The signature covers the claim's strict canonical text with the [sig] child removed; verification proves possession of key= — binding the key to the signer identity is authz/vc's domain."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/cx']
[?let
[= $priv [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
[= $pub "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]
[= $j [$journal:open "mem://holds" "acme"]]
[= $c1 [legal-hold [subject "did:ex:dana"] [signer "did:ex:counsel"] [at "2026-08-12"]]]
[= $s1 [$bytes:to-hex [$crypto:ed25519-sign $priv [$bytes:from-string-utf8 [$cx:canonical [$cx:serialize $c1]]]]]]
[= $e1 [$journal:append $j [legal-hold [subject "did:ex:dana"] [signer "did:ex:counsel"] [at "2026-08-12"] [sig alg=:ed25519 value=$s1 key=$pub]] {actor: "counsel" authority: "h-1" stream: "cx:legal-hold"}]]
[= $c2 [legal-hold [hash "sha2-256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"] [signer "did:ex:counsel"] [at "2026-08-12"]]]
[= $s2 [$bytes:to-hex [$crypto:ed25519-sign $priv [$bytes:from-string-utf8 [$cx:canonical [$cx:serialize $c2]]]]]]
[= $e2 [$journal:append $j [legal-hold [hash "sha2-256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"] [signer "did:ex:counsel"] [at "2026-08-12"] [sig alg=:ed25519 value=$s2 key=$pub]] {actor: "counsel" authority: "h-1" stream: "cx:legal-hold"}]]
[= $refused [?fallback [$journal:append $j [legal-hold [subject "did:ex:eve"] [signer "did:ex:counsel"] [at "2026-08-12"]] {actor: "counsel" authority: "h-1" stream: "cx:legal-hold"}] [recover-with [context] [code $err@code]]]]
  [probe [all [$journal:legal-holds $j]] [dana [$journal:legal-holds $j {subject: "did:ex:dana"}]] [refused $refused]]]"""] [expect """[probe [all [holds stream=cx:legal-hold head=2 count=2 [hold seq=1 subject=did:ex:dana signer=did:ex:counsel at='2026-08-12'] [hold seq=2 hash=sha2-256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa signer=did:ex:counsel at='2026-08-12']]] [dana [holds stream=cx:legal-hold head=2 count=1 [hold seq=1 subject=did:ex:dana signer=did:ex:counsel at='2026-08-12']]] [refused [code 'cx-err:CXER4620']]]"""]]
]
[fn-doc name=erase-subject scope=public purity=impure
  [sig """-> element"""]
  [summary """The recorded RTBF command (stream 20): journal an attributed [erase-subject] record to the reserved per-tenant cx:erasure stream, then execute the crypto-shred walk — destroy the subject's SEK(s), tombstone every subject-sealed doc ([erased] with attribution), purge derived surfaces (computation cache, materialization checkpoints, in-process dedup records and plaintext caches), across the backing store and every store the segment index names. HOLD-BEATS-SHRED: a signed legal hold binding the subject (or a scoped hash) refuses CXER4621 atomically — the hold-stream head pins before commit and re-checks under the writing commit lock. The KMS destroy is strictly POST-COMMIT (the forward-only pivot). Idempotent: the journaled record IS the durable dedup record (its request= id is an opaque CSPRNG token); a resubmission answers [deduped <the recorded shred-report>] and re-runs only the idempotent walk (self-heal). A committed shred advances the tenant shred-generation, staling every pre-shred snapshot's fold-id (CXER4640 on fold-from — re-snapshot is forced). Direct appends to cx:erasure refuse CXER4622. Returns the balanced [shred-report …]: docs = erased + already-erased."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/cx']
[?let
[= $priv [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
[= $pub "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]
[= $j [$journal:open "mem://erase" "acme"]]
[= $e0 [$journal:append $j [order id="o-1" total=42] {actor: "svc" authority: "ing-1" stream: "orders"}]]
[= $c1 [legal-hold [subject "did:ex:eve"] [signer "did:ex:counsel"] [at "2026-08-12"]]]
[= $s1 [$bytes:to-hex [$crypto:ed25519-sign $priv [$bytes:from-string-utf8 [$cx:canonical [$cx:serialize $c1]]]]]]
[= $e1 [$journal:append $j [legal-hold [subject "did:ex:eve"] [signer "did:ex:counsel"] [at "2026-08-12"] [sig alg=:ed25519 value=$s1 key=$pub]] {actor: "counsel" authority: "h-1" stream: "cx:legal-hold"}]]
[= $held [?fallback [$journal:erase-subject $j "did:ex:eve" {actor: "dpo" authority: "rtbf-9"} {request: "shred-fx-eve"}] [recover-with [context] [code $err@code]]]]
[= $g0 [$journal:shred-generation $j]]
[= $snap [$journal:snapshot $j [?fn ($acc $e) $acc] 0 {stream: "orders" sign: "false" fold-id: "fold:demo-g0"}]]
[= $r1 [$journal:erase-subject $j "did:ex:dana" {actor: "dpo" authority: "rtbf-9"} {request: "shred-fx-dana"}]]
[= $g1 [$journal:shred-generation $j]]
[= $r2 [$journal:erase-subject $j "did:ex:dana" {actor: "dpo" authority: "rtbf-9"} {request: "shred-fx-dana"}]]
[= $stale [?fallback [$journal:fold-from $j $snap [?fn ($acc $e) $acc] {fold-id: "fold:demo-g1"}] [recover-with [context] [code $err@code]]]]
[= $forged [?fallback [$journal:append $j [erase-subject [subject "did:ex:mallory"]] {actor: "m" authority: "m" stream: "cx:erasure"}] [recover-with [context] [code $err@code]]]]
  [probe [held $held] [gen0 $g0] [gen1 $g1] [first $r1] [replay $r2] [stale $stale] [forged $forged]]]"""] [expect """[probe [held [code 'cx-err:CXER4621']] [gen0 0] [gen1 1] [first [shred-report subject=did:ex:dana request=shred-fx-dana docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=1 holds-head=1]] [replay [deduped [shred-report subject=did:ex:dana request=shred-fx-dana docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=1 holds-head=1]]] [stale [code 'cx-err:CXER4640']] [forged [code 'cx-err:CXER4622']]]"""]]
]
[fn-doc name=ingest-stream scope=public purity=impure
  [sig """-> element"""]
  [summary """Replica-local stream ingestion (stream 9, distributed_store §2) — the journal half of sync. Register a source journal's named stream into this journal's tenant as a DISJOINT AGGREGATE: entries re-land BYTE-IDENTICAL (the entry hash survives; the chain verifies unchanged here), no sequencer is consulted (tenant state is your order-independent composition of per-stream folds). Idempotent: re-ingesting an unchanged stream answers ingested=0, and a source that merely grew re-lands only the tail (clean prefix extension). A stream key this journal already holds with a DIFFERENT chain refuses CXER5050 E_SYNC_STREAM_DIVERGENT (a replica stream is a new aggregate, never a merge into an origin stream — `append` re-hashes by design, so identity-preserving transfer happens only here). The default stream and reserved cx:* streams refuse CXER5052 E_SYNC_STREAM_RESERVED (evidence streams propagate on the feed, never by hand-ingestion). An unverifiable or gapped source chain refuses CXER5051 E_SYNC_CHAIN_INVALID and nothing lands. Payload docs ride along when the source holds them; a payload lawfully shredded at the source still lands its entry (the chain covers the ADDRESS) with the count visible (`payloads-absent=`, present only when non-zero). Returns the balanced [ingest-report …]: entries = ingested + already-present."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?let
[= $sa [$store:open "mem://s9-rep"]]
[= $ja [$journal:attach $sa "acme"]]
[= $e1 [$journal:append $ja [order id="o-1"] {actor: "clerk" authority: "tab-1" stream: "order:r1"}]]
[= $e2 [$journal:append $ja [order-line id="o-1" sku="x"] {actor: "clerk" authority: "tab-1" stream: "order:r1"}]]
[= $sb [$store:open "mem://s9-origin"]]
[= $jb [$journal:attach $sb "acme"]]
[= $e0 [$journal:append $jb [origin-fact a=1] {actor: "svc" authority: "g"}]]
[= $r1 [$journal:ingest-stream $jb $ja "order:r1"]]
[= $r2 [$journal:ingest-stream $jb $ja "order:r1"]]
[= $v [$journal:verify $jb {stream: "order:r1"}]]
[= $e3 [$journal:append $ja [order-close id="o-1"] {actor: "clerk" authority: "tab-1" stream: "order:r1"}]]
[= $r3 [$journal:ingest-stream $jb $ja "order:r1"]]
[= $ha [$journal:head $ja "order:r1"]]
[= $hb [$journal:head $jb "order:r1"]]
[= $res [?fallback [$journal:ingest-stream $jb $ja "cx:erasure"] [recover-with [context] [code $err@code]]]]
[= $x1 [$journal:append $jb [rogue] {actor: "x" authority: "y" stream: "order:r2"}]]
[= $x2 [$journal:append $ja [real] {actor: "clerk" authority: "tab-1" stream: "order:r2"}]]
[= $div [?fallback [$journal:ingest-stream $jb $ja "order:r2"] [recover-with [context] [code $err@code]]]]
  [probe [first $r1] [replay $r2] [verify $v] [tail $r3] [head-a $ha/@hash] [head-b $hb/@hash] [reserved $res] [divergent $div]]]"""] [expect """[probe [first [ingest-report stream=order:r1 entries=2 ingested=2 already-present=0 head=2 hash='sha2-256:5ba2f8da382bc68298b496299225e48c4a93ddb227512669324ec25b578f8c71']] [replay [ingest-report stream=order:r1 entries=2 ingested=0 already-present=2 head=2 hash='sha2-256:5ba2f8da382bc68298b496299225e48c4a93ddb227512669324ec25b578f8c71']] [verify [verification valid=true checked-from=1 checked-to=2 head-hash='sha2-256:5ba2f8da382bc68298b496299225e48c4a93ddb227512669324ec25b578f8c71']] [tail [ingest-report stream=order:r1 entries=3 ingested=1 already-present=2 head=3 hash='sha2-256:42d713eb7091fe473fa9c5be03422675c69e4b9db150bb727add638f6fd75174']] [head-a 'sha2-256:42d713eb7091fe473fa9c5be03422675c69e4b9db150bb727add638f6fd75174'] [head-b 'sha2-256:42d713eb7091fe473fa9c5be03422675c69e4b9db150bb727add638f6fd75174'] [reserved [code 'cx-err:CXER5052']] [divergent [code 'cx-err:CXER5050']]]"""]]
]
[fn-doc name=register-replica scope=public purity=impure
  [sig """-> element"""]
  [summary """Register (or advance — upsert) a replica at this origin journal (stream 9, distributed_store §5, L177 — register-or-refuse retention): the registration records the replica's synced cursor per stream, and the retention cover rule EXTENDS to it — a retain/compact boundary above a registered replica's cursor refuses CXER4616 loud (advance the registration on a later sync, or deregister, before pruning). The alternative is client-anchored: no origin state, and a cursor below the compacted floor gets the loud re-seed refusals (ingest CXER5051, resume CXER4617, live CXER5073). Both are spec'd; the deployment chooses."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?let
[= $s [$store:open "mem://reg-136"]]
[= $j [$journal:attach $s "acme"]]
[= $e1 [$journal:append $j [f 1] {actor: "u" authority: "g" stream: "s1"}]]
[= $e2 [$journal:append $j [f 2] {actor: "u" authority: "g" stream: "s1"}]]
[= $reg [$journal:register-replica $j "tab-1" {stream: "s1" seq: 1}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) $a] 0 {stream: "s1" signing-key: "0101010101010101010101010101010101010101010101010101010101010101"}]]
[= $ref [?fallback [$journal:retain $j {stream: "s1" keep-after-seq: 2 snapshot: $snap}] [recover-with [context] [code $err@code]]]]
[= $reg2 [$journal:register-replica $j "tab-1" {stream: "s1" seq: 2}]]
[= $ok [$journal:retain $j {stream: "s1" keep-after-seq: 2 snapshot: $snap}]]
[= $dereg [$journal:deregister-replica $j "tab-1" {stream: "s1"}]]
  [probe [registered $reg] [refused $ref] [advanced $reg2] [retained $ok] [dereg $dereg]]]"""] [expect """[probe [registered [replica-registration id=tab-1 stream=s1 seq=1]] [refused [code 'cx-err:CXER4616']] [advanced [replica-registration id=tab-1 stream=s1 seq=2]] [retained [retention boundary=2 covered-by-seq=2 stream=s1]] [dereg [deregistered id=tab-1 existed=true]]]"""]]
]
[fn-doc name=deregister-replica scope=public purity=impure
  [sig """-> element"""]
  [summary """Remove a replica's registration at this origin (stream 9): the retention hold it bought is released — history below the next prune boundary may compact away, and a replica that returns later below the floor re-seeds via the loud client-anchored refusals. Returns [deregistered id= existed=]."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?let
[= $s [$store:open "mem://reg-136"]]
[= $j [$journal:attach $s "acme"]]
[= $e1 [$journal:append $j [f 1] {actor: "u" authority: "g" stream: "s1"}]]
[= $e2 [$journal:append $j [f 2] {actor: "u" authority: "g" stream: "s1"}]]
[= $reg [$journal:register-replica $j "tab-1" {stream: "s1" seq: 1}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) $a] 0 {stream: "s1" signing-key: "0101010101010101010101010101010101010101010101010101010101010101"}]]
[= $ref [?fallback [$journal:retain $j {stream: "s1" keep-after-seq: 2 snapshot: $snap}] [recover-with [context] [code $err@code]]]]
[= $reg2 [$journal:register-replica $j "tab-1" {stream: "s1" seq: 2}]]
[= $ok [$journal:retain $j {stream: "s1" keep-after-seq: 2 snapshot: $snap}]]
[= $dereg [$journal:deregister-replica $j "tab-1" {stream: "s1"}]]
  [probe [registered $reg] [refused $ref] [advanced $reg2] [retained $ok] [dereg $dereg]]]"""] [expect """[probe [registered [replica-registration id=tab-1 stream=s1 seq=1]] [refused [code 'cx-err:CXER4616']] [advanced [replica-registration id=tab-1 stream=s1 seq=2]] [retained [retention boundary=2 covered-by-seq=2 stream=s1]] [dereg [deregistered id=tab-1 existed=true]]]"""]]
]
[fn-doc name=apply-erasures scope=public purity=impure
  [sig """-> element"""]
  [summary """The shred-reach worker (stream 9 × stream 20's joint requirement): consume the origin's journaled shred-requests (the reserved cx:erasure stream) and execute THIS replica's OWN erase-subject per record under the SAME (subject, request-token) key — the replica journals its own attributed record, runs its own local walk, and emits its own balanced shred-report; replay answers [deduped …] per record (idempotent — fleet convergence is the collection of per-replica reports, never an origin-side assumption). A record refused by a LOCAL legal hold is a LOUD [held subject= request= code=] child (hold-beats-shred holds at every replica); held= appears only when non-zero and means the fleet has NOT converged. Returns [erasure-sync records= applied= deduped= held?=]."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/cx']
[?let
[= $so [$store:open "mem://ae-origin"]]
[= $jo [$journal:attach $so "acme"]]
[= $e0 [$journal:append $jo [order id="o-1"] {actor: "svc" authority: "g" stream: "orders"}]]
[= $r1 [$journal:erase-subject $jo "did:ex:dana" {actor: "dpo" authority: "rtbf-9"} {request: "shred-ae-1"}]]
[= $r2 [$journal:erase-subject $jo "did:ex:carol" {actor: "dpo" authority: "rtbf-9"} {request: "shred-ae-2"}]]
[= $sr [$store:open "mem://ae-rep"]]
[= $jr [$journal:attach $sr "acme"]]
[= $a1 [$journal:apply-erasures $jr $jo]]
[= $a2 [$journal:apply-erasures $jr $jo]]
[= $priv [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
[= $pub "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]
[= $c1 [legal-hold [subject "did:ex:eve"] [signer "did:ex:counsel"] [at "2026-08-12"]]]
[= $s1 [$bytes:to-hex [$crypto:ed25519-sign $priv [$bytes:from-string-utf8 [$cx:canonical [$cx:serialize $c1]]]]]]
[= $h1 [$journal:append $jr [legal-hold [subject "did:ex:eve"] [signer "did:ex:counsel"] [at "2026-08-12"] [sig alg=:ed25519 value=$s1 key=$pub]] {actor: "counsel" authority: "h-1" stream: "cx:legal-hold"}]]
[= $r3 [$journal:erase-subject $jo "did:ex:eve" {actor: "dpo" authority: "rtbf-9"} {request: "shred-ae-3"}]]
[= $a3 [$journal:apply-erasures $jr $jo]]
  [probe [first $a1] [replay $a2] [with-held $a3]]]"""] [expect """[probe [first [erasure-sync records=2 applied=2 deduped=0 [shred-report subject=did:ex:dana request=shred-ae-1 docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=1 holds-head=0] [shred-report subject=did:ex:carol request=shred-ae-2 docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=2 holds-head=0]]] [replay [erasure-sync records=2 applied=0 deduped=2 [deduped [shred-report subject=did:ex:dana request=shred-ae-1 docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=1 holds-head=0]] [deduped [shred-report subject=did:ex:carol request=shred-ae-2 docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=2 holds-head=0]]]] [with-held [erasure-sync records=3 applied=0 deduped=2 held=1 [deduped [shred-report subject=did:ex:dana request=shred-ae-1 docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=1 holds-head=0]] [deduped [shred-report subject=did:ex:carol request=shred-ae-2 docs=0 erased=0 already-erased=0 subject-keys=0 derived=0 checkpoints=0 dedup-records=0 stores=1 disposed=0 generation=2 holds-head=0]] [held subject=did:ex:eve request=shred-ae-3 code=cx-err:CXER4621]]]]"""]]
]
[fn-doc name=saga-run scope=public purity=impure
  [sig """-> element"""]
  [summary """The Ring-2 saga runner (stream 10, cross_stream_coordination §2): drive a [saga-def id= [step name= pivot?=true [fn <command>] [args {…}]]…] — every step a COMMAND invocation (effects narrowing, [idempotent] dedup, and the [requires-at] admission all apply; the runner is the second journal-bound admission site) — journaling every status transition as a new [saga] record on the home stream (opts.stream; opts.actor + opts.authority = the authority basis, mandatory). The journaled record IS the durable step-dedup: on resume, steps recorded :done never re-execute, and re-running a completed saga answers [deduped <the recorded value>]. A failed step marks the saga :failed (compensation flows are the reverse-pre-pivot / forward-only-post-pivot vocabulary). Saga state never enters any other stream's fold — participants replay in isolation byte-identically; the saga document is an order-independent reporting JOIN."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?def release-inventory impure [effects] ($sku='' $qty=1) [released sku=$sku]]
[?def reserve-inventory impure [effects] [compensates release-inventory] ($sku='' $qty=1) [reserved sku=$sku qty=$qty]]
[?def void-authorization impure [effects] ($acct='' $amount=0) [voided acct=$acct]]
[?def authorize-payment impure [effects] [compensates void-authorization] ($acct='' $amount=0) [authorized acct=$acct amount=$amount]]
[?def place-order impure [effects] ($order='') [placed order=$order]]
[?let
[= $s [$store:open "mem://saga-1"]]
[= $j [$journal:attach $s "acme"]]
[= $def [saga-def id="cs-1"
  [step name="reserve-inventory" [fn $reserve-inventory] [args {sku: "88" qty: 1}]]
  [step name="authorize-payment" [fn $authorize-payment] [args {acct: "pay:acme" amount: 100}]]
  [step name="place-order" pivot=true [fn $place-order] [args {order: "o-5521"}]]]]
[= $r1 [$journal:saga-run $j $def {stream: "order:o-5521" actor: "agent-1" authority: "checkout"}]]
[= $r2 [$journal:saga-run $j $def {stream: "order:o-5521" actor: "agent-1" authority: "checkout"}]]
[= $st [$journal:saga-status $j "cs-1" {stream: "order:o-5521"}]]
[= $v [$journal:verify $j {stream: "order:o-5521"}]]
  [probe [run $r1] [replay $r2] [status $st/@status] [chain $v/@valid]]]"""] [expect """[probe [run [saga id=cs-1 status=:done [step name=reserve-inventory status=:done] [step name=authorize-payment status=:done] [step name=place-order status=:done pivot=true]]] [replay [deduped [saga id=cs-1 status=:done [step name=reserve-inventory status=:done] [step name=authorize-payment status=:done] [step name=place-order status=:done pivot=true]]]] [status :done] [chain true]]"""]]
]
[fn-doc name=saga-status scope=public purity=impure
  [sig """-> element"""]
  [summary """The last recorded [saga] value for an id on its home stream (opts.stream) — the :at-head-set-class reporting read ("is the checkout done?"); absence when no record exists. Read-only: the record scan never mutates saga state."""]
  [example [code """[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?def release-inventory impure [effects] ($sku='' $qty=1) [released sku=$sku]]
[?def reserve-inventory impure [effects] [compensates release-inventory] ($sku='' $qty=1) [reserved sku=$sku qty=$qty]]
[?def void-authorization impure [effects] ($acct='' $amount=0) [voided acct=$acct]]
[?def authorize-payment impure [effects] [compensates void-authorization] ($acct='' $amount=0) [authorized acct=$acct amount=$amount]]
[?def place-order impure [effects] ($order='') [placed order=$order]]
[?let
[= $s [$store:open "mem://saga-1"]]
[= $j [$journal:attach $s "acme"]]
[= $def [saga-def id="cs-1"
  [step name="reserve-inventory" [fn $reserve-inventory] [args {sku: "88" qty: 1}]]
  [step name="authorize-payment" [fn $authorize-payment] [args {acct: "pay:acme" amount: 100}]]
  [step name="place-order" pivot=true [fn $place-order] [args {order: "o-5521"}]]]]
[= $r1 [$journal:saga-run $j $def {stream: "order:o-5521" actor: "agent-1" authority: "checkout"}]]
[= $r2 [$journal:saga-run $j $def {stream: "order:o-5521" actor: "agent-1" authority: "checkout"}]]
[= $st [$journal:saga-status $j "cs-1" {stream: "order:o-5521"}]]
[= $v [$journal:verify $j {stream: "order:o-5521"}]]
  [probe [run $r1] [replay $r2] [status $st/@status] [chain $v/@valid]]]"""] [expect """[probe [run [saga id=cs-1 status=:done [step name=reserve-inventory status=:done] [step name=authorize-payment status=:done] [step name=place-order status=:done pivot=true]]] [replay [deduped [saga id=cs-1 status=:done [step name=reserve-inventory status=:done] [step name=authorize-payment status=:done] [step name=place-order status=:done pivot=true]]]] [status :done] [chain true]]"""]]
]
[fn-doc name=shred-generation scope=public purity=impure
  [sig """-> int"""]
  [summary """The tenant's current shred-generation (0 before any committed erase-subject). The ENV-quadrant input of the §7 snapshot-reach design: bind it into your fold identity (the fold-id you pass to snapshot/fold-from/retain), and every committed shred moves the current fold-id — pre-shred snapshots then refuse fold-from with CXER4640, forcing a re-snapshot under the post-shred fold. A refused (held) erase never advances it."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://gen" "acme"]]
[= $g0 [$journal:shred-generation $j]]
[= $r [$journal:erase-subject $j "did:ex:dana" {actor: "dpo" authority: "rtbf-9"} {request: "shred-g-1"}]]
  [probe [before $g0] [after [$journal:shred-generation $j]]]]"""] [expect """[probe [before 0] [after 1]]"""]]
]
[fn-doc name=overlaps scope=public purity=pure
  [sig """-> bool"""]
  [summary """Do two vocabulary-bearing elements' half-open validity windows intersect? Absent valid-from/valid-to = unbounded on that side; half-open adjacency (one window's valid-to equal to the other's valid-from) does NOT overlap — no boundary double-count."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $a [promo pct=10 valid-from="2026-08-01" valid-to="2026-08-05"]]
[= $b [promo pct=20 valid-from="2026-08-04"]]
[= $c [promo pct=30 valid-from="2026-08-05" valid-to="2026-08-09"]]
  [intervals ab=[$journal:overlaps $a $b] ac=[$journal:overlaps $a $c] open=[$journal:overlaps $b $c] in=[$journal:contains-instant $a "2026-08-01"] out=[$journal:contains-instant $a "2026-08-05"]]]"""] [expect """[intervals ab=true ac=false open=true in=true out=false]"""]]
]
[fn-doc name=contains-instant scope=public purity=pure
  [sig """-> bool"""]
  [summary """Does the element's half-open validity window contain the instant? valid-from is inclusive, valid-to exclusive; an absent end is unbounded; an element with no valid-time vocabulary contains every instant."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $a [promo pct=10 valid-from="2026-08-01" valid-to="2026-08-05"]]
[= $b [promo pct=20 valid-from="2026-08-04"]]
[= $c [promo pct=30 valid-from="2026-08-05" valid-to="2026-08-09"]]
  [intervals ab=[$journal:overlaps $a $b] ac=[$journal:overlaps $a $c] open=[$journal:overlaps $b $c] in=[$journal:contains-instant $a "2026-08-01"] out=[$journal:contains-instant $a "2026-08-05"]]]"""] [expect """[intervals ab=true ac=false open=true in=true out=false]"""]]
]
[fn-doc name=replay scope=public purity=impure
  [sig """-> any"""]
  [summary """Deterministically re-execute the log into state, honouring replay options such as `at-seq`."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:replay $j [?fn ($a $e) [+ $a 1]] 0 {at-seq: 2}]]"""] [expect """2"""]]
]
[fn-doc name=dry-run scope=public purity=impure
  [sig """-> element"""]
  [summary """Preview the state and `[entry]` an append would produce, without committing it."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
  [$journal:dry-run $j [b] {actor: "u" authority: "g"} [?fn ($a $e) [+ $a 1]] 0]]"""] [expect """[dry-run [state 2] [entry seq=2 tenant=acme actor=u authority=g ts='1970-01-01T00:00:02Z' prev-hash='sha2-256:83a013836d0939e47c191cd4a5c079e89fe2f1ecfee486f7da7db50fcdeb9b98' payload=sha2-256:ca0dff2eeeb428d9b948154b48f08f4957c2aa0b9c36f31410812c2943df3b74 hash=sha2-256:d0ff5f72f597fa548dc5e52dc2e65d474e18a5fae0b440d09e2c29901ac39ac5]]"""]]
]
[fn-doc name=verify scope=public purity=impure
  [sig """-> element"""]
  [summary """Verify hash-chain integrity end to end, returning a `[verification]` finding (not an error on corruption). The chain verdict is syntactic — the entry hash covers the payload ADDRESS, so valid=true holds with payloads lawfully destroyed. On a valid walk every detached payload is fetched and re-hashed, and every missing payload reconciles against an ATTRIBUTED erasure record (a covering journaled shred-request, or the address's [erased] tombstone): the report gains redacted= payloads-verified= unattributed-missing= when the accounting engages, and any unattributed-missing > 0 is a LOUD finding — a payload gone with no lawful record is evidence of tampering or key loss, never silently counted among the redactions (stream 20)."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
  [$journal:verify $j {}]]"""] [expect """[verification valid=true checked-from=1 checked-to=2 head-hash=sha2-256:d0ff5f72f597fa548dc5e52dc2e65d474e18a5fae0b440d09e2c29901ac39ac5]"""]]
]
[fn-doc name=verify-slice scope=public purity=impure
  [sig """-> element"""]
  [summary """Verify hash-chain integrity over a `from..to` range, with the same payload reconciliation axis as `verify` over exactly that range."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
  [$journal:verify-slice $j 2 3]]"""] [expect """[verification valid=true checked-from=2 checked-to=3 head-hash=sha2-256:aea8756847199d3ffb540efb20ebfcc5d25f1b8a9396d66d1dfd14ca4b23952d]"""]]
]
[fn-doc name=coherence scope=public purity=impure
  [sig """-> element"""]
  [summary """Semantic linter over the reserved payload vocabulary: checks valid-from/valid-to carriers (half-open [from, to); open end = absent, never null) and [supersedes hash= relation=] linkage (relation is the atom :correction or :amendment), resolving each well-formed target against the tenant's retained entry hashes (stream 8). Given {upcast: $chain} it also runs the coverage pre-flight (stream 21): the chain is dry-applied to every event-bearing entry and each refusal becomes an :uncovered-entry finding with the declared schema visible. Findings are VALUES — never errors; verify stays syntactic."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://bt-105" "acme"]]
[= $e1 [$journal:append $j [price amount=10 [supersedes hash="sha2-256:00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff" relation=:correction]] {actor: "u" authority: "g"}]]
  [$journal:coherence $j {}]]"""] [expect """[coherence tenant=acme checked=1 findings=1 [finding kind=':dangling-supersedes' seq=1 hash='sha2-256:00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff']]"""]]
]
[fn-doc name=snapshot scope=public purity=impure
  [sig """-> element"""]
  [summary """Fold the log up to a sequence into a signed, derived state checkpoint so fold need not re-run from genesis. opts.fold-id (stream 21) records the fold identity — the (entries, chain, fn, init) quadruple as a computation address — INSIDE the signed preimage (the slot reserved at I1, omitted while unset); the tenant SET form refuses it (no reserved slot in its preimage)."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
  [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {sign: "false"}]]"""] [expect """[snapshot tenant=acme at-seq=1 anchor-hash='sha2-256:83a013836d0939e47c191cd4a5c079e89fe2f1ecfee486f7da7db50fcdeb9b98' hash-algo=sha2-256 sig-algo=none [state 1]]"""]]
]
[fn-doc name=snapshot-verify scope=public purity=impure
  [sig """-> element"""]
  [summary """Check a `[snapshot]` against the chain and against its own signature."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $bad [snapshot tenant=acme at-seq=1 anchor-hash="sha256:deadbeef" hash-algo=sha256 sig-algo=none [state 99]]]
  [$journal:snapshot-verify $j $bad]]"""] [expect """[snapshot-verification valid=false at-seq=1 reason=':algo-mismatch']"""]]
]
[fn-doc name=fold-from scope=public purity=impure
  [sig """-> any"""]
  [summary """Reconstruct state fast: verify a snapshot, then fold only the tail of entries after it. opts.fold-id declares the caller's CURRENT fold identity — a snapshot carrying a different identity, or none, refuses CXER4640 loudly (re-snapshot under the current fold); opts.upcast composes the stream-21 chain over the tail. Undeclared keeps the shipped path."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {sign: "false" at-seq: 1}]]
[= $full [$journal:fold $j [?fn ($a $e) [+ $a 1]] 0]]
[= $fast [$journal:fold-from $j $snap [?fn ($a $e) [+ $a 1]]]]
  [equiv full=$full fast=$fast]]"""] [expect """[equiv full=3 fast=3]"""]]
]
[fn-doc name=resnapshot scope=public purity=impure
  [sig """-> element"""]
  [summary """The L147 maintenance discipline as a verb (RULED: SEA-1): re-derive a snapshot at its OWN at-seq/stream under the CURRENT fold quadruple — fn, init, opts.upcast chain, opts.fold-id (required; the identity to stamp) — verifying the old snapshot against the chain first and signing per the snapshot rules (opts.signing-key / opts.sign=false / opts.signer). Idempotent when the snapshot already carries the declared identity. Refusals reuse existing codes: bad anchor CXER4615, bad signature CXER4613, set form / absent fold-id CXER4610, uncovered entries CXER4641, pruned prefix refuses like snapshot."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://rsnap" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $old [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {sign: "false" at-seq: 1}]]
[= $new [$journal:resnapshot $j [?fn ($a $e) [+ $a 1]] 0 $old {sign: "false" fold-id: "computes-as:sha2-256:v2v2"}]]
  [rederived at=$new@at-seq fold=$new@fold-id same-anchor=[= $old@anchor-hash $new@anchor-hash]]]"""] [expect """[rederived at=1 fold=computes-as:sha2-256:v2v2 same-anchor=true]"""]]
]
[fn-doc name=retain scope=public purity=impure
  [sig """-> element"""]
  [summary """Record a prune-behind-a-snapshot `[retention]` policy and check its snapshot coverage; deletes nothing. policy.fold-id declares the caller's CURRENT fold: the cover rule then reads covered-under-the-current-fold — a cover frozen under any other fold (or none) refuses CXER4616 with the re-snapshot teaching, closing the vocabulary-change data-loss path."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {signing-key: "0101010101010101010101010101010101010101010101010101010101010101" at-seq: 2}]]
  [$journal:retain $j {keep-after-seq: 2 snapshot: $snap}]]"""] [expect """[retention boundary=2 covered-by-seq=2]"""]]
]
[fn-doc name=compact scope=public purity=impure
  [sig """-> element"""]
  [summary """Copy a snapshot plus the retained tail forward into a new segment, leaving the source chain intact."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://src" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [c] {actor: "u" authority: "g"}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {signing-key: "0101010101010101010101010101010101010101010101010101010101010101" at-seq: 2}]]
[= $ret [$journal:retain $j {keep-after-seq: 2 snapshot: $snap}]]
[= $seg [$journal:compact $j {retention: $ret target: "mem://seg"}]]
  [$journal:verify $j {}]]"""] [expect """[verification valid=true checked-from=1 checked-to=3 head-hash=sha2-256:aea8756847199d3ffb540efb20ebfcc5d25f1b8a9396d66d1dfd14ca4b23952d]"""]]
]
[fn-doc name=subscribe scope=public purity=impure
  [sig """-> element"""]
  [summary """Open a local tail-follow subscription over one stream (the delivery contract): committed entries strictly above opts.from (default: the current head) deliver in seq order through [?receive]/[?select]; a from below the retained floor refuses CXER4617."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://jsub-doc" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[= $sub [$journal:subscribe $j {from: 0}]]
[= $r1 [?receive from=$sub]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g"}]]
[= $b [?receive from=$sub max=5 deadline=0]]
  ([first $r1/@seq], [then n=[$count $b]], [rung $sub@rung])]"""] [expect """([first 1], [then n=1], [rung ':complete-ordered'])"""]]
]
[fn-doc name=seq-at scope=public purity=impure
  [sig """-> element"""]
  [summary """Resolve a timestamp to a stream position: the largest seq whose commit ts is at-or-before the given datetime, or absence — time is an index into positions, never a cursor form."""]
  [example [code """[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://jseq-doc" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g"}]]
[= $p [$journal:seq-at $j "1970-01-01T00:00:01Z"]]
  [at seq=$p@seq]]"""] [expect """[at seq=1]"""]]
]
