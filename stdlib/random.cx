[; cx-stdlib/random — PRNG (xoshiro256++) + crypto-random.

   Full surface per spec/stdlib_random.md §3. Bodies forward to
   native primitives (vcx/code/stdlib_random.v) since generation of
   pseudo-random / cryptographic values is not expressible in pure CX.

   PRNG is process-global (impure) with explicit-state -with mirrors
   (pure given the generator). The -with mirrors return [result :value v
   :next-generator g] pairs threaded by the caller. Crypto-random is
   kernel-backed and never seedable. ]

[; §3.1 PRNG process-global (impure) ]
[?def seed         scope=public impure [returns null]             ($s::int)               [$random-seed $s]]
[?def next-int     scope=public impure [returns int]              ()                     [$random-next-int]]
[?def next-float   scope=public impure [returns float]            ()                     [$random-next-float]]
[?def next-bool    scope=public impure [returns bool]             ()                     [$random-next-bool]]
[?def int-range    scope=public impure [returns int]              ($lo::int $hi::int)      [$random-int-range $lo $hi]]
[?def float-range  scope=public impure [returns float]            ($lo::float $hi::float)  [$random-float-range $lo $hi]]
[?def shuffle      scope=public impure [returns [sequence any]]   ($xs::[sequence any])   [$random-shuffle $xs]]
[?def choose       scope=public impure [returns any]              ($xs::[sequence any])   [$random-choose $xs]]
[?def sample       scope=public impure [returns [sequence any]]   ($xs::[sequence any] $n::int) [$random-sample $xs $n]]

[; §3.2 PRNG explicit-state (pure given generator) ]
[?def from-seed         scope=public pure [returns element] ($s::int)                            [$random-from-seed $s]]
[?def next-int-with     scope=public pure [returns element] ($gen::element)                      [$random-next-int-with $gen]]
[?def next-float-with   scope=public pure [returns element] ($gen::element)                      [$random-next-float-with $gen]]
[?def next-bool-with    scope=public pure [returns element] ($gen::element)                      [$random-next-bool-with $gen]]
[?def int-range-with    scope=public pure [returns element] ($gen::element $lo::int $hi::int)      [$random-int-range-with $gen $lo $hi]]
[?def float-range-with  scope=public pure [returns element] ($gen::element $lo::float $hi::float)  [$random-float-range-with $gen $lo $hi]]
[?def shuffle-with      scope=public pure [returns element] ($gen::element $xs::[sequence any])   [$random-shuffle-with $gen $xs]]
[?def choose-with       scope=public pure [returns element] ($gen::element $xs::[sequence any])   [$random-choose-with $gen $xs]]
[?def sample-with       scope=public pure [returns element] ($gen::element $xs::[sequence any] $n::int) [$random-sample-with $gen $xs $n]]

[; §3.3 crypto-random (impure, kernel-backed) ]
[?def crypto-bytes         scope=public impure [returns bytes]  ($n::int)          [$random-crypto-bytes $n]]
[?def crypto-int           scope=public impure [returns int]    ($lo::int $hi::int) [$random-crypto-int $lo $hi]]
[?def crypto-hex           scope=public impure [returns string] ($n::int)          [$random-crypto-hex $n]]
[?def crypto-base64-url    scope=public impure [returns string] ($n::int)          [$random-crypto-base64-url $n]]
[?def crypto-token-urlsafe scope=public impure [returns string] ($n::int)          [$random-crypto-token-urlsafe $n]]

[; §3.4 distribution helpers ]
[?def gaussian      scope=public impure [returns float] ($mean::float $stddev::float) [$random-gaussian $mean $stddev]]
[?def exponential   scope=public impure [returns float] ($lambda::float)             [$random-exponential $lambda]]
[?def poisson       scope=public impure [returns int]   ($lambda::float)             [$random-poisson $lambda]]
[?def gaussian-with    scope=public pure [returns element] ($gen::element $mean::float $stddev::float) [$random-gaussian-with $gen $mean $stddev]]
[?def exponential-with scope=public pure [returns element] ($gen::element $lambda::float)             [$random-exponential-with $gen $lambda]]
[?def poisson-with     scope=public pure [returns element] ($gen::element $lambda::float)             [$random-poisson-with $gen $lambda]]

[; §3.5 weighted sampling ]
[?def choose-weighted   scope=public impure [returns any]            ($xs::[sequence any] $weights::[sequence float])        [$random-choose-weighted $xs $weights]]
[?def sample-weighted   scope=public impure [returns [sequence any]] ($xs::[sequence any] $weights::[sequence float] $n::int) [$random-sample-weighted $xs $weights $n]]
[?def choose-weighted-with scope=public pure [returns element] ($gen::element $xs::[sequence any] $weights::[sequence float])        [$random-choose-weighted-with $gen $xs $weights]]
[?def sample-weighted-with scope=public pure [returns element] ($gen::element $xs::[sequence any] $weights::[sequence float] $n::int) [$random-sample-weighted-with $gen $xs $weights $n]]

[; §3.6 vectorized generation ]
[?def next-floats    scope=public impure [returns [sequence float]] ($n::int) [$random-next-floats $n]]
[?def next-ints      scope=public impure [returns [sequence int]]   ($n::int) [$random-next-ints $n]]
[?def next-floats-with scope=public pure [returns element] ($gen::element $n::int) [$random-next-floats-with $gen $n]]
[?def next-ints-with   scope=public pure [returns element] ($gen::element $n::int) [$random-next-ints-with $gen $n]]

[; co-located docs (seeded — refine in place). ]
[module-doc name=random
  [scope """Two distinct randomness facilities, kept cleanly separated so PRNG output can never accidentally stand in for crypto. The PRNG path is seeded and reproducible — for simulation, sampling, and shuffling — and comes in a process-global form plus pure explicit-state mirrors. The crypto-random path is kernel-backed cryptographic randomness for tokens, keys, and salts, and is never seedable. This module owns generation of random values; keyed transforms belong to cx-stdlib/crypto."""]]
[fn-doc name=seed scope=public purity=impure
  [sig """-> null"""]
  [summary """Re-seed the process-global PRNG so its sequence becomes reproducible."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $a [$random:seed 42]] [$random:next-int]]"""] [expect """7510639304993616975"""]]
]
[fn-doc name=next-int scope=public purity=impure
  [sig """-> int"""]
  [summary """Draw a uniform 63-bit non-negative integer from the process-global PRNG."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $a [$random:seed 42]] [$random:next-int]]"""] [expect """7510639304993616975"""]]
]
[fn-doc name=next-float scope=public purity=impure
  [sig """-> float"""]
  [summary """Draw a uniform float in the half-open range 0.0 to 1.0 from the process-global PRNG."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $a [$random:seed 42]] [?let [= $f [$random:next-float]] [and [>= $f 0.0] [< $f 1.0]]]]"""] [expect """true"""]]
]
[fn-doc name=next-bool scope=public purity=impure
  [sig """-> bool"""]
  [summary """Draw a uniform random boolean from the process-global PRNG."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $a [$random:seed 42]] [?let [= $b [$random:next-bool]] [or [= $b true] [= $b false]]]]"""] [expect """true"""]]
]
[fn-doc name=int-range scope=public purity=impure
  [sig """-> int"""]
  [summary """Draw a uniform integer in the inclusive range lo to hi, with no modulo bias."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:int-range 5 5]"""] [expect """5"""]]
]
[fn-doc name=float-range scope=public purity=impure
  [sig """-> float"""]
  [summary """Draw a uniform float in the half-open range lo to hi."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:float-range 2.5 2.5]"""] [expect """2.5"""]]
]
[fn-doc name=shuffle scope=public purity=impure
  [sig """-> [sequence any]"""]
  [summary """Return a new Fisher-Yates shuffle of the sequence."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:shuffle (42)]"""] [expect """(42)"""]]
]
[fn-doc name=choose scope=public purity=impure
  [sig """-> any"""]
  [summary """Pick one element uniformly at random from the sequence."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:choose ("only")]"""] [expect """'only'"""]]
]
[fn-doc name=sample scope=public purity=impure
  [sig """-> [sequence any]"""]
  [summary """Draw a uniform sample of size n without replacement from the sequence."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:sample (1, 2, 3) 0]"""] [expect """()"""]]
]
[fn-doc name=from-seed scope=public purity=pure
  [sig """-> element"""]
  [summary """Build an explicit-state generator carrying its own reproducible state from a seed."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-int-with [$random:from-seed 42]]] $r/value]"""] [expect """7510639304993616975"""]]
]
[fn-doc name=next-int-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw a 63-bit integer from an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-int-with [$random:from-seed 42]]] $r/value]"""] [expect """7510639304993616975"""]]
]
[fn-doc name=next-float-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw a float in 0.0 to 1.0 from an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-float-with [$random:from-seed 42]]] $r/value]"""] [expect """0.8143051451229099"""]]
]
[fn-doc name=next-bool-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw a boolean from an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-bool-with [$random:from-seed 42]]] $r/value]"""] [expect """true"""]]
]
[fn-doc name=int-range-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw an unbiased integer in lo to hi from an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:int-range-with [$random:from-seed 7] 9 9]] $r/value]"""] [expect """9"""]]
]
[fn-doc name=float-range-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw a float in lo to hi from an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:float-range-with [$random:from-seed 7] 2.5 2.5]] $r/value]"""] [expect """2.5"""]]
]
[fn-doc name=shuffle-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Shuffle a sequence with an explicit generator, returning the result and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:shuffle-with [$random:from-seed 42] (1, 2, 3, 4, 5)]] $r/value]"""] [expect """(4, 3, 1, 5, 2)"""]]
]
[fn-doc name=choose-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Pick one element with an explicit generator, returning the choice and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:choose-with [$random:from-seed 3] ("solo")]] $r/value]"""] [expect """'solo'"""]]
]
[fn-doc name=sample-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Sample n elements without replacement with an explicit generator, returning the sample and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:sample-with [$random:from-seed 42] (10, 20, 30, 40, 50) 3]] $r/value]"""] [expect """(40, 30, 10)"""]]
]
[fn-doc name=crypto-bytes scope=public purity=impure
  [sig """-> bytes"""]
  [summary """Return n cryptographically random bytes from the system CSPRNG."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:crypto-bytes -1]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=crypto-int scope=public purity=impure
  [sig """-> int"""]
  [summary """Return a cryptographically random integer in the inclusive range lo to hi, unbiased."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:crypto-int 7 7]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=crypto-hex scope=public purity=impure
  [sig """-> string"""]
  [summary """Return n cryptographically random bytes as a lowercase hex string of length 2n."""]
  [example [code """[?lib 'cx-stdlib/random']
[$string-length [$random:crypto-hex 8]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=crypto-base64-url scope=public purity=impure
  [sig """-> string"""]
  [summary """Return n cryptographically random bytes as an unpadded base64-url string."""]
  [example [code """[?lib 'cx-stdlib/random']
[$contains [$random:crypto-base64-url 32] "="]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=crypto-token-urlsafe scope=public purity=impure
  [sig """-> string"""]
  [summary """Return a URL-safe random session token, base64-url with a default of 32 bytes."""]
  [example [code """[?lib 'cx-stdlib/random']
[$contains [$random:crypto-token-urlsafe 32] "="]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=gaussian scope=public purity=impure
  [sig """-> float"""]
  [summary """Draw a normally-distributed float with the given mean and standard deviation."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:gaussian 5.0 0.0]"""] [expect """5.0"""]]
]
[fn-doc name=exponential scope=public purity=impure
  [sig """-> float"""]
  [summary """Draw an exponentially-distributed float with rate lambda."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:exponential 0.0]"""] [expect """cx-err:CXER1905"""]]
]
[fn-doc name=poisson scope=public purity=impure
  [sig """-> int"""]
  [summary """Draw a Poisson-distributed integer with mean lambda."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:poisson -2.0]"""] [expect """cx-err:CXER1905"""]]
]
[fn-doc name=gaussian-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw a normal value with an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:gaussian-with [$random:from-seed 11] 3.0 0.0]] $r/value]"""] [expect """3.0"""]]
]
[fn-doc name=exponential-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw an exponential value with an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:exponential-with [$random:from-seed 42] 1.0]] $r/value]"""] [expect """1.683650517646569"""]]
]
[fn-doc name=poisson-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Draw a Poisson value with an explicit generator, returning the value and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:poisson-with [$random:from-seed 42] 4.0]] $r/value]"""] [expect """6"""]]
]
[fn-doc name=choose-weighted scope=public purity=impure
  [sig """-> any"""]
  [summary """Pick one element with probability proportional to its weight."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:choose-weighted ("a", "b") (1.0)]"""] [expect """cx-err:CXER1904"""]]
]
[fn-doc name=sample-weighted scope=public purity=impure
  [sig """-> [sequence any]"""]
  [summary """Sample n elements without replacement, proportional to remaining weights."""]
  [example [code """[?lib 'cx-stdlib/random']
[$random:sample-weighted ("a", "b") (1.0, 0.0) 2]"""] [expect """cx-err:CXER1903"""]]
]
[fn-doc name=choose-weighted-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Weighted pick with an explicit generator, returning the choice and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:choose-weighted-with [$random:from-seed 5] ("a", "b") (0.0, 1.0)]] $r/value]"""] [expect """'b'"""]]
]
[fn-doc name=sample-weighted-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Weighted sample of n without replacement using an explicit generator, returning the sample and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:sample-weighted-with [$random:from-seed 42] ("a", "b", "c") (1.0, 1.0, 1.0) 2]] [$count $r/value]]"""] [expect """2"""]]
]
[fn-doc name=next-floats scope=public purity=impure
  [sig """-> [sequence float]"""]
  [summary """Return a sequence of n uniform floats in 0.0 to 1.0."""]
  [example [code """[?lib 'cx-stdlib/random']
[$count [$random:next-floats 5]]"""] [expect """5"""]]
]
[fn-doc name=next-ints scope=public purity=impure
  [sig """-> [sequence int]"""]
  [summary """Return a sequence of n uniform 63-bit non-negative integers."""]
  [example [code """[?lib 'cx-stdlib/random']
[$count [$random:next-ints 7]]"""] [expect """7"""]]
]
[fn-doc name=next-floats-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Generate n floats with an explicit generator, returning the sequence and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-floats-with [$random:from-seed 42] 3]] $r/value]"""] [expect """(0.8143051451229099, 0.3188210400616611, 0.9838941681774888)"""]]
]
[fn-doc name=next-ints-with scope=public purity=pure
  [sig """-> element"""]
  [summary """Generate n integers with an explicit generator, returning the sequence and next generator."""]
  [example [code """[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-ints-with [$random:from-seed 42] 3]] $r/value]"""] [expect """(7510639304993616975, 2940605065665682376, 9074821957992740550)"""]]
]
