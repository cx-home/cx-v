[; cx-stdlib/time — date / datetime / duration / instant manipulation.

   Full surface per spec/stdlib_time.md §3. Bodies call native
   primitives (vcx/code/stdlib_time.v) since Gregorian calendar math,
   ISO/RFC parsing, LDML formatting and tz offsets are not expressible
   in pure CX. Instants and durations are carried as int nanoseconds;
   dates / datetimes as typed scalar strings; weekday as an atom.

   NOTE: this const and stdlib/time.cx are the same source — edit both. ]

[; §3.1 time sources (impure) ]
[?def now              scope=public impure [returns datetime] ()                   [$time-now]]
[?def today            scope=public impure [returns date]     ()                   [$time-today]]
[?def instant-now      scope=public impure [returns instant]  ()                   [$time-instant-now]]
[?def monotonic-now    scope=public impure [returns int]      ()                   [$time-monotonic-now]]
[?def now-mock         scope=public pure   [returns datetime] ($t::datetime)        [$time-now-mock $t]]
[?def today-mock       scope=public pure   [returns date]     ($d::date)            [$time-today-mock $d]]
[?def instant-now-mock scope=public pure   [returns instant]  ($i::instant)         [$time-instant-now-mock $i]]
[?def mock-advance     scope=public impure [returns null]     ($d::duration)        [$time-mock-advance $d]]
[?def mock-set         scope=public impure [returns null]     ($t::instant)         [$time-mock-set $t]]

[; §3.2 construction ]
[?def date             scope=public pure [returns date] ($year::int $month::int $day::int) [$time-date $year $month $day]]
[?def datetime         scope=public pure [returns datetime] ($year::int $month::int $day::int $hour::int $minute::int $second::int) [$time-datetime $year $month $day $hour $minute $second]]
[?def datetime-with-tz scope=public pure [returns datetime] ($year::int $month::int $day::int $hour::int $minute::int $second::int $tz::string) [$time-datetime-with-tz $year $month $day $hour $minute $second $tz]]
[?def from-unix        scope=public pure [returns instant] ($unix-seconds::int) [$time-from-unix $unix-seconds]]
[?def from-unix-ms     scope=public pure [returns instant] ($unix-millis::int)  [$time-from-unix-ms $unix-millis]]
[?def from-unix-ns     scope=public pure [returns instant] ($unix-nanos::int)   [$time-from-unix-ns $unix-nanos]]
[?def epoch            scope=public pure [returns instant] () [$time-epoch]]

[; §3.3 decomposition ]
[?def year             scope=public pure [returns int] ($d::any) [$time-year $d]]
[?def month            scope=public pure [returns int] ($d::any) [$time-month $d]]
[?def day              scope=public pure [returns int] ($d::any) [$time-day $d]]
[?def hour             scope=public pure [returns int] ($dt::datetime) [$time-hour $dt]]
[?def minute           scope=public pure [returns int] ($dt::datetime) [$time-minute $dt]]
[?def second           scope=public pure [returns int] ($dt::datetime) [$time-second $dt]]
[?def nanosecond       scope=public pure [returns int] ($dt::datetime) [$time-nanosecond $dt]]
[?def weekday          scope=public pure [returns atom] ($d::any) [$time-weekday $d]]
[?def day-of-year      scope=public pure [returns int] ($d::any) [$time-day-of-year $d]]
[?def week-of-year     scope=public pure [returns int] ($d::any) [$time-week-of-year $d]]
[?def timezone-offset  scope=public pure [returns int] ($dt::datetime) [$time-timezone-offset $dt]]
[?def to-unix          scope=public pure [returns int] ($dt::datetime) [$time-to-unix $dt]]
[?def to-unix-ms       scope=public pure [returns int] ($dt::datetime) [$time-to-unix-ms $dt]]
[?def to-unix-ns       scope=public pure [returns int] ($dt::datetime) [$time-to-unix-ns $dt]]

[; §3.4 arithmetic ]
[?def add              scope=public pure [returns any] ($t::any $d::duration) [$time-add $t $d]]
[?def subtract         scope=public pure [returns any] ($t::any $d::duration) [$time-subtract $t $d]]
[?def diff             scope=public pure [returns duration] ($a::any $b::any) [$time-diff $a $b]]
[?def add-days          scope=public pure [returns date] ($d::date $n::int) [$time-add-days $d $n]]
[?def add-months        scope=public pure [returns date] ($d::date $n::int) [$time-add-months $d $n]]
[?def add-months-strict scope=public pure [returns date] ($d::date $n::int) [$time-add-months-strict $d $n]]
[?def add-years         scope=public pure [returns date] ($d::date $n::int) [$time-add-years $d $n]]
[?def add-hours         scope=public pure [returns datetime] ($dt::datetime $n::int) [$time-add-hours $dt $n]]
[?def add-minutes       scope=public pure [returns datetime] ($dt::datetime $n::int) [$time-add-minutes $dt $n]]
[?def add-seconds       scope=public pure [returns datetime] ($dt::datetime $n::int) [$time-add-seconds $dt $n]]

[; §3.5 duration construction and conversion ]
[?def duration-ms     scope=public pure [returns duration] ($ms::int) [$time-duration-ms $ms]]
[?def duration-s      scope=public pure [returns duration] ($s::int)  [$time-duration-s $s]]
[?def duration-m      scope=public pure [returns duration] ($m::int)  [$time-duration-m $m]]
[?def duration-h      scope=public pure [returns duration] ($h::int)  [$time-duration-h $h]]
[?def duration-d      scope=public pure [returns duration] ($d::int)  [$time-duration-d $d]]
[?def duration-parts  scope=public pure [returns element] ($d::duration) [$time-duration-parts $d]]
[?def duration-total-ms scope=public pure [returns int] ($d::duration) [$time-duration-total-ms $d]]
[?def duration-total-s  scope=public pure [returns int] ($d::duration) [$time-duration-total-s $d]]
[?def duration-total-h  scope=public pure [returns float] ($d::duration) [$time-duration-total-h $d]]
[?def duration-add    scope=public pure [returns duration] ($a::duration $b::duration) [$time-duration-add $a $b]]
[?def duration-sub    scope=public pure [returns duration] ($a::duration $b::duration) [$time-duration-sub $a $b]]
[?def duration-mul    scope=public pure [returns duration] ($d::duration $n::int) [$time-duration-mul $d $n]]
[?def duration-div    scope=public pure [returns duration] ($d::duration $n::int) [$time-duration-div $d $n]]

[; §3.6 parsing ]
[?def parse-date        scope=public pure [returns date] ($s::string)     [$time-parse-date $s]]
[?def parse-datetime    scope=public pure [returns datetime] ($s::string) [$time-parse-datetime $s]]
[?def parse-instant     scope=public pure [returns instant] ($s::string)  [$time-parse-instant $s]]
[?def parse-duration    scope=public pure [returns duration] ($s::string) [$time-parse-duration $s]]
[?def parse-rfc3339     scope=public pure [returns datetime] ($s::string) [$time-parse-rfc3339 $s]]
[?def parse-rfc2822     scope=public pure [returns datetime] ($s::string) [$time-parse-rfc2822 $s]]
[?def parse-with-format scope=public pure [returns datetime] ($s::string $format::string) [$time-parse-with-format $s $format]]
[?def parse-strftime    scope=public pure [returns datetime] ($s::string $format::string) [$time-parse-strftime $s $format]]

[; §3.7 formatting ]
[?def format-iso8601     scope=public pure [returns string] ($dt::any) [$time-format-iso8601 $dt]]
[?def format-rfc3339     scope=public pure [returns string] ($dt::datetime) [$time-format-rfc3339 $dt]]
[?def format-rfc2822     scope=public pure [returns string] ($dt::datetime) [$time-format-rfc2822 $dt]]
[?def format-with-format scope=public pure [returns string] ($dt::any $format::string) [$time-format-with-format $dt $format]]
[?def format-duration    scope=public pure [returns string] ($d::duration) [$time-format-duration $d]]
[?def format-relative    scope=public pure [returns string] ($dt::datetime $now-dt::datetime) [$time-format-relative $dt $now-dt]]

[; §3.8 timezone ]
[?def timezone        scope=public pure [returns element] ($name::string) [$time-timezone $name]]
[?def to-timezone     scope=public pure [returns datetime] ($dt::datetime $tz::string) [$time-to-timezone $dt $tz]]
[?def to-utc          scope=public pure [returns datetime] ($dt::datetime) [$time-to-utc $dt]]
[?def utc-now         scope=public impure [returns datetime] () [$time-utc-now]]
[?def system-timezone scope=public impure [returns string] () [$time-system-timezone]]
[?def list-timezones  scope=public pure [returns [sequence string]] () [$time-list-timezones]]

[; §3.9 predicates ]
[?def is-leap-year    scope=public pure [returns bool] ($year::int) [$time-is-leap-year $year]]
[?def is-before       scope=public pure [returns bool] ($a::any $b::any) [$time-is-before $a $b]]
[?def is-after        scope=public pure [returns bool] ($a::any $b::any) [$time-is-after $a $b]]
[?def is-same         scope=public pure [returns bool] ($a::any $b::any) [$time-is-same $a $b]]
[?def is-same-day     scope=public pure [returns bool] ($a::datetime $b::datetime) [$time-is-same-day $a $b]]
[?def days-in-month   scope=public pure [returns int] ($year::int $month::int) [$time-days-in-month $year $month]]

[; §3.10 recurrence rules — RFC 5545 RRULE + cron; all pure (no clock) ]
[?def recurrence       scope=public pure [returns element]             ($freq::atom $anchor::datetime $tz::string $opts::map {}) [$time-recurrence $freq $anchor $tz $opts]]
[?def validate-rule    scope=public pure [returns element]             ($rule::element) [$time-validate-rule $rule]]
[?def is-valid-rule    scope=public pure [returns bool]                ($rule::element) [$time-is-valid-rule $rule]]
[?def parse-rrule      scope=public pure [returns element]             ($s::string $anchor::datetime $tz::string $opts::map {}) [$time-parse-rrule $s $anchor $tz $opts]]
[?def format-rrule     scope=public pure [returns string]              ($rule::element) [$time-format-rrule $rule]]
[?def parse-cron       scope=public pure [returns element]             ($s::string $tz::string $opts::map {}) [$time-parse-cron $s $tz $opts]]
[?def format-cron      scope=public pure [returns element]             ($rule::element) [$time-format-cron $rule]]
[?def next-occurrence  scope=public pure [returns datetime]            ($rule::element $after::datetime) [$time-next-occurrence $rule $after]]
[?def occurrences-in   scope=public pure [returns [sequence datetime]] ($rule::element $from::datetime $to::datetime) [$time-occurrences-in $rule $from $to]]
[?def nth-occurrence   scope=public pure [returns datetime]            ($rule::element $n::int) [$time-nth-occurrence $rule $n]]
[?def rule-freq        scope=public pure [returns atom]                ($rule::element) [$time-rule-freq $rule]]
[?def rule-bound       scope=public pure [returns element]             ($rule::element) [$time-rule-bound $rule]]
[?def rule-is-finite   scope=public pure [returns bool]                ($rule::element) [$time-rule-is-finite $rule]]

[; co-located docs (seeded — refine in place). ]
[module-doc name=time
  [scope """Dates, datetimes, durations, and instants, with wall-clock and monotonic time sources. Covers construction and decomposition, exact-time and calendar arithmetic, ISO 8601 / RFC 3339 / RFC 2822 / ICU-LDML parsing and formatting, timezone handling, RFC 5545 RRULE and cron recurrence rules, and mockable clocks for deterministic-time testing. Durations are signed nanosecond counts; date and datetime values come from the parse and construction functions."""]]
[fn-doc name=now scope=public purity=impure
  [sig """-> datetime"""]
  [summary """Return the current wall-clock datetime from the host."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:now]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=today scope=public purity=impure
  [sig """-> date"""]
  [summary """Return the current wall-clock date from the host."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:today]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=instant-now scope=public purity=impure
  [sig """-> instant"""]
  [summary """Return the current wall-clock instant (UTC-anchored timestamp)."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:instant-now]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=monotonic-now scope=public purity=impure
  [sig """-> int"""]
  [summary """Return a monotonic clock reading in nanoseconds, for measuring elapsed time."""]
  [example [code """[?lib 'cx-stdlib/time']
[?let [= $a [$time:monotonic-now]] [?let [= $b [$time:monotonic-now]] [>= $b $a]]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=now-mock scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Pin the mock clock to a fixed datetime for deterministic-time testing."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-iso8601 [$time:now-mock [$time:datetime 2026 5 26 14 30 0]]]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=today-mock scope=public purity=pure
  [sig """-> date"""]
  [summary """Pin the mock clock to a fixed date for deterministic-time testing."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:year [$time:today-mock [$time:date 2026 5 26]]]"""] [expect """2026"""]]
]
[fn-doc name=instant-now-mock scope=public purity=pure
  [sig """-> instant"""]
  [summary """Pin the mock clock to a fixed instant for deterministic-time testing."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:instant-now-mock 1000000000]"""] [expect """1000000000"""]]
]
[fn-doc name=mock-advance scope=public purity=impure
  [sig """-> null"""]
  [summary """Step the frozen mock clock forward by a duration."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:mock-advance [$time:duration-h 1]]"""] [expect """null"""]]
]
[fn-doc name=mock-set scope=public purity=impure
  [sig """-> null"""]
  [summary """Re-pin the mock clock to an absolute instant."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:mock-set [$time:from-unix 1000]]"""] [expect """null"""]]
]
[fn-doc name=date scope=public purity=pure
  [sig """-> date"""]
  [summary """Construct a date from year, month, and day components."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:date 2026 5 26]"""] [expect """'2026-05-26'"""]]
]
[fn-doc name=datetime scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Construct a UTC datetime from year, month, day, hour, minute, and second."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:datetime 2026 5 26 14 30 0]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=datetime-with-tz scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Construct a datetime from components interpreted in the named timezone."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:datetime-with-tz 2026 1 15 12 0 0 "America/New_York"]"""] [expect """'2026-01-15T12:00:00-05:00'"""]]
]
[fn-doc name=from-unix scope=public purity=pure
  [sig """-> instant"""]
  [summary """Construct an instant from a Unix timestamp in seconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:from-unix 1000]"""] [expect """1000000000000"""]]
]
[fn-doc name=from-unix-ms scope=public purity=pure
  [sig """-> instant"""]
  [summary """Construct an instant from a Unix timestamp in milliseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:from-unix-ms 1500]"""] [expect """1500000000"""]]
]
[fn-doc name=from-unix-ns scope=public purity=pure
  [sig """-> instant"""]
  [summary """Construct an instant from a Unix timestamp in nanoseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:from-unix-ns 42]"""] [expect """42"""]]
]
[fn-doc name=epoch scope=public purity=pure
  [sig """-> instant"""]
  [summary """Return the Unix epoch instant (1970-01-01T00:00:00Z)."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:epoch]"""] [expect """0"""]]
]
[fn-doc name=year scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the year component of a date or datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:year [$time:parse-date "2026-05-26"]]"""] [expect """2026"""]]
]
[fn-doc name=month scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the month component (1-12) of a date or datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:month [$time:parse-date "2026-05-26"]]"""] [expect """5"""]]
]
[fn-doc name=day scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the day-of-month component of a date or datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:day [$time:parse-date "2026-05-26"]]"""] [expect """26"""]]
]
[fn-doc name=hour scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the hour component (0-23) of a datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:hour [$time:parse-datetime "2026-05-26T14:30:45Z"]]"""] [expect """14"""]]
]
[fn-doc name=minute scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the minute component (0-59) of a datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:minute [$time:parse-datetime "2026-05-26T14:30:45Z"]]"""] [expect """30"""]]
]
[fn-doc name=second scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the second component (0-59) of a datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:second [$time:parse-datetime "2026-05-26T14:30:45Z"]]"""] [expect """45"""]]
]
[fn-doc name=nanosecond scope=public purity=pure
  [sig """-> int"""]
  [summary """Extract the sub-second nanosecond component of a datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:nanosecond [$time:parse-datetime "2026-05-26T14:30:45.250Z"]]"""] [expect """250000000"""]]
]
[fn-doc name=weekday scope=public purity=pure
  [sig """-> atom"""]
  [summary """Return the day of the week as an atom, from :monday to :sunday."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:weekday [$time:parse-date "2026-05-26"]]"""] [expect """:tuesday"""]]
]
[fn-doc name=day-of-year scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the 1-based day of the year (1-366)."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:day-of-year [$time:parse-date "2026-01-01"]]"""] [expect """1"""]]
]
[fn-doc name=week-of-year scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the week number of the year."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:week-of-year [$time:parse-date "2026-01-05"]]"""] [expect """2"""]]
]
[fn-doc name=timezone-offset scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the offset from UTC in seconds for a datetime."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:timezone-offset [$time:parse-datetime "2026-01-15T12:00:00-05:00"]]"""] [expect """-18000"""]]
]
[fn-doc name=to-unix scope=public purity=pure
  [sig """-> int"""]
  [summary """Convert a datetime to a Unix timestamp in seconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:to-unix [$time:parse-datetime "1970-01-01T00:16:40Z"]]"""] [expect """1000"""]]
]
[fn-doc name=to-unix-ms scope=public purity=pure
  [sig """-> int"""]
  [summary """Convert a datetime to a Unix timestamp in milliseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:to-unix-ms [$time:parse-datetime "1970-01-01T00:00:01Z"]]"""] [expect """1000"""]]
]
[fn-doc name=to-unix-ns scope=public purity=pure
  [sig """-> int"""]
  [summary """Convert a datetime to a Unix timestamp in nanoseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:to-unix-ns [$time:parse-datetime "1970-01-01T00:00:01Z"]]"""] [expect """1000000000"""]]
]
[fn-doc name=add scope=public purity=pure
  [sig """-> any"""]
  [summary """Add a duration to a date, datetime, or instant, advancing real elapsed time."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add [$time:parse-datetime "2026-05-26T14:00:00Z"] [$time:duration-h 2]]"""] [expect """'2026-05-26T16:00:00Z'"""]]
]
[fn-doc name=subtract scope=public purity=pure
  [sig """-> any"""]
  [summary """Subtract a duration from a date, datetime, or instant, rewinding real elapsed time."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:subtract [$time:parse-datetime "2026-05-26T14:00:00Z"] [$time:duration-h 2]]"""] [expect """'2026-05-26T12:00:00Z'"""]]
]
[fn-doc name=diff scope=public purity=pure
  [sig """-> duration"""]
  [summary """Return the duration from the second time to the first."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:diff [$time:parse-datetime "2026-05-26T14:00:00Z"] [$time:parse-datetime "2026-05-26T13:00:00Z"]]"""] [expect """3600000000000"""]]
]
[fn-doc name=add-days scope=public purity=pure
  [sig """-> date"""]
  [summary """Advance a date by a number of calendar days."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-days [$time:parse-date "2026-05-26"] 10]"""] [expect """'2026-06-05'"""]]
]
[fn-doc name=add-months scope=public purity=pure
  [sig """-> date"""]
  [summary """Advance a date by a number of calendar months, clamping to end-of-month."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-months [$time:parse-date "2026-01-31"] 1]"""] [expect """'2026-02-28'"""]]
]
[fn-doc name=add-months-strict scope=public purity=pure
  [sig """-> date"""]
  [summary """Advance a date by calendar months, raising rather than clamping a non-existent day."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-months-strict [$time:parse-date "2026-01-31"] 1]"""] [expect """cx-err:CXER3300"""]]
]
[fn-doc name=add-years scope=public purity=pure
  [sig """-> date"""]
  [summary """Advance a date by a number of calendar years, clamping to end-of-month."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-years [$time:parse-date "2024-02-29"] 1]"""] [expect """'2025-02-28'"""]]
]
[fn-doc name=add-hours scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Advance a datetime by a number of hours of real elapsed time."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-hours [$time:parse-datetime "2026-05-26T22:00:00Z"] 5]"""] [expect """'2026-05-27T03:00:00Z'"""]]
]
[fn-doc name=add-minutes scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Advance a datetime by a number of minutes of real elapsed time."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-minutes [$time:parse-datetime "2026-05-26T14:00:00Z"] 90]"""] [expect """'2026-05-26T15:30:00Z'"""]]
]
[fn-doc name=add-seconds scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Advance a datetime by a number of seconds of real elapsed time."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add-seconds [$time:parse-datetime "2026-05-26T14:00:00Z"] 75]"""] [expect """'2026-05-26T14:01:15Z'"""]]
]
[fn-doc name=duration-ms scope=public purity=pure
  [sig """-> duration"""]
  [summary """Build a duration from a count of milliseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-ms 100]"""] [expect """100000000"""]]
]
[fn-doc name=duration-s scope=public purity=pure
  [sig """-> duration"""]
  [summary """Build a duration from a count of seconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-s 5]"""] [expect """5000000000"""]]
]
[fn-doc name=duration-m scope=public purity=pure
  [sig """-> duration"""]
  [summary """Build a duration from a count of minutes."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-m 2]"""] [expect """120000000000"""]]
]
[fn-doc name=duration-h scope=public purity=pure
  [sig """-> duration"""]
  [summary """Build a duration from a count of hours."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:add [$time:parse-datetime "2026-05-26T14:00:00Z"] [$time:duration-h 2]]"""] [expect """'2026-05-26T16:00:00Z'"""]]
]
[fn-doc name=duration-d scope=public purity=pure
  [sig """-> duration"""]
  [summary """Build a duration from a count of days."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-d 1]"""] [expect """86400000000000"""]]
]
[fn-doc name=duration-parts scope=public purity=pure
  [sig """-> element"""]
  [summary """Decompose a duration into days, hours, minutes, seconds, and nanoseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-parts [$time:parse-duration "1d2h30m45s"]]"""] [expect """[duration-parts days=1 hours=2 minutes=30 seconds=45 nanoseconds=0]"""]]
]
[fn-doc name=duration-total-ms scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the duration as a total count of milliseconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-total-ms [$time:duration-s 3]]"""] [expect """3000"""]]
]
[fn-doc name=duration-total-s scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the duration as a total count of seconds."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-total-s [$time:duration-h 2]]"""] [expect """7200"""]]
]
[fn-doc name=duration-total-h scope=public purity=pure
  [sig """-> float"""]
  [summary """Return the duration as a fractional count of hours."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-total-h [$time:duration-h 2]]"""] [expect """2.0"""]]
]
[fn-doc name=duration-add scope=public purity=pure
  [sig """-> duration"""]
  [summary """Add two durations."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-add [$time:duration-s 1] [$time:duration-s 2]]"""] [expect """3000000000"""]]
]
[fn-doc name=duration-sub scope=public purity=pure
  [sig """-> duration"""]
  [summary """Subtract the second duration from the first."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-sub [$time:duration-s 5] [$time:duration-s 2]]"""] [expect """3000000000"""]]
]
[fn-doc name=duration-mul scope=public purity=pure
  [sig """-> duration"""]
  [summary """Multiply a duration by an integer factor."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-mul [$time:duration-s 2] 3]"""] [expect """6000000000"""]]
]
[fn-doc name=duration-div scope=public purity=pure
  [sig """-> duration"""]
  [summary """Divide a duration by an integer divisor; raises on division by zero."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-div [$time:duration-s 6] 3]"""] [expect """2000000000"""]]
]
[fn-doc name=parse-date scope=public purity=pure
  [sig """-> date"""]
  [summary """Parse an ISO 8601 date string into a date value."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:year [$time:parse-date "2026-05-26"]]"""] [expect """2026"""]]
]
[fn-doc name=parse-datetime scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Parse an ISO 8601 datetime string into a datetime value."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:hour [$time:parse-datetime "2026-05-26T14:30:45Z"]]"""] [expect """14"""]]
]
[fn-doc name=parse-instant scope=public purity=pure
  [sig """-> instant"""]
  [summary """Parse an ISO 8601 string into an instant normalized to UTC."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:parse-instant "1970-01-01T00:00:01Z"]"""] [expect """1000000000"""]]
]
[fn-doc name=parse-duration scope=public purity=pure
  [sig """-> duration"""]
  [summary """Parse an ISO 8601 duration or shorthand string into a duration value."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:duration-parts [$time:parse-duration "1d2h30m45s"]]"""] [expect """[duration-parts days=1 hours=2 minutes=30 seconds=45 nanoseconds=0]"""]]
]
[fn-doc name=parse-rfc3339 scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Parse an RFC 3339 timestamp string into a datetime value."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:parse-rfc3339 "2026-05-26T14:30:00Z"]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=parse-rfc2822 scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Parse an RFC 2822 email-style date string into a datetime value."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:parse-rfc2822 "Tue, 26 May 2026 14:30:00 +0000"]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=parse-with-format scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Parse a string into a datetime using an ICU/LDML pattern."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:parse-with-format "2026-05-26 14:30:00" "yyyy-MM-dd HH:mm:ss"]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=parse-strftime scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Parse a string into a datetime using strftime tokens, for ingesting external output."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:parse-strftime "2026-05-26 14:30:00" "%Y-%m-%d %H:%M:%S"]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=format-iso8601 scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a date or datetime as a canonical ISO 8601 string."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-iso8601 [$time:parse-datetime "2026-05-26T14:30:00Z"]]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=format-rfc3339 scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a datetime as an RFC 3339 timestamp string."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-rfc3339 [$time:parse-datetime "2026-05-26T14:30:00Z"]]"""] [expect """'2026-05-26T14:30:00Z'"""]]
]
[fn-doc name=format-rfc2822 scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a datetime as an RFC 2822 email-style date string."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-rfc2822 [$time:parse-datetime "2026-05-26T14:30:00Z"]]"""] [expect """'Tue, 26 May 2026 14:30:00 +0000'"""]]
]
[fn-doc name=format-with-format scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a date or datetime using an ICU/LDML pattern at the root locale."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-with-format [$time:parse-datetime "2026-05-26T14:30:00Z"] "yyyy-MM-dd HH:mm:ss"]"""] [expect """'2026-05-26 14:30:00'"""]]
]
[fn-doc name=format-duration scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a duration as a shorthand string such as 1d2h30m45s."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-duration [$time:parse-duration "1d2h30m45s"]]"""] [expect """'1d2h30m45s'"""]]
]
[fn-doc name=format-relative scope=public purity=pure
  [sig """-> string"""]
  [summary """Format a datetime relative to a reference time, such as 2 hours ago."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-relative [$time:parse-datetime "2026-05-26T12:00:00Z"] [$time:parse-datetime "2026-05-26T14:00:00Z"]]"""] [expect """'2 hours ago'"""]]
]
[fn-doc name=timezone scope=public purity=pure
  [sig """-> element"""]
  [summary """Look up an IANA timezone by name, returning its offset and DST status."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:timezone "America/New_York"]"""] [expect """[timezone name='America/New_York' offset=-18000 dst=true]"""]]
]
[fn-doc name=to-timezone scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Convert a datetime to the wall-clock time in the named timezone."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:to-timezone [$time:parse-datetime "2026-01-15T17:00:00Z"] "America/New_York"]"""] [expect """'2026-01-15T12:00:00-05:00'"""]]
]
[fn-doc name=to-utc scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Convert a datetime to its equivalent in UTC."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:to-utc [$time:parse-datetime "2026-01-15T12:00:00-05:00"]]"""] [expect """'2026-01-15T17:00:00Z'"""]]
]
[fn-doc name=utc-now scope=public purity=impure
  [sig """-> datetime"""]
  [summary """Return the current wall-clock datetime in UTC."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:timezone-offset [$time:utc-now]]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=system-timezone scope=public purity=impure
  [sig """-> string"""]
  [summary """Return the host's configured timezone identifier."""]
  [example [code """[?lib 'cx-stdlib/time']
[>= [$time:timezone-offset [$time:datetime-with-tz 2026 1 15 12 0 0 [$time:system-timezone]]] -86400]"""] [expect """cx-err:CXER0271"""]]
]
[fn-doc name=list-timezones scope=public purity=pure
  [sig """-> [sequence string]"""]
  [summary """List the available IANA timezone identifiers."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:list-timezones]"""] [expect """('UTC', 'Etc/UTC', 'America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'Europe/London', 'Europe/Paris', 'Europe/Berlin', 'Asia/Tokyo', 'Asia/Kolkata', 'Australia/Sydney')"""]]
]
[fn-doc name=is-leap-year scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether the given year is a leap year."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:is-leap-year 2024]"""] [expect """true"""]]
]
[fn-doc name=is-before scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether the first time is chronologically before the second."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:is-before [$time:parse-date "2026-01-01"] [$time:parse-date "2026-12-31"]]"""] [expect """true"""]]
]
[fn-doc name=is-after scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether the first time is chronologically after the second."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:is-after [$time:parse-date "2026-12-31"] [$time:parse-date "2026-01-01"]]"""] [expect """true"""]]
]
[fn-doc name=is-same scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether two times denote the same instant, regardless of offset."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:is-same [$time:parse-datetime "2026-05-26T14:00:00Z"] [$time:parse-datetime "2026-05-26T16:00:00+02:00"]]"""] [expect """true"""]]
]
[fn-doc name=is-same-day scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether two datetimes fall on the same calendar day."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:is-same-day [$time:parse-datetime "2026-05-26T01:00:00Z"] [$time:parse-datetime "2026-05-26T23:00:00Z"]]"""] [expect """true"""]]
]
[fn-doc name=days-in-month scope=public purity=pure
  [sig """-> int"""]
  [summary """Return the number of days in the given month of the given year."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:days-in-month 2024 2]"""] [expect """29"""]]
]
[fn-doc name=recurrence scope=public purity=pure
  [sig """-> element"""]
  [summary """Build and eagerly validate a recurrence rule from a frequency, anchor, timezone, and options."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:recurrence :yearly '2026-01-01T09:00:00' 'UTC' {by-month: 2 by-month-day: 30}]"""] [expect """cx-err:CXER3323"""]]
]
[fn-doc name=validate-rule scope=public purity=pure
  [sig """-> element"""]
  [summary """Run the full validation check on a recurrence rule, raising on a fault."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:validate-rule [recurrence freq=:weekly anchor='2026-06-01T09:00:00' tz='UTC' count=2 until='2026-12-01T00:00:00']]"""] [expect """cx-err:CXER3323"""]]
]
[fn-doc name=is-valid-rule scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a recurrence rule is valid, never raising."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:is-valid-rule [recurrence freq=:monthly anchor='2026-01-01T09:00:00' tz='UTC' [by-day [nth 3 :thursday]]]]"""] [expect """true"""]]
]
[fn-doc name=parse-rrule scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse an RFC 5545 RRULE string into a recurrence rule, given an anchor and timezone."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-rrule [$time:parse-rrule 'FREQ=MONTHLY;BYDAY=3TH' '2026-01-01T09:00:00' 'UTC']]"""] [expect """'FREQ=MONTHLY;BYDAY=3TH'"""]]
]
[fn-doc name=format-rrule scope=public purity=pure
  [sig """-> string"""]
  [summary """Serialize a recurrence rule to its RFC 5545 RRULE string form."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-rrule [$time:parse-rrule 'FREQ=MONTHLY;BYDAY=3TH' '2026-01-01T09:00:00' 'UTC']]"""] [expect """'FREQ=MONTHLY;BYDAY=3TH'"""]]
]
[fn-doc name=parse-cron scope=public purity=pure
  [sig """-> element"""]
  [summary """Parse a 5- or 6-field cron expression or @macro into a recurrence rule."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-cron [$time:parse-cron '30 9 * * 1' 'UTC']]"""] [expect """'30 9 * * 1'"""]]
]
[fn-doc name=format-cron scope=public purity=pure
  [sig """-> element"""]
  [summary """Serialize a recurrence rule to a cron string, raising if cron cannot express it."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:format-cron [$time:parse-cron '30 9 * * 1' 'UTC']]"""] [expect """'30 9 * * 1'"""]]
]
[fn-doc name=next-occurrence scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Return the first occurrence of a rule strictly after the given time."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:next-occurrence [recurrence freq=:daily anchor='2026-06-01T09:00:00' tz='UTC' count=5] '2026-06-02T09:00:00']"""] [expect """'2026-06-03T09:00:00Z'"""]]
]
[fn-doc name=occurrences-in scope=public purity=pure
  [sig """-> [sequence datetime]"""]
  [summary """Return a rule's occurrences within a half-open window, in ascending order."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:occurrences-in [recurrence freq=:daily anchor='2026-06-01T09:00:00' tz='UTC' count=3] '2026-06-01T00:00:00' '2026-06-10T00:00:00']"""] [expect """('2026-06-01T09:00:00Z', '2026-06-02T09:00:00Z', '2026-06-03T09:00:00Z')"""]]
]
[fn-doc name=nth-occurrence scope=public purity=pure
  [sig """-> datetime"""]
  [summary """Return the nth occurrence of a rule, counting 1-based from the anchor."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:nth-occurrence [recurrence freq=:weekly interval=2 anchor='2026-06-01T00:00:00' tz='UTC' [by-day :monday :wednesday :friday]] 4]"""] [expect """'2026-06-15T00:00:00Z'"""]]
]
[fn-doc name=rule-freq scope=public purity=pure
  [sig """-> atom"""]
  [summary """Return the base frequency atom of a recurrence rule."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:rule-freq [$time:parse-rrule 'FREQ=MONTHLY;BYDAY=3TH' '2026-01-01T09:00:00' 'UTC']]"""] [expect """:monthly"""]]
]
[fn-doc name=rule-bound scope=public purity=pure
  [sig """-> element"""]
  [summary """Return a rule's bound — a count, an until datetime, or absence if infinite."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:rule-bound [recurrence freq=:daily anchor='2026-06-01T09:00:00' tz='UTC' count=3]]"""] [expect """[count 3]"""]]
]
[fn-doc name=rule-is-finite scope=public purity=pure
  [sig """-> bool"""]
  [summary """Report whether a recurrence rule produces a finite number of occurrences."""]
  [example [code """[?lib 'cx-stdlib/time']
[$time:rule-is-finite [recurrence freq=:daily anchor='2026-06-01T09:00:00' tz='UTC' count=3]]"""] [expect """true"""]]
]
