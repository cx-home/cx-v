+// #145 CLONE-ROOT RING (multi-reactor sweep-while-live fix). A per-thread,
+// NON-resetting ring of recently-cloned map backing-array pointers (keys+values).
+// Every map.clone() registers the source AND destination key/value arrays of a
+// string-keyed map into the calling thread's ring; vgc_mark_roots shades every
+// ring entry under STW. This roots the live per-request env-clone maps (renv +
+// every [?let] child env + closures + dyn_context — all reached through map.clone)
+// INDEPENDENT of where their stack/register holder happens to live at the freeing
+// GC, which is the multi-reactor root miss (the env's only live pointer is in a
+// transient register the conservative scan does not cover; N=1 never collects
+// mid-clone so it is sound). The ring does NOT reset per request (the prior
+// envroots experiment did, so an env swept while held only as a LATER clone source
+// lost its root) — it is a fixed-size LRU per thread, so it is TCO-safe and bounded:
+// once a request completes its maps die and vgc_shade's alloc-bit check skips the
+// stale slots until they are overwritten. Sized to comfortably exceed one request's
+// live-map working set (renv + nested child envs + closures).
+const vgc_cloneroot_slots = 512
+__global vgc_clone_ring = [32768]usize{} // [cache_idx*vgc_cloneroot_slots + slot] -> array obj ptr (64*512)
+__global vgc_clone_cur  = [64]u32{}      // per-thread ring cursor (writes its own row only)
+
+// vgc_cloneroot_register adds one backing-array object pointer to the calling
+// thread's clone-root ring. Lock-free: only this thread writes its own row, and the
+// collector reads all rows only under STW (mutators frozen), so there is no
+// concurrent reader/writer of the same slot. A torn read is impossible for an
+// aligned usize on the target. p==0 / unregistered-thread / stale addrs are benign
+// (vgc_shade bounds- and alloc-checks every entry).
+@[inline]
+fn vgc_cloneroot_register(p usize) {
+	if p == 0 {
+		return
+	}
+	ci := C.vgc_get_cache_idx()
+	if ci < 0 || ci >= vgc_max_threads {
+		return
+	}
+	unsafe {
+		slot := vgc_clone_cur[ci] % u32(vgc_cloneroot_slots)
+		vgc_clone_ring[u32(ci) * u32(vgc_cloneroot_slots) + slot] = p
+		vgc_clone_cur[ci] = vgc_clone_cur[ci] + 1
+	}
+	$if vgc_cloneroots_diag ? {
+		vgc_clone_reg_count++
+	}
+}
+
+// vgc_cloneroot_mark shades every live entry in every thread's clone-root ring.
+// Called from vgc_mark_roots under STW. vgc_shade marks + (for the SCAN keys/values
+// arrays) enqueues for descent, so each rooted keys-array traces its string structs
+// -> .str char buffers, and each values-array traces its element pointers.
+__global vgc_clone_reg_count = u64(0)  // total registrations (diagnostic)
+__global vgc_clone_mark_gcs  = u64(0)  // GCs where the ring was scanned (diagnostic)
+
+fn vgc_cloneroot_mark() {
+	mut live := 0
+	mut nonzero := 0
+	for i in 0 .. (vgc_max_threads * vgc_cloneroot_slots) {
+		p := unsafe { vgc_clone_ring[i] }
+		if p != 0 {
+			nonzero++
+			if p >= vgc_arena_lo && p < vgc_arena_hi {
+				sp := vgc_find_span(voidptr(p))
+				if sp != unsafe { nil } && sp.in_use && sp.elem_size != 0 {
+					live++
+				}
+			}
+			vgc_shade(p)
+		}
+	}
+	$if vgc_cloneroots_diag ? {
+		vgc_clone_mark_gcs++
+		if vgc_clone_mark_gcs % u64(20) == 0 {
+			C.vgc_say(0x0c70, vgc_clone_reg_count) // total registrations
+			C.vgc_say(0x0c71, u64(nonzero)) // ring entries non-zero
+			C.vgc_say(0x0c72, u64(live)) // ring entries live (in-use span)
+		}
+	}
+}
