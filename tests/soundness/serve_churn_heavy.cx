[?lib 'cx-stdlib/http' :as http]
[?lib 'cx-stdlib/strings' :as s]
[?def handler impure ($req) [?let [= $field_00 [$concat "k00-" "v-" "payload-"]] [?let [= $field_01 [$concat "k01-" "v-" "payload-"]] [?let [= $field_02 [$concat "k02-" "v-" "payload-"]] [?let [= $field_03 [$concat "k03-" "v-" "payload-"]] [?let [= $field_04 [$concat "k04-" "v-" "payload-"]] [?let [= $field_05 [$concat "k05-" "v-" "payload-"]] [?let [= $field_06 [$concat "k06-" "v-" "payload-"]] [?let [= $field_07 [$concat "k07-" "v-" "payload-"]] [?let [= $field_08 [$concat "k08-" "v-" "payload-"]] [?let [= $field_09 [$concat "k09-" "v-" "payload-"]] [?let [= $field_10 [$concat "k10-" "v-" "payload-"]] [?let [= $field_11 [$concat "k11-" "v-" "payload-"]] [?let [= $field_12 [$concat "k12-" "v-" "payload-"]] [?let [= $field_13 [$concat "k13-" "v-" "payload-"]] [?let [= $field_14 [$concat "k14-" "v-" "payload-"]] [?let [= $field_15 [$concat "k15-" "v-" "payload-"]] [?let [= $field_16 [$concat "k16-" "v-" "payload-"]] [?let [= $field_17 [$concat "k17-" "v-" "payload-"]] [?let [= $field_18 [$concat "k18-" "v-" "payload-"]] [?let [= $field_19 [$concat "k19-" "v-" "payload-"]] [?let [= $field_20 [$concat "k20-" "v-" "payload-"]] [?let [= $field_21 [$concat "k21-" "v-" "payload-"]] [?let [= $field_22 [$concat "k22-" "v-" "payload-"]] [?let [= $field_23 [$concat "k23-" "v-" "payload-"]] [?let [= $acc [$concat $field_00 $field_05 $field_10 $field_15 $field_20]] [?let [= $big [$s:repeat $acc 1500]] [response status=200 [headers [header name="content-type" value="text/plain"]] [body $big]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
[$http:serve "tcp://127.0.0.1:9031" handler {block: true}]
