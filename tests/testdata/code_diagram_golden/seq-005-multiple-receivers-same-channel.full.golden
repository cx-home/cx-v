sequenceDiagram
  participant INPUT
  participant ch
  participant wa
  participant wb
  participant OUTPUT
  activate wa
  ch -->> wa : msg
  Note over wa : [ok]
  deactivate wa
  activate wb
  ch -->> wb : msg
  Note over wb : [ok]
  deactivate wb
  Note over INPUT : bind $ch
  Note over INPUT : bind $_a
  Note over INPUT : bind $m