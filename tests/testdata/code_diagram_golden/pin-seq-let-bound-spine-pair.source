[?let [= $ch [?channel name="jobs" buffer=4]]
  [?let [= $prod [?worker name="producer"
                   [body [?let [= $_ [?for [in $i [$range 1 3]]
                                       [yield [?send $i to=$ch]]]]
                           [?close $ch]]]]]
    [?let [= $cons [?worker name="consumer"
                     [body [?for [in $i [$range 1 3]]
                             [yield [?receive from=$ch]]]]]]
      [?let [= $_ [?wait-for worker=$prod]]
        [?wait-for worker=$cons]]]]]