flowchart TD
    n1(["start"])
    n2(["result"])
    n3{"if $p"}
    n4["[?if] result"]
    n5[["[?service] \"svc-a\""]]
    n3 -- "true" --> n5
    n5 --> n4
    n6[["[?worker] \"w2\""]]
    n7["[?receive]"]
    n8[/"channel $ch"/]
    n8 -- "recv" --> n7
    n6 -- ":body" --> n7
    n3 -- "false" --> n6
    n6 --> n4
    n1 --> n4
    n4 --> n2