flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_time_now[["time-now"]]
  cap_clock{{"clock --allow-clock"}}
  prog --> eff_time_now
  eff_time_now --> cap_clock
  class prog entry;
  class eff_time_now effect;
  class cap_clock cap;