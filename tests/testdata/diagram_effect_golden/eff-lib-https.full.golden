flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_lib_https[["[?lib] over https"]]
  unk_1[/"[?lib] — module body not in the image: https://example.com/m.cx"/]
  cap_net{{"net --allow-net"}}
  any{{"any granted capability"}}
  prog --> eff_lib_https
  eff_lib_https --> cap_net
  prog ==> unk_1
  unk_1 ==> any
  class prog entry;
  class eff_lib_https effect;
  class cap_net cap;
  class unk_1 unknown;