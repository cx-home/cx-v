flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_random_crypto_bytes[["random-crypto-bytes"]]
  cap_random{{"random --allow-random"}}
  prog --> eff_random_crypto_bytes
  eff_random_crypto_bytes --> cap_random
  class prog entry;
  class eff_random_crypto_bytes effect;
  class cap_random cap;