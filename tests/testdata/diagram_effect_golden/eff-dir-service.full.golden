flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_http_service[["[?http-service]"]]
  cap_net{{"net --allow-net"}}
  prog --> eff_http_service
  eff_http_service --> cap_net
  class prog entry;
  class eff_http_service effect;
  class cap_net cap;