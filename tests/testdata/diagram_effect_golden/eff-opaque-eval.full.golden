flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_eval[["[?eval]"]]
  unk_1[/"[?eval] — executes a tree the image does not hold"/]
  cap_eval{{"eval --allow-eval"}}
  any{{"any granted capability"}}
  prog --> eff_eval
  eff_eval --> cap_eval
  prog ==> unk_1
  unk_1 ==> any
  class prog entry;
  class eff_eval effect;
  class cap_eval cap;
  class unk_1 unknown;