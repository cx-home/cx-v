flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_reveal[["[?reveal]"]]
  cap_secret_reveal{{"secret-reveal --allow-secret-reveal"}}
  prog --> eff_reveal
  eff_reveal --> cap_secret_reveal
  class prog entry;
  class eff_reveal effect;
  class cap_secret_reveal cap;