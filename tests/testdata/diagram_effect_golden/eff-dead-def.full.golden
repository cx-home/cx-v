flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  def_unused["def unused"]
  eff_process_run[["process-run"]]
  cap_subprocess{{"subprocess --allow-subprocess"}}
  def_unused --> eff_process_run
  eff_process_run --> cap_subprocess
  class prog entry;
  class eff_process_run effect;
  class cap_subprocess cap;