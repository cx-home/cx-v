flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  eff_env_var[["env-var"]]
  eff_io_read_file[["io-read-file"]]
  eff_io_write_file[["io-write-file"]]
  cap_read{{"read --allow-read"}}
  cap_write{{"write --allow-write"}}
  cap_env{{"env --allow-env"}}
  prog --> eff_env_var
  prog -.-> eff_io_read_file
  prog -.-> eff_io_write_file
  eff_env_var --> cap_env
  eff_io_read_file --> cap_read
  eff_io_write_file --> cap_write
  class prog entry;
  class eff_env_var effect;
  class eff_io_read_file effect;
  class eff_io_write_file effect;
  class cap_read cap;
  class cap_write cap;
  class cap_env cap;