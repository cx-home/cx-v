flowchart TD
  classDef entry fill:#e8f5e9,stroke:#1b5e20;
  classDef effect fill:#e8eaf6,stroke:#1a237e;
  classDef cap fill:#ffebee,stroke:#b71c1c;
  classDef unknown fill:#fff8e1,stroke:#ff6f00;
  prog(["program"])
  def_fetch["def fetch"]
  eff_http_get[["http-get"]]
  eff_env_var[["env-var"]]
  cap_net{{"net --allow-net"}}
  cap_env{{"env --allow-env"}}
  def_fetch --> eff_http_get
  prog --> eff_env_var
  prog -.->|"call"| def_fetch
  eff_http_get --> cap_net
  eff_env_var --> cap_env
  class prog entry;
  class eff_http_get effect;
  class eff_env_var effect;
  class cap_net cap;
  class cap_env cap;