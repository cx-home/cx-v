# cx-x/ux — the SEMANTIC CORE of the UX projection (#787 W1–W5).
#
# ⚠ x/-TIER MODULE (spec/03-approved/std-lib/README.md D3): bundled + gated
# in-tree but EXEMPT from the frozen-`std` byte-compatible-reimpl stability
# promise. This is the THIRD PROJECTION's kernel at PoC coverage; #787's DP1
# is an explicit go/kill, so the surface may not claim frozen stability until
# it passes.
#
# Normative source: spec/03-approved/xap/ux.md (graduated 2026-08-20, UX-1;
# owner-RULED 2026-08-17 as design/787/787-phase0-spec.md),
# 52 [P0-n] clauses. Every clause this file implements is cited inline. The
# spec is the only truth; where a comment and the spec disagree, the spec wins.
#
# ── THIS MODULE CONTAINS NO RENDERER ─────────────────────────────────────────
#
# P0-20 (R5) says the semantic element set "assumes no hover, pointer, or
# CSS-shaped layout" and that "the web emitter's lowering to HTML/htmx is
# renderer-private". W1–W4 stated that as a comment while the vocabulary
# quietly acquired `target=`, `swap=`, `oob=`, `ext=`, `subscribe=` and `on=`
# — htmx concepts, one of them (`oob=`) carrying a literal CSS selector. A
# renderer-agnostic vocabulary with htmx attributes in it is not renderer-
# agnostic; the claim was false, and a comment cannot make it true.
#
# So the file is split. This module holds the vocabulary, the addressing, the
# validation, the projections and the patch algebra — and imports no markup
# library of any kind. `cx-x/ux-web` lowers to HTML/htmx; `cx-x/ux-tui` lowers
# to a terminal. Neither is privileged; the semantic tree does not know which
# one it will meet. A renderer-private concept can no longer climb into the
# vocabulary without crossing a module boundary, which is the only enforcement
# that actually holds.
#
# WHERE THE RENDERER-PRIVATE INTENT WENT (§3): a region declares `live=<feed>`
# — a LOGICAL feed name; an action or a form declares `affects=<element path>`
# — the semantic thing it updates. Endpoints, event names and swap modes live
# in the RENDER CONTEXT (`[ux:render-ctx …]`), a document each renderer reads
# for itself. The web renderer turns a feed binding into `sse-connect`; the
# terminal renderer opens the same stream and repaints. Neither concept is
# spelled in htmx, and neither is spelled in ANSI.

[?lib 'cx-stdlib/strings' :as strings]
[?lib 'cx-stdlib/json' :as json]
[?lib 'cx-stdlib/hash' :as hash]
[?lib 'cx-stdlib/bytes' :as bytes]

# ── §1 Fragment addressing (P0-8 … P0-11) ───────────────────────────────────
#
# Identity inputs are EXACTLY (route, feature instance, element path) — theme,
# template, locale, actor, session and data values are inputs to a fragment's
# CONTENT, never to its IDENTITY (P0-8). That exclusion is what makes
# render-once-broadcast possible at all and what lets a rebrand keep every
# anchor, memo and studio selection alive.
#
# Addressing is CORE, not renderer-private: it is identity, and both renderers
# address the same fragments. The web renderer derives a DOM id from an
# address; the terminal renderer keys its focus ring and its patch targets by
# the same addresses. One identity, two derived renderings.

# frag — the canonical fragment address (P0-9). Its STRICT CANONICAL BYTES are
# the identity; everything below is a stated function of those bytes.
[?def frag scope=public pure [returns element] ($route::string $feature::string $path::string)
  [frag [route $route] [feature $feature] [path $path]]]

# frag-address — the Tier-1 content address of a fragment address, tagged
# `sha2-256:<hex>` exactly like every other address in the suite.
[?def frag-address scope=public pure [returns string] ($f::element)
  [$cx:hash $f]]

# frag-id — the DOM id: `cx-` + the first 16 lowercase hex chars of the
# sha2-256 of the address's strict canonical bytes (P0-11, Q-B). A DERIVED
# RENDERING, never a second identity. `[$cx:hash]` returns the tagged form, so
# the hex starts at position 10 (after `sha2-256:`).
#
# It lives in the core rather than in the web renderer because it is not a web
# concept: it is the short, selector-safe SPELLING of an address, and the
# terminal renderer uses the same spelling to name a patch target. What the
# web renderer owns is the `#`-prefixing and the attribute it lands in.
[?def frag-id scope=public pure [returns string] ($f::element)
  [$concat "cx-" [$substring [$cx:hash $f] 10 16]]]

# frag-repr — the full readable canonical form, carried in `data-cx-frag` so
# rendered-fragment goldens stay human-diffable and a client can recover the
# address without a second registry (P0-11).
[?def frag-repr scope=public pure [returns string] ($f::element)
  [$cx:canonical $f]]

# frag-id-of — the DOM id derived from an ALREADY-COMPUTED canonical form.
#
# Every addressed element needs both the id and the readable form, and
# `frag-id` + `frag-repr` canonicalize the same value twice. Measurement said
# that mattered: lowering a ten-row nested table cost ~86 ms for 54 addressed
# elements, and canonicalization was the bulk of it.
#
# Byte-identical by construction, not by approximation: `[$cx:hash]` IS
# `"sha2-256:"` followed by the sha2-256 of exactly these bytes, so hashing
# the repr yields the digest the address's own hash yields. The W1 goldens pin
# it — were this ever to diverge, every rendered-fragment fixture would go red
# at once, which is the right blast radius for an identity derivation.
[?def frag-id-of scope=public pure [returns string] ($repr::string)
  [$concat "cx-" [$substring [$bytes:to-hex [$hash:sha256-string $repr]] 1 16]]]

# path-step — append one element-path step. Paths are CXPath-shaped
# (slash-separated steps), rooted at the feature instance's projection.
[?def path-step scope=public pure [returns string] ($base::string $step::string)
  [?if [= $base "/"]
    [then [$concat "/" $step]]
    [else [$concat $base "/" $step]]]]

# row-step — a collection row's path step (P0-10). A row keys by the projected
# query's DECLARED row key; a collection with no declared key gets NO per-row
# address (absence, not a positional fallback — an insertion must never
# re-address every following row). Absence-in / absence-out.
[?def row-step scope=public pure [returns any] ($base::string $key::any)
  [?if [$exists $key]
    [then [$concat $base "/row[" [$string $key] "]"]]
    [else ()]]]

# ── §2 The semantic vocabulary (P0-20, R5) ──────────────────────────────────
#
# Surface-neutral by construction: no member assumes hover, pointer, or
# CSS-shaped layout — and, since W5, no member carries a renderer's transport
# either (§3). W1 enumerates the set as fixtures; the spec rules the
# discipline, not the final list (P0-20), so members are added by ruling,
# never by convenience.
[?def vocabulary scope=public pure [returns any] ()
  ("ux:region", "ux:card", "ux:heading", "ux:text", "ux:field", "ux:badge",
   "ux:list", "ux:item", "ux:table", "ux:columns", "ux:column", "ux:rows",
   "ux:row", "ux:cell", "ux:nav", "ux:nav-item", "ux:link", "ux:action",
   "ux:form", "ux:input", "ux:hidden", "ux:submit", "ux:error", "ux:notice", "ux:filter",
   "ux:select", "ux:option", "ux:group",
   "ux:media", "ux:grid", "ux:param", "ux:steps", "ux:step", "ux:quantity",
   "ux:breadcrumb", "ux:crumb", "ux:pager", "ux:page-link",
   "ux:facet", "ux:facet-value", "ux:sort", "ux:sort-option",
   "ux:aside", "ux:status",
   "ux:panel")]

[; `ux:filter` is a W5 ADDITION BY RULING (owner, 2026-08-17), not by
   convenience — P0-20 admits members only that way. It exists because a
   filter is not an intent: it has no effect, commits nothing, and journals
   nothing, so it cannot ride `[ux:form]` (which posts to `/intent/<verb>`)
   without lying about what invoking it does. It is a QUERY control: "narrow
   the collection at `affects=` by this text".

   Drill-down, by contrast, needed NO new member: the key column projects an
   ordinary `[ux:link]` to the detail route. That asymmetry is the useful
   test of whether a concept belongs in the vocabulary — drill-down is
   navigation, which the vocabulary already had; filtering is a query, which
   it did not.

   `ux:select` / `ux:option` and `ux:group` are the W6 additions, both by
   ruling (owner, 2026-08-17), and both were forced by trying to ENTER a real
   order rather than by wanting more vocabulary:

   `ux:select` is what P0-17 already RULED and nobody had built — "reference-
   typed fields project typeahead wired against the referenced query". A field
   whose declared type names another noun is a CHOICE FROM A KNOWN SET, and
   until now the projection rendered it as a free-text box. You cannot pick a
   product out of a text box.

   `ux:group repeat=` is the nested WRITE case, and it had no ruled design at
   all. Every nested-case clause in the spec — `view=cards`, nested tables, the
   W3 gauntlet — is READ-side. An order with two line items could be displayed
   from the first wave and never entered, which is a gap a read-side gauntlet
   is structurally unable to find.
   THE SIXTEEN W10 ADDITIONS are spec §10 (P0-54..P0-64), each admitted under
   P0-53's two-part test: it carries semantics no existing member carries, AND
   both renderers can honour it natively rather than by simulating the other.
   They exist because W6/W7 built an order-entry DESK and the owner's verdict
   was that it is not a store — and the residue of that failure was a precise
   list of things this vocabulary could not say:

     ux:media      a picture of the thing. There was NO IMAGE MEMBER AT ALL.
     ux:grid       things compared as WHOLES, not rows compared field by field.
     ux:param      the one that mattered most: NO INTENT WAS EMITTABLE FROM A
                   COLLECTION ITEM, so every act had to come from a form placed
                   beside the collection — which is exactly what a desk is.
     ux:steps/step you are at step 3 of 4 and step 1 is still editable.
     ux:quantity    a bounded quantity, changed by acts rather than by typing.
     ux:breadcrumb where you are.
     ux:pager      a WINDOW over an ordered collection, honestly counted.
     ux:facet      what narrowing is available, AND HOW MUCH EACH LEAVES. The
                   counts are the whole difference from ux:filter: a filter
                   tells you nothing until you use it.
     ux:sort       W7 deferred it web-first; it lands in both faces at once.
     ux:aside      a secondary region whose OPEN STATE IS A URL and whose
                   dismissal is a NAVIGATION. Admitted over its own objection —
                   see DP2 letter (c), which states the case against it.
     ux:status     something just changed, and here is what. Before this there
                   was no announcement surface at all, so a screen-reader user
                   got silence on every swap. ]

[?def in-vocabulary scope=public pure [returns bool] ($n::string)
  [$exists [?for [in $x [$vocabulary]] [where [= $x $n]] [yield $x]]]]

# ── §2.5 Value formatting — shared, because a format is not a renderer choice ─
#
# P0-65: money never becomes a float, and money is never a bare pre-formatted
# string in the semantic tree. The tree carries the DECIMAL CARRIER plus the
# currency; the renderers format. And they format IDENTICALLY, through these
# defs, because how much money something costs is a locale decision and not a
# renderer decision — a terminal and a browser disagreeing about where the
# thousands separator goes would be a defect, not neutrality.
#
# Contrast `kind=`, which each renderer maps to its OWN control on purpose.
# The test is whether the difference is about the medium. A widget is; a
# thousands separator is not.

[?def currency-symbol scope=public pure [returns string] ($c::string)
  [?match $c
    [case "USD" "$"] [case "EUR" "\u20ac"] [case "GBP" "\u00a3"] [case "JPY" "\u00a5"]
    [else [$concat $c " "]]]]

# group-digits — thousands separators, right to left. Written as an explicit
# fold rather than with arithmetic on the index, because `[/ a b]` is not
# integer division in CX and the obvious spelling produces a float index.
[?def group-digits scope=public pure [returns string] ($d::string)
  [?let
    [= $n [$strings:length $d]]
    [?if [<= $n 3]
      [then $d]
      [else [$concat [$group-digits [$strings:slice $d 0 [- $n 3]]] ","
                     [$strings:slice $d [- $n 3] $n]]]]]]

# money-text — the decimal carrier and its currency, rendered. Never routed
# through a double: W6 computed an order total with `[$sum]` over decimals and
# it printed `4.6e1`, which looks like a formatting bug and is a CARRIER bug.
[?def money-text scope=public pure [returns string] ($v::string $cur::string)
  [?let
    [= $neg   [$strings:starts-with $v "-"]]
    [= $abs   [?if $neg [then [$strings:slice $v 1 [$strings:length $v]]] [else $v]]]
    [= $parts [$strings:split $abs "."]]
    [= $int   [?if [= [$count $parts] 0] [then "0"] [else [$nth $parts 1]]]]
    [= $frac  [?if [> [$count $parts] 1] [then [$nth $parts 2]] [else "00"]]]
    [$concat [?if $neg [then "-"] [else ""]] [$currency-symbol $cur]
             [$group-digits $int] "." [$strings:pad-end $frac 2 "0"]]]]

# rating-fifths — a 0..5 rating as a whole number of filled marks, for the
# renderer that draws marks. The NUMBER always rides beside them (P0-66): a
# run of star glyphs on its own is a picture of a number, and a picture of a
# number is not a value.
[?def rating-fifths scope=public pure [returns int] ($v::string)
  [?let [= $parts [$strings:split $v "."]]
    [= $whole [?if [= [$count $parts] 0] [then 0] [else [$cast [$nth $parts 1] :int]]]]
    [= $tenth [?if [> [$count $parts] 1] [then [$cast [$strings:slice [$nth $parts 2] 0 1] :int]] [else 0]]]
    [?if [>= $tenth 5] [then [$min-int [+ $whole 1] 5]] [else [$min-int $whole 5]]]]]

[?def min-int pure [returns int] ($a::int $b::int) [?if [< $a $b] [then $a] [else $b]]]

# formatted — the ONE place a `format=` hint turns a carrier into display text.
# Both renderers call it, so the fixture that asserts semantic == web ==
# terminal is asserting they agree on it.
[; rating-text — THE MARKS AND THE NUMBER, always together (P0-66). A run of
   star glyphs on its own is a picture of a number, and a picture of a number is
   not a value: it cannot be read aloud, compared, or sorted by eye. Glyphs are
   a medium both faces have, so this one is shared rather than lowered twice —
   the terminal shows exactly what the browser shows. ]
[?def rating-text scope=public pure [returns string] ($v::string)
  [?let [= $n [$rating-fifths $v]]
    [$concat [$strings:repeat "★" $n] [$strings:repeat "☆" [- 5 $n]] "  " $v]]]

[?def formatted scope=public pure [returns string] ($el::any $raw::string)
  [?match [$str-or $el@format ""]
    [case "money"  [$money-text $raw [$str-or $el@currency "USD"]]]
    [case "rating" [$rating-text $raw]]
    [else $raw]]]

# The closed tone set for [ux:badge]. Tones are SEMANTIC, never colors — the
# renderer decides what a tone looks like (a CSS token on the web, an SGR
# sequence in a terminal). P0-33's "every visual decision lives in the token
# system" generalizes: every visual decision lives in the RENDERER's token
# system, and the vocabulary names only the meaning.
[?def tones scope=public pure [returns any] () ("ok", "warn", "danger", "info", "neutral")]

[?def valid-tone scope=public pure [returns bool] ($t::string)
  [$exists [?for [in $x [$tones]] [where [= $x $t]] [yield $x]]]]

# ── §3 The render context — where renderer-private intent lives now ─────────
#
# THE W5 CORRECTION. Six attributes used to ride semantic elements:
#
#   ux:region   oob=  ext=  subscribe=  on=
#   ux:row      oob=
#   ux:action   target=  swap=  include=
#   ux:form     target=  swap=
#
# Every one of them is an htmx concept under a shorter name (`ext` → `hx-ext`,
# `subscribe` → `sse-connect`, `on` → `sse-swap`, `oob` → `hx-swap-oob`, and
# `oob`'s value is a literal CSS selector). A terminal renderer handed such a
# tree would have to parse htmx swap syntax to know what the author meant —
# which is the definition of not being renderer-agnostic.
#
# They are replaced by two SEMANTIC declarations plus one document:
#
#   live=<feed name>       on a region: "this region's content is live, from
#                          the feed called <name>". A name, not an endpoint.
#   affects=<element path> on an action or form: "invoking this updates the
#                          element at <path>". A semantic address, not a
#                          selector — and derived, so it cannot drift from
#                          what the renderer actually minted.
#
#   [ux:render-ctx
#     [feed name=orders endpoint="/stream" event="orders-changed"]
#     [swap default=outerHTML]
#     [swap affects="/open-orders/new-order" mode=innerHTML]]
#
# The render context is a DOCUMENT, resolved like every other document in the
# cascade (P0-12/P0-14), and it is SHARED, not web-private: both renderers
# read the same feed bindings, because both are HTTP clients of the same
# surface. What differs is what each does with one — `sse-connect` in a
# browser, `http:sse-connect` + a repaint in a terminal. `[swap …]` is the one
# genuinely web-shaped entry, and the terminal renderer ignores it, which is
# exactly the right shape for a renderer-specific hint: unread, not refused.

# feed-binding — the `[feed name=…]` entry for one logical feed, or absence.
[?def feed-binding scope=public pure [returns any] ($rctx::any $name::string)
  [?for [in $f $rctx/feed] [where [= [$string $f@name] $name]] [yield $f]]]

# swap-mode — the swap mode declared for one `affects=` path, else the render
# context's default, else `outerHTML`. A renderer that has no notion of swap
# modes never calls this.
[?def swap-mode scope=public pure [returns string] ($rctx::any $affects::string)
  [?let
    [= $specific [?for [in $s $rctx/swap]
                   [where [and [$exists $s@affects] [= [$string $s@affects] $affects]]]
                   [yield [$string $s@mode]]]]
    [= $default  [?for [in $s $rctx/swap]
                   [where [$exists $s@default]]
                   [yield [$string $s@default]]]]
    [?if [$exists $specific]
      [then [$first $specific]]
      [else [?if [$exists $default] [then [$first $default]] [else "outerHTML"]]]]]]

# binding-refusals — a `live=` naming a feed the render context does not bind
# is a REFUSAL, on every renderer. A live region that silently is not live is
# the precise failure class §5.4 exists to make impossible: it passes every
# server-side gate, renders correctly once, and then never updates again.
#
# Checked here rather than in either renderer, because it is a property of the
# semantic tree and its context — not of HTML and not of a terminal.
[?def binding-refusals scope=public pure [returns any] ($el::any $rctx::any)
  [?let [= $c [$binding-tree $el $rctx]] $c//ux-refusal]]

[?def binding-tree pure [returns any] ($el::any $rctx::any)
  [?if [$seq-child $el]
    [then [ux-refusals [?for [in $m $el] [yield [$binding-tree $m $rctx]]]]]
    [else
      [ux-refusals
        [?if [and [$exists $el@live] [not [$exists [$feed-binding $rctx [$string $el@live]]]]]
          [then ([ux-refusal code=ux-unbound-feed feed=[$string $el@live]])]
          [else ()]]
        [?for [in $k $el/*] [yield [$binding-tree $k $rctx]]]]]]]

# ── §4 Semantic-tree validation (pre-lowering, fail-loud) ───────────────────
#
# Every refusal is collected BEFORE any lowering, so the lowering itself is
# total and an `[err]` can never end up spliced into a rendered page as if it
# were content.

# Refusals collect into a CARRIER element and are read back flat with the
# descendant axis (`//ux-refusal`). A recursive check naturally produces a
# sequence per level; the carrier lets the tree do the flattening instead of a
# hand-rolled fold, and it is the same shape the fixtures assert against.

# A `[?for … [yield …]]` in an element body lands as ONE sequence-valued child,
# not as spliced siblings — the suite-wide convention (`cx-x/tools` reads its
# own such children back with `//`). A projection therefore hands a renderer
# trees whose children are sometimes sequences, and every walk has to see
# through them: `[$name]` refuses a multi-item sequence, so an unflattened
# sequence child would otherwise vanish from a lowering and take a whole
# projected field list with it.
[; MEASURED, and it dominated everything. The obvious spelling —
   `[?match [$name $el] [case [err @code=$c] true] [else false]]` — costs
   ~55 µs PER CALL, and pattern-matching an `[err …]` case is what costs it,
   not `[$name]`: matching the raw value against an err pattern costs the same
   ~53 µs whether or not the subject is an error. `[$count]` costs 1.2 µs.
   Since this predicate runs once per node in every walk in all three modules
   — validation, lowering (twice over), addressing, focus, painting, both
   content readbacks — it WAS the render cost. A synthetic walk without it
   runs at ~3 µs/node; the same walk with it runs at ~133 µs/node.

   `[?else]` over the same `[$name]` gives byte-identical answers on all four
   cases (element → false, empty and multi-item sequences → true, a
   single-item sequence → false, which is what atomization already does with
   it) at 1.2-4.0 µs. `[$count]` is cheaper still and WRONG: it counts an
   element's CHILDREN, so `[c [a] [b]]` and `([a], [b])` both report 2 and the
   predicate cannot discriminate at all. ]
[?def seq-child scope=public pure [returns bool] ($el::any)
  [= [?else [$name $el] ""] ""]]

# renderer-private-attrs — THE list a semantic element may not carry. Not a
# style rule: each name here is a renderer's private concept, and a tree
# carrying one is a tree that only one renderer can honor.
#
#   oob target swap ext subscribe on   the htmx six W1–W4 leaked (§3)
#   include                            hx-include; a semantic "submit these
#                                      fields too" concept is not yet ruled,
#                                      and the pinned subset keeps hx-include
#                                      available for when one is
#
# The check is a fixed list rather than a wildcard because CXPath has no
# attribute wildcard — and because an explicit list is what a fixture can pin.
[?def renderer-private-attrs scope=public pure [returns any] ()
  ("oob", "target", "swap", "ext", "subscribe", "on", "include")]

[?def private-attr-refusals pure [returns any] ($el::any $n::string)
  [ux-refusals
    [?if [$exists $el@oob]       [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=oob])]       [else ()]]
    [?if [$exists $el@target]    [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=target])]    [else ()]]
    [?if [$exists $el@swap]      [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=swap])]      [else ()]]
    [?if [$exists $el@ext]       [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=ext])]       [else ()]]
    [?if [$exists $el@subscribe] [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=subscribe])] [else ()]]
    [?if [$exists $el@on]        [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=on])]        [else ()]]
    [?if [$exists $el@include]   [then ([ux-refusal code=ux-renderer-private-attr element=$n attr=include])]   [else ()]]]]

# ── P0-98: the vocabulary is closed over ATTRIBUTES, not only over members ──
# (RULED — owner, 2026-08-18, audit letter 3a.)
#
# The 2026-08-18 audit demonstrated the hole this closes: `[ux:action
# disabled=true reason="…"]` passed this gate and both renderers ignored it —
# an author who invents an attribute got no error and no rendering, the same
# silent-acceptance family as the campaign's three language traps. Member
# closure without attribute closure is half a rule.
#
# allowed-attrs — THE per-member grant table. An attribute is here because a
# clause grants it or because the shared layer demonstrably honors it (the
# projections emit it, or both faces read it). The full inventory behind every
# row — spec clause, both renderers' reads, the store's emissions, fixture
# usage — is recorded in design/787/w14/README.md. What is deliberately NOT
# here, because nothing honors it and P0-98 exists to refuse exactly that:
#
#   ux:action  disabled=   the audit's demonstration bug; available= is the
#                          ruled spelling (P0-99, lands with its faces)
#   ux:option  selected=   vestigial one-renderer read; selection derives
#                          from the parent select's value=
#   ux:filter  over=       dead W1-era attribute, no reader anywhere
#   ux:aside   name=       written in two places, read in none
#   ux:pager   per-page=   a spec example wrote it (fixed at DP4 letter b);
#                          no reader anywhere
#   ux:row     id=         a row addresses by key= (has-address); an id on it
#                          was silently discarded — the exact failure class
#   ux:group   id=         a group addresses by name=; same silence
#   ux:panel   id=         a panel addresses by name= (P0-101); same silence
#
# id= otherwise rides every member `has-address` honors — every member except
# the four `no-placed-id` refuses with their own code (region/link/action/
# form) and the two above whose address derives from another attribute.
#
# format= / currency= ride the leaf-bodied members whose body text flows
# through the one shared `[$formatted]` path (P0-65/P0-66): heading, text,
# field, badge, item, column, cell, status.
[; MEASURED, and ?match was the whole cost — the §4 lesson, again. This
   table as a 44-arm [?match] cost ~964 µs PER CALL (int bodies or sequence
   bodies, same); the same table as a flat [?if]/[=] chain costs ~2 µs. Since
   the gate consults it once per node, the match spelling took the semantic
   gate from 144 ms to 1,195 ms over the 24-card page and this spelling gives
   it back. Generated mechanically (one member per line, balance-checked) so
   the bracket tail cannot silently swallow a def (T5).

   prominence= on ux:action carries P0-103 (RULED at DP4 letter a): a
   semantic emphasis level, normal | primary, default normal — tokens decide
   appearance, and a face may not drop it. ]
[?def allowed-attrs scope=public pure [returns any] ($n::string)
  [?if [= $n "ux:region"] [then ("feature", "path", "live")]
  [else [?if [= $n "ux:card"] [then ("id")]
  [else [?if [= $n "ux:heading"] [then ("level", "id", "format", "currency")]
  [else [?if [= $n "ux:text"] [then ("id", "format", "currency")]
  [else [?if [= $n "ux:field"] [then ("label", "format", "currency", "id")]
  [else [?if [= $n "ux:badge"] [then ("tone", "id", "format", "currency")]
  [else [?if [= $n "ux:list"] [then ("id")]
  [else [?if [= $n "ux:item"] [then ("id", "format", "currency")]
  [else [?if [= $n "ux:table"] [then ("id")]
  [else [?if [= $n "ux:columns"] [then ("id")]
  [else [?if [= $n "ux:column"] [then ("id", "format", "currency")]
  [else [?if [= $n "ux:rows"] [then ("id", "live")]
  [else [?if [= $n "ux:row"] [then ("key")]
  [else [?if [= $n "ux:cell"] [then ("id", "format", "currency")]
  [else [?if [= $n "ux:nav"] [then ("id")]
  [else [?if [= $n "ux:nav-item"] [then ("href", "label", "id", "live")]
  [else [?if [= $n "ux:link"] [then ("href", "label")]
  [else [?if [= $n "ux:action"] [then ("verb", "label", "affects", "confirm", "confirm-href", "prominence", "available", "reason")]
  [else [?if [= $n "ux:form"] [then ("verb", "affects")]
  [else [?if [= $n "ux:input"] [then ("name", "label", "kind", "required", "value", "error", "help", "id")]
  [else [?if [= $n "ux:hidden"] [then ("name", "value", "id")]
  [else [?if [= $n "ux:submit"] [then ("label", "id")]
  [else [?if [= $n "ux:error"] [then ("id")]
  [else [?if [= $n "ux:notice"] [then ("tone", "id")]
  [else [?if [= $n "ux:filter"] [then ("name", "label", "affects", "route", "value", "id")]
  [else [?if [= $n "ux:select"] [then ("name", "label", "required", "value", "error", "help", "id")]
  [else [?if [= $n "ux:option"] [then ("value", "label", "id")]
  [else [?if [= $n "ux:group"] [then ("name", "label", "repeat", "affects", "add-label", "help")]
  [else [?if [= $n "ux:media"] [then ("src", "alt", "kind", "tone", "id")]
  [else [?if [= $n "ux:grid"] [then ("density", "id")]
  [else [?if [= $n "ux:param"] [then ("name", "value", "id")]
  [else [?if [= $n "ux:steps"] [then ("name", "current", "id")]
  [else [?if [= $n "ux:step"] [then ("name", "label", "state", "href", "id")]
  [else [?if [= $n "ux:quantity"] [then ("name", "label", "verb", "value", "min", "max", "step", "affects", "id")]
  [else [?if [= $n "ux:breadcrumb"] [then ("id")]
  [else [?if [= $n "ux:crumb"] [then ("label", "href", "current", "id")]
  [else [?if [= $n "ux:pager"] [then ("ordered", "page", "pages", "total", "prev-href", "next-href", "id")]
  [else [?if [= $n "ux:page-link"] [then ("n", "href", "current", "id")]
  [else [?if [= $n "ux:facet"] [then ("name", "label", "id")]
  [else [?if [= $n "ux:facet-value"] [then ("value", "label", "count", "href", "selected", "id")]
  [else [?if [= $n "ux:sort"] [then ("name", "label", "id")]
  [else [?if [= $n "ux:sort-option"] [then ("value", "href", "selected", "label", "id")]
  [else [?if [= $n "ux:aside"] [then ("label", "open", "dismiss-href", "id", "live")]
  [else [?if [= $n "ux:status"] [then ("tone", "id", "format", "currency")]
  [else [?if [= $n "ux:panel"] [then ("name", "label")]
  [else ()]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]

[?def attr-allowed-in pure [returns bool] ($allowed::any $a::string)
  [$exists [?for [in $x $allowed] [where [= $x $a]] [yield $x]]]]

[?def renderer-private-attr pure [returns bool] ($a::string)
  [$exists [?for [in $x [$renderer-private-attrs]] [where [= $x $a]] [yield $x]]]]

# own-attr-names — the element's OWN attribute names, enumerated. The binding
# path surface cannot spell an attribute wildcard (`$el@*` refuses to parse),
# but the ROOTED surface can: wrap the element in a carrier document and read
# `/carrier/*/@*` — a fixed-depth path, so a child's attributes never leak
# into the answer. MEASURED before adoption (the §4 lesson): ~8 µs/node on
# the real 24-card projection — the enumeration was never the cost; the
# table dispatch above was.
#
# The carrier name is hyphenated and def-free on purpose: a bare element
# literal whose head matches a [?def] name parses as a CALL (#858).
[?def own-attr-names scope=public pure [returns any] ($el::any)
  [?let [= $doc [ux-attr-scan $el]]
    [?for [in $a /ux-attr-scan/*/@*] [yield [$name $a]]]]]

# attr-closure-refusals — every attribute this member carries that no clause
# grants. The seven renderer-private names are excluded here because they
# already refuse above with their own, more precise code — one mistake, one
# refusal, the name that tells the author what kind of mistake it was.
# The grant list is fetched ONCE per element, not once per attribute.
[?def attr-closure-refusals pure [returns any] ($el::any $n::string)
  [?let [= $allowed [$allowed-attrs $n]]
    [?for [in $a [$own-attr-names $el]]
      [where [and [not [$attr-allowed-in $allowed $a]]
                  [not [$renderer-private-attr $a]]]]
      [yield [ux-refusal code=ux-unknown-attr element=$n attr=$a]]]]]

# refusal-tree — the recursive check, one carrier per subtree.
[?def refusal-tree pure [returns any] ($el::any)
  [?if [$seq-child $el]
    [then [ux-refusals [?for [in $m $el] [yield [$refusal-tree $m]]]]]
    [else [$refusal-tree-el $el]]]]

[?def refusal-tree-el pure [returns any] ($el::any)
  [?let
    [= $n [$name $el]]
    [= $self
       [?if [not [$in-vocabulary $n]]
         [then ([ux-refusal code=ux-unknown-element element=$n])]
         [else
           [?if [and [$exists $el/*] [$exists $el/text()]]
             [then ([ux-refusal code=ux-mixed-content element=$n])]
             [else [$member-refusals $el $n]]]]]]
    [ux-refusals $self
      [?let [= $p [$private-attr-refusals $el $n]] $p//ux-refusal]
      [; P0-98 — attribute closure, guarded on membership: an unknown MEMBER
         already refused above, and refusing its attributes too would bury
         the one refusal that names the actual mistake. ]
      [?if [$in-vocabulary $n] [then [$attr-closure-refusals $el $n]] [else ()]]
      [?for [in $k $el/*] [yield [$refusal-tree $k]]]]]]

# refusals-of — every refusal in one semantic subtree, flat; empty means
# projectable BY ANY RENDERER. This is the shared gate: both renderers run it
# before lowering, so a tree that one accepts and the other rejects cannot
# exist.
[?def refusals-of scope=public pure [returns any] ($el::any)
  [?let [= $c [$refusal-tree $el]] $c//ux-refusal]]

# member-refusals — the per-member payload rules.
[; FLAT IF-CHAIN, NOT [?match] — the gate-merge lever (DP4 letter d), the
   same §4 lesson allowed-attrs learned in W14: a wide [?match] costs tens of
   µs PER ARM per call and this def runs once per node under the semantic
   gate. Converted mechanically from the match spelling (case bodies
   byte-identical); the verifier is the derived conformance suites, which
   re-ran identical after the conversion, and the bench delta is recorded in
   design/787/w21/README.md. ]
[?def member-refusals pure [returns any] ($el::any $n::string)
    [?if [= $n "ux:heading"] [then
      [?if [$valid-level [$level-of $el]]
        [then ()]
        [else ([ux-refusal code=ux-bad-heading-level element=$n level=[$string $el@level]])]]]
    [else [?if [= $n "ux:badge"] [then
      [?if [$valid-tone [$str-or $el@tone "neutral"]]
        [then ()]
        [else ([ux-refusal code=ux-bad-tone element=$n tone=[$string $el@tone]])]]]
    [; the tone set is CLOSED (§2.5) and three members carry one; until W14
       only two of them checked it, so `[ux:notice tone=sparkly]` passed —
       found by the P0-98 attribute inventory, same silent-acceptance family. ]
    [else [?if [= $n "ux:notice"] [then
      [?if [$valid-tone [$str-or $el@tone "info"]]
        [then ()]
        [else ([ux-refusal code=ux-bad-tone element=$n tone=[$string $el@tone]])]]]
    [; P0-67: a destructive action confirms BY URL, never by dialog. `hx-confirm`
       is off the pinned subset permanently, and a client dialog is a thing the
       terminal renderer would have to simulate. So `confirm=` declares the
       restatement and `confirm-href=` is the place it lives — a real location,
       deep-linkable, degrading with no kernel, identical on both faces. One
       without the other is a confirmation nobody can reach. ]
    [; P0-99 (RULED 2026-08-18, audit letter 2a): an unavailable act says so,
       and says why — when the why is data. `available=` is boolean-shaped and
       closed (the tone precedent); `available=false` REQUIRES `reason=` — a
       disabled control with no stated why is a locked door with no sign on
       it. Capability-derived absence stays P0-47 and never reaches this
       attribute: this is for the state of the WORLD, not of the actor. ]
    [else [?if [= $n "ux:action"] [then
      [?if [$exists $el@verb]
        [then [?if [and [$exists $el@confirm] [not [$exists $el@confirm-href]]]
                [then ([ux-refusal code=ux-confirm-no-href element=$n verb=[$string $el@verb]])]
                [else [?if [and [$exists $el@available]
                                [not [or [= [$string $el@available] "true"]
                                         [= [$string $el@available] "false"]]]]
                        [then ([ux-refusal code=ux-bad-available element=$n available=[$string $el@available]])]
                        [else [?if [and [= [$str-or $el@available "true"] "false"]
                                        [not [$exists $el@reason]]]
                                [then ([ux-refusal code=ux-unavailable-no-reason element=$n verb=[$string $el@verb]])]
                                [else [$no-placed-id $el $n]]]]]]]]
        [else ([ux-refusal code=ux-action-no-verb element=$n])]]]
    [else [?if [= $n "ux:link"] [then   [$no-placed-id $el $n]]
    [; AN ACTION INSIDE A FORM IS REFUSED. An action is itself a submitting
       control with its own verb and its own parameters (W10 made it a real
       form so it degrades without the kernel), and one submission cannot be
       nested inside another — on the web the inner one is dropped by the
       parser, and in a terminal the focus ring would offer a stop that posts
       the wrong intent. Both failures are silent, which is why this is a gate
       rather than a note. ]
    [else [?if [= $n "ux:form"] [then
      [?if [$exists $el@verb]
        [then [?if [$found $el//ux:action]
                [then ([ux-refusal code=ux-action-in-form element=$n verb=[$string $el@verb]])]
                [else [$no-placed-id $el $n]]]]
        [else ([ux-refusal code=ux-form-no-verb element=$n])]]]
    [else [?if [= $n "ux:input"] [then
      [?if [$exists $el@name]
        [then ()]
        [else ([ux-refusal code=ux-input-no-name element=$n])]]]
    [else [?if [= $n "ux:hidden"] [then
      [?if [$exists $el@name]
        [then ()]
        [else ([ux-refusal code=ux-input-no-name element=$n])]]]
    [else [?if [= $n "ux:region"] [then
      [?if [$exists $el@feature]
        [then [$no-placed-id $el $n]]
        [else ([ux-refusal code=ux-region-no-feature element=$n])]]]
    [; A select with no name submits nothing; an option with no value carries
       nothing. Both render fine and both are dead controls. ]
    [else [?if [= $n "ux:select"] [then
      [?if [$exists $el@name] [then ()] [else ([ux-refusal code=ux-input-no-name element=$n])]]]
    [else [?if [= $n "ux:option"] [then
      [?if [$exists $el@value] [then ()] [else ([ux-refusal code=ux-option-no-value element=$n])]]]
    [; A repeating group needs a name to index its instances under; without one
       every instance submits under the same key and collapses to one. ]
    [else [?if [= $n "ux:group"] [then
      [?if [$exists $el@name] [then ()] [else ([ux-refusal code=ux-input-no-name element=$n])]]]
    [; A filter that names no collection is inert on every renderer, and
       inert-but-rendered is the failure class that survives every gate. ]
    [; A FILTER NARROWS SOMETHING. W10 admits a second spelling of "something":
       `affects=` narrows a collection ON THIS PAGE (a fragment), and `route=`
       narrows the store BY GOING SOMEWHERE — a store search box produces a new
       location (`/search?q=…`), and P0-78 says a location is what a meaningful
       state is. Both are the same semantic (narrow by this text) and neither is
       an intent, which is why they are one member rather than two. What is
       still refused is a filter that narrows NOTHING: inert-but-rendered is the
       failure class that survives every server-side gate. ]
    [else [?if [= $n "ux:filter"] [then
      [?if [$exists $el@name]
        [then [?if [or [$exists $el@affects] [$exists $el@route]]
                [then ()]
                [else ([ux-refusal code=ux-filter-no-affects element=$n])]]]
        [else ([ux-refusal code=ux-input-no-name element=$n])]]]

    [; ── the W10 members ─────────────────────────────────────────────────── ]

    [; AN UNDESCRIBED DEPICTION IS A REFUSAL (P0-54/P0-95), not a rendering
       with an empty attribute. A store without alt text is a store a blind
       customer cannot shop, and the omission is invisible to everyone who can
       see the picture — which is exactly the defect class that needs a gate
       rather than a review comment. Decorative art says so explicitly with
       `alt=""`, so "described as decorative" and "nobody wrote it" are
       distinguishable states. ]
    [else [?if [= $n "ux:media"] [then
      [?if [$exists $el@src]
        [then [?if [$exists $el@alt]
                [then ()]
                [else ([ux-refusal code=ux-media-no-alt element=$n src=[$string $el@src]])]]]
        [else ([ux-refusal code=ux-media-no-src element=$n])]]]

    [; A parameter with no value posts an empty string, and the command layer
       then refuses in a way that blames the customer for the projection's bug
       (P0-56). Refusing at projection puts the error where the mistake is. ]
    [else [?if [= $n "ux:param"] [then
      [?if [$exists $el@name]
        [then [?if [$exists $el@value]
                [then ()]
                [else ([ux-refusal code=ux-param-no-value element=$n param=[$string $el@name]])]]]
        [else ([ux-refusal code=ux-input-no-name element=$n])]]]

    [else [?if [= $n "ux:steps"] [then
      [?if [$exists $el@name] [then ()] [else ([ux-refusal code=ux-input-no-name element=$n])]]]

    [; A `done` step MUST carry an href. This is the one place a UX pattern is
       enforced by the VOCABULARY rather than by review (P0-57/P0-89), because
       "you cannot go back and change the address you already typed" is the
       most commonly lost property of a checkout and its loss is silent. ]
    [else [?if [= $n "ux:step"] [then
      [?if [$valid-step-state [$str-or $el@state "ahead"]]
        [then [?if [and [= [$str-or $el@state "ahead"] "done"] [not [$exists $el@href]]]
                [then ([ux-refusal code=ux-step-not-editable element=$n step=[$string $el@name]])]
                [else ()]]]
        [else ([ux-refusal code=ux-bad-step-state element=$n state=[$string $el@state]])]]]

    [; FIELD MODE (W23, audit2 letter (i)): a quantity without a verb is a
       FORM FIELD — the value rides the enclosing form's post, exactly like
       ux:input, and the shell (browser or terminal) steps it locally. With a
       verb it stays P0-102's act-stepper: every change is its own intent. ]
    [else [?if [= $n "ux:quantity"] [then
      [?if [$exists $el@name]
        [then ()]
        [else ([ux-refusal code=ux-input-no-name element=$n])]]]

    [; A link to where you already are is a lie about what activating it does,
       and in a terminal it is a focus stop that does nothing. ]
    [else [?if [= $n "ux:crumb"] [then
      [?if [and [= [$str-or $el@current "false"] "true"] [$exists $el@href]]
        [then ([ux-refusal code=ux-crumb-current-href element=$n])]
        [else [?if [$exists $el@label] [then ()] [else ([ux-refusal code=ux-crumb-no-label element=$n])]]]]]

    [; PAGING AN UNORDERED COLLECTION IS NOT A WINDOW, IT IS A LOTTERY (P0-60):
       the same request twice may return overlapping pages and omit rows
       entirely, and no client can detect it. The collection has to say it is
       ordered; silence is refused rather than assumed. ]
    [else [?if [= $n "ux:pager"] [then
      [?if [= [$str-or $el@ordered "false"] "true"]
        [then [?if [$exists $el@page] [then ()] [else ([ux-refusal code=ux-pager-no-page element=$n])]]]
        [else ([ux-refusal code=ux-pager-unordered element=$n])]]]

    [else [?if [= $n "ux:page-link"] [then
      [?if [$exists $el@href] [then ()] [else ([ux-refusal code=ux-link-no-href element=$n])]]]

    [else [?if [= $n "ux:facet"] [then
      [?if [$exists $el@name] [then ()] [else ([ux-refusal code=ux-input-no-name element=$n])]]]

    [; A ZERO-COUNT FACET VALUE IS A TRAP WITH A LABEL ON IT — it is an
       affordance that leads to an empty page. It is admitted only when it is
       SELECTED, because then it is the only way back out of the empty page
       you are already looking at. ]
    [else [?if [= $n "ux:facet-value"] [then
      [?if [$exists $el@href]
        [then [?if [and [= [$str-or $el@count "1"] "0"] [not [= [$str-or $el@selected "false"] "true"]]]
                [then ([ux-refusal code=ux-facet-dead-end element=$n value=[$string $el@value]])]
                [else ()]]]
        [else ([ux-refusal code=ux-link-no-href element=$n])]]]

    [else [?if [= $n "ux:sort"] [then
      [?if [$exists $el@name] [then ()] [else ([ux-refusal code=ux-input-no-name element=$n])]]]
    [else [?if [= $n "ux:sort-option"] [then
      [?if [$exists $el@href] [then ()] [else ([ux-refusal code=ux-link-no-href element=$n])]]]

    [; A region you can open and cannot close is a trap, and `open=` without a
       way out is how every one of them is written. ]
    [else [?if [= $n "ux:aside"] [then
      [?if [$exists $el@label]
        [then [?if [and [= [$str-or $el@open "false"] "true"] [not [$exists $el@dismiss-href]]]
                [then ([ux-refusal code=ux-aside-no-dismiss element=$n label=[$string $el@label]])]
                [else ()]]]
        [else ([ux-refusal code=ux-aside-no-label element=$n])]]]

    [else [?if [= $n "ux:status"] [then
      [?if [$valid-tone [$str-or $el@tone "info"]]
        [then ()]
        [else ([ux-refusal code=ux-bad-tone element=$n tone=[$string $el@tone]])]]]

    [; ── P0-101 (DP4 letter g) ───────────────────────────────────────────── ]

    [; A PANEL INSIDE A PANEL IS REFUSED: peers of peers is a hierarchy, and a
       hierarchy is what regions and cards already are. The scan is over the
       CHILDREN's subtrees (`$el/*//`) because the descendant axis includes
       the element itself — `$el//ux:panel` would refuse every panel. ]
    [else [?if [= $n "ux:panel"] [then
      [?if [$exists $el@name]
        [then [?if [$found $el/*//ux:panel]
                [then ([ux-refusal code=ux-panel-nested element=$n panel=[$string $el@name]])]
                [else ()]]]
        [else ([ux-refusal code=ux-input-no-name element=$n])]]]

    [else ()]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]

[?def valid-step-state pure [returns bool] ($x::string)
  [$exists [?for [in $s ("done", "current", "ahead")] [where [= $s $x]] [yield $s]]]]

# no-placed-id — three members cannot carry a placed-element address, each for
# its own reason: a region is keyed by (feature instance, path) and would
# SILENTLY DISCARD an id; a link and an action own their element's attribute
# slots. Writing `id=` on one of them is a refusal rather than a no-op, because
# a silently ignored identity is exactly the kind of thing that is discovered
# much later, from a deep link that never resolves.
[?def no-placed-id pure [returns any] ($el::any $n::string)
  [?if [$exists $el@id]
    [then ([ux-refusal code=ux-id-not-addressable element=$n id=[$string $el@id]])]
    [else ()]]]

# A heading level is one of six literal names, checked by membership rather
# than by casting: a cast RAISES on `level=abc`, and a raised cast would escape
# the "one [err] naming every refusal" contract and reach the caller as an
# engine error instead of a projection refusal.
[?def level-of scope=public pure [returns string] ($el::any)
  [$str-or $el@level "2"]]

[?def valid-level pure [returns bool] ($l::string)
  [$exists [?for [in $x ("1", "2", "3", "4", "5", "6")] [where [= $x $l]] [yield $x]]]]

# joined — read two refusal sequences back as one flat node-set, via the same
# carrier discipline.
[?def joined scope=public pure [returns any] ($a::any $b::any)
  [?let [= $c [ux-refusals $a $b]] $c//ux-refusal]]

# ── §4.7 Verb coverage — the completeness instrument (audit H6, W16) ────────
#
# EQUIVALENCE PROVES AGREEMENT, NOT COMPLETENESS (register L5): the product
# page had no buy control for three waves and every fixture certified both
# faces rendered the absence identically. This is the instrument that makes
# completeness mechanical: the feature's invokable verbs (`effect=act` — the
# tools-projection discriminator, P0-17) are diffed against the verbs a tree
# actually offers as controls, and a missing affordance REFUSES unless the
# composition document declares it not offered, with a why.
#
# Coverage is STATE-DEPENDENT — an empty basket legitimately offers no
# remove-line — so these defs are the mechanical core for a DRIVEN walker
# (the store's harness puts each route into a state where its subjects
# exist, then asserts), not a per-request gate: a request-time check would
# re-prove a static fact on every GET and false-refuse on honest states.
#
# P0-86 ("a card you cannot buy from is a catalogue entry") generalized:
# would have caught the three-wave missing buy control on its first run —
# and on its actual first run it caught five declared verbs the store never
# built controls for (see design/787/w16/README.md).

# act-verbs — the feature's invokable verbs, by the P0-17 discriminator.
[?def act-verbs scope=public pure [returns any] ($feature::any)
  [?for [in $v $feature//verb]
    [where [= [$str-or $v@effect ""] "act"]]
    [yield [$string $v@name]]]]

# control-verbs — every verb a semantic tree offers as a CONTROL: an action
# (available or not — an unavailable act is still the act, stated inert), a
# form, or a quantity. Distinct, because twenty cards offering add-to-basket
# are one affordance.
[?def control-verbs scope=public pure [returns any] ($el::any)
  [?let [= $box [ux-verb-box
                  [?splice [?for [in $a $el//ux:action]  [yield [ux-verb [?attr "n" [$str-or $a@verb ""]]]]]]
                  [?splice [?for [in $f $el//ux:form]    [yield [ux-verb [?attr "n" [$str-or $f@verb ""]]]]]]
                  [; a FIELD-MODE quantity (no verb, W23 letter (i)) invokes
                     nothing of its own — its value rides the enclosing form. ]
                  [?splice [?for [in $s $el//ux:quantity] [where [$exists $s@verb]]
                             [yield [ux-verb [?attr "n" [$str-or $s@verb ""]]]]]]]]
    [$distinct [?for [in $x $box/*]
                 [where [not [= [$string $x@n] ""]]]
                 [yield [$string $x@n]]]]]]

# verbs-uncovered — the verbs a route DECLARES it offers that its tree, in
# the state the walker drove it into, does not offer as a control.
[?def verbs-uncovered scope=public pure [returns any] ($offers::any $el::any)
  [?let [= $have [$control-verbs $el]]
    [?for [in $v $offers]
      [where [not [$exists [?for [in $h $have] [where [= $h $v]] [yield $h]]]]]
      [yield [ux-refusal code=ux-verb-uncovered verb=$v]]]]]

# verbs-unaccounted — the surface-level completeness half: every act verb the
# feature declares must be offered by SOME route or declared not-offered with
# a why. An act verb no route offers and nothing accounts for is exactly the
# missing-affordance class L5 says equivalence cannot see.
[?def verbs-unaccounted scope=public pure [returns any] ($feature::any $offered::any $not-offered::any)
  [?for [in $v [$act-verbs $feature]]
    [where [and [not [$exists [?for [in $o $offered]     [where [= $o $v]] [yield $o]]]]
                [not [$exists [?for [in $n $not-offered] [where [= $n $v]] [yield $n]]]]]]
    [yield [ux-refusal code=ux-verb-unaccounted verb=$v]]]]

# ── §5 The renderer SDK — what a renderer needs and nothing more ────────────
#
# Everything a renderer must share with every other renderer, so that two
# renderings agree on structure by construction rather than by discipline.

# descend — the element path an element's CHILDREN see. A placed element
# carrying an author-assigned id contributes that id as the path step (P0-16),
# which is what keeps two sibling collections in one region from minting the
# same row addresses. An element without an id is not a placed element and
# leaves the path alone.
#
# The render context rides along untouched: a renderer descending a tree must
# not lose its bindings halfway down.
[?def descend scope=public pure [returns map] ($el::any $ctx::map)
  [?if [$exists $el@id]
    [then [$ctx-at $ctx [$path-step [?else $ctx.path "/"] [$string $el@id]]]]
    [else $ctx]]]

# ctx-at — the same fragment context at a different element path.
[?def ctx-at scope=public pure [returns map] ($ctx::map $path::string)
  {route: [?else $ctx.route "/"], feature: [?else $ctx.feature ""],
   path: $path, bind: [?else $ctx.bind ()]}]

# ctx-frag — the fragment address a context currently denotes.
[?def ctx-frag scope=public pure [returns element] ($ctx::map)
  [$frag [?else $ctx.route "/"] [?else $ctx.feature ""] [?else $ctx.path "/"]]]

# affects-frag — the fragment an action or form declares that it updates. The
# address is DERIVED from the declaration and the enclosing context, so a
# renderer's target can never drift from the identity it minted for the thing
# being targeted.
[; A FRAGMENT ADDRESS IS (route, feature instance, element path) — P0-9, and
   the feature instance is not decoration. An action inside one region that
   updates something in ANOTHER — a buy control on a product card updating the
   basket badge in the shell — is naming a target in a different feature
   instance, and the address model has always required it to say so.
   W11 made that concrete rather than magical: `affects="shell#/shell/basket"`
   names the instance before the path. Resolving a bare path against whichever
   region happened to mint one was the alternative, and it would have made two
   regions with the same element path silently interchangeable — exactly the
   ambiguity P0-9 refuses when it forbids silent ordinals for repeated feature
   instances. ]
[?def affects-frag scope=public pure [returns any] ($el::any $ctx::map)
  [?if [$exists $el@affects]
    [then [?let
            [= $raw [$string $el@affects]]
            [= $i   [$strings:find $raw "#"]]
            [?if [< $i 0]
              [then [$frag [?else $ctx.route "/"] [?else $ctx.feature ""] $raw]]
              [else [$frag [?else $ctx.route "/"]
                           [$strings:slice $raw 0 $i]
                           [$strings:slice $raw [+ $i 1] [$strings:length $raw]]]]]]]
    [else ()]]]

# str-or — an absent attribute's default. NOT `[?else [$string $el@a] D]`:
# `[$string ()]` is the empty string, which EXISTS, so `?else` would never fire
# and every absent attribute would silently read as "".
[?def str-or scope=public pure [returns string] ($v::any $dflt::string)
  [?if [$exists $v] [then [$string $v]] [else $dflt]]]

# label-of — an element's display label: the `label=` attribute when present,
# else its text.
[?def label-of scope=public pure [returns string] ($el::any)
  [?if [$exists $el@label] [then [$string $el@label]] [else [$string $el]]]]

# label-of-name — `order-id` → `Order id`. THE degradation P0-17 rules: a
# param name is always present, so a label always exists.
[?def label-of-name scope=public pure [returns string] ($n::string)
  [?let [= $s [$strings:replace $n "-" " "]]
    [$concat [$upper [$substring $s 1 1]] [$substring $s 2 [- [$string-length $s] 1]]]]]

# child-elements — the child ELEMENTS of `$el` named `$n`.
#
# NOT `$el/n`. A named child step is a FIELD READ, and with exactly one match
# it atomizes to the child's VALUE — so `[$first $li/a]` hands back the string
# "Products" where the caller wanted the `<a>` element, while the identical
# expression over a li with TWO anchors hands back an element. Correct for
# reading a value, wrong for walking a tree, and the difference only appears
# when a collection happens to have one member: the worst possible time to
# discover it, because every fixture with two rows passes.
#
# `/*` does not atomize, so walking goes through it and filters by name. It
# also has to see through sequence children (§4), because a projection's
# children arrive as one sequence-valued child.
[?def child-elements scope=public pure [returns any] ($el::any $n::string)
  [?if [$absent $el]
    [then ()]
    [else
      [?let
        [; `[?for [in $p $el]]` yields an ELEMENT once and a sequence's members
           each, so one spelling covers both — and it has to, because `/*` does
           NOT see through a single-item sequence even though `[$name]` does.
           `[$cx:parse]` returns exactly that shape for a one-element document,
           which is how every `.feature.cxd` in the reference estate arrives. ]
        [= $c [ux-kids [?splice [?for [in $p $el]
                                  [yield [?for [in $k $p/*] [yield [$kid-wrap $k $n]]]]]]]]
        [?for [in $w $c//ux-kid] [yield [$first $w/*]]]]]]]

# absent — is this absence rather than an element? NOT `[not [$exists $x]]`:
# `[$exists]` is FALSE for a single element taken with `[$first]`/`[$nth]` as
# well as for absence, so it cannot tell "found one" from "found none" — the
# most load-bearing distinction a tree walk makes. `[$count]` can: 0 for
# absence, 1 for one element.
[?def absent scope=public pure [returns bool] ($x::any) [= [$count $x] 0]]

[?def kid-wrap pure [returns any] ($k::any $n::string)
  [?if [$seq-child $k]
    [then [ux-kids [?for [in $m $k] [yield [$kid-wrap $m $n]]]]]
    [else [?if [= [$name $k] $n] [then [ux-kid $k]] [else ()]]]]]

# found — "did this step match anything", for a value that may be a NODE-SET or
# a bare element. The builtin `[$present]` (#854/#849) IS this question — true
# for any present value, false only for the absence channel — so the def is a
# thin delegation kept for its vocabulary name (DP4 (i): the pre-[$present]
# workaround body, an [$exists]-or-named dance, retired at the release/0.16.0
# rebase).
[?def found scope=public pure [returns bool] ($x::any)
  [$present $x]]

# first-child — the first child element named `$n`, or absence.
[?def first-child scope=public pure [returns any] ($el::any $n::string)
  [?let [= $cs [$child-elements $el $n]]
    [?if [$absent $cs] [then ()] [else [$first $cs]]]]]

# has-str — membership of a string in a sequence of stringables.
[?def has-str scope=public pure [returns bool] ($seq::any $s::string)
  [$exists [?for [in $x $seq] [where [= [$string $x] $s]] [yield $x]]]]

# ── §5b Minted addresses, and the collision check (P0-11, Q-B) ─────────────
#
# WHICH ELEMENTS OWN AN ADDRESS is a property of the semantic tree, not of a
# renderer — so it is stated once, here, and both renderers mint from it.
# Until W5 the duplicate-id check lived in the web emitter over the LOWERED
# HTML tree, which was wrong twice over: the terminal renderer had no check at
# all (and mints its focus ring from the same ids, so a truncation collision
# would silently break navigation with nothing to catch it), and the check
# re-walked the larger of the two trees to recover addresses the lowering had
# just minted.

# has-address — does this element own a distinct fragment address?
[?def has-address scope=public pure [returns bool] ($el::any)
  [?match [$name $el]
    [case "ux:region" true]
    [case "ux:form"   true]
    [case "ux:group"  true]
    [case "ux:panel"  true]
    [case "ux:row"    [$exists $el@key]]
    [else [$exists $el@id]]]]

# child-ctx — the fragment context an element's children see. THE one
# definition of how a path grows: a region re-roots feature and path, a form
# steps by its verb, a keyed row steps by its key, a placed element steps by
# its author-assigned id (P0-16), and anything else is structure and leaves
# the path alone.
[?def child-ctx scope=public pure [returns map] ($el::any $ctx::map)
  [?match [$name $el]
    [case "ux:region"
      {route: [?else $ctx.route "/"], feature: [$string $el@feature],
       path: [$str-or $el@path "/"], bind: [?else $ctx.bind ()]}]
    [case "ux:form"
      [$ctx-at $ctx [$path-step [?else $ctx.path "/"] [$str-or $el@verb ""]]]]
    [; a repeating group is a swap target — the add control appends into it —
       so it owns an address, keyed by the name its instances are indexed under ]
    [case "ux:group"
      [$ctx-at $ctx [$path-step [?else $ctx.path "/"] [$str-or $el@name ""]]]]
    [; a panel's name is its identity within its region (P0-101) — the address
       step, exactly as a group steps by name ]
    [case "ux:panel"
      [$ctx-at $ctx [$path-step [?else $ctx.path "/"] [$str-or $el@name ""]]]]
    [case "ux:row"
      [?let [= $s [$row-step [?else $ctx.path "/"]
                    [?if [$exists $el@key] [then [$string $el@key]] [else ()]]]]
        [?if [$exists $s] [then [$ctx-at $ctx $s]] [else $ctx]]]]
    [else [$descend $el $ctx]]]]

# address-pairs — every (DOM id, readable address) a semantic tree will mint.
[?def address-pairs scope=public pure [returns any] ($el::any $ctx::map)
  [?let [= $c [$address-tree $el $ctx]] $c//ux-addr]]

[?def address-tree pure [returns any] ($el::any $ctx::map)
  [?if [$seq-child $el]
    [then [ux-addrs [?splice [?for [in $m $el] [yield [$address-tree $m $ctx]]]]]]
    [else
      [?let
        [= $inner [$child-ctx $el $ctx]]
        [ux-addrs
          [?splice [?if [$has-address $el]
                     [then [?let [= $r [$frag-repr [$ctx-frag $inner]]]
                             ([ux-addr [?attr "id" [$frag-id-of $r]] [?attr "frag" $r]])]]
                     [else ()]]]
          [?splice [?for [in $k $el/*] [yield [$address-tree $k $inner]]]]]]]]]

# address-collisions — a duplicate DOM id is an EMITTER ERROR: refusal, never
# silent disambiguation. TWO distinct causes, reported distinctly because they
# send an implementer to different places:
#
#   ux-id-collision   — different addresses, same id. The hash16 TRUNCATION
#                       collision P0-11 names (Q-B).
#   ux-address-reused — the SAME address minted twice on one page. Not a
#                       truncation problem at all: the projection produced two
#                       fragments claiming to be the same fragment, which means
#                       an element path failed to distinguish them. W3 found
#                       this for real — two orders each holding a line with the
#                       same SKU addressed identically until rows began
#                       extending the path for their contents.
#
# TWO PHASES, because the exact answer is quadratic and the common answer is
# "no collisions". Detection is three counts:
#
#   pairs ≠ distinct pairs   → some (id, address) was minted twice  → reuse
#   distinct pairs ≠ distinct ids → some id carries two addresses   → collision
#
# Both are O(n log n). The pairwise scan that NAMES the offenders runs only
# when a count disagrees — a path that refuses the render anyway, so its cost
# buys a precise diagnostic instead of being paid on every clean page. W5
# measured the old always-quadratic form at ~47 ms of a ~190 ms render.
[; THE SINGLE GATE WALK (W24, owner ruling 3a): minting the address pairs —
   a full-tree walk that hashes a fragment repr per addressed element — was
   the dominant cost of BOTH address gates, and each gate ran it privately.
   The `-with` variants take the pairs a caller minted ONCE; the original
   entries stay, delegating, so a fixture's subject (the gate) is unchanged
   and every golden re-derives byte-identically. ]
[?def collisions-with scope=public pure [returns any] ($pairs::any)
  [?let
    [= $ids   [?for [in $p $pairs] [yield [$string $p@id]]]]
    [?if [and [= [$count $pairs] [$count [$distinct $pairs]]]
              [= [$count [$distinct $pairs]] [$count [$distinct $ids]]]]
      [then ()]
      [else [$name-collisions $pairs]]]]]

[?def address-collisions scope=public pure [returns any] ($el::any $ctx::map)
  [$collisions-with [$address-pairs $el $ctx]]]

[?def name-collisions pure [returns any] ($pairs::any)
  [?let
    [= $c [ux-refusals
            [?splice [?for [in $a $pairs]
                       [yield [?for [in $b $pairs]
                                [where [and [= $a@id $b@id] [not [= $a@frag $b@frag]]]]
                                [yield [ux-refusal code=ux-id-collision id=[$string $a@id]]]]]]]
            [?splice [?for [in $a $pairs]
                       [where [> [$count [?for [in $b $pairs]
                                           [where [and [= $a@id $b@id] [= $a@frag $b@frag]]]
                                           [yield $b]]] 1]]
                       [yield [ux-refusal code=ux-address-reused id=[$string $a@id]]]]]]]
    [$distinct $c//ux-refusal]]]

# err-refusals — an `[err]` ANYWHERE in a tree the projection is about to
# render.
#
# Found by a bug, like the last one. `[$concat]` was handed a node-set instead
# of a string; the builtin's refusal came back as an `[err code=… message=…]`
# ELEMENT, the renderer treated it as an ordinary child, and it serialized into
# the page as content. The response was 200. Every gate in this pack passed,
# because none of them was looking for a refusal that had stopped being a
# refusal and become a node.
#
# That is the §5.4 failure class exactly: not "the projection produced the
# wrong thing" but "the projection produced something nobody checked". A
# builtin refusal reaching a browser as markup is worse than a blank page,
# because a blank page gets reported.
#
# The gate is deliberately blunt — ANY `err` element, semantic tree or lowered
# tree, refuses the whole render. There is no legitimate reason for one to be
# in a tree destined for a surface: refusals travel on the `[err]` CHANNEL, and
# a refusal that has been spliced into a document has already lost the property
# that makes it a refusal.
[?def err-refusals scope=public pure [returns any] ($el::any)
  [?let [= $c [ux-refusals [?splice [?for [in $e $el//err]
                                      [yield [ux-refusal code=ux-err-in-tree
                                               element=[$str-or $e@code "err"]
                                               affects=[$str-or $e@message ""]]]]]]]
    [$distinct $c//ux-refusal]]]

# dangling-affects — an `affects=` naming a path NO element in the same tree
# mints is a refusal.
#
# This is the gate the design was missing, and a user found the hole by
# clicking the button. `affects=` exists so a renderer derives its target from
# a semantic address instead of carrying a hand-written selector — but the
# PATH itself was still hand-written, and a path that names nothing produces a
# target id for an element that does not exist. The swap then lands nowhere:
# the commit succeeds, the feed publishes, and the page silently does not
# update. Manual refresh shows the change, which is the worst possible symptom
# because it looks like a caching problem.
#
# Every other address mistake in this pack already refuses — an unbound feed, a
# duplicate address, a reused address. This one did not, and "silently does
# nothing" is exactly the failure class §5.4 exists to exclude.
# A FRAGMENT is the one tree where "no element here mints it" is not a
# mistake: the form re-rendered after a refusal targets the card it is about
# to be swapped into, and that card is on the page, not in the payload.
#
# The relaxation is not "skip the gate". A fragment's `affects=` must name a
# path the RENDER CONTEXT declares — a `[swap affects=…]` or `[fragment
# affects=…]` entry is the surface author stating that a container lives at
# that path. So a fragment is checked against the surface's own declaration
# instead of against the payload, and an `affects=` that names nothing anywhere
# still refuses. A full page keeps the strict rule, because on a page there is
# nowhere else for the container to be.
[?def dangling-affects-with scope=public pure [returns any] ($el::any $ctx::map $pairs::any)
  [?let
    [= $minted [?for [in $p $pairs] [yield [$string $p@frag]]]]
    [= $declared [?if [= [?else $ctx.fragment false] true]
                   [then [$declared-containers [?else $ctx.bind ()]]]
                   [else ()]]]
    [= $c [$affects-tree $el $ctx $minted $declared]]
    [$distinct $c//ux-refusal]]]

[?def dangling-affects scope=public pure [returns any] ($el::any $ctx::map)
  [$dangling-affects-with $el $ctx [$address-pairs $el $ctx]]]

# declared-containers — the container paths the render context names, as the
# same reprs `affects-tree` compares against. A declared path is a claim by the
# surface author that something at that path exists; a fragment is allowed to
# aim at one and at nothing else.
[?def declared-containers scope=public pure [returns any] ($rctx::any)
  [?if [$absent $rctx]
    [then ()]
    [else [?let [= $c [rctx-decls [?splice $rctx/swap] [?splice $rctx/fragment]]]
            [$distinct [?for [in $d $c/*]
                         [where [$exists $d@affects]]
                         [yield [$string $d@affects]]]]]]]]

[?def affects-tree pure [returns any] ($el::any $ctx::map $minted::any $declared::any)
  [?if [$seq-child $el]
    [then [ux-refusals [?splice [?for [in $m $el] [yield [$affects-tree $m $ctx $minted $declared]]]]]]
    [else
      [?let
        [= $inner [$child-ctx $el $ctx]]
        [ux-refusals
          [?splice [?if [$exists $el@affects]
                     [then [?let [= $want [$frag-repr [$affects-frag $el $ctx]]]
                             [?if [or [$has-str $minted $want]
                                      [$has-str $declared [$string $el@affects]]]
                               [then ()]
                               [else ([ux-refusal code=ux-dangling-affects
                                        element=[$name $el] affects=[$string $el@affects]])]]]]
                     [else ()]]]
          [?splice [?for [in $k $el/*] [yield [$affects-tree $k $inner $minted $declared]]]]]]]]]

# ── §6 The common content normal form (the equivalence subject) ─────────────
#
# R5's claim is that the SAME semantic tree renders on a non-browser renderer.
# "The same" needs a subject: two renderings agree when they agree on CONTENT
# and STRUCTURE, and disagree freely on presentation — a `<td>` and a
# column-padded terminal cell are the same cell.
#
# `content-of` is that normal form, taken from the semantic tree. Each
# renderer supplies a readback from ITS OWN OUTPUT to the same form
# (`ux-web:content-of-html`, `ux-tui:content-of-tui`), and the fixtures assert
# all three canonical-equal. That is a three-way agreement, not a two-way one:
# it catches a renderer that drops content AND a renderer that invents it.
#
# Attribute ORDER is identity-bearing in canonical bytes, so every producer of
# a `[c:…]` element writes the same attributes in the same order. The order is
# stated once, here, and the two readbacks follow it.
[?def content-of scope=public pure [returns any] ($el::any)
  [?if [$seq-child $el]
    [then [c:seq [$content-flat $el]]]
    [else [$content-of-el $el]]]]

# SEQUENCE NESTING IS NORMALIZED AWAY, and it has to be. A hand-authored card
# has four element children; the SAME card, after a projection built its
# children with a `[?for]`, has one sequence-valued child holding four. Both
# are the same content and the same structure, and a normal form that
# distinguished them would report every projected tree as unequal to its
# hand-authored twin — which is precisely the comparison W5 exists to make.
#
# Flattening rides the carrier discipline used everywhere else: wrap each item
# in `[c:k …]`, read them back with the descendant axis. Sound because a
# flattened content element never contains a `c:k` of its own — each level
# unwraps before returning.
[?def content-flat pure [returns any] ($s::any)
  [?let [= $c [c:ks [?for [in $m $s] [yield [$content-wrap $m]]]]]
    [?for [in $w $c//c:k] [yield [$first $w/*]]]]]

[?def content-wrap pure [returns any] ($k::any)
  [?if [$seq-child $k]
    [then [c:ks [?for [in $m $k] [yield [$content-wrap $m]]]]]
    [else [c:k [$content-of-el $k]]]]]

[; FLAT IF-CHAIN, NOT [?match] — the other half of DP4 letter d. content-of
   runs once per node whenever the normal form is taken (every equivalence
   readback, every voice render), and the 45-arm match spelling paid the same
   per-arm scan the gate did. Same mechanical conversion, same verifier. ]
[?def content-of-el pure [returns any] ($el::any)
  [?let [= $n [$name $el]]
    [?if [= $n "ux:region"] [then    [c:region  [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:card"] [then      [c:card    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:heading"] [then   [c:heading [?attr "level" [$level-of $el]] [?splice [$content-leaf $el]]]]
    [else [?if [= $n "ux:text"] [then      [c:text    [?splice [$content-leaf $el]]]]
    [else [?if [= $n "ux:field"] [then     [c:field   [?attr "label" [$str-or $el@label ""]] [?splice [$content-leaf $el]]]]
    [; `format=` turns a carrier into display text in ONE place — see
       `[$formatted]`. A cell carrying `format=money` is the same content in
       both faces because both call the same def. ]
    [else [?if [= $n "ux:badge"] [then     [c:badge   [?attr "tone" [$str-or $el@tone "neutral"]] [?splice [$content-leaf $el]]]]
    [else [?if [= $n "ux:list"] [then      [c:list    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:item"] [then      [c:item    [?splice [$content-leaf $el]]]]
    [else [?if [= $n "ux:table"] [then     [c:table   [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:columns"] [then   [c:columns [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:column"] [then    [c:column  [?splice [$content-leaf $el]]]]
    [else [?if [= $n "ux:rows"] [then      [c:rows    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:row"] [then       [c:row     [?attr "key" [$str-or $el@key ""]] [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:cell"] [then      [c:cell    [?splice [$content-leaf $el]]]]
    [else [?if [= $n "ux:nav"] [then       [c:nav     [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:nav-item"] [then  [c:nav-item [?attr "href" [$str-or $el@href ""]] [$label-of $el]]]
    [else [?if [= $n "ux:link"] [then      [c:link    [?attr "href" [$str-or $el@href ""]] [$label-of $el]]]
    [; THE PARAMS ARE CONTENT. What an item-scoped action posts is the whole
       point of the member (P0-56), and two renderers that agreed on the label
       and disagreed on the SKU would pass an equivalence fixture while sending
       different customers different things. The label moves to an attribute so
       the params can be children. ]
    [; REWORKED IN W15, three corrections in one entry so the goldens move once.
       `confirm` is PRESENCE-BOOLEAN: `confirm="true"` when declared, absent
       when not — emitting confirm="" for an unconfirmed action made "no
       confirm" and "empty confirm" indistinguishable (the audit's H5 blemish,
       the alt= distinction of P0-95), and the TEXT cannot be content because
       the web face deliberately renders it only at the confirmation URL
       (P0-67). For the same reason a confirming action carries NO verb: its
       web rendering is a link to the confirmation view and the verb lives
       there — a property one face legitimately does not render is not
       content. `available`/`reason` (P0-99) are content, verbatim when
       declared: an inert act whose why one face drops is two stores telling
       different truths. ]
    [else [?if [= $n "ux:action"] [then    [c:action  [?attr [?if [$exists $el@confirm] [then ()] [else "verb"]]
                                           [$str-or $el@verb ""]]
                                    [?attr "label" [$label-of $el]]
                                    [?attr [?if [$exists $el@confirm] [then "confirm"] [else ()]] "true"]
                                    [?attr [?if [$exists $el@available] [then "available"] [else ()]]
                                           [$str-or $el@available "true"]]
                                    [?attr [?if [$exists $el@reason] [then "reason"] [else ()]]
                                           [$str-or $el@reason ""]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:form"] [then      [c:form    [?attr "verb" [$str-or $el@verb ""]] [?splice [$content-kids $el]]]]
    [; `kind=` is deliberately ABSENT from the normal form. The semantic tree
       carries a CX TYPE (`int`, `money`); each renderer maps it to its own
       control — a number input and a checkbox on the web, a numeric editor
       and a `[x]` toggle in a terminal — and the mapping is many-to-one, so
       neither can recover it. Asserting on it would assert that two renderers
       make the same widget choice, which is the opposite of what
       renderer-agnostic means. ]
    [else [?if [= $n "ux:input"] [then     [c:input   [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?attr "required" [$str-or $el@required "false"]]
                                    [?attr "error" [$str-or $el@error ""]]
                                    [$str-or $el@value ""]]]
    [else [?if [= $n "ux:hidden"] [then    [c:hidden  [?attr "name" [$str-or $el@name ""]] [$str-or $el@value ""]]]
    [else [?if [= $n "ux:submit"] [then    [c:submit  [$label-of $el]]]
    [else [?if [= $n "ux:error"] [then     [c:error   [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:notice"] [then    [c:notice  [?attr "tone" [$str-or $el@tone "info"]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:select"] [then    [c:select  [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?attr "required" [$str-or $el@required "false"]]
                                    [?attr "error" [$str-or $el@error ""]]
                                    [?attr "value" [$str-or $el@value ""]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:option"] [then    [c:option  [?attr "value" [$str-or $el@value ""]] [$label-of $el]]]
    [else [?if [= $n "ux:group"] [then     [c:group   [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:filter"] [then    [c:filter  [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?attr "route" [$str-or $el@route ""]]
                                    [$str-or $el@value ""]]]

    [; ── the W10 members in the normal form ──────────────────────────────────
       What is content and what is not, member by member, on the same test the
       existing entries use: a property BOTH renderers must carry is content;
       a property one renderer legitimately expresses differently is not.

       ux:media    — `alt` and `src` are content (the description IS the
                     depiction, for the reader who needs it, and the file is
                     what both faces name). `kind` and `tone` are not: they
                     are control-choice inputs, exactly like `kind=` on a
                     field.
       ux:quantity  — `value`, `min` and `max` are content; a browser draws
                     three buttons and a terminal binds two keys, and the
                     BOUNDS are the thing both must agree on.
       ux:facet-value — `count` is content. It is the member's whole reason
                     to exist; a renderer that dropped it turned the facet
                     back into a filter.
       ux:media/field/cell text is ALREADY FORMATTED by `[$formatted]`, which
       both renderers call — so this normal form asserts they format money the
       same way, which they must (a thousands separator is not about the
       medium). ]

    [else [?if [= $n "ux:media"] [then     [c:media   [?attr "src" [$str-or $el@src ""]]
                                    [?attr "alt" [$str-or $el@alt ""]]]]
    [else [?if [= $n "ux:grid"] [then      [c:grid    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:param"] [then     [c:param   [?attr "name" [$str-or $el@name ""]]
                                    [?attr "value" [$str-or $el@value ""]]]]
    [else [?if [= $n "ux:steps"] [then     [c:steps   [?attr "name" [$str-or $el@name ""]]
                                    [?attr "current" [$str-or $el@current ""]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:step"] [then      [c:step    [?attr "name" [$str-or $el@name ""]]
                                    [?attr "state" [$str-or $el@state "ahead"]]
                                    [?attr "href" [$str-or $el@href ""]]
                                    [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]]
    [; `value` joined in W15: the section comment above always said value, min
       and max are the content, and the entry disagreed with it — found by the
       W14 inventory. Two renderers agreeing on the bounds but not the number
       between them would pass the old fixture. ]
    [else [?if [= $n "ux:quantity"] [then   [c:quantity [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?attr "verb" [$str-or $el@verb ""]]
                                    [?attr "value" [$str-or $el@value ""]]
                                    [?attr "min" [$str-or $el@min "0"]]
                                    [?attr "max" [$str-or $el@max ""]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:breadcrumb"] [then [c:breadcrumb [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:crumb"] [then     [c:crumb   [?attr "href" [$str-or $el@href ""]]
                                    [?attr "current" [$str-or $el@current "false"]]
                                    [$str-or $el@label ""]]]
    [else [?if [= $n "ux:pager"] [then     [c:pager   [?attr "page" [$str-or $el@page "1"]]
                                    [?attr "pages" [$str-or $el@pages ""]]
                                    [?attr "total" [$str-or $el@total ""]]
                                    [?attr "prev-href" [$str-or $el@prev-href ""]]
                                    [?attr "next-href" [$str-or $el@next-href ""]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:page-link"] [then [c:page-link [?attr "n" [$str-or $el@n ""]]
                                      [?attr "href" [$str-or $el@href ""]]
                                      [?attr "current" [$str-or $el@current "false"]]]]
    [else [?if [= $n "ux:facet"] [then     [c:facet   [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:facet-value"] [then [c:facet-value [?attr "value" [$str-or $el@value ""]]
                                          [?attr "count" [$str-or $el@count ""]]
                                          [?attr "href" [$str-or $el@href ""]]
                                          [?attr "selected" [$str-or $el@selected "false"]]
                                          [$str-or $el@label [$str-or $el@value ""]]]]
    [else [?if [= $n "ux:sort"] [then      [c:sort    [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:sort-option"] [then [c:sort-option [?attr "value" [$str-or $el@value ""]]
                                          [?attr "href" [$str-or $el@href ""]]
                                          [?attr "selected" [$str-or $el@selected "false"]]
                                          [$str-or $el@label [$str-or $el@value ""]]]]
    [; P0-101: the grouping IS content — a face that dropped it would flatten
       a case file's "parties" and "timeline" into one undifferentiated run.
       Same shape as c:group: name, label (defaulted from the name), children. ]
    [else [?if [= $n "ux:panel"] [then     [c:panel   [?attr "name" [$str-or $el@name ""]]
                                    [?attr "label" [$str-or $el@label [$label-of-name [$str-or $el@name ""]]]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:aside"] [then     [c:aside   [?attr "label" [$str-or $el@label ""]]
                                    [?attr "open" [$str-or $el@open "false"]]
                                    [?attr "dismiss-href" [$str-or $el@dismiss-href ""]]
                                    [?splice [$content-kids $el]]]]
    [else [?if [= $n "ux:status"] [then    [c:status  [?attr "tone" [$str-or $el@tone "info"]]
                                    [?splice [$content-leaf $el]]]]
    [else [c:unknown]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]

[?def content-kids pure [returns any] ($el::any)
  [$content-flat $el/*]]

# A leaf's content is its text unless it has element children, in which case
# the children ARE the content. Mixed content was refused in §4, so exactly
# one of the two applies.
[?def content-leaf pure [returns any] ($el::any)
  [?if [$exists $el/*]
    [then [$content-kids $el]]
    [else [$formatted $el [$string $el]]]]]

# content-repr — the canonical bytes two renderings must agree on.
[?def content-repr scope=public pure [returns string] ($el::any)
  [$cx:canonical [$content-of $el]]]

# ── §7 Form projection: a command def → a semantic form (P0-17, P0-18) ──────
#
# The THIRD projection derives from the same source as the first two, the same
# way (P0-17): a command is a `[?def]` whose `[effects]` clause is PRESENT —
# clause presence, not item count, exactly the agent-tools discriminator. Like
# the tools face, this derives AT RENDER TIME from definitions; there is no
# materialized UI manifest to drift.
#
# ONE divergence from `cx-x/tools`, and it is deliberate: where the tools
# projection fails loud on a missing `[summary]` (an agent-facing description is
# load-bearing semantics), the UX projection DEGRADES to name-derived labels —
# human-facing defaults are presentational, and the R6 gates measure their
# quality rather than a refusal doing it. That difference is why the doc-lane
# helpers below are not shared with `cx-x/tools`: routing through
# `descriptors-of` would inherit its whole-projection refusal.
#
# `[preconditions]` and schema constraints are enforced ONCE, at the command
# layer. This projection never restates a rule — a refusal renders through
# `form-error` from the `[err]` channel, and nothing here mirrors a predicate.

[?def fn-docs-of pure [returns any] ($ast::map)
  [?for [in $s [?else $ast.docs []]]
    [= $el [$cx:parse $s]]
    [where [= [$name $el] "fn-doc"]]
    [yield $el]]]

[?def fn-doc-of pure [returns any] ($fn-docs::any $name::string)
  [?for [in $fd $fn-docs] [where [= $fd@name $name]] [yield $fd]]]

[?def param-help-of pure [returns any] ($fd::any $pname::string)
  [?for [in $pd $fd//param-doc] [where [= $pd@name $pname]] [yield [$text $pd]]]]

# command-defs — the [effects]-bearing defs named $verb. Clause PRESENCE is the
# discriminator (stream 6), zero-item included — never an item count, and never
# a name convention.
[?def command-defs pure [returns any] ($ast::map $verb::string)
  [$filter [?else $ast.defs []] [?fn ($d)
    [and [= $d.name $verb]
         [?match $d [case {effects: $e} true] [else false]]]]]]

# required-param — required = the non-defaulted POSITIONALS, exactly the rule
# the tools projection uses for its input schema, so the two faces of one
# command agree on what the caller must supply.
[?def required-param pure [returns bool] ($p::map)
  [and [= $p.kind "positional"] [not [$exists [?else $p.default ()]]]]]

# field-of — one param → one [ux:input]. Help text comes from [param-doc] when
# the author wrote one; the label always degrades to the name. `kind=` carries
# the DECLARED CX TYPE, not a control type: mapping a type to a control is a
# renderer's decision (`type="number"` on the web, a numeric line editor in a
# terminal), and the vocabulary states the fact, not the widget.
[?def field-of pure [returns any] ($p::map $fd::any)
  [?let [= $help [$param-help-of $fd $p.name]]
    [ux:input name=$p.name
      kind=[?else $p.type "string"]
      required=[?if [$required-param $p] [then "true"] [else "false"]]
      [?attr [?if [$exists $help] [then "help"] [else ()]] [$string [$first $help]]]]]]

# form-of-def — one command def + its [fn-doc] → the semantic form tree.
[?def form-of-def pure [returns any] ($d::map $fd::any $opts::map)
  [?let
    [= $title [?if [$exists $fd/summary]
                [then [$string $fd/summary]]
                [else [$label-of-name $d.name]]]]
    [= $named [$filter [?else $d.params []] [?fn ($q) [not [= $q.kind "rest"]]]]]
    [ux:form verb=$d.name
      [?attr [?if [$exists [?else $opts.affects ()]] [then "affects"] [else ()]] [$string [?else $opts.affects ""]]]
      [ux:heading level=2 $title]
      [?if [$exists [?else $opts.csrf ()]]
        [then [ux:hidden name=csrf-token value=[$string $opts.csrf]]]
        [else ()]]
      [?splice [?for [in $p $named] [yield [$field-of $p $fd]]]]
      [ux:submit label=[$label-of-name $d.name]]]]]

# form — THE entry point (P0-17's `[$ux:form $command]`). A command is named by
# (module source, qualified verb): the verb is the composition's command
# address — what `POST /intent/<verb>` dispatches on — and a def is not a
# first-class runtime handle, so the pair is how one is denoted (P0-2's third
# subject kind). Returns the SEMANTIC TREE; a renderer lowers it.
[?def form scope=public pure [returns any] ($source::string $verb::string $opts::map)
  [?let [= $raw [$cx:ast $source]]
    [?match $raw
      [case [err @code=$c] $raw]
      [else
        [?let
          [= $ast [$json:parse $raw]]
          [= $ds  [$command-defs $ast $verb]]
          [= $miss ([ux-refusal code=ux-no-such-command verb=$verb])]
          [?if [$exists $ds]
            [then [$form-of-def [$first $ds] [$first [$fn-doc-of [$fn-docs-of $ast] $verb]] $opts]]
            [else [err code=ux-refused $miss]]]]]]]]

# form-error — a command refusal rendered as a form error. Takes the refusal's
# OWN message, verbatim: the UX layer never restates a rule, never re-derives a
# message, and never decides whether something was allowed. What the command
# layer refused is what the user reads (P0-17).
#
# A string rather than the `[err]` value itself, because passing an err into a
# call PROPAGATES it — the caller matches the refusal (`[?match $r [case
# [err @code=$c @message=$m] …]]`) and hands the message over. The error CODE is
# deliberately not rendered: the message is what the command layer chose to
# disclose, and a code is structure the refused actor has no claim on.
[?def form-error scope=public pure [returns any] ($message::string)
  [ux:error [ux:text $message]]]

# committed — the other half of `form-error`, and owed by the same reasoning.
# A surface that shows a refusal loudly and a success silently teaches the
# operator that nothing they do works: the commit is the outcome they asked
# for, and it is the one the projection was told about. The message is the
# CALLER's, exactly as with a refusal — the UX layer does not compose prose
# about a command it does not own.
[?def committed scope=public pure [returns any] ($message::string)
  [ux:notice tone=ok [ux:text $message]]]

# ── §8 Hint claims (P0-4, P0-5, P0-6, P0-21) ────────────────────────────────
#
# Hints are Lane-2 DETACHED CLAIMS keyed by (schema content-address, CXPath) —
# never schema edits, because annotating a schema would mint a new schema
# identity (ruling 6) and orphan everything keyed to the old one. A claim is an
# ordinary content-addressed document; nothing about the projection knows where
# it was stored.
#
# W4 lands two of the five ruled hint types (Q-C): `order` and `view`. `group`,
# `format` and `show` are the same mechanism with different payloads.

# schema-address — the E2 content address of a DECLARED schema: sha2-256 over
# its strict canonical bytes (P0-2), tagged like every other address in the
# suite. Byte-identical to what `[$validate:register-schema]` binds, so a claim
# keyed this way resolves against the registry — names are hints, hashes are
# identity.
#
# IT TAKES A SCHEMA, NEVER A VALUE (RULED 1a). Deriving the address from a
# sample value was tried and is wrong: `[$cx:schema-of]` bakes INFERRED
# cardinality into the schema text, so an order with two line items and an
# order with one produce different addresses for the same shape, and a claim
# written against one silently stops applying to the other. Silently, because
# cosmetic claims fail open (P0-7) — the worst combination. Inference (#688)
# still produces the DEFAULT PROJECTION; it just cannot produce an identity.
[?def schema-address scope=public pure [returns string] ($schema::any)
  [$cx:hash $schema]]

# claim-key — THE composite string form (P0-4): the tagged address immediately
# followed by the CXPath. Unambiguous by construction, because the address
# grammar admits no `/` and every CXPath starts with one. A DERIVED SPELLING of
# the (address, path) pair — never a third identity.
[?def claim-key scope=public pure [returns string] ($addr::string $path::string)
  [$concat $addr $path]]

# hint-for — resolve one hint type for one keyed node. P0-6's precedence, at
# the depth W4 needs it: an exactly-pathed claim wins over a shorter one, so
# the LONGEST matching path is taken. Absence is a normal answer — the default
# projection applies and nothing is logged, because a missing cosmetic hint is
# not a defect (P0-7: cosmetics fail open).
[?def hint-for scope=public pure [returns any] ($hints::any $addr::string $path::string $type::string)
  [?let
    [= $matches [?for [in $h $hints]
                  [where [and [= [$string $h/schema] $addr]
                              [and [= [$string $h/path] $path]
                                   [$exists [$cx:select $h [$concat "@" $type]]]]]]
                  [yield $h]]]
    [?if [$exists $matches]
      [then [$string [$first [$cx:select [$first $matches] [$concat "@" $type]]]]]
      [else ()]]]]

# apply-order — the `order` hint (P0-21). Reorders columns to the claim's
# sequence.
#
# A NAMED COLUMN IS NEVER DROPPED. Columns the claim omits keep their derived
# order and follow the named ones, so a partial order is legal and a stale claim
# — one written against an older schema that has since gained a field — degrades
# to "the fields I named first, then the rest" rather than silently hiding data.
# A presentation claim must never be able to make a value disappear.
[?def apply-order pure [returns any] ($cols::any $order::any)
  [?if [not [$exists $order]]
    [then $cols]
    [else
      [?let
        [= $named [$strings:split-whitespace $order]]
        [= $carrier [ux-cols
                      [?for [in $n $named] [where [$has-str $cols $n]]        [yield [ux-col name=$n]]]
                      [?for [in $c $cols]  [where [not [$has-str $named $c]]] [yield [ux-col name=$c]]]]]
        [?for [in $x $carrier//ux-col] [yield [$string $x@name]]]]]]]

# ── §9 The XAP feature grammar as a projection subject (RULED, W5) ──────────
#
# P0-17 rules the subject as a `[?def]` whose `[effects]` clause is present —
# the agent-tools discriminator. The in-family reference estate does not define
# commands that way: its domain is XAP FEATURE DOCUMENTS, `[verb name=…
# effect=act]` over `[noun name=… [field …]]`. Two ruled clauses pointed at
# different command surfaces, and W5 could not project the reference app until
# this was ruled.
#
# The premise is one definition, three faces. If the estate's definitions are
# feature documents, the third face projects THOSE — otherwise the premise is
# not true where it actually matters.
#
# WHAT THIS GRAMMAR DOES NOT CARRY, AND IS THEREFORE NOT INVENTED HERE:
# optionality. A `[field]` declares a name, a type, and sometimes a doc — there
# is no required/optional marker. The `[?def]` lane derives required from
# non-defaulted positionals because that information EXISTS there. Marking
# fields required here would be a projection asserting a constraint the domain
# never stated.

[?def feature-verb pure [returns any] ($feature::any $verb::string)
  [?for [in $v $feature//verb] [where [= [$string $v@name] $verb]] [yield $v]]]

[?def feature-noun scope=public pure [returns any] ($feature::any $noun::string)
  [?for [in $n $feature//noun] [where [= [$string $n@name] $noun]] [yield $n]]]

# feature-field -- one declared field becomes one control, and WHICH control is
# read off the grammar rather than guessed:
#
#   type names another NOUN            -> a choice from that noun's rows
#   type names a noun AND repeats=true -> a repeating group of that noun
#   anything else                      -> a scalar input of the declared kind
#
# The first case is P0-17's ruled "reference-typed fields project ... against
# the referenced query", built at last. The projection derives the CONTROL from
# the grammar; the caller supplies the DATA, because only the caller can run
# the query — which is the same division `[$ux:table]` already uses.
# entered — what the operator typed, threaded back through the projection.
#
# A FORM THAT LOSES YOUR INPUT ON AN ERROR IS UNUSABLE, and it is the default
# outcome of the obvious design: the command refuses, the handler renders the
# refusal, and everything typed is gone. So a refusal re-projects the SAME
# form with the values still in it, which means the projection has to accept
# them — they are a render input, exactly like the terminal shell's edit
# overlay, and for the same reason.
[?def entered scope=public pure [returns string] ($opts::map $name::string $dflt::string)
  [?let [= $hits [?for [in $v [?else $opts.values ()]]
                   [where [= [$string $v@name] $name]] [yield [$string $v@text]]]]
    [?if [$absent $hits] [then $dflt] [else [$first $hits]]]]]

# field-error — the refusal that belongs to ONE control. A banner saying
# something is wrong makes the operator hunt; the message belongs next to the
# field it is about, and only the command layer knows which that is.
[?def field-error scope=public pure [returns string] ($opts::map $name::string)
  [?let [= $hits [?for [in $e [?else $opts.errors ()]]
                   [where [= [$string $e@name] $name]] [yield [$string $e@message]]]]
    [?if [$absent $hits] [then ""] [else [$first $hits]]]]]

[?def feature-field pure [returns any] ($f::any $feature::any $opts::map)
  [?let
    [= $t   [$str-or $f@type "text"]]
    [= $ref [$feature-noun $feature $t]]
    [= $nm  [$string $f@name]]
    [?if [$absent $ref]
      [then [ux:input [?attr "name" $nm]
                      [?attr "label" [$str-or $f@label [$label-of-name $nm]]]
                      [?attr "kind" $t]
                      [?attr "value" [$entered $opts $nm ""]]
                      [?attr [?if [= [$field-error $opts $nm] ""] [then ()] [else "error"]]
                             [$field-error $opts $nm]]
                      [?attr [?if [$exists $f@doc] [then "help"] [else ()]] [$string $f@doc]]]]
      [else
        [?if [= [$str-or $f@repeats "false"] "true"]
          [then [$repeating-group $f $ref $feature $opts]]
          [else [$reference-select $f $t $opts]]]]]]]

# reference-select -- the referenced noun's rows as options. An option list the
# caller did not supply yields a select with no options, which the shared gate
# does NOT refuse: an empty catalogue is a legitimate state of the world, and a
# projection that refused it would refuse a shop on its first day.
[?def reference-select scope=public pure [returns any] ($f::any $noun::string $opts::map)
  [?let [= $nm [$string $f@name]]
    [ux:select [?attr "name" $nm]
               [?attr "label" [$str-or $f@label [$label-of-name $nm]]]
               [?attr "required" "true"]
               [?attr "value" [$entered $opts $nm ""]]
               [?attr [?if [= [$field-error $opts $nm] ""] [then ()] [else "error"]]
                      [$field-error $opts $nm]]
               [?attr [?if [$exists $f@doc] [then "help"] [else ()]] [$string $f@doc]]
      [?splice [$options-for $opts $noun]]]]]

# options-for -- the caller's option sets, keyed by the noun they are for:
#   [options for=product [option value=ESC-18 label='Escapement (15.00)'] ...]
[?def options-for scope=public pure [returns any] ($opts::map $noun::string)
  [?let
    [= $sets [?for [in $o [?else $opts.options ()]]
               [where [= [$string $o@for] $noun]] [yield $o]]]
    [?if [$absent $sets]
      [then ()]
      [else
        [?for [in $o [$child-elements [$first $sets] "option"]]
          [yield [ux:option [?attr "value" [$string $o@value]] [$str-or $o@label [$string $o@value]]]]]]]]]

# repeating-group -- the nested WRITE case (RULED, owner 2026-08-17). One
# instance is projected here; the renderer is what lets an operator add more.
# `min` instances are rendered up front so the form is never empty of the thing
# it exists to collect.
[?def repeating-group scope=public pure [returns any] ($f::any $ref::any $feature::any $opts::map)
  [ux:group [?attr "name" [$string $f@name]]
            [?attr "repeat" "true"]
            [?attr [?if [$exists $f@doc] [then "help"] [else ()]] [$string $f@doc]]
            [?attr [?if [$exists [?else $opts.group-endpoint ()]] [then "affects"] [else ()]]
                   [$string [?else $opts.group-affects ""]]]
            [?attr "add-label" [$str-or $f@add-label "Add another"]]
    [?splice [?for [in $i [$instance-indices $opts [$string $f@name]]]
               [yield [$group-instance $f $ref $feature $opts $i]]]]]]

# instance-indices — WHICH instances to re-render, by their own index, not by
# how many there are.
#
# The difference matters the moment a line is removed. Drop the first of two
# and the survivor is `lines.1`; re-render "two instances" as 0 and 1 and the
# survivor's typed values are looked up under `lines.0`, find nothing, and come
# back blank. Indices are the instance's identity on the wire, so they are what
# is preserved. Gaps are harmless — the reader walks indices and skips the
# empty ones — and an unentered form has no values at all, which is the one
# case that mints a fresh index 0.
[?def instance-indices scope=public pure [returns any] ($opts::map $group::string)
  [?let
    [= $ix [$distinct [?for [in $v [?else $opts.values ()]]
                        [where [$starts-with [$string $v@name] [$concat $group "."]]]
                        [yield [$cast [$index-part [$string $v@name] [+ [$string-length $group] 1]] :int]]]]]
    [?if [$absent $ix] [then (0)] [else $ix]]]]

[?def index-part scope=public pure [returns string] ($s::string $n::int)
  [?if [<= [$string-length $s] $n]
    [then "0"]
    [else [$first [$strings:split [$substring $s [+ $n 1] [- [$string-length $s] $n]] "."]]]]]

# group-instance -- one instance of the repeated noun, with its controls named
# `<group>.<i>.<field>`. The index is not decoration: a form posts a flat
# key/value list, so two instances under a bare name collapse to one and the
# second line item silently disappears.
[?def group-instance scope=public pure [returns any] ($f::any $ref::any $feature::any $opts::map $i::int)
  [ux:card [?splice [$instance-fields $f $ref $feature $opts $i]]]]

[; FLAT, through a carrier. `[?splice [?for … [yield [?for …]]]]` flattens one
   level and leaves the inner `[?for]` results as SEQUENCE children — which walk
   fine in memory and vanish under `/*` the moment the tree crosses a wire
   (#847). The instance rendered locally and came back empty over HTTP, which
   is the same failure that cost this pack a day in W5. ]
[?def instance-fields pure [returns any] ($f::any $ref::any $feature::any $opts::map $i::int)
  [?let
    [= $c [ux-fs [?splice [?for [in $n $ref]
                            [yield [?for [in $sub [$child-elements $n "field"]]
                                     [yield [ux-f [$indexed-field $sub $feature $opts [$string $f@name] $i]]]]]]]]]
    [?for [in $w [$child-elements $c "ux-f"]] [yield [$first $w/*]]]]]

[?def indexed-field pure [returns any] ($sub::any $feature::any $opts::map $group::string $i::int)
  [?let
    [= $base [$feature-field $sub $feature $opts]]
    [= $nm   [$concat $group "." [$string $i] "." [$string $sub@name]]]
    [= $err [$field-error $opts $nm]]
    [?match [$name $base]
      [case "ux:select" [ux:select [?attr "name" $nm]
                                   [?attr "label" [$str-or $sub@label [$label-of-name [$string $sub@name]]]]
                                   [?attr "required" "true"]
                                   [?attr "value" [$entered $opts $nm ""]]
                                   [?attr [?if [= $err ""] [then ()] [else "error"]] $err]
                          [?splice [$child-elements $base "ux:option"]]]]
      [else [ux:input [?attr "name" $nm]
                      [?attr "label" [$str-or $sub@label [$label-of-name [$string $sub@name]]]]
                      [?attr "kind" [$str-or $sub@type "text"]]
                      [?attr "value" [$entered $opts $nm ""]]
                      [?attr [?if [= $err ""] [then ()] [else "error"]] $err]]]]]]

# feature-form — project an ACT verb onto a form. Fields come from the noun the
# verb `[writes]`; the `[summary]` titles it, degrading to a name-derived title
# exactly as the `[?def]` lane degrades (P0-17).
[?def feature-form scope=public pure [returns any] ($feature::any $verb::string $opts::map)
  [?let
    [= $vs [$feature-verb $feature $verb]]
    [= $miss ([ux-refusal code=ux-no-such-verb verb=$verb])]
    [?if [$exists $vs]
      [then [$feature-form-of [$first $vs] $feature $verb $opts]]
      [else [err code=ux-refused $miss]]]]]

# intent-params — the verb's OWN parameter list, when the grammar states one:
#
#   [verb name=place-order [intent [do :place-order [id] [customer]]] [writes order]]
#
# RULED (owner, 2026-08-17, DP1 4b). The projection used to derive form fields
# from the noun the verb `[writes]`, because `[intent [do :verb]]` carried no
# parameters — and that OVER-OFFERS: the reference estate's `place-order`
# accepts three slots where its `order` noun declares five, so the form showed
# two fields the runtime would ignore.
#
# The noun was the best inference available from feature documents alone, but
# it was an inference, and a verb whose real signature is only knowable from a
# client's component registration is not fully defined by its own grammar. So
# the grammar carries it, the projection reads it, and the noun remains the
# FALLBACK for a verb that has not declared one yet — degrading to the old
# behaviour rather than to an empty form.
[?def intent-params scope=public pure [returns any] ($v::any)
  [?let [= $intents [$child-elements $v "intent"]]
    [?if [$absent $intents]
      [then ()]
      [else
        [?let [= $do [$first-child [$first $intents] "do"]]
          [?if [$absent $do]
            [then ()]
            [else [?for [in $p $do/*] [yield [$name $p]]]]]]]]]]

# param-field — one declared intent parameter as a control. The grammar states
# a name; a type, when the written noun also declares that field, is taken from
# there rather than guessed, so `promised-at` still reaches the renderer as an
# instant.
[?def param-field pure [returns any] ($p::string $ns::any $feature::any $opts::map)
  [?let
    [= $decl [?for [in $n $ns] [yield [?for [in $f [$child-elements $n "field"]]
                                        [where [= [$string $f@name] $p]] [yield $f]]]]]
    [= $c [ux-fs [?splice [?for [in $d $decl] [yield [ux-f $d]]]]]]
    [= $hits [$child-elements $c "ux-f"]]
    [?if [$absent $hits]
      [then [ux:input [?attr "name" $p] [?attr "kind" "text"]]]
      [else [?let [= $w [$first $hits]] [$feature-field [$first $w/*] $feature $opts]]]]]]

[?def feature-form-of pure [returns any] ($v::any $feature::any $verb::string $opts::map)
  [?let
    [= $wname [$string [$first $v/writes]]]
    [= $ns    [$feature-noun $feature $wname]]
    [= $ps    [$intent-params $v]]
    [= $title [?if [$exists $v/summary]
                [then [$string [$first $v/summary]]]
                [else [$label-of-name $verb]]]]
    [ux:form verb=$verb
      [?attr [?if [$exists [?else $opts.affects ()]] [then "affects"] [else ()]] [$string [?else $opts.affects ""]]]
      [; `heading: "none"` — the composition has already framed this form with
         its own heading, so the verb summary would be a second title in
         heading clothes (W22 audit, finding F11). The summary is not lost:
         it is the verb's own words and the composition can write them as
         prose where it wants them. ]
      [?splice [?if [= [$string [?else $opts.heading "shown"]] "none"]
                 [then ()]
                 [else ([ux:heading level=2 $title])]]]
      [; the landing the intent's plain-wire 303 falls to, when the composition
         states one — the same `return` convention `ux:action` params already
         ride (the csrf-token idiom above, applied to navigation). Without it a
         degraded POST falls to the wire's default landing, which is how W22's
         audit found set-address dropping customers on the basket. ]
      [?splice [?if [$exists [?else $opts.return ()]]
                 [then ([ux:hidden name=return value=[$string $opts.return]])]
                 [else ()]]]
      [?splice [?if [$absent $ps]
                 [then [$noun-fields $ns $feature $opts]]
                 [else [?for [in $p $ps] [yield [$param-field [$string $p] $ns $feature $opts]]]]]]
      [ux:submit label=[$label-of-name $verb]]]]]

# noun-fields — a noun's `[field …]` children, projected and FLAT.
#
# `$n/field` is not used, deliberately: a named child step atomizes on a single
# match, so a noun with exactly one field would hand back the field's TEXT
# instead of the element — and the reference estate has such nouns.
[?def noun-fields pure [returns any] ($ns::any $feature::any $opts::map)
  [?let [= $c [ux-fields
                [?for [in $n $ns]
                  [yield [?for [in $f [$child-elements $n "field"]]
                           [yield [ux-f [$feature-field $f $feature $opts]]]]]]]]
    [?for [in $w $c//ux-f] [yield [$first $w/*]]]]]

# feature-columns — a noun's fields as column names, for the OBSERVE side. The
# declaration order is the domain author's order, so unlike the inferred-schema
# lane there is nothing alphabetical to correct with an `order` hint.
#
# The result NESTS ONE LEVEL: `[?for]` in an element body yields one
# sequence-valued child per outer iteration (§4's seq-child convention), and a
# noun name matches at most one noun, so the shape is one inner sequence. A
# caller wanting the flat list reads it back through a carrier — which is also
# what makes an absent noun read as absence rather than as an empty string.
# ── §9.5 Card projection: a noun + a route-level card spec → a card (W10) ───
#
# THE THING W6 COULD NOT DO. A product card is not a table row and not a form:
# it is a depiction, a name, two or three declared values, and A WAY TO BUY THE
# THING (P0-86). Every one of those is derived — the label and the help from
# the noun's own `[field …]` declaration, the format from a hint claim, the
# action's parameters from the row's declared key — so a card cannot drift from
# the domain the way a hand-written one does.
#
# WHAT IS IN THE SPEC AND WHAT IS IN THE DOMAIN, kept apart on purpose. The
# NOUN says what a product has. The SURFACE's `[card …]` spec says which of
# those a card shows, in what order, and what acting on it means — route-level
# picks, deliberately unshared, exactly where P0-24 puts them. Neither document
# says what a card looks like; that is the renderers', and they disagree about
# it on purpose.
#
#   [card noun=product key=sku detail="/p"
#         media=art alt=alt title=name subtitle=brand
#         shows="price rating promise" stock=stock
#         action=add-to-basket action-label="Add to basket" affects="/shell/basket"]
[?def feature-card scope=public pure [returns any] ($feature::any $spec::any $row::any $opts::map)
  [?let
    [= $noun  [$str-or $spec@noun ""]]
    [= $ns    [$feature-noun $feature $noun]]
    [= $key   [$str-or $spec@key ""]]
    [= $kv    [$row-attr $row $key]]
    [= $shows [?if [= [$str-or $spec@shows ""] ""] [then ()]
                [else [$strings:split [$string $spec@shows] " "]]]]
    [ux:card [?attr "id" [$concat $noun "-" $kv]]
      [?splice [$card-media $spec $row]]
      [?splice [$card-title $spec $row $kv]]
      [?splice [$card-subtitle $spec $row]]
      [; a card states what it knows: a field the row carries no value for is
         dropped, not rendered as a labelled blank (W22 audit — an unreviewed
         product wore an empty Rating row on every card). ]
      [?splice [?for [in $f $shows]
                 [where [not [= [$row-attr $row [$string $f]] ""]]]
                 [yield [$noun-field-view $ns $f $row $opts]]]]
      [?splice [$card-buy $spec $row $kv $opts]]]]]

[?def row-attr scope=public pure [returns string] ($row::any $name::string)
  [?if [= $name ""] [then ""]
    [else [?let [= $v [$cx:select $row [$concat "@" $name]]]
            [?if [$exists $v] [then [$string [$first $v]]] [else ""]]]]]]

[?def card-media pure [returns any] ($spec::any $row::any)
  [?if [= [$str-or $spec@media ""] ""]
    [then ()]
    [else ([ux:media [?attr "src" [$row-attr $row [$string $spec@media]]]
                     [?attr "alt" [$row-attr $row [$str-or $spec@alt ""]]]
                     [?attr "kind" "illustration"]])]]]

[; the title is the DRILL-DOWN, which needed no new member in W5 and needs none
   now: it is an ordinary link to the row's own route (P0-87 — a SKU is a URL). ]
[?def card-title pure [returns any] ($spec::any $row::any $kv::string)
  [?let [= $t [$row-attr $row [$str-or $spec@title ""]]]
    [?if [= $t ""]
      [then ()]
      [else ([ux:heading [?attr "level" "3"]
               [?if [= [$str-or $spec@detail ""] ""]
                 [then $t]
                 [else [ux:link [?attr "href" [$concat [$string $spec@detail] "/" $kv]]
                                [?attr "label" $t]]]]])]]]]

[?def card-subtitle pure [returns any] ($spec::any $row::any)
  [?let [= $t [$row-attr $row [$str-or $spec@subtitle ""]]]
    [?if [= $t ""] [then ()] [else ([ux:text $t])]]]]

[; OUT OF STOCK IS A STATE OF THE BUY CONTROL, NEVER A HIDDEN PRODUCT (P0-91).
   Hiding it means a customer who searched for it by name concludes the store
   does not sell it. Until W15 the card swapped the control for a badge; P0-99
   ruled the stronger form: THE CONTROL KEEPS ITS PLACE AND ITS LABEL, states
   `available=false`, and says why — the badge told you the fact, the inert
   control tells you the fact AND that the act exists and will return. This
   is P0-99's live consumer, in the shared projection so both faces get it
   from one place. ]
[?def card-buy pure [returns any] ($spec::any $row::any $kv::string $opts::map)
  [?if [= [$str-or $spec@action ""] ""]
    [then ()]
    [else
      [?let [= $stock [$row-attr $row [$str-or $spec@stock ""]]]
        [?if [= $stock "0"]
          [then ([ux:action [?attr "verb" [$string $spec@action]]
                            [?attr "label" [$str-or $spec@action-label "Add"]]
                            [?attr "available" "false"]
                            [?attr "reason" "Out of stock"]
                            [?attr "affects" [$str-or $spec@affects ""]]
                    [ux:param [?attr "name" [$str-or $spec@key "id"]] [?attr "value" $kv]]
                    [ux:param [?attr "name" "qty"] [?attr "value" "1"]]
                    [ux:param [?attr "name" "rendered-at"] [?attr "value" [$cx:hash $row]]]
                    [?splice [$return-param $opts]]])]
          [; R5 (W20): the address of the ROW the control was projected
             from rides along, so the command can VERIFY what was on screen
             rather than compare one field of it (DP2 letter f3). ]
          [else ([ux:action [?attr "verb" [$string $spec@action]]
                            [?attr "label" [$str-or $spec@action-label "Add"]]
                            [?attr "prominence" "primary"]
                            [?attr "affects" [$str-or $spec@affects ""]]
                    [ux:param [?attr "name" [$str-or $spec@key "id"]] [?attr "value" $kv]]
                    [ux:param [?attr "name" "qty"] [?attr "value" "1"]]
                    [ux:param [?attr "name" "rendered-at"] [?attr "value" [$cx:hash $row]]]
                    [; WHERE THE CUSTOMER IS, POSTED AS A PARAMETER. The answer
                       to an act has to name the state it affects — the badge on
                       THIS page for a fragment swap, THIS URL for the 303 — and
                       P0-82 says the client holds nothing the server cannot
                       reconstruct. Deriving it at projection time makes it a
                       fact about what was rendered, which is exactly what
                       every other `[ux:param]` is. ]
                    [?splice [$return-param $opts]]])]]]]]]

[?def return-param pure [returns any] ($opts::map)
  [?let [= $r [$str-or [?else $opts.return ()] ""]]
    [?if [= $r ""] [then ()]
      [else ([ux:param [?attr "name" "return"] [?attr "value" $r]])]]]]

# noun-field-view — ONE declared field, projected as a labelled value. The
# label comes from the field's own declaration (or is derived from its name);
# the FORMAT comes from a hint claim keyed by (noun-declaration address, path),
# which is why money is money everywhere it appears rather than everywhere
# somebody remembered.
[?def noun-field-view scope=public pure [returns any] ($ns::any $fname::string $row::any $opts::map)
  [?let
    [= $fd  [?for [in $f $ns//field] [where [= [$string $f@name] $fname]] [yield $f]]]
    [= $lbl [?if [$found $fd]
              [then [?let [= $f0 [$first $fd]] [$str-or $f0@label [$label-of-name $fname]]]]
              [else [$label-of-name $fname]]]]
    [= $fmt [$hint-for [?else $opts.hints ()] [$str-or [?else $opts.addr ()] ""]
                       [$concat "/" $fname] "format"]]
    [= $cur [$row-attr $row [$str-or [?else $opts.currency ()] "currency"]]]
    [ux:field [?attr "label" $lbl]
              [?attr [?if [$exists $fmt] [then "format"] [else ()]] [$str-or $fmt ""]]
              [?attr [?if [$exists $fmt] [then "currency"] [else ()]] [?if [= $cur ""] [then "USD"] [else $cur]]]
      [$row-attr $row $fname]]]]

# feature-fields — every declared field of a noun, projected. The detail page's
# specification block: the noun says what a product HAS, so a product that
# gains an attribute gains a row here and nowhere else.
[?def feature-fields scope=public pure [returns any] ($feature::any $noun::string $row::any $skip::any $opts::map)
  [?let
    [= $ns [$feature-noun $feature $noun]]
    [?for [in $f $ns//field]
      [where [and [not [$has-str $skip [$string $f@name]]]
                  [not [= [$row-attr $row [$string $f@name]] ""]]]]
      [yield [$noun-field-view $ns [$string $f@name] $row $opts]]]]]

[?def feature-columns scope=public pure [returns any] ($feature::any $noun::string)
  [?let
    [= $ns [$feature-noun $feature $noun]]
    [= $c [ux-cols [?for [in $n $ns]
                     [yield [?for [in $f [$child-elements $n "field"]]
                              [yield [ux-col name=[$string $f@name]]]]]]]]
    [?for [in $x $c//ux-col] [yield [$string $x@name]]]]]

# ── §10 Table projection: a query's rows → a semantic table (P0-17, P0-10) ──
#
# The second projection entry point. Columns derive from the ROW SCHEMA — the
# shape-inference lane (#688), read through `[$cx:schema-of]` — so a table
# needs no column list, no field registry, and nothing that could drift from
# the data it renders.
#
# ROW KEYS ARE DECLARED, NEVER GUESSED (P0-10). An `id` attribute is not
# treated as identity because it is spelled `id`: that would be a naming
# convention masquerading as a keying rule, and it would silently mint
# addresses for rows whose `id` is incidental. A collection with no declared
# key gets NO per-row addresses — the enclosing fragment becomes the smallest
# addressable unit and updates repaint the region, honestly.
#
# Declarations are elements rather than map entries because CX has no dynamic
# map lookup, and because a `[row-type name=… key=… schema=…]` reads as what it
# is: a statement about a row type, not a rendering option.

# table — THE entry point (P0-17's `[$ux:table $query]`). `$rows` is the
# query's result sequence; `$opts` carries the id and the key declarations.
# An empty result projects an empty table rather than inventing copy about
# emptiness — what to say when there is nothing to say is the surface's call.
[?def table scope=public pure [returns any] ($rows::any $opts::map)
  [?if [$exists $rows]
    [then [$table-of [$first $rows] $rows $opts]]
    [; AN EMPTY COLLECTION STILL OWNS ITS CONTAINER. Returning a bare
       `[ux:table]` was tidy and wrong: the row container is what a live insert
       appends into and what a filter replaces, so a table that has no rows YET
       is exactly the table those need to address. A shop on its first morning
       would otherwise refuse its own order book. ]
    [else
      [ux:table
        [?attr [?if [$absent [?else $opts.id ()]] [then ()] [else "id"]] [$string [?else $opts.id ""]]]
        [ux:rows [?attr "id" [$rows-container-step]]
          [?attr [?if [$absent [?else $opts.live ()]] [then ()] [else "live"]]
                 [$str-or [?else $opts.live ()] ""]]]]]]]

# rows-container-step — the element-path step the row container takes inside a
# placed table. It exists so a live patch has a REAL ADDRESS to append into:
# a `[ux:rows]` with no id is unaddressable, and W4b's feed ops fell back to
# wiping the whole region for want of one.
[?def rows-container-step scope=public pure [returns string] () "rows"]

# rows-container-path — the container path for a table placed at $path.
[?def rows-container-path scope=public pure [returns string] ($table-path::string)
  [$path-step $table-path [$rows-container-step]]]

[?def table-of pure [returns any] ($first-row::any $rows::any $opts::map)
  [?let
    [= $rowname [$name $first-row]]
    [; The inferred schema is only consulted when the caller has NOT declared
       its columns. That is not just an optimization: `[$cx:schema-of]` refuses
       a corpus whose items are not element-rooted, and a XAP fold slice is one
       such shape — so deriving it unconditionally made a declared-column table
       fail on exactly the estate the projection exists to serve. ]
    [= $declared [?else $opts.columns ()]]
    [= $schema  [?if [$absent $declared]
                  [then [$cx:parse [$cx:schema-of $first-row]]]
                  [else [schema]]]]
    [; The claim subject is the DECLARED schema address, never one inferred
       from this row (RULED 1a). No declaration means no claims resolve and the
       default projection applies — fail open, as cosmetics must. ]
    [= $decl    [$schema-for $opts $rowname]]
    [= $addr    [?if [$exists $decl] [then [$first $decl]] [else ""]]]
    [= $hints   [?else $opts.hints ()]]
    [; Columns come from the DOMAIN when the caller has one. The inferred row
       schema is the default because a query result is all a table projection
       usually has; but the XAP feature grammar DECLARES its fields, and a
       declared field list beats an inferred one — it carries the author's
       order, and it does not vary with which rows happen to be present. ]
    [= $derived [?if [$absent $declared]
                  [then [$row-columns $schema $rowname]]
                  [else $declared]]]
    [= $cols    [$apply-order $derived [$hint-for $hints $addr "/" "order"]]]
    [= $nested  [?if [$absent $declared] [then [$row-collections $schema $rowname]] [else ()]]]
    [?if [= [?else [$hint-for $hints $addr "/" "view"] "table"] "cards"]
      [then [$cards-of $rows $cols $nested $opts]]
      [else
        [ux:table
          [?attr [?if [$exists [?else $opts.id ()]] [then "id"] [else ()]] [$string [?else $opts.id ""]]]
          [ux:columns
            [?splice [?for [in $c $cols]   [yield [ux:column [$label-of-name $c]]]]]
            [?splice [?for [in $n $nested] [yield [ux:column [$label-of-name $n]]]]]]
          [ux:rows [?attr "id" [$rows-container-step]]
            [; THE FEED CONNECTS AT THE REGION AND SWAPS AT THE COLLECTION.
               A patch aimed at a table has to arrive in a table parse context:
               a bare `<tr>` parsed as a standalone fragment loses its wrapper
               by the HTML spec, and the cells land as siblings of the rows.
               Naming the collection as the swap target means the payload is
               parsed as the container's contents, which is the one context
               where `<tr>` survives. ]
            [?attr [?if [$absent [?else $opts.live ()]] [then ()] [else "live"]]
                   [$str-or [?else $opts.live ()] ""]]
            [?splice [?for [in $r $rows]
                       [yield [$row-of $r $cols $nested
                                {id: [?else $opts.id ()], types: [?else $opts.types ()],
                                 hints: $hints, addr: $addr,
                                 detail-route: [?else $opts.detail-route ()]}]]]]]]]]]]

# cards-of — the `view=cards` presentation (P0-21). Each row becomes a card of
# LABELLED fields, which is what makes it the right answer for a nested
# collection: a table repeats its header in every containing cell, whereas
# cards carry their labels per value and read cleanly inside a row. W3 surfaced
# that rough edge; this is the hint that answers it, without the emitter
# guessing on the author's behalf.
[?def cards-of pure [returns any] ($rows::any $cols::any $nested::any $opts::map)
  [ux:list
    [?attr [?if [$exists [?else $opts.id ()]] [then "id"] [else ()]] [$string [?else $opts.id ""]]]
    [?splice [?for [in $r $rows] [yield [$card-of $r $cols $nested $opts]]]]]]

[?def card-of pure [returns any] ($r::any $cols::any $nested::any $opts::map)
  [?let
    [= $ka [$key-for $opts [$name $r]]]
    [= $kv [?if [$exists $ka] [then [$cell-text $r [$first $ka]]] [else ()]]]
    [ux:item
      [ux:card
        [?attr [?if [$exists $kv] [then "id"] [else ()]] [?if [$exists $kv] [then $kv] [else ""]]]
        [?splice [?for [in $c $cols]
                   [yield [ux:field label=[$label-of-name $c] [$cell-text $r $c]]]]]
        [?splice [?for [in $n $nested] [yield [$nested-view $r $n $opts]]]]]]]]

# row-columns — the row type's SCALAR attributes, in the schema's order. The
# schema is derived from the data, so a column exists because a value does.
[?def row-columns scope=public pure [returns any] ($schema::any $rowname::string)
  [?for [in $a [$cx:select $schema [$concat "//" $rowname "/attr"]]]
    [yield [$first [$strings:split [$strings:trim [$string $a]] "::"]]]]]

# row-collections — the row type's child COLLECTIONS: the nested case. Each
# becomes one further column whose cells hold a nested table.
[?def row-collections pure [returns any] ($schema::any $rowname::string)
  [?for [in $e [$cx:select $schema [$concat "//" $rowname "/elem"]]]
    [yield [$first [$strings:split [$string $e] " "]]]]]

# ── row-type declarations ───────────────────────────────────────────────────
#
# ONE declaration per row type, carrying both what the projection cannot infer:
#
#   [row-type name=order key=id schema=sha2-256:…]
#
#   key=    the DECLARED row key (P0-10). Absent → unkeyed rows, no per-row
#           addresses, honestly.
#   schema= the DECLARED E2 schema address the hint claims key against (P0-2,
#           RULED 1a). Absent → no claims resolve for this row type, and the
#           default projection applies — cosmetics fail open (P0-7).

[?def row-type-decl pure [returns any] ($opts::map $rowname::string)
  [?for [in $t [?else $opts.types ()]]
    [where [= [$string $t@name] $rowname]]
    [yield $t]]]

# key-for — the DECLARED key attribute for one row type, or absence.
[?def key-for scope=public pure [returns any] ($opts::map $rowname::string)
  [?for [in $t [$row-type-decl $opts $rowname]]
    [where [$exists $t@key]]
    [yield [$string $t@key]]]]

# schema-for — the DECLARED schema address for one row type, or absence.
[?def schema-for pure [returns any] ($opts::map $rowname::string)
  [?for [in $t [$row-type-decl $opts $rowname]]
    [where [$exists $t@schema]]
    [yield [$string $t@schema]]]]

# -- the `format` hint (P0-21's third ruled type) ----------------------------
#
# W3 recorded the rough edge and W4 did not answer it: "status renders as raw
# text where the hand-authored version had tone badges. Nothing tells the
# projection that a value is an enum with tones." Nothing did, because a
# derived schema knows `status` is a string and cannot know it is a state with
# meanings. That is exactly what a CLAIM is for.
#
#   [ux:hint format=badge tones='late:danger on-time:ok picking:warn'
#            [schema sha2-256:...] [path /status]]
#
# The tone map is part of the claim rather than inferred, because which state
# is bad is a domain judgement -- `late` is danger in a fulfilment console and
# unremarkable in an archive. A value with no mapping renders `neutral` rather
# than refusing: a claim that has fallen behind an enum must degrade, not break
# the page (P0-7, cosmetics fail open).
[?def format-for scope=public pure [returns any] ($hints::any $addr::string $col::string)
  [$hint-for $hints $addr [$concat "/" $col] "format"]]

[?def tone-for pure [returns string] ($hints::any $addr::string $col::string $v::string)
  [?let
    [= $map [$hint-for $hints $addr [$concat "/" $col] "tones"]]
    [?if [$absent $map]
      [then "neutral"]
      [else
        [?let [= $hits [?for [in $pair [$strings:split-whitespace [$string $map]]]
                         [= $kv [$strings:split [$string $pair] ":"]]
                         [where [= [$first $kv] $v]]
                         [yield [$nth $kv 2]]]]
          [?if [$absent $hits] [then "neutral"] [else [$string [$first $hits]]]]]]]]]

# formatted-cell -- the value, shaped by whatever the claim asked for.
[?def formatted-cell pure [returns any] ($v::string $hints::any $addr::string $col::string)
  [?let [= $f [$format-for $hints $addr $col]]
    [?if [$absent $f]
      [then $v]
      [else
        [?match [$string $f]
          [case "badge" [ux:badge [?attr "tone" [$tone-for $hints $addr $col $v]] $v]]
          [else $v]]]]]]

[?def row-of pure [returns any] ($r::any $cols::any $nested::any $opts::map)
  [?let
    [= $ka  [$key-for $opts [$name $r]]]
    [= $kv  [?if [$exists $ka] [then [$cell-text $r [$first $ka]]] [else ()]]]
    [ux:row
      [?attr [?if [$exists $kv] [then "key"] [else ()]] [?if [$exists $kv] [then $kv] [else ""]]]
      [?splice [?for [in $c $cols]   [yield [$cell-of $r $c $ka $kv $opts]]]]
      [?splice [?for [in $n $nested] [yield [$nested-cell $r $n $opts]]]]]]]

# cell-of — DRILL-DOWN, and why it needed no new vocabulary member. When the
# projection is told a detail route, the KEY column's cell carries an ordinary
# `[ux:link]` to `<detail-route>/<key>`. The web renderer makes it an anchor;
# the terminal renderer activates it on Enter over the focused row. Navigation
# was already in the vocabulary — only the affordance differs, which is exactly
# where two renderers SHOULD differ.
#
# Only the key column, and only when a key is declared: a row with no identity
# has nothing to drill into, and inventing a positional detail URL would repeat
# the mistake P0-10 forbids one level up.
[?def cell-of pure [returns any] ($r::any $c::string $ka::any $kv::any $opts::map)
  [?let
    [= $detail [?else $opts.detail-route ()]]
    [= $txt    [$cell-text $r $c]]
    [?if [and [$exists $detail] [and [$exists $kv] [and [$exists $ka] [= $c [$first $ka]]]]]
      [then [ux:cell [ux:link href=[$concat [$string $detail] "/" [$string $kv]] $txt]]]
      [else [ux:cell [$formatted-cell $txt [?else $opts.hints ()] [?else $opts.addr ""] $c]]]]]]

# cell-text — one attribute's value as text. The canonical scalar printer does
# the formatting, so a decimal renders with the precision it was stored at
# rather than through a float.
[; A row carries its fields as ATTRIBUTES (a query result) or as CHILD
   ELEMENTS (a XAP fold slice). Both are legitimate row shapes and the
   projection should not require one — so the attribute is tried first and the
   child element second, and a row that has neither reads as empty rather than
   refusing. Nothing here guesses which shape it was handed. ]
[?def cell-text scope=public pure [returns string] ($r::any $attr::string)
  [?let [= $v [$cx:select $r [$concat "@" $attr]]]
    [?if [$exists $v]
      [then [$string [$first $v]]]
      [else
        [?let [= $k [$child-elements $r $attr]]
          [?if [$absent $k] [then ""] [else [$string [$first $k]]]]]]]]]

# nested-cell — THE hard case, deliberately faced in W3 rather than deferred:
# a collection inside a row. The default renders it as a nested table, because
# that is the only option that shows the data without inventing a
# summarization policy — a count discards what the reader came for, and
# dropping the column is worse. Whether that default is USABLE at zero
# overrides is exactly what the R6 gauntlet measures, so it is stated plainly
# here and judged there rather than being hedged.
#
# The nested table is given the COLLECTION NAME as its id, so it contributes
# that name as an element-path step (P0-16). Two different collections in one
# row therefore address distinctly, and — with the containing row extending the
# path — a line in one order can never share an address with an identically-keyed
# line in another. It must NOT inherit the parent table's id: that would put
# the same DOM id on every nested table on the page.
[?def nested-view pure [returns any] ($r::any $n::string $opts::map)
  [$table [$cx:select $r [$concat "/" $n "/*"]]
          {types: [?else $opts.types ()], hints: [?else $opts.hints ()], id: $n}]]

[?def nested-cell pure [returns any] ($r::any $n::string $opts::map)
  [ux:cell [$nested-view $r $n $opts]]]

# ── §11 Liveness: ∂ frames → SEMANTIC PATCH OPERATIONS (P0-44) ──────────────
#
# A UX feed is a live-modes SUBSCRIPTION — there is no `[?feed]` directive to
# invent. `[$live:observe]` over a quoted planar comprehension yields ∂ frames,
# and this section lowers those frames onto FRAGMENT ADDRESSES: the keyed row
# identities W1 minted and W3 taught to compose.
#
# W4b lowered them straight onto htmx `hx-swap-oob` values — `beforeend:#id`,
# `delete`, `innerHTML:#id` — which put htmx swap syntax, CSS selectors and
# all, inside the value a feed publishes. A terminal renderer would have had to
# parse it. So the ∂ frames now lower onto a SEMANTIC PATCH ALGEBRA over keyed
# collections, and each renderer lowers THAT:
#
#   [ux:op kind=insert  container=<path> [ux:row key=… …]]   a new row arrives
#   [ux:op kind=update  container=<path> [ux:row key=… …]]   a row re-renders
#   [ux:op kind=remove  container=<path> key=…]              a row leaves
#   [ux:op kind=repaint container=<path> [ux:rows …]]        the set is replaced
#
# The container is an ELEMENT PATH, not a DOM id: the web renderer derives the
# id from it exactly as it derived the id it first rendered, so the two cannot
# drift, and the terminal renderer resolves the same path in its own tree.
#
# UNKEYED COLLECTIONS COLLAPSE EVERY FRAME TO A REPAINT (P0-10). Not a
# limitation being worked around — the honest consequence of having no per-row
# identity. Without a declared key there is no address to target, and inventing
# a positional one would break on the first insertion.
#
# `retract` carries only a POSITION, never the row. Recovering which fragment to
# remove therefore needs the CURRENT row list — the projection's last-known
# ordering for that subscription — which is why `feed-ops` takes it. A frame
# alone is not self-describing, and pretending otherwise would delete the wrong
# row after any concurrent change.

# feed-ops — one ∂ script + the rows it applies to → the semantic patch
# operations that realize it.
[?def feed-ops scope=public pure [returns any] ($frames::any $rows::any $ctx::map $opts::map)
  [?let
    [; Each op is wrapped so the carrier can be read back FLAT: a bare [?for]
       yields one sequence-valued child. ]
    [= $carrier [ux-ops [?for [in $fr $frames] [yield [ux-op [$feed-op $fr $rows $ctx $opts]]]]]]
    [?for [in $w $carrier//ux-op] [where [$exists $w/*]] [yield [$first $w/*]]]]]

[?def feed-op pure [returns any] ($fr::any $rows::any $ctx::map $opts::map)
  [?let
    [= $kind [$name $fr]]
    [= $keyed [$exists [$key-for $opts [$row-name-of $rows]]]]
    [?if [not $keyed]
      [; No declared key → no row addresses exist, so every frame becomes a
         repaint of the collection. Stated once, here. ]
      [then [$repaint-op $rows $ctx $opts]]
      [else
        [?match $kind
          [case "insert"    [$row-op $fr $rows $ctx $opts "insert"]]
          [case "regroup"   [$row-op $fr $rows $ctx $opts "update"]]
          [case "retract"   [$retract-op $fr $rows $ctx $opts]]
          [case "recompute" [$repaint-op $rows $ctx $opts]]
          [else ()]]]]]]

# container-of — the collection container's element path. `opts.container` is
# an element PATH; absent, it defaults to the container inside the region the
# context addresses, which is what `table` places.
[?def container-of pure [returns string] ($ctx::map $opts::map)
  [?if [$exists [?else $opts.container ()]]
    [then [$string $opts.container]]
    [else [$rows-container-path [?else $ctx.path "/"]]]]]

# row-op — insert / update both carry the row, so the fragment is rendered
# fresh from it.
[; The guard tests the NODE-SET, not the element taken from it: `[$exists]` is
   false for a single element returned by `[$first]`/`[$nth]`, so guarding the
   result instead of the set silently drops every frame that carries a row. ]
[?def row-op pure [returns any] ($fr::any $rows::any $ctx::map $opts::map $kind::string)
  [?if [$exists $fr/*]
    [then [ux:op [?attr "kind" $kind] [?attr "container" [$container-of $ctx $opts]]
            [$row-fragment [$first $fr/*] $opts]]]
    [else ()]]]

# retract-op — the frame gives a POSITION; the key comes from the row that
# currently occupies it. An out-of-range position means the caller's row list
# and the ∂ stream have diverged, which is a repaint, not a guess.
[; ∂ positions are 0-based; `[$nth]` is 1-based. The bound is checked by COUNT
   rather than by testing the retrieved element, for the same reason as above. ]
[?def retract-op pure [returns any] ($fr::any $rows::any $ctx::map $opts::map)
  [?let [= $p [$cast $fr@pos :int]]
    [?if [and [>= $p 0] [< $p [$count $rows]]]
      [then
        [?let
          [= $row [$nth $rows [+ $p 1]] ]
          [= $ka  [$key-for $opts [$name $row]]]
          [ux:op kind=remove
            [?attr "container" [$container-of $ctx $opts]]
            [?attr "key" [?if [$exists $ka] [then [$cell-text $row [$first $ka]]] [else ""]]]]]]
      [else [$repaint-op $rows $ctx $opts]]]]]

# repaint-op — the honest fallback, and now a USEFUL one: it carries the
# collection's current rows, so a renderer can replace the set rather than
# blank the region. W4b's repaint emitted an EMPTY region with an innerHTML
# OOB swap, which would have wiped the very region it meant to refresh; the
# demo hid that by publishing a separately-rendered region and dropping the op
# on the floor. An op nobody could use was the tell.
[?def repaint-op pure [returns any] ($rows::any $ctx::map $opts::map)
  [ux:op kind=repaint
    [?attr "container" [$container-of $ctx $opts]]
    [ux:rows [?attr "id" [$rows-container-step]]
      [?splice [?for [in $r $rows] [yield [$row-fragment $r $opts]]]]]]]

# row-fragment — one keyed row as a semantic row element, columns derived from
# its own shape exactly as the first render derived them.
[?def row-fragment pure [returns any] ($row::any $opts::map)
  [?let
    [= $ka [$key-for $opts [$name $row]]]
    [= $kv [?if [$exists $ka] [then [$cell-text $row [$first $ka]]] [else ()]]]
    [= $schema [$cx:parse [$cx:schema-of $row]]]
    [= $cols   [$row-columns $schema [$name $row]]]
    [ux:row [?attr [?if [$exists $kv] [then "key"] [else ()]] [?if [$exists $kv] [then $kv] [else ""]]]
      [?splice [?for [in $c $cols] [yield [ux:cell [$cell-text $row $c]]]]]]]]

[?def row-name-of pure [returns string] ($rows::any)
  [?if [$exists $rows] [then [$name [$first $rows]]] [else ""]]]

# feed — the live region itself (P0-44). It names a LOGICAL FEED; the endpoint
# and the event name live in the render context (§3), so the same region
# declaration reaches a browser (one SSE connection per page, never polling)
# and a terminal (one held-open `http:sse-connect`, likewise never polling)
# without either transport being spelled in the tree.
[; op-replace — THE PATCH ALGEBRA, GENERALISED FROM ROWS TO ANY ADDRESSED
   ELEMENT (P0-83). W4b's algebra was keyed-collection-only because the only
   live thing was a table; a basket badge is an addressed element that is not a
   row, and P0-44 already says the operations are `insert / update / remove /
   repaint` over an element PATH rather than over a table. So `replace` is the
   same algebra reaching the case it always described.
   Each renderer lowers it for itself: the browser gets an out-of-band swap,
   and a terminal — which repaints from a re-read rather than patching a
   document — treats it as the instruction to re-read. That asymmetry is not a
   gap; it is what "lowered by each renderer for itself" means. ]
[?def op-replace scope=public pure [returns element] ($path::string $el::any)
  [ux:op [?attr "kind" "replace"] [?attr "container" $path] $el]]

[?def feed scope=public pure [returns any] ($feature::string $path::string $name::string $body::any)
  [ux:region [?attr "feature" $feature] [?attr "path" $path] [?attr "live" $name]
    [?splice $body]]]

# ── §12 The surface document and its routing (P0-24, P0-25) ─────────────────
#
# `[surface …]` is a DOCUMENT: diffable, reviewable, deployed by store put
# (P0-24, renamed from ruling 8's `[app …]` per C4). Hand-authoring one plus
# projection defaults is a complete working path with no studio — R1, the
# bootstrap guarantee.
#
# Routing LOWERS onto shipped machinery (P0-25): `[route …]` entries become
# `[?http-service]` `[resource]` routes with `:name` path params, over the
# hosted web binding. The surface document is composition data; this module
# introduces NO second router — `[resource]` tables are static program by
# construction (the directive collects program literals, not values), so the
# lowering is a stated, checkable correspondence rather than a dispatcher.

# routes-of — the surface document's route table as data.
[?def routes-of scope=public pure [returns any] ($surface::element)
  [?for [in $r $surface/route]
    [yield [ux:route
             [path [$string $r@path]]
             [feature [$string $r/feature@xap]]
             [instance [?if [$exists $r/feature@as] [then [$string $r/feature@as]] [else [$string $r/feature@xap]]]]
             [template [?if [$exists $r@template] [then [$string $r@template]] [else "default"]]]]]]]

# duplicate-instances — composing the same feature twice on one route without
# distinct instance names is a COMPOSE-TIME REFUSAL (P0-9): no silent ordinals,
# no first-wins, because the instance name is an identity input to every
# fragment address on that route.
[?def duplicate-instances scope=public pure [returns any] ($surface::element)
  [?let
    [= $rs [$routes-of $surface]]
    [= $c [ux-refusals
            [?for [in $a $rs]
              [where [> [$count [?for [in $b $rs]
                                  [where [and [= [$string $a/path] [$string $b/path]]
                                              [= [$string $a/instance] [$string $b/instance]]]]
                                  [yield $b]]] 1]]
              [yield [ux-refusal code=ux-duplicate-instance
                       path=[$string $a/path] instance=[$string $a/instance]]]]]]
    [$distinct $c//ux-refusal]]]

# service-refusals — the lowering check (P0-25): the `[resource]` paths a
# surface's `[?http-service]` actually registers MUST be exactly the surface
# document's route paths. A route with no resource is an unreachable page; a
# resource with no route is a page outside the composition — both are refusals,
# so the hand-written service and the surface document cannot drift.

# fragment-paths — the FRAGMENT endpoints a route declares. A filter control
# (`ux:filter`) narrows a collection by fetching just that collection back, so
# a surface needs endpoints that are not pages. Declaring them under their
# route keeps them inside the correspondence check rather than exempt from it:
#
#   [route /orders [feature xap=orders] [fragment path=/orders/rows]]
#
# Exempting fragment endpoints would have been the easy move and the wrong
# one — an unrouted fragment endpoint is exactly as much a page outside the
# composition as an unrouted page is.
[?def fragment-paths scope=public pure [returns any] ($surface::element)
  [?for [in $f $surface//fragment] [yield [$string $f@path]]]]

[?def service-refusals scope=public pure [returns any] ($surface::element $served::any)
  [?let
    [= $paths [?let [= $c [ux-paths
                            [?for [in $r [$routes-of $surface]] [yield [ux-p v=[$string $r/path]]]]
                            [?for [in $p [$fragment-paths $surface]] [yield [ux-p v=[$string $p]]]]]]
                [?for [in $x $c//ux-p] [yield [$string $x@v]]]]]
    [$joined
      [?for [in $p $paths]
        [where [not [$has-str $served $p]]]
        [yield [ux-refusal code=ux-route-unserved path=$p]]]
      [?for [in $p $served]
        [where [not [$has-str $paths [$string $p]]]]
        [yield [ux-refusal code=ux-resource-unrouted path=[$string $p]]]]]]]

# surface-verb-refusals — the static half of verb coverage, AT COMPOSE TIME
# (W16-b, DP4 letter e ruled in): every act verb the composed features declare
# is offered by some route or declared not-offered WITH A WHY, or the surface
# refuses to compose. Two decisions this spelling carries deliberately:
#
#   - the features are a REQUIRED argument of the gate, so "the checker had no
#     feature documents" is a wrong call, not a new refusal code — a gate that
#     can be handed nothing to check and politely pass is the silent family
#     this whole phase exists to close;
#   - a [not-offered] with no why= does NOT account for its verb. A reasoned
#     absence is a state the surface can be held to; an unreasoned one is the
#     hole with a label on it. The refusal stays the RULED code
#     (ux-verb-unaccounted) and names the sharper cause in a note, because
#     "declared without a reason" is a WAY of being unaccounted, not a second
#     kind of refusal.
#
# The driven walker (drive 29/30) remains the state-dependent instrument; this
# is its state-independent half, priced at compose time.
[?def surface-verb-refusals scope=public pure [returns any] ($surface::element $features::any)
  [?let
    [= $offers [?for [in $o $surface//offer] [yield [$string $o@verb]]]]
    [= $whys   [?for [in $n $surface//not-offered]
                 [where [not [= [$str-or $n@why ""] ""]]]
                 [yield [$string $n@verb]]]]
    [= $bare   [?for [in $n $surface//not-offered]
                 [where [= [$str-or $n@why ""] ""]]
                 [yield [$string $n@verb]]]]
    [= $box [uvr [?splice [?for [in $f $features]
                            [yield [uv [?splice [$verbs-unaccounted $f $offers $whys]]]]]]]]
    [?for [in $r $box//ux-refusal]
      [yield [?if [$exists [?for [in $b $bare] [where [= $b [$string $r@verb]]] [yield $b]]]
               [then [ux-refusal code=ux-verb-unaccounted verb=[$string $r@verb]
                                 note="declared not-offered without a why"]]
               [else $r]]]]]]

# check-surface — the compose-time gate over a surface document, the resource
# paths its service registers, and the feature documents it composes. The
# features are the third leg because W16-b made verb accounting part of
# composing at all: a surface built from no feature documents passes an empty
# sequence and states, in its own call, that it asserts nothing about verbs.
[?def check-surface scope=public pure [returns any] ($surface::element $served::any $features::any)
  [?let [= $bad [$joined [$duplicate-instances $surface]
                  [$joined [$service-refusals $surface $served]
                           [$surface-verb-refusals $surface $features]]]]
    [?if [$exists $bad] [then [err code=ux-refused $bad]] [else true]]]]

# ── §13 Layout commands: the studio's emission surface (P0-105…P0-108, W26) ──
#
# The five layout commands — `[ux:move]`, `[ux:wrap]`, `[ux:set-hint]`,
# `[ux:place]`, `[ux:remove]` — applied to a LAYOUT DOCUMENT: the
# arrangement-as-data subtree of a surface document (P0-24), shaped
#
#   [ux:layout
#     [placed id=hero component=hero]
#     [placed id=rail component=group [hint name=density value=compact]
#       [placed id=promo component=promo]]]
#
# A `[placed]` element carries exactly (id, component) as attributes; its
# SURFACE-LEVEL hints (P0-107) are `[hint name= value=]` children, and its
# placed children follow them. Hints ride children rather than attributes so
# the rebuild is total: a set-hint can add a hint the element never carried,
# and CX element construction cannot splice a dynamic attribute list.
#
# EVERYTHING HERE IS PURE. Applying a command is a pure function of
# (layout, command, component registry) — the journal entry, the actor stamp
# and the SSE publish are the caller's (the serving boundary's), which is what
# makes every refusal class a fixture rather than a server test. The refusal
# semantics are the ruled ones:
#
#   P0-26  an element a command does not address is UNTOUCHED (the transforms
#          below are structural surgery on the addressed node, never rebuilds
#          from a client's view — which is why a lensed editor cannot delete
#          what its lens withheld);
#   P0-27  batches are atomic: one journal entry, all-or-nothing;
#   P0-28  an address miss REFUSES (ux-layout-address-miss), never a no-op;
#   P0-29  validity is judged against the FULL document, server-side: a cycle
#          (ux-layout-cycle), a non-container parent (ux-layout-not-container),
#          an incoherent position (ux-layout-bad-position);
#   P0-105 a place/wrap id already present refuses (ux-layout-id-collision);
#          a component no cascade level binds refuses
#          (ux-layout-unknown-component);
#   P0-106 remove takes the addressed element's OWN subtree with it.
#
# The component registry is a sequence of `[component name=… container=…]`
# declarations — the caller resolves it through the cascade (P0-14) and hands
# the resolution in, because the registry is a document and this module does
# not read documents.

[?def placed-kids pure [returns any] ($el::any)
  [$child-elements $el "placed"]]

[?def hint-kids pure [returns any] ($el::any)
  [$child-elements $el "hint"]]

[?def param-kids pure [returns any] ($el::any)
  [$child-elements $el "param"]]

# layout-find — the [placed] element carrying this id, anywhere in the tree,
# or absence. Ids are unique per document (P0-16; place enforces it), so the
# first hit is the only hit.
[?def layout-find scope=public pure [returns any] ($layout::any $id::string)
  [?let [= $hits [?for [in $p $layout//placed]
                   [where [= [$str-or $p@id ""] $id]] [yield $p]]]
    [?if [$absent $hits] [then ()] [else [$first $hits]]]]]

[?def layout-has pure [returns bool] ($layout::any $id::string)
  [$found [?for [in $p $layout//placed]
            [where [= [$str-or $p@id ""] $id]] [yield $p]]]]

# layout-ids — every placed id in the document, document order.
[?def layout-ids scope=public pure [returns any] ($layout::any)
  [?for [in $p $layout//placed] [yield [$str-or $p@id ""]]]]

# layout-parent-id — the id of the placed element holding $id; "" means it
# sits at the layout root.
[?def layout-parent-id scope=public pure [returns string] ($layout::any $id::string)
  [?let [= $hits [?for [in $p $layout//placed]
                   [where [$exists [?for [in $k [$placed-kids $p]]
                                     [where [= [$str-or $k@id ""] $id]] [yield $k]]]]
                   [yield [$str-or $p@id ""]]]]
    [?if [$absent $hits] [then ""] [else [$first $hits]]]]]

[?def layout-siblings pure [returns any] ($layout::any $id::string)
  [?let [= $pid [$layout-parent-id $layout $id]]
    [?if [= $pid ""]
      [then [$placed-kids $layout]]
      [else [$placed-kids [$layout-find $layout $pid]]]]]]

# layout-successor — the id of the placed sibling FOLLOWING $id, or "" when it
# is the last. This is what makes the inverse-pair table (P0-108) computable:
# "put it back" is "insert before what used to follow it".
[?def layout-successor scope=public pure [returns string] ($layout::any $id::string)
  [?let
    [= $sibs [$layout-siblings $layout $id]]
    [= $n    [$count $sibs]]
    [?if [<= $n 1]
      [then ""]
      [else
        [?let [= $hits [?for [in $i [$range 1 [- $n 1]]]
                         [= $s [$nth $sibs $i]]
                         [where [= [$str-or $s@id ""] $id]]
                         [= $nx [$nth $sibs [+ $i 1]]]
                         [yield [$str-or $nx@id ""]]]]
          [?if [$absent $hits] [then ""] [else [$first $hits]]]]]]]]

# layout-hint — the SURFACE-LEVEL value of one hint on one placed element, or
# "" when the element does not carry it (the inherited resolution applies —
# P0-107). Also the prior value the set-hint inverse restores.
[?def layout-hint scope=public pure [returns string] ($layout::any $id::string $hint::string)
  [?let [= $t [$layout-find $layout $id]]
    [?if [$absent $t]
      [then ""]
      [else [?let [= $hits [?for [in $h [$hint-kids $t]]
                             [where [= [$str-or $h@name ""] $hint]]
                             [yield [$str-or $h@value ""]]]]
              [?if [$absent $hits] [then ""] [else [$first $hits]]]]]]]]

# layout-param — the value of one content param on one placed element, or ""
# when the element carries none (the registry default applies — P0-111). The
# prior the set-param inverse restores.
[?def layout-param scope=public pure [returns string] ($layout::any $id::string $param::string)
  [?let [= $t [$layout-find $layout $id]]
    [?if [not [$found $t]]
      [then ""]
      [else [?let [= $hits [?for [in $h [$param-kids $t]]
                             [where [= [$str-or $h@name ""] $param]]
                             [yield [$str-or $h@value ""]]]]
              [?if [$absent $hits] [then ""] [else [$first $hits]]]]]]]]

# ── the component registry reads ─────────────────────────────────────────────

[?def component-decl pure [returns any] ($components::any $name::string)
  [?for [in $c $components] [where [= [$str-or $c@name ""] $name]] [yield $c]]]

[?def component-known scope=public pure [returns bool] ($components::any $name::string)
  [$exists [$component-decl $components $name]]]

[?def component-container scope=public pure [returns bool] ($components::any $name::string)
  [?let [= $hits [$component-decl $components $name]]
    [?if [$absent $hits]
      [then false]
      [else [?let [= $c0 [$first $hits]]
              [= [$str-or $c0@container "false"] "true"]]]]]]

# component-params — the [param name= default= carrier=] declarations of one
# registry entry (P0-113): the component's editable content surface.
[?def component-params scope=public pure [returns any] ($components::any $name::string)
  [?let [= $hits [$component-decl $components $name]]
    [?if [$absent $hits]
      [then ()]
      [else [$child-elements [$first $hits] "param"]]]]]

[?def component-param-declared pure [returns bool] ($components::any $name::string $param::string)
  [$found [?for [in $d [$component-params $components $name]]
            [where [= [$str-or $d@name ""] $param]] [yield $d]]]]

# component-variants — the [variant name= options=…] axes of one entry
# (P0-113): closed option sets the studio offers as pickers; a variant write
# is an ordinary surface-level hint (P0-107).
[?def component-variants scope=public pure [returns any] ($components::any $name::string)
  [?let [= $hits [$component-decl $components $name]]
    [?if [$absent $hits]
      [then ()]
      [else [$child-elements [$first $hits] "variant"]]]]]

# component-accepts — WHAT A CONTAINER MAY HOLD (P0-113). A container that
# accepts anything produces invalid trees the moment an editor guesses: a card
# inside a nav's list is the live case that taught this (the owner placed a
# search box in the menu and got garbage, because nothing said no). Absent
# `accepts=` on a container means "anything"; an empty accepts= means nothing.
[?def component-accepts scope=public pure [returns any] ($components::any $name::string)
  [?let [= $hits [$component-decl $components $name]]
    [?if [$absent $hits]
      [then ()]
      [else [?let [= $c0 [$first $hits]]
              [?if [$exists $c0@accepts]
                [then [$strings:split-whitespace [$string $c0@accepts]]]
                [else ()]]]]]]]

[?def component-declares-accepts pure [returns bool] ($components::any $name::string)
  [?let [= $hits [$component-decl $components $name]]
    [?if [$absent $hits]
      [then false]
      [else [?let [= $c0 [$first $hits]] [$exists $c0@accepts]]]]]]

# accepts-refusal — the child's component must be one the parent accepts.
# Root placement ("" parent) is the page level and is not gated here.
[?def accepts-refusal pure [returns any] ($components::any $parent-comp::string $child-comp::string $id::string)
  [?if [not [$component-declares-accepts $components $parent-comp]]
    [then ()]
    [else [?if [$has-str [$component-accepts $components $parent-comp] $child-comp]
            [then ()]
            [else ([ux-refusal code=ux-layout-not-accepted id=$id
                     parent=$parent-comp child=$child-comp])]]]]]

# component-fixed — load-bearing chrome: restylable (hints, variants, params)
# but never moved, removed or wrapped (P0-113 declaring what is NOT editable
# — e.g. an element other controls' affects= targets name).
[?def component-fixed scope=public pure [returns bool] ($components::any $name::string)
  [?let [= $hits [$component-decl $components $name]]
    [?if [$absent $hits]
      [then false]
      [else [?let [= $c0 [$first $hits]]
              [= [$str-or $c0@fixed "false"] "true"]]]]]]

[?def fixed-refusal pure [returns any] ($layout::any $id::string $components::any)
  [?let [= $t [$layout-find $layout $id]]
    [?if [and [$found $t] [$component-fixed $components [$str-or $t@component ""]]]
      [then ([ux-refusal code=ux-layout-fixed id=$id])]
      [else ()]]]]

# ── the structural surgery (pure rebuilds) ──────────────────────────────────
#
# Each transform rebuilds the tree touching ONLY the addressed node — P0-26 by
# construction: an element the walk does not address is copied through with
# its hints, its children and their order intact.

[?def placed-node pure [returns any] ($id::string $component::string $hints::any $params::any $kids::any)
  [placed [?attr "id" $id] [?attr "component" $component]
    [?splice $hints]
    [?splice $params]
    [?splice $kids]]]

# layout-strip — the tree WITHOUT the placed element $id. The subtree goes
# with it (P0-106: children of a removed element are its content).
[?def layout-strip pure [returns any] ($el::any $id::string)
  [?if [= [$name $el] "ux:layout"]
    [then [ux:layout [?splice [$strip-kids $el $id]]]]
    [else [$placed-node [$str-or $el@id ""] [$str-or $el@component ""]
            [$hint-kids $el] [$param-kids $el] [$strip-kids $el $id]]]]]

[?def strip-kids pure [returns any] ($el::any $id::string)
  [?for [in $k [$placed-kids $el]]
    [where [not [= [$str-or $k@id ""] $id]]]
    [yield [$layout-strip $k $id]]]]

# insert-kids — one child list with $node inserted before $before ("" = end).
# Carrier-flattened, because a [?for] cannot yield two siblings directly.
[?def insert-kids pure [returns any] ($kids::any $node::any $before::string)
  [?let [= $c [ux-lks
                [?splice [?for [in $k $kids]
                           [yield [?if [and [not [= $before ""]]
                                           [= [$str-or $k@id ""] $before]]
                                    [then [ux-lkp [ux-lk $node] [ux-lk $k]]]
                                    [else [ux-lk $k]]]]]]
                [?splice [?if [= $before ""] [then ([ux-lk $node])] [else ()]]]]]
    [?for [in $w $c//ux-lk] [yield [$first $w/*]]]]]

# layout-insert — $node inserted under $parent ("" = the root), before
# $before ("" = at the end). The caller has already validated the position.
[?def layout-insert pure [returns any] ($el::any $node::any $parent::string $before::string)
  [?let
    [= $isroot [= [$name $el] "ux:layout"]]
    [= $match  [?if $isroot
                 [then [= $parent ""]]
                 [else [= [$str-or $el@id ""] $parent]]]]
    [= $kids0  [?for [in $k [$placed-kids $el]]
                 [yield [$layout-insert $k $node $parent $before]]]]
    [= $kids   [?if $match [then [$insert-kids $kids0 $node $before]] [else $kids0]]]
    [?if $isroot
      [then [ux:layout [?splice $kids]]]
      [else [$placed-node [$str-or $el@id ""] [$str-or $el@component ""]
              [$hint-kids $el] [$param-kids $el] $kids]]]]]

# layout-set-hint-tree — the tree with one surface-level hint set (or cleared,
# value="") on the addressed element. The replaced hint's slot moves to the
# end of the hint list — deterministic under the command sequence, which is
# what the journal replays.
[?def hints-with pure [returns any] ($hints::any $hint::string $value::string)
  [?let [= $c [ux-lks
                [?splice [?for [in $h $hints]
                           [where [not [= [$str-or $h@name ""] $hint]]]
                           [yield [ux-lk $h]]]]
                [?splice [?if [= $value ""]
                           [then ()]
                           [else ([ux-lk [hint [?attr "name" $hint] [?attr "value" $value]]])]]]]]
    [?for [in $w $c//ux-lk] [yield [$first $w/*]]]]]

[?def layout-set-hint-tree pure [returns any] ($el::any $id::string $hint::string $value::string)
  [?if [= [$name $el] "ux:layout"]
    [then [ux:layout [?splice [?for [in $k [$placed-kids $el]]
                                [yield [$layout-set-hint-tree $k $id $hint $value]]]]]]
    [else
      [?let
        [= $me    [= [$str-or $el@id ""] $id]]
        [= $hints [?if $me
                    [then [$hints-with [$hint-kids $el] $hint $value]]
                    [else [$hint-kids $el]]]]
        [$placed-node [$str-or $el@id ""] [$str-or $el@component ""] $hints
          [$param-kids $el]
          [?for [in $k [$placed-kids $el]]
            [yield [$layout-set-hint-tree $k $id $hint $value]]]]]]]]

# layout-set-param-tree — the set-hint transform's twin over [param] children
# (P0-111): value="" clears back to the registry default.
[?def layout-set-param-tree pure [returns any] ($el::any $id::string $param::string $value::string)
  [?if [= [$name $el] "ux:layout"]
    [then [ux:layout [?splice [?for [in $k [$placed-kids $el]]
                                [yield [$layout-set-param-tree $k $id $param $value]]]]]]
    [else
      [?let
        [= $me     [= [$str-or $el@id ""] $id]]
        [= $params [?if $me
                     [then [$params-with [$param-kids $el] $param $value]]
                     [else [$param-kids $el]]]]
        [$placed-node [$str-or $el@id ""] [$str-or $el@component ""]
          [$hint-kids $el] $params
          [?for [in $k [$placed-kids $el]]
            [yield [$layout-set-param-tree $k $id $param $value]]]]]]]]

[?def params-with pure [returns any] ($params::any $param::string $value::string)
  [?let [= $c [ux-lks
                [?splice [?for [in $h $params]
                           [where [not [= [$str-or $h@name ""] $param]]]
                           [yield [ux-lk $h]]]]
                [?splice [?if [= $value ""]
                           [then ()]
                           [else ([ux-lk [param [?attr "name" $param] [?attr "value" $value]]])]]]]]
    [?for [in $w $c//ux-lk] [yield [$first $w/*]]]]]

# ── the refusal gate (P0-28/P0-29/P0-105/P0-106) ────────────────────────────

# parent-ok — parent exists (or is the root) and is a container.
[?def parent-refusals pure [returns any] ($layout::any $parent::string $components::any)
  [?if [= $parent ""]
    [then ()]
    [else [?if [not [$layout-has $layout $parent]]
            [then ([ux-refusal code=ux-layout-address-miss id=$parent])]
            [else [?let [= $p [$layout-find $layout $parent]]
                    [?if [$component-container $components [$str-or $p@component ""]]
                      [then ()]
                      [else ([ux-refusal code=ux-layout-not-container id=$parent])]]]]]]]]

# position-refusals — before, when named, must exist AND sit under the named
# parent (an incoherent position is a P0-29 validity refusal, judged against
# the full document).
[?def position-refusals pure [returns any] ($layout::any $parent::string $before::string)
  [?if [= $before ""]
    [then ()]
    [else [?if [not [$layout-has $layout $before]]
            [then ([ux-refusal code=ux-layout-address-miss id=$before])]
            [else [?if [= [$layout-parent-id $layout $before] $parent]
                    [then ()]
                    [else ([ux-refusal code=ux-layout-bad-position id=$before parent=$parent])]]]]]]]

[?def layout-refusals scope=public pure [returns any] ($layout::any $cmd::any $components::any)
  [?let [= $k [$name $cmd]] [= $id [$str-or $cmd@id ""]]
    [?if [= $k "ux:move"]     [then [$move-refusals $layout $cmd $id $components]]
    [else [?if [= $k "ux:wrap"]     [then [$wrap-refusals $layout $cmd $id $components]]
    [else [?if [= $k "ux:set-hint"] [then [$sethint-refusals $layout $cmd $id]]
    [else [?if [= $k "ux:place"]    [then [$place-refusals $layout $cmd $id $components]]
    [else [?if [= $k "ux:set-param"] [then [$setparam-refusals $layout $cmd $id $components]]
    [else [?if [= $k "ux:remove"]
      [then [?if [$layout-has $layout $id]
              [then [$fixed-refusal $layout $id $components]]
              [else ([ux-refusal code=ux-layout-address-miss id=$id])]]]
    [else ([ux-refusal code=ux-layout-unknown-command command=$k])]]]]]]]]]]]]]]

[?def move-refusals pure [returns any] ($layout::any $cmd::any $id::string $components::any)
  [?if [not [$layout-has $layout $id]]
    [then ([ux-refusal code=ux-layout-address-miss id=$id])]
    [else
      [?let
        [= $parent [$str-or $cmd@parent ""]]
        [= $before [$str-or $cmd@before ""]]
        [= $t      [$layout-find $layout $id]]
        [; a parent inside the moved element's own subtree — or the element
           itself — is a cycle (P0-29); a before inside it would strand the
           insertion in the detached subtree, same class. ]
        [= $pcycle [or [= $parent $id]
                       [and [not [= $parent ""]] [$layout-has $t $parent]]]]
        [= $bcycle [or [= $before $id]
                       [and [not [= $before ""]] [$layout-has $t $before]]]]
        [= $mycomp [$str-or $t@component ""]]
        [= $acc [?if [= $parent ""]
                  [then ()]
                  [else [?let [= $pel [$layout-find $layout $parent]]
                          [?if [$found $pel]
                            [then [$accepts-refusal $components [$str-or $pel@component ""] $mycomp $id]]
                            [else ()]]]]]]
        [= $pr [?if $pcycle
                 [then ([ux-refusal code=ux-layout-cycle id=$id parent=$parent])]
                 [else [$joined $acc [$parent-refusals $layout $parent $components]]]]]
        [= $br [?if $bcycle
                 [then ([ux-refusal code=ux-layout-cycle id=$id before=$before])]
                 [else [$position-refusals $layout $parent $before]]]]
        [$joined [$fixed-refusal $layout $id $components]
                 [$joined $pr $br]]]]]]

[?def wrap-refusals pure [returns any] ($layout::any $cmd::any $id::string $components::any)
  [?let
    [= $w [$str-or $cmd@wrapper ""]]
    [= $c [$str-or $cmd@component ""]]
    [$joined
      [?if [$layout-has $layout $id]
        [then [$fixed-refusal $layout $id $components]]
        [else ([ux-refusal code=ux-layout-address-miss id=$id])]]
      [$joined
        [?if [= $w ""]
          [then ([ux-refusal code=ux-layout-bad-command command="ux:wrap"])]
          [else [?if [$layout-has $layout $w]
                  [then ([ux-refusal code=ux-layout-id-collision id=$w])]
                  [else ()]]]]
        [?if [not [$component-known $components $c]]
          [then ([ux-refusal code=ux-layout-unknown-component component=$c])]
          [else [?if [$component-container $components $c]
                  [then ()]
                  [else ([ux-refusal code=ux-layout-not-container component=$c])]]]]]]]]

[; P0-111: a param the component's registry entry does not declare refuses —
   the registry IS the closed editing surface (P0-113). ]
[?def setparam-refusals pure [returns any] ($layout::any $cmd::any $id::string $components::any)
  [?if [not [$layout-has $layout $id]]
    [then ([ux-refusal code=ux-layout-address-miss id=$id])]
    [else
      [?let
        [= $pn   [$str-or $cmd@param ""]]
        [= $t    [$layout-find $layout $id]]
        [= $comp [$str-or $t@component ""]]
        [?if [= $pn ""]
          [then ([ux-refusal code=ux-layout-bad-command command="ux:set-param"])]
          [else [?if [$component-param-declared $components $comp $pn]
                  [then ()]
                  [else ([ux-refusal code=ux-layout-unknown-param id=$id param=$pn])]]]]]]]]

[?def sethint-refusals pure [returns any] ($layout::any $cmd::any $id::string)
  [$joined
    [?if [$layout-has $layout $id]
      [then ()]
      [else ([ux-refusal code=ux-layout-address-miss id=$id])]]
    [?if [= [$str-or $cmd@hint ""] ""]
      [then ([ux-refusal code=ux-layout-bad-command command="ux:set-hint"])]
      [else ()]]]]

[?def place-refusals pure [returns any] ($layout::any $cmd::any $id::string $components::any)
  [?let
    [= $c      [$str-or $cmd@component ""]]
    [= $parent [$str-or $cmd@parent ""]]
    [= $before [$str-or $cmd@before ""]]
    [$joined
      [?if [= $id ""]
        [then ([ux-refusal code=ux-layout-bad-command command="ux:place"])]
        [else [?if [$layout-has $layout $id]
                [then ([ux-refusal code=ux-layout-id-collision id=$id])]
                [else ()]]]]
      [$joined
        [?if [$component-known $components $c]
          [then ()]
          [else ([ux-refusal code=ux-layout-unknown-component component=$c])]]
        [$joined
          [?if [= $parent ""]
            [then ()]
            [else [?let [= $pel [$layout-find $layout $parent]]
                    [?if [$found $pel]
                      [then [$accepts-refusal $components [$str-or $pel@component ""] $c $id]]
                      [else ()]]]]]
          [$joined
            [$parent-refusals $layout $parent $components]
            [$position-refusals $layout $parent $before]]]]]]]

# ── apply ───────────────────────────────────────────────────────────────────

# layout-apply — ONE command against the FULL document (P0-29: never against a
# lens projection). Returns the amended layout, or one [err] naming every
# refusal. The caller journals, stamps and publishes; this stays pure.
[?def layout-apply scope=public pure [returns any] ($layout::any $cmd::any $components::any)
  [?let [= $bad [$layout-refusals $layout $cmd $components]]
    [?if [$exists $bad]
      [then [err code=ux-refused $bad]]
      [else [$layout-apply-ok $layout $cmd]]]]]

[?def apply-move pure [returns any] ($layout::any $cmd::any $id::string)
  [?let [= $t [$layout-find $layout $id]]
    [$layout-insert [$layout-strip $layout $id] $t
      [$str-or $cmd@parent ""] [$str-or $cmd@before ""]]]]

[?def apply-wrap pure [returns any] ($layout::any $cmd::any $id::string)
  [?let
    [= $t [$layout-find $layout $id]]
    [= $p [$layout-parent-id $layout $id]]
    [= $s [$layout-successor $layout $id]]
    [= $w [$placed-node [$str-or $cmd@wrapper ""] [$str-or $cmd@component ""] () () ($t)]]
    [$layout-insert [$layout-strip $layout $id] $w $p $s]]]

[?def layout-apply-ok pure [returns any] ($layout::any $cmd::any)
  [?let [= $k [$name $cmd]] [= $id [$str-or $cmd@id ""]]
    [?if [= $k "ux:move"]
      [then [$apply-move $layout $cmd $id]]
      [else [?if [= $k "ux:wrap"]
        [then [$apply-wrap $layout $cmd $id]]
        [else [?if [= $k "ux:set-hint"]
          [then [$layout-set-hint-tree $layout $id
                  [$str-or $cmd@hint ""] [$str-or $cmd@value ""]]]
          [else [?if [= $k "ux:set-param"]
            [then [$layout-set-param-tree $layout $id
                    [$str-or $cmd@param ""] [$str-or $cmd@value ""]]]
          [else [?if [= $k "ux:place"]
            [then [$layout-insert $layout
                    [$placed-node $id [$str-or $cmd@component ""] () () ()]
                    [$str-or $cmd@parent ""] [$str-or $cmd@before ""]]]
            [else [$layout-strip $layout $id]]]]]]]]]]]]]

# layout-apply-batch — a P0-27 batch: atomic, all-or-nothing, one journal
# entry at the boundary. The first refusal refuses the WHOLE batch.
[?def layout-apply-batch scope=public pure [returns any] ($layout::any $cmds::any $components::any)
  [?if [$absent $cmds]
    [then $layout]
    [else
      [?let [= $r [$layout-apply $layout [$first $cmds] $components]]
        [?match $r
          [case [err @code=$c] $r]
          [else [$layout-apply-batch $r [$tail $cmds] $components]]]]]]]

# ── the inverse-pair table (P0-108) ─────────────────────────────────────────
#
# Computed against the PRE-state — the state the client was rendered with.
# Answers a SEQUENCE of commands: one for move/set-hint/place, a P0-27 batch
# for wrap (move the child back, THEN remove the empty wrapper — in that
# order, because remove takes its subtree) and for remove (the places and
# set-hints that reconstruct the removed subtree in place).
[?def layout-inverse scope=public pure [returns any] ($layout::any $cmd::any)
  [?let [= $k [$name $cmd]] [= $id [$str-or $cmd@id ""]]
    [?if [= $k "ux:move"]
      [then ([ux:move [?attr "id" $id]
               [?attr "parent" [$layout-parent-id $layout $id]]
               [?attr "before" [$layout-successor $layout $id]]])]
      [else [?if [= $k "ux:set-hint"]
        [then ([ux:set-hint [?attr "id" $id]
                 [?attr "hint" [$str-or $cmd@hint ""]]
                 [?attr "value" [$layout-hint $layout $id [$str-or $cmd@hint ""]]]])]
        [else [?if [= $k "ux:set-param"]
          [then ([ux:set-param [?attr "id" $id]
                   [?attr "param" [$str-or $cmd@param ""]]
                   [?attr "value" [$layout-param $layout $id [$str-or $cmd@param ""]]]])]
        [else [?if [= $k "ux:place"]
          [then ([ux:remove [?attr "id" $id]])]
          [else [?if [= $k "ux:wrap"]
            [then ([ux:move [?attr "id" $id]
                     [?attr "parent" [$layout-parent-id $layout $id]]
                     [?attr "before" [$str-or $cmd@wrapper ""]]],
                   [ux:remove [?attr "id" [$str-or $cmd@wrapper ""]]])]
            [else [?if [= $k "ux:remove"]
              [then [$reconstruct-places $layout $id]]
              [else ()]]]]]]]]]]]]]]

[?def reconstruct-places pure [returns any] ($layout::any $id::string)
  [?let
    [= $t [$layout-find $layout $id]]
    [= $p [$layout-parent-id $layout $id]]
    [= $s [$layout-successor $layout $id]]
    [; `found`, not `absent`: [$absent] counts ELEMENT CHILDREN (#849), so a
       childless placed element would read as missing and its remove-inverse
       would silently reconstruct nothing. ]
    [?if [$found $t] [then [$reconstruct-node $t $p $s]] [else ()]]]]

[?def reconstruct-node pure [returns any] ($t::any $parent::string $before::string)
  [?let [= $c [ux-lks
                [ux-lk [ux:place [?attr "id" [$str-or $t@id ""]]
                         [?attr "component" [$str-or $t@component ""]]
                         [?attr "parent" $parent]
                         [?attr "before" $before]]]
                [?splice [?for [in $h [$hint-kids $t]]
                           [yield [ux-lk [ux:set-hint [?attr "id" [$str-or $t@id ""]]
                                           [?attr "hint" [$str-or $h@name ""]]
                                           [?attr "value" [$str-or $h@value ""]]]]]]]
                [?splice [?for [in $h [$param-kids $t]]
                           [yield [ux-lk [ux:set-param [?attr "id" [$str-or $t@id ""]]
                                           [?attr "param" [$str-or $h@name ""]]
                                           [?attr "value" [$str-or $h@value ""]]]]]]]
                [?splice [?for [in $k [$placed-kids $t]]
                           [yield [$reconstruct-carrier $k [$str-or $t@id ""]]]]]]]
    [?for [in $w $c//ux-lk] [yield [$first $w/*]]]]]

[?def reconstruct-carrier pure [returns any] ($t::any $parent::string)
  [ux-lks [?splice [?for [in $x [$reconstruct-node $t $parent ""]]
                     [yield [ux-lk $x]]]]]]

# ── docs ────────────────────────────────────────────────────────────────────
[module-doc name=ux
  [scope """The SEMANTIC CORE of the UX projection (EXPERIMENTAL x/ tier;
   #787): the vocabulary, the fragment addressing, the validation, the three
   projections (command→form, query→table, feature-grammar→form/columns), the
   hint claims, the patch algebra a live feed lowers onto, and the surface
   document's routing correspondence. It contains NO RENDERER and imports no
   markup library: `cx-x/ux-web` lowers a semantic tree to HTML/htmx and
   `cx-x/ux-tui` lowers the same tree to a terminal, and neither is
   privileged. Renderer-private intent — swap modes, out-of-band targets, SSE
   endpoints — is refused on semantic elements and lives instead in the render
   context document a renderer reads for itself; a region declares a LOGICAL
   feed name and an action declares the element path it AFFECTS. Fragment
   identity is exactly (route, feature instance, element path) — theme,
   locale, actor and data are content, never identity — and `content-of` is
   the normal form on which two renderings are asserted to agree."""]]

[fn-doc name=frag scope=public purity=pure
  [sig """($route::string $feature::string $path::string) -> element"""]
  [summary """Build a fragment address from its three identity inputs; its strict canonical bytes are the identity."""]
  [param-doc name=route """The INSTANTIATED route path as served, with pattern params bound (/orders/o-1041, never /orders/:id)."""]
  [param-doc name=feature """The feature INSTANCE name on the route (defaults to the feature name; duplicates on one route are a compose-time refusal)."""]
  [param-doc name=path """The element path inside the instance's projection: schema-derived step names, template slot names, or an author-assigned element id."""]]
[fn-doc name=frag-address scope=public purity=pure
  [sig """($f::element) -> string"""]
  [summary """The Tier-1 content address of a fragment address, tagged sha2-256:<hex> like every other address in the suite."""]
  [param-doc name=f """A [frag …] address value."""]]
[fn-doc name=frag-id scope=public purity=pure
  [sig """($f::element) -> string"""]
  [summary """The short selector-safe spelling of an address: cx- plus the first 16 hex chars of its sha2-256 — a derived rendering, never a second identity."""]
  [param-doc name=f """A [frag …] address value."""]]
[fn-doc name=frag-id-of scope=public purity=pure
  [sig """($repr::string) -> string"""]
  [summary """The DOM id derived from an already-computed canonical form — byte-identical to frag-id, and half the canonicalization, which measurement showed dominates rendering."""]
  [param-doc name=repr """The address's canonical form, from frag-repr."""]]
[fn-doc name=frag-repr scope=public purity=pure
  [sig """($f::element) -> string"""]
  [summary """The full readable canonical form, so goldens stay diffable and clients can recover the address."""]
  [param-doc name=f """A [frag …] address value."""]]
[fn-doc name=path-step scope=public purity=pure
  [sig """($base::string $step::string) -> string"""]
  [summary """Append one step to an element path."""]
  [param-doc name=base """The enclosing element path (/ for the projection root)."""]
  [param-doc name=step """The step name to append."""]]
[fn-doc name=row-step scope=public purity=pure
  [sig """($base::string $key::any) -> string | ()"""]
  [summary """A collection row's path step, keyed by the declared row key; absence in yields absence out, because positional row identity is never minted."""]
  [param-doc name=base """The collection's element path."""]
  [param-doc name=key """The declared row key value, or () when the collection declares no key."""]]
[fn-doc name=vocabulary scope=public purity=pure
  [sig """() -> [sequence string]"""]
  [summary """The semantic element set the projection emits — surface-neutral, assuming no hover, pointer, CSS-shaped layout, or renderer transport."""]]
[fn-doc name=in-vocabulary scope=public purity=pure
  [sig """($n::string) -> bool"""]
  [summary """Is an element name a member of the semantic vocabulary?"""]
  [param-doc name=n """The element name."""]]
[fn-doc name=tones scope=public purity=pure
  [sig """() -> [sequence string]"""]
  [summary """The closed tone set for a badge — semantic meanings, never colors; each renderer decides what a tone looks like."""]]
[fn-doc name=valid-tone scope=public purity=pure
  [sig """($t::string) -> bool"""]
  [summary """Is a tone name a member of the closed tone set?"""]
  [param-doc name=t """The tone name."""]]
[fn-doc name=renderer-private-attrs scope=public purity=pure
  [sig """() -> [sequence string]"""]
  [summary """The attribute names a semantic element may NOT carry — each one a renderer's private concept; a tree carrying one is a tree only that renderer can honor."""]]
[fn-doc name=feed-binding scope=public purity=pure
  [sig """($rctx::any $name::string) -> element | ()"""]
  [summary """The render context's binding for one logical feed name: its endpoint and event. Shared by every renderer, because both are clients of the same surface."""]
  [param-doc name=rctx """The [ux:render-ctx …] document."""]
  [param-doc name=name """The logical feed name a region declares with live=."""]]
[fn-doc name=swap-mode scope=public purity=pure
  [sig """($rctx::any $affects::string) -> string"""]
  [summary """The swap mode declared for one affects= path, else the context default, else outerHTML. A renderer with no notion of swap modes never calls it."""]
  [param-doc name=rctx """The [ux:render-ctx …] document."""]
  [param-doc name=affects """The element path an action or form declares that it updates."""]]
[fn-doc name=binding-refusals scope=public purity=pure
  [sig """($el::any $rctx::any) -> [sequence element]"""]
  [summary """Refuse a live= naming a feed the render context does not bind — a region that silently is not live passes every server-side gate and then never updates."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=rctx """The [ux:render-ctx …] document."""]]
[fn-doc name=refusals-of scope=public purity=pure
  [sig """($el::any) -> [sequence element]"""]
  [summary """Every refusal in one semantic subtree, collected before any lowering — the SHARED gate, so a tree one renderer accepts and another rejects cannot exist."""]
  [param-doc name=el """The semantic element tree to check."""]]
[fn-doc name=joined scope=public purity=pure
  [sig """($a::any $b::any) -> [sequence element]"""]
  [summary """Read two refusal sequences back as one flat node-set."""]
  [param-doc name=a """The first refusal sequence."""]
  [param-doc name=b """The second refusal sequence."""]]
[fn-doc name=seq-child scope=public purity=pure
  [sig """($el::any) -> bool"""]
  [summary """Is this child a SEQUENCE rather than an element? A [?for] in an element body yields one sequence-valued child, and every tree walk must see through it."""]
  [param-doc name=el """The child to test."""]]
[fn-doc name=descend scope=public purity=pure
  [sig """($el::any $ctx::map) -> map"""]
  [summary """The fragment context an element's children see: a placed element contributes its author-assigned id as the element-path step, and the render context rides along untouched."""]
  [param-doc name=el """The semantic element being entered."""]
  [param-doc name=ctx """The enclosing fragment context."""]]
[fn-doc name=ctx-at scope=public purity=pure
  [sig """($ctx::map $path::string) -> map"""]
  [summary """The same fragment context at a different element path."""]
  [param-doc name=ctx """The fragment context."""]
  [param-doc name=path """The element path to move to."""]]
[fn-doc name=ctx-frag scope=public purity=pure
  [sig """($ctx::map) -> element"""]
  [summary """The fragment address a context currently denotes."""]
  [param-doc name=ctx """The fragment context map {route, feature, path, bind}."""]]
[fn-doc name=affects-frag scope=public purity=pure
  [sig """($el::any $ctx::map) -> element | ()"""]
  [summary """The fragment an action or form declares that it updates — DERIVED, so a renderer's target cannot drift from the identity it minted for the target."""]
  [param-doc name=el """The [ux:action …] or [ux:form …] element."""]
  [param-doc name=ctx """The enclosing fragment context."""]]
[fn-doc name=str-or scope=public purity=pure
  [sig """($v::any $dflt::string) -> string"""]
  [summary """An absent attribute's default — NOT ?else over [$string], which never fires because the empty string exists."""]
  [param-doc name=v """The attribute value or absence."""]
  [param-doc name=dflt """The default."""]]
[fn-doc name=label-of scope=public purity=pure
  [sig """($el::any) -> string"""]
  [summary """An element's display label: its label= attribute when present, else its text."""]
  [param-doc name=el """The semantic element."""]]
[fn-doc name=label-of-name scope=public purity=pure
  [sig """($n::string) -> string"""]
  [summary """Derive a human label from a param or verb name — the ruled degradation when no documentation supplies one."""]
  [param-doc name=n """The param or verb name."""]]
[fn-doc name=level-of scope=public purity=pure
  [sig """($el::any) -> string"""]
  [summary """A heading's level as a literal name, defaulting to 2 — read as a string because a cast would RAISE on level=abc and escape the refusal contract."""]
  [param-doc name=el """The [ux:heading …] element."""]]
[fn-doc name=child-elements scope=public purity=pure
  [sig """($el::any $n::string) -> [sequence element]"""]
  [summary """The child ELEMENTS named n. NOT $el/n: a named child step is a field read and ATOMIZES to the child's value on a single match, so [$first $el/n] returns a string for a one-member collection and an element for a two-member one — a difference every two-row fixture hides."""]
  [param-doc name=el """The parent element."""]
  [param-doc name=n """The child element name."""]]
[fn-doc name=absent scope=public purity=pure
  [sig """($x::any) -> bool"""]
  [summary """Is this absence rather than an element? NOT [not [$exists x]]: $exists is false for a single element taken with [$first]/[$nth] as well as for absence, so it cannot tell found-one from found-none — the most load-bearing distinction a tree walk makes. [$count] can."""]
  [param-doc name=x """The value to test."""]]
[fn-doc name=first-child scope=public purity=pure
  [sig """($el::any $n::string) -> element | ()"""]
  [summary """The first child element named n, or absence. NOT for a PARSED DOCUMENT: [$cx:parse] returns a document node the child axis does not traverse, even though [$count] reports 1 — read those with the descendant axis."""]
  [param-doc name=el """The parent element."""]
  [param-doc name=n """The child element name."""]]
[fn-doc name=has-str scope=public purity=pure
  [sig """($seq::any $s::string) -> bool"""]
  [summary """Membership of a string in a sequence of stringables."""]
  [param-doc name=seq """The sequence."""]
  [param-doc name=s """The string to find."""]]
[fn-doc name=has-address scope=public purity=pure
  [sig """($el::any) -> bool"""]
  [summary """Does this element own a distinct fragment address? A property of the semantic tree, not of a renderer, so both renderers mint from one answer."""]
  [param-doc name=el """The semantic element."""]]
[fn-doc name=child-ctx scope=public purity=pure
  [sig """($el::any $ctx::map) -> map"""]
  [summary """THE one definition of how an element path grows: a region re-roots feature and path, a form steps by its verb, a keyed row by its key, a placed element by its author-assigned id, and structure leaves the path alone."""]
  [param-doc name=el """The semantic element being entered."""]
  [param-doc name=ctx """The enclosing fragment context."""]]
[fn-doc name=address-pairs scope=public purity=pure
  [sig """($el::any $ctx::map) -> [sequence element]"""]
  [summary """Every (DOM id, readable address) pair a semantic tree will mint — taken from the semantic tree, so the check runs once and is shared rather than re-walking each renderer's larger output."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=ctx """The fragment context."""]]
[fn-doc name=address-collisions scope=public purity=pure
  [sig """($el::any $ctx::map) -> [sequence element]"""]
  [summary """Refuse a duplicate DOM id — a hash-truncation collision or a reused address — never silently disambiguate. Detection is three counts and O(n log n); the pairwise scan that names the offenders runs only when a count disagrees, which is a path that refuses the render anyway."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=ctx """The fragment context."""]]
[fn-doc name=dangling-affects scope=public purity=pure
  [sig """($el::any $ctx::map) -> [sequence element]"""]
  [summary """Refuse an affects= naming a path no element in the same tree mints. Without it a swap targets an id that does not exist and the page silently does not update — which looks like a caching problem and is the worst symptom an addressing mistake can have."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=ctx """The fragment context."""]]
[fn-doc name=content-of scope=public purity=pure
  [sig """($el::any) -> element"""]
  [summary """The COMMON CONTENT NORMAL FORM: content and structure with presentation stripped. Each renderer supplies a readback from its own output to this form, and the fixtures assert all three canonical-equal."""]
  [param-doc name=el """The semantic element tree."""]]
[fn-doc name=content-repr scope=public purity=pure
  [sig """($el::any) -> string"""]
  [summary """The canonical bytes of the content normal form — what two renderings must agree on."""]
  [param-doc name=el """The semantic element tree."""]]
[fn-doc name=form scope=public purity=pure
  [sig """($source::string $verb::string $opts::map) -> element | [err …]"""]
  [summary """Project a command def onto a semantic form — fields from the param list, required from the non-defaulted positionals, labels degrading to name-derived; derived at render time, never from a materialized manifest."""]
  [param-doc name=source """The module source text carrying the command definition."""]
  [param-doc name=verb """The qualified verb naming the command — what POST /intent/<verb> dispatches on."""]
  [param-doc name=opts """Rendering options: affects (the element path the submission updates) and the session csrf token."""]]
[fn-doc name=form-error scope=public purity=pure
  [sig """($message::string) -> element"""]
  [summary """Render a command refusal as a form error, carrying the refusal's own message verbatim — the UX layer never restates a rule."""]
  [param-doc name=message """The message from the [err …] the command layer returned."""]]
[fn-doc name=feature-form scope=public purity=pure
  [sig """($feature::any $verb::string $opts::map) -> element | [err …]"""]
  [summary """Project an ACT verb of an XAP FEATURE DOCUMENT onto a semantic form — fields from the verb's own declared intent parameters when the grammar states them, falling back to the noun the verb writes when it does not. The reference estate defines commands as feature grammar, not as [?def]s, so this is the subject the third face must project there."""]
  [param-doc name=feature """The [feature …] document."""]
  [param-doc name=verb """The verb name."""]
  [param-doc name=opts """Rendering options: affects."""]]
[fn-doc name=feature-noun scope=public purity=pure
  [sig """($feature::any $noun::string) -> [sequence element]"""]
  [summary """The noun a feature declares under that name — public so a surface can project one more instance of a repeating group without re-deriving the grammar."""]
  [param-doc name=feature """The [feature …] document."""]
  [param-doc name=noun """The noun name."""]]
[fn-doc name=feature-columns scope=public purity=pure
  [sig """($feature::any $noun::string) -> [sequence [sequence string]]"""]
  [summary """A noun's field names as column names, in the domain author's declaration order. Nests ONE level — a [?for] in an element body yields one sequence-valued child — so an absent noun reads as absence, not as an empty name."""]
  [param-doc name=feature """The [feature …] document."""]
  [param-doc name=noun """The noun name."""]]
[fn-doc name=schema-address scope=public purity=pure
  [sig """($schema::any) -> string"""]
  [summary """The E2 content address of a DECLARED schema — byte-identical to what register-schema binds. Takes a SCHEMA, never a value: an address inferred from one sample carries that sample's cardinality and cannot serve as a claim key."""]
  [param-doc name=schema """The parsed schema document being addressed."""]]
[fn-doc name=claim-key scope=public purity=pure
  [sig """($addr::string $path::string) -> string"""]
  [summary """The composite claim-key spelling: the tagged schema address immediately followed by the CXPath — a derived spelling of the pair, never a third identity."""]
  [param-doc name=addr """The schema content address."""]
  [param-doc name=path """The CXPath into that shape; / for the whole value."""]]
[fn-doc name=hint-for scope=public purity=pure
  [sig """($hints::any $addr::string $path::string $type::string) -> string | ()"""]
  [summary """Resolve one hint type for a keyed node, longest matching path first; absence is a normal answer and the default projection applies."""]
  [param-doc name=hints """The [ux:hint …] claims in force."""]
  [param-doc name=addr """The schema content address of the node's shape."""]
  [param-doc name=path """The CXPath of the node within that shape."""]
  [param-doc name=type """The hint type to resolve, e.g. order or view."""]]
[fn-doc name=table scope=public purity=pure
  [sig """($rows::any $opts::map) -> element"""]
  [summary """Project a query result onto a semantic table — columns derived from the row schema, rows keyed only by a DECLARED key, nested collections rendered as nested tables, and the row container addressed so a live patch has somewhere to land."""]
  [param-doc name=rows """The query's result sequence."""]
  [param-doc name=opts """{id: the placed-element id, live: the logical feed whose pushes replace this collection, types: a sequence of [row-type name=… key=… schema=…] declarations, hints: the [ux:hint …] claims in force, columns: an explicit column list from a DECLARED field set, which beats the inferred row schema because it carries the author's order and does not vary with which rows are present, detail-route: the route a keyed row drills into}."""]]
[fn-doc name=rows-container-step scope=public purity=pure
  [sig """() -> string"""]
  [summary """The element-path step a projected table's row container takes — the address a live patch appends into."""]]
[fn-doc name=rows-container-path scope=public purity=pure
  [sig """($table-path::string) -> string"""]
  [summary """The row container's element path for a table placed at the given path."""]
  [param-doc name=table-path """The table's element path."""]]
[fn-doc name=row-columns scope=public purity=pure
  [sig """($schema::any $rowname::string) -> [sequence string]"""]
  [summary """A row type's scalar attribute names in schema order — a column exists because a value does."""]
  [param-doc name=schema """The parsed row schema."""]
  [param-doc name=rowname """The row element's name."""]]
[fn-doc name=key-for scope=public purity=pure
  [sig """($opts::map $rowname::string) -> string | ()"""]
  [summary """The DECLARED key attribute for one row type, or absence — never guessed from an attribute named id."""]
  [param-doc name=opts """The projection options carrying the [row-type …] declarations."""]
  [param-doc name=rowname """The row element's name."""]]
[fn-doc name=cell-text scope=public purity=pure
  [sig """($r::any $attr::string) -> string"""]
  [summary """One attribute's value as text through the canonical scalar printer, so a decimal renders at the precision it was stored at."""]
  [param-doc name=r """The row element."""]
  [param-doc name=attr """The attribute name."""]]
[fn-doc name=feed-ops scope=public purity=pure
  [sig """($frames::any $rows::any $ctx::map $opts::map) -> [sequence element]"""]
  [summary """Lower a live-modes ∂ script onto the SEMANTIC PATCH ALGEBRA — insert / update / remove / repaint over a keyed collection addressed by element path, never by a renderer's swap syntax. retract carries only a position, so the current row list recovers its key, and an unkeyed collection collapses every frame to a repaint."""]
  [param-doc name=frames """The ∂ frames: insert / retract / regroup / recompute."""]
  [param-doc name=rows """The projection's current row list for this subscription."""]
  [param-doc name=ctx """The fragment context map {route, feature, path, bind}."""]
  [param-doc name=opts """{types: the row-type declarations, container: the collection container's ELEMENT PATH}."""]]
[fn-doc name=feed scope=public purity=pure
  [sig """($feature::string $path::string $name::string $body::any) -> element"""]
  [summary """The live region: it names a LOGICAL FEED, and the endpoint and event live in the render context — so one declaration reaches a browser and a terminal without either transport being spelled in the tree."""]
  [param-doc name=feature """The feature instance name."""]
  [param-doc name=path """The element path within the instance's projection."""]
  [param-doc name=name """The logical feed name the render context binds."""]
  [param-doc name=body """The region's initial content."""]]
[fn-doc name=routes-of scope=public purity=pure
  [sig """($surface::element) -> [sequence element]"""]
  [summary """A surface document's route table as data: path, feature, instance name, and template per route."""]
  [param-doc name=surface """A [surface …] composition document."""]]
[fn-doc name=duplicate-instances scope=public purity=pure
  [sig """($surface::element) -> [sequence element]"""]
  [summary """Refuse composing the same feature instance twice on one route — no silent ordinals, because the instance name is a fragment-identity input."""]
  [param-doc name=surface """A [surface …] composition document."""]]
[fn-doc name=fragment-paths scope=public purity=pure
  [sig """($surface::element) -> [sequence string]"""]
  [summary """The fragment endpoints a surface's routes declare — kept INSIDE the route/resource correspondence check rather than exempted from it, because an unrouted fragment endpoint is as much a page outside the composition as an unrouted page."""]
  [param-doc name=surface """A [surface …] composition document."""]]
[fn-doc name=service-refusals scope=public purity=pure
  [sig """($surface::element $served::any) -> [sequence element]"""]
  [summary """Refuse any drift between a surface document's routes and the resource paths its [?http-service] registers, in both directions."""]
  [param-doc name=surface """A [surface …] composition document."""]
  [param-doc name=served """The resource paths the service actually registers."""]]
[fn-doc name=surface-verb-refusals scope=public purity=pure
  [sig """($surface::element $features::any) -> [sequence element]"""]
  [summary """The static half of verb coverage at compose time (W16-b): every act verb the composed features declare is offered by some route or declared not-offered with a why — a why-less declaration does not account for its verb."""]
  [param-doc name=surface """A [surface …] composition document carrying [offer] and [not-offered] declarations."""]
  [param-doc name=features """The [feature …] documents the surface composes; empty when the surface composes none, which asserts nothing about verbs."""]]
[fn-doc name=check-surface scope=public purity=pure
  [sig """($surface::element $served::any $features::any) -> true | [err …]"""]
  [summary """The compose-time gate over a surface document, its service's resource table, and the feature documents it composes (verb accounting is part of composing at all — W16-b)."""]
  [param-doc name=surface """A [surface …] composition document."""]
  [param-doc name=served """The resource paths the service actually registers."""]
  [param-doc name=features """The composed [feature …] documents; a surface built from none passes an empty sequence."""]]
[fn-doc name=currency-symbol scope=public purity=pure
  [sig """($c::string) -> string"""]
  [summary """The display symbol for an ISO currency code (USD/EUR/GBP/JPY); an unknown code falls back to the code itself plus a space, never an error."""]]
[fn-doc name=group-digits scope=public purity=pure
  [sig """($d::string) -> string"""]
  [summary """Insert thousands separators into a digit string, right to left ('1234567' -> '1,234,567')."""]]
[fn-doc name=money-text scope=public purity=pure
  [sig """($v::string $cur::string) -> string"""]
  [summary """Render a decimal carrier and its currency as display text (sign, symbol, grouped integer part, two-place fraction) — never routed through a float."""]]
[fn-doc name=rating-fifths scope=public purity=pure
  [sig """($v::string) -> int"""]
  [summary """A 0..5 rating carrier as a whole number of filled marks, rounding half-up and clamping to 5."""]]
[fn-doc name=rating-text scope=public purity=pure
  [sig """($v::string) -> string"""]
  [summary """The marks AND the number, always together (P0-66): filled/empty stars followed by the numeric value, shared by every renderer."""]]
[fn-doc name=formatted scope=public purity=pure
  [sig """($el::any $raw::string) -> string"""]
  [summary """The ONE place a format= hint turns a carrier into display text — money and rating dispatch here; anything else passes through raw."""]
  [param-doc name=el """The vocabulary element carrying format= (and currency= for money)."""]
  [param-doc name=raw """The raw carrier text to format."""]]
[fn-doc name=allowed-attrs scope=public purity=pure
  [sig """($n::string) -> sequence"""]
  [summary """The closed attribute list for one vocabulary member — the authority the attribute-closure gate checks against; an unknown member yields the empty sequence."""]]
[fn-doc name=own-attr-names scope=public purity=pure
  [sig """($el::any) -> sequence"""]
  [summary """The element's OWN attribute names, enumerated through a fixed-depth rooted carrier scan (the binding surface has no attribute wildcard)."""]]
[fn-doc name=act-verbs scope=public purity=pure
  [sig """($feature::any) -> sequence"""]
  [summary """The feature's invokable verbs — every [verb] whose effect is 'act', by the P0-17 discriminator."""]]
[fn-doc name=control-verbs scope=public purity=pure
  [sig """($el::any) -> sequence"""]
  [summary """Every verb a semantic tree offers as a control (action, form, or verb-carrying quantity), distinct — twenty cards offering one verb are one affordance."""]]
[fn-doc name=verbs-uncovered scope=public purity=pure
  [sig """($offers::any $el::any) -> sequence"""]
  [summary """The verbs a route declares it offers that its rendered tree does not offer as a control — each as a ux-verb-uncovered refusal."""]
  [param-doc name=offers """The verb names the route's [offer] declarations promise."""]
  [param-doc name=el """The semantic tree the walker drove the route into."""]]
[fn-doc name=verbs-unaccounted scope=public purity=pure
  [sig """($feature::any $offered::any $not-offered::any) -> sequence"""]
  [summary """Surface-level completeness: every act verb the feature declares that no route offers and no [not-offered] accounts for — the missing-affordance class equivalence cannot see (L5)."""]
  [param-doc name=feature """The [feature …] document whose act verbs are the obligation."""]
  [param-doc name=offered """Verb names some route offers."""]
  [param-doc name=not-offered """Verb names the surface explicitly declares not offered, with a why."""]]
[fn-doc name=found scope=public purity=pure
  [sig """($x::any) -> bool"""]
  [summary """True iff the value is present — delegates to [$present] (#854); the retired exists-or-named workaround's public name, kept for its callers."""]]
[fn-doc name=collisions-with scope=public purity=pure
  [sig """($pairs::any) -> sequence"""]
  [summary """Address-collision refusals over a precomputed address-pair set — empty when every pair and every id is distinct."""]]
[fn-doc name=err-refusals scope=public purity=pure
  [sig """($el::any) -> sequence"""]
  [summary """Every [err …] spliced into a semantic tree, surfaced as a ux-err-in-tree refusal — an err embedded in a document has already lost the property that makes it a refusal."""]]
[fn-doc name=dangling-affects-with scope=public purity=pure
  [sig """($el::any $ctx::map $pairs::any) -> sequence"""]
  [summary """Every affects= naming a path neither the tree mints nor (for a fragment) the render context declares — the silently-lands-nowhere class, refused."""]
  [param-doc name=el """The semantic tree."""]
  [param-doc name=ctx """The render context; ctx.fragment relaxes the check to the surface's declared containers."""]
  [param-doc name=pairs """The tree's address pairs, precomputed by address-pairs."""]]
[fn-doc name=declared-containers scope=public purity=pure
  [sig """($rctx::any) -> sequence"""]
  [summary """The container paths a render context declares ([swap]/[fragment] entries) — what a fragment's affects= is allowed to aim at."""]]
[fn-doc name=committed scope=public purity=pure
  [sig """($message::string) -> element"""]
  [summary """A success notice for a committed intent — the caller's message in a tone=ok notice; the other half of form-error, owed by the same reasoning."""]]
[fn-doc name=entered scope=public purity=pure
  [sig """($opts::map $name::string $dflt::string) -> string"""]
  [summary """The value the operator already typed for one control (from opts.values), or the default — what keeps a refused form from losing its input."""]
  [param-doc name=opts """Projection options; .values carries the re-render inputs."""]
  [param-doc name=name """The control's wire name."""]
  [param-doc name=dflt """The value when nothing was entered."""]]
[fn-doc name=field-error scope=public purity=pure
  [sig """($opts::map $name::string) -> string"""]
  [summary """The refusal message that belongs to ONE control (from opts.errors), or the empty string — the message renders next to its field, not in a banner."""]]
[fn-doc name=reference-select scope=public purity=pure
  [sig """($f::any $noun::string $opts::map) -> element"""]
  [summary """A reference field as a required ux:select over the referenced noun's rows; a missing option set yields an empty select (an empty catalogue is a legitimate state)."""]
  [param-doc name=f """The [field …] declaration."""]
  [param-doc name=noun """The referenced noun's name."""]
  [param-doc name=opts """Projection options; .options carries the caller's option sets."""]]
[fn-doc name=options-for scope=public purity=pure
  [sig """($opts::map $noun::string) -> sequence"""]
  [summary """The caller's option set for one noun ([options for=… [option value=… label=…]…]) as ux:option elements; absent set yields the empty sequence."""]]
[fn-doc name=repeating-group scope=public purity=pure
  [sig """($f::any $ref::any $feature::any $opts::map) -> element"""]
  [summary """The nested WRITE case: a repeat=true ux:group over the referenced noun's fields, one rendered instance per surviving wire index."""]
  [param-doc name=f """The group's [field …] declaration."""]
  [param-doc name=ref """The referenced noun declaration(s)."""]
  [param-doc name=feature """The enclosing feature document."""]
  [param-doc name=opts """Projection options; .values decides which instances exist."""]]
[fn-doc name=instance-indices scope=public purity=pure
  [sig """($opts::map $group::string) -> sequence"""]
  [summary """WHICH group instances to re-render, by their own wire index (gaps preserved — indices are identity, so removing lines.0 must not renumber lines.1); an unentered form mints index 0."""]]
[fn-doc name=index-part scope=public purity=pure
  [sig """($s::string $n::int) -> string"""]
  [summary """The index segment of a grouped wire name ('lines.2.sku' at the group prefix length -> '2'); too-short names yield '0'."""]]
[fn-doc name=group-instance scope=public purity=pure
  [sig """($f::any $ref::any $feature::any $opts::map $i::int) -> element"""]
  [summary """One instance of a repeated noun as a ux:card of controls named <group>.<i>.<field> — the index keeps two instances from collapsing on the flat form wire."""]]
[fn-doc name=intent-params scope=public purity=pure
  [sig """($v::any) -> sequence"""]
  [summary """The parameter names a verb's [intent [do …]] grammar declares — the verb's real signature; empty when the verb has not declared one (the noun remains the fallback)."""]]
[fn-doc name=feature-card scope=public purity=pure
  [sig """($feature::any $spec::any $row::any $opts::map) -> element"""]
  [summary """One row as a ux:card, driven by a route-level [card …] spec: media, title, subtitle, the shows= fields that carry values (empty ones drop), and the buy action."""]
  [param-doc name=feature """The feature document (noun declarations resolve against it)."""]
  [param-doc name=spec """The [card noun= key= …] spec — route-level picks, deliberately unshared."""]
  [param-doc name=row """The projected row element."""]
  [param-doc name=opts """Projection options (hints, currency, return route)."""]]
[fn-doc name=row-attr scope=public purity=pure
  [sig """($row::any $name::string) -> string"""]
  [summary """One attribute of a row as a string, or '' when absent or unnamed — the total accessor card projection is built on."""]]
[fn-doc name=noun-field-view scope=public purity=pure
  [sig """($ns::any $fname::string $row::any $opts::map) -> element"""]
  [summary """ONE declared field as a labelled ux:field — label from the declaration (or derived from the name), format from the hint claim keyed by (noun address, path), which is why money is money everywhere."""]
  [param-doc name=ns """The noun declaration(s) the field belongs to."""]
  [param-doc name=fname """The field name."""]
  [param-doc name=row """The row carrying the value."""]
  [param-doc name=opts """Projection options; .hints and .addr key the format claim, .currency names the row's currency column."""]]
[fn-doc name=feature-fields scope=public purity=pure
  [sig """($feature::any $noun::string $row::any $skip::any $opts::map) -> sequence"""]
  [summary """Every declared field of a noun projected as labelled values, minus the skip list and the value-less — the detail page's specification block, driven by the noun so a new attribute gains a row here and nowhere else."""]]
[fn-doc name=format-for scope=public purity=pure
  [sig """($hints::any $addr::string $col::string) -> any"""]
  [summary """The format= hint claim for one column, keyed by (schema content-address, /column path) — absent when no claim speaks for it."""]]
[fn-doc name=layout-find scope=public purity=pure
  [sig """($layout::any $id::string) -> element | ()"""]
  [summary """The [placed …] element carrying this surface-doc id, anywhere in the layout document, or absence — ids are unique per document (P0-16)."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=id """The author-assigned placed-element id."""]]
[fn-doc name=layout-ids scope=public purity=pure
  [sig """($layout::any) -> [sequence string]"""]
  [summary """Every placed id in the layout document, document order."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]]
[fn-doc name=layout-parent-id scope=public purity=pure
  [sig """($layout::any $id::string) -> string"""]
  [summary """The id of the placed element holding this one; '' means it sits at the layout root."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=id """The placed-element id."""]]
[fn-doc name=layout-successor scope=public purity=pure
  [sig """($layout::any $id::string) -> string"""]
  [summary """The id of the placed sibling FOLLOWING this one, or '' when it is last — what makes the inverse-pair table (P0-108) computable: put-it-back is insert-before-what-followed."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=id """The placed-element id."""]]
[fn-doc name=layout-hint scope=public purity=pure
  [sig """($layout::any $id::string $hint::string) -> string"""]
  [summary """The SURFACE-LEVEL value of one hint on one placed element, or '' when it carries none and the inherited resolution applies (P0-107) — also the prior value the set-hint inverse restores."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=id """The placed-element id."""]
  [param-doc name=hint """The hint name."""]]
[fn-doc name=component-known scope=public purity=pure
  [sig """($components::any $name::string) -> bool"""]
  [summary """Is a component name in the resolved registry? Placeable is a cascade-resolvable component name, never raw markup (P0-105)."""]
  [param-doc name=components """The resolved [component name=… container=…] declarations."""]
  [param-doc name=name """The component name."""]]
[fn-doc name=component-container scope=public purity=pure
  [sig """($components::any $name::string) -> bool"""]
  [summary """Is a component declared container=true — allowed to hold placed children (a wrap target, a place/move parent)?"""]
  [param-doc name=components """The resolved [component name=… container=…] declarations."""]
  [param-doc name=name """The component name."""]]
[fn-doc name=layout-refusals scope=public purity=pure
  [sig """($layout::any $cmd::any $components::any) -> [sequence element]"""]
  [summary """Every refusal one layout command earns against the FULL document: address-miss (P0-28), id-collision (P0-16/P0-105), unknown or non-container component, cycle and incoherent position (P0-29), unknown command."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=cmd """One of the five layout commands."""]
  [param-doc name=components """The resolved component registry."""]]
[fn-doc name=layout-apply scope=public purity=pure
  [sig """($layout::any $cmd::any $components::any) -> element | [err …]"""]
  [summary """Apply ONE layout command against the full document (P0-29) — pure structural surgery touching only what the command addresses (P0-26); the amended document, or one [err] naming every refusal. The caller journals, stamps and publishes."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=cmd """One of the five layout commands."""]
  [param-doc name=components """The resolved component registry."""]]
[fn-doc name=layout-apply-batch scope=public purity=pure
  [sig """($layout::any $cmds::any $components::any) -> element | [err …]"""]
  [summary """A P0-27 batch, atomic: all-or-nothing, one journal entry at the boundary; the first refusal refuses the batch whole."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=cmds """The command sequence."""]
  [param-doc name=components """The resolved component registry."""]]
[fn-doc name=layout-param scope=public purity=pure
  [sig """($layout::any $id::string $param::string) -> string"""]
  [summary """The value of one content param on one placed element, or '' when it carries none and the registry default applies (P0-111) — the prior the set-param inverse restores."""]
  [param-doc name=layout """The [ux:layout …] arrangement document."""]
  [param-doc name=id """The placed-element id."""]
  [param-doc name=param """The param name."""]]
[fn-doc name=component-params scope=public purity=pure
  [sig """($components::any $name::string) -> [sequence element]"""]
  [summary """One registry entry's [param name= default= carrier=] declarations — the component's editable content surface (P0-113)."""]
  [param-doc name=components """The resolved registry."""]
  [param-doc name=name """The component name."""]]
[fn-doc name=component-variants scope=public purity=pure
  [sig """($components::any $name::string) -> [sequence element]"""]
  [summary """One registry entry's [variant name= options=] axes — closed option sets written as ordinary surface-level hints (P0-107/P0-113)."""]
  [param-doc name=components """The resolved registry."""]
  [param-doc name=name """The component name."""]]
[fn-doc name=component-accepts scope=public purity=pure
  [sig """($components::any $name::string) -> [sequence string]"""]
  [summary """The component names a container may hold (P0-113); absent accepts= means anything, and a place or move of an unaccepted child refuses with ux-layout-not-accepted — the rule that stops an editor's reasonable guess from producing an invalid tree."""]
  [param-doc name=components """The resolved registry."""]
  [param-doc name=name """The container component's name."""]]
[fn-doc name=component-fixed scope=public purity=pure
  [sig """($components::any $name::string) -> bool"""]
  [summary """Is a component declared fixed — restylable but never moved, removed or wrapped (load-bearing chrome, e.g. an affects= target)?"""]
  [param-doc name=components """The resolved registry."""]
  [param-doc name=name """The component name."""]]
[fn-doc name=layout-inverse scope=public purity=pure
  [sig """($layout::any $cmd::any) -> [sequence element]"""]
  [summary """The P0-108 inverse-pair table, computed against the PRE-state: move↔move-back, set-hint↔set-hint-prior, place↔remove, remove↔the reconstructing place batch, wrap↔(move the child back THEN remove the empty wrapper) as one P0-27 batch."""]
  [param-doc name=layout """The layout document BEFORE the command applies."""]
  [param-doc name=cmd """The command whose inverse is wanted."""]]
[fn-doc name=op-replace scope=public purity=pure
  [sig """($path::string $el::any) -> element"""]
  [summary """A replace operation over an addressed element path (the P0-44 algebra reaching non-row elements, P0-83) — each renderer lowers it for itself: the browser swaps out-of-band, a terminal re-reads."""]]
