# cx-x/ux-web — THE WEB RENDERER: semantic tree → HTML/htmx (#787 W1–W5).
#
# ⚠ x/-TIER MODULE (spec/03-approved/std-lib/README.md D3): bundled + gated
# in-tree but EXEMPT from the frozen-`std` byte-compatible-reimpl stability
# promise. Ring 2 by dependency (routing rides `[?http-service]`, the
# platform-ring directive); the pure lowering below runs anywhere the html
# pack does.
#
# Normative source: spec/03-approved/xap/ux.md (graduated 2026-08-20, UX-1;
# owner-RULED 2026-08-17 as design/787/787-phase0-spec.md).
# Every clause this file implements is cited inline; the spec is the only
# truth.
#
# ── ONE OF TWO RENDERERS, NOT THE RENDERER ──────────────────────────────────
#
# W1–W4 kept the lowering in `cx-x/ux` beside the vocabulary, and htmx
# concepts duly climbed into the vocabulary: `target=`, `swap=`, `oob=`,
# `ext=`, `subscribe=`, `on=`. P0-20's claim that the semantic element set is
# renderer-agnostic was, in that arrangement, false. The lowering therefore
# lives here, `cx-x/ux` imports no markup library at all, and this module is a
# peer of `cx-x/ux-tui` rather than the privileged one.
#
# What that buys, concretely: every htmx spelling in this file is derived from
# a SEMANTIC declaration plus the RENDER CONTEXT (`ux:region live=`,
# `ux:action affects=`, `[ux:render-ctx [feed …] [swap …]]`). Nothing in a
# semantic tree names an htmx attribute, an event name, or a CSS selector, so
# the same tree reaches the terminal renderer intact.
#
# THE EMITTER IS THE SOLE ATTRIBUTE AUTHOR (P0-30). Nothing outside this
# module may author an `hx-*`/`sse-*` attribute on managed HTML — that is what
# makes the kernel replaceable by a ~2 kB substitute with no surface-visible
# change (R4). Enforcement is two-sided: constructively, every htmx attribute
# name passes `hx-name`, so an off-list name is omitted rather than emitted;
# and on the output side, `off-subset-attrs` re-scans the serialized bytes, so
# a path that bypassed the constructor still goes red.
#
# ESCAPING IS STRUCTURAL (P0-32). Fragments compose as CXDM trees and are
# serialized ONCE through `[$html:serialize]` (WHATWG rules, double-quoted
# attributes). There is no interpolation surface: this module never builds
# markup by string concatenation, so there is nothing to inject into. The one
# exception is the `<!doctype html>` prefix in `page-html`, which carries no
# caller data.

[?lib 'cx-x/ux' :as ux]
[?lib 'cx-stdlib/html' :as html]
[?lib 'cx-stdlib/hash' :as hash]
[?lib 'cx-stdlib/re' :as re]
[?lib 'cx-stdlib/io' :as io]
[?lib 'cx-stdlib/strings' :as strings]
[?lib 'cx-stdlib/url' :as url]

# ── §1 The pinned htmx subset (P0-31, R4) ───────────────────────────────────
#
# The initial NORMATIVE attribute set. Additions are individual rulings.
# `hx-on` is excluded PERMANENTLY (R4) — it is what keeps strict CSP possible.
# Excluded until individually ruled in: hx-boost, hx-push-url, hx-vals,
# hx-confirm, hx-select, hx-sync, and every non-POST write verb (commands post
# — but a FILTER is a query, so it reads with `hx-get`, which the subset has
# carried since W1).
[?def htmx-subset scope=public pure [returns any] ()
  ("hx-get", "hx-post", "hx-target", "hx-swap", "hx-swap-oob", "hx-trigger",
   "hx-include", "hx-indicator", "hx-ext", "sse-connect", "sse-swap")]

# htmx-allowed — is one attribute name on the pinned list?
[?def htmx-allowed scope=public pure [returns bool] ($attr::string)
  [$exists [?for [in $x [$htmx-subset]] [where [= $x $attr]] [yield $x]]]]

# hx-name — THE name gate for every htmx attribute this emitter authors.
# `[?attr]` is valid only lexically inside an element body, so the gate cannot
# be a constructor that returns an attribute; it gates the NAME instead, and
# `[?element]`'s absence channel (an empty name omits the attribute) does the
# rest. An off-list name therefore cannot be emitted at all, and `$value`
# absence omits an optional attribute rather than emitting an empty one.
[?def hx-name pure [returns any] ($attr::string $value::any)
  [?if [and [$htmx-allowed $attr] [$exists $value]]
    [then $attr]
    [else ()]]]

# ── §2 Lowering: semantic element → HTML (P0-32) ────────────────────────────
#
# One function, one dispatch, one serializer. Text content and attribute
# values are escaped BY CONSTRUCTION because the tree reaches
# `[$html:serialize]` as a tree — never as markup text.

# lower — one semantic element → its HTML element, in the fragment context
# $ctx {route, feature, path, bind}. Assumes `refusals-of` was empty.
[?def lower scope=public pure [returns any] ($el::any $c0::map)
  [?if [$ux:seq-child $el]
    [then [?for [in $m $el] [yield [$lower $m $c0]]]]
    [else [$lower-el $el $c0]]]]

[?def lower-el pure [returns any] ($el::any $c0::map)
  [?let [= $n [$name $el]] [= $ctx [$ux:descend $el $c0]]
    [?match $n
      [case "ux:region"   [$lower-region $el $ctx]]
      [case "ux:card"     [$box "section" "ux-card"    $el $ctx [$lower-kids $el $ctx]]]
      [case "ux:heading"  [$box [$concat "h" [$ux:level-of $el]] "ux-heading" $el $ctx [$lower-body $el $ctx]]]
      [case "ux:text"     [$box "p"       "ux-text"    $el $ctx [$lower-body $el $ctx]]]
      [case "ux:field"    [$box "div" "ux-field" $el $ctx [$lower-field $el $ctx]]]
      [case "ux:badge"    [$box "span" [$concat "ux-badge ux-badge-" [$ux:str-or $el@tone "neutral"]] $el $ctx [$lower-body $el $ctx]]]
      [case "ux:list"     [$box "ul"      "ux-list"    $el $ctx [$lower-kids $el $ctx]]]
      [case "ux:item"     [$box "li"      "ux-item"    $el $ctx [$lower-body $el $ctx]]]
      [case "ux:table"    [$box "table"   "ux-table"   $el $ctx [$lower-kids $el $ctx]]]
      [case "ux:columns"  [$box "thead"   "ux-columns" $el $ctx [?element "tr" [$lower-kids $el $ctx]]]]
      [case "ux:column"   [$box-x "th" "ux-column" "scope" "col" $el $ctx [$lower-body $el $ctx]]]
      [case "ux:rows"     [$lower-rows-el $el $ctx]]
      [case "ux:row"      [$lower-row $el $ctx ()]]
      [case "ux:cell"     [$box "td"      "ux-cell"    $el $ctx [$lower-body $el $ctx]]]
      [case "ux:nav"      [$box "nav"     "ux-nav"     $el $ctx [?element "ul" [$lower-kids $el $ctx]]]]
      [case "ux:nav-item" [$lower-nav-item $el $ctx]]
      [case "ux:link"     [?element "a" class="ux-link" [?attr "href" [$string $el@href]] [$ux:label-of $el]]]
      [case "ux:action"   [$lower-action $el $ctx]]
      [case "ux:form"     [$lower-form $el $ctx]]
      [case "ux:input"    [$lower-input $el $ctx]]
      [; PLACED form controls paint their minted address as data-cx-frag ONLY
         (W22 audit letter c): the DOM id on a form control is the label-
         binding id, already spoken for — and the id is a derived rendering
         of the address, never a second identity, so the recoverable half is
         the one that must not go missing. Structural members below paint
         both, box-x's pattern. ]
      [case "ux:hidden"   [?element "input" type="hidden" [?attr "name" [$string $el@name]] [?attr "value" [$string $el@value]]
                            [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]]
                                   [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ""]]]]]
      [; the submit is the ONE act a command form offers, so it wears the
         primary tokens by class — `.ux-submit` beside `.ux-action`, appearance
         decided in the stylesheet like everything else (W22 audit, F11: the
         checkout's advance was the quietest control on its page). ]
      [case "ux:submit"   [?element "button" type="submit" class="ux-action ux-submit"
                            [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]]
                                   [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ""]]]
                            [$ux:label-of $el]]]
      [case "ux:error"    [$box-x "div" "ux-error" "role" "alert" $el $ctx [$lower-body $el $ctx]]]
      [; `role=status` and not `role=alert`: a commit is not an interruption,
         and a screen reader should announce it when it gets to it rather than
         cut across whatever the operator is doing. ]
      [case "ux:notice"   [$box-x "div" [$concat "ux-notice ux-notice-" [$ux:str-or $el@tone "info"]]
                                  "role" "status" $el $ctx [$lower-body $el $ctx]]]
      [case "ux:select"   [$lower-select $el $ctx]]
      [; `selected` is DERIVED from the parent select's value= (lower-kids-
         selected below) — it was never a member attribute, and the one-
         renderer read that used to sit here is gone with P0-98: the shared
         gate now refuses `selected=` on an option, so honoring it here would
         honor a tree the gate never admits. ]
      [case "ux:option"   [?element "option" [?attr "value" [$string $el@value]]
                            [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]]
                                   [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ""]]]
                            [$ux:label-of $el]]]
      [case "ux:group"    [$lower-group $el $ctx]]
      [case "ux:filter"   [$lower-filter $el $ctx]]

      [; ── the W10 members ──────────────────────────────────────────────── ]
      [case "ux:media"      [$lower-media $el $ctx]]
      [case "ux:grid"       [$box "div" [$concat "ux-grid ux-grid-" [$ux:str-or $el@density "comfortable"]]
                                  $el $ctx [$lower-kids $el $ctx]]]
      [; a param is not a control — it is what the action posts. `lower-action`
         emits it as a hidden field inside the action's own form; reaching one
         on its own means it was placed outside an action, which posts nothing
         and is caught by the semantic gate rather than rendered as nothing. ]
      [case "ux:param"      ()]
      [case "ux:steps"      [$lower-steps $el $ctx]]
      [case "ux:step"       [$lower-step $el $ctx]]
      [case "ux:quantity"    [$lower-quantity $el $ctx]]
      [case "ux:breadcrumb" [$box-x "nav" "ux-breadcrumb" "aria-label" "Breadcrumb" $el $ctx
                                    [?element "ol" [$lower-kids $el $ctx]]]]
      [case "ux:crumb"      [$lower-crumb $el $ctx]]
      [case "ux:pager"      [$lower-pager $el $ctx]]
      [case "ux:page-link"  [$lower-page-link $el $ctx]]
      [case "ux:facet"      [?let [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
                              [?element "div" class="ux-facet"
                                [?attr "data-cx-name" [$ux:str-or $el@name ""]]
                                [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
                                [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
                                [?element "h3" class="ux-facet-label"
                                  [$ux:str-or $el@label [$ux:label-of-name [$ux:str-or $el@name ""]]]]
                                [?element "ul" class="ux-facet-values" [$lower-kids $el $ctx]]]]]
      [case "ux:facet-value" [$lower-facet-value $el $ctx]]
      [case "ux:sort"       [?let [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
                              [?element "nav" class="ux-sort" aria-label="Sort order"
                                [?attr "data-cx-name" [$ux:str-or $el@name ""]]
                                [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
                                [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
                                [?element "span" class="ux-sort-label"
                                  [$ux:str-or $el@label [$ux:label-of-name [$ux:str-or $el@name ""]]]]
                                [?element "ul" class="ux-sort-options" [$lower-kids $el $ctx]]]]]
      [case "ux:sort-option" [$lower-sort-option $el $ctx]]
      [case "ux:aside"      [$lower-aside $el $ctx]]
      [; P0-101: a named group of peer blocks — a `section` landmark carrying
         the label as its accessible name. Rail/track assignment is a token
         decision over the DECLARED name (data-cx-panel), never a selector
         guess over the panel's children. ]
      [case "ux:panel"      [$lower-panel $el $ctx]]
      [; PRESENT FROM FIRST PAINT (P0-93). A live region inserted at the same
         moment as its first message is not announced by most assistive
         technology — a defect testing with a screen reader finds and testing
         without one never does. So an EMPTY ux:status still emits its element:
         the region is the thing that has to exist early, not the sentence. ]
      [case "ux:status"     [$box-x "div" [$concat "ux-status ux-status-" [$ux:str-or $el@tone "info"]]
                                    "aria-live" [?if [= [$ux:str-or $el@tone "info"] "danger"]
                                                  [then "assertive"] [else "polite"]]
                                    $el $ctx
                                    [?element "span"
                                      [?attr "role" [?if [= [$ux:str-or $el@tone "info"] "danger"]
                                                      [then "alert"] [else "status"]]]
                                      [$lower-body $el $ctx]]]]
      [else ()]]]]

# ── §3.5 the W10 lowerings ──────────────────────────────────────────────────

# lower-media — a depiction. `alt` rides verbatim (the semantic gate already
# refused a media element without one). No inline `style=` and no width/height
# attributes: the aspect ratio and the fit are token decisions (P0-33), which
# is what lets a rebrand change how tall every product picture is without
# touching a projection.
[; every structural member below paints its minted address when placed —
   box-x's two attributes, inlined (W22 audit letter c: eleven-plus members
   minted addresses the DOM never carried, so the address participated in
   collision checks and reached no swap, no anchor and no reader). ]
[?def lower-media pure [returns any] ($el::any $ctx::map)
  [?let [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "img"
      [?attr "class" [$concat "ux-media ux-media-" [$ux:str-or $el@kind "illustration"]]]
      [?attr "src" [$string $el@src]]
      [?attr "alt" [$string $el@alt]]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?attr "loading" "lazy"]
      [?attr "decoding" "async"]]]]

# lower-steps — the flow position. `aria-current="step"` on the current one is
# the whole accessibility contract for a quantity, and it is the thing that is
# always forgotten because it is invisible.
[?def lower-steps pure [returns any] ($el::any $ctx::map)
  [?let [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "nav" class="ux-steps" aria-label="Checkout progress"
      [?attr "data-cx-name" [$ux:str-or $el@name ""]]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?element "ol" class="ux-steps-list" [$lower-kids $el $ctx]]]]]

[?def lower-step pure [returns any] ($el::any $ctx::map)
  [?let
    [= $st  [$ux:str-or $el@state "ahead"]]
    [= $lab [$ux:str-or $el@label [$ux:label-of-name [$ux:str-or $el@name ""]]]]
    [; the step's NAME rides data-cx-step — the class carries the STATE, and
       until W17 the name was simply not in the HTML, so the readback answered
       c:unknown for every step and `current=` with a state instead of a name.
       Found by the R2 checkout composite, the first fixture to read a steps
       block back from this face. ]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "li"
      [?attr "class" [$concat "ux-step ux-step-" $st]]
      [?attr "data-cx-step" [$ux:str-or $el@name ""]]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?attr [?if [= $st "current"] [then "aria-current"] [else ()]] "step"]
      [?if [= $st "ahead"]
        [then [?element "span" class="ux-step-label" $lab]]
        [else [?element "a" class="ux-step-label"
                [?attr "href" [$ux:str-or $el@href ""]] $lab]]]]]]

# lower-quantity — a bounded quantity. Three REAL submits, not a client-side
# counter (P0-82): each posts the whole intent, so a stale tab cannot hold a
# number the server does not have.
#
# AT A BOUND THE AFFORDANCE IS DISABLED, NEVER ABSENT (P0-58). A control that
# disappears at `min` moves everything beside it, and geometry that changes
# under the cursor makes people click the wrong thing.
[?def lower-quantity pure [returns any] ($el::any $ctx::map)
  [?if [$exists $el@verb]
    [then [$lower-quantity-acts $el $ctx]]
    [else [$lower-quantity-field $el $ctx]]]]

[?def lower-quantity-acts pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n    [$string $el@name]]
    [= $cur  [$cast [$ux:str-or $el@value "1"] :int]]
    [= $lo   [$cast [$ux:str-or $el@min "0"] :int]]
    [= $hi   [$cast [$ux:str-or $el@max "999"] :int]]
    [= $stp  [$cast [$ux:str-or $el@step "1"] :int]]
    [= $lab  [$ux:str-or $el@label [$ux:label-of-name $n]]]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "div" class="ux-quantity" role="group"
      [?attr "aria-label" $lab]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [; the bounds are STATED, not inferred from which arm happens to be
         disabled. Inferring them worked only at a bound, which is the one
         case a fixture is least likely to exercise — a readback that is
         correct only in the corner is a readback that lies in the middle. ]
      [?attr "data-cx-name" $n]
      [?attr "data-cx-verb" [$string $el@verb]]
      [?attr "data-cx-min" [$ux:str-or $el@min "0"]]
      [?attr "data-cx-max" [$ux:str-or $el@max ""]]
      [$quantity-arm $el $ctx [- $cur $stp] [<= $cur $lo] "-" [$concat "One fewer " $lab]]
      [; DIRECT ENTRY (W23 letter (i)): the number between the arms is a real
         input in a real form — type a value, press enter, the whole intent
         posts. Kernel-free, exactly like the arms. ]
      [$quantity-entry $el $ctx $cur $lab]
      [$quantity-arm $el $ctx [+ $cur $stp] [>= $cur $hi] "+" [$concat "One more " $lab]]]]]

[?def quantity-entry pure [returns any] ($el::any $ctx::map $cur::int $lab::string)
  [?let
    [= $act [$concat "/intent/" [$string $el@verb]]]
    [= $t   [$target-id $el $ctx]]
    [= $s   [$affects-swap $el $ctx]]
    [?element "form" class="ux-quantity-arm" method="post"
      [?attr "action" $act]
      [?attr [$hx-name "hx-post"   "post"] $act]
      [?attr [$hx-name "hx-target" $t]     [$string $t]]
      [?attr [$hx-name "hx-swap"   $s]     [$string $s]]
      [?for [in $p $el/ux:param]
        [yield [?element "input" type="hidden"
                 [?attr "name" [$string $p@name]] [?attr "value" [$string $p@value]]]]]
      [?element "input" type="number" class="ux-quantity-value"
        [?attr "aria-label" $lab]
        [?attr "name" [$string $el@name]]
        [?attr "value" [$string $cur]]
        [?attr "min" [$ux:str-or $el@min "0"]]
        [?attr [?if [= [$ux:str-or $el@max ""] ""] [then ()] [else "max"]] [$ux:str-or $el@max ""]]
        [?attr "step" [$ux:str-or $el@step "1"]]]]]]

[; FIELD MODE (W23, audit2 letter (i)): no verb, so no wire of its own — the
   quantity is a bounded field of the ENCLOSING form, and the browser is the
   shell that steps it. One labeled number input; the label binds by DOM id
   (the id is a derived rendering, the identity stays the frag — DP4 (c)). ]
[?def lower-quantity-field pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n   [$string $el@name]]
    [= $lab [$ux:str-or $el@label [$ux:label-of-name $n]]]
    [= $cid [$concat [?else $ctx.form "ux"] "-qty-" $n]]
    [?element "div" class="ux-quantity ux-quantity-field" role="group"
      [?attr "aria-label" $lab]
      [?attr "data-cx-name" $n]
      [?attr "data-cx-verb" ""]
      [?attr "data-cx-min" [$ux:str-or $el@min "0"]]
      [?attr "data-cx-max" [$ux:str-or $el@max ""]]
      [?element "label" class="ux-label" [?attr "for" $cid] $lab]
      [?element "input" type="number" class="ux-control ux-quantity-direct"
        [?attr "id" $cid]
        [?attr "name" $n]
        [?attr "value" [$ux:str-or $el@value "1"]]
        [?attr "min" [$ux:str-or $el@min "0"]]
        [?attr [?if [= [$ux:str-or $el@max ""] ""] [then ()] [else "max"]] [$ux:str-or $el@max ""]]
        [?attr "step" [$ux:str-or $el@step "1"]]]]]]

[?def quantity-arm pure [returns any] ($el::any $ctx::map $to::int $off::bool $glyph::string $aria::string)
  [?let
    [= $act [$concat "/intent/" [$string $el@verb]]]
    [= $t   [$target-id $el $ctx]]
    [= $s   [$affects-swap $el $ctx]]
    [?element "form" class="ux-quantity-arm" method="post"
      [?attr "action" $act]
      [?attr [$hx-name "hx-post"   "post"] $act]
      [?attr [$hx-name "hx-target" $t]     [$string $t]]
      [?attr [$hx-name "hx-swap"   $s]     [$string $s]]
      [?for [in $p $el/ux:param]
        [yield [?element "input" type="hidden"
                 [?attr "name" [$string $p@name]] [?attr "value" [$string $p@value]]]]]
      [?element "input" type="hidden"
        [?attr "name" [$string $el@name]] [?attr "value" [$string $to]]]
      [?element "button" type="submit" class="ux-quantity-button"
        [?attr "aria-label" $aria]
        [?attr [?if $off [then "disabled"] [else ()]] "disabled"]
        $glyph]]]]

[?def lower-crumb pure [returns any] ($el::any $ctx::map)
  [?let [= $cur [= [$ux:str-or $el@current "false"] "true"]]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "li" class="ux-crumb"
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?if $cur
        [then [?element "span" [?attr "aria-current" "page"] [$ux:str-or $el@label ""]]]
        [else [?element "a" [?attr "href" [$ux:str-or $el@href ""]] [$ux:str-or $el@label ""]]]]]]]

# lower-pager — a window over an ordered collection. The total is stated when
# the surface knows it and OMITTED when it does not (P0-60): a pager that
# cannot count says nothing rather than guessing, because a wrong total is a
# customer counting pages that are not there.
[?def lower-pager pure [returns any] ($el::any $ctx::map)
  [$box-x "nav" "ux-pager" "aria-label" "Pagination" $el $ctx
    ([?element "a" class="ux-pager-prev"
       [?attr [?if [= [$ux:str-or $el@prev-href ""] ""] [then "aria-disabled"] [else "href"]]
              [?if [= [$ux:str-or $el@prev-href ""] ""] [then "true"] [else [$ux:str-or $el@prev-href ""]]]]
       "Previous"],
     [?element "ol" class="ux-pager-pages" [$lower-kids $el $ctx]],
     [?element "a" class="ux-pager-next"
       [?attr [?if [= [$ux:str-or $el@next-href ""] ""] [then "aria-disabled"] [else "href"]]
              [?if [= [$ux:str-or $el@next-href ""] ""] [then "true"] [else [$ux:str-or $el@next-href ""]]]]
       "Next"],
     [?element "span" class="ux-pager-count"
       [?if [= [$ux:str-or $el@total ""] ""]
         [then [$concat "Page " [$ux:str-or $el@page "1"] " of " [$ux:str-or $el@pages "1"]]]
         [else [$concat "Page " [$ux:str-or $el@page "1"] " of " [$ux:str-or $el@pages "1"]
                        " \u2014 " [$ux:str-or $el@total ""] " items"]]]])]]

[?def lower-page-link pure [returns any] ($el::any $ctx::map)
  [?let [= $cur [= [$ux:str-or $el@current "false"] "true"]]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "li" class="ux-page-link"
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?element "a"
        [?attr "href" [$ux:str-or $el@href ""]]
        [?attr [?if $cur [then "aria-current"] [else ()]] "page"]
        [?attr "class" [?if $cur [then "ux-page-current"] [else "ux-page-other"]]]
        [$ux:str-or $el@n ""]]]]]

# lower-facet-value — the count is what makes a facet a facet, so it is
# rendered as text beside the label rather than as a decoration.
[?def lower-facet-value pure [returns any] ($el::any $ctx::map)
  [?let [= $sel [= [$ux:str-or $el@selected "false"] "true"]]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "li" [?attr "class" [?if $sel [then "ux-facet-value ux-facet-on"] [else "ux-facet-value"]]]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?element "a"
        [?attr "href" [$ux:str-or $el@href ""]]
        [?attr "data-cx-value" [$ux:str-or $el@value ""]]
        [?attr [?if $sel [then "aria-pressed"] [else ()]] "true"]
        [?element "span" class="ux-facet-mark" [?if $sel [then "\u2713"] [else "\u00a0"]]]
        [?element "span" class="ux-facet-name" [$ux:str-or $el@label [$ux:str-or $el@value ""]]]
        [?element "span" class="ux-facet-count" [$ux:str-or $el@count ""]]]]]]

[?def lower-sort-option pure [returns any] ($el::any $ctx::map)
  [?let [= $sel [= [$ux:str-or $el@selected "false"] "true"]]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "li" [?attr "class" [?if $sel [then "ux-sort-option ux-sort-on"] [else "ux-sort-option"]]]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?element "a"
        [?attr "href" [$ux:str-or $el@href ""]]
        [?attr "data-cx-value" [$ux:str-or $el@value ""]]
        [?attr [?if $sel [then "aria-current"] [else ()]] "true"]
        [$ux:str-or $el@label [$ux:str-or $el@value ""]]]]]]

# lower-nav-item — a place you go. A nav item declaring `live=<feed>` LISTENS
# (W24, P0-44): its anchor carries `sse-swap=<event>` and the event's payload
# becomes its text — route-neutral by construction, because the words change
# and the href stays this page's own. The region above owns the connection.
[?def lower-nav-item pure [returns any] ($el::any $ctx::map)
  [?let
    [= $fb [?if [$exists $el@live]
             [then [$ux:feed-binding [$rctx-of $ctx] [$string $el@live]]]
             [else ()]]]
    [= $b  [?if [$exists $fb] [then [$first $fb]] [else ()]]]
    [$box "li" "ux-nav-item" $el $ctx
      [?element "a" [?attr "href" [$string $el@href]]
        [?attr [$hx-name "sse-swap" [?if [$exists $fb] [then $b@event] [else ()]]] [$string $b@event]]
        [$ux:label-of $el]]]]]

# lower-aside — a secondary region. NOT A MODAL: the primary region stays
# reachable and nothing traps focus. The dismiss is a LINK, because dismissing
# is a navigation and the open state is in the URL (P0-63) — which is also why
# a shared link to an open basket opens the basket.
[?def lower-aside pure [returns any] ($el::any $ctx::map)
  [?let
    [= $open [= [$ux:str-or $el@open "false"] "true"]]
    [; An OPEN aside declaring `live=<feed>` refetches ITSELF on the feed's
       event (W24, P0-44): `hx-get` to the binding's `refetch=` endpoint with
       its own location as `return=`, triggered by `sse:<event>`, swapping
       itself whole. Pushed CONTENT cannot carry another page's targets \u2014 a
       fragment address is (route, feature instance, element path), so the
       stepper ids inside a pushed body would name the PUBLISHER's page.
       That is why the aside listens-and-refetches (one GET per push,
       rendered for its own route) where the badge, whose payload is
       route-neutral words, swaps the push directly. ]
    [= $fb [?if [and $open [$exists $el@live]]
             [then [$ux:feed-binding [$rctx-of $ctx] [$string $el@live]]]
             [else ()]]]
    [= $b  [?if [$exists $fb] [then [$first $fb]] [else ()]]]
    [= $rf [?if [$exists $fb] [then [$ux:str-or $b@refetch ""]] [else ""]]]
    [= $head [?element "div" class="ux-aside-head"
               ([?element "h2" class="ux-aside-title" [$string $el@label]],
                [?if $open
                  [then [?element "a" class="ux-aside-dismiss"
                          [?attr "href" [$string $el@dismiss-href]]
                          [?attr "aria-label" [$concat "Close " [$string $el@label]]] "\u00d7"]]
                  [else ()]])]]
    [= $body [?element "div" class="ux-aside-body" [$lower-kids $el $ctx]]]
    [?if [= $rf ""]
      [then [$box-x "aside" [?if $open [then "ux-aside ux-aside-open"] [else "ux-aside"]]
                    "aria-label" [$string $el@label] $el $ctx
              ($head, $body)]]
      [else
        [?element "aside"
          [?attr "class" [?if $open [then "ux-aside ux-aside-open"] [else "ux-aside"]]]
          [?attr "aria-label" [$string $el@label]]
          [?attr [$hx-name "hx-get"     "g"] [$concat $rf "?return=" [$url:encode [$ux:str-or $el@dismiss-href "/"]]]]
          [?attr [$hx-name "hx-trigger" "t"] [$concat "sse:" [$string $b@event]]]
          [?attr [$hx-name "hx-target"  "x"] "this"]
          [?attr [$hx-name "hx-swap"    "s"] "outerHTML"]
          $head
          $body]]]]]

# box — the ONE place a placed element's address is minted. An element carrying
# an author-assigned id is a placed element (P0-16): its path step is that id
# (already applied by `descend`), so it gets the DOM id and the readable
# address, and `#cx-<hash16>` deep links resolve to it (P0-11). An element
# without an id is structure, not a placed element, and carries no address.
# `$xn`/`$xv` carry ONE extra attribute (an empty `$xn` omits it) — enough for
# the members that need `scope` or `role`, and cheaper than a near-copy of this
# function per member. Attributes cannot be returned from a function at all
# (`[?attr]` is valid only lexically inside an element body), so a passthrough
# pair is the available shape.
# lower-rows-el -- the collection, and the feed's SWAP TARGET when it is live.
# The region owns the connection (one per page); the collection owns the swap,
# because that is the only parse context in which a `<tr>` payload survives.
[?def lower-rows-el pure [returns any] ($el::any $ctx::map)
  [?let
    [= $fb [?if [$exists $el@live]
             [then [$ux:feed-binding [$rctx-of $ctx] [$string $el@live]]]
             [else ()]]]
    [= $b  [?if [$exists $fb] [then [$first $fb]] [else ()]]]
    [= $r  [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [?element "tbody"
      [?attr "class" "ux-rows"]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?attr [$hx-name "sse-swap" [?if [$exists $fb] [then $b@event] [else ()]]] [$string $b@event]]
      [?attr [$hx-name "hx-swap"  [?if [$exists $fb] [then "innerHTML"] [else ()]]] "innerHTML"]
      [$lower-kids $el $ctx]]]]

[?def box pure [returns any] ($tag::string $class::string $el::any $ctx::map $body::any)
  [$box-x $tag $class () "" $el $ctx $body]]

[?def box-x pure [returns any] ($tag::string $class::string $xn::any $xv::string $el::any $ctx::map $body::any)
  [?let
    [; ONE canonicalization per addressed element, not two — see
       `ux:frag-id-of`. The id is derived from the repr, byte-identically. ]
    [= $r [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ()]]]
    [; P0-109 (W26): in EDIT MODE ONLY, the emitter stamps the resolved edit
       target beside data-cx-frag — `[placed <id>]` for an element carrying an
       author-assigned id (regime 4), `[claim <addr> <path>]` for a formatted
       field whose claim key the projection resolved (regime 1) — plus the
       hint provenance and the placed element's component facts the inspector
       shows. A normal render ($ed false) evaluates ONE cheap path read and
       emits nothing: byte-identical by construction, pinned by goldens on
       both sides. ]
    [= $ed [$edit-on $ctx]]
    [= $claim  [?if [and $ed [and [not [$exists $el@id]]
                                  [and [= [$name $el] "ux:field"] [$exists $el@format]]]]
                 [then [$sel-claim-entry $ctx [$ux:str-or $el@label ""]]]
                 [else ()]]]
    [; SELECTION IS MEMBERSHIP, not merely having an id. An element is a regime-4
       target only if the arrangement actually holds a placed element of that id
       — which is what `sel-placed` reports. Stamping every id'd element instead
       told the studio that a projection's own output (a department card, a
       product tile) was addressable, so a designer could drag one and the
       engine would answer `ux-layout-address-miss` on an id no command can
       name. An editor must not be offered a gesture that cannot succeed. ]
    [= $sp   [?if [and $ed [$exists $el@id]]
               [then [$sel-placed-entry $ctx [$ux:str-or $el@id ""]]] [else ()]]]
    [= $placed [and $ed [$ux:found $sp]]]
    [= $prov [?if $placed [then [$sel-prov-of $ctx [$ux:str-or $el@id ""]]] [else ""]]]
    [= $span [?if [$exists $el@id]
               [then [$place-span-of $ctx [$ux:str-or $el@id ""]]]
               [else ""]]]
    [= $eid  [$ux:str-or $el@id ""]]
    [= $v1 [?if [$exists $el@id] [then [$place-var-nth $ctx $eid 1]] [else ()]]]
    [= $v2 [?if [$exists $el@id] [then [$place-var-nth $ctx $eid 2]] [else ()]]]
    [= $v3 [?if [$exists $el@id] [then [$place-var-nth $ctx $eid 3]] [else ()]]]
    [= $v4 [?if [$exists $el@id] [then [$place-var-nth $ctx $eid 4]] [else ()]]]
    [= $kit [?if [$exists $el@id] [then [$place-kit-of $ctx $eid]] [else ""]]]
    [= $col [?if [$exists $el@id] [then [$place-col-of $ctx $eid]] [else ""]]]
    [= $spn [?if [$exists $el@id] [then [$place-span-narrow-of $ctx $eid]] [else ""]]]
    [= $hasc [$ux:found $claim]]
    [= $hass [$ux:found $sp]]
    [?element $tag
      [?attr "class" $class]
      [?attr $xn $xv]
      [?attr [?if [$exists $el@id] [then "id"] [else ()]]           [?if [$exists $el@id] [then [$ux:frag-id-of $r]] [else ""]]]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]] [?if [$exists $el@id] [then $r] [else ""]]]
      [?attr [?if $placed [then "data-cx-sel"] [else ()]]
             [$concat "[placed " [$ux:str-or $el@id ""] "]"]]
      [?attr [?if $hasc [then "data-cx-sel"] [else ()]]
             [?if $hasc
               [then [$concat "[claim " [$ux:str-or $claim@addr ""] " " [$ux:str-or $claim@path ""] "]"]]
               [else ""]]]
      [?attr [?if $hasc [then "data-cx-sel-prov"] [else ()]] [$ux:str-or $claim@prov ""]]
      [?attr [?if [and $placed [not [= $prov ""]]] [then "data-cx-sel-prov"] [else ()]] $prov]
      [?attr [?if $hass [then "data-cx-sel-component"] [else ()]] [$ux:str-or $sp@component ""]]
      [?attr [?if $hass [then "data-cx-sel-container"] [else ()]] [$ux:str-or $sp@container "false"]]
      [?attr [?if [and $hass [= [$ux:str-or $sp@fixed "false"] "true"]] [then "data-cx-sel-fixed"] [else ()]] "true"]
      [?attr [?if [and $hass [not [= [$ux:str-or $sp@params ""] ""]]] [then "data-cx-sel-params"] [else ()]]
             [$ux:str-or $sp@params ""]]
      [?attr [?if [and $hass [not [= [$ux:str-or $sp@vars ""] ""]]] [then "data-cx-sel-vars"] [else ()]]
             [$ux:str-or $sp@vars ""]]
      [?attr [?if [= $span ""] [then ()] [else "data-cx-span"]] $span]
      [?attr [?if [= $kit ""] [then ()] [else "data-cx-kit"]] $kit]
      [?attr [?if [= $col ""] [then ()] [else "data-cx-col"]] $col]
      [?attr [?if [= $spn ""] [then ()] [else "data-cx-span-narrow"]] $spn]
      [?attr [?if [$ux:found $v1] [then [$concat "data-cx-var-" [$ux:str-or $v1@name ""]]] [else ()]] [$ux:str-or $v1@value ""]]
      [?attr [?if [$ux:found $v2] [then [$concat "data-cx-var-" [$ux:str-or $v2@name ""]]] [else ()]] [$ux:str-or $v2@value ""]]
      [?attr [?if [$ux:found $v3] [then [$concat "data-cx-var-" [$ux:str-or $v3@name ""]]] [else ()]] [$ux:str-or $v3@value ""]]
      [?attr [?if [$ux:found $v4] [then [$concat "data-cx-var-" [$ux:str-or $v4@name ""]]] [else ()]] [$ux:str-or $v4@value ""]]
      $body]]]

# lower-kids / lower-body — container children vs a text leaf. Mixed content
# was refused by the core's shared gate, so exactly one of these applies to any
# given element.
[?def lower-kids pure [returns any] ($el::any $ctx::map)
  [?for [in $k $el/*] [yield [$lower $k $ctx]]]]

[; `format=` is applied HERE, through `[$ux:formatted]` — the same def the
   terminal renderer calls and the same def the content normal form calls. Two
   renderers disagreeing about where a thousands separator goes would be a
   defect and not neutrality (P0-65), so the formatting is shared even though
   the control choice is not. ]
[?def lower-body pure [returns any] ($el::any $ctx::map)
  [?if [$exists $el/*]
    [then [$lower-kids $el $ctx]]
    [else [$ux:formatted $el [$string $el]]]]]

# ── the render context, read here and only here ─────────────────────────────
#
# `target=`, `swap=`, `ext=`, `subscribe=`, `on=` and `oob=` used to be
# attributes an author wrote on a semantic element. They are now DERIVED: from
# a semantic declaration (`live=`, `affects=`) plus the render context
# document. Nothing below reads a renderer concept off the tree.

[?def rctx-of pure [returns any] ($ctx::map) [?else $ctx.bind ()]]

# ── EDIT MODE (P0-109, W26): the studio is this emitter with edit engaged ────
#
# Edit-mode data rides the RENDER CONTEXT, never the fragment-context map —
# the bind flows untouched through every descent (`ctx-at`, `child-ctx`, the
# form context), so engaging edit changes NOTHING about addressing, and a
# normal render (no `[edit]` child in the context) is byte-identical by
# construction. The serving boundary amends the context per editor render:
#
#   [ux:render-ctx …
#     [edit components="hero promo group" return="/?edit=1"]
#     [sel-placed id=depts component=departments container=false]
#     [sel-prov   id=depts hint=density level=surface]
#     [sel-claim  label=Price addr=sha2-256:… path=/price prov=platform]]
#
# `[edit]` presence IS edit mode (the boundary adds it only for a session
# carrying the ux:edit claim — the PEP still rechecks every command).
# `sel-placed` entries carry what the inspector needs about a placed element
# (its component, whether it is a container); `sel-prov` carries hint
# provenance by cascade level (P0-107's override-here display); `sel-claim`
# resolves a formatted field to its regime-1 claim key — the resolution the
# projection computed anyway, stamped rather than re-derived (ST-2a: one
# resolver, zero round-trips).

[?def edit-on pure [returns bool] ($ctx::map)
  [?let [= $rctx [$rctx-of $ctx]]
    [$ux:found $rctx/edit]]]

[?def edit-of pure [returns any] ($ctx::map)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/edit] [yield $e]]]
    [?if [$ux:absent $hits] [then ()] [else [$first $hits]]]]]

[?def sel-placed-entry pure [returns any] ($ctx::map $id::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/sel-placed]
               [where [= [$ux:str-or $e@id ""] $id]] [yield $e]]]
    [?if [$ux:absent $hits] [then ()] [else [$first $hits]]]]]

[; each honored hint stamps `name:level:value` — the LEVEL is the cascade
   provenance (P0-107's override-here display) and the VALUE is the current
   surface-level value ("" when inherited), which is exactly the prior the
   set-hint inverse restores (ST-7a: "the inspector already displays the
   prior"). The value is URL-encoded so a value carrying ':' or ' ' cannot
   break the pair grammar. ]
[?def sel-prov-of pure [returns string] ($ctx::map $id::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $pairs [?for [in $e $rctx/sel-prov]
                [where [= [$ux:str-or $e@id ""] $id]]
                [yield [$concat [$ux:str-or $e@hint ""] ":" [$ux:str-or $e@level ""]
                                ":" [$url:encode [$ux:str-or $e@value ""]]]]]]
    [?if [$ux:absent $pairs] [then ""] [else [$strings:join $pairs " "]]]]]

[?def sel-claim-entry pure [returns any] ($ctx::map $label::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/sel-claim]
               [where [= [$ux:str-or $e@label ""] $label]] [yield $e]]]
    [?if [$ux:absent $hits] [then ()] [else [$first $hits]]]]]

# ── the ARRANGED region (W26 owner review): spans as surface data ────────────
#
# An arrangement document's elements may carry a `span` hint (1..12). The
# TREE stays layout-blind (P0-20: no CSS-shaped layout in the vocabulary);
# the realization is THIS renderer's, driven by render-context entries the
# serving boundary derives from the arrangement:
#
#   [arranged feature=home]                 the region that lays out as a grid
#   [place-span id=featured span=6]         one element's column span
#
# The emitter stamps `data-cx-arranged` on the region and `data-cx-span` on
# the matching placed elements; the pack stylesheet realizes them as a
# 12-column grid. The terminal face never reads these entries — unread, not
# refused, exactly the [swap] discipline. NOT edit-gated: the span is the
# arrangement itself, rendered for every visitor; edit mode merely makes it
# draggable.

[; MULTIPLE features may be arranged in one render (the page's own region and
   the shell's, or a route's region beside them) — membership, not one name. ]
[?def arranged-has pure [returns bool] ($ctx::map $feature::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [$ux:found [?for [in $a $rctx/arranged]
                 [where [= [$ux:str-or $a@feature ""] $feature]] [yield $a]]]]]

[?def place-span-of pure [returns string] ($ctx::map $id::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/place-span]
               [where [= [$ux:str-or $e@id ""] $id]]
               [yield [$ux:str-or $e@span ""]]]]
    [?if [$ux:absent $hits] [then ""] [else [$first $hits]]]]]

[; a placed element's VARIANTS (P0-113/P0-121) realize on this face as
   data-cx-var-<name> attributes — [place-var id= name= value=] entries in the
   render context, derived from surface hints. FOUR SLOTS, because a container
   carries several axes at once (tracks, gap, alignment, padding, ground) and
   [?attr] is lexical: one slot per axis, filled by position. ]
[; a NARROW-TIER span (DS-7): the width this element takes below the pack's
   880px breakpoint. Editing it is what the studio's viewport switcher does. ]
[?def place-span-narrow-of pure [returns string] ($ctx::map $id::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/place-span-narrow]
               [where [= [$ux:str-or $e@id ""] $id]]
               [yield [$ux:str-or $e@span ""]]]]
    [?if [$ux:absent $hits] [then ""] [else [$first $hits]]]]]

[?def place-col-of pure [returns string] ($ctx::map $id::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/place-col]
               [where [= [$ux:str-or $e@id ""] $id]]
               [yield [$ux:str-or $e@col ""]]]]
    [?if [$ux:absent $hits] [then ""] [else [$first $hits]]]]]

[?def place-var-nth pure [returns any] ($ctx::map $id::string $k::int)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/place-var]
               [where [= [$ux:str-or $e@id ""] $id]] [yield $e]]]
    [?if [>= [$count $hits] $k] [then [$nth $hits $k]] [else ()]]]]

[; the COMPONENT KIND, stamped on every placed element (not edit-only): the
   pack stylesheet dresses a kit member by what it IS — a hero-split, a quote,
   a stat — which is what lets an adopter's kit look designed rather than like
   a stack of cards. Derived from the arrangement, never authored in a tree. ]
[?def place-kit-of pure [returns string] ($ctx::map $id::string)
  [?let [= $rctx [$rctx-of $ctx]]
    [= $hits [?for [in $e $rctx/place-kit]
               [where [= [$ux:str-or $e@id ""] $id]]
               [yield [$ux:str-or $e@component ""]]]]
    [?if [$ux:absent $hits] [then ""] [else [$first $hits]]]]]

# target-id — the `#cx-…` selector for what an action or form AFFECTS. It is
# computed with the same `frag-id` that minted the target's own id, so the two
# cannot drift; a hand-written selector could, and in W1 did (the demo carried
# one by hand and had to recompute it in the service).
[?def target-id pure [returns any] ($el::any $ctx::map)
  [?let [= $f [$ux:affects-frag $el $ctx]]
    [?if [$exists $f] [then [$concat "#" [$ux:frag-id $f]]] [else ()]]]]

[?def affects-swap pure [returns any] ($el::any $ctx::map)
  [?if [$exists $el@affects]
    [then [$ux:swap-mode [$rctx-of $ctx] [$string $el@affects]]]
    [else ()]]]

# lower-region — the addressed fragment root. The region's element path is its
# `path=` (default `/`), and the address is minted from the CONTEXT's route +
# the region's own feature-instance name (P0-9).
#
# A region declaring `live=<feed>` becomes an SSE-connected region. The
# endpoint and the event name come from the RENDER CONTEXT's binding for that
# feed name, never from the tree — which is what lets the terminal renderer
# open the same stream from the same declaration.
[?def lower-region pure [returns any] ($el::any $ctx::map)
  [?let
    [= $feature [$string $el@feature]]
    [= $path    [$ux:str-or $el@path "/"]]
    [= $f       [$ux:frag [?else $ctx.route "/"] $feature $path]]
    [= $inner   {route: [?else $ctx.route "/"], feature: $feature, path: $path, bind: [?else $ctx.bind ()]}]
    [= $fb      [?if [$exists $el@live]
                  [then [$ux:feed-binding [$rctx-of $ctx] [$string $el@live]]]
                  [else ()]]]
    [= $b       [?if [$exists $fb] [then [$first $fb] ] [else ()]]]
    [; A region whose feed binding carries `region-refetch=` LISTENS instead
       of connecting (W26, P0-44's aside pattern reaching regions): the page's
       one SSE connection is owned elsewhere (the shell); this region hears
       the event on it and refetches ITSELF, rendered for its own location —
       pushed content cannot carry another page's targets. The return= names
       where the region lives (in edit mode, the edit toggle's own URL, so a
       refetched region keeps its stamps). ]
    [= $rrf     [?if [$exists $fb] [then [$ux:str-or $b@region-refetch ""]] [else ""]]]
    [= $ret     [?let [= $e [$edit-of $ctx]]
                  [?if [$ux:found $e]
                    [then [$ux:str-or $e@return [?else $ctx.route "/"]]]
                    [else [?else $ctx.route "/"]]]]]
    [?element "section" class="ux-region"
      [?attr "id" [$ux:frag-id-of [$ux:frag-repr $f]]]
      [?attr "data-cx-frag" [$ux:frag-repr $f]]
      [?attr [?if [$arranged-has $ctx $feature] [then "data-cx-arranged"] [else ()]] "1"]
      [?attr [$hx-name "hx-ext"      [?if [and [$exists $fb] [= $rrf ""]] [then "sse"] [else ()]]] "sse"]
      [?attr [$hx-name "sse-connect" [?if [and [$exists $fb] [= $rrf ""]] [then $b@endpoint] [else ()]]] [$string $b@endpoint]]
      [?attr [$hx-name "hx-get"      [?if [= $rrf ""] [then ()] [else "g"]]]
             [$concat $rrf "?return=" [$url:encode $ret]]]
      [?attr [$hx-name "hx-trigger"  [?if [= $rrf ""] [then ()] [else "t"]]]
             [$concat "sse:" [$ux:str-or $b@event ""]]]
      [?attr [$hx-name "hx-target"   [?if [= $rrf ""] [then ()] [else "x"]]] "this"]
      [?attr [$hx-name "hx-swap"     [?if [= $rrf ""] [then ()] [else "s"]]] "outerHTML"]
      [; The region CONNECTS; it does not swap. The swap target is whichever
         element names the same feed — for a collection that is its row
         container, which is the only parse context where a `<tr>` payload
         survives (a bare `<tr>` fragment loses its wrapper by the HTML spec,
         and the cells land as siblings of the rows). ]
      [; A REGION HOLDING FACETS IS A BROWSE REGION, and a browse region wants
         its narrowing beside its results rather than stacked above them. The
         facets are gathered into one wrapper so the rail can span the results
         column's rows; without it, each facet shares a row track with a result
         block and the grid is pushed down by the tallest facet.
         This is the renderer's own structural wrapper, exactly like the `<tr>`
         it puts inside `ux:columns`, and the content readback steps through it
         for the same reason: a wrapper is presentation, not content. It is
         derived from what the region CONTAINS — no layout member, no class the
         surface has to remember, nothing for a projection to get wrong. ]
      [?splice [$region-kids-lowered $el $inner]]]]]

[; DOCUMENT ORDER IS PRESERVED: the wrapper stands where the FIRST facet
   stood, and the rest of the facets are gathered into it. Emitting the wrapper
   first was simpler and reordered the page — which the content normal form
   caught immediately, on the two routes that have facets and nowhere else.
   That is the equivalence fixture doing exactly the job it exists for. ]
[?def region-kids-lowered pure [returns any] ($el::any $inner::map)
  [?let
    [= $facets [?for [in $k $el/*] [where [= [$name $k] "ux:facet"]] [yield $k]]]
    [?if [$ux:absent $facets]
      [then [?for [in $k $el/*] [yield [$lower $k $inner]]]]
      [else
        [?let
          [= $kids [?for [in $k $el/*] [yield $k]]]
          [= $fi   [$first-facet-index $kids 1]]
          [= $box  [rk [?splice [?for [in $i [$range 1 [$count $kids]]]
                                  [= $k [$nth $kids $i]]
                                  [yield [$region-kid $k $i $fi $facets $inner]]]]]]
          [?for [in $x $box/*] [yield $x]]]]]]]

[?def region-kid pure [returns any] ($k::any $i::int $fi::int $facets::any $inner::map)
  [?if [= $i $fi]
    [then [?element "div" class="ux-facets"
            [?for [in $g $facets] [yield [$lower $g $inner]]]]]
    [else [?if [= [$name $k] "ux:facet"] [then ()] [else [$lower $k $inner]]]]]]

[?def first-facet-index pure [returns int] ($kids::any $i::int)
  [?if [> $i [$count $kids]]
    [then 0]
    [else [?let [= $k [$nth $kids $i]]
            [?if [= [$name $k] "ux:facet"] [then $i] [else [$first-facet-index $kids [+ $i 1]]]]]]]]

# lower-row — a collection row. Keyed rows are individually addressable (and
# therefore OOB-updatable); an unkeyed row gets NO address at all, honestly —
# the enclosing region becomes the smallest addressable unit (P0-10).
#
# `$oob` is supplied ONLY by the patch lowering (§4); a row in a page never
# carries one, because out-of-band is not a property of a row.
[?def lower-row pure [returns any] ($el::any $ctx::map $oob::any)
  [?let
    [= $step [$ux:row-step [?else $ctx.path "/"] [?if [$exists $el@key] [then [$string $el@key]] [else ()]]]]
    [= $f    [?if [$exists $step]
               [then [$ux:frag [?else $ctx.route "/"] [?else $ctx.feature ""] $step]]
               [else ()]]]
    [; A keyed row EXTENDS the element path for everything inside it. Without
       this, content nested in a row is addressed as a sibling of the row
       rather than a descendant — and two rows holding identically-keyed
       nested rows would mint the SAME address for different fragments. An
       unkeyed row extends nothing, because it has no address to extend. ]
    [= $inner [?if [$exists $step] [then [$ux:ctx-at $ctx $step]] [else $ctx]]]
    [= $rr    [?if [$exists $step] [then [$ux:frag-repr $f]] [else ""]]]
    [?element "tr" class="ux-row"
      [?attr [?if [$exists $step] [then "id"] [else ()]]           [?if [$exists $step] [then [$ux:frag-id-of $rr]] [else ""]]]
      [?attr [?if [$exists $step] [then "data-cx-frag"] [else ()]] [?if [$exists $step] [then $rr] [else ""]]]
      [?attr [$hx-name "hx-swap-oob" $oob] [$string $oob]]
      [$lower-kids $el $inner]]]]

# lower-field — the label/value pair; `box` supplies the wrapper and any
# placed-element address.
[; the FORMAT rides out as a data attribute rather than as a class, so the
   readback's class match keeps working and the stylesheet still gets to treat
   a price differently from a delivery promise. Presentation follows the
   declared format; it does not re-derive it. ]
[?def lower-field pure [returns any] ($el::any $ctx::map)
  ([?element "span" class="ux-field-label" [$ux:str-or $el@label ""]],
   [?element "span" class="ux-field-value"
     [?attr [?if [$exists $el@format] [then "data-cx-format"] [else ()]] [$ux:str-or $el@format ""]]
     [$lower-body $el $ctx]])]

# lower-action — THE write control. A projected action submits as
# `POST /intent/<verb>` — the shipped web intent wire, ρ-resolution + PEP +
# contract apply behind it. The UX face adds NO new wire (P0-18, P0-25).
# Every htmx attribute name here passes `hx-name`, so an off-list attribute is
# unreachable at authorship; `off-subset-attrs` re-checks the emitted bytes so
# any path that bypassed this constructor still goes red.
#
# W10 CHANGED ITS SHAPE, TWICE OVER, AND BOTH CHANGES ARE CORRECTIONS.
#
# It used to be a bare `<button hx-post>`. That button does NOTHING with the
# kernel absent (P0-81 — the MPA shape must degrade rather than die), and it
# has no way to carry a body, so no action could post anything about the item
# it sits on. It is now a real `<form method="post" action="/intent/<verb>">`
# with the item's `[ux:param]`s as hidden fields: it works without the kernel,
# and P0-56's item-scoped intents become expressible at all.
#
# The params are SERVER-DERIVED AT PROJECTION TIME and never read back out of
# the document. An item whose price changed between render and click posts the
# price it was rendered with, the command layer refuses it, and the customer
# is told what changed — which is the correct outcome and the one a DOM read
# cannot produce.
#
# An action declaring `confirm=` is a LINK to its confirmation view instead
# (P0-67): destructive acts confirm by URL, never by dialog. `hx-confirm` is
# off the pinned subset permanently and a client dialog is something the
# terminal renderer would have to simulate.
[?def lower-action pure [returns any] ($el::any $ctx::map)
  [?if [$exists $el@confirm]
    [then [?element "a" class="ux-action ux-action-danger"
            [?attr "href" [$string $el@confirm-href]]
            [$ux:label-of $el]]]
    [else [?if [= [$ux:str-or $el@available "true"] "false"]
      [then [$lower-action-unavailable $el]]
      [else
      [?let
        [= $t   [$target-id $el $ctx]]
        [= $s   [$affects-swap $el $ctx]]
        [= $act [$concat "/intent/" [$string $el@verb]]]
        [?element "form" class="ux-action-form" method="post"
          [?attr "action" $act]
          [?attr [$hx-name "hx-post"    "post"] $act]
          [?attr [$hx-name "hx-target"  $t]     [$string $t]]
          [?attr [$hx-name "hx-swap"    $s]     [$string $s]]
          [?for [in $p $el/ux:param]
            [yield [?element "input" type="hidden"
                     [?attr "name" [$string $p@name]] [?attr "value" [$string $p@value]]]]]
          [; a FIELD-MODE quantity child (W23 letter (i)) is this form's own
             bounded field — the customer says "two of them" where the
             decision happens, and the value rides the same post. ]
          [?for [in $qc $el/ux:quantity]
            [yield [$lower-quantity-field $qc $ctx]]]
          [?element "button" type="submit"
            [?attr "class" [?if [= [$ux:str-or $el@prominence "normal"] "primary"]
                             [then "ux-action ux-action-primary"] [else "ux-action"]]]
            [$ux:label-of $el]]]]]]]]]

# lower-action-unavailable — P0-99's web face: the control KEEPS ITS PLACE and
# its label, is a REAL disabled control (not a styled div — a screen reader
# announces a disabled button as what it is), and the reason is visible text
# programmatically associated via aria-describedby. No post wiring at all:
# inert means there is nothing to trigger, with or without the kernel. The
# verb rides `data-cx-verb` and the params stay as hidden inputs, so the
# content readback recovers the same c:action the semantic tree yields — an
# unavailable act is still THE act, stated inert, not a different thing.
#
# The reason element's id is minted by hashing verb + the action's param
# values through the same frag-id derivation every other id uses — 24
# out-of-stock cards on one page are 24 DIFFERENT ids, because their SKUs
# differ, and a colliding describedby would silently point every control at
# the first card's reason.
[?def lower-action-unavailable pure [returns any] ($el::any)
  [?let
    [= $key [$reduce [?for [in $p $el/ux:param] [yield [$ux:str-or $p@value ""]]]
              [?fn ($a $b) [$concat $a "." $b]] [$ux:str-or $el@verb ""]]]
    [= $rid [$concat [$ux:frag-id-of $key] "-reason"]]
    [?element "div" class="ux-action-form ux-action-unavailable"
      [?attr "data-cx-verb" [$ux:str-or $el@verb ""]]
      [?for [in $p $el/ux:param]
        [yield [?element "input" type="hidden"
                 [?attr "name" [$string $p@name]] [?attr "value" [$string $p@value]]]]]
      [?element "button" type="button" class="ux-action" disabled="disabled"
        [?attr "aria-describedby" $rid]
        [$ux:label-of $el]]
      [?element "span" class="ux-action-reason"
        [?attr "id" $rid]
        [$ux:str-or $el@reason ""]]]]]

# lower-form — the write control's container. Submits as `POST /intent/<verb>`:
# the shipped web intent wire, ρ-resolution + PEP + contract apply behind it
# (P0-18). `action`/`method` are emitted alongside `hx-post` so the form still
# posts natively when the kernel is absent or still loading — the MPA shape
# degrades instead of dying, and CSP's `form-action 'self'` covers that path.
#
# The form's element-path step is its VERB, so its address is derived rather
# than author-assigned, and the control ids beneath it inherit that address —
# two forms for different commands on one page cannot collide, and two forms
# for the SAME command on one page collide loudly rather than silently
# producing duplicate DOM ids.
[?def lower-form pure [returns any] ($el::any $ctx::map)
  [?let
    [= $verb [$string $el@verb]]
    [= $act  [$concat "/intent/" $verb]]
    [= $path [$ux:path-step [?else $ctx.path "/"] $verb]]
    [= $f    [$ux:frag [?else $ctx.route "/"] [?else $ctx.feature ""] $path]]
    [= $fr   [$ux:frag-repr $f]]
    [= $fctx {route: [?else $ctx.route "/"], feature: [?else $ctx.feature ""],
              path: $path, bind: [?else $ctx.bind ()], form: [$ux:frag-id-of $fr]}]
    [= $t    [$target-id $el $ctx]]
    [= $s    [$affects-swap $el $ctx]]
    [; the form dims itself for exactly as long as the post is outstanding.
       `hx-indicator` names the form's own id, so this needs no extra element
       and no script — and a form that looks identical before and after the
       click is the single most common reason an operator submits twice. ]
    [?element "form" class="ux-form ux-busy" method="post"
      [?attr "action" $act]
      [?attr "id" [$ux:frag-id-of $fr]]
      [?attr "data-cx-frag" $fr]
      [?attr [$hx-name "hx-post"   "post"] $act]
      [?attr [$hx-name "hx-target" $t]     [$string $t]]
      [?attr [$hx-name "hx-swap"   $s]     [$string $s]]
      [?attr [$hx-name "hx-indicator" "self"] [$concat "#" [$ux:frag-id-of $fr]]]
      [?for [in $k $el/*] [yield [$lower $k $fctx]]]]]]

# lower-input — one labelled control. The `for`/`id` pair is scoped by the
# enclosing form's address, so a label always points at its own control even
# with several forms on a page.
#
# The wrapper class is `ux-control-field`, distinct from `ux-field`'s
# label/value pair: the two are different things and the content readback (§6)
# has to tell them apart without guessing from the presence of an `<input>`.
[?def lower-input pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n    [$string $el@name]]
    [= $cid  [$concat [?else $ctx.form "ux"] "-" $n]]
    [= $kind [$input-kind-of [$ux:str-or $el@kind "string"]]]
    [?element "div" class="ux-control-field"
      [; a placed input's minted address rides the FIELD wrapper as
         data-cx-frag only — the input's own DOM id is the label-binding id,
         already spoken for (letter c). ]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]]
             [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ""]]]
      [?element "label" class="ux-label" [?attr "for" $cid]
        [$ux:str-or $el@label [$ux:label-of-name $n]]]
      [?element "input" [?attr "class" [?if [$exists $el@error] [then "ux-control ux-control-bad"] [else "ux-control"]]]
        [?attr "id" $cid]
        [?attr "name" $n]
        [?attr "type" $kind]
        [?attr [?if [= [$ux:str-or $el@required "false"] "true"] [then "required"] [else ()]] "required"]
        [; the accessible half of "this field is wrong": a red border is not a
           message, and a screen reader reads neither a colour nor a border ]
        [?attr [?if [$exists $el@error] [then "aria-invalid"] [else ()]] "true"]
        [?attr [?if [$exists $el@value] [then "value"] [else ()]] [$string $el@value]]]
      [?if [$exists $el@error]
        [then [?element "span" class="ux-field-error" [$string $el@error]]]
        [else [?if [$exists $el@help]
                [then [?element "span" class="ux-help" [$string $el@help]]]
                [else ()]]]]]]]

# lower-select -- a reference-typed field: a CHOICE FROM A KNOWN SET rather
# than a text box. P0-17 ruled this ("reference-typed fields project typeahead
# wired against the referenced query") and it had never been built, which is
# why an order form asked the operator to type a product identifier from
# memory.
#
# A native `<select>` rather than a scripted combobox: it is keyboard-operable,
# screen-reader-operable and works with the strict CSP by construction, and the
# typeahead the clause names is the same element over a fetched option list
# once a catalogue is too large to inline. Nothing about the semantic element
# changes when that happens.
[?def lower-select pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n    [$string $el@name]]
    [= $cid  [$concat [?else $ctx.form "ux"] "-" $n]]
    [?element "div" class="ux-control-field"
      [; the same placed-address rule as lower-input (letter c). ]
      [?attr [?if [$exists $el@id] [then "data-cx-frag"] [else ()]]
             [?if [$exists $el@id] [then [$ux:frag-repr [$ux:ctx-frag $ctx]]] [else ""]]]
      [?element "label" class="ux-label" [?attr "for" $cid]
        [$ux:str-or $el@label [$ux:label-of-name $n]]]
      [?element "select" [?attr "class" [?if [$exists $el@error] [then "ux-control ux-control-bad"] [else "ux-control"]]]
        [?attr "id" $cid]
        [?attr "name" $n]
        [?attr [?if [= [$ux:str-or $el@required "false"] "true"] [then "required"] [else ()]] "required"]
        [?attr [?if [$exists $el@error] [then "aria-invalid"] [else ()]] "true"]
        [$lower-kids-selected $el $ctx [$ux:str-or $el@value ""]]]
      [?if [$exists $el@error]
        [then [?element "span" class="ux-field-error" [$string $el@error]]]
        [else [?if [$exists $el@help]
                [then [?element "span" class="ux-help" [$string $el@help]]]
                [else ()]]]]]]]

[; a re-projected select must come back on the option the operator chose ]
[?def lower-kids-selected pure [returns any] ($el::any $ctx::map $chosen::string)
  [?for [in $o [$ux:child-elements $el "ux:option"]]
    [yield [?element "option" [?attr "value" [$string $o@value]]
             [?attr [?if [= [$ux:str-or $o@value ""] $chosen] [then "selected"] [else ()]] "selected"]
             [; the placed-address rule reaches THIS option spelling too — the
                one place options are really built (letter c); the descend is
                this def's own, since it bypasses the dispatcher. ]
             [?attr [?if [$exists $o@id] [then "data-cx-frag"] [else ()]]
                    [?if [$exists $o@id] [then [$ux:frag-repr [$ux:ctx-frag [$ux:descend $o $ctx]]]] [else ""]]]
             [$ux:label-of $o]]]]]

# lower-group-items -- each instance, with a remove affordance beside it.
#
# Removing an unsubmitted line is not an INTENT: nothing is committed and
# nothing is journaled, so it cannot ride the intent wire — the same reasoning
# that made `ux:filter` a query control rather than a form. It is realized
# entirely in the renderer from the group's own declaration: a request whose
# empty response replaces the instance with nothing. No JavaScript, and the
# pinned subset already carries every attribute it needs.
[?def lower-group-items pure [returns any] ($el::any $ctx::map)
  [?let
    [= $eps [$filter-endpoint [$rctx-of $ctx] [$ux:str-or $el@affects ""]]]
    [= $ep  [?if [$ux:absent $eps] [then ""] [else [$concat [$first $eps] "?drop=1"]]]]
    [?for [in $inst [$ux:child-elements $el "ux:card"]]
      [yield [?element "div" class="ux-group-row"
               [$lower $inst $ctx]
               [?if [= $ep ""]
                 [then ()]
                 [else [?element "button" class="ux-remove" type="button"
                         [?attr "aria-label" "Remove this line"]
                         [?attr [$hx-name "hx-get" $ep] $ep]
                         [?attr [$hx-name "hx-target" "closest .ux-group-row"] "closest .ux-group-row"]
                         [?attr [$hx-name "hx-swap" "outerHTML"] "outerHTML"]
                         "\u00d7"]]]]]]]]

# lower-group -- a REPEATING field group: the nested write case.
#
# Instances are indexed in their control names (`lines.0.sku`, `lines.1.sku`),
# because a form posts a flat key/value list and repeated bare names collapse
# to one. The index is the only thing that makes "two line items" survive the
# wire.
#
# Adding an instance is a hypermedia fetch, not a script: the add control does
# an `hx-get` against the group's fragment endpoint and appends one more
# instance. That keeps the strict CSP intact and the kernel replaceable — the
# `javascript policy=none` posture the reference estate takes, honoured by a
# projection rather than by hand.
# lower-panel — P0-101. A panel's name is its identity within its region, so
# its DOM id is minted from the SAME child-ctx step the address walk uses
# (`ux:child-ctx` steps a panel by name exactly as a group), and its children
# are lowered under that stepped context so every address below the panel
# agrees with the minted set.
[; a panel addresses by NAME (P0-101), so its edit-mode stamps key on the
   name — the same lookups box-x makes for id-addressed members. Inlined
   because [?attr] is lexical: attributes cannot be returned from a def. ]
[?def lower-panel pure [returns any] ($el::any $ctx::map)
  [?let
    [= $inner [$ux:child-ctx $el $ctx]]
    [= $r [$ux:frag-repr [$ux:ctx-frag $inner]]]
    [= $nm [$ux:str-or $el@name ""]]
    [= $ed [$edit-on $ctx]]
    [= $sp [?if $ed [then [$sel-placed-entry $ctx $nm]] [else ()]]]
    [= $hass [$ux:found $sp]]
    [= $prov [?if $ed [then [$sel-prov-of $ctx $nm]] [else ""]]]
    [= $span [$place-span-of $ctx $nm]]
    [= $pcol [$place-col-of $ctx $nm]]
    [= $v1 [$place-var-nth $ctx $nm 1]]
    [= $v2 [$place-var-nth $ctx $nm 2]]
    [= $v3 [$place-var-nth $ctx $nm 3]]
    [?element "section" class="ux-panel"
      [?attr "id" [$ux:frag-id-of $r]]
      [?attr "data-cx-frag" $r]
      [?attr "data-cx-panel" $nm]
      [?attr "aria-label" [$ux:str-or $el@label [$ux:label-of-name $nm]]]
      [?attr [?if $hass [then "data-cx-sel"] [else ()]] [$concat "[placed " $nm "]"]]
      [?attr [?if [and $hass [not [= $prov ""]]] [then "data-cx-sel-prov"] [else ()]] $prov]
      [?attr [?if $hass [then "data-cx-sel-component"] [else ()]] [$ux:str-or $sp@component ""]]
      [?attr [?if $hass [then "data-cx-sel-container"] [else ()]] [$ux:str-or $sp@container "false"]]
      [?attr [?if [and $hass [not [= [$ux:str-or $sp@vars ""] ""]]] [then "data-cx-sel-vars"] [else ()]]
             [$ux:str-or $sp@vars ""]]
      [?attr [?if [= $span ""] [then ()] [else "data-cx-span"]] $span]
      [?attr [?if [= $pcol ""] [then ()] [else "data-cx-col"]] $pcol]
      [?attr [?if [$ux:found $v1] [then [$concat "data-cx-var-" [$ux:str-or $v1@name ""]]] [else ()]] [$ux:str-or $v1@value ""]]
      [?attr [?if [$ux:found $v2] [then [$concat "data-cx-var-" [$ux:str-or $v2@name ""]]] [else ()]] [$ux:str-or $v2@value ""]]
      [?attr [?if [$ux:found $v3] [then [$concat "data-cx-var-" [$ux:str-or $v3@name ""]]] [else ()]] [$ux:str-or $v3@value ""]]
      [?for [in $k $el/*] [yield [$lower $k $inner]]]]]]

[?def lower-group pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n  [$string $el@name]]
    [; the group's OWN address, so the add control's target is derived rather
       than composed from a form id and a name that could drift apart ]
    [= $gid [$ux:frag-id-of [$ux:frag-repr [$ux:ctx-frag $ctx]]]]
    [= $ep [$filter-endpoint [$rctx-of $ctx] [$ux:str-or $el@affects ""]]]
    [?element "fieldset" class="ux-group ux-busy"
      [?attr "id" $gid]
      [?element "legend" class="ux-group-label" [$ux:str-or $el@label [$ux:label-of-name $n]]]
      [?element "div" class="ux-group-items"
        [?attr "id" [$concat $gid "-items"]]
        [$lower-group-items $el $ctx]]
      [?if [$ux:absent $ep]
        [then ()]
        [else [?element "button" class="ux-action ux-action-quiet" type="button"
                [?attr [$hx-name "hx-get" $ep] [$string $ep]]
                [?attr [$hx-name "hx-target" [$concat "#" $gid "-items"]] [$concat "#" $gid "-items"]]
                [?attr [$hx-name "hx-swap" "beforeend"] "beforeend"]
                [?attr [$hx-name "hx-include" [$concat "#" $gid "-items"]] [$concat "#" $gid "-items"]]
                [?attr [$hx-name "hx-indicator" [$concat "#" $gid]] [$concat "#" $gid]]
                [$ux:str-or $el@add-label "Add another"]]]]]]]

# lower-filter — the QUERY control (W5 ruling). A filter is not an intent: it
# commits nothing, so it READS with `hx-get` against the fragment endpoint that
# serves the collection it narrows, and swaps that collection in place. The
# trigger — debounced keyup — is a renderer decision and is spelled here, not
# in the tree; the terminal renderer binds the same declaration to `/` instead.
#
# The endpoint is the affected container's fragment endpoint, declared by the
# surface document (`[route … [fragment path=…]]`) and passed in the render
# context. A filter with no endpoint bound renders as a plain box that filters
# nothing — so it refuses instead, for the same reason an unbound feed does.
[; A ROUTE-NARROWING FILTER IS A REAL GET FORM to a real URL. No htmx at all,
   and that is the point: searching produces a location, so the browser's own
   navigation is exactly the right mechanism and the no-kernel path is not a
   fallback but the only path. ]
[?def lower-filter pure [returns any] ($el::any $ctx::map)
  [?if [$exists $el@route] [then [$lower-filter-route $el $ctx]] [else [$lower-filter-frag $el $ctx]]]]

[?def lower-filter-route pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n   [$string $el@name]]
    [= $cid [$concat [?else $ctx.form "ux"] "-filter-" $n]]
    [?element "form" class="ux-control-field ux-filter ux-filter-route" method="get"
      [?attr "action" [$string $el@route]]
      [?attr "role" "search"]
      [?element "label" class="ux-label" [?attr "for" $cid]
        [$ux:str-or $el@label [$ux:label-of-name $n]]]
      [?element "input" class="ux-control" type="search"
        [?attr "id" $cid]
        [?attr "name" $n]
        [?attr [?if [$exists $el@value] [then "value"] [else ()]] [$string $el@value]]]
      [?element "button" type="submit" class="ux-action" "Search"]]]]

[?def lower-filter-frag pure [returns any] ($el::any $ctx::map)
  [?let
    [= $n   [$string $el@name]]
    [= $cid [$concat [?else $ctx.form "ux"] "-filter-" $n]]
    [= $t   [$target-id $el $ctx]]
    [= $ep  [$filter-endpoint [$rctx-of $ctx] [$ux:str-or $el@affects ""]]]
    [?element "div" class="ux-control-field ux-filter"
      [?element "label" class="ux-label" [?attr "for" $cid]
        [$ux:str-or $el@label [$ux:label-of-name $n]]]
      [?element "input" class="ux-control" type="search"
        [?attr "id" $cid]
        [?attr "name" $n]
        [?attr [?if [$exists $el@value] [then "value"] [else ()]] [$string $el@value]]
        [?attr [$hx-name "hx-get"     $ep] [$string $ep]]
        [?attr [$hx-name "hx-target"  $t]  [$string $t]]
        [?attr [$hx-name "hx-swap"    [?if [$exists $ep] [then "outerHTML"] [else ()]]] "outerHTML"]
        [?attr [$hx-name "hx-trigger" [?if [$exists $ep] [then "keyup changed delay:200ms, search"] [else ()]]]
                                      "keyup changed delay:200ms, search"]]]]]

# filter-endpoint — the render context's fragment endpoint for one affected
# container path: `[fragment affects=<path> endpoint=<url>]`.
[?def filter-endpoint pure [returns any] ($rctx::any $affects::string)
  [?for [in $f $rctx/fragment]
    [where [= [$string $f@affects] $affects]]
    [yield [$string $f@endpoint]]]]

# unbound-filter-refusals — a filter whose affected container has no fragment
# endpoint in the render context. Same reasoning as an unbound feed: a control
# that renders and does nothing passes every server-side gate.
[?def unbound-filter-refusals scope=public pure [returns any] ($el::any $rctx::any)
  [?let [= $c [$filter-tree $el $rctx]] $c//ux-refusal]]

[?def filter-tree pure [returns any] ($el::any $rctx::any)
  [?if [$ux:seq-child $el]
    [then [ux-refusals [?for [in $m $el] [yield [$filter-tree $m $rctx]]]]]
    [else
      [ux-refusals
        [?if [and [= [$name $el] "ux:filter"]
                  [and [not [$exists $el@route]]
                       [not [$exists [$filter-endpoint $rctx [$ux:str-or $el@affects ""]]]]]]
          [then ([ux-refusal code=ux-unbound-filter filter=[$ux:str-or $el@name ""]])]
          [else ()]]
        [?for [in $k $el/*] [yield [$filter-tree $k $rctx]]]]]]]

# input-kind-of — the declared CX kind → the HTML control type. The carrier
# conventions are load-bearing here for the same reason they are in the tools
# projection: a decimal or bigint rides a STRING carrier, so it gets a TEXT
# control. An HTML number input round-trips through a double and would silently
# corrupt a value the command declared exactly — the projection must never
# quietly narrow a declared type.
#
# This mapping is RENDERER-PRIVATE, which is why it lives here: the terminal
# renderer maps the same declared kinds to its own editors, and the two
# mappings are free to disagree because `kind=` states the CX TYPE, not a
# widget.
[?def input-kind-of scope=public pure [returns string] ($kind::string)
  [?match $kind
    [; the XAP feature grammar's field types share this mapper, so one place
       decides how a declared type becomes a control — `money` and `decimal`
       both stay TEXT for the same carrier reason. ]
    [case "instant"  "datetime-local"]
    [case "password" "password"]
    [case "money"    "text"]
    [case "text"     "text"]
    [case "int"      "number"]
    [case "float"    "number"]
    [case "number"   "number"]
    [case "bool"     "checkbox"]
    [case "date"     "date"]
    [case "datetime" "datetime-local"]
    [case "time"     "time"]
    [else "text"]]]

# ── §3 Emitter self-checks ──────────────────────────────────────────────────

# The duplicate-id check MOVED to `cx-x/ux` at W5 (`address-collisions`): it
# is a property of the semantic tree, both renderers mint from the same
# addresses, and the terminal renderer had no check at all while minting its
# focus ring from the same ids. It also no longer re-walks this renderer's
# lowered tree to recover addresses the lowering just minted.

# off-subset-attrs — the OUTPUT-side subset gate (P0-31). Scans the serialized
# bytes for any `hx-*`/`sse-*` attribute name and refuses every one that is not
# on the pinned list. This is the fixture-enforced check: an off-list attribute
# anywhere in emitter output is red.
# (RE2 has no lookaround, so the `="` sentinel is matched and the name is taken
# from the capture group — an attribute NAME, never a value, can reach here.)
[?def off-subset-attrs scope=public pure [returns any] ($html::string)
  [?let [= $rx [$re:compile "((?:hx|sse)-[a-z][a-z0-9-]*)=\""]]
    [?for [in $m [$re:find-all $rx $html]]
      [= $a [$re:group $m 1]]
      [where [not [$htmx-allowed $a]]]
      [yield [ux-refusal code=ux-attr-off-subset attr=$a]]]]]

# csp-violations — the strict-CSP emitter invariants (P0-33). The emitter never
# emits inline `style=` (theming is token CSS — a generated stylesheet, which
# also keeps every visual decision inside the token/claim system), never an
# inline script, and never an event-handler attribute.
#
# A `<script src=… integrity=…>` element is SANCTIONED — that is precisely how
# the vendored kernel is served and hash-pinned. What is refused is an INLINE
# script: a `<script>` with no `src`, or any content between its tags. Both are
# checked, because either one alone would let the other through.
[?def csp-violations scope=public pure [returns any] ($html::string)
  [?let
    [= $style   [$re:compile "[ ]style=\""]]
    [= $script  [$re:compile "<script([^>]*)>"]]
    [= $inline  [$re:compile "<script[^>]*>[^<]"]]
    [= $handler [$re:compile "[ ]on[a-z]+=\""]]
    [= $c [ux-refusals
            [?for [in $m [$re:find-all $style $html]]   [yield [ux-refusal code=ux-inline-style]]]
            [?for [in $m [$re:find-all $script $html]]
              [where [not [$contains [$re:group $m 1] "src=\""]]]
              [yield [ux-refusal code=ux-inline-script]]]
            [?for [in $m [$re:find-all $inline $html]]  [yield [ux-refusal code=ux-inline-script]]]
            [?for [in $m [$re:find-all $handler $html]] [yield [ux-refusal code=ux-event-handler]]]]]
    $c//ux-refusal]]

# ── §4 THE render entry points ──────────────────────────────────────────────

# render — one semantic tree + fragment context → HTML text, or ONE [err …]
# naming every refusal. Never a partial render: a refused tree yields no markup
# at all, so a projection failure can never reach a browser as content.
#
# The pipeline, in order: the SHARED semantic gate → the binding gates → lower
# → check minted ids → serialize → re-scan the bytes for subset and CSP
# violations. The first gate is `cx-x/ux`'s, run identically by the terminal
# renderer, so a tree one renderer accepts and the other rejects cannot exist.
[?def render scope=public pure [returns any] ($el::any $ctx::map)
  [?let
    [; ONE address walk feeds both address gates (W24, ruling 3a) — the
       staging and the refusal order are exactly what they were. ]
    [= $pairs [$ux:address-pairs $el $ctx]]
    [= $bad [$ux:joined [$ux:refusals-of $el]
              [$ux:joined [$ux:err-refusals $el]
                [$ux:joined [$ux:binding-refusals $el [$rctx-of $ctx]]
                  [$ux:joined [$unbound-filter-refusals $el [$rctx-of $ctx]]
                              [$ux:dangling-affects-with $el $ctx $pairs]]]]]]
    [?if [$exists $bad]
      [then [err code=ux-refused $bad]]
      [else
        [?let
          [= $dupe [$ux:collisions-with $pairs]]
          [?if [$exists $dupe]
            [then [err code=ux-refused $dupe]]
            [else
              [?let
                [; the lowered tree, not just the semantic one: THIS is where
                   the `[$concat]` refusal appeared — minted by the renderer
                   itself, after every semantic gate had already passed. ]
                [= $low  [$lower $el $ctx]]
                [= $lerr [$ux:err-refusals $low]]
                [= $out  [?if [$exists $lerr] [then ""] [else [$html:serialize $low]]]]
                [= $post [$ux:joined $lerr
                           [$ux:joined [$off-subset-attrs $out] [$csp-violations $out]]]]
                [?if [$exists $post]
                  [then [err code=ux-refused $post]]
                  [else $out]]]]]]]]]]

# render-fragment — the same pipeline addressed by an explicit fragment
# address: the swap-target form the intent round trip returns.
[?def render-fragment scope=public pure [returns any] ($el::any $f::element $rctx::any)
  [$render $el {route: [$string $f/route], feature: [$string $f/feature],
                path: [$string $f/path], bind: $rctx}]]

# ── the patch lowering: semantic ops → out-of-band HTML ─────────────────────
#
# `[$ux:feed-ops]` returns SEMANTIC operations over a keyed collection —
# insert / update / remove / repaint, addressed by ELEMENT PATH. This is where
# they become htmx out-of-band swaps, and it is the only place `hx-swap-oob`
# is authored anywhere in the tree.
#
#   insert  → hx-swap-oob="beforeend:#<container id>"   the row is new
#   update  → hx-swap-oob="true"                        the row's id matches
#   remove  → hx-swap-oob="delete" on an empty row      htmx needs only the id
#   repaint → hx-swap-oob="true" on the row container   same id, new contents
#
# The container id is DERIVED from the op's container path with the same
# `frag-id` that minted it during the first render, so a patch cannot target a
# selector that no longer exists.

# EACH OPERATION SHIPS INSIDE A `<template>`, and it is not decoration.
#
# A patch payload is a `<tr>` or a `<tbody>`. By the HTML spec those cannot
# stand on their own: parsed as a fragment outside a table, the parser DROPS
# the wrapper and keeps the contents. The live update then arrives, htmx
# faithfully appends what it was given, and four bare `<td>` elements land as
# siblings in the row container — visible in the DOM, invisible on screen,
# with no error anywhere. That is what "the table still does not update"
# actually was, after the extension was vendored.
#
# `<template>` is the documented htmx answer for exactly this: its contents
# are parsed as-is, so the `<tr>` survives to be swapped. htmx unwraps it
# before applying the out-of-band swap.
[; the `<template>` wrapper exists for ONE reason: a `<tr>` cannot stand on its
   own in the DOM, so a row-shaped out-of-band payload has to be encapsulated.
   An element that CAN stand on its own must not be wrapped — the wrapper is
   not free, and a `replace` op's payload is an ordinary div. So the wrapper
   follows the HTML spec's constraint rather than being applied uniformly. ]
[?def lower-ops scope=public pure [returns any] ($ops::any $ctx::map)
  [?for [in $o $ops]
    [yield [?if [= [$ux:str-or $o@kind ""] "replace"]
             [then [$lower-op $o $ctx]]
             [else [?element "template" [$lower-op $o $ctx]]]]]]]

[?def lower-op pure [returns any] ($o::any $ctx::map)
  [?let
    [= $cpath [$ux:str-or $o@container "/"]]
    [= $cctx  [$ux:ctx-at $ctx $cpath]]
    [= $cid   [$ux:frag-id [$ux:ctx-frag $cctx]]]
    [?match [$ux:str-or $o@kind ""]
      [case "insert"  [$lower-row [$ux:first-child $o "ux:row"] $cctx [$concat "beforeend:#" $cid]]]
      [case "update"  [$lower-row [$ux:first-child $o "ux:row"] $cctx "true"]]
      [case "remove"  [$lower-row [ux:row [?attr "key" [$ux:str-or $o@key ""]]] $cctx "delete"]]
      [case "repaint" [$lower-rows [$ux:first-child $o "ux:rows"] $cctx "true"]]
      [; ANY addressed element, out of band. The directive rides a WRAPPER
         rather than the element itself — `hx-swap-oob="outerHTML:#<id>"` names
         its own target — so this works for every member without threading an
         out-of-band flag through every lowering, and it stays inside the
         pinned attribute set (P0-31): `hx-swap-oob` was already on it. ]
      [case "replace" [$lower-oob [$first $o/*] $cctx]]
      [else ()]]]]

[?def lower-oob pure [returns any] ($el::any $ctx::map)
  [?let
    [= $c2 [$ux:descend $el $ctx]]
    [= $id [$ux:frag-id [$ux:ctx-frag $c2]]]
    [?element "div"
      [?attr [$hx-name "hx-swap-oob" "1"] [$concat "outerHTML:#" $id]]
      [$lower $el $ctx]]]]

# lower-rows — the row container carrying an out-of-band directive. Its id is
# the container's own address, so "replace by id" is the whole swap.
[?def lower-rows pure [returns any] ($el::any $ctx::map $oob::string)
  [?element "tbody" class="ux-rows"
    [?attr "id" [$ux:frag-id [$ux:ctx-frag $ctx]]]
    [?attr "data-cx-frag" [$ux:frag-repr [$ux:ctx-frag $ctx]]]
    [?attr [$hx-name "hx-swap-oob" $oob] $oob]
    [?for [in $r $el/*] [yield [$lower $r $ctx]]]]]

# render-ops — the serialized out-of-band payload one ∂ script becomes: the
# bytes an SSE event carries. It goes through the SAME subset and CSP scans as
# a page, so a live update cannot reach a browser by a route that skips the
# invariants.
# render-rows -- the row container's CONTENTS as bytes: what an innerHTML swap
# at the collection expects, and the shape a `<tr>` survives being parsed in.
[?def render-rows scope=public pure [returns any] ($rows-el::any $ctx::map)
  [?let
    [= $inner [$ux:child-ctx $rows-el $ctx]]
    [= $h    [?for [in $r $rows-el/*] [yield [$lower $r $inner]]]]
    [= $out  [$html:serialize $h]]
    [= $post [$ux:joined [$off-subset-attrs $out] [$csp-violations $out]]]
    [?if [$exists $post] [then [err code=ux-refused $post]] [else $out]]]]

[?def render-ops scope=public pure [returns any] ($ops::any $ctx::map)
  [?let
    [= $h    [$lower-ops $ops $ctx]]
    [= $out  [$html:serialize $h]]
    [= $post [$ux:joined [$off-subset-attrs $out] [$csp-violations $out]]]
    [?if [$exists $post]
      [then [err code=ux-refused $post]]
      [else $out]]]]

# ── §5 Token theme → generated stylesheet (P0-33) ───────────────────────────
#
# A theme is a token DOCUMENT (ruling 5): content-addressed, versioned, and
# resolved through the cascade (P0-13/P0-14 — platform → vendor → tenant →
# surface; W1 populates one level). It compiles to a GENERATED stylesheet, so
# the emitter never needs an inline `style=` and every visual decision stays in
# the token system.
#
# WEB-PRIVATE by construction: the terminal renderer has its own token
# document mapping the same semantic tones to SGR sequences. Tones are shared;
# their realizations are not.

# token-value-safe — a token value is tenant-supplied data reaching a
# stylesheet, which is an injection surface exactly like markup. The allowlist
# admits what CSS values legitimately need and nothing that can close a
# declaration, a rule, or a <style> element.
[?def token-value-safe scope=public pure [returns bool] ($v::string)
  [$re:matches [$re:compile "^[A-Za-z0-9 .,#%()/_-]+$"] $v]]

# font-value-safe — the same discipline as `token-value-safe`, one character
# wider. A `unicode-range` is written `U+0000-00FF` and there is no other way
# to spell it, so `+` is admitted here and nowhere else.
[?def font-value-safe scope=public pure [returns bool] ($v::string)
  [$re:matches [$re:compile "^[A-Za-z0-9 .,#%()/_+-]+$"] $v]]

# font-src-local — a font file is served from THIS origin or it is refused.
# Not a style rule: a font fetched from a third party tells that third party
# which page a customer is on, which is the same disclosure the CSP posture
# (P0-33) exists to prevent — and `font-src 'self'` would block it at the
# browser anyway, silently, leaving a store rendered in a fallback nobody
# chose. Refusing at the theme says so out loud.
[?def font-src-local pure [returns bool] ($v::string)
  [and [$strings:starts-with $v "/"] [not [$strings:starts-with $v "//"]]]]

[?def font-refusals pure [returns any] ($theme::element)
  [?for [in $f $theme//font]
    [where [not [and [$font-value-safe [$ux:str-or $f@family ""]]
                     [and [$font-value-safe [$ux:str-or $f@src ""]]
                          [and [$font-src-local [$ux:str-or $f@src ""]]
                               [$font-value-safe [$ux:str-or $f@unicode-range "U-0"]]]]]]]
    [yield [ux-refusal code=ux-bad-font-value font=[$ux:str-or $f@family "?"]]]]]

# theme-root — the `[ux:theme]` element itself, whether the caller passed the
# element or the parsed document that wraps it (serve passes the parse result;
# the fixtures pass literals). The palette walks are DIRECT-child walks — a
# token inside a palette is not a shared token — so they need the real root,
# where the descendant walks above never cared.
[?def theme-root pure [returns any] ($theme::any)
  [?let [= $hs $theme//ux:theme]
    [?if [$ux:found $hs] [then [$first $hs]] [else $theme]]]]

# palette-scheme-known — the ruled scheme set (P0-104). A palette outside it
# would reach the stylesheet as a raw `@media` condition, which is exactly the
# injection shape token-value-safe exists to refuse.
[?def palette-scheme-known pure [returns bool] ($s::string)
  [or [= $s "light"] [= $s "dark"]]]

[?def palette-is-default pure [returns bool] ($p::any)
  [= [$ux:str-or $p@default ""] "true"]]

# palette-refusals — P0-104's gate: every palette claims a scheme from the
# ruled set, no scheme is claimed twice, and when palettes exist exactly one
# is the default. Fail-loud like every token: a half-stated scheme scheme
# would otherwise ship a store whose dark half is whatever fell through.
[?def palette-refusals pure [returns any] ($theme::element)
  [?let
    [= $root [$theme-root $theme]]
    [= $ds [?for [in $p $root/palette] [where [$palette-is-default $p]] [yield $p]]]
    [$ux:joined
      [$ux:joined
        [?for [in $p $root/palette]
          [where [not [$palette-scheme-known [$ux:str-or $p@scheme ""]]]]
          [yield [ux-refusal code=ux-bad-palette-scheme scheme=[$ux:str-or $p@scheme "?"]]]]
        [?for [in $p $root/palette]
          [where [> [$count [?for [in $x $root/palette]
                              [where [= [$ux:str-or $x@scheme ""] [$ux:str-or $p@scheme ""]]]
                              [yield $x]]] 1]]
          [yield [ux-refusal code=ux-bad-palette-scheme scheme=[$ux:str-or $p@scheme "?"]]]]]
      [?if [and [> [$count $root/palette] 0] [not [= [$count $ds] 1]]]
        [then ([ux-refusal code=ux-bad-palette-default])]
        [else ()]]]]]

# theme-refusals — every unsafe token value (inside a palette or out), every
# unsafe or off-origin font entry, and every malformed palette, in one theme
# document.
[?def theme-refusals scope=public pure [returns any] ($theme::element)
  [$ux:joined
    [?for [in $t $theme//token]
      [where [not [$token-value-safe [$string $t@value]]]]
      [yield [ux-refusal code=ux-bad-token-value token=[$string $t@name]]]]
    [$ux:joined [$font-refusals $theme] [$palette-refusals $theme]]]]

# theme-vars — the `:root` custom-property block: one `--cx-<name>` per token.
# theme-fonts — the `@font-face` block, from the theme's own `[font …]`
# entries. The font FILES are part of the theme, not of the emitter: a rebrand
# that changes the typeface is a document put, exactly like a rebrand that
# changes a colour, and P0-33's "every visual decision lives in the token
# system" has no exception for type.
[?def theme-fonts pure [returns string] ($theme::element)
  [$join-str
    [?for [in $f $theme//font]
      [yield [$concat "@font-face{font-family:\"" [$string $f@family] "\";"
               "src:url(\"" [$string $f@src] "\") format(\"woff2\");"
               "font-weight:" [$ux:str-or $f@weight "400"] ";"
               "font-style:" [$ux:str-or $f@style "normal"] ";"
               "font-display:" [$ux:str-or $f@display "swap"] ";"
               [?if [= [$ux:str-or $f@unicode-range ""] ""]
                 [then ""]
                 [else [$concat "unicode-range:" [$ux:str-or $f@unicode-range ""] ";"]]]
               "}\n"]]]]]

# token-decls — one `--cx-<name>` custom property per token, in order.
[?def token-decls pure [returns string] ($ts::any)
  [$join-str [?for [in $t $ts]
               [yield [$concat "--cx-" [$string $t@name] ":" [$string $t@value] ";"]]]]]

# theme-vars — the shared tokens and the default palette are `:root`; each
# non-default palette re-states its custom properties under that scheme's
# `prefers-color-scheme` condition (P0-104). A theme with no palettes emits
# byte-identically to the single-block form this generalizes.
[?def theme-vars scope=public pure [returns string] ($theme::element)
  [?let [= $root [$theme-root $theme]]
    [$concat ":root{"
      [$token-decls $root/token]
      [$join-str [?for [in $p $root/palette]
                   [where [$palette-is-default $p]]
                   [yield [$token-decls $p/token]]]]
      "}\n"
      [$join-str [?for [in $p $root/palette]
                   [where [not [$palette-is-default $p]]]
                   [yield [$concat "@media (prefers-color-scheme: " [$string $p@scheme] "){:root{"
                            [$token-decls $p/token] "}}\n"]]]]]]]

# join-str — concatenate a sequence of strings. (Sequence → one string; the
# fold keeps this a pure, total reduction.)
[?def join-str scope=public pure [returns string] ($parts::any)
  [$reduce $parts [?fn ($acc $p) [$concat $acc $p]] ""]]

# component-rules — the pack-owned rule table: the .ux-* class surface bound to
# theme tokens. STRUCTURED data, not pasted CSS text — the stylesheet is a
# projection of this table exactly as the page is a projection of the semantic
# tree, and the same discipline (no string interpolation of caller data)
# applies. Every declaration references a token; nothing here hard-codes a
# color, a size, or a font.
[?def component-rules scope=public pure [returns any] ()
  [ux:rules
   [rule sel="*"
     [decl prop=box-sizing value="border-box"]]
   [rule sel="body"
     [decl prop=background value="var(--cx-bg)"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-base)"]
     [decl prop=line-height value="var(--cx-leading)"]
     [decl prop=margin value="0"]
     [decl prop="-webkit-font-smoothing" value="antialiased"]]

   [; -- the top bar. A console needs one line that says where you are, and
      the nav is the only element that can carry it. ]
   [rule sel=".ux-nav"
     [decl prop=background value="var(--cx-surface)"]
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=padding value="0 var(--cx-space-5)"]
     [decl prop=position value="sticky"]
     [decl prop=top value="0"]
     [decl prop=z-index value="10"]]
   [rule sel=".ux-nav ul"
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-2)"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [; a menu item's label is a LABEL: it does not wrap mid-phrase. This was
      stated only inside the narrow media query, so at wide widths a squeezed
      bar broke "Basket · 0 items · $0.00" across two lines — wrong at every
      width, not just small ones. ]
   [rule sel=".ux-nav-item a"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]
     [decl prop=white-space value="nowrap"]
     [decl prop=padding value="var(--cx-space-4) var(--cx-space-3)"]
     [decl prop=text-decoration value="none"]
     [decl prop=border-bottom value="2px solid transparent"]]
   [rule sel=".ux-nav-item a:hover"
     [decl prop=color value="var(--cx-fg)"]]

   [rule sel="body > .ux-region"
     [decl prop=padding value="var(--cx-space-5)"]
     [decl prop=max-width value="76rem"]]
   [rule sel=".ux-region"
     [decl prop=display value="block"]]

   [; -- panels ]
   [rule sel=".ux-card"
     [decl prop=background value="var(--cx-surface)"]
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=border-radius value="var(--cx-radius)"]
     [decl prop=box-shadow value="var(--cx-shadow-card)"]
     [decl prop=padding value="var(--cx-space-4)"]
     [decl prop=margin-bottom value="var(--cx-space-4)"]]
   [rule sel=".ux-card > .ux-card:last-child"
     [decl prop=margin-bottom value="0"]]
   [rule sel=".ux-heading"
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=font-family value="var(--cx-font-heading)"]
     [decl prop=font-size value="var(--cx-text-title)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=letter-spacing value="-0.01em"]
     [decl prop=margin value="0 0 var(--cx-space-4) 0"]]
   [rule sel=".ux-text"
     [decl prop=margin value="0 0 var(--cx-space-3) 0"]]

   [; -- tables. The header is a label row, not a heading: small, tracked,
      muted. Figures are tabular so a column of totals lines up. ]
   [rule sel=".ux-table"
     [decl prop=border-collapse value="collapse"]
     [decl prop=font-variant-numeric value="tabular-nums"]
     [decl prop=width value="100%"]]
   [rule sel=".ux-column"
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]
     [decl prop=padding value="0 var(--cx-space-3) var(--cx-space-2) var(--cx-space-3)"]
     [decl prop=text-align value="left"]
     [decl prop=text-transform value="uppercase"]
     [decl prop=white-space value="nowrap"]]
   [rule sel=".ux-row"
     [decl prop=transition value="background 90ms linear"]]
   [rule sel=".ux-row:hover"
     [decl prop=background value="var(--cx-row-hover)"]]
   [rule sel=".ux-cell"
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=padding value="var(--cx-space-3)"]
     [decl prop=vertical-align value="top"]]
   [rule sel=".ux-rows .ux-row:last-child .ux-cell"
     [decl prop=border-bottom value="none"]]
   [rule sel=".ux-cell .ux-table"
     [decl prop=margin value="0"]]
   [rule sel=".ux-cell .ux-cell"
     [decl prop=border-bottom value="none"]
     [decl prop=padding value="0 var(--cx-space-2) 0 0"]]

   [; -- an identifier is a token to compare, not prose to read ]
   [rule sel=".ux-link"
     [decl prop=color value="var(--cx-accent)"]
     [decl prop=font-family value="var(--cx-font-mono)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-link:hover"
     [decl prop=text-decoration value="underline"]]

   [; -- nested collections read as one row per item, not one row per field ]
   [rule sel=".ux-list"
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-item"
     [decl prop=padding value="0"]]
   [rule sel=".ux-cell .ux-list"
     [decl prop=display value="flex"]
     [decl prop=flex-direction value="column"]
     [decl prop=gap value="var(--cx-space-1)"]]
   [rule sel=".ux-item > .ux-card"
     [decl prop=background value="var(--cx-surface-sunk)"]
     [decl prop=box-shadow value="none"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=margin value="0 0 var(--cx-space-1) 0"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-3)"]]
   [rule sel=".ux-item .ux-field"
     [decl prop=align-items value="baseline"]
     [decl prop=display value="inline-flex"]
     [decl prop=gap value="var(--cx-space-2)"]
     [decl prop=padding value="0"]]
   [; a nested value is DATA, so it reads as a figure rather than as prose ]
   [rule sel=".ux-item .ux-field-value"
     [decl prop=font-family value="var(--cx-font-mono)"]
     [decl prop=font-size value="var(--cx-text-small)"]]
   [rule sel=".ux-item .ux-field-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=min-width value="0"]
     [decl prop=text-transform value="uppercase"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]]

   [; -- badges. A tone is a meaning; this is where it becomes a colour. ]
   [rule sel=".ux-badge"
     [decl prop=border-radius value="var(--cx-radius-pill)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=line-height value="1.6"]
     [decl prop=padding value="0 var(--cx-space-3)"]
     [decl prop=white-space value="nowrap"]]
   [rule sel=".ux-badge-ok"      [decl prop=background value="var(--cx-tone-ok)"]      [decl prop=color value="var(--cx-tone-ok-fg)"]]
   [rule sel=".ux-badge-warn"    [decl prop=background value="var(--cx-tone-warn)"]    [decl prop=color value="var(--cx-tone-warn-fg)"]]
   [rule sel=".ux-badge-danger"  [decl prop=background value="var(--cx-tone-danger)"]  [decl prop=color value="var(--cx-tone-danger-fg)"]]
   [rule sel=".ux-badge-info"    [decl prop=background value="var(--cx-tone-info)"]    [decl prop=color value="var(--cx-tone-info-fg)"]]
   [rule sel=".ux-badge-neutral" [decl prop=background value="var(--cx-tone-neutral)"] [decl prop=color value="var(--cx-tone-neutral-fg)"]]

   [; -- read-only field pairs ]
   [rule sel=".ux-field"
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=padding value="0 0 var(--cx-space-2) 0"]]
   [rule sel=".ux-field-label"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=min-width value="var(--cx-label-width)"]]

   [; -- controls ]
   [rule sel=".ux-control-field"
     [decl prop=display value="flex"]
     [decl prop=align-items value="center"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=padding value="0 0 var(--cx-space-3) 0"]]
   [rule sel=".ux-control-field > .ux-label"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=min-width value="var(--cx-label-width)"]]
   [rule sel=".ux-control"
     [decl prop=background value="var(--cx-surface)"]
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border-strong)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=font value="inherit"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-3)"]
     [decl prop=width value="var(--cx-control-width)"]]
   [rule sel=".ux-control:focus"
     [decl prop=border-color value="var(--cx-accent)"]
     [decl prop=box-shadow value="0 0 0 3px var(--cx-focus-ring)"]
     [decl prop=outline value="none"]]
   [rule sel="input.ux-control[type=checkbox]"
     [decl prop=width value="auto"]]
   [rule sel=".ux-help"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]]

   [; -- the filter sits above its collection, not in the form column ]
   [; a repeating group reads as a small section: the legend names it, the
      instances stack, and each instance is a row of controls rather than a
      stack of them -- a line item is one line. ]
   [rule sel=".ux-group"
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=margin value="0 0 var(--cx-space-4) 0"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4) var(--cx-space-4)"]]
   [rule sel=".ux-group-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]
     [decl prop=padding value="0 var(--cx-space-2)"]
     [decl prop=text-transform value="uppercase"]]
   [; an instance row: the instance's controls, then the control that removes
      it. `align-items: center` on the ROW rather than the card so the remove
      button lines up with the inputs and not with the label above them. ]
   [rule sel=".ux-group-row"
     [decl prop=align-items value="center"]
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-2)"]]
   [rule sel=".ux-group-row > .ux-card"
     [decl prop=flex value="1"]]
   [rule sel=".ux-remove"
     [decl prop=background value="transparent"]
     [decl prop=border value="var(--cx-border-width) solid transparent"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=cursor value="pointer"]
     [decl prop=font value="inherit"]
     [decl prop=line-height value="1"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-3)"]]
   [rule sel=".ux-remove:hover"
     [decl prop=background value="var(--cx-tone-danger)"]
     [decl prop=border-color value="var(--cx-tone-danger)"]
     [decl prop=color value="var(--cx-tone-danger-fg)"]]
   [rule sel=".ux-remove:focus-visible"
     [decl prop=box-shadow value="0 0 0 3px var(--cx-focus-ring)"]
     [decl prop=outline value="none"]]
   [rule sel=".ux-group-items > .ux-card"
     [decl prop=align-items value="center"]
     [decl prop=background value="transparent"]
     [decl prop=border value="none"]
     [decl prop=box-shadow value="none"]
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=margin value="0"]
     [decl prop=padding value="var(--cx-space-1) 0"]]
   [rule sel=".ux-group-items .ux-control-field"
     [decl prop=gap value="var(--cx-space-2)"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-group-items .ux-label"
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=min-width value="auto"]]
   [rule sel=".ux-group-items select.ux-control"
     [decl prop=width value="22rem"]]
   [rule sel=".ux-group-items input.ux-control"
     [decl prop=width value="5rem"]]
   [rule sel="select.ux-control"
     [decl prop=cursor value="pointer"]]
   [rule sel=".ux-filter"
     [decl prop=padding value="0 0 var(--cx-space-4) 0"]]
   [rule sel=".ux-filter > .ux-label"
     [decl prop=min-width value="auto"]]

   [; -- actions. A form's button, because a button that only works with the
      kernel loaded is a button that does not work (P0-81). Quiet surface by
      default; the loud accent belongs to the PRIMARY act and the submit. The
      hover is one shade of ground, never the accent — an accent flash on a
      secondary control spends the money colour on nothing. ]
   [rule sel=".ux-action"
     [decl prop=background value="var(--cx-surface)"]
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border-strong)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=cursor value="pointer"]
     [decl prop=font value="inherit"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4)"]]
   [rule sel=".ux-action:hover"
     [decl prop=background value="var(--cx-surface-sunk)"]]
   [; the quiet variant follows `.ux-action` deliberately: same specificity,
      later wins, so a secondary control is a modifier rather than a new class
      that has to restate everything ]
   [rule sel=".ux-action-quiet"
     [decl prop=background value="transparent"]
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border-strong)"]
     [decl prop=color value="var(--cx-accent)"]
     [decl prop=margin-top value="var(--cx-space-2)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-4)"]]
   [rule sel=".ux-action-quiet:hover"
     [decl prop=background value="var(--cx-surface-sunk)"]]
   [rule sel=".ux-action:focus-visible"
     [decl prop=box-shadow value="0 0 0 3px var(--cx-focus-ring)"]
     [decl prop=outline value="none"]]

   [; -- an unavailable act, stated (P0-99) --------------------------------
      The control keeps its geometry and its label; what changes is that it
      visibly cannot be pressed, and the why sits beside it. Same accent
      tokens desaturated by opacity rather than a new palette entry, so a
      theme change moves both states together. ]
   [rule sel=".ux-action-unavailable .ux-action"
     [decl prop=cursor value="not-allowed"]
     [decl prop=opacity value="0.5"]]
   [rule sel=".ux-action-reason"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=display value="block"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=margin-top value="var(--cx-space-2)"]]

   [; -- a refusal, ON the field it is about ------------------------------
      A banner at the top of a form says something is wrong and makes the
      operator hunt for what. The command layer already knows which field it
      refused, so the message is rendered where that field is. The red border
      is the glance; the sentence is the answer; `aria-invalid` is the half a
      screen reader gets, and it is emitted next to both. ]
   [rule sel=".ux-control-bad"
     [decl prop=border-color value="var(--cx-tone-danger-fg)"]]
   [rule sel=".ux-control-bad:focus"
     [decl prop=border-color value="var(--cx-tone-danger-fg)"]
     [decl prop=box-shadow value="0 0 0 3px var(--cx-tone-danger)"]]
   [rule sel=".ux-field-error"
     [decl prop=color value="var(--cx-tone-danger-fg)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]]

   [; -- in flight ---------------------------------------------------------
      htmx sets `.htmx-request` on the element named by `hx-indicator` for
      exactly as long as the request is outstanding. A control that looks
      identical before and after a click reads as broken on a slow link, and
      this is the whole cost of fixing that: two rules and no script. ]
   [rule sel=".ux-busy"
     [decl prop=opacity value="1"]
     [decl prop=transition value="opacity 120ms ease-in"]]
   [rule sel=".ux-busy.htmx-request"
     [decl prop=opacity value="0.55"]]
   [rule sel=".ux-form.htmx-request .ux-action"
     [decl prop=cursor value="progress"]]
   [rule sel=".htmx-request .ux-action"
     [decl prop=cursor value="progress"]]

   [rule sel=".ux-notice"
     [decl prop=background value="var(--cx-tone-info)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-tone-info-fg)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]
     [decl prop=margin value="0 0 var(--cx-space-4) 0"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4)"]]
   [rule sel=".ux-notice-ok"
     [decl prop=background value="var(--cx-tone-ok)"]
     [decl prop=color value="var(--cx-tone-ok-fg)"]]
   [rule sel=".ux-notice-warn"
     [decl prop=background value="var(--cx-tone-warn)"]
     [decl prop=color value="var(--cx-tone-warn-fg)"]]

   [rule sel=".ux-error"
     [decl prop=background value="var(--cx-tone-danger)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-tone-danger-fg)"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4)"]]
   [rule sel=".ux-error .ux-text"
     [decl prop=margin value="0"]]

   [rule sel=".htmx-indicator"
     [decl prop=opacity value="0"]]
   [rule sel=".htmx-request .htmx-indicator"
     [decl prop=opacity value="1"]]

   [; ══ W10's members ═══════════════════════════════════════════════════════
      Every declaration below references a token. Nothing here writes a colour,
      a size, or a font — which is what makes a rebrand a document put, and
      what makes "the store is too cramped" an edit to `oriel-theme.cx` rather
      than an archaeology expedition through a stylesheet. ]

   [; -- depiction. A square well with the art centred in it: the illustrations
      are drawn on their own wash, so the well is transparent and the artwork
      supplies the ground. `object-fit: contain` so a depiction is never
      cropped — a cropped picture of a thing you are deciding whether to buy is
      a picture of the wrong thing. ]
   [rule sel=".ux-media"
     [decl prop=aspect-ratio value="var(--cx-media-ratio)"]
     [decl prop=background value="var(--cx-surface-sunk)"]
     [decl prop=border-radius value="var(--cx-radius)"]
     [decl prop=display value="block"]
     [decl prop=object-fit value="contain"]
     [decl prop=width value="100%"]]
   [; a depiction INSIDE A LIST ITEM is a thumbnail. A basket line is a row of
      facts with a picture at the front of it, not a picture with facts under
      it — and which one it is, is a fact about where the media sits, which the
      renderer can see. ]
   [rule sel=".ux-item"
     [decl prop=align-items value="center"]
     [decl prop=column-gap value="var(--cx-line-gap)"]
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="var(--cx-media-thumb) minmax(0, 1fr)"]
     [decl prop=padding value="var(--cx-space-3) 0"]]
   [rule sel=".ux-item:has(> .ux-media)"
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]]
   [rule sel=".ux-item > .ux-media"
     [decl prop=grid-column value="1"]
     [decl prop=grid-row value="1 / 20"]
     [decl prop=width value="var(--cx-media-thumb)"]]
   [rule sel=".ux-item > *"
     [decl prop=grid-column value="2"]]
   [rule sel=".ux-item:not(:has(> .ux-media))"
     [decl prop=display value="block"]]
   [rule sel=".ux-item .ux-quantity"
     [decl prop=justify-self value="start"]
     [decl prop=margin value="var(--cx-space-2) 0"]]
   [rule sel=".ux-item .ux-field"
     [decl prop=align-items value="baseline"]
     [decl prop=display value="flex"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=gap value="var(--cx-space-3)"]]
   [rule sel=".ux-item .ux-field-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=white-space value="nowrap"]]
   [rule sel=".ux-item .ux-action-form .ux-action"
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-3)"]]
   [; the aside's own footer: the totals and the two ways out. ]
   [rule sel=".ux-aside-body > .ux-field"
     [decl prop=border-top value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=display value="flex"]
     [decl prop=font-size value="var(--cx-text-lead)"]
     [decl prop=justify-content value="space-between"]
     [decl prop=padding value="var(--cx-space-4) 0"]]
   [rule sel=".ux-aside-body > .ux-link"
     [decl prop=background value="var(--cx-accent)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-accent-fg)"]
     [decl prop=display value="block"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=padding value="var(--cx-space-4)"]
     [decl prop=text-align value="center"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-aside-body > .ux-action-danger"
     [decl prop=display value="block"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=margin-top value="var(--cx-space-4)"]
     [decl prop=text-align value="center"]]

   [rule sel=".ux-aside .ux-list"
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]

   [rule sel=".ux-media-glyph"
     [decl prop=aspect-ratio value="1/1"]
     [decl prop=width value="var(--cx-space-6)"]]

   [; -- the grid. Track sizing from tokens: `auto-fill` plus a minimum means
      the column count is a fact about the viewport, which is exactly why the
      vocabulary refuses to carry one (P0-55). ]
   [rule sel=".ux-grid"
     [decl prop=display value="grid"]
     [decl prop=gap value="var(--cx-grid-gap)"]
     [decl prop=grid-template-columns value="repeat(auto-fill, minmax(var(--cx-grid-min), 1fr))"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-grid-compact"
     [decl prop=gap value="var(--cx-space-4)"]]
   [rule sel=".ux-grid > .ux-card"
     [decl prop=display value="flex"]
     [decl prop=flex-direction value="column"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=height value="100%"]
     [decl prop=margin value="0"]
     [decl prop=transition value="box-shadow 120ms ease, transform 120ms ease"]]
   [rule sel=".ux-grid > .ux-card:hover"
     [decl prop=box-shadow value="var(--cx-shadow-lift)"]
     [decl prop=transform value="translateY(-2px)"]]
   [; the buy control sits at the bottom of every card whatever the name length
      above it, so a row of cards has one baseline for its actions. ]
   [rule sel=".ux-grid > .ux-card > .ux-action-form"
     [decl prop=margin-top value="auto"]]
   [; inside a card the label/value pairs are a compact ledger rather than a
      form: the label stays on one line, the value is right-aligned, and the
      price is the one that carries weight. ]
   [rule sel=".ux-grid .ux-card .ux-field"
     [decl prop=align-items value="baseline"]
     [decl prop=display value="flex"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=justify-content value="space-between"]]
   [rule sel=".ux-grid .ux-card .ux-field-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=white-space value="nowrap"]]
   [rule sel=".ux-grid .ux-card .ux-field-value"
     [decl prop=text-align value="right"]]
   [rule sel=".ux-grid .ux-card .ux-heading"
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-base)"]
     [decl prop=line-height value="var(--cx-leading-tight)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-grid .ux-card .ux-text"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=margin value="0 0 var(--cx-space-2) 0"]]
   [rule sel=".ux-grid .ux-card .ux-heading a"
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=text-decoration value="none"]]

   [; -- item-scoped actions. The base `.ux-action` chrome lives with the
      quiet/unavailable modifiers above; only the emphasis variants are here. ]
   [rule sel=".ux-action-form"
     [decl prop=margin value="0"]]
   [rule sel=".ux-action-primary"
     [decl prop=background value="var(--cx-accent)"]
     [decl prop=border-color value="var(--cx-accent)"]
     [decl prop=color value="var(--cx-accent-fg)"]
     [decl prop=width value="100%"]]
   [rule sel=".ux-action-primary:hover"
     [decl prop=background value="var(--cx-accent-sunk)"]]
   [; a command form's submit is its one act — primary by default, sized to
      its label rather than the primary-action full width (a form's submit
      sits under its fields, not across a card). ]
   [rule sel=".ux-submit"
     [decl prop=background value="var(--cx-accent)"]
     [decl prop=border-color value="var(--cx-accent)"]
     [decl prop=color value="var(--cx-accent-fg)"]]
   [rule sel=".ux-submit:hover"
     [decl prop=background value="var(--cx-accent-sunk)"]]
   [; a destructive act is a QUIET DANGER LINK, not a button competing with
      the primary: colour says danger, chrome says nothing (audit2 letter (j),
      the W23 half). The hover restores the underline a link owes its reader. ]
   [rule sel=".ux-action-danger"
     [decl prop=background value="transparent"]
     [decl prop=border value="none"]
     [decl prop=color value="var(--cx-tone-danger-fg)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-action-danger:hover"
     [decl prop=background value="transparent"]
     [decl prop=text-decoration value="underline"]]
   [rule sel=".ux-action:disabled"
     [decl prop=cursor value="not-allowed"]
     [decl prop=opacity value="0.45"]]

   [; -- the quantity control. Three real submits in one group. At a bound the
      affordance is DISABLED rather than removed, so the geometry never shifts
      under the pointer (P0-58). ]
   [rule sel=".ux-quantity"
     [decl prop=align-items value="center"]
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border-strong)"]
     [decl prop=border-radius value="var(--cx-radius-pill)"]
     [decl prop=display value="inline-flex"]
     [decl prop=overflow value="hidden"]]
   [rule sel=".ux-quantity-arm"
     [decl prop=display value="flex"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-quantity-button"
     [decl prop=background value="none"]
     [decl prop=border value="0"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=cursor value="pointer"]
     [decl prop=font value="inherit"]
     [decl prop=line-height value="1"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4)"]]
   [rule sel=".ux-quantity-button:disabled"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=cursor value="not-allowed"]]
   [rule sel=".ux-quantity-value"
     [decl prop=font-variant-numeric value="tabular-nums"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]
     [decl prop=min-width value="var(--cx-space-5)"]
     [decl prop=text-align value="center"]]
   [; direct entry (W23): the value is a real input riding inside the pill —
      chrome-less, centered, native spinners off (the arms ARE the spinners). ]
   [rule sel="input.ux-quantity-value"
     [decl prop=appearance value="textfield"]
     [decl prop=background value="transparent"]
     [decl prop=border value="none"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=font value="inherit"]
     [decl prop=width value="var(--cx-space-7)"]]
   [rule sel="input.ux-quantity-value::-webkit-outer-spin-button, input.ux-quantity-value::-webkit-inner-spin-button"
     [decl prop=appearance value="none"]
     [decl prop=margin value="0"]]
   [; field mode (W23 letter (i)): a labeled bounded number field of the form
      it sits in. ]
   [rule sel=".ux-quantity-field"
     [decl prop=align-items value="center"]
     [decl prop=border value="none"]
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=margin value="0 0 var(--cx-space-3) 0"]]
   [rule sel=".ux-quantity-field .ux-label"
     [decl prop=color value="var(--cx-fg-muted)"]]
   [rule sel=".ux-quantity-field .ux-control"
     [decl prop=width value="6rem"]]

   [; -- the flow position. The current step is heavier and darker; done steps
      are links, ahead steps are not, and the difference is visible without
      colour because colour is not a channel everyone has. ]
   [rule sel=".ux-steps-list"
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0 0 var(--cx-space-5) 0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-step"
     [decl prop=align-items value="center"]
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=display value="flex"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]
     [decl prop=text-transform value="uppercase"]]
   [rule sel=".ux-step + .ux-step::before"
     [decl prop=color value="var(--cx-border-strong)"]
     [decl prop=content value="'/'"]]
   [rule sel=".ux-step-done"
     [decl prop=color value="var(--cx-accent)"]]
   [rule sel=".ux-step-current"
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=font-weight value="var(--cx-weight-heavy)"]]
   [rule sel=".ux-steps a"
     [decl prop=color value="inherit"]]

   [; -- where you are. ]
   [rule sel=".ux-breadcrumb ol"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0 0 var(--cx-space-4) 0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-crumb + .ux-crumb::before"
     [decl prop=color value="var(--cx-border-strong)"]
     [decl prop=content value="'/'"]
     [decl prop=padding-right value="var(--cx-space-3)"]]

   [; -- the window over the collection. ]
   [rule sel=".ux-pager"
     [decl prop=align-items value="center"]
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=margin value="var(--cx-space-6) 0 var(--cx-space-5) 0"]]
   [rule sel=".ux-pager-pages"
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-2)"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-pager a"
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-variant-numeric value="tabular-nums"]
     [decl prop=min-width value="var(--cx-space-6)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-3)"]
     [decl prop=text-align value="center"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-pager .ux-page-current"
     [decl prop=background value="var(--cx-accent)"]
     [decl prop=border-color value="var(--cx-accent)"]
     [decl prop=color value="var(--cx-accent-fg)"]]
   [rule sel=".ux-pager [aria-disabled]"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=cursor value="not-allowed"]]
   [rule sel=".ux-pager-count"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=margin-left value="auto"]]

   [; -- facets. The count is text beside the label rather than a decoration,
      because the count is the member's whole reason to exist. ]
   [rule sel=".ux-facet"
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=padding value="0 0 var(--cx-space-4) 0"]
     [decl prop=margin value="0 0 var(--cx-space-4) 0"]]
   [rule sel=".ux-facet-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-micro)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]
     [decl prop=margin value="0 0 var(--cx-space-3) 0"]
     [decl prop=text-transform value="uppercase"]]
   [rule sel=".ux-facet-values"
     [decl prop=display value="flex"]
     [decl prop=flex-direction value="column"]
     [decl prop=gap value="var(--cx-space-1)"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-facet-values a"
     [decl prop=align-items value="baseline"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=display value="flex"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=gap value="var(--cx-space-2)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-2)"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-facet-values a:hover"
     [decl prop=background value="var(--cx-row-hover)"]]
   [rule sel=".ux-facet-on a"
     [decl prop=font-weight value="var(--cx-weight-bold)"]]
   [rule sel=".ux-facet-mark"
     [decl prop=color value="var(--cx-accent)"]
     [decl prop=width value="var(--cx-space-4)"]]
   [rule sel=".ux-facet-name"
     [decl prop=flex value="1"]]
   [rule sel=".ux-facet-count"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-micro)"]
     [decl prop=font-variant-numeric value="tabular-nums"]]

   [; -- ordering. ]
   [rule sel=".ux-sort"
     [decl prop=align-items value="baseline"]
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=gap value="var(--cx-space-3)"]]
   [rule sel=".ux-sort-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]]
   [rule sel=".ux-sort-options"
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=list-style value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-sort-options a"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-sort-on a"
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=text-decoration value="underline"]
     [decl prop=text-underline-offset value="3px"]]

   [; -- the secondary region. NOT a modal: no overlay, no focus trap, and the
      primary region stays interactive behind it (P0-63). ]
   [rule sel=".ux-aside"
     [decl prop=background value="var(--cx-surface)"]
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=border-radius value="var(--cx-radius-lg)"]
     [decl prop=box-shadow value="var(--cx-shadow-card)"]
     [decl prop=display value="flex"]
     [decl prop=flex-direction value="column"]
     [decl prop=max-width value="100%"]
     [decl prop=width value="var(--cx-aside-width)"]]
   [rule sel=".ux-aside-open"
     [decl prop=box-shadow value="var(--cx-shadow-lift)"]]
   [rule sel=".ux-aside-head"
     [decl prop=align-items value="baseline"]
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=display value="flex"]
     [decl prop=justify-content value="space-between"]
     [decl prop=padding value="var(--cx-space-4) var(--cx-space-5)"]]
   [rule sel=".ux-aside-title"
     [decl prop=font-family value="var(--cx-font-heading)"]
     [decl prop=font-size value="var(--cx-text-title)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-aside-dismiss"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=font-size value="var(--cx-text-title)"]
     [decl prop=line-height value="1"]
     [decl prop=text-decoration value="none"]]
   [rule sel=".ux-aside-body"
     [decl prop=overflow-y value="auto"]
     [decl prop=padding value="var(--cx-space-4) var(--cx-space-5)"]]

   [; -- the announcement. Present from first paint, empty or not (P0-93):
      a live region inserted with its first message is not announced. ]
   [; the region is ALWAYS in the document (P0-93) and takes up no room until
      it has something to say. `:has(*)` rather than `:not(:empty)` because the
      announcement is wrapped in its own element, so the region is never
      literally empty even when the sentence is. ]
   [rule sel=".ux-status"
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-status:has(span:not(:empty))"
     [decl prop=margin value="0 auto var(--cx-space-4) auto"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4)"]]
   [rule sel=".ux-status-ok:has(span:not(:empty))"
     [decl prop=background value="var(--cx-tone-ok)"]
     [decl prop=color value="var(--cx-tone-ok-fg)"]]
   [rule sel=".ux-status-warn:has(span:not(:empty))"
     [decl prop=background value="var(--cx-tone-warn)"]
     [decl prop=color value="var(--cx-tone-warn-fg)"]]
   [rule sel=".ux-status-danger:has(span:not(:empty))"
     [decl prop=background value="var(--cx-tone-danger)"]
     [decl prop=color value="var(--cx-tone-danger-fg)"]]
   [rule sel=".ux-status-info:has(span:not(:empty))"
     [decl prop=background value="var(--cx-tone-info)"]
     [decl prop=color value="var(--cx-tone-info-fg)"]]

   [; -- money and ratings are FIELD CONTENT, so they are styled where the
      field values are. Money gets tabular figures and its own colour; the
      rating's number always rides beside the marks (P0-66), because a run of
      star glyphs on its own is a picture of a number. ]
   [rule sel="[data-cx-format='money']"
     [decl prop=color value="var(--cx-price)"]
     [decl prop=font-size value="var(--cx-text-lead)"]
     [decl prop=font-variant-numeric value="tabular-nums"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]]
   [rule sel="[data-cx-format='rating']"
     [decl prop=color value="var(--cx-star)"]
     [decl prop=letter-spacing value="0.06em"]
     [decl prop=white-space value="pre"]]

   [; -- the shell. A page needs a measure and a spine; both are tokens. ]
   [rule sel=".ux-page"
     [decl prop=margin value="0 auto"]
     [decl prop=max-width value="var(--cx-page-width)"]
     [decl prop=padding value="var(--cx-space-5)"]]
   [rule sel=".ux-split"
     [decl prop=align-items value="start"]
     [decl prop=display value="grid"]
     [decl prop=gap value="var(--cx-space-6)"]
     [decl prop=grid-template-columns value="minmax(0, 3fr) minmax(0, 1fr)"]]
   [rule sel=".ux-rail"
     [decl prop=display value="grid"]
     [decl prop=gap value="var(--cx-space-6)"]
     [decl prop=grid-template-columns value="minmax(0, 240px) minmax(0, 1fr)"]]

   [; ── the page shell ──────────────────────────────────────────────────────
      A page needs a measure. The outermost region IS the page, so it gets one
      here rather than by asking the surface to place a wrapper it should not
      have to know about. ]
   [rule sel="body > .ux-region > *"
     [decl prop=margin-left value="auto"]
     [decl prop=margin-right value="auto"]
     [decl prop=max-width value="var(--cx-page-width)"]
     [decl prop=width value="100%"]]
   [rule sel="body > .ux-region > .ux-nav"
     [decl prop=max-width value="none"]]
   [rule sel="body > .ux-region > .ux-region"
     [decl prop=padding value="0 var(--cx-space-5) var(--cx-space-7) var(--cx-space-5)"]]
   [rule sel="body > .ux-region > .ux-card"
     [decl prop=margin-bottom value="var(--cx-space-5)"]]

   [; the LAST nav item is pushed to the far end. A basket badge is a
      navigation item — it is a place you go — and the place it goes is the
      other end of the bar, which is where every shopper's eye already is. ]
   [rule sel=".ux-nav li:last-child"
     [decl prop=margin-left value="auto"]]
   [rule sel=".ux-nav li:last-child a"
     [decl prop=background value="var(--cx-accent-wash)"]
     [decl prop=border-radius value="var(--cx-radius-pill)"]
     [decl prop=color value="var(--cx-accent)"]
     [decl prop=font-variant-numeric value="tabular-nums"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-4)"]]

   [; the brand sits first in the nav and is the only thing in the store set in
      the display face at nav size — a shop's name is not a menu item. ]
   [rule sel=".ux-nav li:first-child a"
     [decl prop=font-family value="var(--cx-font-heading)"]
     [decl prop=font-size value="var(--cx-text-title)"]
     [decl prop=font-weight value="var(--cx-weight-heavy)"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]]

   [; -- the store search: one bar, not a form card. ]
   [rule sel=".ux-filter-route"
     [decl prop=align-items value="center"]
     [decl prop=display value="flex"]
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=margin value="var(--cx-space-4) auto"]
     [decl prop=padding value="0 var(--cx-space-5)"]]
   [rule sel=".ux-filter-route .ux-label"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=white-space value="nowrap"]]
   [rule sel=".ux-filter-route .ux-control"
     [decl prop=flex value="1"]
     [decl prop=border-radius value="var(--cx-radius-pill)"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-4)"]]

   [; ── THE RAIL, DERIVED FROM WHAT THE REGION CONTAINS ──────────────────────
      A region that holds facets is a browse region, and a browse region wants
      its narrowing beside its results rather than stacked above them. That is a
      RENDERER decision taken from the SEMANTIC content — no layout member, no
      class the surface has to remember, nothing for a projection to get wrong.
      The terminal renderer reaches the same conclusion from the same tree and
      expresses it with columns instead. ]
   [; ── THE RAIL, ASSIGNED BY TOKEN OVER THE DECLARED PANEL NAME (P0-101) ────
      A panel says WHAT the group is (name=, data); these rules say WHERE a
      group of that name goes on this face — a token decision, exactly like a
      color. The child-selector guesses below them remain for panel-less
      surfaces; a region that declares panels never matches them, because its
      narrowing sits inside a panel rather than as a region child. ]
   [rule sel=".ux-region:has(> .ux-panel[data-cx-panel=narrow])"
     [decl prop=align-items value="start"]
     [decl prop=display value="grid"]
     [decl prop=column-gap value="var(--cx-space-6)"]
     [decl prop=grid-template-columns value="minmax(0, 250px) minmax(0, 1fr)"]]
   [rule sel=".ux-region:has(> .ux-panel[data-cx-panel=narrow]) > .ux-breadcrumb"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-region:has(> .ux-panel[data-cx-panel=narrow]) > .ux-card"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-panel[data-cx-panel=narrow]"
     [decl prop=grid-column value="1"]
     [decl prop=grid-row value="3 / span 3"]
     [decl prop=position value="sticky"]
     [decl prop=top value="var(--cx-space-5)"]]
   [rule sel=".ux-panel[data-cx-panel=sort]"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="3"]]
   [rule sel=".ux-panel[data-cx-panel=results]"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="4"]]
   [rule sel=".ux-region:has(> .ux-panel[data-cx-panel=narrow]) > .ux-pager"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="5"]]

   [rule sel=".ux-facets"
     [decl prop=grid-column value="1"]
     [decl prop=grid-row value="3 / span 3"]
     [decl prop=position value="sticky"]
     [decl prop=top value="var(--cx-space-5)"]]
   [rule sel=".ux-region:has(> .ux-facets)"
     [decl prop=align-items value="start"]
     [decl prop=display value="grid"]
     [decl prop=column-gap value="var(--cx-space-6)"]
     [decl prop=grid-template-columns value="minmax(0, 250px) minmax(0, 1fr)"]]
   [rule sel=".ux-region:has(> .ux-facets) > .ux-breadcrumb"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-region:has(> .ux-facets) > .ux-card"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-region:has(> .ux-facets) > .ux-sort"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="3"]]
   [rule sel=".ux-region:has(> .ux-facets) > .ux-grid"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="4"]]
   [rule sel=".ux-region:has(> .ux-facets) > .ux-text"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="4"]]
   [rule sel=".ux-region:has(> .ux-facets) > .ux-pager"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="5"]]
   [rule sel=".ux-region:has(> .ux-facet)"
     [decl prop=align-items value="start"]
     [decl prop=display value="grid"]
     [decl prop=column-gap value="var(--cx-space-6)"]
     [decl prop=grid-template-columns value="minmax(0, 250px) minmax(0, 1fr)"]]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-breadcrumb"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-card"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-facet"
     [decl prop=grid-column value="1"]]
   [; the rows are placed EXPLICITLY in the results column, so the narrowing
      can flow down the rail beside them instead of pushing them below it. ]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-sort"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="3"]]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-grid"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="4"]]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-text"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="4"]]
   [rule sel=".ux-region:has(> .ux-facet) > .ux-pager"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="5"]]

   [; -- the product page reads as one column of blocks, wide enough to hold a
      depiction beside its facts. ]
   [rule sel=".ux-region:has(> .ux-card > .ux-media)"
     [decl prop=display value="grid"]
     [decl prop=gap value="var(--cx-space-5)"]]
   [rule sel=".ux-card:has(> .ux-media)"
     [decl prop=align-items value="start"]
     [decl prop=column-gap value="var(--cx-space-6)"]
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="minmax(0, 380px) minmax(0, 1fr)"]]
   [rule sel=".ux-card:has(> .ux-media) > .ux-media"
     [decl prop=grid-column value="1"]
     [decl prop=grid-row value="1 / 20"]]
   [rule sel=".ux-grid .ux-card:has(> .ux-media)"
     [decl prop=display value="flex"]
     [decl prop=flex-direction value="column"]]

   [; -- the focus ring is a TOKEN and is never suppressed (P0-94). The
      terminal face proves the reachability; this makes it visible here. ]
   [rule sel=":focus-visible"
     [decl prop=outline value="3px solid var(--cx-focus-ring)"]
     [decl prop=outline-offset value="2px"]]

   [; ══ W23: the dress ══════════════════════════════════════════════════════
      Stylesheet only — zero tree changes, the terminal face untouched. ]

   [; -- register (V3). A product NAME is prose, not an identifier: wherever a
      link is the name of a thing (a heading, a line item), it reads in the
      body face at body size. `.ux-link` itself stays mono, because everywhere
      ELSE a link is a code to compare. ]
   [rule sel=".ux-heading .ux-link"
     [decl prop=font-family value="inherit"]
     [decl prop=font-size value="inherit"]]
   [rule sel=".ux-item > .ux-link"
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-base)"]
     [decl prop=font-weight value="var(--cx-weight-medium)"]]
   [; the basket's checkout CTA is a sentence, not a code ]
   [rule sel=".ux-aside-body > .ux-link"
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-base)"]]

   [; -- merchandise drops its labels (V3). In a grid card and on the detail
      lead, a money or rating value IS its own label — `Price $128.00` is a
      record inspector, `$128.00` is a shop. The label STAYS IN THE MARKUP for
      the reader who cannot see the format (content loss is never a style
      choice), so it hides by clipping, not display:none. ]
   [rule sel=".ux-grid .ux-card .ux-field:has(> [data-cx-format='money']) > .ux-field-label, .ux-grid .ux-card .ux-field:has(> [data-cx-format='rating']) > .ux-field-label, .ux-card:has(> .ux-media) > .ux-field:has(> [data-cx-format='money']) > .ux-field-label, .ux-card:has(> .ux-media) > .ux-field:has(> [data-cx-format='rating']) > .ux-field-label"
     [decl prop=position value="absolute"]
     [decl prop=width value="1px"]
     [decl prop=height value="1px"]
     [decl prop=overflow value="hidden"]
     [decl prop=clip-path value="inset(50%)"]
     [decl prop=white-space value="nowrap"]]

   [; -- the store search is top-bar chrome, not page furniture (owner note,
      2026-08-19): the card chrome dies, the row tucks under the bar's right
      edge, the control is compact, and the label serves the reader who cannot
      see it (clipped, still announced — the input keeps its accessible name). ]
   [rule sel="body > .ux-region > .ux-card:has(> .ux-filter-route)"
     [decl prop=background value="transparent"]
     [decl prop=border value="none"]
     [decl prop=box-shadow value="none"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-filter-route"
     [decl prop=justify-content value="flex-end"]
     [decl prop=margin value="var(--cx-space-3) auto"]]
   [rule sel=".ux-filter-route .ux-label"
     [decl prop=position value="absolute"]
     [decl prop=width value="1px"]
     [decl prop=height value="1px"]
     [decl prop=overflow value="hidden"]
     [decl prop=clip-path value="inset(50%)"]
     [decl prop=white-space value="nowrap"]]
   [rule sel=".ux-filter-route .ux-control"
     [decl prop=flex value="0 1 18rem"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-4)"]]
   [rule sel=".ux-filter-route .ux-action"
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=padding value="var(--cx-space-2) var(--cx-space-4)"]]

   [; -- the basket is a DRAWER (letter (l)). Fixed to the right edge, over
      the page, translating in over 150ms; the primary region stays live
      behind it (P0-63 — no overlay, no focus trap). The width token wins over
      the shell's measure rule by specificity, which is the whole reason this
      selector spells the shell out. ]
   [keyframes name="cx-drawer-in"
     [step at="from" [decl prop=transform value="translateX(100%)"]]
     [step at="to"   [decl prop=transform value="translateX(0)"]]]
   [rule sel="body > .ux-region > .ux-aside"
     [decl prop=animation value="cx-drawer-in 150ms ease"]
     [decl prop=border-radius value="var(--cx-radius-lg) 0 0 var(--cx-radius-lg)"]
     [decl prop=border-right value="none"]
     [decl prop=bottom value="0"]
     [decl prop=box-shadow value="var(--cx-shadow-lift)"]
     [decl prop=margin value="0"]
     [decl prop=max-width value="100vw"]
     [decl prop=position value="fixed"]
     [decl prop=right value="0"]
     [decl prop=top value="0"]
     [decl prop=width value="var(--cx-aside-width)"]
     [decl prop=z-index value="20"]]
   [media query="(prefers-reduced-motion: reduce)"
     [rule sel="body > .ux-region > .ux-aside"
       [decl prop=animation value="none"]]]

   [; ── the ARRANGED region (W26 owner review): the arrangement's own grid.
      Twelve columns; an element's span is SURFACE DATA (the `span` hint on
      its placed element), stamped by the emitter as data-cx-span from the
      render context — the semantic tree stays layout-blind (P0-20). The
      default (no span) is full width via :not, so a stamped span always
      wins on specificity. ]
   [rule sel=".ux-region[data-cx-arranged]"
     [decl prop=align-items value="start"]
     [decl prop=display value="grid"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=grid-template-columns value="repeat(12, minmax(0, 1fr))"]]
   [rule sel=".ux-region[data-cx-arranged] > *"
     [decl prop=margin value="0"]]
   [rule sel=".ux-region[data-cx-arranged] > :not([data-cx-span])"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel="[data-cx-span='1']" [decl prop=grid-column-end value="span 1"]]
   [rule sel="[data-cx-span='2']" [decl prop=grid-column-end value="span 2"]]
   [rule sel="[data-cx-span='3']" [decl prop=grid-column-end value="span 3"]]
   [rule sel="[data-cx-span='4']" [decl prop=grid-column-end value="span 4"]]
   [rule sel="[data-cx-span='5']" [decl prop=grid-column-end value="span 5"]]
   [rule sel="[data-cx-span='6']" [decl prop=grid-column-end value="span 6"]]
   [rule sel="[data-cx-span='7']" [decl prop=grid-column-end value="span 7"]]
   [rule sel="[data-cx-span='8']" [decl prop=grid-column-end value="span 8"]]
   [rule sel="[data-cx-span='9']" [decl prop=grid-column-end value="span 9"]]
   [rule sel="[data-cx-span='10']" [decl prop=grid-column-end value="span 10"]]
   [rule sel="[data-cx-span='11']" [decl prop=grid-column-end value="span 11"]]
   [rule sel="[data-cx-span='12']" [decl prop=grid-column-end value="span 12"]]

   [; ── VARIANTS realized (P0-113): the nav's side orientation, the spacer's
      height — each keyed on the emitter-stamped data-cx-var-* attribute. ]
   [rule sel="nav[data-cx-var-orientation='side']"
     [decl prop=border-bottom value="none"]
     [decl prop=border-right value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=grid-column value="1"]
     [decl prop=grid-row value="1 / 99"]
     [decl prop=min-height value="100vh"]
     [decl prop=padding value="var(--cx-space-4) 0"]
     [decl prop=position value="static"]]
   [rule sel="nav[data-cx-var-orientation='side'] ul"
     [decl prop=align-items value="stretch"]
     [decl prop=flex-direction value="column"]
     [decl prop=gap value="0"]]
   [rule sel="nav[data-cx-var-orientation='side'] .ux-nav-item a"
     [decl prop=border-bottom value="none"]
     [decl prop=display value="block"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-5)"]]
   [rule sel="nav[data-cx-var-orientation='side'] li:last-child"
     [decl prop=margin-left value="0"]
     [decl prop=margin-top value="var(--cx-space-4)"]]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side'])"
     [decl prop=align-items value="start"]
     [decl prop=column-gap value="var(--cx-space-5)"]
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="220px minmax(0, 1fr)"]]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side']) > :not(nav)"
     [decl prop=grid-column value="2"]]
   [rule sel="p[data-cx-var-height='s']" [decl prop=height value="var(--cx-space-4)"] [decl prop=margin value="0"]]
   [rule sel="p[data-cx-var-height='m']" [decl prop=height value="var(--cx-space-6)"] [decl prop=margin value="0"]]
   [rule sel="p[data-cx-var-height='l']" [decl prop=height value="var(--cx-space-7)"] [decl prop=margin value="0"]]

   [; when a region is ARRANGED (a designer set at least one span), the
      12-column grid is the layout and the panel-rail guesses must stand down —
      higher specificity, stated once, so the two systems never fight. ]
   [rule sel=".ux-region[data-cx-arranged]:has(> .ux-panel[data-cx-panel=narrow])"
     [decl prop=grid-template-columns value="repeat(12, minmax(0, 1fr))"]]
   [rule sel=".ux-region[data-cx-arranged] > .ux-panel[data-cx-panel=narrow], .ux-region[data-cx-arranged] > .ux-panel[data-cx-panel=sort], .ux-region[data-cx-arranged] > .ux-panel[data-cx-panel=results], .ux-region[data-cx-arranged] > .ux-pager, .ux-region[data-cx-arranged] > .ux-breadcrumb, .ux-region[data-cx-arranged] > .ux-card"
     [decl prop=grid-row value="auto"]
     [decl prop=position value="static"]]
   [; the rail guesses stand down on COLUMN PLACEMENT only where the designer
      has not spoken. Stated for every element, this rule also flattened every
      declared span to full width — the resize gesture wrote its hint, the
      inspector read it back, and the page never moved. ]
   [rule sel=".ux-region[data-cx-arranged] > .ux-panel[data-cx-panel=narrow]:not([data-cx-span]), .ux-region[data-cx-arranged] > .ux-panel[data-cx-panel=sort]:not([data-cx-span]), .ux-region[data-cx-arranged] > .ux-panel[data-cx-panel=results]:not([data-cx-span]), .ux-region[data-cx-arranged] > .ux-pager:not([data-cx-span]), .ux-region[data-cx-arranged] > .ux-breadcrumb:not([data-cx-span]), .ux-region[data-cx-arranged] > .ux-card:not([data-cx-span])"
     [decl prop=grid-column value="1 / -1"]]
   [rule sel=".ux-region[data-cx-arranged] > [data-cx-span]"
     [decl prop=grid-row value="auto"]]
   [; and the declared width WINS, at a weight that beats the three-class rail
      guesses (see the narrow tier for the same arithmetic). ]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='1']"  [decl prop=grid-column value="auto / span 1"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='2']"  [decl prop=grid-column value="auto / span 2"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='3']"  [decl prop=grid-column value="auto / span 3"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='4']"  [decl prop=grid-column value="auto / span 4"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='5']"  [decl prop=grid-column value="auto / span 5"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='6']"  [decl prop=grid-column value="auto / span 6"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='7']"  [decl prop=grid-column value="auto / span 7"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='8']"  [decl prop=grid-column value="auto / span 8"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='9']"  [decl prop=grid-column value="auto / span 9"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='10']" [decl prop=grid-column value="auto / span 10"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='11']" [decl prop=grid-column value="auto / span 11"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span='12']" [decl prop=grid-column value="auto / span 12"]]

   [; ── THE SHELL BAR (owner review W27): a SEARCH CARD sitting beside the nav
      is part of the bar, not content inside it. Given widths on the shell's own
      grid (the default arrangement gives the menu nine columns and the search
      three), these rules make the two read as ONE bar: same vertical centre,
      the card's own chrome dropped, and the nav's bottom rule continued across
      the search so the line does not stop three columns short. Keyed on
      STRUCTURE (a filter-bearing card that is a sibling of a nav), which is a
      face decision about a shape, not a rule about one document's ids. ]
   [rule sel=".ux-region:has(> .ux-nav) > .ux-card:has(.ux-filter)"
     [decl prop=align-items value="center"]
     [decl prop=align-self value="stretch"]
     [decl prop=background value="var(--cx-surface)"]
     [decl prop=border value="none"]
     [decl prop=border-bottom value="var(--cx-border-width) solid var(--cx-border)"]
     [decl prop=border-radius value="0"]
     [decl prop=box-shadow value="none"]
     [decl prop=display value="flex"]
     [decl prop=justify-content value="flex-end"]
     [decl prop=margin value="0"]
     [decl prop=padding value="0 var(--cx-space-5)"]]
   [; and the control INSIDE it must shrink to the column it was given. A search
      form's intrinsic width is its input plus its button — 372px here — and a
      flex item that wide in a 283px track does not shrink: it overflows, and
      with right-alignment it overflows LEFTWARD, sliding the input in under the
      menu. That was the owner's "layout gibberish": every box was placed
      correctly and the content inside one of them was 89px wider than its
      track. min-width:0 is what lets a flex item honour its track at all. ]
   [rule sel=".ux-region:has(> .ux-nav) > .ux-card:has(.ux-filter) .ux-filter"
     [decl prop=gap value="var(--cx-space-3)"]
     [decl prop=margin value="0"]
     [decl prop=min-width value="0"]
     [decl prop=padding value="0"]
     [decl prop=width value="100%"]]
   [rule sel=".ux-region:has(> .ux-nav) > .ux-card:has(.ux-filter) .ux-filter > .ux-control"
     [decl prop=flex value="1 1 auto"]
     [decl prop=min-width value="0"]
     [decl prop=width value="auto"]]
   [rule sel=".ux-region:has(> .ux-nav) > .ux-card:has(.ux-filter) .ux-filter > .ux-action"
     [decl prop=flex value="0 0 auto"]]
   [rule sel=".ux-region:has(> .ux-nav) > .ux-card:has(.ux-filter) .ux-filter > .ux-label"
     [decl prop=position value="absolute"]
     [decl prop=width value="1px"]
     [decl prop=height value="1px"]
     [decl prop=overflow value="hidden"]
     [decl prop=clip-path value="inset(50%)"]
     [decl prop=white-space value="nowrap"]]

   [; ── A SIDE MENU IS BESIDE THE CONTENT, not above it (owner review W27).
      The rail rules already said so, but inside an ARRANGED region the
      12-column grid outranked them and everything stacked under the menu —
      the exact complaint. Stated here at a weight above both the arranged
      grid and the declared-width rules, because a menu's orientation is a
      decision about the whole region's shape and a width is a decision about
      one child within it. ]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged]:has(> nav[data-cx-var-orientation='side'])"
     [decl prop=align-items value="start"]
     [decl prop=column-gap value="var(--cx-space-5)"]
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="220px minmax(0, 1fr)"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged]:has(> nav[data-cx-var-orientation='side']) > nav[data-cx-var-orientation='side']"
     [decl prop=grid-column value="1"]
     [decl prop=grid-row value="1 / 99"]]
   [rule sel=".ux-region[data-cx-arranged][data-cx-arranged]:has(> nav[data-cx-var-orientation='side']) > :not(nav)"
     [decl prop=grid-column value="2"]]

   [; ── CONTAINER LAYOUT CONTROLS (DS-12): a designer's levers, realized from
      the emitter's variant stamps and the theme's own scale — no px in the
      vocabulary, no CSS in the document, and every value a closed set. ]
   [rule sel="[data-cx-var-cols='2']"
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="repeat(2, minmax(0, 1fr))"]]
   [rule sel="[data-cx-var-cols='3']"
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="repeat(3, minmax(0, 1fr))"]]
   [rule sel="[data-cx-var-cols='4']"
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="repeat(4, minmax(0, 1fr))"]]
   [rule sel="[data-cx-var-gap='tight']"  [decl prop=gap value="var(--cx-space-2)"]]
   [rule sel="[data-cx-var-gap='normal']" [decl prop=gap value="var(--cx-space-4)"]]
   [rule sel="[data-cx-var-gap='loose']"  [decl prop=gap value="var(--cx-space-6)"]]
   [rule sel="[data-cx-var-pad='none']"   [decl prop=padding value="0"]]
   [rule sel="[data-cx-var-pad='tight']"  [decl prop=padding value="var(--cx-space-3)"]]
   [rule sel="[data-cx-var-pad='normal']" [decl prop=padding value="var(--cx-space-5)"]]
   [rule sel="[data-cx-var-pad='loose']"  [decl prop=padding value="var(--cx-space-7)"]]
   [rule sel="[data-cx-var-tone='plain']"
     [decl prop=background value="transparent"]
     [decl prop=border value="none"]
     [decl prop=box-shadow value="none"]]
   [rule sel="[data-cx-var-tone='surface']" [decl prop=background value="var(--cx-surface)"]]
   [rule sel="[data-cx-var-tone='sunk']"
     [decl prop=background value="var(--cx-surface-sunk)"]
     [decl prop=box-shadow value="none"]]
   [rule sel="[data-cx-var-tone='accent']"
     [decl prop=background value="var(--cx-accent-wash)"]
     [decl prop=border-color value="var(--cx-accent)"]]
   [rule sel="[data-cx-var-align='center']"
     [decl prop=align-items value="center"]
     [decl prop=text-align value="center"]]
   [rule sel="[data-cx-var-align='end']"
     [decl prop=align-items value="end"]
     [decl prop=text-align value="right"]]
   [rule sel="[data-cx-var-align='start']"
     [decl prop=align-items value="start"]
     [decl prop=text-align value="left"]]
   [rule sel="[data-cx-var-align='stretch']" [decl prop=align-items value="stretch"]]

   [; ══ THE KIT, DRESSED (DS-12a) ═══════════════════════════════════════════
      Each kit member is ordinary vocabulary; what makes it look designed is
      this table, keyed on the emitter's data-cx-kit stamp and the element's
      closed variant axes. Every declaration references a theme token, so an
      adopter's rebrand moves the whole kit and a client cannot break it. ]

   [; -- a hero split: media beside the words, generous air, big type. ]
   [rule sel=".ux-card[data-cx-kit='hero-split']"
     [decl prop=align-items value="center"]
     [decl prop=column-gap value="var(--cx-space-7)"]
     [decl prop=display value="grid"]
     [decl prop=grid-template-columns value="minmax(0, 1fr) minmax(0, 1fr)"]
     [decl prop=padding value="var(--cx-space-7)"]]
   [rule sel=".ux-card[data-cx-kit='hero-split'] > .ux-media"
     [decl prop=grid-column value="2"]
     [decl prop=grid-row value="1 / 4"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-card[data-cx-kit='hero-split'][data-cx-var-media='left'] > .ux-media"
     [decl prop=grid-column value="1"]]
   [rule sel=".ux-card[data-cx-kit='hero-split'][data-cx-var-media='left'] > .ux-heading, .ux-card[data-cx-kit='hero-split'][data-cx-var-media='left'] > .ux-text, .ux-card[data-cx-kit='hero-split'][data-cx-var-media='left'] > .ux-link"
     [decl prop=grid-column value="2"]]
   [rule sel=".ux-card[data-cx-kit='hero-split'] > .ux-heading"
     [decl prop=font-size value="var(--cx-text-hero)"]
     [decl prop=grid-column value="1"]
     [decl prop=line-height value="var(--cx-leading-tight)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-card[data-cx-kit='hero-split'] > .ux-text"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=font-size value="var(--cx-text-lead)"]
     [decl prop=grid-column value="1"]
     [decl prop=margin value="var(--cx-space-3) 0 0 0"]]
   [rule sel=".ux-card[data-cx-kit='hero-split'] > .ux-link, .ux-card[data-cx-kit='banner'] > .ux-link"
     [decl prop=background value="var(--cx-accent)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-accent-fg)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-base)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=grid-column value="1"]
     [decl prop=justify-self value="start"]
     [decl prop=margin-top value="var(--cx-space-5)"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-5)"]
     [decl prop=text-decoration value="none"]]

   [; -- a banner: one line of persuasion across the measure. ]
   [rule sel=".ux-card[data-cx-kit='banner']"
     [decl prop=align-items value="center"]
     [decl prop=display value="flex"]
     [decl prop=flex-wrap value="wrap"]
     [decl prop=gap value="var(--cx-space-4)"]
     [decl prop=padding value="var(--cx-space-5) var(--cx-space-6)"]]
   [rule sel=".ux-card[data-cx-kit='banner'] > .ux-heading"
     [decl prop=font-size value="var(--cx-text-title)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-card[data-cx-kit='banner'] > .ux-text"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-card[data-cx-kit='banner'] > .ux-link"
     [decl prop=margin value="0"]
     [decl prop=margin-left value="auto"]]

   [; -- a feature: a small heading and a sentence, in a column of peers. ]
   [rule sel=".ux-card[data-cx-kit='feature']"
     [decl prop=padding value="var(--cx-space-5)"]]
   [rule sel=".ux-card[data-cx-kit='feature'] > .ux-heading"
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-lead)"]
     [decl prop=margin value="0 0 var(--cx-space-2) 0"]]
   [rule sel=".ux-card[data-cx-kit='feature'] > .ux-text"
     [decl prop=color value="var(--cx-fg-muted)"]
     [decl prop=margin value="0"]]

   [; -- a stat: the number is the point. ]
   [rule sel=".ux-card[data-cx-kit='stat']"
     [decl prop=padding value="var(--cx-space-5)"]]
   [rule sel=".ux-card[data-cx-kit='stat'] > .ux-heading"
     [decl prop=font-size value="var(--cx-text-display)"]
     [decl prop=font-variant-numeric value="tabular-nums"]
     [decl prop=letter-spacing value="-0.02em"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-card[data-cx-kit='stat'] > .ux-text"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=letter-spacing value="var(--cx-tracking-cap)"]
     [decl prop=margin value="0"]
     [decl prop=text-transform value="uppercase"]]

   [; -- a quote: the words carry it; the attribution stays quiet. ]
   [rule sel=".ux-card[data-cx-kit='quote']"
     [decl prop=padding value="var(--cx-space-6)"]]
   [rule sel=".ux-card[data-cx-kit='quote'] > .ux-text"
     [decl prop=font-family value="var(--cx-font-heading)"]
     [decl prop=font-size value="var(--cx-text-title)"]
     [decl prop=line-height value="var(--cx-leading)"]
     [decl prop=margin value="0"]]
   [rule sel=".ux-card[data-cx-kit='quote'] > .ux-field"
     [decl prop=color value="var(--cx-fg-subtle)"]
     [decl prop=font-size value="var(--cx-text-small)"]
     [decl prop=margin-top value="var(--cx-space-4)"]
     [decl prop=padding value="0"]]
   [rule sel=".ux-card[data-cx-kit='quote'] > .ux-field .ux-field-label"
     [decl prop=min-width value="auto"]]

   [; -- sections and galleries are containers: their children stack or grid,
      and their air is a token choice. ]
   [rule sel=".ux-card[data-cx-kit='section'], .ux-card[data-cx-kit='group']"
     [decl prop=display value="flex"]
     [decl prop=flex-direction value="column"]
     [decl prop=gap value="var(--cx-space-4)"]]
   [rule sel=".ux-card[data-cx-kit='section'] > *, .ux-card[data-cx-kit='group'] > *"
     [decl prop=margin-bottom value="0"]]
   [rule sel="[data-cx-var-width='narrow']"
     [decl prop=margin-left value="auto"]
     [decl prop=margin-right value="auto"]
     [decl prop=max-width value="42rem"]]
   [rule sel="[data-cx-var-width='page']"
     [decl prop=margin-left value="auto"]
     [decl prop=margin-right value="auto"]
     [decl prop=max-width value="var(--cx-page-width)"]]
   [rule sel="[data-cx-var-width='full']"
     [decl prop=max-width value="none"]]

   [; -- leaf style axes: type scale, emphasis, media shape, call-to-action. ]
   [rule sel="[data-cx-var-size='small'] .ux-text, [data-cx-var-size='small'].ux-text"
     [decl prop=font-size value="var(--cx-text-small)"]]
   [rule sel="[data-cx-var-size='lead'] .ux-text, [data-cx-var-size='lead'].ux-text"
     [decl prop=font-size value="var(--cx-text-lead)"]]
   [rule sel="[data-cx-var-tone='muted'] .ux-text, [data-cx-var-tone='muted'] .ux-heading"
     [decl prop=color value="var(--cx-fg-muted)"]]
   [rule sel="[data-cx-var-tone='subtle'] .ux-text, [data-cx-var-tone='subtle'] .ux-heading"
     [decl prop=color value="var(--cx-fg-subtle)"]]
   [rule sel="[data-cx-var-tone='ink']"
     [decl prop=background value="var(--cx-fg)"]
     [decl prop=color value="var(--cx-bg)"]]
   [rule sel="[data-cx-var-tone='ink'] .ux-heading, [data-cx-var-tone='ink'] .ux-text, [data-cx-var-tone='ink'] .ux-field"
     [decl prop=color value="var(--cx-bg)"]]
   [rule sel="[data-cx-var-ratio='square'] , [data-cx-var-ratio='square'] .ux-media"
     [decl prop=aspect-ratio value="1 / 1"]]
   [rule sel="[data-cx-var-ratio='wide'] , [data-cx-var-ratio='wide'] .ux-media"
     [decl prop=aspect-ratio value="16 / 9"]]
   [rule sel="[data-cx-var-ratio='tall'] , [data-cx-var-ratio='tall'] .ux-media"
     [decl prop=aspect-ratio value="3 / 4"]]
   [rule sel="[data-cx-var-ratio='natural'] , [data-cx-var-ratio='natural'] .ux-media"
     [decl prop=aspect-ratio value="auto"]]
   [rule sel="[data-cx-var-fit='cover'] .ux-media, [data-cx-var-fit='cover'].ux-media"
     [decl prop=object-fit value="cover"]]
   [rule sel="[data-cx-var-radius='none'] .ux-media" [decl prop=border-radius value="0"]]
   [rule sel="[data-cx-var-radius='round'] .ux-media" [decl prop=border-radius value="var(--cx-radius-lg)"]]
   [rule sel="[data-cx-var-style='primary'] .ux-link"
     [decl prop=background value="var(--cx-accent)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-accent-fg)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=font-size value="var(--cx-text-base)"]
     [decl prop=font-weight value="var(--cx-weight-bold)"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-5)"]
     [decl prop=text-decoration value="none"]]
   [rule sel="[data-cx-var-style='quiet'] .ux-link"
     [decl prop=border value="var(--cx-border-width) solid var(--cx-border-strong)"]
     [decl prop=border-radius value="var(--cx-radius-sm)"]
     [decl prop=color value="var(--cx-fg)"]
     [decl prop=display value="inline-block"]
     [decl prop=font-family value="var(--cx-font-body)"]
     [decl prop=padding value="var(--cx-space-3) var(--cx-space-5)"]
     [decl prop=text-decoration value="none"]]
   [rule sel="[data-cx-var-size='large'] .ux-link"
     [decl prop=font-size value="var(--cx-text-lead)"]
     [decl prop=padding value="var(--cx-space-4) var(--cx-space-6)"]]
   [rule sel="[data-cx-var-height='xl']" [decl prop=height value="var(--cx-space-8)"] [decl prop=margin value="0"]]

   [; -- GRID POSITION (DS-2a): a span sets the END, so a start can be set
      independently and the two never fight. ]
   [rule sel="[data-cx-col='1']"  [decl prop=grid-column-start value="1"]]
   [rule sel="[data-cx-col='2']"  [decl prop=grid-column-start value="2"]]
   [rule sel="[data-cx-col='3']"  [decl prop=grid-column-start value="3"]]
   [rule sel="[data-cx-col='4']"  [decl prop=grid-column-start value="4"]]
   [rule sel="[data-cx-col='5']"  [decl prop=grid-column-start value="5"]]
   [rule sel="[data-cx-col='6']"  [decl prop=grid-column-start value="6"]]
   [rule sel="[data-cx-col='7']"  [decl prop=grid-column-start value="7"]]
   [rule sel="[data-cx-col='8']"  [decl prop=grid-column-start value="8"]]
   [rule sel="[data-cx-col='9']"  [decl prop=grid-column-start value="9"]]
   [rule sel="[data-cx-col='10']" [decl prop=grid-column-start value="10"]]
   [rule sel="[data-cx-col='11']" [decl prop=grid-column-start value="11"]]
   [rule sel="[data-cx-col='12']" [decl prop=grid-column-start value="12"]]

   [; A SIDE RAIL IS A PAGE LAYOUT, so the shell's page-measure rules (which
      center and cap every direct child) must stand down inside it — otherwise
      the rail's grid columns fight a max-width and the chrome lands in a
      column it was never assigned. Found live: the owner put the search above
      a side nav and got a floating box over dead space. ]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side']) > *"
     [decl prop=margin-left value="0"]
     [decl prop=margin-right value="0"]
     [decl prop=max-width value="none"]]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side']) > .ux-card"
     [decl prop=grid-column value="2"]]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side']) > .ux-region"
     [decl prop=grid-column value="2"]]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side']) > .ux-status"
     [decl prop=grid-column value="2"]]
   [rule sel=".ux-region:has(> nav[data-cx-var-orientation='side']) > .ux-aside"
     [decl prop=grid-column value="2"]]

   [; -- responsive (V1). Two breakpoints, both structural: the rail collapses
      at 880 (narrowing drops BELOW the results — order, not markup), and at
      560 the store is one column with full-width controls. The px literals
      are here rather than in the theme because `var()` is not legal inside a
      media condition — a browser fact, recorded, not a discipline breach. ]
   [media query="(max-width: 880px)"
     [; the arranged grid stacks on a narrow screen — spans are a wide-screen
        arrangement, and a phone reads document order (P0-96 unchanged) —
        UNLESS the designer set a narrow-tier span for this element (DS-7),
        which is what the studio's viewport switcher writes. ]
     [rule sel=".ux-region[data-cx-arranged] > :not([data-cx-span-narrow])"
       [decl prop=grid-column value="1 / -1"]]
     [; the doubled attribute is specificity arithmetic, not a hack looking for
        a name: the stacking rule above names a class and an attribute, so a
        bare `[data-cx-span-narrow]` rule loses to it and the narrow width a
        designer set does nothing at all. Repeating the region's own attribute
        states "inside an arranged region, the arrangement decides" at a weight
        that says so. ]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='1']"  [decl prop=grid-column value="auto / span 1"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='2']"  [decl prop=grid-column value="auto / span 2"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='3']"  [decl prop=grid-column value="auto / span 3"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='4']"  [decl prop=grid-column value="auto / span 4"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='5']"  [decl prop=grid-column value="auto / span 5"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='6']"  [decl prop=grid-column value="auto / span 6"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='7']"  [decl prop=grid-column value="auto / span 7"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='8']"  [decl prop=grid-column value="auto / span 8"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='9']"  [decl prop=grid-column value="auto / span 9"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='10']" [decl prop=grid-column value="auto / span 10"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='11']" [decl prop=grid-column value="auto / span 11"]]
     [rule sel=".ux-region[data-cx-arranged][data-cx-arranged] > [data-cx-span-narrow='12']" [decl prop=grid-column value="auto / span 12"]]
     [rule sel=".ux-region:has(> .ux-panel[data-cx-panel=narrow]), .ux-region:has(> .ux-facets), .ux-region:has(> .ux-facet)"
       [decl prop=display value="flex"]
       [decl prop=flex-direction value="column"]
       [decl prop=gap value="var(--cx-space-4)"]]
     [rule sel=".ux-panel[data-cx-panel=narrow], .ux-facets, .ux-region:has(> .ux-facet) > .ux-facet"
       [decl prop=order value="9"]
       [decl prop=position value="static"]]
     [rule sel=".ux-nav ul"
       [decl prop=overflow-x value="auto"]]
     [rule sel=".ux-nav-item a"
       [decl prop=white-space value="nowrap"]]
     [rule sel=".ux-split, .ux-rail"
       [decl prop=grid-template-columns value="minmax(0, 1fr)"]]]
   [media query="(max-width: 560px)"
     [rule sel="body > .ux-region > .ux-region"
       [decl prop=padding value="0 var(--cx-space-4) var(--cx-space-6) var(--cx-space-4)"]]
     [rule sel=".ux-grid"
       [decl prop=grid-template-columns value="minmax(0, 1fr)"]]
     [rule sel=".ux-card:has(> .ux-media)"
       [decl prop=display value="block"]]
     [rule sel=".ux-card:has(> .ux-media) > .ux-media"
       [decl prop=margin-bottom value="var(--cx-space-4)"]]
     [rule sel=".ux-control-field"
       [decl prop=flex-wrap value="wrap"]]
     [rule sel=".ux-control-field > .ux-label"
       [decl prop=min-width value="auto"]]
     [rule sel=".ux-control"
       [decl prop=width value="100%"]]
     [rule sel=".ux-field"
       [decl prop=flex-wrap value="wrap"]]
     [rule sel=".ux-table"
       [decl prop=display value="block"]
       [decl prop=overflow-x value="auto"]]
     [rule sel=".ux-filter-route"
       [decl prop=flex-wrap value="wrap"]]
     [rule sel=".ux-filter-route .ux-control"
       [decl prop=flex value="1 1 10rem"]]
     [rule sel="body > .ux-region > .ux-aside"
       [decl prop=border-radius value="0"]
       [decl prop=width value="100vw"]]]]]

# rules-css — the component rule table → CSS text. Three shapes: a `[rule]` is
# a rule, a `[media query=…]` wraps rules in an @media condition (the query is
# pack-owned structure, exactly like a selector), a `[keyframes name=…]` wraps
# `[step at=…]` frames — the one CSS construct an entry animation cannot be
# said without.
[?def decls-css pure [returns string] ($r::any)
  [$join-str [?for [in $d $r/decl]
               [yield [$concat [$string $d@prop] ":" [$string $d@value] ";"]]]]]

[?def rule-css pure [returns string] ($r::any)
  [$concat [$string $r@sel] "{" [$decls-css $r] "}\n"]]

[?def rules-css pure [returns string] ()
  [?let [= $rules [$component-rules]]
    [$join-str
      [?for [in $r $rules/*]
        [yield
          [?if [= [$name $r] "media"]
            [then [$concat "@media " [$string $r@query] "{"
                    [$join-str [?for [in $i $r/rule] [yield [$rule-css $i]]]]
                    "}\n"]]
            [else [?if [= [$name $r] "keyframes"]
                    [then [$concat "@keyframes " [$string $r@name] "{"
                            [$join-str [?for [in $s $r/step]
                                         [yield [$concat [$string $s@at] "{" [$decls-css $s] "}"]]]]
                            "}\n"]]
                    [else [$rule-css $r]]]]]]]]]]

# theme-css — THE stylesheet: token block + component rules, generated. Refuses
# the whole sheet if any token value is unsafe (fail-loud, never a sheet with a
# silently dropped token).
[?def theme-css scope=public pure [returns any] ($theme::element)
  [?let [= $bad [$theme-refusals $theme]]
    [?if [$exists $bad]
      [then [err code=ux-refused $bad]]
      [else [$concat [$theme-fonts $theme] [$theme-vars $theme] [$rules-css]]]]]]

# ── §6 The content readback — the equivalence subject, from HTML ────────────
#
# `[$ux:content-of]` is the common normal form. This is the WEB side of the
# agreement: the lowered HTML tree read back to the same `[c:…]` shape, so a
# fixture can assert semantic == web == terminal on canonical bytes.
#
# It reads the tree this renderer actually serializes, not a re-parse of the
# bytes — the tree IS the rendering, and re-parsing would test the html pack's
# parser rather than this lowering.
#
# TWO recoveries are deliberate rather than cheats:
#   • a row's KEY comes out of `data-cx-frag`. P0-11 states that attribute
#     exists so a client can recover the address without a second registry;
#     recovering the key from the address is that facility used as designed.
#   • a verb comes out of `/intent/<verb>`. That URL is the command address
#     (P0-2's third subject kind), not an encoding of one.
#
# What is NOT in the normal form, and why: `kind=`. The semantic tree carries a
# CX TYPE (`int`, `money`); HTML carries a control type (`number`, `text`), and
# the mapping is many-to-one. A renderer legitimately loses it, so asserting on
# it would assert that the two renderers make the same widget choice — the
# opposite of what renderer-agnostic means.

[?def content-of-html scope=public pure [returns any] ($h::any)
  [?if [$ux:seq-child $h]
    [then [c:seq [$content-html-flat $h]]]
    [else [$content-html-el $h]]]]

# The same sequence-flattening the core does, for the same reason: a lowered
# tree's children arrive as one sequence-valued child wherever `lower-kids`
# built them, and that is not a structural difference from the semantic tree
# it came from.
[?def content-html-flat pure [returns any] ($s::any)
  [?let [= $c [c:ks [?for [in $m $s] [yield [$content-html-wrap $m]]]]]
    [?for [in $w $c//c:k] [yield [$first $w/*]]]]]

[?def content-html-wrap pure [returns any] ($k::any)
  [?if [$ux:seq-child $k]
    [then [c:ks [?for [in $m $k] [yield [$content-html-wrap $m]]]]]
    [else [c:k [$content-html-el $k]]]]]

[?def cls pure [returns string] ($h::any) [$ux:str-or $h@class ""]]

[?def content-html-el pure [returns any] ($h::any)
  [?let [= $c [$cls $h]] [= $t [$name $h]]
    [?match $c
      [; the facet wrapper is stepped through, so a browse region reads back as
         the flat sequence the semantic tree actually declared. ]
      [case "ux-region"   [c:region  [?splice [$content-html-flat [$region-kids $h]]]]]
      [case "ux-card"     [c:card    [?splice [$content-html-kids $h]]]]
      [case "ux-heading"  [c:heading [?attr "level" [$substring $t 2 1]] [?splice [$content-html-leaf $h]]]]
      [case "ux-text"     [c:text    [?splice [$content-html-leaf $h]]]]
      [case "ux-field"    [c:field   [?attr "label" [$span-text $h "ux-field-label"]]
                                     [$content-html-leaf [$first $h//*[= $_@class "ux-field-value"]]]]]
      [case "ux-list"     [c:list    [?splice [$content-html-kids $h]]]]
      [case "ux-item"     [c:item    [?splice [$content-html-leaf $h]]]]
      [case "ux-table"    [c:table   [?splice [$content-html-kids $h]]]]
      [; a header row is wrapped in a <tr> the semantic tree never had — the
         readback steps through it, because a renderer's structural wrapper is
         presentation, not content. ]
      [case "ux-columns"  [?let [= $tr [$first $h/*]] [c:columns [?splice [$content-html-flat $tr/*]]]]]
      [case "ux-column"   [c:column  [?splice [$content-html-leaf $h]]]]
      [case "ux-rows"     [c:rows    [?splice [$content-html-kids $h]]]]
      [case "ux-row"      [c:row     [?attr "key" [$key-from-frag $h]] [?splice [$content-html-kids $h]]]]
      [case "ux-cell"     [c:cell    [?splice [$content-html-leaf $h]]]]
      [case "ux-nav"      [?let [= $ul [$first $h/*]] [c:nav [?splice [$content-html-flat $ul/*]]]]]
      [case "ux-nav-item" [c:nav-item [?attr "href" [$anchor-href $h]] [$anchor-text $h]]]
      [case "ux-link"     [c:link    [?attr "href" [$ux:str-or $h@href ""]] [$string $h]]]
      [case "ux-error"    [c:error   [?splice [$content-html-kids $h]]]]
      [case "ux-notice ux-notice-ok"      [c:notice [?attr "tone" "ok"] [?splice [$content-html-kids $h]]]]
      [case "ux-notice ux-notice-warn"    [c:notice [?attr "tone" "warn"] [?splice [$content-html-kids $h]]]]
      [case "ux-notice ux-notice-info"    [c:notice [?attr "tone" "info"] [?splice [$content-html-kids $h]]]]
      [case "ux-notice ux-notice-danger"  [c:notice [?attr "tone" "danger"] [?splice [$content-html-kids $h]]]]
      [case "ux-notice ux-notice-neutral" [c:notice [?attr "tone" "neutral"] [?splice [$content-html-kids $h]]]]
      [case "ux-form ux-busy" [c:form    [?attr "verb" [$verb-of [$ux:str-or $h@action ""]]] [?splice [$content-html-kids $h]]]]
      [case "ux-control-field"          [$content-control $h]]
      [case "ux-control-field ux-filter" [$content-control $h]]
      [case "ux-control-field ux-filter ux-filter-route" [$content-filter-route $h]]
      [; W6's members join the readback here. A vocabulary member that renders
         in both faces but is invisible to the content normal form is a member
         R5's equivalence claim does not cover — the fixture would pass by not
         looking. ]
      [case "ux-group ux-busy" [c:group [?attr "name" [$group-name $h]]
                                        [?attr "label" [$span-text-el $h "legend"]]
                                        [?splice [$content-html-flat [$group-instances $h]]]]]
      [; the instance ROW is the renderer's own wrapper -- it exists to seat a
         remove control beside the instance, and neither it nor that control is
         content: both are minted from the group's declaration, exactly as the
         add control is. ]
      [; the instance row is the renderer's own wrapper — it exists to seat a
         remove control beside the instance. `[?splice]` is invalid in a case
         slot, so the wrapper reads back as its single instance directly. ]
      [case "ux-group-row" [$first-content-kid $h]]

      [; ── W10's members in the readback ─────────────────────────────────────
         Every member added this wave reads back here. W7's finding was that a
         member the fixture cannot see is a member R5's equivalence claim does
         not cover — the fixture passes by not looking — and the parity ruling
         means that finding is not allowed to repeat. ]
      [case "ux-media ux-media-illustration" [$content-media $h]]
      [case "ux-media ux-media-photo"        [$content-media $h]]
      [case "ux-media ux-media-glyph"        [$content-media $h]]
      [case "ux-status ux-status-ok"      [c:status [?attr "tone" "ok"] [?splice [$content-html-leaf [$first $h/*]]]]]
      [case "ux-status ux-status-warn"    [c:status [?attr "tone" "warn"] [?splice [$content-html-leaf [$first $h/*]]]]]
      [case "ux-status ux-status-info"    [c:status [?attr "tone" "info"] [?splice [$content-html-leaf [$first $h/*]]]]]
      [case "ux-status ux-status-danger"  [c:status [?attr "tone" "danger"] [?splice [$content-html-leaf [$first $h/*]]]]]
      [case "ux-status ux-status-neutral" [c:status [?attr "tone" "neutral"] [?splice [$content-html-leaf [$first $h/*]]]]]
      [case "ux-grid ux-grid-comfortable" [c:grid [?splice [$content-html-kids $h]]]]
      [case "ux-grid ux-grid-compact"     [c:grid [?splice [$content-html-kids $h]]]]
      [case "ux-steps"      [?let [= $ol [$first $h/*]] [c:steps [?attr "name" [$ux:str-or $h@data-cx-name ""]]
                                                                [?attr "current" [$current-step $h]]
                                                                [?splice [$content-html-flat $ol/*]]]]]
      [case "ux-step ux-step-done"    [$content-step $h "done"]]
      [case "ux-step ux-step-current" [$content-step $h "current"]]
      [case "ux-step ux-step-ahead"   [$content-step $h "ahead"]]
      [case "ux-breadcrumb" [?let [= $ol [$first $h/*]] [c:breadcrumb [?splice [$content-html-flat $ol/*]]]]]
      [case "ux-crumb"      [$content-crumb $h]]
      [case "ux-quantity"    [$content-quantity $h]]
      [case "ux-quantity ux-quantity-field" [$content-quantity-field $h]]
      [case "ux-pager"      [$content-pager $h]]
      [case "ux-page-link"  [$content-page-link $h]]
      [case "ux-facet"      [?let [= $ul [$first $h//*[= $_@class "ux-facet-values"]]]
                              [c:facet [?attr "name" [$facet-name $h]]
                                       [?attr "label" [$span-text-el $h "h3"]]
                                       [?splice [$content-html-flat $ul/*]]]]]
      [case "ux-facet-value" [$content-facet-value $h false]]
      [case "ux-facet-value ux-facet-on" [$content-facet-value $h true]]
      [case "ux-sort"       [?let [= $ul [$first $h//*[= $_@class "ux-sort-options"]]]
                              [c:sort [?attr "name" [$facet-name $h]]
                                      [?attr "label" [$span-text $h "ux-sort-label"]]
                                      [?splice [$content-html-flat $ul/*]]]]]
      [case "ux-sort-option" [$content-sort-option $h false]]
      [case "ux-sort-option ux-sort-on" [$content-sort-option $h true]]
      [case "ux-aside"      [$content-aside $h false]]
      [case "ux-aside ux-aside-open" [$content-aside $h true]]
      [; P0-101: the panel reads back from this face's own attributes — the
         name from data-cx-panel, the label from the landmark's accessible
         name — in the same attribute order the core writes. ]
      [case "ux-panel"      [c:panel [?attr "name" [$ux:str-or $h@data-cx-panel ""]]
                                     [?attr "label" [$ux:str-or $h@aria-label ""]]
                                     [?splice [$content-html-kids $h]]]]
      [case "ux-action-form" [$content-action-form $h]]
      [case "ux-action-form ux-action-unavailable" [$content-action-unavailable $h]]
      [case "ux-action ux-action-danger" [$content-action-link $h]]
      [else [$content-html-other $h $c $t]]]]]

# ── the W10 readbacks ───────────────────────────────────────────────────────

[?def content-filter-route pure [returns any] ($h::any)
  [?let [= $in [$ux:first-child $h "input"]]
    [c:filter [?attr "name" [$ux:str-or $in@name ""]]
              [?attr "label" [$span-text $h "ux-label"]]
              [?attr "route" [$ux:str-or $h@action ""]]
              [$ux:str-or $in@value ""]]]]

[?def region-kids pure [returns any] ($h::any)
  [?let
    [= $box [rk [?splice [?for [in $k $h/*]
                           [yield [?if [= [$ux:str-or $k@class ""] "ux-facets"]
                                    [then [?for [in $g $k/*] [yield $g]]]
                                    [else $k]]]]]]]
    [?for [in $x $box/*] [yield $x]]]]

[?def content-media pure [returns any] ($h::any)
  [c:media [?attr "src" [$ux:str-or $h@src ""]] [?attr "alt" [$ux:str-or $h@alt ""]]]]

[; the NAME rides data-cx-step (the class carries the state) — reading the
   class here answered "current=current", a state where a name belongs, and
   nothing caught it until the R2 checkout composite read a steps block back
   from this face for the first time. ]
[?def current-step pure [returns string] ($h::any)
  [?let [= $hits [?for [in $li $h//li] [where [= [$ux:str-or $li@aria-current ""] "step"]]
                   [yield [$ux:str-or $li@data-cx-step ""]]]]
    [?if [$ux:found $hits] [then [$first $hits]] [else ""]]]]

[?def content-step pure [returns any] ($li::any $state::string)
  [?let [= $a [$first $li/*]]
    [c:step [?attr "name" [$ux:str-or $li@data-cx-step ""]]
            [?attr "state" $state]
            [?attr "href" [$ux:str-or $a@href ""]]
            [$string $a]]]]

[?def content-crumb pure [returns any] ($h::any)
  [?let
    [= $a [$ux:first-child $h "a"]]
    [?if [$ux:found $a]
      [then [c:crumb [?attr "href" [$ux:str-or $a@href ""]] [?attr "current" "false"] [$string $a]]]
      [else [c:crumb [?attr "href" ""] [?attr "current" "true"] [$string $h]]]]]]

[; the quantity's value and bounds come back off the ARMS, not off a data
   attribute the renderer would otherwise have to invent: each arm posts the
   value it would set, so `min` is what the disabled decrement would have
   posted and `max` is what the disabled increment would have. The bounds are
   recoverable because they are load-bearing on the page, which is the same
   argument P0-11 makes for recovering a row key from `data-cx-frag`. ]
[?def content-quantity pure [returns any] ($h::any)
  [?let
    [= $arms [?for [in $f $h/*] [where [= [$ux:str-or $f@class ""] "ux-quantity-arm"]] [yield $f]]]
    [= $dec  [?if [>= [$count $arms] 1] [then [$nth $arms 1]] [else ()]]]
    [; `value` reads back from the value span — it joined the normal form in
       W15 on the core face, and the R2 checkout composite found both
       renderers' readbacks still dropping it: two faces agreeing on the
       bounds but not on the number between them. ]
    [; the value slot became a real INPUT with W23's direct entry, so the
       number reads from its value= — the text-content read answered "" the
       moment the span died, which is exactly the drop W17 caught twice. ]
    [= $vspan [$first $h//*[= $_@class "ux-quantity-value"]]]
    [c:quantity [?attr "name" [$ux:str-or $h@data-cx-name ""]]
               [?attr "label" [$ux:str-or $h@aria-label ""]]
               [?attr "verb" [$ux:str-or $h@data-cx-verb ""]]
               [?attr "value" [$ux:str-or $vspan@value [$string $vspan]]]
               [?attr "min" [$ux:str-or $h@data-cx-min "0"]]
               [?attr "max" [$ux:str-or $h@data-cx-max ""]]
               [?splice [$quantity-params $dec]]]]]

[; field mode reads back from the labeled input; verb is stated empty, which
   is what the semantic face answers for a verb-less member. ]
[?def content-quantity-field pure [returns any] ($h::any)
  [?let [= $i [$first $h//input]]
    [c:quantity [?attr "name" [$ux:str-or $h@data-cx-name ""]]
               [?attr "label" [$ux:str-or $h@aria-label ""]]
               [?attr "verb" ""]
               [?attr "value" [$ux:str-or $i@value ""]]
               [?attr "min" [$ux:str-or $h@data-cx-min "0"]]
               [?attr "max" [$ux:str-or $h@data-cx-max ""]]]]]

[; the LAST hidden field an arm carries is the quantity it would post; the ones
   before it are the action's own parameters. ]
[?def quantity-hiddens pure [returns any] ($arm::any)
  [?for [in $i $arm//input] [where [= [$ux:str-or $i@type ""] "hidden"]] [yield $i]]]

[?def quantity-name pure [returns string] ($arm::any)
  [?let [= $hs [$quantity-hiddens $arm]]
    [?if [$ux:found $hs]
      [then [?let [= $last [$nth $hs [$count $hs]]] [$ux:str-or $last@name ""]]]
      [else ""]]]]

[?def quantity-params pure [returns any] ($arm::any)
  [?let [= $hs [$quantity-hiddens $arm]]
    [?for [in $i [$range 1 [- [$count $hs] 1]]]
      [= $hi [$nth $hs $i]]
      [yield [c:param [?attr "name" [$ux:str-or $hi@name ""]]
                      [?attr "value" [$ux:str-or $hi@value ""]]]]]]]

[?def content-pager pure [returns any] ($h::any)
  [?let
    [= $ol   [$first $h//*[= $_@class "ux-pager-pages"]]]
    [= $prev [$first $h//*[= $_@class "ux-pager-prev"]]]
    [= $next [$first $h//*[= $_@class "ux-pager-next"]]]
    [= $cnt  [$span-text $h "ux-pager-count"]]
    [c:pager [?attr "page" [$pager-field $cnt 2]]
             [?attr "pages" [$pager-field $cnt 4]]
             [?attr "total" [$pager-total $cnt]]
             [?attr "prev-href" [$ux:str-or $prev@href ""]]
             [?attr "next-href" [$ux:str-or $next@href ""]]
             [?splice [$content-html-flat $ol/*]]]]]

[; "Page 3 of 42 \u2014 1004 items" — the count sentence is the pager's only
   textual output and it is where the numbers come back from. Whitespace
   splitting rather than a regex, because the sentence is emitted by this
   module and its shape is fixed here. ]
[?def pager-field pure [returns string] ($s::string $i::int)
  [?let [= $ws [$strings:split-whitespace $s]]
    [?if [>= [$count $ws] $i] [then [$nth $ws $i]] [else ""]]]]

[?def pager-total pure [returns string] ($s::string)
  [?let [= $ws [$strings:split-whitespace $s]]
    [?if [>= [$count $ws] 7] [then [$nth $ws 6]] [else ""]]]]

[?def content-page-link pure [returns any] ($h::any)
  [?let [= $a [$first $h/*]]
    [c:page-link [?attr "n" [$string $a]]
                 [?attr "href" [$ux:str-or $a@href ""]]
                 [?attr "current" [?if [= [$ux:str-or $a@aria-current ""] "page"] [then "true"] [else "false"]]]]]]

[?def content-facet-value pure [returns any] ($h::any $sel::bool)
  [?let [= $a [$first $h/*]]
    [c:facet-value [?attr "value" [$ux:str-or $a@data-cx-value ""]]
                   [?attr "count" [$span-text $a "ux-facet-count"]]
                   [?attr "href" [$ux:str-or $a@href ""]]
                   [?attr "selected" [?if $sel [then "true"] [else "false"]]]
                   [$span-text $a "ux-facet-name"]]]]

[?def content-sort-option pure [returns any] ($h::any $sel::bool)
  [?let [= $a [$first $h/*]]
    [c:sort-option [?attr "value" [$ux:str-or $a@data-cx-value ""]]
                   [?attr "href" [$ux:str-or $a@href ""]]
                   [?attr "selected" [?if $sel [then "true"] [else "false"]]]
                   [$string $a]]]]

[?def content-aside pure [returns any] ($h::any $open::bool)
  [?let
    [= $head [$first $h//*[= $_@class "ux-aside-head"]]]
    [= $body [$first $h//*[= $_@class "ux-aside-body"]]]
    [= $dis  [$first $h//*[= $_@class "ux-aside-dismiss"]]]
    [c:aside [?attr "label" [$ux:str-or $h@aria-label ""]]
             [?attr "open" [?if $open [then "true"] [else "false"]]]
             [?attr "dismiss-href" [$ux:str-or $dis@href ""]]
             [?splice [$content-html-flat $body/*]]]]]

[?def content-action-form pure [returns any] ($h::any)
  [?let
    [= $b  [$first $h//button]]
    [= $hs [?for [in $i $h//input] [where [= [$ux:str-or $i@type ""] "hidden"]] [yield $i]]]
    [c:action [?attr "verb" [$verb-of [$ux:str-or $h@action ""]]]
              [?attr "label" [$string $b]]
              [?splice [?for [in $i $hs]
                         [yield [c:param [?attr "name" [$ux:str-or $i@name ""]]
                                         [?attr "value" [$ux:str-or $i@value ""]]]]]]
              [; a field-mode quantity child (W23 letter (i)) is content the
                 other faces state — dropping it here would be the two-stores-
                 telling-different-truths failure P0-99 closed for reasons. ]
              [?splice [?for [in $q $h/*]
                         [where [= [$ux:str-or $q@class ""] "ux-quantity ux-quantity-field"]]
                         [yield [$content-quantity-field $q]]]]]]]

[; P0-99's readback: the verb rides data-cx-verb (a disabled control has no
   action= to derive it from), the reason is the associated span's text, and
   the params read back from the hidden inputs exactly as an available
   action's do — an unavailable act is the same act, stated inert. ]
[?def content-action-unavailable pure [returns any] ($h::any)
  [?let
    [= $b  [$first $h//button]]
    [= $rs [$first $h//*[= $_@class "ux-action-reason"]]]
    [= $hs [?for [in $i $h//input] [where [= [$ux:str-or $i@type ""] "hidden"]] [yield $i]]]
    [c:action [?attr "verb" [$ux:str-or $h@data-cx-verb ""]]
              [?attr "label" [$string $b]]
              [?attr "available" "false"]
              [?attr "reason" [$string $rs]]
              [?splice [?for [in $i $hs]
                         [yield [c:param [?attr "name" [$ux:str-or $i@name ""]]
                                         [?attr "value" [$ux:str-or $i@value ""]]]]]]]]]

[; a confirming action lowers to a LINK, not a form, so it reads back from the
   anchor. `confirm="true"` is presence-boolean and there is NO verb: the act's
   verb lives at the confirmation view (P0-67), so it is not this rendering's
   content — and W15 made the core normal form say the same thing. ]
[?def content-action-link pure [returns any] ($h::any)
  [c:action [?attr "label" [$string $h]] [?attr "confirm" "true"]]]

[?def facet-name pure [returns string] ($h::any) [$ux:str-or $h@data-cx-name ""]]

# The badge classes carry the tone, and `ux-action` is two members apart by
# `type=` — both need a second look rather than a class match.
[?def content-html-other pure [returns any] ($h::any $c::string $t::string)
  [?if [$starts-with $c "ux-badge "]
    [; "ux-badge ux-badge-" is 18 characters; the tone is everything after it. ]
    [then [c:badge [?attr "tone" [$substring $c 19 [- [$string-length $c] 18]]] [$content-html-leaf $h]]]
    [else
      [?if [or [= $c "ux-action"] [= $c "ux-action ux-submit"]]
        [then
          [?if [= [$ux:str-or $h@type ""] "submit"]
            [then [c:submit [$string $h]]]
            [else [c:action [?attr "verb" [$verb-of [$ux:str-or $h@hx-post ""]]]
                            [?attr "label" [$string $h]]]]]]
        [else
          [?if [and [= $t "input"] [= [$ux:str-or $h@type ""] "hidden"]]
            [then [c:hidden [?attr "name" [$ux:str-or $h@name ""]] [$ux:str-or $h@value ""]]]
            [else [c:unknown]]]]]]]]

# content-control — a labelled control: a form input, or a filter. The two are
# told apart by the input's own `type=search`, which is what the filter's
# lowering emits, rather than by looking for htmx attributes.
[?def content-control pure [returns any] ($h::any)
  [?let
    [= $in  [$ux:first-child $h "input"]]
    [= $sel [$ux:first-child $h "select"]]
    [= $lbl [$span-text $h "ux-label"]]
    [= $err [$span-text $h "ux-field-error"]]
    [; `absent` is `[$count] = 0` and `[$count]` counts ELEMENT CHILDREN
       (#849) — an `<input>` has none, so an input read as "no input here" and
       fell through to the select branch. `exists` asks the question that was
       meant: did the step match anything. ]
    [?if [$ux:found $in]
      [then
        [?if [= [$ux:str-or $in@type ""] "search"]
          [then [c:filter [?attr "name" [$ux:str-or $in@name ""]]
                          [?attr "label" $lbl]
                          [?attr "route" ""]
                          [$ux:str-or $in@value ""]]]
          [else [c:input [?attr "name" [$ux:str-or $in@name ""]]
                         [?attr "label" $lbl]
                         [?attr "required" [?if [$exists $in@required] [then "true"] [else "false"]]]
                         [?attr "error" $err]
                         [$ux:str-or $in@value ""]]]]]
      [else [c:select [?attr "name" [$ux:str-or $sel@name ""]]
                      [?attr "label" $lbl]
                      [?attr "required" [?if [$exists $sel@required] [then "true"] [else "false"]]]
                      [?attr "error" $err]
                      [?attr "value" [$selected-value $sel]]
                      [?splice [$options-of $sel]]]]]]]

# The option step is written `/option` rather than `/*` so a renderer that
# later seats anything else inside a select does not silently turn it into a
# choice.
[?def options-of pure [returns any] ($sel::any)
  [?for [in $o [$ux:child-elements $sel "option"]]
    [yield [c:option [?attr "value" [$ux:str-or $o@value ""]] [$string $o]]]]]

[?def selected-value pure [returns string] ($sel::any)
  [?let [= $on [?for [in $o [$ux:child-elements $sel "option"]]
                 [where [$exists $o@selected]] [yield [$ux:str-or $o@value ""]]]]
    [?if [$exists $on] [then [$first $on]] [else ""]]]]

[?def first-content-kid pure [returns any] ($h::any)
  [?let [= $ks [$content-html-kids $h]]
    [?if [$exists $ks] [then [$first $ks]] [else [c:unknown]]]]]

[?def group-name pure [returns string] ($h::any)
  [?let [= $c [$ux:first-child $h "div"]]
    [?let [= $ins [$ux:child-elements $c "div"]]
      [?if [$ux:found $ins] [then [$name-before-dot [$first-control-name [$first $ins]]]] [else ""]]]]]

[?def first-control-name pure [returns string] ($row::any)
  [?let [= $ns [?for [in $n $row//*] [where [$exists $n@name]] [yield [$string $n@name]]]]
    [?if [$ux:found $ns] [then [$first $ns]] [else ""]]]]

[?def name-before-dot pure [returns string] ($n::string)
  [$first [$strings:split $n "."]]]

[?def group-instances pure [returns any] ($h::any)
  [?let [= $c [$ux:first-child $h "div"]]
    [?if [$ux:found $c] [then $c/*] [else ()]]]]

[?def span-text-el pure [returns string] ($h::any $tag::string)
  [?let [= $e [$ux:first-child $h $tag]]
    [?if [$ux:found $e] [then [$string $e]] [else ""]]]]

[?def content-html-kids pure [returns any] ($h::any)
  [$content-html-flat $h/*]]

[?def content-html-leaf pure [returns any] ($h::any)
  [?if [$exists $h/*]
    [then [$content-html-kids $h]]
    [else [$string $h]]]]

[?def span-text pure [returns string] ($h::any $c::string)
  [?let [= $s [?for [in $k $h//*] [where [= [$ux:str-or $k@class ""] $c]] [yield $k]]]
    [?if [$exists $s] [then [$string [$first $s]]] [else ""]]]]

[?def anchor-href pure [returns string] ($h::any)
  [?let [= $a [$ux:first-child $h "a"]] [$ux:str-or $a@href ""]]]

[?def anchor-text pure [returns string] ($h::any)
  [?let [= $a [$ux:first-child $h "a"]] [$string $a]]]

# verb-of — `/intent/place-order` → `place-order`.
[?def verb-of pure [returns string] ($url::string)
  [?if [$starts-with $url "/intent/"]
    [then [$substring $url 9 [- [$string-length $url] 8]]]
    [else ""]]]

# key-from-frag — a row's declared key, recovered from the readable address in
# `data-cx-frag`. The LAST `row[…]` step is this row's own: a nested row's path
# carries its container's key first.
[?def key-from-frag pure [returns string] ($h::any)
  [?let
    [= $ms [$re:find-all [$re:compile "row\\[([^\\]]*)\\]"] [$ux:str-or $h@data-cx-frag ""]]]
    [?if [$exists $ms]
      [then [$re:group [$nth $ms [$count $ms]] 1]]
      [else ""]]]]

# content-repr-html — the canonical bytes the web rendering contributes to the
# equivalence assertion.
[?def content-repr-html scope=public pure [returns string] ($el::any $ctx::map)
  [$cx:canonical [$content-of-html [$lower $el $ctx]]]]

# ── §7 The surface document's routing (P0-25) ───────────────────────────────
#
# The correspondence check lives in `cx-x/ux` (it is about a document and a
# resource table, not about HTML). What lives here is the page shell.

# ── §8 The page shell and strict CSP (P0-33) ────────────────────────────────

# csp-header — the strict Content-Security-Policy value. Script hashes come
# from the ASSET MANIFEST (§9): the vendored kernel and island assets are
# served as static files and hash-pinned in `script-src`, which is sound only
# because each `<script>` also carries the matching `integrity=` (CSP3 matches
# a hash-source against an external script's SRI digest). `hx-on`'s permanent
# exclusion (P0-31) is what lets `script-src` omit 'unsafe-inline' at all.
[?def csp-header scope=public pure [returns string] ($assets::any)
  [$concat
    "default-src 'none'; script-src 'self'"
    [$join-str [?for [in $a $assets] [yield [$concat " '" [$string $a@sri] "'"]]]]
    "; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; "
    "form-action 'self'; base-uri 'none'; frame-ancestors 'none'"]]

# page — the full document for one route: the token stylesheet, the pinned
# kernel, and the lowered body. Returns the HTML element tree; `page-html`
# serializes it.
[?def page pure [returns any] ($title::string $assets::any $body::any $edit::any)
  [?element "html" lang="en"
    [?element "head"
      [?element "meta" charset="utf-8"]
      [?element "meta" name="viewport" content="width=device-width, initial-scale=1"]
      [; The emitter never emits an inline `style=` (P0-33) — but the KERNEL
         will, unless told not to: htmx injects a <style> block for its
         indicator classes at load, which `style-src 'self'` correctly blocks.
         Widening the policy to admit it would surrender the invariant to the
         vendored dependency, so the kernel is configured out of it instead.
         A meta element carries the config, since an inline script is exactly
         what the policy forbids. The indicator styling that htmx would have
         injected lives in the token stylesheet, where every other visual
         decision lives.
         This element is part of the KERNEL contract, not the emitter's: a
         substitute kernel (R4) replaces it along with the scripts. ]
      [?element "meta" name="htmx-config" content="{\"includeIndicatorStyles\":false}"]
      [?element "title" $title]
      [?element "link" rel="stylesheet" href="/static/ux.css"]
      [; a .css asset is a stylesheet link, everything else a pinned script —
         the studio's studio.css rides the same SRI-pinned manifest as its
         studio.js (P0-110), and a page with only script assets is
         byte-identical to before this branch existed. ]
      [?for [in $a $assets]
        [yield [?if [$strings:ends-with [$string $a@name] ".css"]
                 [then [?element "link"
                         [?attr "rel" "stylesheet"]
                         [?attr "href" [$string $a@href]]
                         [?attr "integrity" [$string $a@sri]]
                         [?attr "crossorigin" "anonymous"]]]
                 [else [?element "script"
                         [?attr "src" [$string $a@href]]
                         [?attr "integrity" [$string $a@sri]]
                         [?attr "crossorigin" "anonymous"]
                         [?attr "defer" "defer"]]]]]]]
    [; the body states edit mode as emitter-authored data (P0-109): the studio
       asset reads its boot facts here — never from a second wire, never from
       an inline script. ]
    [?element "body"
      [?attr [?if [$ux:found $edit] [then "data-cx-edit"] [else ()]] "1"]
      [?attr [?if [$ux:found $edit] [then "data-cx-edit-components"] [else ()]]
             [$ux:str-or $edit@components ""]]
      [?attr [?if [$ux:found $edit] [then "data-cx-edit-containers"] [else ()]]
             [$ux:str-or $edit@containers ""]]
      [?attr [?if [$ux:found $edit] [then "data-cx-edit-return"] [else ()]]
             [$ux:str-or $edit@return ""]]
      [; the editing TIER (adopter | client), the TENANT whose deployment is
         being edited, and — for a client — the ceiling the adopter declared,
         so the studio offers only what the PEP will accept (§6.2's
         hide-vs-refuse reaching the palette). ]
      [?attr [?if [$ux:found $edit] [then "data-cx-edit-tier"] [else ()]]
             [$ux:str-or $edit@tier "adopter"]]
      [?attr [?if [$ux:found $edit] [then "data-cx-edit-tenant"] [else ()]]
             [$ux:str-or $edit@tenant "default"]]
      [?attr [?if [and [$ux:found $edit] [not [= [$ux:str-or $edit@allow-place ""] ""]]]
               [then "data-cx-edit-allow-place"] [else ()]]
             [$ux:str-or $edit@allow-place ""]]
      [?attr [?if [and [$ux:found $edit] [not [= [$ux:str-or $edit@allow-move ""] ""]]]
               [then "data-cx-edit-allow-move"] [else ()]]
             [$ux:str-or $edit@allow-move ""]]
      [?attr [?if [and [$ux:found $edit] [not [= [$ux:str-or $edit@allow-remove ""] ""]]]
               [then "data-cx-edit-allow-remove"] [else ()]]
             [$ux:str-or $edit@allow-remove ""]]
      $body]]]

# page-html — the served bytes for one route: `<!doctype html>` + the
# serialized document. The doctype prefix is the ONE string concatenation in
# this module and carries no caller data; everything below it composed as a
# tree and was escaped by the serializer.
[?def page-html scope=public pure [returns any] ($title::string $assets::any $el::any $ctx::map)
  [?let
    [; ONE address walk feeds both address gates (W24, ruling 3a). ]
    [= $pairs [$ux:address-pairs $el $ctx]]
    [= $bad [$ux:joined [$ux:refusals-of $el]
              [$ux:joined [$ux:err-refusals $el]
                [$ux:joined [$ux:binding-refusals $el [$rctx-of $ctx]]
                  [$ux:joined [$unbound-filter-refusals $el [$rctx-of $ctx]]
                              [$ux:dangling-affects-with $el $ctx $pairs]]]]]]
    [?if [$exists $bad]
      [then [err code=ux-refused $bad]]
      [else
        [?let
          [= $dupe [$ux:collisions-with $pairs]]
          [?if [$exists $dupe]
            [then [err code=ux-refused $dupe]]
            [else
              [?let
                [; the LOWERED tree is gated exactly as `render` gates it
                   (W24 finding, the §5.4 class caught LIVE): a lowering that
                   minted an [err] node shipped here as page CONTENT at 200 —
                   serialized markup saying `<err code=…>` — because this
                   pipeline scanned only the semantic tree. An err in the
                   lowered tree refuses the page, in both pipelines, always. ]
                [= $low  [$page $title $assets [$lower $el $ctx] [$edit-of $ctx]]]
                [= $lerr [$ux:err-refusals $low]]
                [= $out  [?if [$exists $lerr] [then ""]
                           [else [$concat "<!doctype html>\n" [$html:serialize $low]]]]]
                [= $post [$ux:joined $lerr
                           [$ux:joined [$off-subset-attrs $out] [$csp-violations $out]]]]
                [?if [$exists $post]
                  [then [err code=ux-refused $post]]
                  [else $out]]]]]]]]]]

# ── §9 The vendored kernel's asset manifest (P0-30, P0-33) ──────────────────
#
# htmx and idiomorph are vendored and PINNED TOGETHER (idiomorph is the morph
# engine §5.4 requires). Their bytes are served as static files; their SRI
# digests are computed FROM THOSE BYTES at manifest time, so `script-src` and
# `integrity=` can never drift from what is actually served, and a swapped
# asset fails closed in the browser rather than silently executing.
#
# Impure: it reads the vendored files. `csp-header` and `page` stay pure over
# the manifest it returns.

# asset-manifest — the vendored kernel's records, or ONE [err …] naming every
# asset that is missing or unreadable. A missing kernel is a refusal, never a
# page served without its morph engine.
[?def asset-manifest scope=public impure [returns any] ($dir::string $names::any)
  [?let
    [= $recs [?for [in $n $names] [yield [$asset-record $dir [$string $n]]]]]
    [= $bad  [?for [in $r $recs] [where [= [$name $r] "ux-refusal"]] [yield $r]]]
    [?if [$exists $bad]
      [then [err code=ux-refused $bad]]
      [else $recs]]]]

# The refusal carries the READ's OWN error code rather than asserting "missing":
# an absent file and a denied read capability are different facts, and a
# manifest that reported both as "missing" would send an operator looking in
# the wrong place.
[?def asset-record impure [returns any] ($dir::string $n::string)
  [?let [= $b [$io:read-file-bytes [$concat $dir "/" $n]]]
    [?match $b
      [case [err @code=$c] [ux-refusal code=ux-asset-unreadable asset=$n cause=$c]]
      [else [ux:asset name=$n
              href=[$concat "/static/" $n]
              sri=[$hash:sri-format [$hash:sha384 $b] "sha384"]]]]]]

# ── docs ────────────────────────────────────────────────────────────────────
[module-doc name=ux-web
  [scope """The WEB RENDERER of the UX projection (EXPERIMENTAL x/ tier;
   #787): one of two peers over `cx-x/ux`'s semantic vocabulary, not the
   privileged one. It lowers a semantic tree to HTML/htmx, is the SOLE author
   of htmx attributes — restricted to a pinned, fixture-enforced subset with
   `hx-on` excluded permanently, which is what keeps the kernel replaceable
   and strict CSP possible — and derives every one of them from a semantic
   declaration plus the render context, so no htmx spelling appears in a
   semantic tree. Escaping is structural: fragments compose as CXDM trees and
   serialize once through the html pack, so there is no interpolation surface.
   It also owns the token theme's compilation to a generated stylesheet, the
   page shell and its strict CSP, the vendored kernel's SRI manifest, the
   out-of-band lowering of the core's semantic patch operations, and the
   readback from its own output to the common content normal form on which the
   two renderings are asserted to agree."""]]

[fn-doc name=htmx-subset scope=public purity=pure
  [sig """() -> [sequence string]"""]
  [summary """The pinned, normative htmx attribute set the emitter may author; additions are individual rulings and hx-on is excluded permanently."""]]
[fn-doc name=htmx-allowed scope=public purity=pure
  [sig """($attr::string) -> bool"""]
  [summary """Is one attribute name on the pinned htmx subset?"""]
  [param-doc name=attr """The attribute name, e.g. hx-post."""]]
[fn-doc name=lower scope=public purity=pure
  [sig """($el::any $c0::map) -> any"""]
  [summary """Lower a semantic tree to its HTML element tree — the rendering, before serialization."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=c0 """The root fragment context map {route, feature, path, bind}; descent derives child contexts from it."""]]
[fn-doc name=render scope=public purity=pure
  [sig """($el::any $ctx::map) -> string | [err …]"""]
  [summary """Project one semantic tree to HTML text, or refuse with one [err …] naming every violation — never a partial render. Runs the SHARED semantic gate first, so a tree this renderer accepts and the terminal renderer rejects cannot exist."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=ctx """The fragment context map {route, feature, path, bind}."""]]
[fn-doc name=render-fragment scope=public purity=pure
  [sig """($el::any $f::element $rctx::any) -> string | [err …]"""]
  [summary """Project one semantic tree addressed by an explicit fragment address — the swap-target form the intent round trip returns."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=f """The [frag …] address the tree renders at."""]
  [param-doc name=rctx """The [ux:render-ctx …] document."""]]
[fn-doc name=lower-ops scope=public purity=pure
  [sig """($ops::any $ctx::map) -> any"""]
  [summary """Lower the core's semantic patch operations to out-of-band HTML — the ONLY place hx-swap-oob is authored, with every container id derived from the op's element path by the same frag-id that minted it."""]
  [param-doc name=ops """The [ux:op …] operations from feed-ops."""]
  [param-doc name=ctx """The fragment context map."""]]
[fn-doc name=render-rows scope=public purity=pure
  [sig """($rows-el::any $ctx::map) -> string | [err …]"""]
  [summary """A row container's contents as bytes — what an innerHTML swap at the collection expects, and the one parse context in which a <tr> payload survives."""]
  [param-doc name=rows-el """The [ux:rows …] element."""]
  [param-doc name=ctx """The fragment context of the table."""]]
[fn-doc name=render-ops scope=public purity=pure
  [sig """($ops::any $ctx::map) -> string | [err …]"""]
  [summary """The serialized out-of-band payload one ∂ script becomes — through the same subset and CSP scans as a page, so a live update cannot skip the invariants."""]
  [param-doc name=ops """The [ux:op …] operations from feed-ops."""]
  [param-doc name=ctx """The fragment context map."""]]
[fn-doc name=unbound-filter-refusals scope=public purity=pure
  [sig """($el::any $rctx::any) -> [sequence element]"""]
  [summary """Refuse a filter whose affected collection has no fragment endpoint bound — a control that renders and does nothing passes every server-side gate."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=rctx """The [ux:render-ctx …] document."""]]
[fn-doc name=input-kind-of scope=public purity=pure
  [sig """($kind::string) -> string"""]
  [summary """Map a declared CX kind to its HTML control type; decimal and bigint stay text because they ride string carriers and a number input would corrupt them. Renderer-private — the terminal renderer maps the same kinds to its own editors."""]
  [param-doc name=kind """The CX kind name as spelled in the param annotation."""]]
[fn-doc name=off-subset-attrs scope=public purity=pure
  [sig """($html::string) -> [sequence element]"""]
  [summary """Scan serialized emitter output and refuse every hx-*/sse-* attribute that is not on the pinned subset."""]
  [param-doc name=html """The serialized HTML text to scan."""]]
[fn-doc name=csp-violations scope=public purity=pure
  [sig """($html::string) -> [sequence element]"""]
  [summary """Scan serialized emitter output for the strict-CSP invariants: no inline style=, no inline script, no event-handler attribute."""]
  [param-doc name=html """The serialized HTML text to scan."""]]
[fn-doc name=content-of-html scope=public purity=pure
  [sig """($h::any) -> element"""]
  [summary """Read the lowered HTML tree back to the common content normal form — the WEB side of the equivalence assertion, taken from the tree this renderer actually serializes."""]
  [param-doc name=h """The lowered HTML element tree."""]]
[fn-doc name=content-repr-html scope=public purity=pure
  [sig """($el::any $ctx::map) -> string"""]
  [summary """The canonical bytes the web rendering contributes to the equivalence assertion."""]
  [param-doc name=el """The semantic element tree."""]
  [param-doc name=ctx """The fragment context map."""]]
[fn-doc name=token-value-safe scope=public purity=pure
  [sig """($v::string) -> bool"""]
  [summary """Is a theme token value safe to place in a generated stylesheet — the CSS analogue of the emitter's escaping invariant?"""]
  [param-doc name=v """The token value from a theme document."""]]
[fn-doc name=theme-refusals scope=public purity=pure
  [sig """($theme::element) -> [sequence element]"""]
  [summary """Every unsafe token value in one theme document."""]
  [param-doc name=theme """A [ux:theme …] token document."""]]
[fn-doc name=theme-css scope=public purity=pure
  [sig """($theme::element) -> string | [err …]"""]
  [summary """Compile a token theme document to the generated stylesheet — custom properties plus the component rule table; an unsafe token refuses the whole sheet."""]
  [param-doc name=theme """A [ux:theme …] token document."""]]
[fn-doc name=component-rules scope=public purity=pure
  [sig """() -> [sequence element]"""]
  [summary """The pack-owned .ux-* rule table as structured data; every declaration references a theme token, so no color, size, or font is hard-coded."""]]
[fn-doc name=join-str scope=public purity=pure
  [sig """($parts::any) -> string"""]
  [summary """Concatenate a sequence of strings as a pure, total fold."""]
  [param-doc name=parts """The string sequence."""]]
[fn-doc name=csp-header scope=public purity=pure
  [sig """($assets::any) -> string"""]
  [summary """The strict Content-Security-Policy value, pinning each vendored script by the SRI digest of the bytes actually served."""]
  [param-doc name=assets """The asset manifest records from asset-manifest."""]]
[fn-doc name=page-html scope=public purity=pure
  [sig """($title::string $assets::any $el::any $ctx::map) -> string | [err …]"""]
  [summary """The served bytes for one route: doctype, token stylesheet, hash-pinned kernel, and the lowered body — refused whole on any violation."""]
  [param-doc name=title """The document title."""]
  [param-doc name=assets """The asset manifest records from asset-manifest."""]
  [param-doc name=el """The semantic element tree for the route's body."""]
  [param-doc name=ctx """The fragment context map."""]]
[fn-doc name=asset-manifest scope=public purity=impure
  [sig """($dir::string $names::any) -> [sequence element] | [err …]"""]
  [summary """Read the vendored kernel's bytes and derive each asset's SRI digest, so script-src and integrity= can never drift from what is served; a missing asset refuses."""]
  [param-doc name=dir """The directory holding the vendored, pinned kernel assets."""]
  [param-doc name=names """The asset file names to pin, htmx and idiomorph together."""]]
[fn-doc name=font-value-safe scope=public purity=pure
  [sig """($v::string) -> bool"""]
  [summary """The token-value-safe allowlist widened by exactly one character: '+' — a unicode-range is written U+0000-00FF and there is no other way to spell it; admitted here and nowhere else."""]]
[fn-doc name=theme-vars scope=public purity=pure
  [sig """($theme::element) -> string"""]
  [summary """The theme's tokens as CSS custom properties: shared tokens and the default palette on :root, each non-default palette re-stated under its prefers-color-scheme condition (P0-104)."""]]
