'007'
#]]
 ]

# Coercion failure in strict mode → CXER1504.
 [case id=csv-024-parse-with-schema-coercion-failed level=core
  [tags csv parse-with-schema coercion-failed strict CXER1504]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:parse-with-schema "score\nn/a" {score: :int}]
#]]
  [out-err [#
cx-err:CXER1504
#]]
 ]

# ── §3.2 emit ──

 [case id=csv-025-emit-map-rows level=core
  [tags csv emit map header rfc4180]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit ({a: "1", b: "2"})]
#]]
  [out-text [#
'a,b\n1,2\n'
#]]
 ]

 [case id=csv-026-emit-quotes-delimiter-cell level=core
  [tags csv emit quoting delimiter rfc4180]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit ({name: "Alice", note: "a,b"})]
#]]
  [out-text [#
'name,note\nAlice,"a,b"\n'
#]]
 ]

 [case id=csv-027-emit-escapes-embedded-quote level=core
  [tags csv emit quoting doubled-quote rfc4180]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit ({msg: "He said \"hi\""})]
#]]
  [out-text [#
'msg\n"He said ""hi"""\n'
#]]
 ]

 [case id=csv-028-emit-union-of-keys level=core
  [tags csv emit union-of-keys heterogeneous]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit ({a: "1", b: "2"}, {a: "3", c: "4"})]
#]]
  [out-text [#
'a,b,c\n1,2,\n3,,4\n'
#]]
 ]

 [case id=csv-029-emit-headerless-array-rows level=core
  [tags csv emit array positional]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit ([1, 2, 3], [4, 5, 6])]
#]]
  [out-text [#
'1,2,3\n4,5,6\n'
#]]
 ]

 [case id=csv-030-emit-ragged-array-pads level=core
  [tags csv emit array ragged pad]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit ([1, 2, 3], [4, 5])]
#]]
  [out-text [#
'1,2,3\n4,5,\n'
#]]
 ]

# ── §3.2 emit-with-dialect ──

 [case id=csv-031-emit-with-dialect-tsv level=core
  [tags csv emit-with-dialect tsv builtin]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit-with-dialect ({a: "1", b: "2"}) [dialect [name "tsv"]]]
#]]
  [out-text [#
'a\tb\n1\t2\n'
#]]
 ]

 [case id=csv-032-emit-with-dialect-crlf level=core
  [tags csv emit-with-dialect line-terminator crlf]
  [# The CRLF terminators (\r\n) cannot be embedded literally in an out-text
     payload, so assert the full expected content via strings:contains — the
     in_code CX string literal CAN carry the \r\n escapes (code.md §6.5 escape
     set). Confirms header + row are emitted with CRLF terminators. #]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/strings']
[?lib 'cx-stdlib/csv']
[$strings:contains [$csv:emit-with-dialect ({a: "1", b: "2"}) [dialect [line-terminator "crlf"]]] "a,b\r\n1,2\r\n"]
#]]
  [out-text [#
true
#]]
 ]

 [case id=csv-033-emit-with-dialect-backslash-escape level=core
  [tags csv emit-with-dialect escape backslash]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit-with-dialect ({msg: "He said \"hi\""}) [dialect [escape "backslash"]]]
#]]
  [out-text [#
'msg\n"He said \\"hi\\""\n'
#]]
 ]

 [case id=csv-034-emit-with-dialect-pinned-columns level=core
  [tags csv emit-with-dialect columns pinned drop]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit-with-dialect ({a: "1", b: "2", c: "3"}) [dialect [columns [sequence "b" "a"]]]]
#]]
  [out-text [#
'b,a\n2,1\n'
#]]
 ]

# Invalid dialect on emit → CXER1502. Per §2.2 Validity, dialect validation
# runs identically on the emit path: the empty-string delimiter is rejected
# with CXER1502 before any emission work begins (mirrors csv-016 on parse).
 [case id=csv-035-emit-with-dialect-invalid level=core
  [tags csv emit-with-dialect dialect-invalid CXER1502]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$csv:emit-with-dialect ({a: "1"}) [dialect [delimiter ""]]]
#]]
  [out-err [#
cx-err:CXER1502
#]]
 ]

# ── §3.3 dialects-builtin ──

 [case id=csv-036-dialects-builtin-count level=core
  [tags csv dialects-builtin map count]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[$count [$keys [$csv:dialects-builtin]]]
#]]
  [out-text [#
7
#]]
 ]

 [case id=csv-037-dialects-builtin-tsv-delimiter level=core
  [tags csv dialects-builtin tsv access]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[?let [= $dialects [$csv:dialects-builtin]]
      [= $tsv $dialects/tsv]
  $tsv/delimiter]
#]]
  [out-text [#
'\t'
#]]
 ]

 [case id=csv-038-dialects-builtin-headless-header-false level=core
  [tags csv dialects-builtin headless header]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/csv']
[?let [= $dialects [$csv:dialects-builtin]]
      [= $headless $dialects/headless]
  $headless/header]
#]]
  [out-text [#
false
#]]
 ]
]
