[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[$prof:time-fn "work" [?fn () 42] opts={clock: "cpu"}]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

