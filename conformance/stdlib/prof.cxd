  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[?let [= $_ [$prof:counter-add "prof-009-bytes" 5]]
  [$prof:counter-get "prof-009-bytes"]]
#]]
  [out-text [#
5
#]]
 ]

