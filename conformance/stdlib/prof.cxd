  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[?let [= $a [$prof:histogram-observe "prof-017-lat" 5.0e0]] [= $b [$prof:histogram-observe "prof-017-lat" 6.0e0]] [= $c [$prof:histogram-reset "prof-017-lat"]] [= $s [$prof:histogram-stats "prof-017-lat"]]
  $s@count]
#]]
  [out-text [#
0
#]]
 ]

# non-finite unconstructible from pure CX (finite-only, code.md §6.5);
# CXER2103/CXER3104 are FFI-boundary guards — real coverage is a
# binding-level NaN-injection test (TODO). [/ 1.0 0.0] raises CXER0101
# (division by zero), never yields +Inf, so this case cannot exercise
# CXER2103 from pure CX.
 [case id=prof-018-histogram-observe-non-finite level=core gate=skip
  [tags prof histogram-observe non-finite CXER2103]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[$prof:histogram-observe "prof-018-lat" [/ 1.0e0 0.0e0]]
#]]
  [out-err [#
cx-err:CXER2103
#]]
 ]

 [case id=prof-019-mem-snapshot-rss-positive level=core
  [tags prof mem-snapshot rss-bytes required]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[?let [= $s [$prof:mem-snapshot]]
  [> $s@rss-bytes 0]]
#]]
  [out-text [#
true
#]]
 ]

