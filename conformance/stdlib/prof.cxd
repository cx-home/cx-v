[?lib 'cx-stdlib/prof']
[?let [= $a [$prof:histogram-observe "prof-014-lat" 1.0e0]] [= $b [$prof:histogram-observe "prof-014-lat" 2.0e0]] [= $c [$prof:histogram-observe "prof-014-lat" 3.0e0]] [= $s [$prof:histogram-stats "prof-014-lat"]]
  $s@count]
#]]
  [out-text [#
3
#]]
 ]

