#]]
  [out-text [#
null
#]]
 ]

 [case id=prof-008-counter-inc-then-get level=core
  [tags prof counter-inc counter-get]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[?let [= $_ [$prof:counter-inc "prof-008-hits"]]
  [$prof:counter-get "prof-008-hits"]]
#]]
  [out-text [#
1
#]]
 ]

