  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/prof']
[?let [= $_ [$prof:counter-add "prof-011-x" 9]] [= $__ [$prof:counter-reset "prof-011-x"]]
  [$prof:counter-get "prof-011-x"]]
#]]
  [out-text [#
0
#]]
 ]

