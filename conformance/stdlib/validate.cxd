true
#]]
 ]

 # ENUM_MISMATCH: value not in the [enum …] member set (§2.3, §3.5, §6).
 # Members are the body items of the [enum …] child element — attributes
 # are scalar-only (code.md §6.4.1), so the retired enum=[…] attr form is
 # gone (#466/#268 owner ruling).
 [case id=validate-012-shape-enum-mismatch level=core
  [tags validate validate-shape enum-mismatch violation]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $r [$validate:validate-shape
  [rec [color "purple"]]
  [schema [field name="color" type="string" [enum "red" "green" "blue"]]]]]
  $r/violation/@code]
#]]
  [out-text [#
'ENUM_MISMATCH'
#]]
 ]

 # [enum …] member is [ok …] (§3.5 membership test happy path).
 [case id=validate-013-shape-enum-ok level=core
  [tags validate validate-shape enum happy]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok
  [$validate:validate-shape
    [rec [color "red"]]
    [schema [field name="color" type="string" [enum "red" "green" "blue"]]]]]
#]]
