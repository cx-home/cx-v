  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $r [$validate:validate-shape
  [rec [score 101]]
  [schema [field name="score" type="int" min=0 max=100]]]]
  $r/violation/@code]
#]]
  [out-text [#
'MAX_VIOLATION'
#]]
 ]

 # In-range numeric is [ok …] (§6 min/max in-range case).
 [case id=validate-007-shape-min-max-ok level=core
  [tags validate validate-shape min max happy]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok
  [$validate:validate-shape
    [rec [score 50]]
    [schema [field name="score" type="int" min=0 max=100]]]]
#]]
  [out-text [#
true
#]]
 ]

 # MIN_LENGTH_VIOLATION: string shorter than min-length= (§2.3, §6).
 [case id=validate-008-shape-min-length-violation level=core
  [tags validate validate-shape min-length-violation violation]
  [in-cx [#
