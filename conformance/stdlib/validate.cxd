true
#]]
 ]

 # UNKNOWN_FIELD: strict=true schema sees an undeclared field (§2.3, §4.1, §6).
 [case id=validate-014-shape-strict-unknown-field level=core
  [tags validate validate-shape unknown-field strict violation]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $r [$validate:validate-shape
  [rec [email "a@b.co"] [extra "x"]]
  [schema strict=true [field name="email" type="string"]]]]
  $r/violation/@code]
#]]
  [out-text [#
'UNKNOWN_FIELD'
#]]
 ]

 # Lax (default): undeclared field is ignored -> [ok …] (§4.1).
 [case id=validate-015-shape-lax-ignores-unknown level=core
  [tags validate validate-shape lax happy]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok
  [$validate:validate-shape
    [rec [email "a@b.co"] [extra "x"]]
    [schema [field name="email" type="string"]]]]
#]]
  [out-text [#
true
#]]
 ]

 # NESTED_VIOLATION + extended path: nested-schema failure bubbles up with
 # its path extended by the nesting step (§2.3, §4.3, §6). Ground via the
 # leaf violation's CXPath path= -> "/address/zip".
 [case id=validate-016-shape-nested-path level=core
  [tags validate validate-shape nested path violation]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:violation-paths
  [$validate:validate-shape
    [rec [address [zip "abc"]]]
    [schema [field name="address" type="element" [schema
      [field name="zip" type="string" pattern="^\\d{5}(-\\d{4})?$"]]]]]]
#]]
  [out-text [#
('/address/zip')
#]]
 ]

 # Multi-violation: a value with two distinct violations produces both
 # (§6 multi-violation). Ground via errors-of count = 2 (§3.3).
 [case id=validate-017-shape-multi-violation-count level=core
  [tags validate validate-shape multi-violation count]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$count
  [$validate:errors-of
    [$validate:validate-shape
      [rec [email "bad"] [score "abc"]]
      [schema
        [field name="email" type="string" pattern=".+@.+\\..+"]
        [field name="score" type="int"]]]]]
#]]
  [out-text [#
2
#]]
 ]

 # §4.5.1 widening: type="float" ACCEPTS an int (lossless widening) -> ok.
 [case id=validate-018-shape-float-accepts-int level=core
  [tags validate validate-shape type float widening]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok
  [$validate:validate-shape
    [rec [n 3]]
    [schema [field name="n" type="float"]]]]
#]]
  [out-text [#
true
#]]
 ]

 # §4.5.1 narrowing rejected: type="int" REJECTS a float (even 3.0).
 [case id=validate-019-shape-int-rejects-float level=core
  [tags validate validate-shape type int narrowing type-mismatch]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $r [$validate:validate-shape
  [rec [n 3.0]]
  [schema [field name="n" type="int"]]]]
  $r/violation/@code]
#]]
  [out-text [#
'TYPE_MISMATCH'
#]]
 ]

 # type="any" always matches (§4.5 type matrix).
 [case id=validate-020-shape-any-matches level=core
  [tags validate validate-shape type any]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok
  [$validate:validate-shape
    [rec [x "anything"]]
    [schema [field name="x" type="any"]]]]
#]]
  [out-text [#
true
#]]
 ]

 # CXER1601 E_VALIDATE_TYPE_UNKNOWN: type= not in §4.5 set (§5).
 [case id=validate-021-shape-type-unknown-err level=core
  [tags validate validate-shape error CXER1601]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [x "y"]]
  [schema [field name="x" type="frobnicate"]]]
#]]
  [out-err [#
cx-err:CXER1601
#]]
 ]

 # CXER1602 E_VALIDATE_PATTERN_INVALID: pattern= that doesn't compile (§5).
 [case id=validate-022-shape-pattern-invalid-err level=core
  [tags validate validate-shape error CXER1602]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [x "y"]]
  [schema [field name="x" type="string" pattern="("]]]
#]]
  [out-err [#
cx-err:CXER1602
#]]
 ]

 # CXER1603 E_VALIDATE_SCHEMA_MALFORMED: impure validate-with= (§3.6, §4.6, §5).
 [case id=validate-023-shape-impure-validator-err level=core
  [tags validate validate-shape error CXER1603 validate-with purity]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?def loud-check impure [returns bool] ($v::int)
  [$io:print "side effect"]
  true]
[$validate:validate-shape
  [rec [score 4]]
  [schema [field name="score" type="int" validate-with=loud-check]]]
#]]
  [out-err [#
cx-err:CXER1603
#]]
 ]

 # CXER1604 E_VALIDATE_ENUM_INVALID: an [enum …] member is non-comparable
 # (§5). An element is non-comparable as an enum member.
 [case id=validate-024-shape-enum-invalid-err level=core
  [tags validate validate-shape error CXER1604 enum]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [x "y"]]
  [schema [field name="x" type="string" [enum [bad-member]]]]]
#]]
  [out-err [#
cx-err:CXER1604
#]]
 ]

 # CXER1605 E_VALIDATE_NESTED_DEPTH: nested-schema recursion exceeds the
 # implementation-defined limit (§5). Per §5 an implementation MUST accept at
 # least 64 levels of nesting and MAY raise CXER1605 only beyond its limit,
 # which MUST be >= 64. The trigger therefore requires nesting that EXCEEDS the
 # implementation limit (>= 64): at depths <= 64 a conforming implementation
 # never raises this code. The self-referential schema below is the spec's
 # documented construction; the literal data is illustrative (the surrounding
 # parser caps element nesting at 64, so a real >64-deep trigger must be built
 # programmatically against an implementation whose validate limit is exceeded).
 # This case is documentary for CXER1605 and is not gate-run against the
 # implementation; it asserts the error code on the canonical deep-nesting form.
 # (#466/#268 migration: the nested schema is a [schema …] CHILD of the field;
 # a self-referential schema is spelled via the $-value reference.)
 [case id=validate-025-shape-nested-depth-err level=extended gate=skip
  [tags validate validate-shape error CXER1605 nested depth]
  [; R3.12 reachability analysis (2026-08-07): CXER1605 fires when the
     VALIDATOR descends past 64 nested schemas — but the PARSER refuses any
     element literal nested deeper than 64 first ("element nesting exceeds
     limit (64)"), and an [extends …] cycle is CXER1603 before depth. So the
     guard is unreachable from literal fixture input; a future case can reach
     it only by CONSTRUCTING a >64-deep element value programmatically.
     Skip-gated with the analysis recorded — the prof-018/CXER2103 pattern
     (never a silent green: the original in-code did not even parse). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape [rec [leaf "x"]] [schema [field name="leaf" type="string"]]]
#]]
  [out-err [#
cx-err:CXER1605
#]]
 ]

 # §3.6 field-level validate-with=: false -> CUSTOM_VIOLATION at field path
 # (§4.6 return-to-violation mapping). even-score on an odd value.
 [case id=validate-026-shape-custom-field-false level=core
  [tags validate validate-shape validate-with custom-violation]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?def even-score pure [returns bool] ($v::int)
  [= [$mod $v 2] 0]]
[?let [= $r [$validate:validate-shape
  [rec [score 7]]
  [schema [field name="score" type="int" validate-with=even-score]]]]
  $r/violation/@code]
#]]
  [out-text [#
'CUSTOM_VIOLATION'
#]]
 ]

 # §3.6 field-level validate-with= passing: even value -> [ok …].
 [case id=validate-027-shape-custom-field-true level=core
  [tags validate validate-shape validate-with happy]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?def even-score pure [returns bool] ($v::int)
  [= [$mod $v 2] 0]]
[$validate:is-ok
  [$validate:validate-shape
    [rec [score 8]]
    [schema [field name="score" type="int" validate-with=even-score]]]]
#]]
  [out-text [#
true
#]]
 ]

 # §3.6 record-level validate-with=: cross-field rule -> CUSTOM_VIOLATION
 # (§3.6 record-level, §6). Ground via the violation path= -> "/end-date".
 [case id=validate-028-shape-custom-record-level level=core
  [tags validate validate-shape validate-with record-level custom-violation]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?def end-after-start pure [returns [sequence element]] ($rec::any)
  [?if [< $rec/end $rec/start]
    [then [violation code="CUSTOM_VIOLATION" path="/end-date"
                     message="end must be after start"]]]]
[$validate:violation-paths
  [$validate:validate-shape
    [rec [start 10] [end 5]]
    [schema validate-with=end-after-start
      [field name="start" type="int"]
      [field name="end" type="int"]]]]
#]]
  [out-text [#
('/end-date')
#]]
 ]

 # ─────────────────────────────────────────────────────────────────────
 # §3.7 [extends …] schema composition
 # ─────────────────────────────────────────────────────────────────────

 # [extends $Base]: child validates base + own fields. A record satisfying
 # both the base and child fields -> [ok …] (§3.7, §4.7, §6). The base is
 # an [extends …] CHILD of [schema …] whose single item is the base-schema
 # value ($-bound or inline [schema …]) — attributes are scalar-only
 # (code.md §6.4.1), so the retired extends=$BASE attr form is gone.
 [case id=validate-029-extends-ok level=core
  [tags validate validate-shape extends happy]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?const BASE [schema [field name="id" type="string"]]]
[$validate:is-ok
  [$validate:validate-shape
    [rec [id "x"] [email "a@b.co"]]
    [schema [extends $BASE]
      [field name="email" type="string" pattern=".+@.+\\..+"]]]]
#]]
  [out-text [#
true
#]]
 ]

 # [extends …]: a base field still enforced through extension -> violation
 # when missing (§3.7 includes all base fields, §6).
 [case id=validate-030-extends-base-enforced level=core
  [tags validate validate-shape extends required-missing violation]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?const BASE [schema [field name="id" type="string"]]]
[?let [= $r [$validate:validate-shape
  [rec [email "a@b.co"]]
  [schema [extends $BASE]
    [field name="email" type="string"]]]]
  $r/violation/@code]
#]]
  [out-text [#
'REQUIRED_MISSING'
#]]
 ]

 # [extends …] cycle / unresolvable base is malformed -> CXER1603 (§3.7,
 # §4.7, §5, §6). §6 mandates this fixture ("cycle -> CXER1603"); the
 # outcome is the spec-fixed error code, which is what this case asserts.
 # A self-referential [?const] is the cycle trigger: the bare word CYCLE
 # inside [extends …] is a literal symbol carrying no schema value.
 [case id=validate-031-extends-cycle-err level=extended
  [tags validate validate-shape extends error CXER1603 cycle]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?const CYCLE [schema [extends CYCLE] [field name="x" type="string"]]]
[$validate:validate-shape [rec [x "y"]] CYCLE]
#]]
  [out-err [#
cx-err:CXER1603
#]]
 ]

 # ─────────────────────────────────────────────────────────────────────
 # Retired attr-collection surface — loud cutover (#466/#268 ruling)
 # ─────────────────────────────────────────────────────────────────────

 # The retired enum=[…] / schema=[…] / extends=$BASE ATTR forms are gone
 # (code.md §6.4.1 wins: attrs are strictly scalar). A collection-valued
 # attr now fails at CONSTRUCTION time (CXER0100, never stringified).
 [case id=validate-040-retired-enum-attr-construction-err level=core
  [tags validate schema retired enum error CXER0100]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [color "red"]]
  [schema [field name="color" type="string" enum=["red", "green"]]]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 # A retired keyword that still ARRIVES as a scalar attr (quoted / bare
 # string) is a malformed schema with a migration hint -> CXER1603.
 [case id=validate-041-retired-enum-attr-string-err level=core
  [tags validate schema retired enum error CXER1603]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [color "red"]]
  [schema [field name="color" type="string" enum="red,green"]]]
#]]
  [out-err [#
cx-err:CXER1603
#]]
 ]

 # Same loud cutover for a string-carried extends= on [schema …].
 [case id=validate-042-retired-extends-attr-string-err level=core
  [tags validate schema retired extends error CXER1603]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [x "y"]]
  [schema extends=BASE [field name="x" type="string"]]]
#]]
  [out-err [#
cx-err:CXER1603
#]]
 ]

 # Same loud cutover for a string-carried schema= on [field …].
 [case id=validate-043-retired-schema-attr-string-err level=core
  [tags validate schema retired nested error CXER1603]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-shape
  [rec [address [zip "78701"]]]
  [schema [field name="address" type="element" schema=ADDR]]]
#]]
  [out-err [#
cx-err:CXER1603
#]]
 ]

 # ─────────────────────────────────────────────────────────────────────
 # §3.2 validate-against + register-schema — the W4 registry re-rule
 # (stream 16; shape_inference.md §3): names are hints, hashes are
 # identity. register-schema binds name → content-hash and retains the
 # canonical text; validate-against resolves name → hash → content,
 # fail-closed at every hop (CXER1600 is a REAL resolution error).
 # ─────────────────────────────────────────────────────────────────────

 # An unregistered name is a real not-found (no binding, no cx.lock pin).
 [case id=validate-032-against-not-found-err level=core
  [tags validate validate-against error CXER1600 not-found]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:validate-against
  [rec [email "a@b.co"]]
  "LEAD_SCHEMA"]
#]]
  [out-err [#
cx-err:CXER1600
#]]
 ]

 # register → validate-against round trip: the registered [schema …]
 # content takes the full validate-shape path ([ok …] on success).
 [case id=validate-041-register-against-ok level=core
  [tags validate register-schema validate-against happy registry]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $h [$validate:register-schema "Lead"
              [schema [field name="email" type="string" required=true]]]]
  [$validate:is-ok [$validate:validate-against [rec [email "a@b.co"]] "Lead"]]]
#]]
  [out-text [#
true
#]]
 ]

 # The registered schema's violations surface identically to
 # validate-shape ([invalid [violation …]] — data, never a thrown err).
 [case id=validate-042-register-against-invalid level=core
  [tags validate register-schema validate-against invalid registry]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $h [$validate:register-schema "Scored"
              [schema [field name="score" type="int" min=0 max=100]]]]
  [$validate:is-ok [$validate:validate-against [rec [score 250]] "Scored"]]]
#]]
  [out-text [#
false
#]]
 ]

 # register-schema returns the content-hash receipt — deterministic for
 # fixed content (the E2 identity: sha-256 over strict-canonical text),
 # and REBINDING a name is allowed (a hint-binding, not an identity):
 # the second registration wins.
 [case id=validate-043-register-rebind-last-wins level=core
  [tags validate register-schema registry rebind]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $h1 [$validate:register-schema "R" [schema [field name="n" type="int" min=10]]]]
  [?let [= $h2 [$validate:register-schema "R" [schema [field name="n" type="int" min=1]]]]
    [$validate:is-ok [$validate:validate-against [rec [n 5]] "R"]]]]
#]]
  [out-text [#
true
#]]
 ]

 # Registered content whose root is NOT [schema …] is a .cxs
 # data-schema (schema.md) — validate-against dispatches on the
 # content's own language. A conforming document answers [ok …].
 [case id=validate-044-against-cxs-content level=core
  [tags validate register-schema validate-against cxs registry]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $h [$validate:register-schema "Ports" "[schema of=ports mode=open]
[ports [body [list u16] [req]]]"]]
  [$validate:is-ok [$validate:validate-against [ports [80, 443]] "Ports"]]]
#]]
  [out-text [#
true
#]]
 ]

 # The .cxs dispatch reports diagnostics as violations — same
 # inspectable [invalid …] vocabulary, one result surface.
 [case id=validate-045-against-cxs-invalid level=core
  [tags validate register-schema validate-against cxs invalid registry]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $h [$validate:register-schema "Ports" "[schema of=ports mode=open]
[ports [body [list u16] [req]]]"]]
  [$validate:is-ok [$validate:validate-against [ports ('nope')] "Ports"]]]
#]]
  [out-text [#
false
#]]
 ]

 # ─────────────────────────────────────────────────────────────────────
 # §3.3 is-ok / errors-of — result inspection
 # ─────────────────────────────────────────────────────────────────────

 # is-ok true iff result is [ok …] (§3.3). Direct [ok …] element.
 [case id=validate-033-is-ok-true level=core
  [tags validate is-ok happy]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok [ok [user [email "a@b.co"]]]]
#]]
  [out-text [#
true
#]]
 ]

 # is-ok false on an [err …] result (§3.3).
 [case id=validate-034-is-ok-false level=core
  [tags validate is-ok err]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:is-ok
  [invalid [violation code="TYPE_MISMATCH" path="/score"]]]
#]]
  [out-text [#
false
#]]
 ]

 # errors-of returns the sequence of [violation …] children; count two
 # violations in an [err …] (§3.3).
 [case id=validate-035-errors-of-count level=core
  [tags validate errors-of count]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$count
  [$validate:errors-of
    [invalid [violation code="TYPE_MISMATCH" path="/a"]
         [violation code="PATTERN_MISMATCH" path="/b"]]]]
#]]
  [out-text [#
2
#]]
 ]

 # errors-of on an [ok …] result is empty (§3.3: "or empty for [ok …]").
 [case id=validate-036-errors-of-ok-empty level=core
  [tags validate errors-of ok empty]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$count [$validate:errors-of [ok [user [email "a@b.co"]]]]]
#]]
  [out-text [#
0
#]]
 ]

 # ─────────────────────────────────────────────────────────────────────
 # §3.4 violation-paths / violation-messages — projections
 # ─────────────────────────────────────────────────────────────────────

 # violation-paths projects the path= field of each violation (§3.4).
 [case id=validate-037-violation-paths level=core
  [tags validate violation-paths projection]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:violation-paths
  [invalid [violation code="TYPE_MISMATCH" path="/score"]
       [violation code="PATTERN_MISMATCH" path="/email"]]]
#]]
  [out-text [#
('/score', '/email')
#]]
 ]

 # violation-paths on an [ok …] result is empty (§3.4 projects over the
 # violation children, of which an ok result has none).
 [case id=validate-038-violation-paths-ok-empty level=core
  [tags validate violation-paths ok empty]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$count [$validate:violation-paths [ok [user [email "a@b.co"]]]]]
#]]
  [out-text [#
0
#]]
 ]

 # violation-messages projects the message= field of each violation (§3.4).
 [case id=validate-039-violation-messages level=core
  [tags validate violation-messages projection]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[$validate:violation-messages
  [invalid [violation code="TYPE_MISMATCH" path="/score"
                  message="score: expected int, got \"abc\""]]]
#]]
  [out-text [#
('score: expected int, got "abc"')
#]]
 ]

 [case id=validate-046-infer-validate-round-trip level=core
  [tags validate schema-of infer round-trip registry stream-14 686 stream-16 688]
  [meta [#
note: the §11 infer→validate round-trip family (shape_inference):
note: [$cx:schema-of] synthesizes the deterministic open-mode .cxs TEXT
note: (the schema identity form — the SAME engine as cx schema infer);
note: registering it and validating the SOURCE doc answers [ok]; an
note: ill-typed doc REFUSES (is-ok false) — the negative leg is live
note: enforcement, repaired at #813 (text bodies were invisible to the
note: scalar body check; int-declared accepted any prose).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?let [= $doc [rec [email "a@b.co"] [score 91]]]
      [= $schema-text [$cx:schema-of $doc]]
      [= $h [$validate:register-schema "Rec" $schema-text]]
      [= $ok [$validate:is-ok [$validate:validate-against $doc "Rec"]]]
      [= $neg [$validate:is-ok [$validate:validate-against [rec [email "x"] [score "high"]] "Rec"]]]
  [probe [round-trip $ok] [neg $neg]]]
#]]
  [out-text [#
[probe [round-trip true] [neg false]]
#]]
 ]

 [case id=validate-047-schema-of-determinism level=core
  [tags validate schema-of infer determinism stream-14 686 stream-16 688]
  [meta [#
note: same value twice → byte-identical .cxs text (determinism is
note: STRING equality — the schema's identity form).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $doc [rec [email "a@b.co"] [score 91]]]
  [$eq [$cx:schema-of $doc] [$cx:schema-of $doc]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=validate-048-schema-of-join-lattice level=core
  [tags validate schema-of infer lattice join stream-14 686 stream-16 688]
  [meta [#
note: the ruled join lattice over a SEQUENCE corpus (a sequence argument
note: reads as a corpus): int ⊔ float = float; int ⊔ decimal = the
note: [or decimal int] union (decimal joins only decimal — 2.5 IS
note: decimal, 2.5e0 is float; never widened to string).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [$cx:schema-of ([m [v 1]], [m [v 2.5e0]])]]
      [= $b [$cx:schema-of ([m [v 1]], [m [v 2.5]])]]
  [probe [int-float-is-float [$contains $a "[body float"]]
         [int-decimal-is-union [$contains $b "[body [or decimal int]"]]]]
#]]
  [out-text [#
[probe [int-float-is-float true] [int-decimal-is-union true]]
#]]
 ]
]
