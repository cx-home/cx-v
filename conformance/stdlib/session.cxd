#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {nonce: $n-i, eph: $i-eph-pub, endpoint: ""}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, attach: [attach [tenant "acme"] [session mirror]]}]]
  [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
#]]
  [out-err [#
cx-err:CXER4803
#]]
 ]

 [case id=session-048-attach-xsp-independent-sessions level=core gate=enforced
  [tags session attach-xsp multiplicity issue-24 n-ident-4]
  [doc [#
#24 §4.9: one principal opens a `new [name=…]` INDEPENDENT session beside the
default (mirror) session — distinct session ids, both live, both enumerated by
list. The named session resolves by-name.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "e"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed,
           attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [= $m3b [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed,
            attach: [attach [tenant "acme"] [session new [name "watch"]]]}]]
  [= $res2 [$session:attach-xsp $m1 $m2 $m3b {eph-priv: $r-eph-priv, tls: true}]]
  [= $ls [$session:list $i-did "acme"]]
  [= $named [$session:by-name $i-did "acme" "watch"]]
  [seq [$count $ls/session]
       [= [$text $res/session/@id] [$text $res2/session/@id]]
       [$text $named/@name]]]
#]]
  [out-text [#
[seq 2 false 'watch']
#]]
 ]

 [case id=session-049-attach-xsp-frame-principal-mismatch level=core gate=enforced
  [tags session attach-xsp frame-check n-ident-1 principal]
  [doc [#
§4.8, the load-bearing closure: after the handshake, a frame whose principal
does NOT match the session principal is rejected (CXER-XSP-AUTH-PRINCIPAL-
MISMATCH); an empty-principal frame inherits the session principal. This is
what makes the XSP principal field a checked label, never an identity source.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $p "did:key:z6MkPrincipalAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"]
  [= $inherited [$xsp:auth-frame-check $p [frame type=event stream=1 principal=""]]]
  [= $matched   [$xsp:auth-frame-check $p [frame type=event stream=1 principal=$p]]]
  [= $rejected  [?fallback [$xsp:auth-frame-check $p [frame type=event stream=1 principal="did:key:z6MkImposterBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"]]
                  [recover-with "REJECTED"]]]
  [seq [= $inherited $p] [= $matched $p] $rejected]]
#]]
  [out-text [#
[seq true true 'REJECTED']
#]]
 ]

 [; ── VC presentation → capability compilation at the PEP (§5) ──────────────
    present-vc binds a presented VC to the session principal and yields its
    §22.2 delegation for the UNCHANGED PEP (authz:check). These lanes drive the
    full identity→authority path and its rejection cases. ]

 [case id=session-050-present-vc-compiles-to-permit level=core gate=enforced
  [tags session present-vc vc authz pep r9]
  [doc [#
The full §5 path: an agent proves its DID (§4), an issuer principal delegates a
capability to it as a VC, present-vc binds the VC to the session and yields the
delegation, authz:delegate + authz:check (the UNCHANGED PEP, R9) permits the
intent, rooted at the issuer principal.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/vc' :as vc]
[?lib 'cx-stdlib/session' :as session]
[?lib 'cx-stdlib/authz' :as authz]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "e"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed, attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [= $deleg [delegation d-nav [tenant acme] [from [principal $r-did]] [to [principal $i-did]]
              [capabilities [read-telemetry]] [over '/nav'] [assurance :t1]]]
  [= $vc [$vc:issue $r-did $r-seed $i-did $deleg {}]]
  [= $compiled [$session:present-vc $res/session $vc {now: "2020-01-01T00:00:00Z"}]]
  [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az $compiled]]
  [= $permit [$authz:check $az [authz-request [actor [principal $i-did]] [capability read-telemetry] [slice '/nav/speed'] [tenant acme]]]]
  [seq [$name $permit] [= [$text $permit/@rooted-principal] $r-did]]]
#]]
  [out-text [#
[seq 'permit' true]
#]]
 ]

 [case id=session-051-present-vc-wrong-subject level=core gate=enforced
  [tags session present-vc subject negative bearer]
  [doc [#
§5.1: a VC whose subject is NOT the session principal is rejected
(CXER-XSP-AUTH-SUBJECT) — the handshake is the proof of possession, so there
are no bearer credentials.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/vc' :as vc]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "e"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed, attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [; VC issued to a DIFFERENT subject (the responder), not the session principal ]
  [= $deleg [delegation d-x [tenant acme] [from [principal $r-did]] [to [principal $r-did]]
              [capabilities [read-telemetry]] [over '/nav']]]
  [= $vc [$vc:issue $r-did $r-seed $r-did $deleg {}]]
  [$session:present-vc $res/session $vc {now: "2020-01-01T00:00:00Z"}]]
#]]
  [out-err [#
cx-err:CXER-XSP-AUTH-SUBJECT
#]]
 ]

 [case id=session-052-present-vc-time-of-use-expiry level=core gate=enforced
  [tags session present-vc expiry time-of-use n-ident-3]
  [doc [#
§5.4: a VC authorizes before its expiry and stops after — presenting the same
VC with a `now` past `expires` yields a not-valid fault (status carried).
Committed history is unaffected; this is the time-of-use check.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/vc' :as vc]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "e"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed, attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [= $deleg [delegation d-nav [tenant acme] [from [principal $r-did]] [to [principal $i-did]]
              [capabilities [read-telemetry]] [over '/nav']]]
  [= $vc [$vc:issue $r-did $r-seed $i-did $deleg {issued-at: "2020-01-01T00:00:00Z", expires: "2020-01-01T01:00:00Z"}]]
  [= $before [$name [$session:present-vc $res/session $vc {now: "2020-01-01T00:30:00Z"}]]]
  [= $after  [?fallback [$session:present-vc $res/session $vc {now: "2020-01-01T02:00:00Z"}] [recover-with "EXPIRED"]]]
  [seq $before $after]]
#]]
  [out-text [#
[seq 'delegation' 'EXPIRED']
#]]
 ]

 [case id=session-053-present-vc-cross-tenant level=core gate=enforced
  [tags session present-vc cross-tenant negative]
  [doc [#
§5.3: a delegation whose tenant differs from the session tenant is a fault
(CXER4805), never silently inert.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/vc' :as vc]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "e"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed, attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [; delegation names a DIFFERENT tenant than the session's acme ]
  [= $deleg [delegation d-nav [tenant other-corp] [from [principal $r-did]] [to [principal $i-did]]
              [capabilities [read-telemetry]] [over '/nav']]]
  [= $vc [$vc:issue $r-did $r-seed $i-did $deleg {}]]
  [$session:present-vc $res/session $vc {now: "2020-01-01T00:00:00Z"}]]
#]]
  [out-err [#
cx-err:CXER4805
#]]
 ]

 [case id=session-054-present-vc-revoked level=core gate=enforced
  [tags session present-vc revocation time-of-use]
  [doc [#
§5.4: a revoked VC fails presentation — revocation lands at the check point
without re-attach. The revoked-set is passed as opts.revoked.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/vc' :as vc]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "e"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed, attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [= $deleg [delegation d-nav [tenant acme] [from [principal $r-did]] [to [principal $i-did]]
              [capabilities [read-telemetry]] [over '/nav']]]
  [= $vc [$vc:issue $r-did $r-seed $i-did $deleg {id: "urn:vc:revoke-me"}]]
  [?fallback [$session:present-vc $res/session $vc {now: "2020-01-01T00:00:00Z", revoked: "urn:vc:revoke-me"}] [recover-with "REVOKED"]]]
#]]
  [out-text [#
'REVOKED'
#]]
 ]

 [case id=session-055-fn-doc-list-empty-for-unknown-principal level=core gate=enforced
  [tags session list multiplicity fn-doc]
  [doc [#
#24 multiplicity read: a (principal, tenant) that holds no sessions on this
XAP enumerates as an empty [sessions] element — absence is a value, not an
error. Backs the [fn-doc name=list] example.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/session']
[$session:list "did:key:nobody" "acme"]
#]]
  [out-text [#
[sessions]
#]]
 ]

 [case id=session-056-fn-doc-by-name-absent level=core gate=enforced
  [tags session by-name absence fn-doc]
  [doc [#
by-name resolves a named independent session or ABSENCE when none exists —
the caller chooses the fallback via [?else]. Backs the [fn-doc name=by-name]
example.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/session']
[?else [$session:by-name "did:key:nobody" "acme" "watch"] "ABSENT"]
#]]
  [out-text [#
'ABSENT'
#]]
 ]

]
