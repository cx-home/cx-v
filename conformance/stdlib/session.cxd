 [; ── XSP-AUTH attach transport + #24 session multiplicity ──────────────────
    (spec/02-working/xap_identity_model.md §4.8/§4.9). attach-xsp binds a
    session from a completed XSP-AUTH handshake; the selector opens mirror /
    independent / named sessions. RFC 7748/8032 vectors injected so the lanes
    are offline + deterministic. ]

 [case id=session-045-attach-xsp-binds-proven-principal level=core gate=enforced
  [tags session attach-xsp xsp-auth did n-ident-1]
  [doc [#
attach-xsp binds a (principal, tenant) session to the PROVEN initiator DID from
a completed mutual handshake, and the responder's confirm reply finishes the
initiator's side (mutual auth). N-IDENT-1: the principal is the authenticated
DID, not a claim.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "tcps://helm.local/xsp"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed,
           attach: [attach [tenant "acme"] [session mirror] [client [channel tui]]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true}]]
  [= $done [$xsp:auth-finish $m1 $m2 $res/confirm {eph-priv: $i-eph-priv}]]
  [seq [= [$text $res/session/principal/@id] $i-did] [= $done/@responder $r-did]]]
#]]
  [out-text [#
[seq true true]
#]]
 ]

 [case id=session-046-attach-xsp-anonymous-floor level=core gate=enforced
  [tags session attach-xsp anonymous floor]
  [doc [#
An anonymous initiator (no DID in M1, no signature in M3) binds to the
deployment's anonymous-floor principal (§4.7) — the responder is still proven.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/session' :as session]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {nonce: $n-i, eph: $i-eph-pub, endpoint: ""}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, attach: [attach [session mirror]]}]]
  [= $res [$session:attach-xsp $m1 $m2 $m3 {eph-priv: $r-eph-priv, tls: true,
            tenant: "acme", anonymous-floor: "did:key:public-observer"}]]
  [$text $res/session/principal/@id]]
#]]
  [out-text [#
'did:key:public-observer'
#]]
 ]

 [case id=session-047-attach-xsp-anonymous-no-floor-rejected level=core gate=enforced
  [tags session attach-xsp anonymous negative]
  [doc [#
An anonymous initiator with no anonymous-floor principal configured is rejected
(§4.7 / N-IDENT-2): there is no principal to bind.
