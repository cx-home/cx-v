 ]

 [case id=similar-027-normalize-stem-token-scorer-contrast level=core
  [tags similar predicate normalize stem]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/similar']
[?let [= $stemmed [$similar:predicate {score: :token-set, normalize: {stem: true}}]]
      [= $plain [$similar:predicate {score: :token-set}]]
  ([$similar:score-of [~ "running fast" "run fastly" $stemmed]],
   [$similar:score-of [~ "running fast" "run fastly" $plain]])]
#]]
  [out-text [#
(1.0e0, 5.0e-1)
#]]
 ]

