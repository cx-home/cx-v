      [= $city-heavy [$similar:predicate {weights: {name: 1.0, city: 3.0}}]]
  ([$similar:score-of [~ {name: "acne corp", city: "berlin"} {name: "acme corp", city: "berlin"} $name-heavy]],
   [$similar:score-of [~ {name: "acne corp", city: "berlin"} {name: "acme corp", city: "berlin"} $city-heavy]])]
#]]
  [out-text [#
(9.555555555555556e-1, 9.851851851851852e-1)
#]]
 ]

