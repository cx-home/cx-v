  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/similar']
[~ 100 105 [$similar:predicate {tolerance: 10.0}]]
#]]
  [out-text [#
[similar score=5.0e-1 [evidence [scorer :numeric]]]
#]]
 ]

