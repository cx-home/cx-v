[test-suite name=similar ring=1
  [doc [#
conformance fixtures for cx-stdlib/similar (spec/std-lib/similar.md §8).

   Graded similarity: [~ a b] / [~ a b $pred] is the single core operator
   (the graded cognate of [= a b]); every other construct — cxpath
   predicate, join, distinct/group-by, contains, sort, [?match] when-arms,
   validate — is that operator in a position (§3.1). The module owns only
   the operator backing, [$similar:predicate], the ten scorers, and the
   normalizers; the verbs are core (no module prefix).

   Every expected output below was re-derived by RUNNING the program
   against the shipped binary (cx <file> — the single oracle). Floats are
   copied exactly as the canonical renderer prints them; no display
   convention. The default predicate carries cuts {match: 0.95,
   review: 0.85}; a predicate built with NO decide policy returns
   score+evidence only (no band attr) and is FALSY in boolean position.
   null comparand -> the absence channel (), never 0. Disjoint kinds ->
   score 0.0 + [kind-mismatch …] evidence, no coercion.

   Case families:
     001-013 operator scalar rules (§2.1.1)
     014-024 per-scorer known pairs (§4.2; 024 advisory — see TODO)
     025-028 normalizers (§4.3, ft pipeline)
     029-040 recursive comparison over value kinds (§2.3)
     041-061 construct x kind matrix (§3.2) + footnoted negatives
     062-071 join: four types over ONE dataset + selection modes (§5.1)
     072-078 clustering policies + determinism (§5.2)
     079-082 routing + resolutions resume tier (§5.3/§5.4)
     083     decision-policy purpose-relativity (pairs with case 002)
     084     truthiness in boolean position (band=:match iff truthy)
     085-100 module fns / fn-doc corpus / core verb happy paths
     101-113 documented errors (CXER4900 predicate / CXER4901 verb opts)

   Errors render as [err code=cx-err:CXER49xx …]; out-err pins the code.
#]]

 [# ---- §2.1.1 operator scalar rules -------------------------------- #]

 [case id=similar-001-op-identical-strings level=core
  [tags similar op identical]
  [in-cx [#
[empty]
#]]
  [in-code [#
[~ "acme" "acme"]
#]]
  [out-text [#
[similar score=1.0e0 band=:match [evidence [scorer :jaro-winkler]]]
#]]
 ]

 [case id=similar-002-op-graded-string-review level=core
  [tags similar op graded-string]
  [in-cx [#
[empty]
#]]
  [in-code [#
[~ "acme" "acne"]
#]]
  [out-text [#
[similar score=8.666666666666667e-1 band=:review [evidence [scorer :jaro-winkler]]]
#]]
 ]

 [case id=similar-003-op-unrelated-string-no-match level=core
  [tags similar op no-match]
  [in-cx [#
[empty]
#]]
  [in-code [#
[~ "acme" "globex"]
#]]
  [out-text [#
[similar score=4.7222222222222215e-1 band=:no-match [evidence [scorer :jaro-winkler]]]
#]]
 ]

 [case id=similar-004-op-numbers-exact-default level=core
  [tags similar op numeric-exact]
  [in-cx [#
[empty]
#]]
  [in-code [#
([~ 100 100], [~ 100 105])
#]]
  [out-text [#
([similar score=1.0e0 band=:match [evidence [scorer :numeric]]], [similar score=0.0e0 band=:no-match [evidence [scorer :numeric]]])
#]]
 ]

 [case id=similar-005-op-numeric-tolerance-shorthand level=core
  [tags similar op tolerance]
  [in-cx [#
[empty]
#]]
  [in-code [#
[~ 100 105 10]
#]]
  [out-text [#
[similar score=5.0e-1 band=:no-match [evidence [scorer :numeric]]]
#]]
 ]

