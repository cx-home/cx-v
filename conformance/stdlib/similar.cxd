 [case id=similar-025-normalize-fold-case-default level=core
  [tags similar op normalize fold-case]
  [in-cx [#
[empty]
#]]
  [in-code [#
[~ "ACME" "acme"]
#]]
  [out-text [#
[similar score=1.0e0 band=:match [evidence [scorer :jaro-winkler]]]
#]]
 ]

 [case id=similar-026-normalize-trim-default level=core
  [tags similar op normalize trim]
  [in-cx [#
[empty]
#]]
  [in-code [#
