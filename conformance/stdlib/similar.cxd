[?lib 'cx-stdlib/similar']
[$join ({name: "acme corp", city: "berlin"},) ({name: "acme corp.", city: "berlin"},) {on: [$similar:predicate {decide: {match: 0.9, review: 0.8}}], type: :inner}]
#]]
  [out-text [#
[join-result type=:inner [pair score=9.9e-1 band=:match [left {name: 'acme corp', city: berlin}] [right {name: 'acme corp.', city: berlin}]]]
#]]
 ]

