 ]

 [case id=similar-012-op-dates-tolerance-no-decide-no-band level=core
  [tags similar op temporal tolerance no-decide]
  [in-cx [#
[empty]
#]]
  [in-code [#
[~ 2024-01-15 2024-01-20 [similar-predicate tolerance=10.0]]
#]]
  [out-text [#
[similar score=5.0e-1 [evidence [scorer :temporal]]]
#]]
 ]

 [case id=similar-013-op-dates-tolerance-decide-review level=core
  [tags similar op temporal tolerance decide]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/similar']
[~ 2024-01-15 2024-01-20 [$similar:predicate {tolerance: 10.0, decide: {match: 0.9, review: 0.4}}]]
#]]
  [out-text [#
[similar score=5.0e-1 band=:review [evidence [scorer :temporal]]]
#]]
 ]

