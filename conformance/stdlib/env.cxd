 [; ── cwd / executable-path disclose filesystem layout: env.md §7 charges
    the `read` capability, NOT `env`. env-056 holds an `env` grant (but no
    `read`) and still denies — proving env alone is insufficient (env-047
    shows `read` succeeds; env-010/011 show the empty set denies). parse-args
    reads the argv vector + parses purely, so it is uncapped (env-058 runs it
    under a non-env `read` grant). ── ]
 [case id=env-056-cwd-needs-read-not-env level=core gate=enforced grant='env'
  [tags env cwd read capability CXER0271]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$env:cwd]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [case id=env-058-parse-args-no-env-cap level=core gate=enforced grant='read'
  [tags env parse-args uncapped]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [flag name=verbose short=v type=bool] [flag name=limit short=n type=int default=100]]]
  [= $parsed [$env-parse-args $spec ("prog", "--verbose", "--limit", "10")]]
  [$env:flag $parsed "verbose"]]
#]]
  [out-text [#
true
#]]
 ]

 [; ── #926, RULED: PYE-2 + PYE-3 — the program argument vector. The runner
    installs the argv= vector (argv[0] INCLUDED — the resource being run;
    misc/cli.md §3.7 positional rule) before eval, and grant='none' runs the
    case under the EMPTY capability set: $env:argv and the ONE-ARG
    $env:parse-args lane (previously unreachable — the run surface provided
    no program args) must succeed with ZERO grants (PYE-3: program args are
    caller-supplied at the invocation site, not ambient authority; $env:var
    stays behind the env grant — pinned by env-001 above). The CLI launch
    modes themselves (FILE / shebang / -e / stdin, incl. argv[0]
    placeholders '-e' and 'stdin') are pinned end-to-end against the real
    binary in vcx/tests/cli_run_surface_test.v. ── ]
 [case id=env-060-argv-ungated-resource-plus-args level=core gate=enforced grant='none' argv='tool.cx alpha beta'
  [tags env argv pye-2 pye-3 ungated]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$env:argv]
#]]
  [out-text [#
('tool.cx', alpha, beta)
#]]
 ]

 [case id=env-061-parse-args-one-arg-live-argv-ungated level=core gate=enforced grant='none' argv='tool.cx --verbose --limit 10'
  [tags env parse-args argv pye-2 pye-3 ungated one-arg]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [flag name=verbose short=v type=bool] [flag name=limit short=n type=int default=100]]]
  [= $parsed [$env:parse-args $spec]]
  ([$env:flag $parsed "verbose"], [$env:flag $parsed "limit"])]
#]]
  [out-text [#
(true, 10)
#]]
 ]

 [case id=env-062-parse-args-one-arg-positional-remaining level=core gate=enforced grant='none' argv='tool.cx in.txt extra1 extra2'
  [tags env parse-args argv pye-2 pye-3 positional remaining]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?let [= $spec [argspec [positional name=input type=string required=true]]]
  [= $parsed [$env:parse-args $spec]]
  ([$env:positional $parsed "input"], [$string [$count [$env:remaining $parsed]]])]
#]]
  [out-text [#
('in.txt', '2')
#]]
 ]

]
