[test-suite name=env ring=1
  [doc [#
conformance fixtures for cx-stdlib/env (spec/std-lib/env.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/env']
   (resolver MUST be quoted) then calls [$env:fn args]. The LAST
   expression is the rendered result. String scalars render quoted;
   bool/int bare; null as `null`; sequences in paren form (a, b, c);
   handle elements as `[std-stream …]`. Error fixtures use --- out_err
   with the bare CXER code.

   DETERMINISM: env vars / pid / cwd / hostname are environment-
   dependent, so fixtures NEVER assert their literal values. They assert
   structural / predicate properties only — an absent var is null /
   false, typed defaults fall back on unset, and the argspec parser is
   exercised against an EXPLICIT argv passed to the backing primitive
   `env-parse-args` (callable directly by bare name). os-name / os-arch
   / cwd / executable-path non-emptiness is checked via cx-stdlib/strings
   `is-empty`. The argspec `type` attribute is given as a quoted string
   (`type=int`); a bare identifier in attribute-value position does not
   evaluate to a CX value in the current implementation.

   NOTE: no `[; … ]` comment blocks appear BETWEEN fixtures — an
   inter-fixture comment would be swallowed into the preceding fixture's
   out_text section (the section parser reads until the next `--- ` or
   `===`), so all explanatory prose lives in this header or in tags.
#]]

 [case id=env-001-var-cap-denied level=core
  [tags env var unset capability CXER0271]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$env:var "CX_DEFINITELY_UNSET_VAR_XYZ_001"]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [; ── SAP C1 §1 absence cutover (the null/absence catalog). An unset
    optional env var is the ABSENCE channel (the empty sequence `()`,
    code.md §9.1.2), NEVER `null` (the §9.1.2.1 no-conflation guard). These
    cases run under an explicit `grant='env'` (least privilege) so the cap
    gate clears and the absence RETURN is exercised — the deny-lane is
    covered by env-001 above. Extraction is `[?else]` (getOrElse, §8.13). ── ]
 [case id=sap-absence-env-01-var-unset-empty level=core grant='env'
  [tags env var unset absence sap c1]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$env:var "CX_DEFINITELY_UNSET_VAR_XYZ_S01"]
#]]
  [out-text [#
()
#]]
 ]

 [case id=sap-absence-env-02-var-unset-count-zero level=core grant='env'
  [tags env var unset absence count sap c1]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$count [$env:var "CX_DEFINITELY_UNSET_VAR_XYZ_S02"]]
#]]
  [out-text [#
0
#]]
 ]

 [case id=sap-absence-env-03-var-unset-else-default level=core grant='env'
  [tags env var unset absence else getorelse sap c1]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?else [$env:var "CX_DEFINITELY_UNSET_VAR_XYZ_S03"] "fallback"]
#]]
  [out-text [#
'fallback'
#]]
 ]

