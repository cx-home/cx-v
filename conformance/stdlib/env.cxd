 # exit / abort TERMINATE the running process (§5, intrinsic — no capability).
 # They cannot be exercised in-process by the eval runner without killing it;
 # their exit-status / abort-signal contract requires a SUBPROCESS harness that
 # launches a child, runs the program, and inspects its termination. Tracked as
 # gate=pending (not run) so the requirement is machine-visible until that
 # harness lands. The in-code documents the call shape.
 [case id=env-039-exit-subprocess-only level=core gate=pending
  [tags env exit subprocess-harness]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$env:exit 0]
#]]
  [out-text [#
[subprocess-harness: child exits with status 0]
#]]
 ]

 [case id=env-040-abort-subprocess-only level=core gate=pending
  [tags env abort subprocess-harness]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[$env:abort]
#]]
  [out-text [#
[subprocess-harness: child terminates via abort signal]
#]]
 ]
