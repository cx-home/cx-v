 # spec/std-lib/env.md §6 scopes the `argv()[0]` == `executable-path` identity to
 # NATIVE execution only: under the stdlib eval runner argv[0] is the evaluated
 # script path, not the cx executable, so the literal equality does not hold here
 # (per §6, it is asserted only by a native process-launch harness). This case
 # therefore asserts only that executable-path is a non-empty string (env-011
 # covers it directly); the native argv[0]==executable-path identity is out of
 # scope for the eval-runner conformance suite.
 [case id=env-031-executable-path-nonempty-dup level=core
  [tags env argv executable-path metadata]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[$strings:is-empty [$env:executable-path]]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

