  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="hit" "acme quality plumbing"], [doc id="miss" "acme one two three four plumbing"])]]
  [$ft:doc-ids [$ft:search $idx [query [near n=2 [term "acme"] [term "plumbing"]]] 10]]]
#]]
  [out-text [#
(hit)
#]]
 ]

 [case id=ft-035-near-ordered-rejects-reversed level=core
  [tags ft near ordered proximity]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="rev" "plumbing by acme"],)]]
  [= $uno [$count [$ft:search $idx [query [near n=5 [term "acme"] [term "plumbing"]]] 10]]]
  [= $ord [$count [$ft:search $idx [query [near n=5 ordered=true [term "acme"] [term "plumbing"]]] 10]]]
  [pair unordered=$uno ordered=$ord]]
#]]
  [out-text [#
[pair unordered=1 ordered=0]
#]]
 ]

