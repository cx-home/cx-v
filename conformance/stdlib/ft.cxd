[test-suite name=ft ring=1
  [doc [#
conformance fixtures for cx-stdlib/ft (spec/std-lib/ft.md §6/§8).

   Each program imports the bundled module via [?lib 'cx-stdlib/ft']
   (resolver MUST be quoted) then calls [$ft:fn args]. The LAST expression
   is the rendered result. String scalars render quoted; bool/int bare;
   sequences in paren form (a, b, c). Error fixtures use out-err with the
   bare CXER code.

   DETERMINISM (critical): the spec defines NO golden score values for
   TF-IDF / BM25 and no golden snippet text — scores are "comparable
   within an Index, not across Indexes" (§5.2) and are otherwise
   implementation-internal. Therefore NO fixture asserts a literal
   `score=` value or exact snippet body. Search/index assertions pin only
   spec-grounded STRUCTURAL properties:
     - empty-corpus / empty-query behavior (§8: index [] empty; search ""
       empty sequence, NOT an error),
     - round-trip rank-1 doc membership via the ft/doc-ids helper
       (§8 round-trip),
     - result-count / doc-count via $count and ft/index-stats,
     - field restriction returns only matching docs (§4.3 worked example),
     - snippet contains query terms wrapped in <mark> (§8 snippets),
     - case-folding and stemming collapse (§8 stemming / case folding) via
       ft/tokenize and via search result counts,
     - every documented error code (§7).

   The strings helper [?lib 'cx-stdlib/strings'] is co-imported in cases
   that assert substring presence (strings/contains) or emptiness
   (strings/is-empty).
#]]

 [case id=ft-001-index-empty-corpus level=core
  [tags ft index empty-corpus edge]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[$ft:index-stats [$ft:index ()]]
#]]
  [out-text [#
{doc-count: 0, term-count: 0, size-bytes: 0, languages: ()}
#]]
 ]

 [case id=ft-002-index-doc-count level=core
  [tags ft index index-stats doc-count]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc "database design"], [doc "schema migrations"], [doc "query planner"])]]
  [$map-get [$ft:index-stats $idx] "doc-count"]]
#]]
  [out-text [#
3
#]]
 ]

 [case id=ft-003-search-empty-query-returns-empty-seq level=core
  [tags ft search empty-query edge]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc "database design"], [doc "schema migrations"])]]
  [$ft:search $idx [$ft:parse-query ""] 10]]
#]]
  [out-text [#
()
#]]
 ]

