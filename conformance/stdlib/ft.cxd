 # CXER1203 (E_FT_INDEX_INCOMPATIBLE) per ft.md §3.2: search-with-opts whose
 # case-sensitive (or language) differs from the Index's build options raises,
 # because the query tokens cannot match the Index's tokens. Here the Index is
 # built case-sensitive=true and searched with case-sensitive=false.
 [case id=ft-027-search-index-incompatible level=core
  [tags ft search index-incompatible CXER1203]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index-with-opts ([doc id="d1" "Database Design"]) {case-sensitive: true}]]
  [$ft:search-with-opts $idx [$ft:parse-query "database"] {case-sensitive: false}]]
#]]
  [out-err [#
cx-err:CXER1203
#]]
 ]

