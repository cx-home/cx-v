#]]
 ]

 [case id=ft-039-parse-query-slop-and-near level=core
  [tags ft parse-query slop near mapping]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[pair
  [slop [$ft:parse-query "\"customer support\"~2"]]
  [near [$ft:parse-query "acme ONEAR/5 plumbing"]]]
#]]
  [out-text [#
[pair [slop [query [phrase slop=2 'customer support']]] [near [query [near n=5 ordered=true [term 'acme'] [term 'plumbing']]]]]
#]]
 ]

 [case id=ft-040-injection-boundary-term-stays-a-term level=core
  [tags ft injection structural-query security]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="d1" "alpha beta"], [doc id="d2" "gamma"])]]
  [= $user-input "alpha OR gamma"]
  [= $structural [$count [$ft:search $idx [query [term $user-input]] 10]]]
  [= $parsed     [$count [$ft:search $idx [$ft:parse-query $user-input] 10]]]
  [pair structural=$structural parsed=$parsed]]
#]]
  [out-text [#
[pair structural=0 parsed=2]
#]]
 ]

 [case id=ft-041-proximity-boost-monotone level=core
  [tags ft scoring proximity-boost ranking]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/ft']
[?let [= $idx [$ft:index ([doc id="d" "acme plumbing"],)]]
  [= $q [query [all [term "acme"] [term "plumbing"]]]]
  [= $on  [$ft:score-of [$first [$ft:search-with-opts $idx $q {limit: 1}]]]]
  [= $off [$ft:score-of [$first [$ft:search-with-opts $idx $q {limit: 1, proximity-boost: 0.0}]]]]
  [> $on $off]]
#]]
  [out-text [#
true
#]]
 ]

