 # TODO(spec pinned; impl pending): §5 now names all four range builtins
 # (int-range, int-range-with, float-range, float-range-with) plus crypto-int
 # for CXER1901 on lo > hi. This case asserts that now-required error for
 # float-range-with; gate stays advisory until the (currently unimplemented)
 # module raises it.
 [case id=random-049-float-range-with-invalid level=core
  [tags random prng float-range-with CXER1901]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[$random:float-range-with [$random:from-seed 1] 9.0e0 2.0e0]
#]]
  [out-err [#
cx-err:CXER1901
#]]
 ]

 # random-050 pins the STRICTNESS rule and is correct: `0.0` is a decimal
 # literal, and ordered comparison refuses to mix it with the float
 # next-float returns. Keeping it — that refusal is worth a fixture.
 #
 # What was wrong (#998's sweep) is that stdlib/random.cx's fn-doc for
 # next-float showed THIS code and advertised `true`. It does not print `true`;
 # it raises. The doc-backing gate passed it anyway, because that gate only
 # requires the [expect] text to appear VERBATIM somewhere in this file — and
 # `true` appears all over it. So the example was backed by a row that pins the
 # OPPOSITE outcome. The range property the doc means to show is random-050a
 # below, with float literals on both sides, and the fn-doc points there now.
 [case id=random-050-next-float-range level=core
  [tags random prng next-float range property seeded]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $a [$random:seed 42]] [= $f [$random:next-float]] [and [>= $f 0.0] [< $f 1.0]]]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='[>=] operand is not a single numeric scalar (got a decimal-typed scalar); ordered comparison is strict — convert with [cast $s :int] / [cast $s :float]']
#]]
 ]

 [case id=random-050a-next-float-range-float-literals level=core
  [tags random prng next-float range property seeded fn-doc-backing]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $a [$random:seed 42]] [= $f [$random:next-float]] [and [>= $f 0.0e0] [< $f 1.0e0]]]
#]]
  [out-text [#
true
#]]
 ]

