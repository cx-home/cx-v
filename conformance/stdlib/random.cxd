[test-suite name=random
  [doc [#
conformance fixtures for cx-stdlib/random (spec/std-lib/random.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/random']
   (resolver MUST be quoted) then calls [$random:fn args] in the qualified
 postfix-paren call form. The LAST expression is the rendered
   result. Determinism: assertions pin only SEEDED outputs (random/from-seed
   + the -with mirrors, or random/seed + process-global), or structural
   properties (range membership via a degenerate range, sequence length,
   error codes). Unseeded / global RNG values are never asserted by literal
   value.

   The seeded golden values below are produced by xoshiro256++ (§4.1) from
   the SplitMix64 seed-expansion of the given seed; they are the pinned
   cross-version / cross-binding reproducibility vector (§6).
#]]

 [case id=random-001-from-seed-next-int-golden level=core
  [tags random prng from-seed golden]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-int-with [$random:from-seed 42]]] $r/value]
#]]
  [out-text [#
7510639304993616975
#]]
 ]

 [case id=random-002-from-seed-next-int-second level=core
  [tags random prng from-seed thread golden]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $r1 [$random:next-int-with [$random:from-seed 42]]] [?let [= $r2 [$random:next-int-with $r1/next-generator]] $r2/value]]
#]]
  [out-text [#
2940605065665682376
#]]
 ]

 [case id=random-003-from-seed-next-float-golden level=core
  [tags random prng from-seed float golden]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-float-with [$random:from-seed 42]]] $r/value]
#]]
  [out-text [#
0.8143051451229099
#]]
 ]

 [case id=random-004-from-seed-next-bool-golden level=core
  [tags random prng from-seed bool golden]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $r [$random:next-bool-with [$random:from-seed 42]]] $r/value]
#]]
  [out-text [#
true
#]]
 ]

