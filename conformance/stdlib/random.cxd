 [case id=random-057-handle-gen-int-golden level=core
  [tags random prng handle new gen-int golden]
  [doc [# §3.7 parity invariant: [$random:new 42] + gen-int computes the SAME
     golden value as from-seed(42) + next-int-with — one seed→sequence mapping
     across all three generator forms. #]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[$random:gen-int [$random:new 42]]
#]]
  [out-text [#
7510639304993616975
#]]
 ]

 [case id=random-058-handle-streams-are-independent level=core
  [tags random prng handle independence]
  [doc [# two handles from one seed advance independently: interleaved draws on
     $a never perturb $b's sequence (the #625 worker-corpus failure mode). #]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?let [= $a [$random:new 7]]
      [= $b [$random:new 7]]
      [= $a1 [$random:gen-int $a]]
      [= $a2 [$random:gen-int $a]]
      [= $b1 [$random:gen-int $b]]
  [and [= $a1 $b1] [not [= $a1 $a2]]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=random-059-thread-seed-then-draw-golden level=core
  [tags random prng seed thread-stream golden]
  [doc [# §2: [$random:seed] seeds the CALLING THREAD's stream — seed-then-draw
     is deterministic within a thread and yields the pinned §4.1 vector. #]]
  [in-cx [#
[empty]
#]]
  [in-code [#
