  [= $r1 [$fabric:publish $f "m" [a 1] {actor: "u" authority: "g"}]]
  [= $r2 [$fabric:publish $f "m" [a 2] {actor: "u" authority: "g"}]]
  [= $r3 [$fabric:publish $f "m" [a 3] {actor: "u" authority: "g"}]]
  [= $s [$fabric:subscribe $f "m" "a"]]
  [= $c1 [$count [$fabric:receive $s {max: 2}]]]
  [= $c2 [$count [$fabric:receive $s]]]
  [+ [* 10 $c1] $c2]]
#]]
  [out-text [#
21
#]]
 ]

