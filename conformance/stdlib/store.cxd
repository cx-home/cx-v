     check denies, the refusal carries CXER4700 with the [deny] as cause,
     and NOTHING executes (no eval grant here: authorize-before-execute
     fires before the executor's own capability gate). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/authz']
[?let [= $s [$store:open "mem://pq36"]]
  [= $az [$authz:store {tenant: 'acme'}]]
  [$store:query $s [?quote [?for [in $o [$store:source $s "//order"]] [yield $o]]]
    opts={authz: $az, actor: [agent ghost], tenant: 'acme'}]]
#]]
  [out-err [#
cx-err:CXER4700
#]]
 ]

