 [; ── #290: gc/prune succeed on the flat file:// document model (the legacy
    on-disk form) — §15 lists both under write (file/local), so the capability
    table is the contract. Flat semantics mirror pc_reclaim's obj_roots
    semantics: every present doc is its own object AND a root, so there is
    never a sub-doc object to reclaim (reclaimed=0, objects=<live docs>);
    gc additionally compacts the append log to a snapshot. ── ]
 [case id=store-gc-002-flat-file-succeeds level=core grant='read write'
  [tags store gc porcelain file-backend document-model granted effort-b]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/strings']
[?let [= $u [$strings:join ("document+file://", [$path:join [$io:temp-dir "cxstore"] "s/"]) ""]] [= $s [$store:open $u]] [= $a [$store:put-doc $s [doc [item "x"]]]] [= $b [$store:put-doc $s [doc [item "y"]]]] [= $d [$store:delete-doc $s $a]] [$store:gc $s]]
#]]
  [out-text [#
[gc-result reclaimed=0 objects=1]
#]]
 ]

 [case id=store-prune-002-flat-file-succeeds level=core grant='read write'
  [tags store prune porcelain file-backend document-model granted effort-b]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/strings']
[?let [= $u [$strings:join ("document+file://", [$path:join [$io:temp-dir "cxstore"] "s/"]) ""]] [= $s [$store:open $u]] [= $a [$store:put-doc $s [doc [item "x"]]]] [= $b [$store:put-doc $s [doc [item "y"]]]] [= $d [$store:delete-doc $s $a]] [$store:prune $s]]
#]]
  [out-text [#
[prune-result reclaimed=0 objects=1]
#]]
 ]

