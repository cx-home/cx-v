 [case id=store-code-009-tier2-named-param-name-distinct level=core
  [tags code-identity computation-id i1 c2]
  [; C2 rule 1: a NAMED parameter's name is part of the call contract
     (the shipped named spelling is the `=`-default form) — two defs
     whose named params differ only in NAME cannot be called
     interchangeably and must not share an identity. Positional names
     stay alpha-normalized (store-code-002). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$eq [$cx:computation-id '[?def f ($x=1) 7]'] [$cx:computation-id '[?def f ($y=1) 7]']]
#]]
  [out-text [#
false
#]]
 ]

 [case id=store-code-010-tier2-excluded-clause-invariant level=core
  [tags code-identity computation-id i1 c2 excluded]
  [; C2 rule 4 (closed participation list, EXCLUDED-by-default): a clause
     not in the enumerated participating set — [throws] here — is OUTSIDE
     computation identity; two defs differing only in it SHARE an identity. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$eq [$cx:computation-id '[?def f [returns int] ($a) $a]'] [$cx:computation-id '[?def f [returns int] [throws overflow] ($a) $a]']]
#]]
  [out-text [#
true
#]]
 ]


 [case id=store-blob-001-byte-exact-round-trip level=core
  [tags store mem put-blob get-blob opaque f1-prime byte-exact]
  [; F1' (ruled 2026-08-08): an OPAQUE document — CX code here — round-trips
     BYTE-EXACT through put-blob/get-blob (identity = hash of the RAW bytes;
     no canonicalization). This exact def MANGLES through put-doc-text (the
     structured path — see store_verbatim_roundtrip_evidence_test.v). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]] [= $src "[?def greet ($name) [str-format 'hello, {}' $name]]"] [$eq [$store:get-blob $s [$store:put-blob $s $src]] $src]]
#]]
  [out-text [#
true
#]]
 ]

