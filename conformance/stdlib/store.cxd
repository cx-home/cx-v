  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $kids [?for [in $i ("a", "b")] [yield [?element "row" [?attr "id" $i]]]]] [= $doc [?element "rows" [?splice $kids]]] [= $s [$store:open "mem://"]] [= $h [$store:put-doc $s $doc]] ([$cx:equal [$store:get-doc $s $h] $doc], [$eq [$cx:serialize [$store:get-doc $s $h]] [$cx:serialize $doc]])]
#]]
  [out-text [#
(true, true)
#]]
 ]

