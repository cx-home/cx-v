 [- ── (B) file:// open / open-opts capability-deny paths (CXER0271) ── -]

 [case id=store-001-open-cap-denied level=core
  [tags store open capability CXER0271]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[$store:open "file:///var/data/store/"]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [case id=store-002-open-opts-cap-denied level=core
  [tags store open-opts capability CXER0271]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[$store:open-opts "file:///var/data/store/" [map compression="zst" encoding="cxbin"]]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [- ── Effort B granted-harness pilot: `grant=` injects a least-privilege
    capability set for this case (vs the empty deny-lane default). With the
    read/write grant the file:// open clears the capability gate (no longer
    CXER0271, cf. store-001) and reaches the now-functional file:// backend
    (§2.2.1 LocalFiles), which opens a real on-disk Store. This proves the
    per-fixture [grant] path end-to-end against the same effect point
    store-001 denies. The file:// behavior cases below are kept hermetic by
    rooting each Store at a fresh `io/temp-dir`. ── -]
 [case id=store-003-open-file-granted-reaches-backend level=core grant='read write'
  [tags store open capability grant effort-b file-backend]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/strings']
[?let [= $u [$strings:join ("file://", [$path:join [$io:temp-dir "cxstore"] "s/"]) ""]] [?let [= $s [$store:open $u]] $s@backend]]
#]]
  [out-text [#
'file'
#]]
 ]

 [case id=store-014-file-put-get-roundtrip-granted level=core grant='read write'
  [tags store put-doc get-doc file-backend roundtrip granted effort-b]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/strings']
[?let [= $u [$strings:join ("file://", [$path:join [$io:temp-dir "cxstore"] "s/"]) ""]] [?let [= $s [$store:open $u]] [?let [= $h [$store:put-doc $s [user name=z]]] [$store:get-doc $s $h]]]]
#]]
  [out-text [#
[user name=z]
#]]
 ]

