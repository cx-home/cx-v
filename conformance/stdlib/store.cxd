 [case id=store-log-002-advance-order level=core
  [tags store mem log porcelain e3 lineage i5-stream4]
  [doc [#
#708 fixed: store:log reports PER-REF ADVANCE ORDER - one row per
recorded act, not one row per held doc-ref. put A, put B, delete A =
THREE rows; the retract is an act in the history (docs-plane pos 3),
never a silent disappearance. This is the E3 lineage the wire feed
reads too (one log, two readers - the local view and the remote
subscription can never disagree).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]]
  [= $h1 [$store:put-doc $s [doc [v 1]]]]
  [= $h2 [$store:put-doc $s [doc [v 2]]]]
  [= $del [$store:delete-doc $s $h1]]
  [= $l [$store:log $s]]
  [= $r [$first $l//ref[= $_@kind "retract"]]]
  [seq [$count $l] [$text $r/@pos] [$text $r/@plane]]]
#]]
  [out-text [#
[seq 3 '3' 'docs']
#]]
 ]

 [case id=store-log-003-branch-advances-appear level=core
  [tags store mem log porcelain e3 branch-force lineage i5-stream4]
  [doc [#
E3 position semantics (semantic_value_model §4): aliases are per-name
streams with dense positions - branch then branch-force on one name
are pos 1 and pos 2, and the FORCE advance APPEARS in the history (an
invisible force-move hollows the audit story).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]]
  [= $h1 [$store:put-doc $s [doc [v 1]]]]
  [= $h2 [$store:put-doc $s [doc [v 2]]]]
  [= $b1 [$store:branch $s "main" $h1]]
  [= $b2 [$store:branch-force $s "main" $h2]]
  [= $l [$store:log $s]]
  [?for [in $r $l//ref[= $_@plane "aliases"]]
    [yield [$text $r/@pos]]]]
#]]
  [out-text [#
'1'
'2'
#]]
 ]

