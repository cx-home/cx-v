 [; SAP C1 §1: an alias miss is the ABSENCE channel (the empty sequence
    `()`, code.md §9.1.2), NEVER `null` (the §9.1.2.1 no-conflation guard). ]
 [case id=store-alias-002-get-missing-absence level=core
  [tags store mem get-alias absence sap c1]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]] [$store:get-alias $s "nope"]]
#]]
  [out-text [#
()
#]]
 ]

 [; SAP C1: getOrElse over an alias miss — `[?else]` coalesces absence to the
    default (§8.13), proving the alias-miss empty IS the absence channel. ]
 [case id=sap-absence-store-01-alias-miss-else level=core
  [tags store mem get-alias absence else getorelse sap c1]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]] [?else [$store:get-alias $s "nope"] "fallback"]]
#]]
  [out-text [#
'fallback'
#]]
 ]

 [; SAP C1: a RESOLVED alias still returns its hash (present value flows) —
    pins that the cutover did not turn every alias return into absence. ]
