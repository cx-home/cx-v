 [; CO-2 975: the err-at-boundary rule — a store document write is an
    externalizing effect; an err element at any depth refuses CXER0275
    unless the effect form carries errs=:permit. commands_effects §7.5. ]

 [case id=store-err-boundary-001-put-doc-nested-err-refuses level=core gate=enforced
  [tags store err-boundary CXER0275 975]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]]
      [= $rows ([row [v 2.5]], [err code=cx-err:CXER0100 message="a refusal at rest"], [row [v 4.5]])]
  [$store:put-doc $s [report [count [$count $rows]] [?splice $rows]]]]
#]]
  [out-err [#
cx-err:CXER0275
#]]
 ]

 [case id=store-err-boundary-002-put-doc-permit-externalizes level=core gate=enforced
  [tags store err-boundary permit 975]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://"]]
      [= $h [$store:put-doc $s [report [err code=cx-err:CXER0100 message="stored deliberately"]] {errs: :permit}]]
  [$store:get-doc $s $h]]
#]]
  [out-text [#
[report [err code=cx-err:CXER0100 message='stored deliberately']]
#]]
 ]

 [case id=store-err-boundary-003-modify-action-err-refuses level=core gate=enforced
