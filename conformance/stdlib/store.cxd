 [case id=store-034-explain-query-slices-and-rewrites level=core
  [tags store explain-query planar quoted slices rewrites l99 l96 stream-2]
  [; R-A1 migration: envelope → spliced children (2026-08-25) ]
  [; the slice set is extracted statically (kind/handle/path) and the L96
     rewrite report rides the same element — an order-by/where pair shows
     one APPLIED σ-pushdown (the honest-reporting surface). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://pq34"]]
  [= $qp [$store:explain-query $s [?quote [?for [in $o [$store:source $s "//order"]]
    [order-by $o@n] [where [= $o@k "x"]] [yield $o]]]]]
  [report slices=[$count $qp//slice]
    pushdown=[$count $qp//applied[= $_@kind "sigma-pushdown-below-tau"]]
    [p [?splice $qp//slice/@path]]]]
#]]
  [out-text [#
[report slices=1 pushdown=1 [p [path '//order']]]
#]]
 ]

