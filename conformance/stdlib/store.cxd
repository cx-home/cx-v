[?let [= $rows ([row [v 2.5]], [err code=cx-err:CXER0100 message="a value, in process"], [row [v 4.5]])]
  [summary [n [$count $rows]] [first-err-code [?for [in $e $rows] [where [?match $e [case [err] true] [else false]]] [yield [$concat "" $e@code]]]]]]
#]]
  [out-text [#
[summary [n 3] [first-err-code 'cx-err:CXER0100']]
#]]
 ]
