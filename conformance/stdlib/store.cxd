(2, true, 2)
#]]
 ]

 [case id=store-reconcile-001-fast-forward level=core gate=enforced
  [tags store sync reconcile fast-forward stream-9 681 L175 L176]
  [; ── stream 9 (distributed_store §4/§5): per-ref reconciliation of the
     alias plane — the fast-forward leg of the discriminator pair. Ours
     never moved past the common base while theirs did, so the advance
     APPLIES: the target doc lands (content-addressed copy) and the ref
     advances through the one live-mutation seam, durably. A second
     reconcile is idempotent (identical=1, nothing applied twice). The
     report is the balanced examination account: refs = identical +
     advanced + ahead + conflicts.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let
[= $a [$store:open "mem://rc-a"]]
[= $b [$store:open "mem://rc-b"]]
[= $d1 [$store:put-doc $a [order [id 1]]]]
[= $d1b [$store:put-doc $b [order [id 1]]]]
[= $x1 [$store:set-alias $a "head" $d1]]
[= $x2 [$store:set-alias $b "head" $d1]]
[= $d2 [$store:put-doc $a [order [id 1] [line "x"]]]]
[= $x3 [$store:set-alias $a "head" $d2]]
[= $ff [$store:reconcile-report $b $a]]
[= $again [$store:reconcile-report $b $a]]
  [probe [ff $ff] [target [$store:get-alias $b "head"]] [again $again]]]
#]]
  [out-text [#
[probe [ff [reconcile-report ok=true refs=1 identical=0 advanced=1 ahead=0 conflicts=0 [advance name=head from='sha2-256:59f4fc9c5c13e45e4f86a3c3b89087184d8cb442c919adb6e633c376061cc056' to='sha2-256:312707dfc6c3239450adc15165c83202db4d98c2b6fba3ccceb4a54a17d6bc7b']]] [target 'sha2-256:312707dfc6c3239450adc15165c83202db4d98c2b6fba3ccceb4a54a17d6bc7b'] [again [reconcile-report ok=true refs=1 identical=1 advanced=0 ahead=0 conflicts=0]]]
#]]
 ]

 [case id=store-reconcile-002-diverged-conflict-value level=core gate=enforced
  [tags store sync reconcile conflict diverged stream-9 681 L174 L175 CXER5053]
  [; ── stream 9 (distributed_store §3/§4): the diverged leg — BOTH sides
     moved past the common base, so the ref applies NOTHING and the report
     carries the ONE Ring-0 conflict value: [conflict subject=
     kind=:diverged-advance [base position= hash=] [ours position= hash=
     [diff …]] [theirs position= hash= [diff …]] [cas code=CXER1114
     expect-pos= actual-pos=]]. The base is the NORMATIVE common base
     (L174: greatest position at which both lineages record the same
     target); ours/theirs carry navigable, PATCHABLE diffs against it —
     the cx module's §5 law holds on the conflict's own payload
     (patch(base, ours-diff) ≡ ours, probed [law true]); the value
     canonicalizes and hashes stably ([stable true] — a data-profile
     citizen); ours' ref is UNMOVED ([unmoved true] — diverged applies
     nothing). The enforcing twin obeys the agreement law: raise ⟺ the
     report says ok=false — CXER5053 E_SYNC_DIVERGED carrying every
     [conflict] as err children.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/cx']
[?let
[= $a [$store:open "mem://rc3-a"]]
[= $b [$store:open "mem://rc3-b"]]
[= $d1 [$store:put-doc $a [order [id 1]]]]
[= $d1b [$store:put-doc $b [order [id 1]]]]
[= $x1 [$store:set-alias $a "head" $d1]]
[= $x2 [$store:set-alias $b "head" $d1]]
[= $d3 [$store:put-doc $a [order [id 1] [line "y"]]]]
[= $x4 [$store:set-alias $a "head" $d3]]
[= $d4 [$store:put-doc $b [order [id 1] [note "rush"]]]]
[= $x5 [$store:set-alias $b "head" $d4]]
[= $dv [$store:reconcile-report $b $a]]
[= $conf $dv/conflict]
[= $basedoc [$store:get-doc $b $conf/base/@hash]]
[= $oursdoc [$store:get-doc $b $conf/ours/@hash]]
[= $law [$cx:equal [$cx:patch $basedoc [$first $conf/ours/*]] $oursdoc]]
[= $ctext [$cx:canonical [$cx:serialize $conf]]]
[= $stable [$cx:equal [$cx:hash $ctext] [$cx:hash [$cx:canonical $ctext]]]]
[= $unmoved [$cx:equal [$store:get-alias $b "head"] $d4]]
[= $enf [?fallback [$store:reconcile $b $a] [recover-with [context] [code $err@code]]]]
  [probe [diverged $dv] [law $law] [stable $stable] [unmoved $unmoved] [enforcing $enf]]]
#]]
  [out-text [#
[probe [diverged [reconcile-report ok=false refs=1 identical=0 advanced=0 ahead=0 conflicts=1 [conflict subject=head kind=:diverged-advance [base position=1 hash='sha2-256:59f4fc9c5c13e45e4f86a3c3b89087184d8cb442c919adb6e633c376061cc056'] [ours position=2 hash=sha2-256:ab9d7a9879bcf3cf2493ed198944893dd954d402fcb7bb68f250a24f40075b08 [diff [change kind=element-added path='/order/note' after=note payload=subtree [after [note 'rush']]]]] [theirs position=2 hash='sha2-256:150a51655bdea44c80a0f7f4960573b09f51702c47f078310fb23b344124f03b' [diff [change kind=element-added path='/order/line' after=line payload=subtree [after [line 'y']]]]] [cas code=CXER1114 expect-pos=1 actual-pos=2]]]] [law true] [stable true] [unmoved true] [enforcing [code 'cx-err:CXER5053']]]
#]]
 ]

 [case id=store-reconcile-003-resolution-merge-entry level=core gate=enforced
  [tags store sync reconcile resolution merge-entry stream-9 681 L174]
  [; ── stream 9 (distributed_store §3/§4, ruling L174): merge-as-an-entry.
     A diverged ref resolves through the resolutions INPUT TABLE
     ({resolutions: [resolve ref= target=]}): the join is RECORDED — a
     stored [merge] doc naming base/ours/theirs as locator triples
     (stream, position, hash — the #717 rule) plus the resolved target —
     and the lineage ADOPTS theirs before advancing to the target, so the
     NEXT reconcile finds theirs' tip as the common base and answers
     AHEAD: converged, never a re-conflict (pure + replayable — identical
     input + identical resolutions ⇒ identical end state). The lineage
     stays LINEAR; no merge NODE exists — the join lives in an ordinary,
     addressable, inspectable value. resolved= appears on the report only
     when the seam engaged (the L119 posture).]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/cx']
[?let
[= $a [$store:open "mem://mr-a"]]
[= $b [$store:open "mem://mr-b"]]
[= $d1 [$store:put-doc $a [order [id 1]]]]
[= $d1b [$store:put-doc $b [order [id 1]]]]
[= $x1 [$store:set-alias $a "head" $d1]]
[= $x2 [$store:set-alias $b "head" $d1]]
[= $d3 [$store:put-doc $a [order [id 1] [line "y"]]]]
[= $x4 [$store:set-alias $a "head" $d3]]
[= $d4 [$store:put-doc $b [order [id 1] [note "rush"]]]]
[= $x5 [$store:set-alias $b "head" $d4]]
[= $dm [$store:put-doc $b [order [id 1] [line "y"] [note "rush"]]]]
[= $r [$store:reconcile-report $b $a {resolutions: [resolve ref="head" target=$dm]}]]
[= $rv [$first $r/*]]
[= $rec [$store:get-doc $b $rv/@record]]
[= $again [$store:reconcile-report $b $a]]
[= $t [$cx:equal [$store:get-alias $b "head"] $dm]]
  [probe [resolved $r] [record $rec] [again $again] [target $t]]]
#]]
  [out-text [#
[probe [resolved [reconcile-report ok=true refs=1 identical=0 advanced=0 ahead=0 conflicts=0 resolved=1 [resolved name=head to='sha2-256:766f390f523fa864a370bf0fecd7e0b2d6309e63654941e95d05ebcb204b88c7' record=sha2-256:d642b04715c7e0dbcced6f0e4ee2431c85339a9b97a3418dfe3d08af9e9f9d4a]]] [record [merge ref=head [base stream='aliases/head' position=1 hash='sha2-256:59f4fc9c5c13e45e4f86a3c3b89087184d8cb442c919adb6e633c376061cc056'] [ours stream='aliases/head' position=2 hash=sha2-256:ab9d7a9879bcf3cf2493ed198944893dd954d402fcb7bb68f250a24f40075b08] [theirs stream='aliases/head' position=2 hash='sha2-256:150a51655bdea44c80a0f7f4960573b09f51702c47f078310fb23b344124f03b'] [target hash='sha2-256:766f390f523fa864a370bf0fecd7e0b2d6309e63654941e95d05ebcb204b88c7']]] [again [reconcile-report ok=true refs=1 identical=0 advanced=0 ahead=1 conflicts=0]] [target true]]
#]]
 ]

 [case id=store-pull-002-split-and-agreement level=core gate=enforced
  [tags store sync pull fetch split stream-9 681 719 L176 CXER5053]
  [; ── stream 9 (distributed_store §5, L176 — #719 items 4+5): the
     pull/fetch split, on the record. PULL = FETCH + per-ref
     reconciliation: the first pull moves objects + doc-refs AND
     fast-forwards the alias plane (the composed [pull-result ok=
     [heads …] [reconcile-report …]] — head-set-bearing, never a bare
     counter). Under divergence the ENFORCING pull raises CXER5053
     carrying the [conflict] (its fetch half already landed — partial
     success is the design); pull-report answers the same composition as
     data (ok=false). FETCH stays the immutable-plane verb (objects +
     doc-refs only, heads-bearing). A transferred doc is a LIVE insert:
     it feeds the E3 docs stream exactly like a local put (docs pos
     counts pulled + fetched + local docs — a changes-since consumer
     over a synced store sees every landed doc).]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let
[= $a [$store:open "mem://pl-a"]]
[= $b [$store:open "mem://pl-b"]]
[= $d1 [$store:put-doc $a [order [id 1]]]]
[= $x1 [$store:set-alias $a "head" $d1]]
[= $p1 [$store:pull $b $a]]
[= $t [$store:get-alias $b "head"]]
[= $d2 [$store:put-doc $a [order [id 1] [line "x"]]]]
[= $x2 [$store:set-alias $a "head" $d2]]
[= $d4 [$store:put-doc $b [order [id 1] [note "n"]]]]
[= $x5 [$store:set-alias $b "head" $d4]]
[= $div [?fallback [$store:pull $b $a] [recover-with [context] [refused [code $err@code] [$count $err/*]]]]]
[= $rep [$store:pull-report $b $a]]
[= $f [$store:fetch $b $a]]
  [probe [first-pull $p1] [ff-target [$eq $t $d1]] [diverged $div] [report-ok $rep/@ok] [fetch $f]]]
#]]
  [out-text [#
[probe [first-pull [pull-result objects=5 refs=1 ok=true [heads [stream name='aliases/head' pos=1 hash='sha2-256:59f4fc9c5c13e45e4f86a3c3b89087184d8cb442c919adb6e633c376061cc056'] [stream name=docs pos=1]] [reconcile-report ok=true refs=1 identical=0 advanced=1 ahead=0 conflicts=0 [advance name=head from='' to='sha2-256:59f4fc9c5c13e45e4f86a3c3b89087184d8cb442c919adb6e633c376061cc056']]]] [ff-target true] [diverged [refused [code 'cx-err:CXER5053'] 1]] [report-ok false] [fetch [fetch-result objects=0 refs=2 [heads [stream name='aliases/head' pos=2 hash='sha2-256:23b6269f0ab5dd75c6d6ddffe3bd5d50b7a6604ec8758870bac69c09c5942a0c'] [stream name=docs pos=3]]]]]
#]]
 ]

 [case id=store-status-003-peer-ahead-behind level=core gate=enforced
  [tags store sync status ahead-behind peer stream-9 681 719 L177]
  [; ── stream 9 (L177 — #719 item 1 complete): status opts.peer engages
     the ahead/behind classification — the DRY reconcile examination
     (nothing applied) against a peer handle. Per branch-class alias
     stream: :identical / :ahead (ours moved past the common base) /
     :behind (the fast-forward case) / :diverged (both moved), with each
     side's OWN dense E3 position (positions are local coordinates —
     the CLASSIFICATION is the cross-store fact; a staleness scalar is
     ruled insufficient, the per-stream HEAD-SET is the answer).]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let
[= $a [$store:open "mem://st3-a"]]
[= $b [$store:open "mem://st3-b"]]
[= $d1 [$store:put-doc $a [order [id 1]]]]
[= $d1b [$store:put-doc $b [order [id 1]]]]
[= $x1 [$store:set-alias $a "main" $d1]]
[= $x2 [$store:set-alias $b "main" $d1]]
[= $d2 [$store:put-doc $a [order [id 1] [line "x"]]]]
[= $x3 [$store:set-alias $a "main" $d2]]
[= $d4 [$store:put-doc $b [order [id 2]]]]
[= $x4 [$store:set-alias $b "extra" $d4]]
[= $d5 [$store:put-doc $b [order [id 1] [note "n"]]]]
[= $x5 [$store:set-alias $b "boat" $d1]]
[= $x6 [$store:set-alias $a "boat" $d1]]
[= $x7 [$store:set-alias $b "boat" $d5]]
[= $x8 [$store:set-alias $a "boat" $d2]]
[= $st [$store:status $b {peer: $a}]]
  [probe [status $st]]]
#]]
  [out-text [#
[probe [status [status backend=mem docs=3 objects=13 logical=16 distinct=13 unflushed=3 [heads [stream name='aliases/boat' pos=2 hash='sha2-256:23b6269f0ab5dd75c6d6ddffe3bd5d50b7a6604ec8758870bac69c09c5942a0c'] [stream name='aliases/extra' pos=1 hash='sha2-256:3c8f5f782a4735fa4313e262e55a07755f13c89fb663775914f748c5ed7d1f75'] [stream name='aliases/main' pos=1 hash='sha2-256:59f4fc9c5c13e45e4f86a3c3b89087184d8cb442c919adb6e633c376061cc056'] [stream name=docs pos=3]] [peer url='mem://st3-a' identical=0 ahead=1 behind=1 diverged=1 [stream name='aliases/boat' state=:diverged ours-pos=2 theirs-pos=2] [stream name='aliases/extra' state=:ahead ours-pos=1 theirs-pos=0] [stream name='aliases/main' state=:behind ours-pos=1 theirs-pos=2]]]]]
#]]
 ]

 [case id=store-replica-001-declaration-profile level=core gate=enforced
  [tags store sync replica consistency declaration stream-9 681 L177 M8 CXER4990]
  [; ── stream 9 (audit M8 — stream 7's replica profile, received): a
     handle opened with replica: "true" is a REPLICA surface whose
     guarantee advert is the replica set — it CAN declare
     :prefix-consistent (chain-checkable), :at-seq-pinned (up to the
     synced head), and :monotonic-reads; it MUST refuse
     :read-your-writes and :linearizable-ref (offline ref advance is
     exactly where the conflict values land). The refusals are
     WIRING-TIME (CXER4990 at open — never a runtime surprise); the
     accepted floor echoes on the handle.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let
[= $refused [?fallback [$store:open-opts "mem://rep-1" {replica: "true" consistency: (:read-your-writes)}] [recover-with [context] [code $err@code]]]]
[= $refused2 [?fallback [$store:open-opts "mem://rep-1" {replica: "true" consistency: (:linearizable-ref)}] [recover-with [context] [code $err@code]]]]
[= $ok [$store:open-opts "mem://rep-2" {replica: "true" consistency: (:prefix-consistent, :at-seq-pinned, :monotonic-reads)}]]
  [probe [ryw $refused] [linref $refused2] [profile $ok@consistency]]]
#]]
  [out-text [#
[probe [ryw [code 'cx-err:CXER4990']] [linref [code 'cx-err:CXER4990']] [profile ':prefix-consistent :at-seq-pinned :monotonic-reads']]
#]]
 ]

