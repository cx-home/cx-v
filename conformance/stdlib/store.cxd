[?let [= $s [$store:open "mem://"]] [?let [= $h1 [$store:put-doc $s [doc [item "hello"]]]] [?let [= $h2 [$store:put-doc $s [doc [item "hello"]]]] [$store:list-docs $s]]]]
#]]
  [out-text [#
('01699895b66541c3d480d15af00e3ef54bbc723378919018101dc57bed4b00f9')
#]]
 ]

