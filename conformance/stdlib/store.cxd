 [case id=store-035-planar-query-authz-permit level=core grant='eval'
  [tags store query planar quoted authz permit l99 stream-2]
  [; the AUTHZ-SLICE layer, permit lane: a delegation of `read` over the
     extracted slice admits the query; the relation flows. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/authz']
[?let [= $s [$store:open "mem://pq35"]]
  [= $h [$store:put-doc $s [order id=1]]]
  [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-q1 [tenant acme] [from [principal dana]] [to [agent q-runner]]
      [capabilities [read]] [over '//order'] [assurance :t1] [signature sig-dana]]]]
  [$store:query $s [?quote [?for [in $o [$store:source $s "//order"]] [yield $o]]]
    opts={authz: $az, actor: [agent q-runner], tenant: 'acme'}]]
#]]
  [out-text [#
([order id=1])
#]]
 ]

