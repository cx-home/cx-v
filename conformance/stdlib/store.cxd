[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://flatq"]] [= $h1 [$store:put-doc $s [users [user name=al] [user name=bo]]]] [= $h2 [$store:put-doc $s [root [user name=cy]]]] [$store:query $s "//user"]]
#]]
  [out-text [#
([result doc='sha2-256:49b5b783474fc557326738a6e15aef98585b573e195006bb24577ec9fce2b092' source='mem://flatq#//user' [user name=al]], [result doc='sha2-256:49b5b783474fc557326738a6e15aef98585b573e195006bb24577ec9fce2b092' source='mem://flatq#//user' [user name=bo]], [result doc='sha2-256:419ece31678d2867eea20972a9f7c6eeb676a9d928cedb0dcc78e38a2a8201ab' source='mem://flatq#//user' [user name=cy]])
#]]
 ]

 [case id=store-022-query-multi-segment-path level=core
  [tags store query mem cxpath multiseg document-node]
  [; multi-segment name paths walk STEPWISE from the DOCUMENT node (#768):
     /rec/meta/src anchors at the root (named rec) then walks children;
     //meta/src = src children of meta elements at any depth; /meta/src is
     EMPTY (the root is rec, not meta — absolute paths address the root,
     never silently its children). The pre-fix engine matched the LAST
     segment's name only ([src stray] answered /meta/src). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://mseg"]] [= $h1 [$store:put-doc $s [rec [meta [src alpha]] [src stray]]]] ([$store:query $s "/rec/meta/src"], [$store:query $s "//meta/src"], [$count [$store:query $s "/meta/src"]])]
#]]
  [out-text [#
(([result doc='sha2-256:06dbe1d2eacc5dc2adb09d0d0451b62727a38a36eb9e96431cf381716a6adfec' source='mem://mseg#/rec/meta/src' [src 'alpha']]), ([result doc='sha2-256:06dbe1d2eacc5dc2adb09d0d0451b62727a38a36eb9e96431cf381716a6adfec' source='mem://mseg#//meta/src' [src 'alpha']]), 0)
#]]
 ]

 [case id=store-025-query-per-entity-root level=core
  [tags store query source mem cxpath document-node planar]
  [; document-node anchoring (#768): a per-entity document — the root IS the
     entity — is queryable by name: //order matches each [order …] root
     (descendant-or-self includes the root), /order selects it absolutely,
     and [$store:source] scans it as a planar generator source with no
     wrapping convention. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://ent"]] [= $h1 [$store:put-doc $s [order sku=a [line qty=2]]]] [= $h2 [$store:put-doc $s [order sku=b [line qty=1]]]] ([$count [$store:query $s "//order"]], [$count [$store:query $s "/order"]], [$store:source $s "//order/line"])]
#]]
  [out-text [#
(2, 2, ([line qty=2], [line qty=1]))
#]]
 ]

 [case id=store-023-source-payload-scan level=core
  [tags store source mem cxpath planar l97]
  [; [$store:source] = the same CXPath scan as query, returning the matched
     VALUES only (the tuples' payloads, same order, no provenance wrapper) —
     THE store-side generator source form for planar comprehensions
     (code.md 7.8; backs the fn-doc example verbatim). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://src"]] [= $h1 [$store:put-doc $s [orders [order sku=a total=5] [order sku=b total=7]]]] [$store:source $s "//order"]]
#]]
  [out-text [#
([order sku=a total=5], [order sku=b total=7])
#]]
 ]

 [case id=store-024-source-planar-revenue-by-region level=core
  [tags store source mem planar m5 group-by aggregate l97 document-node]
  [; the ruled M5 worked example (planar_algebra.md) LIVE over a real store:
     a planar comprehension whose generator scans [$store:source], joined by
     correlated unnest ($o/line), grouped by a navigated key, aggregated with
     $sum over $group — east = 2*10+1*5+4*25 = 125, west = 12. The docs are
     NATURAL per-entity roots ([order …] IS the doc) — queryable by name
     under document-node anchoring (#768), no wrapping convention. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://m5"]]
  [= $h1 [$store:put-doc $s [order [line qty=2 price=10] [line qty=1 price=5] [customer region=east]]]]
  [= $h2 [$store:put-doc $s [order [line qty=4 price=25] [customer region=east]]]]
  [= $h3 [$store:put-doc $s [order [line qty=1 price=12] [customer region=west]]]]
  [?for [in $o [$store:source $s "//order"]] [in $l $o/line]
    [= $r [* $l@qty $l@price]]
    [group-by $o/customer/@region]
    [yield [row region=$key revenue=[$sum $group/r]]]]]
#]]
  [out-text [#
[row region=east revenue=125]
[row region=west revenue=12]
#]]
 ]

 [; ── Quoted planar queries (stream-2 L99, store.md §6.2): [$store:query]
    accepts a QUOTED planar comprehension — membership-gated (CXER0120),
    executed by the sandboxed [?eval] under the narrowed cap set (the
    `eval` grant is the host-capability layer), authorize-before-execute
    over the statically extracted slice set. The corpus membership
    negatives land HERE (the ruled entry-5 sequencing, W6 half). ── ]
 [case id=store-026-planar-query-quoted-m5 level=core grant='eval'
  [tags store query planar quoted m5 l99 stream-2]
  [; the ruled M5 revenue example through the LIVE quoted-query verb —
     same store, same ruled numbers as store-024, but the comprehension
     arrives as a value and executes in the L99 sandbox. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?let [= $s [$store:open "mem://pq26"]]
  [= $h1 [$store:put-doc $s [order [line qty=2 price=10] [line qty=1 price=5] [customer region=east]]]]
  [= $h2 [$store:put-doc $s [order [line qty=4 price=25] [customer region=east]]]]
  [= $h3 [$store:put-doc $s [order [line qty=1 price=12] [customer region=west]]]]
  [$store:query $s [?quote [?for [in $o [$store:source $s "//order"]] [in $l $o/line]
    [= $r [* $l@qty $l@price]]
    [group-by $o/customer/@region]
    [yield [row region=$key revenue=[$sum $group/r]]]]]]]
#]]
  [out-text [#
([row region=east revenue=125], [row region=west revenue=12])
#]]
 ]

