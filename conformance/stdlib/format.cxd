[test-suite name=format
  [doc [#
conformance fixtures for cx-stdlib/format (spec/std-lib/format.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/format']
   (resolver MUST be quoted) then calls [$format:fn args]. The LAST
   expression is the rendered result.

   The test renderer wraps a string scalar result in double quotes, so a
   function that returns canonical text [a 1] renders as "[a 1]" (the
   whole string quoted). Comparison is whitespace-normalised token-by-
   token, so multi-line pretty output compares by token sequence (indent
   and newlines collapse). Error fixtures use --- out_err with the bare
   CXER code.
#]]

 [case id=format-001-canonical-element level=core
  [tags format canonical]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:canonical [user [name "x"]]]
#]]
  [out-text [#
"[user [name 'x']]"
#]]
 ]

 [case id=format-002-canonical-scalar-int level=core
  [tags format canonical scalar]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:canonical 42]
#]]
  [out-text [#
'42'
#]]
 ]

 [case id=format-003-canonical-scalar-bool level=core
  [tags format canonical scalar bool]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:canonical true]
#]]
  [out-text [#
'true'
#]]
 ]

 [case id=format-004-canonical-sequence level=core
  [tags format canonical sequence]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:canonical (1, 2, 3)]
#]]
  [out-text [#
'(1, 2, 3)'
#]]
 ]

 [case id=format-005-canonical-attrs-order-preserved level=core
  [tags format canonical attributes order]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:canonical [user role="admin" id="7"]]
#]]
  [out-text [#
"[user role=admin id='7']"
#]]
 ]

 [case id=format-006-compact-nested level=core
  [tags format compact]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:compact [a [b [c]]]]
#]]
  [out-text [#
'[a [b [c]]]'
#]]
 ]

 [case id=format-007-compact-equals-canonical level=core
  [tags format compact canonical single-source]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[$format:compact [list [item "a"] [item "b"]]]
#]]
  [out-text [#
"[list [item 'a'] [item 'b']]"
#]]
 ]

