 [; ─────────────────────────────────────────────────────────────────
    #978 (RULED: CO-3) — round-trip fidelity, spec §2.1.

    026-029 pin `parse(format(v)) ≡ v` for EACH formatter form over one
    witness carrying string / int / decimal / bool / atom in BOTH
    attribute and body-scalar position.

    They compare the CANONICAL IMAGES of the two sides rather than the
    values themselves, and that is load-bearing: `[$eq]` atomizes a
    decimal or atom ATTRIBUTE against its string spelling — `[$eq [u
    a=1.5] [u a="1.5"]]` and `[$eq [u a=:ops] [u a="ops"]]` are both
    `true` — so a value-level comparison passes VACUOUSLY on exactly the
    two kinds these pins exist to catch. Canonical text is type-faithful
    (`a=1.5` vs `a='1.5'`, `a=:ops` vs `a=ops`), so comparing images
    discriminates. Red-proven: before the fix 026 and 029 were `false`.

    The witness lists its attributes already in alphabetical order so
    diff-friendly (which sorts) compares against the same canonical
    image as the order-preserving forms.
    ───────────────────────────────────────────────────────────────── ]

 [case id=format-026-round-trip-pretty-typed-scalars level=core
  [tags format pretty round-trip types 978]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[?let [= $w [user active=true age=41 name=alice role="ops lead" score=1.5 tier=:gold [s "text"] [i 7] [d 2.50] [b false] [a :ok]]]
  [$eq [$format:canonical [$cx:parse [$format:pretty $w]]] [$format:canonical $w]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=format-027-round-trip-canonical-typed-scalars level=core
  [tags format canonical round-trip types 978]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[?let [= $w [user active=true age=41 name=alice role="ops lead" score=1.5 tier=:gold [s "text"] [i 7] [d 2.50] [b false] [a :ok]]]
  [$eq [$format:canonical [$cx:parse [$format:canonical $w]]] [$format:canonical $w]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=format-028-round-trip-compact-typed-scalars level=core
  [tags format compact round-trip types 978]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[?let [= $w [user active=true age=41 name=alice role="ops lead" score=1.5 tier=:gold [s "text"] [i 7] [d 2.50] [b false] [a :ok]]]
  [$eq [$format:canonical [$cx:parse [$format:compact $w]]] [$format:canonical $w]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=format-029-round-trip-diff-friendly-typed-scalars level=core
  [tags format diff-friendly round-trip types 978]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/format']
[?let [= $w [user active=true age=41 name=alice role="ops lead" score=1.5 tier=:gold [s "text"] [i 7] [d 2.50] [b false] [a :ok]]]
  [$eq [$format:canonical [$cx:parse [$format:diff-friendly $w]]] [$format:canonical $w]]]
