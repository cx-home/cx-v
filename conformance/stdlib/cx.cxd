cx-err:CXER4115
#]]
 ]

 [case id=cx-155-pretty-print-fits-one-line level=core
  [tags cx pretty-print layout issue-940 vc-6]
  [meta [#
note: §2.3 defaults — indent 2, max-line-length 80. A value whose compact
note: form fits the budget stays on one line.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:pretty-print "[root [a one] [b two]]"]
#]]
  [out-text [#
'[root [a one] [b two]]'
#]]
 ]

