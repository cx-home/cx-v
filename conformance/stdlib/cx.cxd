  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $doc [users [user name="ada"] [user name="bob"]]] [$eq [$count [$cx:select $doc "//user"]] [$count $doc//user]]]
#]]
  [out-text [#
true
#]]
 ]

