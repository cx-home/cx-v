 [case id=cx-121-serialize-canonical-byte-identity level=core
  [tags cx serialize canonical roundtrip issue-807]
  [meta [#
note: #807(f) / I5 audit AF-3 — the §4 identity serialize∘parse ≡
note: canonical is BYTE-true, trailing LF included. The pre-fix
note: cx-010..012 masked the missing LF with a [$concat … "\n"]
note: wrapper (repaired in the same landing); this case pins the
note: identity with NO mask, on a multi-node body whose canonical
note: form also exercises attr ordering + child indentation.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t "[cfg [db host='h' port=5432] [flags on true]]"] [$eq [$cx:serialize [$cx:parse $t]] [$cx:canonical $t]]]
#]]
  [out-text [#
true
#]]
 ]
