  [in-cx [#
[empty]
#]]
  [in-code [#
[$eq [$cx:hash [cfg [a 1] [b 2]]] [$cx:hash [cfg [a 1] [b 2]]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-027-equal-true level=core
  [tags cx equal]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:equal [a 1] [a 1]]
#]]
