 [case id=cx-108-computation-id-injectivity level=core
  [tags cx computation-id tier2 injectivity stream-2 769]
  [meta [#
note: #769 (RULED (a) 2026-08-10) — fields that distinguish
note: computations are IN the Tier-2 stream: slice bounds, pattern-attr
note: comparison values and type-test names, and predicate attr KIND
note: (existence vs absence). Each pair below collided on the pre-fix
note: encoding (false computation-identity merges, verified live).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[probe
 [slice-bounds [$eq [$cx:computation-id '[?def f ($x) $x[0:2]]']
                    [$cx:computation-id '[?def f ($x) $x[1:4]]']]]
 [attr-value [$eq [$cx:computation-id '[?def f ($d) [?match $d [case [user @role="admin"] 1] [else 0]]]']
                  [$cx:computation-id '[?def f ($d) [?match $d [case [user @role="guest"] 1] [else 0]]]']]]
 [attr-type-test [$eq [$cx:computation-id '[?def f ($d) [?match $d [case [user @role::str] 1] [else 0]]]']
                      [$cx:computation-id '[?def f ($d) [?match $d [case [user @role::int] 1] [else 0]]]']]]
 [pred-existence-absence [$eq [$cx:computation-id '[?def f ($d) $d//x[@k]]']
                              [$cx:computation-id '[?def f ($d) $d//x[@!k]]']]]
 [alpha-slice-still-collides [$eq [$cx:computation-id '[?def f ($x $a $b) $x[$a:$b]]']
                                  [$cx:computation-id '[?def f ($y $p $q) $y[$p:$q]]']]]]
#]]
  [out-text [#
[probe [slice-bounds false] [attr-value false] [attr-type-test false] [pred-existence-absence false] [alpha-slice-still-collides true]]
#]]
 ]

 [case id=cx-111-computation-id-injectivity-audit level=core
  [tags cx computation-id tier2 injectivity stream-2 769 audit]
  [meta [#
note: the W7 adversarial audit found five more #769-class holes (same
note: ruled class): order-by DIRECTION, duration + period payloads
note: (dur_val, not str_val), map-pattern typed binds, and sequence
note: rest-captures — each pair collided on the pre-audit encoding.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[probe
 [direction [$eq [$cx:computation-id '[?def f ($s) [?for [in $o $s] [order-by $o/k asc] [yield $o]]]']
                 [$cx:computation-id '[?def f ($s) [?for [in $o $s] [order-by $o/k desc] [yield $o]]]']]]
 [duration [$eq [$cx:computation-id '[?def f () 100ms]'] [$cx:computation-id '[?def f () 200ms]']]]
 [period [$eq [$cx:computation-id '[?def f () 1mo]'] [$cx:computation-id '[?def f () 2mo]']]]
 [typed-bind [$eq [$cx:computation-id '[?def f ($d) [?match $d [case {k: $v::int} $v] [else 0]]]']
                  [$cx:computation-id '[?def f ($d) [?match $d [case {k: $v::str} $v] [else 0]]]']]]
 [rest-capture [$eq [$cx:computation-id '[?def f ($d) [?match $d [case ($x, *$r) $r] [else 0]]]']
                    [$cx:computation-id '[?def f ($d) [?match $d [case ($x, $r) $r] [else 0]]]']]]]
#]]
  [out-text [#
[probe [direction false] [duration false] [period false] [typed-bind false] [rest-capture false]]
#]]
 ]

