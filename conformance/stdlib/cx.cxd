 [case id=cx-117-version-pure-semver level=core
  [tags cx version environment L103 stream-5]
  [; L103 — [$cx:version] is the PURE runtime-version builtin (a constant
     of the evaluation: full semver derived from the cx_version build
     define / repo-root VERSION; test builds default 0.0.0-dev). Shape
     asserted, not the value — fixtures run on every build. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[r [$contains [$cx:version] '.'] [$eq [$cx:version] [$cx:version]]]
#]]
  [out-text [#
[r true true]
#]]
 ]

 [case id=cx-118-env-canonical-value level=core
  [tags cx env environment canonical L103 stream-5]
  [; L103 — [$cx:env] is the canonical environment CX value of the
     computation record: {builtins:, runtime:, schema-dialect:} (map =
     self-canonicalizing). runtime == [$cx:version]; builtins = a plain
     Tier-1 address; schema-dialect = the S020-enforced dialect semver. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $e [$cx:env]]
[r [$eq $e/runtime [$cx:version]]
   [$starts-with $e/builtins 'sha2-256:']
   [$eq $e/schema-dialect '0.8']]]
#]]
  [out-text [#
[r true true true]
#]]
 ]

 [case id=cx-120-tape-composed-identity level=core
  [tags cx computation tape identity composition L107 stream-5]
  [; L107 — a witnessed impure computation is hash(fn, inputs UNION
     {tape}, env, caps): the tape is an ORDINARY Tier-1-addressed input
     (composition, not a new axis — the record shape is unchanged).
     Adding the tape input moves the address; the same tape address
     composes reproducibly; and the tape-bearing record still hashes
     through the plain Tier-1 path (no new prefix, no registry row). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let
 [= $tape [$cx:hash '[cx-trace version=1 [seed clock=0 rng=7] [event step=1 effect=receive [result 42]]]']]
 [= $mk [?fn $extra {computation: {fn: {code: 'computes-as:sha2-256:ab', source: 'sha2-256:cd'}, inputs: [?if [$eq $extra ''] [then {x: 'sha2-256:ef'}] [else {tape: $extra, x: 'sha2-256:ef'}]], env: {runtime: '1.0.0'}, caps: {}}}]]
 [r [$starts-with $tape 'sha2-256:']
    [$eq [$cx:hash [$mk $tape]] [$cx:hash [$mk $tape]]]
    [$eq [$cx:hash [$mk $tape]] [$cx:hash [$mk '']]]]]
#]]
  [out-text [#
[r true true false]
#]]
 ]

 [case id=cx-119-builtins-rehash-verifies level=core
