 [case id=cx-130-eval-pure-def-refused level=core grant='eval'
  [tags cx eval purity issue-940 vc-6]
  [meta [#
note: §3 — cx:eval is impure, so the purity classifier refuses a pure
note: [?def] body that reaches it.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def f pure () [$cx:eval "1" {}]]
[$f]
#]]
  [out-err [#
cx-err:CXER0233
#]]
 ]

 [case id=cx-131-render-serializes-eval-result level=core grant='eval'
  [tags cx render eval serialize issue-940 vc-6]
  [meta [#
note: §2.2 — cx:render is sugar for cx:serialize(cx:eval(t, ctx)), so the
note: result carries serialize's trailing LF (the §4 byte identity).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:render "[greeting $who]" {who: 'world'}]
#]]
  [out-text [#
'[greeting world]\n'
#]]
 ]

 [case id=cx-132-render-shares-eval-depth-budget level=core grant='eval'
  [tags cx render eval depth issue-940 vc-6]
  [meta [#
note: §3.3 — "the counter increments on each cx:eval invocation INCLUDING
note: indirect invocation through cx:render". The render consumes depth 1,
note: so the nested eval capped at 1 refuses.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:render "[$cx:eval '1' {} {max-depth: 1}]" {}]
#]]
  [out-err [#
cx-err:CXER4114
#]]
 ]

 [case id=cx-133-render-capability-denied level=core
  [tags cx render capability denial issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:render "[a 1]" {}]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [case id=cx-134-render-pure-def-refused level=core grant='eval'
  [tags cx render purity issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def g pure () [$cx:render "1" {}]]
[$g]
#]]
  [out-err [#
cx-err:CXER0233
#]]
 ]

 [case id=cx-160-eval-context-not-optional level=core grant='eval'
  [tags cx eval arity signature issue-940 vc-6]
  [meta [#
note: §2.2 defaults only $opts (`=$nil`). $context is REQUIRED for cx:eval
note: and OPTIONAL for cx:eval-tree — the spec draws that distinction
note: deliberately, so a one-argument cx:eval refuses rather than quietly
note: evaluating against an empty context.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:eval "1"]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=cx-161-render-arity-exact level=core grant='eval'
  [tags cx render arity signature issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:render "[a 1]"]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=cx-135-validate-clean-empty-sequence level=core
  [tags cx validate schema issue-940 vc-6]
  [meta [#
note: §2.2 types the return [sequence any]; an EMPTY sequence is "valid".
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:validate "[person name=ann]" "[schema of=person version='0.8'] [type person [attr name :type=string]]"]
#]]
  [out-text [#
()
#]]
 ]

 [case id=cx-136-validate-violation-item level=core
  [tags cx validate schema violation issue-940 vc-6]
  [meta [#
note: the item is the SAME [violation …] value validate-against puts inside
note: its [invalid …] result — one violation vocabulary, not a second shape.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:validate "[person name=ann]" "[schema of=person version='0.8'] [type person [attr age :type=int :required=true]]"]
#]]
  [out-text [#
([violation code=S002 path='' message="missing required attribute 'age' on <person>"])
#]]
 ]

 [case id=cx-137-validate-schema-load-diagnostic level=core
  [tags cx validate schema load-failure issue-940 vc-6]
  [meta [#
note: schema.md §10.1 surfaces schema-LOAD failure as a diagnostic inside
note: the report, so it arrives as a violation item like any other rather
note: than as an err — one uniform way to read the outcome.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:validate "[person name=ann]" "[not a schema"]
#]]
  [out-text [#
([violation code=S009 path='' message="schema parse failure: 1:15: expected ']' got EOF (cx-err:CXER0100)"])
#]]
 ]

 [case id=cx-138-anchors-document-order level=core
  [tags cx anchors cxdm identity issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:anchors "[root [a &one x] [b &two y] [c z]]"]
#]]
  [out-text [#
(one, two)
#]]
 ]

 [case id=cx-139-anchors-none-empty-sequence level=core
  [tags cx anchors empty issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:anchors "[root [a x]]"]
#]]
  [out-text [#
()
#]]
 ]

