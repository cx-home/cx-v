 [case id=cx-017-serialize-sequence-body-no-marker-leak level=core
  [tags cx serialize sequence element issue-564 parsed-lane]
  [; R-A1 migration: PIVOTED TO THE PARSED LANE (2026-08-25). This case pins
     that an element whose body IS a sequence serializes as a paren sequence
     with NO __cx_seq__ marker leak. Under R-A1 (#847-1a) the RUNTIME
     construction that used to produce that value — [?element "rows" (…)] —
     is refused at eval, so the shape is unconstructible at runtime; the
     PARSED shape still exists, so the same document now arrives via
     [$cx:parse] of paren-seq-body source text and the original
     serialize/no-marker-leak assertion is kept verbatim against it. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:serialize [$cx:parse "[rows ([row id=a], [row id=b])]"]]
#]]
  [out-text [#
'[rows ([row id=a], [row id=b])]\n'
#]]
 ]

 [case id=cx-018-serialize-anon-wrapper-body-is-sequence level=core
  [tags cx serialize sequence for-comprehension issue-566 parsed-lane round-trip]
  [; R-A1 migration: PIVOTED TO THE PARSED LANE (2026-08-25). The original
     built the sequence body from a [?for] comprehension result and pinned
     its serialization; R-A1 (#847-1a) refuses that runtime construction, so
     the wrapper-with-sequence-body value now arrives via [$cx:parse] of
     paren-seq-body source text. The no-marker-leak assertion is kept intact
     (the exact serialized image is still the pinned second member), and the
     case is distinguished from cx-017 by additionally pinning that the image
     is STABLE under re-parse — a leaked __cx_seq__ marker could not survive
     that round trip silently. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[rows ([row id=a], [row id=b])]"]] [= $s [$cx:serialize $t]] ([$eq $s [$cx:serialize [$cx:parse $s]]], $s)]
#]]
  [out-text [#
(true, '[rows ([row id=a], [row id=b])]\n')
#]]
 ]

