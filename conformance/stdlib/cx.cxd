#]]
  [out-text [#
'c2de3721009da3ce799e831e8c1293f6c7c47033bca422657fc3693d79ae82b5'
#]]
 ]

 [case id=cx-025-hash-value-and-source-agree level=core
  [tags cx hash canonical]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$eq [$cx:hash "[a   1]"] [$cx:hash [a 1]]]
#]]
  [out-text [#
true
#]]
 ]

