#]]
 ]

 [case id=cx-029-equal-anchor-resolving level=core
  [tags cx equal anchors canonical]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:equal "[x [a &n 1] [b [*n]]]" "[x [a 1] [b [a 1]]]"]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-040-diff-identical-is-empty level=core
  [tags cx diff]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $d [$cx:diff [a 1] [a 1]]] [$count $d/change]]
#]]
  [out-text [#
0
#]]
 ]

 [case id=cx-041-diff-attr-record-shape level=core
  [tags cx diff record navigable]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:diff [users [user name="ada" age=30]] [users [user name="ada" age=31]]]
#]]
  [out-text [#
[diff [change kind=attribute-changed path='/users/user/@age' before='30' after='31' payload=attr [before [v age=30]] [after [v age=31]]]]
#]]
 ]

 [case id=cx-042-patch-attr-and-add level=core
  [tags cx diff patch roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [users [user name="ada" age=30] [user name="bob"]]] [= $b [users [user name="ada" age=31] [user name="bob"] [user name="eve"]]] [= $d [$cx:diff $a $b]] [$cx:equal [$cx:patch $a $d] $b]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-043-patch-body-remove-rename level=core
  [tags cx diff patch roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [doc [t 'hello'] [items [i 1] [i 2] [i 3] [i 4]] [old [x 1] [y 2]]]] [= $b [doc [t 'world'] [items [i 1] [i 9]] [new [x 5] [y 2]]]] [= $d [$cx:diff $a $b]] [$cx:equal [$cx:patch $a $d] $b]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-044-patch-table-payload level=core
  [tags cx diff patch table issue-445]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [$cx:parse "[users [table[name age::int]]
  ada 30
  bob 25
]"]] [= $b [$cx:parse "[users [table[name age::int]]
  ada 31
  bob 25
  eve 22
]"]] [= $d [$cx:diff $a $b]] [$cx:equal [$cx:patch $a $d] $b]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-045-patch-idempotent-repatch level=core
  [tags cx patch idempotent]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [a 1]] [= $b [a 2]] [= $d [$cx:diff $a $b]] [$cx:equal [$cx:patch [$cx:patch $a $d] $d] $b]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-046-patch-wrong-base-fails-loud level=core
  [tags cx patch error]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $d [$cx:diff [a 1] [a 2]]] [$cx:patch [a 5] $d]]
#]]
  [out-err [#
CXER4102
#]]
 ]

 [case id=cx-047-patch-rejects-non-diff level=core
  [tags cx patch error]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:patch [a 1] [nope]]
#]]
  [out-err [#
CXER4102
#]]
 ]

