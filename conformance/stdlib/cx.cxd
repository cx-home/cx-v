 [# ── I1 row 14 (E1 totality, audit C4): identity acquisition REFUSES
       the three value classes with typed errors — no silent fallback,
       no coercion. Closures were already fail-closed (CXER4101, now
       normative); iterators refuse (CXER4117 — consumption-state
       identity; materialize deliberately and hash the value); a
       secret-bearing value has NO Tier-1 address (CXER4118). ── #]
 [case id=cx-033-hash-refuses-closures level=core
  [tags cx hash totality closure e1 i1]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $f [?fn ($x) $x]] [$cx:hash $f]]
#]]
  [out-err [#
cx-err:CXER4101
#]]
 ]

 [case id=cx-034-hash-refuses-iterators level=core
  [tags cx hash totality iterator e1 i1]
  [; A genuine LAZY iterator ([?take] over [$iterate] stays an
     IteratorNode; a bounded [$range lo hi] is already an eager
     Sequence and hashes normally). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $i [?take 3 [$iterate [?fn ($x) [+ $x 1]] 0]]] [$cx:hash $i]]
#]]
  [out-err [#
cx-err:CXER4117
#]]
 ]

