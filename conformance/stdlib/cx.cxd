 [case id=cx-048-merge-policies-and-conflict-values level=core gate=enforced
  [tags cx merge conflict stream-9 719 CXER4110]
  [; ── cx:merge (modules/cx.md §2.3; #719 item 3 — the conflict posture
     ALIGNED to values, stream 9): elements of the same name deep-merge —
     attrs union (a value collision is one policy point), children pair by
     name and merge recursively, unpaired children keep source order;
     maps union per-key. last-wins (default) takes b's side at each policy
     point, first-wins takes a's. error-on-conflict raises CXER4110 whose
     err CARRIES each collision as the typed [conflict subject=<path>
     kind=:merge-value [ours …] [theirs …]] child — the ONE conflict
     shape, never a bare message.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/cx']
[?let
[= $a [order id="o-1" status="open" [customer [name "Dana"]] [line sku="x" qty=1]]]
[= $b [order id="o-1" status="paid" [customer [name "Dana"]] [note "rush"]]]
[= $last [$cx:merge $a $b]]
[= $first [$cx:merge $a $b "first-wins"]]
[= $conf [?fallback [$cx:merge $a $b "error-on-conflict"] [recover-with [context] [refused [code $err@code] [$count $err/*] [$first $err/*]]]]]
[= $maps [$cx:merge {a: 1 b: {x: 1}} {b: {x: 2 y: 3} c: 4}]]
  [probe [last $last] [first $first] [conflicted $conf] [maps $maps]]]
#]]
  [out-text [#
[probe [last [order id=o-1 status=paid [customer [name 'Dana']] [line sku=x qty=1] [note 'rush']]] [first [order id=o-1 status=open [customer [name 'Dana']] [line sku=x qty=1] [note 'rush']]] [conflicted [refused [code 'cx-err:CXER4110'] 1 [conflict subject='/order/@status' kind=:merge-value [ours 'open'] [theirs 'paid']]]] [maps {a: 1, b: {x: 2, y: 3}, c: 4}]]
#]]
 ]

