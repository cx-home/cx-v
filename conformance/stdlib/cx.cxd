 [case id=cx-142-references-idref-record level=core
  [tags cx references idref map issue-940 vc-6]
  [meta [#
note: §2.2 types the item `map` without naming keys; the record is
note: {attr, kind, path, ref, resolved} in canonical (sorted) key order,
note: `path` in the same /root/child[2] spelling cx:diff / cx:patch use.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:references "[root [a #one x] [b to=@one y]]"]
#]]
  [out-text [#
({attr: to, kind: idref, path: '/root/b', ref: one, resolved: true})
#]]
 ]

 [case id=cx-143-references-none-empty-sequence level=core
  [tags cx references empty issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:references "[root [a x]]"]
#]]
  [out-text [#
()
#]]
 ]

 [case id=cx-144-references-anchor-namespace-forms level=core
  [tags cx references anchor alias merge issue-940 vc-6]
  [meta [#
note: cxdm.md §4's two namespaces are disjoint — MergeRef (*name on a head,
note: grammar [61]) and AliasElement ([*name], [62]) resolve against the
note: ANCHOR table, not the ID table.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:references "[root [defaults &def timeout=30] [use *def] [also [*def]]]"]
#]]
  [out-text [#
({attr: '', kind: merge, path: '/root/use', ref: def, resolved: true}, {attr: '', kind: alias, path: '/root/also', ref: def, resolved: true})
#]]
 ]

 [case id=cx-145-resolve-includes-splices level=core grant='read write' packs=io
  [tags cx resolve-includes include splice granted effort-b issue-940 vc-6]
  [meta [#
note: hermetic — io's own temp-dir is the include root, so the case is
note: self-contained and the root is EXPLICIT (§3.1: no ambient cwd).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?let
  [= $d [$io:temp-dir "cxri"]]
  [= $p [$path:join $d "part.cx"]]
  [= $w [$io:write-file $p "[fragment ok=yes]"]]
  [$cx:resolve-includes "[root [?cx include=part.cx]]" $d]]
#]]
  [out-text [#
[root [fragment ok=yes]]
#]]
 ]

 [case id=cx-146-resolve-includes-not-found level=core grant='read write' packs=io
  [tags cx resolve-includes error granted issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[?let
  [= $d [$io:temp-dir "cxri"]]
  [$cx:resolve-includes "[root [?cx include=nope.cx]]" $d]]
#]]
  [out-err [#
cx-err:CXER4108
#]]
 ]

 [case id=cx-147-resolve-includes-traversal-refused level=core grant='read write'
  [tags cx resolve-includes traversal security granted issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [; The traversal refusal is decided from the PATH against the root, before
     any filesystem access — `../escape.cx` escapes every root there is. So
     this case takes a literal root and does NOT reach for cx-stdlib/io.
     It used to call [$io:temp-dir], which made it the one resolve-includes
     case that failed under the PROFILE gate: a restricted profile carries no
     `io-temp-dir` callable, so the case reported `no callable "io-temp-dir"`
     where CXER4109 was expected — an io-availability failure wearing a
     traversal-check verdict. Isolating the check from the filesystem is both
     the fix and the better test. ]
  [in-code [#
[$cx:resolve-includes "[root [?cx include='../escape.cx']]" "/tmp/cx-no-such-root"]
#]]
  [out-err [#
cx-err:CXER4109
#]]
 ]

 [case id=cx-148-resolve-includes-cycle level=core grant='read write' packs=io
  [tags cx resolve-includes cycle granted issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?let
  [= $d [$io:temp-dir "cxri"]]
  [= $a [$path:join $d "a.cx"]]
  [= $b [$path:join $d "b.cx"]]
  [= $wa [$io:write-file $a "[a [?cx include=b.cx]]"]]
  [= $wb [$io:write-file $b "[b [?cx include=a.cx]]"]]
  [$cx:resolve-includes "[root [?cx include=a.cx]]" $d]]
#]]
  [out-err [#
cx-err:CXER4107
#]]
 ]

 [case id=cx-149-resolve-includes-capability-denied level=core
  [tags cx resolve-includes capability denial issue-940 vc-6]
  [meta [#
note: security.md scopes the `read` capability as "filesystem reads,
note: [?cx include]" — and this IS [?cx include] at runtime.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:resolve-includes "[root [?cx include=missing.cx]]" "."]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

