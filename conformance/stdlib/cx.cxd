#]]
 ]

 [case id=cx-152-strip-attrs-name-glob level=core
  [tags cx strip-attrs transform glob issue-940 vc-6]
  [meta [#
note: SPEC-AMBIGUOUS (recorded, not resolved): §2.3 types the argument
note: $pattern::string and §6 gives CXER4115 for an invalid "name-pattern",
note: but no approved text defines the pattern LANGUAGE. Implemented as the
note: single-segment name GLOB the engine already carries (io:glob / bus
note: head-name patterns), NOT the RE2 `pattern=` of schema/validate.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:strip-attrs "[root x-a=1 keep=2 [c x-b=3 also=4]]" "x-*"]
#]]
  [out-text [#
[root keep=2 [c also=4]]
#]]
 ]

 [case id=cx-153-strip-attrs-star-removes-all level=core
  [tags cx strip-attrs glob issue-940 vc-6]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:strip-attrs "[root a=1 b=2]" "*"]
#]]
