     value so ANY party re-derives the id in-language: hash(value) == the
     env record's builtins field — the M5 re-hash-to-verify property,
     NEVER cx_features or a binary hash. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[r [$eq [$cx:hash [$cx:builtins]] [?let [= $e [$cx:env]] $e/builtins]]]
#]]
  [out-text [#
[r true]
#]]
 ]

