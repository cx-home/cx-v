[test-suite name=cx
  [doc [#
conformance fixtures for the cx: self-host module (spec/03-approved/modules/cx.md).

   The module is ALWAYS available (modules/cx.md §1 activation "Always") —
   most cases call [$cx:fn …] with no [?lib]; the activation section
   (090-…) additionally pins the [?lib 'cx-stdlib/cx'] module lane, the
   as= alias lane and the flat [$cx-fn] dispatch alias (§4).

   Section grouping by id range:
     001-007  #436 — [$cx:parse] of directive-bearing source is a CXDM
              value: navigable, renderable as CX surface, modifiable;
              pure-data parse unregressed
     010-012  §4 round-trip identity serialize∘parse ≡ canonical
              (data lane, directive lane, canonical-input lane)
     020-029  serialize / canonical / hash / equal (CLI-verb agreement:
              hash hex pins the `cx hash` digest of the same doc)
     040-049  diff (navigable [diff [change …]…] value) + patch
              (apply ≡ diff⁻¹; fail-loud CXER4102)
     060-067  to-format / from-format against the conversions registry
              (incl. the #445 table-XML lane and the #442 YAML
              block-sequence-of-mappings lane)
     080-085  select — runtime CXPath ≡ the equivalent inline path
              (descendant, predicate, attribute axis, empty, CXER4106)
     090-093  activation lanes (no-[?lib], module lane, as= alias, flat
              [$cx-fn] alias)

   No inter-fixture comment dividers and no inline comments inside
   in-code (the harness extracts sections to end-of-chunk).
#]]

 [case id=cx-001-parse-directive-navigable level=core
  [tags cx parse directive cxpath issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[?if true [then 1] [else 2]]"]] [$count $t//then]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=cx-002-parse-directive-wildcard level=core
  [tags cx parse directive cxpath wildcard issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[?if true [then 1] [else 2]]"]] [$count $t//*]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=cx-003-parse-directive-renders-cx-surface level=core
  [tags cx parse directive render issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:parse "[?if true [then 1] [else 2]]"]
#]]
  [out-text [#
[?if 'true ' [then 1] [else 2]]
#]]
 ]

 [case id=cx-004-parse-directive-modify-applies level=core
  [tags cx parse directive modify issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[?if true [then 1] [else 2]]"]] [?modify $t //then [set 42]]]
#]]
  [out-text [#
[?if 'true ' [then 42] [else 2]]
#]]
 ]

 [case id=cx-005-parse-nested-directive-descends level=core
  [tags cx parse directive nested cxpath issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[doc [?if cond [then [x 1]]] [tail 9]]"]] [r [a [$count $t//x]] [b [$count $t//tail]]]]
#]]
  [out-text [#
[r [a 1] [b 1]]
#]]
 ]

 [case id=cx-006-parse-pure-data-unregressed level=core
  [tags cx parse data cxpath issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[config [db [port 5432]]]"]] [r [echo $t] [n [$count $t//port]] [p $t/db/port]]]
#]]
  [out-text [#
[r [echo [config [db [port 5432]]]] [n 1] [p 5432]]
#]]
 ]

 [case id=cx-007-parse-directive-attr-axis level=core
  [tags cx parse directive attribute issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [$cx:parse "[doc [?if c [then [x k=7]]]]"]] [$count $t//x/@k]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=cx-010-roundtrip-data level=core
  [tags cx parse serialize canonical roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$eq [$cx:serialize [$cx:parse "[a 1]"]] [$cx:canonical "[a 1]"]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-011-roundtrip-directive level=core
  [tags cx parse serialize canonical roundtrip directive issue-436]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$eq [$cx:serialize [$cx:parse "[?if true [then 1] [else 2]]"]] [$cx:canonical "[?if true [then 1] [else 2]]"]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cx-012-roundtrip-canonical-input level=core
  [tags cx parse serialize canonical roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $c [$cx:canonical "[cfg [db host='h' port=5432] [flags on true]]"]] [$eq [$cx:serialize [$cx:parse $c]] $c]]
#]]
  [out-text [#
true
#]]
 ]

