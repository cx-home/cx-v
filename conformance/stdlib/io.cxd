 # close requires NO capability (io.md §7 — it only releases an already-granted
 # handle). It therefore has no no-cap denial path: the only reason this program
 # raises CXER0271 today is the nested `open` (covered directly by io-009/010/011).
 # close's own behavior — releasing a real handle — needs a granted handle, so
 # it belongs in the capability-granted harness. gate=pending until that lands.
 [case id=io-051-close-granted-behavior level=core gate=pending
  [tags io close granted-harness]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[$io:close [$io:open "/var/log/app.log" "r"]]
#]]
  [out-text [#
[granted-harness: open a real handle then close releases it]
#]]
 ]
 [case id=io-052-read-file-roundtrip-granted level=core gate=enforced grant='read write'
  [tags io read-file write-file roundtrip granted effort-b]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?let [= $d [$io:temp-dir "cxc"]] [?let [= $p [$path:join $d "f"]] [?let [= $w [$io:write-file $p "hello"]] [= [$io:read-file $p] "hello"]]]]
#]]
  [out-text [#
true
#]]
 ]

