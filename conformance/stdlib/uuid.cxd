[test-suite name=uuid
  [doc [#
conformance fixtures for cx-stdlib/uuid (spec/std-lib/uuid.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/uuid']
   (resolver MUST be quoted) then calls [$uuid:fn args]. The LAST
   expression is the rendered result. String scalars render quoted;
   bool bare; int bare. Error fixtures use --- out_err with the bare
   CXER code (matched as a substring of the rendered err value).

   Determinism: v4 / v7 are random, so we never assert their literal
   value. Instead we assert structural properties (validate / version /
   variant / round-trip). v5 / v3 are deterministic, so the RFC test
   vector and version/variant inspection are asserted directly.
#]]

 [case id=uuid-001-v4-validates level=core
  [tags uuid v4 validate random]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/uuid']
[$uuid:validate [$uuid:v4]]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [case id=uuid-002-v4-version level=core
  [tags uuid v4 version random]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/uuid']
[$uuid:version [$uuid:parse [$uuid:v4]]]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

