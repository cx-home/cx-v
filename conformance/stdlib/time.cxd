[test-suite name=time
  [doc [#
conformance fixtures for cx-stdlib/time (spec/std-lib/time.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/time']
   (resolver MUST be quoted) then calls [$time:fn args]. The LAST
   expression is the rendered result. Date/datetime scalars render
   quoted ("…"); instants/durations are int nanoseconds (bare); bools
   bare; atoms with leading colon (:monday); sequences in paren form.

   DETERMINISM: now / today / instant-now / monotonic-now / utc-now are
   impure and never asserted by literal value — they appear only inside
   pure round-trips / compositions whose result is stable. Error cases
   use --- out_err with the bare CXER code.
#]]

 [case id=time-001-date level=core
  [tags time construction date]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:date 2026 5 26]
#]]
  [out-text [#
'2026-05-26'
#]]
 ]

 [case id=time-002-datetime level=core
  [tags time construction datetime]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:datetime 2026 5 26 14 30 0]
#]]
  [out-text [#
'2026-05-26T14:30:00Z'
#]]
 ]

 [case id=time-003-date-invalid-component level=core
  [tags time construction CXER3300]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:date 2026 2 31]
#]]
  [out-err [#
cx-err:CXER3300
#]]
 ]

 [case id=time-004-datetime-invalid-month level=core
  [tags time construction CXER3300]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:datetime 2026 13 1 0 0 0]
#]]
  [out-err [#
cx-err:CXER3300
#]]
 ]

