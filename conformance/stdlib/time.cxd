 [case id=time-148-leading-zero-datetime level=core gate=enforced
  [tags time construction datetime leading-zero]
  [doc [#
HOSTILE (core-bug #1): zero-padded datetime components (`01`, `00`) are
NOT Integer tokens per lexicon [L20c] — they preserve as strings (the
ZIP/SKU rule). Before the coercion fix, every leading-zero argument made
`[$time:datetime …]` fail with a misleading `no callable "time-datetime"`
(the int-param guard rejected the string and dispatch fell through). This
is the natural way a user writes a timestamp; it MUST construct.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:datetime 2030 01 01 00 00 00]
#]]
  [out-text [#
'2030-01-01T00:00:00Z'
#]]
 ]

 [case id=time-149-leading-zero-date level=core gate=enforced
  [tags time construction date leading-zero]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:date 2026 05 26]
#]]
  [out-text [#
'2026-05-26'
#]]
 ]

 [case id=time-150-leading-zero-still-validates level=core gate=enforced
  [tags time construction date leading-zero CXER3300]
  [doc [#
The lenient coercion does NOT weaken validation: a zero-padded but
out-of-range component still raises CXER3300, exactly as the bare form.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:date 2026 02 31]
#]]
  [out-err [#
cx-err:CXER3300
#]]
 ]


 [case id=time-151-yearly-feb29-skip level=core gate=enforced
  [tags time recurrence yearly leap RFC5545 skip-invalid]
  [doc [#
HOSTILE (blocker): a YEARLY rule anchored on Feb 29 must SKIP non-leap years
(RFC 5545 §3.3.10 ignores invalid instances), not emit a nonexistent
2025-02-29 nor clamp to Feb 28. Only the leap years 2024 and 2028 occur.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:occurrences-in [recurrence freq=:yearly anchor='2024-02-29T12:00:00' tz='UTC'] '2024-01-01T00:00:00' '2028-12-31T00:00:00']
#]]
  [out-text [#
('2024-02-29T12:00:00Z', '2028-02-29T12:00:00Z')
#]]
 ]

 [case id=time-152-monthly-day31-skip level=core gate=enforced
  [tags time recurrence monthly RFC5545 skip-not-clamp]
  [doc [#
HOSTILE (major): a MONTHLY rule with no BYMONTHDAY recurs on the anchor
day-of-month; months lacking that day (Feb, Apr) are SKIPPED, not clamped to
their last day. Jan/Mar/May 31 occur; Feb/Apr do not.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:occurrences-in [recurrence freq=:monthly anchor='2026-01-31T09:00:00' tz='UTC'] '2026-01-01T00:00:00' '2026-07-01T00:00:00']
#]]
  [out-text [#
('2026-01-31T09:00:00Z', '2026-03-31T09:00:00Z', '2026-05-31T09:00:00Z')
#]]
 ]

 [case id=time-153-dst-fallback-earlier-offset level=core gate=enforced
  [tags time recurrence dst fall-back overlap earlier-offset]
  [doc [#
HOSTILE (blocker): a fall-back OVERLAP local time exists under both offsets;
§4.2 adopts the EARLIER instant (pre-transition, -04:00 DST), not the later
-05:00. NY 2026-11-01 01:30 must render -04:00.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:next-occurrence [recurrence freq=:yearly anchor='2026-11-01T01:30:00' tz='America/New_York'] '2026-01-01T00:00:00']
#]]
  [out-text [#
'2026-11-01T01:30:00-04:00'
#]]
 ]

 [case id=time-154-dst-gap-rollforward level=core gate=enforced
  [tags time recurrence dst spring-forward gap roll-forward]
  [doc [#
HOSTILE (major): a spring-forward GAP local time (NY 2026-03-08 02:30) does
not exist; §4.2 rolls it FORWARD to the next valid local time (03:30 -04:00)
rather than emitting the nonexistent 02:30 label.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:next-occurrence [recurrence freq=:yearly anchor='2026-03-08T02:30:00' tz='America/New_York'] '2026-01-01T00:00:00']
#]]
  [out-text [#
'2026-03-08T03:30:00-04:00'
#]]
 ]

 [case id=time-155-instant-overflow level=core gate=enforced
  [tags time recurrence instant overflow CXER3304]
  [doc [#
HOSTILE (blocker): past ~2262-04 the i64-ns instant wraps; a next-occurrence
whose result lands beyond the representable range must raise CXER3304, NOT
return a bogus wrapped instant appearing before `after`.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:next-occurrence [recurrence freq=:yearly anchor='2200-06-15T12:00:00' tz='UTC'] '2262-01-01T00:00:00']
#]]
  [out-err [#
cx-err:CXER3304
#]]
 ]

 [case id=time-156-format-cron-hourly level=core gate=enforced
  [tags time recurrence format-cron hourly sub-daily]
  [doc [#
HOSTILE (major): an HOURLY rule formats to `M * * * *` (fire every hour at
the anchor minute). The prior code emitted the anchor hour, silently
collapsing it to a once-a-day cron.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:format-cron [recurrence freq=:hourly anchor='2026-01-01T00:15:00' tz='UTC']]
#]]
  [out-text [#
'15 * * * *'
#]]
 ]

 [case id=time-157-format-cron-minutely level=core gate=enforced
  [tags time recurrence format-cron minutely sub-daily]
  [doc [#
A MINUTELY rule formats to `* * * * *` (every minute), not the anchor
minute/hour.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[$time:format-cron [recurrence freq=:minutely anchor='2026-01-01T00:00:00' tz='UTC']]
#]]
  [out-text [#
'* * * * *'
#]]
 ]

]
