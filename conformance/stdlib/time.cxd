[$time:occurrences-in [recurrence freq=:monthly anchor='2026-01-01T09:00:00' tz='UTC' [by-day :monday :tuesday :wednesday :thursday :friday] [by-set-pos -1]] '2026-01-01T00:00:00' '2026-04-01T00:00:00']
#]]
  [out-text [#
('2026-01-30T09:00:00Z', '2026-02-27T09:00:00Z', '2026-03-31T09:00:00Z')
#]]
 ]

