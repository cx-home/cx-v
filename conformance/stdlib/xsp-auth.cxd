           attach: [attach [session mirror]]}]]
  [= $m4 [$xsp:auth-confirm $m1 $m2 $m3 {eph-priv: $r-eph-priv,
           session: [session id="s-floor" [principal "did:key:dev-floor"]]}]]
  [= $done [$xsp:auth-finish $m1 $m2 $m4 {eph-priv: $i-eph-priv}]]
  [; the anonymous initiator still authenticated the RESPONDER (N-IDENT-2)
     and the session is the deployment's floor principal (§4.7) ]
  [seq [= $done/@responder $r-did] [$text $done/session/@id]]]
#]]
  [out-text [#
[seq true 's-floor']
#]]
 ]

