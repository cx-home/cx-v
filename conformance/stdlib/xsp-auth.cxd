     not carry a signature (§4.7) ]
  [= $m3-evil [xsp-auth phase=prove [sig "zAAA"]
    [tag [$first $m3/tag]] [attach [session mirror]]]]
  [$xsp:auth-confirm $m1 $m2 $m3-evil {eph-priv: $r-eph-priv}]]
