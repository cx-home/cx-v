 ]

 [case id=xsp-auth-020-transcript-endpoint-signed level=core gate=enforced
  [tags xsp-auth endpoint unknown-key-share binding]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "tcps://helm.local/xsp"}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [; a hostile relay rewrites the dialed endpoint in M1 — the responder's
     signature no longer verifies over the doctored transcript (§8.4) ]
  [= $m1-doctored [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "tcps://evil.example/xsp"}]]
  [$xsp:auth-prove $m1-doctored $m2 {eph-priv: $i-eph-priv, key: $i-seed,
    attach: [attach [session mirror]]}]]
#]]
  [out-err [#
cx-err:CXER-XSP-AUTH-SIG
#]]
 ]

 [case id=xsp-auth-021-did-peer-mutual level=core gate=enforced
  [tags xsp-auth did-peer numalgo-0 pairwise mutual]
  [doc [#
§1: a did:peer numalgo-0 pairwise DID completes the full mutual handshake by the
same offline synthesis as did:key — the method flows through auth-* unchanged.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:peer-create $i-pub]]
  [= $r-did [$did:peer-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: ""}]]
  [= $m2 [$xsp:auth-challenge $m1 {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1 $m2 {eph-priv: $i-eph-priv, key: $i-seed, attach: [attach [session mirror]]}]]
  [= $m4 [$xsp:auth-confirm $m1 $m2 $m3 {eph-priv: $r-eph-priv}]]
  [= $done [$xsp:auth-finish $m1 $m2 $m4 {eph-priv: $i-eph-priv}]]
  [seq [$text [$did:method $i-did]] [= $done/@responder $r-did]]]
#]]
  [out-text [#
[seq 'peer' true]
#]]
 ]

 [case id=xsp-auth-022-rotate-continuity level=core gate=enforced
  [tags xsp-auth rotate did-web continuity lifecycle]
  [doc [#
§6.3: the outgoing key signs the incoming DID bound to the prior channel id; the
proof verifies against the old key and FAILS against the wrong key — the
continuity that lets a live session survive a mid-session did:web rotation.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $old-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $old-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $new-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $old-did [$did:key-create $old-pub]]
  [= $new-did [$did:key-create $new-pub]]
  [= $rot [$xsp:auth-rotate $old-seed $new-did "840848621c3c2c92b7934fafc6e0adca"]]
  [seq [$xsp:auth-rotate-verify $rot $old-did [$bytes:from-hex ""]]
       [$xsp:auth-rotate-verify $rot $new-did [$bytes:from-hex ""]]]]
#]]
  [out-text [#
[seq true false]
#]]
 ]

 [case id=xsp-auth-023-rotate-tampered-chan level=core gate=enforced
  [tags xsp-auth rotate continuity negative]
  [doc [#
§6.3: a rotation proof is bound to the prior channel id — verifying a proof
whose channel binding was altered fails (the sig no longer covers it). Modeled
by re-deriving a proof for a different prior-chan and checking the two proofs
differ.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $old-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $old-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $new-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $new-did [$did:key-create $new-pub]]
  [= $rot-a [$xsp:auth-rotate $old-seed $new-did "chan-A"]]
  [= $rot-b [$xsp:auth-rotate $old-seed $new-did "chan-B"]]
  [= [$text [$first $rot-a/sig]] [$text [$first $rot-b/sig]]]]
#]]
  [out-text [#
false
#]]
 ]

 [case id=xsp-auth-024-initiator-frame-roundtrip level=core gate=enforced
  [tags xsp-auth frame data-bin sse-post initiator]
  [doc [#
§4.12 (P2, issue #394): the INITIATOR consumes M2 and M4 off the wire —
each rides an XSP v1 stream-0 frame, whose data-bin decode atomizes the
single-scalar handshake fields (version/nonce/eph/cb/sig/tag) into
attributes. auth-prove and auth-finish must read the attr-form messages
exactly as the fresh child-form ones (fixture 017 proved the responder
half over M1; this is the other direction — the SSE+POST web binding
exercises both). The full handshake runs with EVERY message wire
round-tripped, and finishes established with both sides deriving the
same channel id.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-priv [$bytes:from-hex "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "http://127.0.0.1:1"}]]
  [= $w1 [$xsp:encode [frame type=request stream=0 [payload $m1]]]]
  [= $d1 [$xsp:decode $w1]]
  [= $m1-srv $d1/payload]
  [= $m2 [$xsp:auth-challenge $m1-srv {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $w2 [$xsp:encode [frame type=reply stream=0 [payload $m2]]]]
  [= $d2 [$xsp:decode $w2]]
  [= $m2c $d2/payload]
  [= $m3 [$xsp:auth-prove $m1 $m2c {eph-priv: $i-eph-priv, key: $i-seed,
           attach: [attach [tenant "acme"] [session mirror]]}]]
  [= $w3 [$xsp:encode [frame type=request stream=0 [payload $m3]]]]
  [= $d3 [$xsp:decode $w3]]
  [= $m3-srv $d3/payload]
  [= $m4 [$xsp:auth-confirm $m1-srv $m2 $m3-srv {eph-priv: $r-eph-priv,
           session: [session id="s-1"]}]]
  [= $w4 [$xsp:encode [frame type=reply stream=0 [payload $m4]]]]
  [= $d4 [$xsp:decode $w4]]
  [= $m4c $d4/payload]
  [= $done [$xsp:auth-finish $m1 $m2c $m4c {eph-priv: $i-eph-priv}]]
  [; both sides derive the same channel id: the client from the ATTR-form
     M2, the server from its fresh child-form values ]
  [= $ks-c [$xsp:auth-keys $i-eph-priv $m2c/@eph $n-i $m2c/@nonce]]
  [seq [$text $done/@responder]
       [= [$text $done/@chan-id] [$bytes:to-hex [$first $ks-c/chan-id]]]]]
#]]
  [out-text [#
[seq 'did:key:z6MkiaMbhXHNA4eJVCCj8dbzKzTgYDKf6crKgHVHid1F1WCT' true]
#]]
 ]
]
