 [case id=xsp-auth-017-frame-roundtrip-transcript-stable level=core gate=enforced
  [tags xsp-auth frame data-bin stream-0 lossless]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/xsp' :as xsp]
[?lib 'cx-stdlib/bytes' :as bytes]
[?lib 'cx-stdlib/did' :as did]
[?let
  [= $i-eph-priv [$bytes:from-hex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"]]
  [= $i-eph-pub  [$bytes:from-hex "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"]]
  [= $r-eph-pub  [$bytes:from-hex "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"]]
  [= $i-seed [$bytes:from-hex "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"]]
  [= $i-pub  [$bytes:from-hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"]]
  [= $r-seed [$bytes:from-hex "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"]]
  [= $r-pub  [$bytes:from-hex "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"]]
  [= $n-i [$bytes:from-hex "0101010101010101010101010101010101010101010101010101010101010101"]]
  [= $n-r [$bytes:from-hex "0202020202020202020202020202020202020202020202020202020202020202"]]
  [= $i-did [$did:key-create $i-pub]]
  [= $r-did [$did:key-create $r-pub]]
  [= $m1 [$xsp:auth-hello {did: $i-did, nonce: $n-i, eph: $i-eph-pub, endpoint: "tcps://helm.local/xsp"}]]
  [; carry M1 as a real XSP v1 frame on stream 0 (§4.3), decode it back,
     and run the handshake over the ROUND-TRIPPED element — the data-bin
     losslessness the transcript signature depends on ]
  [= $wire [$xsp:encode [frame type=request stream=0 principal=$i-did [payload $m1]]]]
  [= $decoded [$xsp:decode $wire]]
  [= $m1-rt [$first $decoded/payload]]
  [= $m2 [$xsp:auth-challenge $m1-rt {did: $r-did, nonce: $n-r, eph: $r-eph-pub, key: $r-seed}]]
  [= $m3 [$xsp:auth-prove $m1-rt $m2 {eph-priv: $i-eph-priv, key: $i-seed,
           attach: [attach [session mirror]]}]]
  [$text $m3/@phase]]
#]]
  [out-text [#
'prove'
#]]
 ]

