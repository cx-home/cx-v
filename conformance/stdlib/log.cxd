 [case id=log-010-log-unknown-level-raises level=core
  [tags log log generic level-invalid CXER2402]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/log']
[$log:log :verbose "bad level atom"]
#]]
  [out-err [#
cx-err:CXER2402
#]]
 ]

 [case id=log-011-current-scope-empty-no-scope level=core
  [tags log current-scope scope empty map]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/log']
[$log:current-scope]
#]]
  [out-text [#
{}
#]]
 ]

 [case id=log-012-current-scope-inside-scope level=core
  [tags log current-scope scope auto-attach map]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/log']
[?with-scope {request-id: "r1"}
  [$log:current-scope]]
#]]
  [out-text [#
{request-id: 'r1'}
#]]
 ]

 [case id=log-013-current-scope-nest-override level=core
  [tags log current-scope scope nest override map]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/log']
[?with-scope {request-id: "outer"}
  [?with-scope {request-id: "inner"}
    [$log:current-scope]]]
#]]
  [out-text [#
{request-id: 'inner'}
#]]
 ]

