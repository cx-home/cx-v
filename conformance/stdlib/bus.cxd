 ]

 [case id=bus-026-handler-capability-effect-flows-through level=core gate=enforced
  [tags bus emit handler capability store effect]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?lib 'cx-stdlib/store']
[?let [= $st [$store:open 'mem://bus-effect']]
  [?with-open [$bus:bus] $b
    [?with-open [$bus:on $b :save [?fn ($m) [$store:put-doc $st [doc x=1]]]] $s
      [?let [= $d [$bus:emit $b [do :save]]]
        [$store:exists $st 'a4a2dc818fa04391655363de78c057c0c4d0971fba0046477e2b8072c3f7f20b']]]]]
#]]
  [out-text [#
true
#]]
 ]

