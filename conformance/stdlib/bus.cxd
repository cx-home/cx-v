[test-suite name=bus
  [doc [#
conformance fixtures for cx-stdlib/bus (spec/02-inprogress/xap/stdlib_bus.md
§6/§10). In-process publish/subscribe with synchronous, deterministic,
ordered dispatch (band CXER4650-4699).

   Each program imports the bundled module via [?lib 'cx-stdlib/bus']
   (resolver MUST be quoted). A few handler-effect cases also import
   'cx-stdlib/store'. The LAST expression is the rendered result.

   Handles + subscriptions are closeable ([?with-open]); a [bus] is built
   with [$bus:bus], subscribed with [$bus:on], published with [$bus:emit]
   (returns a [dispatch …] VALUE), unsubscribed with [$bus:off], and
   introspected with subscribers/topics/match/topic/matches (all pure).

   PATTERN FORMS (§2.2): a topic atom (:order-placed); a head-name string
   ('metric'); or an arity-1 boolean predicate function over the message
   (the CXPath-predicate form). PREFIX-GLOB: the spec writes :order.* with
   `.` hierarchy + `.*` suffix; the CX atom grammar admits neither `.` nor
   `*` as a NameChar, so this impl realizes the SAME prefix-glob with `-`
   as the separator and a TRAILING `-` marker: :order- matches
   :order-placed / :order-cancelled (semantics identical, only the typeable
   spelling differs).

   FAULTS (§4.3): a handler "faults" only when it RAISES (a `!`-forced call
   that returns an [err]); a handler that merely RETURNS an [err] value is
   success (§4.5, return ignored). on-fault ∈ :isolate (default; record,
   continue, faulted=true) / :collect (aggregate into [dispatch]/faults) /
   :halt (stop, surface the [err]).

   Determinism: dispatch order is descending priority, ties by ascending
   registration order (§4.1); re-entrant emissions drain FIFO before the
   next external message (§4.2); every cascade is bounded (§4.4).

   Id ranges:
     001-006  on + emit delivery, zero-subscriber VALUE, fire order
     007-013  pattern forms: atom / glob / head-name / predicate; topic
     014-018  re-entrant FIFO drain, once, mutation-during-dispatch
     019-022  introspection: subscribers / topics / match / matches dry-run
     023-026  off idempotence; handler capability effect flows through
     027-030  fault policies: isolate / collect / halt
     031-037  negatives: CXER4660/4661-n.a./4662/4663/4664/4665
#]]

 [- ── 001-006 on + emit delivery ─────────────────────────────────────── -]

 [case id=bus-001-on-emit-single-subscriber level=core gate=enforced
  [tags bus on emit dispatch delivery]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?with-open [$bus:on $b :ping [?fn ($m) $m]] $s
    [?let [= $d [$bus:emit $b [do :ping]]] $d@delivered]]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=bus-001b-emit-dispatch-topic level=core gate=enforced
  [tags bus emit dispatch topic value]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?with-open [$bus:on $b :ping [?fn ($m) $m]] $s
    [?let [= $d [$bus:emit $b [do :ping]]] $d@topic]]]
#]]
  [out-text [#
'ping'
#]]
 ]

 [case id=bus-002-emit-zero-subscribers-is-a-value level=core gate=enforced
  [tags bus emit zero-subscribers value four-channel]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?let [= $d [$bus:emit $b [do :nobody]]] $d@delivered]]
#]]
  [out-text [#
0
#]]
 ]

 [case id=bus-002b-emit-zero-subscribers-is-not-an-err level=core gate=enforced
  [tags bus emit zero-subscribers value four-channel name]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?let [= $d [$bus:emit $b [do :nobody]]] [$name $d]]]
#]]
  [out-text [#
'dispatch'
#]]
 ]

 [case id=bus-003-multiple-subscribers-registration-order level=core gate=enforced
  [tags bus emit fire-order registration-order]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?with-open [$bus:on $b :t [?fn ($m) $m]] $s1
    [?with-open [$bus:on $b :t [?fn ($m) $m]] $s2
      [?let [= $d [$bus:emit $b [do :t]]] [$count $d/fired/subscription]]]]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=bus-004-priority-reorders-fire-order level=core gate=enforced
  [tags bus emit priority fire-order]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?with-open [$bus:on $b :t [?fn ($m) $m] {priority: 1}] $lo
    [?with-open [$bus:on $b :t [?fn ($m) $m] {priority: 5}] $hi
      [?let [= $d [$bus:emit $b [do :t]]]
        [?let [= $top [$first $d/fired/subscription]] $top@id]]]]]
#]]
  [out-text [#
's-2'
#]]
 ]

 [case id=bus-005-delivered-count level=core gate=enforced
  [tags bus emit delivered]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?with-open [$bus:on $b :t [?fn ($m) $m]] $s1
    [?with-open [$bus:on $b :t [?fn ($m) $m]] $s2
      [?let [= $d [$bus:emit $b [do :t]]] $d@delivered]]]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=bus-006-non-matching-subscriber-not-fired level=core gate=enforced
  [tags bus emit selectivity]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/bus']
[?with-open [$bus:bus] $b
  [?with-open [$bus:on $b :a [?fn ($m) $m]] $s1
    [?with-open [$bus:on $b :b [?fn ($m) $m]] $s2
      [?let [= $d [$bus:emit $b [do :a]]] $d@delivered]]]]
#]]
  [out-text [#
