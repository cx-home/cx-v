  [= $x1 [$authz:debit $az 'd-chi']]
  [$authz:debit $az 'd-chi']]
#]]
  [out-text [#
[deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :count] [delegation 'd-par']]
