  [= $p2 [$cx:propose refund-order {order: 'o-1', amount: 4200} {}]]
  [= $a [$authz:approve $az $p1 {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p2 $a refund-order {}]]
#]]
  [out-err [#
cx-err:CXER4714
#]]
 ]

 [case id=authz-088-approval-binds-tier1-exact-version level=core gate=enforced
  [tags authz commit approval tier1 version-binding stream-18 690 L139]
  [meta [#
note: the L139 pair, positive half: the approval was minted against
note: v1's proposal; presenting v1 (the EXACT approved def text) at
note: commit succeeds. ./cmd-v1.cx and ./cmd-v2-widened.cx carry the
note: SAME name/params/body (⇒ same Tier-2 computes-as — cmd-011's
note: clause-exclusion invariance) and differ ONLY in [effects].
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?lib './cmd-v1.cx' as=v1]
[?let [= $j [$journal:open "mem://authz-pm-088" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$cx:propose $v1:refund-order {order: 'o-1', amount: 42} {tenant: 'acme'}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p $a $v1:refund-order {actor: 'agent-1'}]]
#]]
  [out-text [#
42
#]]
 ]

 [case id=authz-089-widened-effects-version-refused level=core gate=enforced
  [tags authz commit approval tier1 tier2 widened-effects CXER4714 stream-18 690 L139]
  [meta [#
note: the L139 pair, negative half — THE binding discriminator: v2 has
note: the SAME Tier-2 computes-as as v1 ([effects] is outside the hash
note: by S0) but a WIDENED effect set ([net] added), hence a different
note: Tier-1 def text. The approval minted against v1's proposal must
note: never admit v2 — a Tier-2-bound approval would replay here; the
note: Tier-1 binding refuses (commit runs the EXACT approved version).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?lib './cmd-v1.cx' as=v1]
[?lib './cmd-v2-widened.cx' as=v2]
[?let [= $j [$journal:open "mem://authz-pm-089" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$cx:propose $v1:refund-order {order: 'o-1', amount: 42} {tenant: 'acme'}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p $a $v2:refund-order {actor: 'agent-1'}]]
#]]
  [out-err [#
cx-err:CXER4714
#]]
 ]

 [case id=authz-080-commit-propose-only-basis level=core gate=enforced
  [tags authz commit propose-only attenuation CXER4715 stream-6 678 L113]
  [meta [#
note: [propose-only] is the grant-side attenuation flag: the
note: delegation can ground a PROPOSAL but never a commit — the
note: screening walks the basis chain (inheritance narrowing-only).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?def refund-order impure [effects] ($order='' $amount=10) $amount]
[?let [= $j [$journal:open "mem://authz-pm-080" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-agent [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [propose-only] [assurance :t1] [signature s]]]]
  [= $p [$cx:propose refund-order {order: 'o-1', amount: 42} {}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p $a refund-order {basis: 'd-agent'}]]
#]]
  [out-err [#
cx-err:CXER4715
#]]
 ]

 [case id=authz-081-resolve-cap-live-then-revoked level=core gate=enforced
  [tags authz resolve-cap cap-prefix fail-closed CXER4716 stream-6 678 L114]
  [meta [#
note: L114 — cap:sha2-256:<hex> addresses ANY authority artifact; the
note: LIVE registry view resolves it. A revoked grant is fail-closed
note: CXER4716 (a trust input that cannot be proven live is refused),
note: never a silent absence.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $dv [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]
  [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az $dv]]
  [= $ref [$concat 'cap:' [$cx:hash $dv]]]
  [= $live [$authz:resolve-cap $az $ref]]
  [= $r [$authz:revoke $az 'd-1']]
  [?fallback [$authz:resolve-cap $az $ref] [recover-with :refused-after-revoke]]]
#]]
  [out-text [#
:refused-after-revoke
#]]
 ]

 [case id=authz-082-commit-precondition-divergence level=core gate=enforced
  [tags authz commit preconditions divergence two-times CXER4714 stream-6 678 L113]
  [meta [#
note: the two-times enforcement table: the precondition was TRUE at
note: propose (counter inc -> 1) and is FALSE at commit (inc -> 2) —
note: divergence is the loud CXER4714 refusal; the body never runs.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?def once-only impure [effects] [preconditions [$eq [?test-counter name='pc-082' op=inc] 1]] ($x=1) $x]
[?let [= $j [$journal:open "mem://authz-pm-082" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$cx:propose once-only {x: 7} {}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p $a once-only {}]]
#]]
  [out-err [#
cx-err:CXER4714
#]]
 ]

 [case id=authz-083-refund-order-m5-end-to-end level=core gate=enforced
  [tags authz command propose approve commit debit dedup m5 stream-6 678 L109 L111 L112 L113]
  [meta [#
note: THE M5 worked example end-to-end (commands_effects sect-0): an
note: agent under a propose-only, budget-bounded sub-delegation
note: proposes a 42 refund; the principal approves the ADDRESS; commit
note: verifies the chain, executes, debits the spend meter under the
note: stream commit lock, and journals. The SECOND commit of an
note: identical proposal dedups (present [deduped ...] value, the
note: in-process effect boundary); the third, larger refund crosses
note: the budget and is denied naming the failing conjunct (:spend on
note: the meter owner). Composes every wave of stream 6.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?def refund-order impure [effects] [preconditions [> $amount 0]] [idempotent [window 7d]] ($order='' $amount=10) [?let [= $c [?test-counter name='m5-exec' op=inc]] $amount]]
[?let [= $j [$journal:open "mem://authz-m5-083" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $dpar [$authz:delegate $az
    [delegation d-dana-ops [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [spend 100.0 :currency :USD :per '1d']] [assurance :t1] [signature s]]]]
  [= $dchi [$authz:delegate $az
    [delegation d-agent [tenant acme] [from [agent ops-1]] [to [agent bot-7]]
      [capabilities [refund]] [attenuates d-dana-ops] [propose-only] [assurance :t1] [signature s]]]]
  [= $p [$cx:propose refund-order {order: 'o-1', amount: 42} {tenant: 'acme'}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-dana'}]]
  [= $r1 [$authz:commit $az $p $a refund-order {actor: 'bot-7', debit: {id: 'd-dana-ops', spend: 42.0, currency: 'USD', at: '2026-01-02T01:00:00Z'}}]]
  [= $r2 [$authz:commit $az $p $a refund-order {actor: 'bot-7'}]]
  [= $p3 [$cx:propose refund-order {order: 'o-2', amount: 70} {tenant: 'acme'}]]
  [= $a3 [$authz:approve $az $p3 {by: 'dana', signature: 'sig-dana'}]]
  [= $r3 [$authz:commit $az $p3 $a3 refund-order {actor: 'bot-7', debit: {id: 'd-dana-ops', spend: 70.0, currency: 'USD', at: '2026-01-02T02:00:00Z'}}]]
  ([first $r1], [replay $r2], [overspend $r3], [execs [?test-counter name='m5-exec' op=read]])]
#]]
  [out-text [#
([first 42], [replay [deduped 42]], [overspend [deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :spend] [delegation 'd-dana-ops']]], [execs 1])
#]]
 ]

 [case id=authz-084-requires-at-admission level=core gate=enforced
  [tags authz coordination requires-at pin stream-10 682 CXER4950 CXER4951]
  [meta [#
note: the stream-10 cross-stream precondition PIN (the B3 admission
note: read): satisfied under authz commit (target head at-or-past seq,
note: entry hash-matching) => the body runs; a stale pin (seq beyond
note: head) refuses CXER4950 with no debit and no body; DIRECT
note: invocation of a pinned command refuses CXER4951 fail-closed both
note: before AND after a successful commit — the admission brackets
note: exactly one commit and never leaks.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/cx']
[?def approve-order impure [effects] [requires-at stream="sku:88" seq=1 hash="sha2-256:5ea2624a305d00e40d18a0b41adbd212d727f0910e8770c7411b886c1c4c7ec0"] ($order='') [approved order=$order]]
[?def approve-late impure [effects] [requires-at stream="sku:88" seq=9 hash="sha2-256:5ea2624a305d00e40d18a0b41adbd212d727f0910e8770c7411b886c1c4c7ec0"] ($order='') [approved order=$order]]
[?let
[= $s [$store:open "mem://pin-1"]]
[= $j [$journal:attach $s "acme"]]
[= $e1 [$journal:append $j [reserved sku="88" qty=1] {actor: "svc" authority: "inv" stream: "sku:88"}]]
[= $direct [?fallback [$approve-order "o-1"] [recover-with [context] [code $err@code]]]]
[= $az [$authz:store {tenant: "acme" journal: $j}]]
[= $p [$cx:propose approve-order {order: "o-1"}]]
[= $ap [$authz:approve $az $p {by: "dana" signature: "sig-1"}]]
[= $ok [$authz:commit $az $p $ap approve-order {actor: "agent-1"}]]
[= $p2 [$cx:propose approve-late {order: "o-2"}]]
[= $ap2 [$authz:approve $az $p2 {by: "dana" signature: "sig-1"}]]
[= $stale [?fallback [$authz:commit $az $p2 $ap2 approve-late {actor: "agent-1"}] [recover-with [context] [code $err@code]]]]
[= $direct2 [?fallback [$approve-order "o-3"] [recover-with [context] [code $err@code]]]]
  [probe [direct $direct] [committed $ok] [stale $stale] [direct-after $direct2]]]
#]]
  [out-text [#
[probe [direct [code 'cx-err:CXER4951']] [committed [approved order=o-1]] [stale [code 'cx-err:CXER4950']] [direct-after [code 'cx-err:CXER4951']]]
#]]
 ]

 [case id=authz-085-escrow-allocations level=core gate=enforced
  [tags authz escrow allocation reservation stream-10 682 L158 M28 CXER4713]
  [meta [#
note: escrow allocations (cross_stream_coordination §3): a reservation
note: draws from the parent's meter AT ALLOCATION TIME under the
note: parent's lock (over-reservation denied naming the conjunct;
note: window attribution pinned at reservation); draws name their
note: allocation and deplete ITS remainder only (one draw, one meter —
note: over-draw and post-expiry draws denied naming the allocation
note: conjunct); rate is REFUSED (flow, un-escrowable); expiry reclaims
note: the UN-DRAWN remainder visibly — not replenishment: after the
note: reclaim the parent's consumption is exactly what was drawn, so a
note: reservation that would have exceeded the cap now fits.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/authz']
[?let
[= $s [$store:open "mem://esc-1"]]
[= $j [$journal:attach $s "acme"]]
[= $az [$authz:store {tenant: "acme" journal: $j}]]
[= $d [$authz:delegate $az
  [delegation d-parent [tenant acme] [from [principal dana]] [to [agent team-1]]
    [capabilities [spend-money]] [bounds [count 10] [spend 100.0 :currency :USD :per '1d']] [assurance :t1] [signature s]]]]
[= $a1 [$authz:allocate $az "esc-1" {from: "d-parent" count: 4 spend: 40.0 currency: "USD" at: "2026-08-12T10:00:00Z"}]]
[= $rate-refused [?fallback [$authz:allocate $az "esc-r" {from: "d-parent" rate: {n: 5 per: "PT1M"}}] [recover-with [context] [code $err@code]]]]
[= $over [$authz:allocate $az "esc-2" {from: "d-parent" spend: 70.0 currency: "USD" at: "2026-08-12T10:01:00Z"}]]
[= $draw1 [$authz:debit $az "d-parent" {allocation: "esc-1" count: 2 spend: 15.0 currency: "USD" at: "2026-08-12T10:05:00Z"}]]
[= $draw-over [$authz:debit $az "d-parent" {allocation: "esc-1" count: 3 at: "2026-08-12T10:06:00Z"}]]
[= $exp [$authz:allocation-expire $az "esc-1" {at: "2026-08-12T11:00:00Z"}]]
[= $draw-late [$authz:debit $az "d-parent" {allocation: "esc-1" count: 1 at: "2026-08-12T11:05:00Z"}]]
[= $after [$authz:allocate $az "esc-3" {from: "d-parent" spend: 70.0 currency: "USD" at: "2026-08-12T11:10:00Z"}]]
  [probe [reserved $a1] [rate $rate-refused] [over-reserve $over] [draw $draw1] [draw-over $draw-over] [expired $exp] [draw-late $draw-late] [reclaimed-then-ok $after]]]
#]]
  [out-text [#
[probe [reserved [allocated alloc=esc-1 from=d-parent count=4 spend=40.0 currency=USD]] [rate [code 'cx-err:CXER4711']] [over-reserve [deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :spend] [delegation 'd-parent']]] [draw [debited id=d-parent alloc=esc-1 count=2 spend=15.0 currency=USD]] [draw-over [deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :allocation-count] [delegation 'esc-1']]] [expired [allocation-expired alloc=esc-1 reclaimed-count=2 reclaimed-spend=25.0]] [draw-late [deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :allocation-expired] [delegation 'esc-1']]] [reclaimed-then-ok [allocated alloc=esc-3 from=d-parent spend=70.0 currency=USD]]]
#]]
 ]

