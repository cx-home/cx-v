[?lib 'cx-stdlib/authz']
[$authz:store {}]
#]]
  [out-err [#
cx-err:CXER4711
#]]
 ]

 # ── §3.2 revoke → absence-for-check (§2.5) ──
 [case id=authz-010-revoke-then-deny level=core gate=enforced
  [tags authz revoke deny]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [over '/orders'] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-1']]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'refund'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-011-revoke-then-find-absence level=core gate=enforced
  [tags authz revoke find absence]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-1']]
  [$authz:find $az 'd-1']]
#]]
  [out-text [# () #]]
 ]

 [case id=authz-012-revoke-cascade level=core gate=enforced
  [tags authz revoke cascade attenuation]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-par [tenant acme] [from [principal dana]] [to [agent mid]]
      [capabilities [x]] [over '/s'] [assurance :t1] [signature s]]]]
  [= $c [$authz:delegate $az
    [delegation d-chi [tenant acme] [from [agent mid]] [to [agent leaf]]
      [capabilities [x]] [over '/s'] [attenuates d-par] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-par' {cascade: true}]]
  [$authz:check $az [authz-request [actor [agent leaf]] [capability x] [slice '/s/1'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=leaf [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'x'] [slice '/s/1'] [tenant id=acme]]
#]]
 ]

 [case id=authz-013-revoke-absent-idempotent level=core gate=enforced
  [tags authz revoke idempotent absence]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:revoke $az 'never-issued']]
#]]
  [out-text [# () #]]
 ]

 # ── §3.3 guardian grant + the falsifiable-by-presence flip (§4.4) ──
 [case id=authz-014-guardian-permit-gate-holds level=core gate=enforced
  [tags authz guardian permit gate incapacity]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $g [$authz:grant-guardian $az
    [delegation g-1 [tenant acme] [mode :guardian] [from [principal admin]] [to [agent ops-1]]
      [capabilities [pause-gw]] [action [do :pause-gw]]
      [gate [all [incapacity [no-ack-within [of :escalation]]] [state [gt '/charge-error-rate' 0.15]]]]
      [assurance :t1] [signature sig-admin]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability pause-gw] [tenant acme]]
    {with-context: [context [no-ack-within true] [charge-error-rate 0.2]]}]]
#]]
  [out-text [#
[permit rooted-principal=admin [delegation 'g-1'] [via 'g-1'] [tier :t1] [capability 'pause-gw']]
#]]
 ]

 [case id=authz-015-guardian-deny-presence-flip level=core gate=enforced
  [tags authz guardian deny falsifiable-by-presence bright-line]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $g [$authz:grant-guardian $az
    [delegation g-1 [tenant acme] [mode :guardian] [from [principal admin]] [to [agent ops-1]]
      [capabilities [pause-gw]] [action [do :pause-gw]]
      [gate [all [incapacity [no-ack-within [of :escalation]]] [state [gt '/charge-error-rate' 0.15]]]]
      [assurance :t1] [signature sig-admin]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability pause-gw] [tenant acme]]
    {with-context: [context [no-ack-within false] [charge-error-rate 0.2]]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :gate-not-holding] [capability 'pause-gw'] [tenant id=acme]]
#]]
 ]

 [case id=authz-016-guardian-deny-state-below level=core gate=enforced
  [tags authz guardian deny state threshold]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $g [$authz:grant-guardian $az
    [delegation g-1 [tenant acme] [mode :guardian] [from [principal admin]] [to [agent ops-1]]
      [capabilities [pause-gw]] [action [do :pause-gw]]
      [gate [all [incapacity [no-ack-within [of :escalation]]] [state [gt '/charge-error-rate' 0.15]]]]
      [assurance :t1] [signature sig-admin]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability pause-gw] [tenant acme]]
    {with-context: [context [no-ack-within true] [charge-error-rate 0.05]]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :gate-not-holding] [capability 'pause-gw'] [tenant id=acme]]
#]]
 ]

 [case id=authz-017-guardian-pinned-action-only level=core gate=enforced
  [tags authz guardian pinned-action deny]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $g [$authz:grant-guardian $az
    [delegation g-1 [tenant acme] [mode :guardian] [from [principal admin]] [to [agent ops-1]]
      [capabilities [pause-gw] [refund]] [action [do :pause-gw]]
      [gate [all [incapacity [no-ack-within]]]] [assurance :t1] [signature sig-admin]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]
    {with-context: [context [no-ack-within true]]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :action-not-pinned] [capability 'refund'] [tenant id=acme]]
#]]
 ]

 # ── §3.5 predicate library + gate-wellformed VALUE ──
 [case id=authz-020-predicate-lookup level=core gate=enforced
  [tags authz predicate library name-at-version]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:predicate $az 'no-ack-within@v1']]
#]]
  [out-text [#
[predicate name=no-ack-within version=v1 [params [duration] [of]] [rationale 'a request was issued and no acknowledgement arrived within the window — truth depends on the elapsed clock + the absence of an ack event, never on the principal willing it; an ack the instant it arrives makes it false'] [signature 'bundled-library:no-ack-within@v1']]
#]]
 ]

 [case id=authz-021-predicate-unknown-absence level=core gate=enforced
  [tags authz predicate unknown absence]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:predicate $az 'made-up@v9']]
#]]
  [out-text [# () #]]
 ]

 [case id=authz-022-gate-wellformed-valid level=core gate=enforced
  [tags authz gate-wellformed valid value]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[$authz:gate-wellformed [gate [all [incapacity [no-ack-within]] [state [gt '/x' 1]]]]]
#]]
  [out-text [# [valid] #]]
 ]

 [case id=authz-023-gate-wellformed-invalid-refusal level=core gate=enforced
  [tags authz gate-wellformed invalid refusal-trigger value bright-line]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[$authz:gate-wellformed [gate [all [refused]]]]
#]]
  [out-text [#
[invalid [reason :refusal-trigger] [code 'cx-err:CXER4701'] [detail "E_AUTHZ_REFUSAL_TRIGGER: gate leaf `refused` branches on a principal's choice — the bright line: a refusal-triggered grant is unexpressible (§4.4)"]]
#]]
 ]

 [case id=authz-024-gate-wellformed-invalid-state-only level=core gate=enforced
  [tags authz gate-wellformed invalid gate-illformed value]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[$authz:gate-wellformed [gate [all [state [gt '/x' 1]]]]]
#]]
  [out-text [#
[invalid [reason :gate-illformed] [code 'cx-err:CXER4702'] [detail 'E_AUTHZ_GATE_ILLFORMED: a gate needs ≥ 1 incapacity predicate — a state-only gate could fire while the principal is present and declining (§4.4)']]
#]]
 ]

 # ── §2.7/§3.5 verify-tier + §3.6 effective envelope ──
 [case id=authz-025-verify-tier-t1 level=core gate=enforced
  [tags authz verify-tier t1 signature]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:verify-tier $az
    [delegation d [tenant acme] [from [principal dana]] [to [agent o]]
      [capabilities [x]] [assurance :t1] [signature sig-ok]] 't1']]
#]]
  [out-text [# [verified [tier :t1]] #]]
 ]

 [case id=authz-026-verify-tier-t2-mofn level=core gate=enforced
  [tags authz verify-tier t2 m-of-n]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:verify-tier $az
    [delegation d [tenant acme] [from [principal dana]] [to [agent o]] [capabilities [x]] [assurance :t2]
      [signatures need=2 [signature by=alice] [signature by=bob] [signature invalid]]] 't2']]
#]]
  [out-text [# [verified [tier :t2]] #]]
 ]

 [case id=authz-027-check-deny-tier-unmet level=core gate=enforced
  [tags authz check deny tier-unmet]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d [tenant acme] [from [principal dana]] [to [agent o]]
      [capabilities [x]] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent o]] [capability x] [tenant acme] [require-tier :t2]]]]
#]]
  [out-text [#
[deny actor=o [code 'cx-err:CXER4700'] [reason :tier-unmet] [capability 'x'] [tenant id=acme]]
#]]
 ]

 [case id=authz-028-effective-envelope-clamp level=core gate=enforced
  [tags authz effective envelope intersection most-restrictive]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $sup [$authz:delegate $az
    [delegation d-sup [tenant acme] [from [principal boss]] [to [agent ops-1]]
      [capabilities [a] [b]] [assurance :t1] [signature s]]]]
  [= $d [$authz:delegate $az
    [delegation d [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [a] [b]] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability b] [tenant acme]]
    {envelopes: [envelopes [envelope from=boss [allow [a]]]]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :envelope-clamped] [capability 'b'] [tenant id=acme]]
#]]
 ]

 [case id=authz-029-effective-unrecorded-ignored level=core gate=enforced
  [tags authz effective envelope unrecorded ignored relationship]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [a] [b]] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability b] [tenant acme]]
    {envelopes: [envelopes [envelope from=ghost [allow [a]]]]}]]
#]]
  [out-text [#
[permit rooted-principal=dana [delegation 'd'] [via 'd'] [tier :t1] [capability 'b']]
#]]
 ]

 # ── §3.7 dry-run / explain (pure, deterministic) ──
 [case id=authz-030-dry-run-permit level=core gate=enforced
  [tags authz dry-run deterministic]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
