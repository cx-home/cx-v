[test-suite name=authz
  [doc [#
conformance fixtures for cx-stdlib/authz (spec/02-working/stdlib_authz.md §10).

   authz is the DECISION layer — principals, attenuating/time-bounded/revocable
   delegations, guardian grants behind an incapacity-typed [gate …], the
   signed+versioned incapacity-predicate library, and the single PEP decision
   function check/authorize. It COMPOSES the shipped crypto (verify) / session
   ((principal,tenant)) / journal+store (persist) and adds NO crypto, NO
   transport, NO new caps-capability of its own (§0/§1/§5). Each program imports
   the bundled module via [?lib 'cx-stdlib/authz'] and calls [$authz:VERB …].

   FOUR-CHANNEL MODEL (SAP §1, §2.4/§2.5):
     a decision         → a present [permit]/[deny] VALUE (a [deny] carries
                          cx-err:CXER4700 as DATA — it is NOT an [err]); check
                          is TOTAL (always permit or deny).
     a genuine fault    → [err] (malformed grant / bright-line violation /
                          signature failure / unknown predicate / closed store).
     an absent grant    → the absence channel () (revoked/expired/never-issued)
                          — NOT null, NOT a [deny]. null is NEVER produced.

   FAIL-CLOSED (§4): deny by default; any ambiguity denies. A guardian grant
   permits ONLY while its incapacity gate holds and ONLY its pinned [action …]
   — the instant the principal re-engages the gate goes false and check flips to
   [deny] with no explicit revoke (falsifiable-by-presence, §4.4 invariant 3).

   BRIGHT LINE as a TYPE CONSTRAINT (§4.4): a guardian [gate …] admits ONLY
   `incapacity` (signed-library name@version) + `state` (CXPath threshold)
   leaves over all/any/not. A leaf branching on a principal's CHOICE
   (declined/refused/consent/…) is rejected at AUTHORING → CXER4701. ≥1
   incapacity required → else CXER4702. Inline/ad-hoc incapacity → CXER4706.

   GRAMMAR ADAPTATION: the spec verb `gate-wellformed?` is spelled
   `gate-wellformed` (no trailing `?`) — `?` is not a NameChar in a call head
   [$authz:VERB …], the same constraint that forced net's addr->string →
   addr-to-string. Semantics identical (a [valid]/[invalid] VALUE).

   HERMETIC: an in-memory authority store per tenant (the capability-free
   posture, §5); a deterministic clock supplied via the request `as-of` /
   `until` as Unix-seconds ints; signatures are recorded markers (a non-empty,
   non-`invalid` [signature …] verifies for T1; T2 needs an M-of-N
   [signatures need=N …] quorum) so the negatives are testable without minting
   real keys. CXPath slices are quoted strings in code position (`/orders` bare
   is a division op). Id ranges:
     001-009  store + delegate + check permit/deny (no-grant/out-of-slice/
              unheld-capability/tenant-mismatch/expired) + find + grants-of
     010-013  revoke (+ cascade) → deny + find absence; idempotent revoke
     014-019  guardian grant: well-formed dormant + gate-holds permit +
              falsifiable-by-presence flip + state-threshold + pinned-action
     020-024  predicate library + gate-wellformed (valid/invalid VALUE)
     025-028  verify-tier T1/T2 + tier-unmet deny + effective envelope clamp
     029-032  dry-run determinism + explain (permit chain / deny first-link)
     040-052  NEGATIVE bright-line spine (CXER4701/4702/4703/4704/4706/4711/4712)
#]]

 # ── §3.1/§3.2/§3.4 store + delegate + the PEP decision ──
 [case id=authz-001-delegate-check-permit level=core gate=enforced
  [tags authz delegate check permit]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature sig-dana]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[permit rooted-principal=dana [delegation 'd-1'] [via 'd-1'] [tier :t1] [capability 'refund-duplicate']]
#]]
 ]

 [case id=authz-002-check-deny-no-grant level=core gate=enforced
  [tags authz check deny no-grant fail-closed]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:check $az [authz-request [actor [agent ghost]] [capability refund-duplicate] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ghost [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'refund-duplicate'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-003-check-deny-out-of-slice level=core gate=enforced
  [tags authz check deny out-of-slice]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/payments/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :out-of-slice] [capability 'refund-duplicate'] [slice '/payments/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-004-check-deny-unheld-capability level=core gate=enforced
  [tags authz check deny unheld-capability]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability delete-account] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'delete-account'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-005-check-deny-tenant-mismatch level=core gate=enforced
  [tags authz check deny tenant-mismatch partition]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/orders/9'] [tenant other]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :tenant-mismatch] [capability 'refund-duplicate'] [slice '/orders/9'] [tenant id=other]]
#]]
 ]

 [case id=authz-006-check-deny-expired level=core gate=enforced
  [tags authz check deny expired time-bound]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [over '/orders'] [until 1700000000] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [slice '/orders/9'] [tenant acme] [as-of 1800000000]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :expired] [capability 'refund'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-007-find-active level=core gate=enforced
  [tags authz find delegation]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [$authz:find $az 'd-1']]
#]]
  [out-text [#
[delegation id=d-1 mode=delegated state=active [tenant id=acme] [to [agent id=ops-1]] [from [principal id=dana]] [capabilities [refund]] [assurance :t1]]
#]]
 ]

 [case id=authz-008-grants-of level=core gate=enforced
  [tags authz grants-of sequence]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [$authz:grants-of $az [agent ops-1]]]
#]]
  [out-text [#
([delegation id=d-1 mode=delegated state=active [tenant id=acme] [to [agent id=ops-1]] [from [principal id=dana]] [capabilities [refund]] [assurance :t1]])
#]]
 ]

 [case id=authz-009-store-missing-tenant level=core gate=enforced
  [tags authz store tenant negative arg-invalid]
  [in-cx [# [empty] #]]
