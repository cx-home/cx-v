 [case id=authz-078-propose-approve-commit-roundtrip level=core gate=enforced
  [tags authz propose approve commit stream-6 678 L113]
  [meta [#
note: the L113 spine end-to-end: cx:propose constructs the proposal
note: value; approve mints the Lane-2 claim binding its ADDRESS;
note: commit verifies fail-closed (address, tier, version binding,
note: precondition re-check), executes the body, and journals the
note: transition on the durable tier. The outcome is the command
note: body result.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?def refund-order impure [effects] [preconditions [> $amount 0]] ($order='' $amount=10) $amount]
[?let [= $j [$journal:open "mem://authz-pm-078" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$cx:propose refund-order {order: 'o-1', amount: 42} {tenant: 'acme'}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p $a refund-order {actor: 'agent-1'}]]
#]]
  [out-text [#
42
#]]
 ]

 [case id=authz-086-propose-predicts-commit-trace level=core gate=enforced rule=EV-EFFECT-SET
  [tags authz propose commit out-effects trace stream-22 694 stream-6 678]
  [meta [#
note: the stream-6 booked pair, landing WITH the out-effects channel
note: (stream 22 W1): commit executes under (grant INTERSECT declared)
note: — exactly the set the proposal records — so the commit-run trace
note: shows the DECLARED effect admitted, in body order.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?lib 'cx-stdlib/time']
[?def stamp-order impure [effects [clock]] ($order='') [$time:now]]
[?let [= $j [$journal:open "mem://authz-pm-086" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$cx:propose stamp-order {order: 'o-1'} {tenant: 'acme'}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [= $r [$authz:commit $az $p $a stamp-order {actor: 'agent-1'}]]
  [ok]]
#]]
  [out-text [#
[ok]
#]]
  [out-effects [#
clock:time-now
#]]
 ]

 [case id=authz-087-commit-undeclared-effect-never-admitted level=core gate=enforced rule=EV-EFFECT-SET
  [tags authz commit out-effects trace discriminator CXER0271 stream-22 694 stream-6 678]
  [meta [#
note: the discriminator: the body attempts an UNDECLARED effect (env
note: under [effects clock]) — refused CXER0271 at the effect point,
note: and the trace shows NO env admission: an undeclared effect is
note: never exercised, not merely reported.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?lib 'cx-stdlib/env']
[?def leak-order impure [effects [clock]] ($order='') [$env:var "HOME"]]
[?let [= $j [$journal:open "mem://authz-pm-087" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$cx:propose leak-order {order: 'o-1'} {tenant: 'acme'}]]
  [= $a [$authz:approve $az $p {by: 'dana', signature: 'sig-1'}]]
  [$authz:commit $az $p $a leak-order {actor: 'agent-1'}]]
#]]
  [out-err [#
cx-err:CXER0271
#]]
  [out-effects [#
#]]
 ]

 [case id=authz-079-commit-tampered-proposal level=core gate=enforced
  [tags authz commit tamper address-binding CXER4714 stream-6 678 L113 L139]
