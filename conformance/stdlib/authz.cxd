  [= $x1 [$authz:debit $az 'd-1' {spend: 50.0, currency: 'USD', at: '2026-01-02T01:00:00Z'}]]
  [$authz:debit $az 'd-1' {spend: 60.0, currency: 'USD', at: '2026-01-02T02:00:00Z'}]]
#]]
  [out-text [#
[deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :spend] [delegation 'd-1']]
#]]
 ]

