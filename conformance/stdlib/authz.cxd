#]]
 ]

 [case id=authz-049-cross-tenant-delegate level=core gate=enforced
  [tags authz negative arg-invalid partition CXER4711]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:delegate $az
    [delegation d [tenant other] [from [principal a]] [to [agent o]] [capabilities [x]] [assurance :t1] [signature s]]]]
#]]
  [out-err [#
cx-err:CXER4711
#]]
 ]

 [case id=authz-050-closed-store level=core gate=enforced
  [tags authz negative handle-closed CXER4712 closeable]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $c [$authz:close $az]]
  [$authz:check $az [authz-request [actor [agent x]] [capability y] [tenant acme]]]]
#]]
  [out-err [#
cx-err:CXER4712
#]]
 ]

 [case id=authz-051-gate-not-combinator-rejected level=core gate=enforced
  [tags authz gate-wellformed not-combinator bright-line hostile security]
  [doc [#
HOSTILE (blocker, authority-WIDENING): `not` is the CX symbolic operator, so a
`[not [incapacity x]]` term in a gate is EAGERLY EVALUATED to a bare scalar
`false` before authz sees it. The old scan silently dropped the scalar term,
so `[all [incapacity X] [not [incapacity X]]]` validated AS IF the not-term
were absent — silently weakening a multi-term gate. It must be rejected
fail-closed; `not` is not an admissible gate combinator (§2.2 = all/any).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[$authz:gate-wellformed [gate [all [incapacity [no-ack-within]] [not [incapacity [no-ack-within]]]]]]
#]]
  [out-text [#
[invalid [reason :gate-illformed] [code 'cx-err:CXER4702'] [detail 'E_AUTHZ_GATE_ILLFORMED: a gate term collapsed to a bare scalar — `not`/operator forms are not gate combinators; a gate is all/any over incapacity/state leaves only (§2.2)']]
#]]
 ]

 [case id=authz-052-verify-tier-expired level=core gate=enforced
  [tags authz verify-tier CXER4705 expiry clock hostile]
  [doc [#
HOSTILE (major): CXER4705 (grant past `until` in a hard verification) was
DEAD — the verify-tier def forwarded only 3 args, dropping the opts/clock, so
the clock was always 0 and expiry never fired. The def now forwards $opts; a
grant whose `until` precedes the supplied `now` is rejected CXER4705.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:verify-tier $az [delegation d [tenant acme] [from [principal dana]] [to [agent o]] [capabilities [x]] [assurance :t1] [signature sig-ok] [until 1000]] 't1' {now: 2000}]]
#]]
  [out-err [#
cx-err:CXER4705
#]]
 ]

 [case id=authz-053-verify-tier-not-expired level=core gate=enforced
  [tags authz verify-tier clock not-expired]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:verify-tier $az [delegation d [tenant acme] [from [principal dana]] [to [agent o]] [capabilities [x]] [assurance :t1] [signature sig-ok] [until 5000]] 't1' {now: 2000}]]
#]]
  [out-text [#
[verified [tier :t1]]
#]]
 ]

 [case id=authz-054-window-escalation level=core gate=enforced
  [tags authz negative escalation window attenuation CXER4703 i5-stream4]
  [doc [#
The WINDOW axis is issue-time SUB-checked (the four-axis pin, §4.2): a
child delegation naming an [until] LATER than its parent's is an
escalation - it would outlive the authority it attenuates. Before the
W4 pin this was enforced at decision time only (the identity model's
chain rule §5.2 always required the issue-time check).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-p [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [until 5000] [assurance :t1] [signature s]]]]
  [$authz:delegate $az
    [delegation d-c [tenant acme] [from [agent ops-1]] [to [agent sub-1]]
      [capabilities [refund]] [attenuates d-p] [until 9000] [assurance :t1] [signature s]]]]
#]]
  [out-err [#
cx-err:CXER4703
#]]
 ]

 [case id=authz-055-window-inherit level=core gate=enforced
  [tags authz window attenuation inherit i5-stream4]
  [doc [#
A child with NO [until] under a windowed parent INHERITS the parent's
window at issue - it cannot outlive it (§4.2). The materialized child
carries the inherited [until].
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-p [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [until 5000] [assurance :t1] [signature s]]]]
  [= $c [$authz:delegate $az
    [delegation d-c [tenant acme] [from [agent ops-1]] [to [agent sub-1]]
      [capabilities [refund]] [attenuates d-p] [assurance :t1] [signature s]]]]
  [$text $c/until]]
#]]
  [out-text [#
'5000'
#]]
 ]

 [case id=authz-056-bounds-carriage level=core gate=enforced
  [tags authz bounds budget carriage i5-stream4]
  [doc [#
[bounds ...] rides the grant value (§2.2, stream 6 L112): a delegation
MAY carry [bounds [rate N :per DUR] [count N]] and the materialized
record carries it verbatim - attenuation, revocation, explain for free.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [rate 2 :per '1m'] [count 3]] [assurance :t1] [signature s]]]]
  [seq [$text $d/bounds/count] [$text $d/bounds/rate]]]
#]]
  [out-text [#
[seq '3' '2per1m']
#]]
 ]

 [case id=authz-057-bounds-rate-escalation level=core gate=enforced
  [tags authz negative escalation bounds rate CXER4703 i5-stream4]
  [doc [#
The BOUNDS axis is the fourth issue-time SUB-check (§4.2): a child
naming a FASTER rate than its parent (10/1m over 5/1m) is an
escalation - a bound never widens.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-p [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [rate 5 :per '1m']] [assurance :t1] [signature s]]]]
  [$authz:delegate $az
    [delegation d-c [tenant acme] [from [agent ops-1]] [to [agent sub-1]]
      [capabilities [refund]] [attenuates d-p] [bounds [rate 10 :per '1m']] [assurance :t1] [signature s]]]]
#]]
  [out-err [#
cx-err:CXER4703
#]]
 ]

 [case id=authz-058-bounds-count-escalation level=core gate=enforced
  [tags authz negative escalation bounds count CXER4703 i5-stream4]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-p [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [count 3]] [assurance :t1] [signature s]]]]
  [$authz:delegate $az
    [delegation d-c [tenant acme] [from [agent ops-1]] [to [agent sub-1]]
      [capabilities [refund]] [attenuates d-p] [bounds [count 5]] [assurance :t1] [signature s]]]]
#]]
  [out-err [#
cx-err:CXER4703
#]]
 ]

 [case id=authz-059-bounds-shared-meter level=core gate=enforced
  [tags authz bounds shared-meter composition i5-stream4]
  [doc [#
A sub-delegation with NO [bounds] under a bounded parent SHARES the
issuer's meter (a pool never multiplies authority, §2.2) - it issues
cleanly and carries no bounds of its own.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-p [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [rate 5 :per '1m']] [assurance :t1] [signature s]]]]
  [= $c [$authz:delegate $az
    [delegation d-c [tenant acme] [from [agent ops-1]] [to [agent sub-1]]
      [capabilities [refund]] [attenuates d-p] [assurance :t1] [signature s]]]]
  [$count $c/bounds]]
#]]
  [out-text [#
0
#]]
 ]

 [case id=authz-060-budget-exhausted-rate level=core gate=enforced
  [tags authz bounds budget deny rate CXER4713 i5-stream4]
  [doc [#
Meter exhaustion at the PEP is a VALUE (§2.2/§8): the meter reading
rides the opts (the materialized-snapshot posture - check stays pure);
an empty token bucket denies :budget-exhausted with CXER4713 as data,
[conjunct :rate] naming the failing conjunct (D-C1), and [retry-after]
= the bucket's next-token interval (rate 2/1m, 0 tokens -> 30s). An
ABSENT meter reading is a FRESH meter (no recorded usage), never a
denial.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [rate 2 :per '1m']] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]
    {meters: [meters [meter id='d-1' tokens=0]]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :rate] [retry-after 30] [capability 'refund'] [tenant id=acme]]
#]]
 ]

 [case id=authz-061-budget-exhausted-count level=core gate=enforced
  [tags authz bounds budget deny count CXER4713 i5-stream4]
  [doc [#
A monotone [count N] bound never replenishes: exhaustion denies with
NO [retry-after] (there is no instant at which retrying helps) -
:budget-exhausted names [conjunct :count].
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [count 3]] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]
    {meters: [meters [meter id='d-1' count-used=3]]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :count] [capability 'refund'] [tenant id=acme]]
#]]
 ]

 [case id=authz-062-budget-available-permit level=core gate=enforced
  [tags authz bounds budget permit i5-stream4]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [rate 2 :per '1m'] [count 3]] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]
    {meters: [meters [meter id='d-1' tokens=1.5 count-used=2]]}]]
#]]
  [out-text [#
[permit rooted-principal=dana [delegation 'd-1'] [via 'd-1'] [tier :t1] [capability 'refund']]
#]]
 ]

 [case id=authz-063-bitemporal-coherence-coordinates level=core gate=enforced
  [tags authz check bitemporal coherence as-of at-seq stream-8 680 L121]
  [; the L121 coherence rule: the decision VALUE records BOTH temporal
     coordinates for audit — as-of (the valid-time decision instant)
     and the context snapshot's TX position (at-seq from a journal
     snapshot passed as with-context). Permit AND deny both stamp;
     a check without the opts stamps nothing (byte-identical shipped
     shape) — a context making no TX claim leaves the coordinate
     VISIBLY absent, so an incoherent pair is constructible only
     explicitly. "What would we have decided at position P, for
     instant T" is thereby specifiable. ]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/authz']
[?let [= $j [$journal:open "mem://bt-authz2" "acme"]]
[= $e1 [$journal:append $j [order total=100] {actor: "u" authority: "g"}]]
[= $snap [$journal:snapshot $j [?fn ($acc $e) [+ $acc 1]] 0 {sign: false}]]
[= $az [$authz:store {tenant: 'acme'}]]
[= $d [$authz:delegate $az
  [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
    [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
[= $p [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/orders/9'] [tenant acme]] {as-of: "2026-08-03T00:00:00Z" with-context: $snap}]]
[= $dny [$authz:check $az [authz-request [actor [agent ops-1]] [capability delete-account] [slice '/orders/9'] [tenant acme]] {as-of: "2026-08-03T00:00:00Z" with-context: $snap}]]
[= $bare [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/orders/9'] [tenant acme]]]]
  [coherence-rule permit-as-of=$p/@as-of permit-at=$p/@at-seq deny-as-of=$dny/@as-of deny-at=$dny/@at-seq bare-has-coord=[$exists $bare/@at-seq]]]
#]]
  [out-text [#
[coherence-rule permit-as-of='2026-08-03T00:00:00Z' permit-at=1 deny-as-of='2026-08-03T00:00:00Z' deny-at=1 bare-has-coord=false]
#]]
 ]
]
