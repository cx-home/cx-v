[test-suite name=authz ring=2
  [doc [#
conformance fixtures for cx-stdlib/authz (spec/02-working/stdlib_authz.md §10).

   authz is the DECISION layer — principals, attenuating/time-bounded/revocable
   delegations, guardian grants behind an incapacity-typed [gate …], the
   signed+versioned incapacity-predicate library, and the single PEP decision
   function check/authorize. It COMPOSES the shipped crypto (verify) / session
   ((principal,tenant)) / journal+store (persist) and adds NO crypto, NO
   transport, NO new caps-capability of its own (§0/§1/§5). Each program imports
   the bundled module via [?lib 'cx-stdlib/authz'] and calls [$authz:VERB …].

   FOUR-CHANNEL MODEL (SAP §1, §2.4/§2.5):
     a decision         → a present [permit]/[deny] VALUE (a [deny] carries
                          cx-err:CXER4700 as DATA — it is NOT an [err]); check
                          is TOTAL (always permit or deny).
     a genuine fault    → [err] (malformed grant / bright-line violation /
                          signature failure / unknown predicate / closed store).
     an absent grant    → the absence channel () (revoked/expired/never-issued)
                          — NOT null, NOT a [deny]. null is NEVER produced.

   FAIL-CLOSED (§4): deny by default; any ambiguity denies. A guardian grant
   permits ONLY while its incapacity gate holds and ONLY its pinned [action …]
   — the instant the principal re-engages the gate goes false and check flips to
   [deny] with no explicit revoke (falsifiable-by-presence, §4.4 invariant 3).

   BRIGHT LINE as a TYPE CONSTRAINT (§4.4): a guardian [gate …] admits ONLY
   `incapacity` (signed-library name@version) + `state` (CXPath threshold)
   leaves over all/any/not. A leaf branching on a principal's CHOICE
   (declined/refused/consent/…) is rejected at AUTHORING → CXER4701. ≥1
   incapacity required → else CXER4702. Inline/ad-hoc incapacity → CXER4706.

   GRAMMAR ADAPTATION: the spec verb `gate-wellformed?` is spelled
   `gate-wellformed` (no trailing `?`) — `?` is not a NameChar in a call head
   [$authz:VERB …], the same constraint that forced net's addr->string →
   addr-to-string. Semantics identical (a [valid]/[invalid] VALUE).

   HERMETIC: an in-memory authority store per tenant (the capability-free
   posture, §5); a deterministic clock supplied via the request `as-of` /
   `until` as Unix-seconds ints; signatures are recorded markers (a non-empty,
   non-`invalid` [signature …] verifies for T1; T2 needs an M-of-N
   [signatures need=N …] quorum) so the negatives are testable without minting
   real keys. CXPath slices are quoted strings in code position (`/orders` bare
   is a division op). Id ranges:
     001-009  store + delegate + check permit/deny (no-grant/out-of-slice/
              unheld-capability/tenant-mismatch/expired) + find + grants-of
     010-013  revoke (+ cascade) → deny + find absence; idempotent revoke
     014-019  guardian grant: well-formed dormant + gate-holds permit +
              falsifiable-by-presence flip + state-threshold + pinned-action
     020-024  predicate library + gate-wellformed (valid/invalid VALUE)
     025-028  verify-tier T1/T2 + tier-unmet deny + effective envelope clamp
     029-032  dry-run determinism + explain (permit chain / deny first-link)
     040-052  NEGATIVE bright-line spine (CXER4701/4702/4703/4704/4706/4711/4712)
#]]

 # ── §3.1/§3.2/§3.4 store + delegate + the PEP decision ──
 [case id=authz-001-delegate-check-permit level=core gate=enforced
  [tags authz delegate check permit]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature sig-dana]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[permit rooted-principal=dana [delegation 'd-1'] [via 'd-1'] [tier :t1] [capability 'refund-duplicate']]
#]]
 ]

 [case id=authz-002-check-deny-no-grant level=core gate=enforced
  [tags authz check deny no-grant fail-closed]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [$authz:check $az [authz-request [actor [agent ghost]] [capability refund-duplicate] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ghost [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'refund-duplicate'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-003-check-deny-out-of-slice level=core gate=enforced
  [tags authz check deny out-of-slice]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/payments/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :out-of-slice] [capability 'refund-duplicate'] [slice '/payments/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-004-check-deny-unheld-capability level=core gate=enforced
  [tags authz check deny unheld-capability]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability delete-account] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'delete-account'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-005-check-deny-tenant-mismatch level=core gate=enforced
  [tags authz check deny tenant-mismatch partition]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund-duplicate]] [over '/orders'] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund-duplicate] [slice '/orders/9'] [tenant other]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :tenant-mismatch] [capability 'refund-duplicate'] [slice '/orders/9'] [tenant id=other]]
#]]
 ]

 [case id=authz-006-check-deny-expired level=core gate=enforced
  [tags authz check deny expired time-bound]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [over '/orders'] [until 1700000000] [assurance :t1] [signature s]]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [slice '/orders/9'] [tenant acme] [as-of 1800000000]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :expired] [capability 'refund'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-007-find-active level=core gate=enforced
  [tags authz find delegation]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [$authz:find $az 'd-1']]
#]]
  [out-text [#
[delegation id=d-1 mode=delegated state=active [tenant id=acme] [to [agent id=ops-1]] [from [principal id=dana]] [capabilities [refund]] [assurance :t1]]
#]]
 ]

 [case id=authz-008-grants-of level=core gate=enforced
  [tags authz grants-of sequence]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [$authz:grants-of $az [agent ops-1]]]
#]]
  [out-text [#
([delegation id=d-1 mode=delegated state=active [tenant id=acme] [to [agent id=ops-1]] [from [principal id=dana]] [capabilities [refund]] [assurance :t1]])
#]]
 ]

 [case id=authz-009-store-missing-tenant level=core gate=enforced
  [tags authz store tenant negative arg-invalid]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[$authz:store {}]
#]]
  [out-err [#
cx-err:CXER4711
#]]
 ]

 # ── §3.2 revoke → absence-for-check (§2.5) ──
 [case id=authz-010-revoke-then-deny level=core gate=enforced
  [tags authz revoke deny]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [over '/orders'] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-1']]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [slice '/orders/9'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'refund'] [slice '/orders/9'] [tenant id=acme]]
#]]
 ]

 [case id=authz-011-revoke-then-find-absence level=core gate=enforced
  [tags authz revoke find absence]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-1']]
  [$authz:find $az 'd-1']]
#]]
  [out-text [# () #]]
 ]

 [case id=authz-012-revoke-cascade level=core gate=enforced
  [tags authz revoke cascade attenuation]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?let [= $az [$authz:store {tenant: 'acme'}]]
  [= $p [$authz:delegate $az
    [delegation d-par [tenant acme] [from [principal dana]] [to [agent mid]]
      [capabilities [x]] [over '/s'] [assurance :t1] [signature s]]]]
  [= $c [$authz:delegate $az
    [delegation d-chi [tenant acme] [from [agent mid]] [to [agent leaf]]
      [capabilities [x]] [over '/s'] [attenuates d-par] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-par' {cascade: true}]]
  [$authz:check $az [authz-request [actor [agent leaf]] [capability x] [slice '/s/1'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=leaf [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'x'] [slice '/s/1'] [tenant id=acme]]
#]]
 ]

 [case id=authz-063-durability-reopen-permit level=core gate=enforced
  [tags authz durability journal replay stream-6 678 713]
  [meta [#
note: #713 item 4 (RULED) — the persisted-grant-then-reopen path. A
note: store bound to a journal (opts.journal, sect-3.1) appends the
note: sect-2.6 attributed issue-event; a NEW store opened on the SAME
note: journal replays the authz stream and rebuilds the grant — trust
note: state survives the store handle (and, with a durable journal
note: backend, the process).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-dur-063" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [= $c [$authz:close $az]]
  [= $az2 [$authz:store {tenant: 'acme', journal: $j}]]
  [$authz:check $az2 [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]]]
#]]
  [out-text [#
[permit rooted-principal=dana [delegation 'd-1'] [via 'd-1'] [tier :t1] [capability 'refund']]
#]]
 ]

 [case id=authz-064-durability-reopen-revoked level=core gate=enforced
  [tags authz durability journal replay revoke stream-6 678 713]
  [meta [#
note: a revocation is an authz-revoked event on the same stream; the
note: reopened store replays issue THEN revoke — the grant stays
note: absent-for-check across the reopen (no resurrection).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-dur-064" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-1']]
  [= $c [$authz:close $az]]
  [= $az2 [$authz:store {tenant: 'acme', journal: $j}]]
  [$authz:check $az2 [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'refund'] [tenant id=acme]]
#]]
 ]

 [case id=authz-065-store-fault-on-append level=core gate=enforced
  [tags authz durability journal fault CXER4710 fail-closed stream-6 678 713]
  [meta [#
note: journal-first, fail-closed (W3 R7) — a persisting verb whose
note: sect-2.6 append faults (here: the bound journal was closed) is
note: the declared store fault CXER4710, live since the durable tier
note: landed.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-dur-065" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $x [$journal:close $j]]
  [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]]]
#]]
  [out-err [#
cx-err:CXER4710
#]]
 ]

 [case id=authz-066-store-fault-no-mutation level=core gate=enforced
  [tags authz durability journal fault fail-closed no-mutation stream-6 678 713]
  [meta [#
note: the R7 other half — on an append fault the in-process mutation
note: does NOT apply: live trust state never runs ahead of its log.
note: The faulted delegate is recovered by [?fallback]; the follow-up
note: check on the SAME still-open store denies (no grant installed).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-dur-066" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $x [$journal:close $j]]
  [= $e [?fallback [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [assurance :t1] [signature s]]] [recover-with :faulted]]]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'refund'] [tenant id=acme]]
#]]
 ]

 [case id=authz-067-durability-cascade-reopen level=core gate=enforced
  [tags authz durability journal replay cascade stream-6 678 713]
  [meta [#
note: W3 R8 — a cascade revoke appends ONE authz-revoked event per
note: affected id, so replay is a trivial fold and the audit stream is
note: exact. Parent + attenuating child both stay revoked across the
note: reopen.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-dur-067" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $p [$authz:delegate $az
    [delegation d-par [tenant acme] [from [principal dana]] [to [agent mid]]
      [capabilities [x]] [over '/s'] [assurance :t1] [signature s]]]]
  [= $ch [$authz:delegate $az
    [delegation d-chi [tenant acme] [from [agent mid]] [to [agent leaf]]
      [capabilities [x]] [over '/s'] [attenuates d-par] [assurance :t1] [signature s]]]]
  [= $r [$authz:revoke $az 'd-par' {cascade: true}]]
  [= $c [$authz:close $az]]
  [= $az2 [$authz:store {tenant: 'acme', journal: $j}]]
  [$authz:check $az2 [authz-request [actor [agent leaf]] [capability x] [slice '/s/1'] [tenant acme]]]]
#]]
  [out-text [#
[deny actor=leaf [code 'cx-err:CXER4700'] [reason :no-grant] [capability 'x'] [slice '/s/1'] [tenant id=acme]]
#]]
 ]

 [case id=authz-068-meters-fold-count level=core gate=enforced
  [tags authz budgets meters fold debit stream-6 678 L112]
  [meta [#
note: L112 meter-as-fold (W4 R10) — meters folds the authz stream's
note: debit events into the EXACT element the pure PEP reads; count is
note: monotone. Only declared conjunct axes are emitted.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-bud-068" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [count 3]] [assurance :t1] [signature s]]]]
  [= $x1 [$authz:debit $az 'd-1']]
  [= $x2 [$authz:debit $az 'd-1']]
  [$authz:meters $az]]
#]]
  [out-text [#
[meters [meter id=d-1 count-used=2]]
#]]
 ]

 [case id=authz-069-debit-exhausts-count level=core gate=enforced
  [tags authz budgets debit commit-point CXER4713 stream-6 678 L112]
  [meta [#
note: L112 commit-point enforcement (W4 R11) — debit re-folds UNDER the
note: stream commit lock before appending; exhausted at commit = the
note: CXER4713-carrying deny VALUE naming the failing conjunct (D-C1)
note: and the meter-owning delegation, and NO event is written. count
note: never replenishes, so no retry-after (the sect-8 rule).
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-bud-069" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [count 2]] [assurance :t1] [signature s]]]]
  [= $x1 [$authz:debit $az 'd-1']]
  [= $x2 [$authz:debit $az 'd-1']]
  [$authz:debit $az 'd-1']]
#]]
  [out-text [#
[deny [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :count] [delegation 'd-1']]
#]]
 ]

 [case id=authz-070-fold-then-check-denies level=core gate=enforced
  [tags authz budgets meters check pure-pep stream-6 678 L112]
  [meta [#
note: the with-context posture end-to-end — the caller folds
note: (meters) then checks; check STAYS PURE over the supplied
note: snapshot and denies :budget-exhausted from the folded reading.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-bud-070" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [count 2]] [assurance :t1] [signature s]]]]
  [= $x1 [$authz:debit $az 'd-1']]
  [= $x2 [$authz:debit $az 'd-1']]
  [$authz:check $az [authz-request [actor [agent ops-1]] [capability refund] [tenant acme]]
    {meters: [$authz:meters $az]}]]
#]]
  [out-text [#
[deny actor=ops-1 [code 'cx-err:CXER4713'] [reason :budget-exhausted] [conjunct :count] [capability 'refund'] [tenant id=acme]]
#]]
 ]

 [case id=authz-071-rate-bucket-refill level=core gate=enforced
  [tags authz budgets meters rate token-bucket stream-6 678 L112]
  [meta [#
note: rate = token-bucket replay over the debit event timestamps (the
note: rate-limit semantics verbatim): capacity 2, two debits at t0
note: empty the bucket; 30s later at 2-per-1m the fold has refilled
note: exactly one token. at/now are the controllable clock (the
note: journal opts.clock posture) so the arithmetic is byte-stable.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-bud-071" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [rate 2 :per '1m']] [assurance :t1] [signature s]]]]
  [= $x1 [$authz:debit $az 'd-1' {at: '2026-01-01T00:00:00Z'}]]
  [= $x2 [$authz:debit $az 'd-1' {at: '2026-01-01T00:00:00Z'}]]
  [$authz:meters $az {now: '2026-01-01T00:00:30Z'}]]
#]]
  [out-text [#
[meters [meter id=d-1 tokens=1]]
#]]
 ]

 [case id=authz-072-spend-window-utc-aligned level=core gate=enforced
  [tags authz budgets meters spend utc-window stream-6 678 L112]
  [meta [#
note: spend windows are UTC-Z aligned (L112; epoch-aligned = the
note: deterministic implementation, never tenant-local midnight): a
note: 60 spent BEFORE the day boundary is outside the current 1d
note: window; only the 50 spent after midnight counts at now.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-bud-072" "acme"]]
  [= $az [$authz:store {tenant: 'acme', journal: $j}]]
  [= $d [$authz:delegate $az
    [delegation d-1 [tenant acme] [from [principal dana]] [to [agent ops-1]]
      [capabilities [refund]] [bounds [spend 100.0 :currency :USD :per '1d']] [assurance :t1] [signature s]]]]
  [= $x1 [$authz:debit $az 'd-1' {spend: 60.0, currency: 'USD', at: '2026-01-01T23:00:00Z'}]]
  [= $x2 [$authz:debit $az 'd-1' {spend: 50.0, currency: 'USD', at: '2026-01-02T01:00:00Z'}]]
  [$authz:meters $az {now: '2026-01-02T02:00:00Z'}]]
#]]
  [out-text [#
[meters [meter id=d-1 spend-used=50.0]]
#]]
 ]

 [case id=authz-073-debit-refuses-overspend level=core gate=enforced
  [tags authz budgets debit spend commit-point CXER4713 stream-6 678 L112]
  [meta [#
note: commit-side spend headroom is STRICT — spent + pending must stay
note: within the window limit (50 + 60 > 100 refuses); refunds never
note: credit back, so the only path to headroom is the next window.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/authz']
[?lib 'cx-stdlib/journal' as=journal]
[?let [= $j [$journal:open "mem://authz-bud-073" "acme"]]
