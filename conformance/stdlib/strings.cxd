[test-suite name=strings

 [case id=strings-001-upper level=core
  [tags strings upper case]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/strings']
[$strings:upper "hello"]
#]]
  [out-text [#
'HELLO'
#]]
 ]

 [case id=strings-002-lower level=core
  [tags strings lower case]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/strings']
[$strings:lower "HeLLo"]
#]]
  [out-text [#
'hello'
#]]
 ]

 [case id=strings-003-upper-sharp-s level=core
  [tags strings upper unicode sharp-s]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/strings']
[$strings:upper "straße"]
#]]
  [out-text [#
'STRASSE'
#]]
 ]

