[test-suite name=bytes ring=1
  [doc [#
conformance/stdlib/bytes.cxd — cx-stdlib/bytes (spec/std-lib/bytes.md §6).

   Auto-run by vcx/tests/code_eval_fixtures_test.v :: test_stdlib_module_fixtures
   (every conformance/stdlib/*.cxd, no whitelist). Each program imports the
   bundled module then calls [$bytes:<fn> args]; the last expression is the
   result. Inputs are strings (bytes round-trips render non-deterministically
   as raw byte strings, so outputs are composed back to string / int / bool).
#]]

 [case id=bytes-001-hex-roundtrip level=core
  [tags bytes hex roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/bytes']
[$bytes:to-hex [$bytes:from-hex "deadbeef"]]
#]]
  [out-text [#
'deadbeef'
#]]
 ]

