[test-suite name=path ring=1
  [doc [#
conformance fixtures for cx-stdlib/path (spec/std-lib/path.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/path']
   (resolver MUST be quoted) then calls [$path:fn args]. The LAST
   expression is the rendered result. String scalars render quoted;
   bool bare; sequences in paren form (a, b, c). Error fixtures use
   --- out_err with the bare CXER code.
#]]

 [case id=path-001-dirname level=core
  [tags path dirname]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/path']
[$path:dirname "/a/b/c.txt"]
#]]
  [out-text [#
'/a/b'
#]]
 ]

 [case id=path-002-basename level=core
  [tags path basename]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/path']
[$path:basename "/a/b/c.txt"]
#]]
  [out-text [#
'c.txt'
#]]
 ]

 [case id=path-003-extension level=core
  [tags path extension]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/path']
[$path:extension "/a/b/c.txt"]
#]]
  [out-text [#
'.txt'
#]]
 ]

 [case id=path-004-extension-none level=core
  [tags path extension empty]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/path']
[$path:extension "/a/b/c"]
#]]
  [out-text [#
''
#]]
 ]

