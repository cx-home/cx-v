 # separator/list-separator are platform-specific (§3.7: `/` and `:` on POSIX,
 # `\` and `;` on Windows). The POSIX values asserted below are correct on the
 # conformance reference platform (see README.md "Reference platform — POSIX");
 # on Windows these cases are expected to differ.
 [case id=path-052-separator level=core
  [tags path separator]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/path']
[$path:separator]
#]]
  [out-text [#
'/'
#]]
 ]

 [case id=path-053-list-separator level=core
  [tags path list-separator]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/path']
[$path:list-separator]
#]]
  [out-text [#
':'
#]]
 ]
]
