[?lib 'cx-stdlib/geo']
[$geo:within-bbox [$geo:point 0.0 179.0] [$geo:bbox ([$geo:point -10.0 170.0], [$geo:point 10.0 -170.0])]]
#]]
  [out-text [#
true
#]]
 ]

