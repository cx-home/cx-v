 # ── §3.4 Polygon operations ────────────────────────────────────────────

 # Degenerate ring with zero enclosed area (fully collinear points) is INVALID
 # per spec/std-lib/geo.md §3.4 — polygon-is-valid returns false and
 # polygon-area raises CXER3602 (consistent with OGC SFA rejecting degenerate
 # geometry); it does NOT return 0.0.
 [case id=geo-028-polygon-area-degenerate-zero level=core
  [tags geo polygon-area degenerate CXER3602]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:polygon-area [$geo:polygon ([$geo:point 0.0 0.0], [$geo:point 0.0 1.0], [$geo:point 0.0 2.0], [$geo:point 0.0 0.0])] "km2"]
#]]
  [out-err [#
cx-err:CXER3602
#]]
 ]

 [case id=geo-029-polygon-area-invalid level=core
  [tags geo polygon-area invalid CXER3602]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:polygon-area [$geo:polygon-with-holes ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 0.0], [$geo:point 10.0 10.0], [$geo:point 0.0 0.0]) ()] "km2"]
#]]
  [out-err [#
cx-err:CXER3602
#]]
 ]

 [case id=geo-030-polygon-perimeter-degenerate level=core
  [tags geo polygon-perimeter degenerate]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:polygon-perimeter [$geo:polygon ([$geo:point 5.0 5.0], [$geo:point 5.0 5.0], [$geo:point 5.0 5.0], [$geo:point 5.0 5.0])] "km"]
#]]
  [out-text [#
0.0
#]]
 ]

