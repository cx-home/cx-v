#]]
  [out-text [#
false
#]]
 ]

 # ── §3.5 Normalization ─────────────────────────────────────────────────

 # §3.5: normalize-lat(95.0) -> 90.0 (clamp; latitudes do not wrap).
 [case id=geo-040-normalize-lat-clamp level=core
  [tags geo normalize-lat clamp]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:normalize-lat 95.0]
#]]
  [out-text [#
90.0
#]]
 ]

