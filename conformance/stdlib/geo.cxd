[test-suite name=geo
  [doc [#
conformance fixtures for cx-stdlib/geo (spec/std-lib/geo.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/geo']
   (resolver MUST be quoted) then calls [$geo:fn args]. The LAST expression
   is the rendered result. String scalars render quoted; bool bare; floats
   with a decimal point. Error fixtures use [out-err] with the bare CXER code.

   Element-returning constructors/operations have NO spec-defined canonical
   element render, so cases extract a scalar field (e.g. $p/lat) or feed the
   element into a predicate / format function whose output IS spec-defined,
   rather than asserting an unspecified element serialization.

   Computed-float results (distance, bearing, area, perimeter) are given only
   APPROXIMATELY in the spec (§6 tolerances, e.g. "≈ 3944 km within 1%"); the
   exact float a conforming impl prints is unspecified, so those happy-path
   cases carry a TODO(spec-ambiguous) marker. Their error/edge behavior and
   the exactly-specified normalize/predicate results are pinned firmly.
#]]

 # ── §3.1 Construction ──────────────────────────────────────────────────

 [case id=geo-001-point-lat level=core
  [tags geo point construction]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:point 37.7749 -122.4194]] $p/lat]
#]]
  [out-text [#
37.7749
#]]
 ]

 [case id=geo-002-point-lon level=core
  [tags geo point construction]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:point 37.7749 -122.4194]] $p/lon]
#]]
  [out-text [#
-122.4194
#]]
 ]

 [case id=geo-003-point-invalid-lat level=core
  [tags geo point construction CXER3601]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:point 95.0 0.0]
#]]
  [out-err [#
cx-err:CXER3601
#]]
 ]

 # §2.1: longitude is CYCLIC — point wraps an out-of-range longitude into
 # [-180, 180] losslessly (200 → -160), never raising. (Out-of-range LATITUDE
 # is the hard error — see geo-003.)
 [case id=geo-004-point-wrap-lon level=core
  [tags geo point construction wrap-longitude]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:point 0.0 200.0]] $p/lon]
#]]
  [out-text [#
-160.0
#]]
 ]

 [case id=geo-005-bbox-min-lat level=core
  [tags geo bbox construction]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:bbox ([$geo:point 37.7 -122.5], [$geo:point 37.85 -122.35])]] $bb/min-lat]
#]]
  [out-text [#
37.7
#]]
 ]

 [case id=geo-006-bbox-max-lon level=core
  [tags geo bbox construction]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $bb [$geo:bbox ([$geo:point 37.7 -122.5], [$geo:point 37.85 -122.35])]] $bb/max-lon]
#]]
  [out-text [#
-122.35
#]]
 ]

 [case id=geo-007-polygon-auto-closes level=core
  [tags geo polygon construction auto-close]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:polygon-is-closed [$geo:polygon ([$geo:point 37.7 -122.5], [$geo:point 37.7 -122.4], [$geo:point 37.8 -122.4], [$geo:point 37.8 -122.5])]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=geo-008-polygon-with-holes-valid level=core
  [tags geo polygon-with-holes construction holes]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:polygon-is-closed [$geo:polygon-with-holes ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0]) (([$geo:point 2.0 2.0], [$geo:point 2.0 4.0], [$geo:point 4.0 4.0], [$geo:point 4.0 2.0], [$geo:point 2.0 2.0]))]]
#]]
  [out-text [#
true
#]]
 ]

 # ── §3.2 Distance and bearing ──────────────────────────────────────────

 # distance NYC→LAX is specified as "≈ 3944 km within 1% tolerance" (§6); the
 # exact float a conforming Haversine impl prints is unspecified, so match the
 # canonical band center with a relative tolerance rather than exact tokens.
 [case id=geo-009-distance-haversine-nyc-lax level=core tol=0.01
  [tags geo distance haversine]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:distance [$geo:point 40.7128 -74.0060] [$geo:point 33.9416 -118.4085] "km"]
#]]
  [out-text [#
3944.0
#]]
 ]

 [case id=geo-010-distance-invalid-unit level=core
  [tags geo distance unit CXER3601]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:distance [$geo:point 0.0 0.0] [$geo:point 0.0 1.0] "furlongs"]
#]]
  [out-err [#
cx-err:CXER3601
#]]
 ]

 # Vincenty result is bounded as "within ~0.3-0.5% of Haversine" (§6); exact
 # float unspecified, so center on the canonical Haversine band (~3944) and
 # admit the Vincenty deviation via a relative tolerance.
 [case id=geo-011-distance-vincenty-nyc-lax level=core tol=0.01
  [tags geo distance-vincenty ellipsoid]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:distance-vincenty [$geo:point 40.7128 -74.0060] [$geo:point 33.9416 -118.4085] "km"]
#]]
  [out-text [#
3960.0
#]]
 ]

 [case id=geo-012-vincenty-antipodal-convergence level=core
  [tags geo distance-vincenty antipodal CXER3600]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:distance-vincenty [$geo:point 0.0 0.0] [$geo:point 0.5 179.7] "km"]
#]]
  [out-err [#
cx-err:CXER3600
#]]
 ]

 [case id=geo-013-bearing-due-east level=core
  [tags geo bearing]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:bearing [$geo:point 0.0 0.0] [$geo:point 0.0 1.0]]
#]]
  [out-text [#
90.0
#]]
 ]

 [case id=geo-014-destination-due-north-lon level=core
  [tags geo destination]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $d [$geo:destination [$geo:point 0.0 0.0] 0.0 100.0 "km"]] $d/lon]
#]]
  [out-text [#
0.0
#]]
 ]

