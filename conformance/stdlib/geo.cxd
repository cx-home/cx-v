  [tags geo normalize-lon wrap]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:normalize-lon 190.0]
#]]
  [out-text [#
-170.0
#]]
 ]

