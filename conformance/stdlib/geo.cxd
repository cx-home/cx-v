 # ── §3.6 WKT format ────────────────────────────────────────────────────

 # §3.6: WKT uses (lon lat) order; parse maps to named lat=/lon=.
 [case id=geo-049-parse-wkt-point-lat level=core
  [tags geo parse-wkt point]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-wkt "POINT(-122.4194 37.7749)"]] $p/lat]
#]]
  [out-text [#
37.7749
#]]
 ]

 [case id=geo-050-parse-wkt-point-lon level=core
  [tags geo parse-wkt point lon-lat-order]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-wkt "POINT(-122.4194 37.7749)"]] $p/lon]
#]]
  [out-text [#
-122.4194
#]]
 ]

 [case id=geo-051-parse-wkt-malformed level=core
  [tags geo parse-wkt malformed CXER3603]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:parse-wkt "POINT(not a coordinate"]
#]]
  [out-err [#
cx-err:CXER3603
#]]
 ]

 # §3.6 example: canonical POINT WKT form.
 [case id=geo-052-format-wkt-point level=core
  [tags geo format-wkt point canonical]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:format-wkt [$geo:point 37.7749 -122.4194]]
#]]
  [out-text [#
'POINT(-122.4194 37.7749)'
#]]
 ]

 # §6: WKT round-trip parse -> format produces canonical form.
 [case id=geo-053-wkt-roundtrip-polygon level=core
  [tags geo parse-wkt format-wkt roundtrip polygon]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:format-wkt [$geo:parse-wkt "POLYGON((-122.5 37.7, -122.4 37.7, -122.4 37.8, -122.5 37.8, -122.5 37.7))"]]
#]]
  [out-text [#
'POLYGON((-122.5 37.7, -122.4 37.7, -122.4 37.8, -122.5 37.8, -122.5 37.7))'
#]]
 ]

 # ── §3.7 GeoJSON format ────────────────────────────────────────────────

 # §3.7: GeoJSON uses [lon, lat]; parse maps to named lat=/lon=.
 [case id=geo-054-parse-geojson-point-lat level=core
  [tags geo parse-geojson point]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-geojson "{\"type\":\"Point\",\"coordinates\":[-122.4194,37.7749]}"]] $p/lat]
#]]
  [out-text [#
37.7749
#]]
 ]

 [case id=geo-055-parse-geojson-point-lon level=core
  [tags geo parse-geojson point lon-lat-order]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-geojson "{\"type\":\"Point\",\"coordinates\":[-122.4194,37.7749]}"]] $p/lon]
#]]
  [out-text [#
-122.4194
#]]
 ]

 [case id=geo-056-parse-geojson-malformed level=core
  [tags geo parse-geojson malformed CXER3604]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:parse-geojson "{not valid json"]
#]]
  [out-err [#
cx-err:CXER3604
#]]
 ]

 # §3.7 / §5: geometry type not in the v0.8.0 surface -> CXER3605.
 [case id=geo-057-parse-geojson-unsupported-type level=core
  [tags geo parse-geojson unsupported CXER3605]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:parse-geojson "{\"type\":\"Circle\",\"coordinates\":[0,0],\"radius\":5}"]
#]]
  [out-err [#
cx-err:CXER3605
#]]
 ]

 # §3.7: format-geojson inverts losslessly. We extract the geometry type to
 # avoid asserting whitespace-sensitive full JSON, while still grounding the
 # round-trip through the JSON map projection.
 [case id=geo-058-geojson-roundtrip-point-lat level=core
  [tags geo parse-geojson format-geojson roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[?let [= $p [$geo:parse-geojson [$geo:format-geojson [$geo:point 37.7749 -122.4194]]]] $p/lat]
#]]
  [out-text [#
37.7749
#]]
 ]
 [case id=geo-059-normalize-lon-large-magnitude-no-hang level=core gate=enforced
  [tags geo normalize-lon wrap large regression perf]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:normalize-lon 10000000000000.0]
#]]
  [out-text [#
-80.0
#]]
 ]

 [case id=geo-060-normalize-lon-540 level=core gate=enforced
  [tags geo normalize-lon wrap regression]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:normalize-lon 540.0]
#]]
  [out-text [#
180.0
#]]
 ]

