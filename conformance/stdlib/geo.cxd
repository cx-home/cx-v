#]]
  [out-text [#
false
#]]
 ]

 # §6: "with a hole, point in hole returns false."
 [case id=geo-034-point-in-polygon-hole level=core
  [tags geo point-in-polygon hole]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:point-in-polygon [$geo:point 3.0 3.0] [$geo:polygon-with-holes ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0]) (([$geo:point 2.0 2.0], [$geo:point 4.0 2.0], [$geo:point 4.0 4.0], [$geo:point 2.0 4.0], [$geo:point 2.0 2.0]))]]
#]]
  [out-text [#
false
#]]
 ]

 # §6: "simple correctly-wound polygon with interior hole -> valid."
 [case id=geo-035-polygon-is-valid-simple level=core
  [tags geo polygon-is-valid ogc]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:polygon-is-valid [$geo:polygon ([$geo:point 0.0 0.0], [$geo:point 0.0 10.0], [$geo:point 10.0 10.0], [$geo:point 10.0 0.0], [$geo:point 0.0 0.0])]]
#]]
  [out-text [#
true
#]]
 ]

 # §6: "bowtie -> invalid" (self-intersecting ring).
