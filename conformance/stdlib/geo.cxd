  [tags geo normalize-lat clamp]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/geo']
[$geo:normalize-lat -100.0]
#]]
  [out-text [#
-90.0
#]]
 ]

 # §3.5 / §6: normalize-lon(190.0) -> -170.0 (wrap to [-180, 180]).
