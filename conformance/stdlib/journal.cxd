  [# ── 078: sig-algo fail-closed (#702/L36) ─────────────────────────────── #]

  [case id=journal-078-snapshot-verify-unsupported-suite level=core gate=enforced
   [tags journal snapshot-verify unsupported-suite fail-closed suite-registry negative]
   [; the snapshot is byte-identical to the deterministic signed snapshot of
      journal-029 (same journal, same entry, all-0x01 seed) EXCEPT sig-algo
      names a registry-reserved, unimplemented suite — anchor and hash-algo
      checks pass, then the suite gate MUST fail closed. Pre-#702 this fell
      through to Ed25519 and reported :signature-invalid. ]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $bad [snapshot tenant=acme at-seq=1 anchor-hash='sha2-256:83a013836d0939e47c191cd4a5c079e89fe2f1ecfee486f7da7db50fcdeb9b98' hash-algo=sha2-256 sig-algo=ml-dsa-65 signature='808b35477d98b9f25bc8363b0d7268223b8879b41fe4be183fe7ee0db6bd1bfe93331cd9ab1c5df1684baf72ee01ea4d336e5225cdea15ca8b1b059269dcc007' verify-key='8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c' [state 1]]]
  [$journal:snapshot-verify $j $bad]]
#]]
   [out-text [#
[snapshot-verification valid=false at-seq=1 reason=':unsupported-suite']
#]]
  ]

  [# ── 079-080: frozen preimage pins (#724, audit C1) ───────────────────── #]

  [case id=journal-079-entry-preimage-recompute level=core gate=enforced
   [tags journal hash preimage entry-canonical tier1 identity clean-room SAP]
   [; the §4.2 pin: recompute both entries' hashes from NOTHING but the
      spec-stated entry-canonical form and the Tier-1 identity surface
      ($cx:hash = the bytes `cx hash` covers). Default-stream entry omits
      stream=; named-stream entry binds it. recomputed must equal emitted
      byte-for-byte on BOTH lanes — the clean-room guarantee #724 demanded.
      All fields deterministic (mem:// epoch-counter ts; payload addresses
      are the events' own Tier-1 addresses). ]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/cx']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [do :refund] {actor: "ops" authority: "d-77"}]]
[= $e2 [$journal:append $j [do :ship] {actor: "ops" authority: "d-77" stream: "orders"}]]
[= $r1 [$cx:hash [entry-canonical seq=1 tenant=acme actor=ops authority=d-77 ts="1970-01-01T00:00:01Z" prev-hash="genesis:" payload="sha2-256:1c28ab1fd422c356d61afc4be98fe2ff836d21b306487a4d67a62b40fc762ec5"]]]
[= $r2 [$cx:hash [entry-canonical seq=1 tenant=acme stream=orders actor=ops authority=d-77 ts="1970-01-01T00:00:01Z" prev-hash="genesis:" payload="sha2-256:107f47b0c7023b78cbe883a5156f6ccdeb2b9ef4377cbc0ca5f3a3b8a54295a5"]]]
  [entry-preimage-pin
    [default recomputed=$r1 emitted=$e1/@hash]
    [named recomputed=$r2 emitted=$e2/@hash]]]
#]]
   [out-text [#
[entry-preimage-pin [default recomputed='sha2-256:902dfe8cf83616e030e70ec30429c632601d4bd29308b757049706a3afb218a4' emitted='sha2-256:902dfe8cf83616e030e70ec30429c632601d4bd29308b757049706a3afb218a4'] [named recomputed='sha2-256:6ab4f136a743aaa1b237473b8a33fe03c29d6b3eeac10b61013770b4366100dd' emitted='sha2-256:6ab4f136a743aaa1b237473b8a33fe03c29d6b3eeac10b61013770b4366100dd']]
#]]
  ]

  [case id=journal-080-snapshot-signed-preimage-form level=core gate=enforced
   [tags journal snapshot signature preimage snapshot-canonical value-emission clean-room SAP]
   [; the §4.8 pin: the shipped signature verifies against the preimage
      reconstructed from the spec-stated snapshot-canonical form — the
      folded state VALUE as the sole body child (NOT a [state] wrapper;
      that reading verifies false, the 2026-08-10 #724 finding) and the
      VALUE-emission byte basis ($format:canonical of the element as
      constructed, no trailing newline) — NOT §4.2's document-identity
      basis. Deterministic all-0x01 signing seed (journal-029). ]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/format']
[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [a] {actor: "u" authority: "g"}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {signing-key: "0101010101010101010101010101010101010101010101010101010101010101"}]]
[= $pre [$format:canonical [snapshot-canonical at-seq=1 anchor-hash=$snap/@anchor-hash hash-algo=$snap/@hash-algo 1]]]
  [preimage-verifies [$crypto:ed25519-verify
    [$bytes:from-hex $snap/@verify-key]
    [$bytes:from-string-utf8 $pre]
    [$bytes:from-hex $snap/@signature]]]]
#]]
   [out-text [#
[preimage-verifies true]
#]]
  ]

  [case id=journal-081-subscribe-tail-follow level=core gate=enforced
   [tags journal subscribe tail-follow delivery u1-13a 762]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://jsub-doc" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[= $sub [$journal:subscribe $j {from: 0}]]
[= $r1 [?receive from=$sub]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g"}]]
[= $b [?receive from=$sub max=5 deadline=0]]
  ([first $r1/@seq], [then n=[$count $b]], [rung $sub@rung])]
#]]
   [out-text [#
([first 1], [then n=1], [rung ':complete-ordered'])
#]]
  ]

  [case id=journal-082-seq-at-position level=core gate=enforced
   [tags journal seq-at time-index u1-14a 762]
   [in-cx [#
[empty]
#]]
