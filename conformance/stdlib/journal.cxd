 [case id=journal-066-tamper-genesis-invalid level=core gate=enforced
  [tags journal verify tamper genesis-invalid valid-false]
  [doc [#
Forge entry 1 with a non-genesis prev-hash; verify reports genesis-invalid.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?let [= $s [$store:open "mem://tg2"]]
[= $j1 [$journal:attach $s "acme"]]
[= $a [$journal:append $j1 [x 1] {actor: "u" authority: "g"}]]
[= $bad [$store:put-doc $s [entry seq=1 tenant=acme actor=u authority=g ts='epoch:00:00:01' prev-hash='sha256:notgenesis' hash='sha256:whatever' [event [x 1]]]]]
[= $z [$store:set-alias $s "cx-journal/entry/acme/1" $bad]]
[= $c [$journal:close $j1]]
[= $j2 [$journal:attach $s "acme"]]
  [$journal:verify $j2]]
#]]
  [out-text [#
[verification valid=false checked-from=1 checked-to=1 first-bad-seq=1 reason=':genesis-invalid']
#]]
 ]

  [# ── 059-065: per-aggregate streams (R2, stdlib_journal.md §2.1.1) ─────────
     A tenant journal is a set of independent per-aggregate streams; the
     `:default` stream is INVISIBLE (no stream attr, no stream in the canonical
     bytes / hash, legacy alias) so 001-058 above are byte-identical. A named
     stream binds `stream` into the entry + hash and has its own seq/head/chain;
     disjoint streams are independent (their own genesis, their own conflict). #]

  [case id=journal-059-stream-genesis level=core
   [tags journal append stream genesis chain]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
  [$journal:append $j [a 1] {actor: "u" authority: "g" stream: "principal:dana"}]]
#]]
   [out-text [#
[entry seq=1 tenant=acme stream=principal:dana actor=u authority=g ts='1970-01-01T00:00:01Z' prev-hash='genesis:' payload=sha2-256:e908d52cb2472325f8078e4e6001a0129e14ee3af98728bfcc0e733c940aba23 hash=sha2-256:a36dd33192764e5e8c5460973935911e182cb85fe7beb892066b8f904bd4c485 [event [a 1]]]
#]]
  ]

  [case id=journal-060-stream-independence level=core
   [tags journal append stream independence per-stream-seq]
