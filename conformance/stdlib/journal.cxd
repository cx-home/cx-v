  [# ── 069-071: per-stream retain + compact (R2, §2.1.1 / §4.10) ──────────────
     A stream-scoped retain (policy.stream + a per-stream covering snapshot)
     yields a stream-tagged retention; compact copies that named stream's
     retained tail into the segment's same named stream, seam-anchored, leaving
     the source byte-for-byte intact. Signing seed = all-0x01 (as 027-035). #]

  [case id=journal-069-stream-compact level=core
   [tags journal compact retain stream segment seam]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $a [$journal:append $j [x 1] {actor: "u" authority: "g" stream: "s1"}]]
[= $b [$journal:append $j [x 2] {actor: "u" authority: "g" stream: "s1"}]]
[= $c [$journal:append $j [x 3] {actor: "u" authority: "g" stream: "s1"}]]
[= $snap [$journal:snapshot $j [?fn ($acc $e) [+ $acc 1]] 0 {stream: "s1" at-seq: 1 signing-key: "0101010101010101010101010101010101010101010101010101010101010101"}]]
[= $ret [$journal:retain $j {keep-after-seq: 1 stream: "s1" snapshot: $snap}]]
[= $seg [$journal:compact $j {retention: $ret target: "mem://seg-a"}]]
  [$journal:read $seg 2 "s1"]]
#]]
   [out-text [#
[entry seq=2 tenant=acme stream=s1 actor=u authority=g ts='1970-01-01T00:00:02Z' prev-hash='sha2-256:2d583ad710b8822d3cda681a30473a513a111789c022c646ca8bf79315760eef' payload='sha2-256:3e449f544747dbeb1b696e860b79d5b1e70d785db0fcd6ae5c03e9565fc6af12' hash='sha2-256:42014eb84d05a06df80894a2f26fa1936b69c7e9f777309594c4b8163e0d2d02' [event [x 2]]]
#]]
  ]

  [case id=journal-070-stream-compact-verify-seam level=core
   [tags journal compact verify stream seam finding]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $a [$journal:append $j [x 1] {actor: "u" authority: "g" stream: "s1"}]]
[= $b [$journal:append $j [x 2] {actor: "u" authority: "g" stream: "s1"}]]
[= $c [$journal:append $j [x 3] {actor: "u" authority: "g" stream: "s1"}]]
[= $snap [$journal:snapshot $j [?fn ($acc $e) [+ $acc 1]] 0 {stream: "s1" at-seq: 1 signing-key: "0101010101010101010101010101010101010101010101010101010101010101"}]]
[= $ret [$journal:retain $j {keep-after-seq: 1 stream: "s1" snapshot: $snap}]]
[= $seg [$journal:compact $j {retention: $ret target: "mem://seg-b"}]]
  [$journal:verify $seg {stream: "s1"}]]
#]]
   [out-text [#
[verification valid=true checked-from=2 checked-to=3 head-hash='sha2-256:75e01820100397b039a1ab583048d4d5c742ece63e8c58be8674de785e81d93a']
#]]
  ]

