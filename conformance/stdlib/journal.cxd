[?let [= $j [$journal:open "mem://t" "acme"]]
[= $a [$journal:append $j [x 1] {actor: "u" authority: "g"}]]
[= $b [$journal:append $j [y 1] {actor: "u" authority: "g" stream: "dana"}]]
  [$journal:read $j 1 "dana"]]
#]]
   [out-text [#
[entry seq=1 tenant=acme stream=dana actor=u authority=g ts='1970-01-01T00:00:01Z' prev-hash='genesis:' payload='sha2-256:7caa6bb2a2d3254b3068a0e9c8896320174b5803771b8f26651ba8198e922456' hash='sha2-256:0b9c0a16194effce35beb72c7a7a9a1ef0f8913a03ab7e4d9eebde58775d15f9' [event [y 1]]]
