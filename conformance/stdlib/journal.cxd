  [# ── 066-068: per-stream verify / fold / snapshot+fold-from (R2, §2.1.1) ────
     verify/fold/replay/snapshot/fold-from all accept a stream scope and operate
     on that stream's own chain. (Per-stream `file://` reload is exercised
     out-of-band — it needs a write grant the hermetic mem:// tier withholds.) #]

  [case id=journal-066-stream-verify level=core
   [tags journal verify stream finding]
   [in-cx [#
[empty]
#]]
