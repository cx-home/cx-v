  [case id=journal-083-subscribe-live-select-gap-absence level=core gate=enforced
   [tags journal subscribe select live-tail negative CXER4610 seq-at absence 762]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://jrn-083" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g" stream: "s"}]]
[= $live [$journal:subscribe $j {stream: "s"}]]
[= $quiet [?receive from=$live max=3 deadline=0]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g" stream: "s"}]]
[= $r [?receive from=$live]]
[= $sel [?select [case [from $live $m] [got $m/@seq]] [case [timeout 0] [idle]]]]
[= $bad [$journal:subscribe $j {from: 99}]]
[= $none [$journal:seq-at $j "1969-01-01T00:00:00Z"]]
  ([quiet n=[$count $quiet]], [got $r/@seq], $sel, $bad@code, [none n=[$count $none]])]
#]]
