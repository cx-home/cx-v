[?let [= $b [$journal:append $j [y 1] {actor: "u" authority: "g" stream: "dana"}]]
  [$journal:read $j 1 "dana"]]]]
#]]
   [out-text [#
[entry seq=1 tenant=acme stream=dana actor=u authority=g ts='epoch:00:00:01' prev-hash=b3:GENESIS hash='sha256:87fb04b81c6bf94faaf297d1956f65fb748a5b151c5691c33a39ce3a921ebf2b' [event [y 1]]]
#]]
  ]

