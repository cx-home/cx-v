  [case id=journal-009a-query-predicate-filters level=core
   [tags journal query cxpath predicate audit issue-782]
   [meta [#
note: the trailing predicate used to be STRIPPED before matching — the
note: verb matched the element-name step alone, so this query answered
note: with all THREE promos instead of the two carrying valid-from: a
note: silent superset of what was asked. The path is now evaluated by
note: the real engine against each hydrated entry, so a predicate means
note: what CXPath says it means (§3.3).
#]]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [promo valid-from='2026-01-01'] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [promo] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [promo valid-from='2026-02-01'] {actor: "u" authority: "g"}]]
  [$count [$journal:query $j "/event/promo[@valid-from]"]]]
#]]
   [out-text [#
2
#]]
  ]

  [case id=journal-009b-query-predicate-value level=core
   [tags journal query cxpath predicate audit issue-782]
   [meta [#
note: a VALUE predicate narrows further — the same engine, so equality
note: and attribute reads behave exactly as they do in an inline
note: `$doc/…` read. One of the two dated promos matches.
#]]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [promo valid-from='2026-01-01'] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [promo] {actor: "u" authority: "g"}]]
[= $e3 [$journal:append $j [promo valid-from='2026-02-01'] {actor: "u" authority: "g"}]]
  [$count [$journal:query $j "/event/promo[= $_@valid-from '2026-02-01']"]]]
#]]
   [out-text [#
1
#]]
  ]

  [case id=journal-009c-query-bad-path-refused level=core
   [tags journal query cxpath fail-loud issue-782]
   [meta [#
note: a path the engine refuses is the CALLER's error, reported once for
note: the query. Before the fix an unparseable predicate was simply cut
note: off and the query answered anyway — the silent-narrowing half of
note: the same class.
#]]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[= $e1 [$journal:append $j [promo] {actor: "u" authority: "g"}]]
  [$journal:query $j "/event/promo["]]
#]]
   [out-err [#
cx-err:CXER4610
#]]
  ]

