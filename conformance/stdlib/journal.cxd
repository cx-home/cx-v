  [# ── 069-071: per-stream retain + compact (R2, §2.1.1 / §4.10) ──────────────
     A stream-scoped retain (policy.stream + a per-stream covering snapshot)
     yields a stream-tagged retention; compact copies that named stream's
     retained tail into the segment's same named stream, seam-anchored, leaving
     the source byte-for-byte intact. Signing seed = all-0x01 (as 027-035). #]

  [case id=journal-069-stream-compact level=core
   [tags journal compact retain stream segment seam]
   [in-cx [#
[empty]
#]]
   [in-code [#
[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://t" "acme"]]
[?let [= $a [$journal:append $j [x 1] {actor: "u" authority: "g" stream: "s1"}]]
[?let [= $b [$journal:append $j [x 2] {actor: "u" authority: "g" stream: "s1"}]]
[?let [= $c [$journal:append $j [x 3] {actor: "u" authority: "g" stream: "s1"}]]
[?let [= $snap [$journal:snapshot $j [?fn ($acc $e) [+ $acc 1]] 0 {stream: "s1" at-seq: 1 signing-key: "0101010101010101010101010101010101010101010101010101010101010101"}]]
[?let [= $ret [$journal:retain $j {keep-after-seq: 1 stream: "s1" snapshot: $snap}]]
[?let [= $seg [$journal:compact $j {retention: $ret target: "mem://seg-a"}]]
  [$journal:read $seg 2 "s1"]]]]]]]]
#]]
   [out-text [#
[entry seq=2 tenant=acme stream=s1 actor=u authority=g ts='epoch:00:00:02' prev-hash=sha256:bfb30a05b39bfe6c03a52bfae36a909f38fa5ec75c7613c09840b8bafb539bfa hash=sha256:c0088c8001f6bc5a098165d54aa6df547e9e3f279ab365427595b57939e3da43 [event [x 2]]]
#]]
  ]

