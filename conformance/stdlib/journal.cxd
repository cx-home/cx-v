[?lib 'cx-stdlib/journal']
[?let [= $j [$journal:open "mem://jseq-doc" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g"}]]
[= $p [$journal:seq-at $j "1970-01-01T00:00:01Z"]]
  [at seq=$p@seq]]
#]]
   [out-text [#
[at seq=1]
