 ]
 [case id=diagram-020-data-tree-dot level=core
  [tags diagram data-tree dot d913-1 issue-913]
  [meta [#
note: RULED D913-1 (#913) — a document with no program structure renders
note: its ELEMENT TREE in the DOT text (the svg/png stdin), where the
note: shipped walk emitted ZERO nodes (an empty canvas with exit 0, the
note: #910 silent-degradation class one lane over). The bare URL keeps the
note: source in the D910-1 data-lift class.
#]]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[?lib 'cx-stdlib/strings' as=strings]
[?let [= $dot [$diagram:of-source "[server [origins https://example.com]]" "dot"]]
  ([$strings:contains $dot "digraph CX {"],
   [$strings:contains $dot "n1 [label=\"[server "],
   [$strings:contains $dot "n1 -> n2;"])]
#]]
  [out-text [# (true, true, true) #]]
 ]
]
