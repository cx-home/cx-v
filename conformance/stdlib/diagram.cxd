[test-suite name=diagram ring=1
  [doc [#
conformance fixtures for cx-stdlib/diagram (spec/03-approved/std-lib/diagram.md).

   The §10.1.2 reference renderer AND the playground CFG/ERD/SEQ emitter, both
   pure CX (#758 waves 1-2; #889 wave 3). Every case here IS the worked example
   of a public function's [fn-doc] — the co-located docs gate
   (scripts/gen_guide/stdlib_docs_check.cx) pins each example verbatim to this
   corpus, so a doc example that drifts from real behavior fails a gate rather
   than misleading a reader.

   CONVENTIONS: the render verbs that take a program IMAGE are exercised with a
   minimal image node ([greet]); the source-text entries (of-source,
   code-diagram) take source directly. `render-svg` / `render-png` run WITHOUT
   the `subprocess` capability here, so they exercise the dot-less envelope
   contract (§6) — the round trip holds on both roads by construction.

   The byte-level pins live elsewhere and are stronger than these examples:
   vcx/tests/diagram_mermaid_golden_test.v (120 mermaid goldens),
   vcx/tests/diagram_vector_golden_test.v (DOT + envelopes + splices),
   vcx/tests/code_diagram_golden_test.v (264 playground goldens).
#]]
 [case id=diagram-001-render-mermaid level=core
  [tags diagram render-mermaid]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:extract-mermaid [$diagram:render-mermaid [greet] "[greet]" "min"]]
#]]
  [out-text [# '[greet]' #]]
 ]
 [case id=diagram-002-rules level=core
  [tags diagram rules]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$count [?for [in $r [$diagram:rules]/*] [where [= [$name $r] "row"]] [yield $r]]]
#]]
  [out-text [# 26 #]]
 ]
 [case id=diagram-003-admitted level=core
  [tags diagram admitted]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:admitted "secret"]
#]]
  [out-text [# false #]]
 ]
 [case id=diagram-004-extract-mermaid level=core
  [tags diagram extract-mermaid]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:extract-mermaid "%%cx:W3hd%%"]
#]]
  [out-text [# '[x]' #]]
 ]
 [case id=diagram-005-extract-svg level=core
  [tags diagram extract-svg]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:extract-svg "<svg><metadata><cx:source>W3hd</cx:source></metadata></svg>"]
#]]
  [out-text [# '[x]' #]]
 ]
 [case id=diagram-006-extract-png level=core
  [tags diagram extract-png]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[?lib 'cx-stdlib/bytes' as=bytes]
[?else [$diagram:extract-png [$bytes:from-base64 "iVBORw0KGgo="]] "no cx-source chunk"]
#]]
  [out-text [# 'no cx-source chunk' #]]
 ]
 [case id=diagram-007-render-dot level=core
  [tags diagram render-dot]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[?lib 'cx-stdlib/strings' as=strings]
[$strings:contains [$diagram:render-dot [greet]] "digraph CX {"]
#]]
  [out-text [# true #]]
 ]
 [case id=diagram-008-render-svg level=core
  [tags diagram render-svg]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:extract-svg [$diagram:render-svg [greet] "[greet]"]]
#]]
  [out-text [# '[greet]' #]]
 ]
 [case id=diagram-009-render-png level=core
  [tags diagram render-png]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:extract-png [$diagram:render-png [greet] "[greet]"]]
#]]
  [out-text [# '[greet]' #]]
 ]
