 [case id=diagram-019-effect-graph level=core
  [tags diagram effect-graph capabilities]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/diagram' as=diagram]
[$diagram:effect-graph "[?def double ($x) [* $x 2]]" "min"]
#]]
  [out-text [# 'flowchart TD\n  prog(["program"])\n  nocap["no capability-charging effect reached"]\n  prog --> nocap' #]]
 ]
 [case id=diagram-020-effect-rules level=core
