 [case id=crypto-087-claim-non-claims level=core gate=enforced
  [tags crypto claim CXER3718 arg]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/crypto']
[$crypto:claim [foo] "iss"]
#]]
  [out-err [#
cx-err:CXER3718
#]]
 ]

 [case id=crypto-088-jwks-fetch-denied level=core gate=enforced
