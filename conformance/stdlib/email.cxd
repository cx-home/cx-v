[test-suite name=email
  [doc [#
conformance fixtures for cx-stdlib/email (spec/std-lib/email.md §6/§7).

   Spec-first: authored AHEAD of implementation, so every case is RED until
   the module lands. Each program imports the bundled module via
   [?lib 'cx-stdlib/email'] (resolver MUST be quoted) then calls
   [$email:<fn> args]; the LAST expression is the rendered result. String
   scalars render double-quoted by the runner; bool/int bare; sequences in
   paren form (a, b, c). Error fixtures use out-err with the bare CXER code.

   email/parse takes bytes, so those cases also import 'cx-stdlib/bytes' and
   feed [bytes/from-string-utf8 "..."]. Element/sequence results are reduced
   to a grounded scalar via the typed accessors (subject/text-body/...) or the
   core builtins [$count …] / [$first …], so the asserted value is one the
   spec states normatively rather than an invented full-element render.

   Grounded anchors (all from §6/§7 and the §2/§3 normative text):
     - decode =?UTF-8?Q?Hello_=E4=B8=96=E7=95=8C?= -> "Hello 世界"
     - decode =?UTF-8?B?SGVsbG8g5LiW55WM?=         -> "Hello 世界"
     - address "John Doe <john@example.com>" -> local-part john / domain example.com
     - group "team: alice@x, bob@x;" -> [address-group name="team" …] (2 members)
     - DSN failed/5.1.1 -> is-bounce true, is-hard-bounce true
     - DSN delayed/4.x.x -> is-bounce true, is-hard-bounce false
     - error codes: CXER1300..CXER1306 (§6)
#]]

 # ── §3.1 parse / emit ───────────────────────────────────────────────────────

 [case id=email-001-parse-is-multipart-false level=core
  [tags email parse is-multipart]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nTo: c@d.com\r\nSubject: Hi\r\n\r\nHello body\r\n"]]]
  [$email:is-multipart $msg]]
#]]
  [out-text [#
false
#]]
 ]

 [case id=email-002-parse-crlf-lf-identical level=core
  [tags email parse crlf lf]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $crlf [$email:parse [$bytes:from-string-utf8 "Subject: Hi\r\n\r\nbody"]]]
  [= $lf [$email:parse [$bytes:from-string-utf8 "Subject: Hi\n\nbody"]]]
  [$eq [$email:subject $crlf] [$email:subject $lf]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=email-003-parse-malformed level=core
  [tags email parse error malformed]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[$email:parse [$bytes:from-string-utf8 "not an email"]]
#]]
  [out-err [#
cx-err:CXER1300
#]]
 ]

 # emit consumes the conceptual [message] element and returns bytes; we assert
 # the round-trip stability the spec guarantees for builder-produced messages
 # (§2: "Round-trip is byte-stable for messages produced by [$email:emit]").
 [case id=email-004-emit-roundtrip-subject level=core
  [tags email emit build roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?let [= $msg [$email:build {"from": "agent@example.com",
                            "to": "customer@example.com",
                            "subject": "Re: Invoice question",
                            "body": "Thank you for reaching out..."}]]
  [$email:subject [$email:parse [$email:emit $msg]]]]
#]]
  [out-text [#
'Re: Invoice question'
#]]
 ]

 # emit raises CXER1304 when From or all recipients are missing (§6).
 [case id=email-005-emit-required-header-missing level=core
  [tags email emit error required-header]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[$email:emit [message [headers [subject "no sender"]] [body [parts [part content-type="text/plain" "x"]] [is-multipart "false"]]]]
#]]
  [out-err [#
cx-err:CXER1304
#]]
 ]

 # emit raises CXER1305 when the multipart boundary appears in a part body (§6).
 [case id=email-006-emit-boundary-collision level=core
  [tags email emit error boundary-collision]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[$email:emit [message
  [headers [from "a@b.com"] [to "c@d.com"]]
  [body
    [parts
      [part content-type="text/plain" "----=_Part_X body contains the boundary"]
      [part content-type="text/html" "<p>x</p>"]]
    [is-multipart "true"]
    [boundary "----=_Part_X"]]]]
#]]
  [out-err [#
cx-err:CXER1305
#]]
 ]

 # ── §3.2 header inspection ───────────────────────────────────────────────────

 [case id=email-007-headers-count level=core
  [tags email headers map]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nSubject: Hi\r\n\r\nbody"]]]
  [$count [$email:headers $msg]]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=email-008-header-lowercased level=core
  [tags email header case-insensitive]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\nSubject: Hi\r\n\r\nbody"]]]
  [$email:header $msg "subject"]]
#]]
  [out-text [#
'Hi'
#]]
 ]

 # header returns empty string when the named header is absent (§3.2).
 [case id=email-009-header-absent-empty level=core
  [tags email header absent empty]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: a@b.com\r\n\r\nbody"]]]
  [$email:header $msg "x-nonexistent"]]
#]]
  [out-text [#
''
#]]
 ]

 # Multi-instance Received: headers preserved as a sequence (§7).
 [case id=email-010-header-multi-received-sequence level=core
  [tags email header-values multi-instance received sequence]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Received: from a\r\nReceived: from b\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:header-values $msg "Received"]]
#]]
  # §3.2: [email/header-values] returns ALL values of a header as a uniform
  # [sequence string] (length N for a multi-instance header like Received) — the
  # always-sequence companion to [email/header] (which returns only the first).
  [out-text [#
('from a', 'from b')
#]]
 ]

 # ── §3.2 typed accessors (documented in the §3.2 table) ──────────────────────

 [case id=email-011-subject-plain level=core
  [tags email subject plain]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Subject: Invoice question\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:subject $msg]]
#]]
  [out-text [#
'Invoice question'
#]]
 ]

 # subject decodes encoded-words (§3.2 "Decoded encoded-words"; §7 anchor).
 [case id=email-012-subject-encoded-word level=core
  [tags email subject encoded-word decode]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Subject: =?UTF-8?B?SGVsbG8g5LiW55WM?=\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:subject $msg]]
#]]
  [out-text [#
'Hello 世界'
#]]
 ]

 [case id=email-013-from-addr-domain level=core
  [tags email from-addr address]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "From: John Doe <john@example.com>\r\n\r\nbody"]]]
  [$email:format-address [$email:from-addr $msg]]]
#]]
  [out-text [#
'John Doe <john@example.com>'
#]]
 ]

 [case id=email-014-to-addrs-count level=core
  [tags email to-addrs sequence]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "To: a@x.com, b@x.com\r\nFrom: c@y.com\r\n\r\nbody"]]]
  [$count [$email:to-addrs $msg]]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=email-015-cc-addrs-count level=core
  [tags email cc-addrs sequence]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
