[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "Message-ID: <abc123@example.com>\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:message-id $msg]]
#]]
