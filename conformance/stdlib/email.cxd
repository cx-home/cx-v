'abc123@example.com'
#]]
 ]

 # in-reply-to returned WITHOUT angle brackets (§3.2).
 [case id=email-018-in-reply-to-no-brackets level=core
  [tags email in-reply-to threading]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/email']
[?lib 'cx-stdlib/bytes']
[?let [= $msg [$email:parse [$bytes:from-string-utf8 "In-Reply-To: <def456@example.com>\r\nFrom: a@b.com\r\n\r\nbody"]]]
  [$email:in-reply-to $msg]]
#]]
