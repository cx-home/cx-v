[test-suite name=a2a-xap ring=2
  [doc [#
Conformance fixtures for cx-x/a2a-xap — A2A tasks mapped onto the xap substrate
(#6 Y2b, the "over-xap" layer). NB cx-x/a2a-xap is an EXPERIMENTAL x/-TIER module
(D3): bundled + gated but exempt from the frozen-std stability promise. Programs
name the tier via [?lib 'cx-x/a2a-xap'].

An A2A agent's task lifecycle is recorded into a cx-stdlib/journal (append-only,
hash-chained), so task history is REPLAYABLE and TAMPER-EVIDENT for free. These
fixtures use a `mem://` journal (in-process, deterministic — like the sched
fixtures), so the record→replay→verify cycle runs hermetically in the gate.

Each program imports the module + cx-stdlib/journal; the LAST expression renders
the result (sequences in paren form, bools bare).
#]]

  [case id=a2a-xap-001-task-event-shape level=core
   [tags a2a-xap task-event shaping]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[$ax:task-event "t1" "submitted"]
#]]
   [out-text [#
[a2a-task id=t1 state=submitted]
#]]
  ]

  [case id=a2a-xap-002-lifecycle-replay level=core
   [tags a2a-xap journal record lifecycle replay]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/journal' :as journal]
[?let [= $jr [$journal:open "mem://a2a" "tenant"]]
 [= $_1 [$ax:record $jr "t1" "submitted"]]
 [= $_2 [$ax:record $jr "t1" "working"]]
 [= $_3 [$ax:record $jr "t1" "completed"]]
 [$ax:lifecycle [$ax:history $jr 1 3]]]
#]]
   [out-text [#
(submitted, working, completed)
#]]
  ]

  [case id=a2a-xap-003-chain-tamper-evident level=core
   [tags a2a-xap journal verify hash-chain]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/journal' :as journal]
[?let [= $jr [$journal:open "mem://a2a" "tenant"]]
 [= $_1 [$ax:record $jr "t1" "submitted"]]
 [= $_2 [$ax:record $jr "t1" "completed"]]
 [?let [= $v [$journal:verify $jr {}]]
  $v/@valid]]
#]]
   [out-text [#
true
#]]
  ]

  [case id=a2a-xap-004-message-envelope level=core
   [tags a2a-xap bus message-envelope]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[$ax:message-envelope {role: "user" text: "hi"}]
#]]
   [out-text [#
[do :a2a-message [payload {role: user, text: hi}]]
#]]
  ]

  [case id=a2a-xap-005-publish-message-fans-out level=core
   [tags a2a-xap bus publish fan-out pub-sub]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/bus' :as bus]
[?let [= $b [$bus:bus {}]]
 [?with-open [$bus:on $b :a2a-message [?fn ($m) $m]] $s1
  [?with-open [$bus:on $b :a2a-message [?fn ($m) $m]] $s2
   [?let [= $d [$ax:publish-message $b {role: "agent" text: "yo"}]] $d@delivered]]]]
#]]
   [out-text [#
2
#]]
  ]

  [case id=a2a-xap-006-grant-credential-valid level=core
   [tags a2a-xap did vc auth delegation]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/crypto' :as crypto]
[?let [= $kp [$crypto:ed25519-keypair]]
 [= $agent [$ax:agent-did $kp/@public]]
 [= $grant [$ax:grant-credential $agent $kp/@private $agent [delegation d1 [capabilities [read]]] {id: "urn:a2a:grant:1" issued-at: 2026-06-16T12:00:00Z expires: 2026-06-16T13:00:00Z}]]
 [$ax:grant-status $grant 2026-06-16T12:30:00Z]]
#]]
   [out-text [#
'valid'
#]]
  ]

  [case id=a2a-xap-007-grant-credential-expired level=core
   [tags a2a-xap did vc auth expiry]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/crypto' :as crypto]
[?let [= $kp [$crypto:ed25519-keypair]]
 [= $agent [$ax:agent-did $kp/@public]]
 [= $grant [$ax:grant-credential $agent $kp/@private $agent [delegation d1 [capabilities [read]]] {id: "urn:a2a:grant:2" issued-at: 2026-06-16T12:00:00Z expires: 2026-06-16T13:00:00Z}]]
 [$ax:grant-status $grant 2026-06-16T14:00:00Z]]
#]]
   [out-text [#
'expired'
#]]
  ]

  [case id=a2a-xap-008-propose-task-durable-pending-approval level=core
   [tags a2a-xap propose-task input-required journal proposal tier1 stream-18 690 L140]
   [; R-A1 migration: envelope → spliced children (2026-08-25) ]
   [meta [#
note: input-required IS the durable pending-approval slot (stream 18):
note: propose-task journals the transition CARRYING the proposal's
note: Tier-1 address (what an out-of-band approval binds); the replayed
note: lifecycle shows the path and the address survives replay —
note: durable, tamper-evident, never a bespoke pending-store.
#]]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/journal' :as journal]
[?def refund-order scope=public impure [effects [write]] [returns int] ($order-id::string $amount::int 10) $amount]
[?let [= $jr [$journal:open "mem://a2a-xap-008" "acme"]]
  [= $p [$cx:propose refund-order {order-id: 'o-1', amount: 42} {}]]
  [= $addr [$cx:hash $p]]
  [= $e1 [$ax:propose-task $jr "t-1" $p]]
  [= $e2 [$ax:record $jr "t-1" "completed"]]
  [= $entries [$ax:history $jr 1 2]]
  [flow [path [?splice [$ax:lifecycle $entries]]]
        [addr-carried [$eq [?let [= $ev [$first $entries]] [?let [= $t $ev/event] $t/@address]] $addr]]]]
#]]
   [out-text [#
[flow [path 'input-required' 'completed'] [addr-carried true]]
#]]
  ]

  [case id=a2a-xap-009-approval-credential-binds-address level=core
   [tags a2a-xap did vc approval proposal tier1 stream-18 690 L139 L140]
   [meta [#
note: the DID/VC approval substrate: a DID-signed credential whose
note: delegation subject IS the proposal's Tier-1 address — the same
note: delegation value shape the PEP consumes, verified fail-closed
note: (grant-status) with no callback to the issuer.
#]]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-x/a2a-xap' :as ax]
[?lib 'cx-stdlib/crypto' :as crypto]
[?def refund-order scope=public impure [effects [write]] [returns int] ($order-id::string $amount::int 10) $amount]
[?let [= $p [$cx:propose refund-order {order-id: 'o-1', amount: 42} {}]]
 [= $addr [$cx:hash $p]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $agent [$ax:agent-did $kp/@public]]
 [= $cred [$ax:approval-credential $agent $kp/@private $agent $addr {id: "urn:a2a:approval:1" issued-at: 2026-06-16T12:00:00Z expires: 2026-06-16T13:00:00Z}]]
 [$ax:grant-status $cred 2026-06-16T12:30:00Z]]
#]]
   [out-text [#
'valid'
#]]
  ]
]
