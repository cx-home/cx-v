 [case id=did-023-resolve-did-web-net-denied level=core gate=enforced grant="read"
  [tags did resolve web capability deny-lane spec-finding]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/did']
[$did:resolve "did:web:example.com"]
#]]
  [out-text [#
[err code=cx-err:CXER0271 message='E_CAP_DENIED: net capability required for example.com:443; none granted (grant via --allow-net)']
#]]
 ]

