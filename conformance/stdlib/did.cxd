 [case id=did-018-verify-control-pass level=core gate=enforced
  [tags did verify-control proof-of-control offline]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/did']
[?lib 'cx-stdlib/crypto']
[?lib 'cx-stdlib/bytes']
[?let [= $chal [$bytes:from-string-utf8 "nonce-42"]]
  [= $sig [$crypto:ed25519-sign [$bytes:from-hex "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"] $chal]]
  [$did:verify-control "did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7" $chal $sig]]
#]]
  [out-text [#
true
#]]
 ]

