 [case id=live-006-shape-parity-delta-vs-recompute level=core grant='eval read write'
  [tags live changes-since shape-parity transparency l131 stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/live']
[?let [= $s [$store:open "mem://live-006"]]
[= $q [?quote [?for [in $o [$store:source $orders "//order"]] [= $v [* $o@qty 10]] [yield [row id=$o@id total=$v]]]]]
[= $h1 [$store:put-doc $s [order id=1 qty=2]]]
[= $c1 [$live:changes-since $q {orders: $s} [head-set]]]
[= $cur [?element "head-set" $c1/head-set]]
[= $h2 [$store:put-doc $s [order id=2 qty=5]]]
[= $c2 [$live:changes-since $q {orders: $s} $cur]]
[= $delta-row [$first [?for [in $f $c2/insert] [yield [$first $f/*]]]]]
[= $head-rows [?for [in $o [$store:source $s "//order"]] [= $v [* $o@qty 10]] [yield [row id=$o@id total=$v]]]]
  [parity eq=[$cx:equal $delta-row [$last $head-rows]] $delta-row]]
#]]
  [out-text [#
[parity eq=true [row id=2 total=50]]
#]]
 ]

