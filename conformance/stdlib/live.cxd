[?let [= $s [$store:open "mem://live-048s"]]
[= $cs [$store:open "mem://live-048c"]]
[= $q [?quote [?for [in $o [$store:source $orders "//order"]] [yield $o]]]]
[= $h1 [$store:put-doc $s [order id=1]]]
[= $m [$live:materialize $cs $q {orders: $s} "o48"]]
[= $ck [$store:get-alias $cs "o48"]]
[= $del [$store:delete-doc $cs $ck]]
[= $r [$live:read $m]]
  ($r, [same eq=[$cx:equal [?for [in $x $r/order] [yield $x]] [?for [in $o [$store:source $s "//order"]] [yield $o]]]])]
#]]
  [out-text [#
([snapshot [head-set [s source=orders pos=1]] [order id=1]], [same eq=true])
#]]
 ]

