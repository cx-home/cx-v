 [case id=live-021-leg2-observe-eq-changes-since level=core grant='eval read write'
  [tags live observe receive quartet-leg2 equivalence stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/live']
[?let [= $s [$store:open "mem://live-021"]]
[= $q [?quote [?for [in $o [$store:source $orders "//order"]] [yield $o]]]]
[= $sub [$live:observe $q {orders: $s} [head-set]]]
[= $h1 [$store:put-doc $s [order id=1]]]
[= $r1 [?receive from=$sub]]
[= $c1 [$live:changes-since $q {orders: $s} [head-set]]]
[= $h2 [$store:put-doc $s [order id=2]]]
[= $del [$store:delete-doc $s $h1]]
[= $r2 [?receive from=$sub]]
[= $cur1 [?element "head-set" $c1/head-set]]
[= $c2 [$live:changes-since $q {orders: $s} $cur1]]
[= $r3 [?receive from=$sub]]
[= $cur2 [?element "head-set" $c2/head-set]]
[= $c3 [$live:changes-since $q {orders: $s} $cur2]]
  [leg2 eq1=[$cx:equal $r1 $c1] eq2=[$cx:equal $r2 $c2] eq3=[$cx:equal $r3 $c3] $r2]]
#]]
  [out-text [#
[leg2 eq1=true eq2=true eq3=true [changes [head-set [s source=orders pos=3]] [insert pos=1 [order id=2]] [retract pos=0]]]
#]]
 ]

