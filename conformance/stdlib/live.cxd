 [case id=live-011-journal-stream-cursor level=core grant='eval read write'
  [tags live changes-since journal stream per-stream-seq widening stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/live']
[?let [= $j [$journal:open "mem://live-011" "acme"]]
[= $q [?quote [?for [in $e [$journal:source $jrn "orders"]] [yield [ev seq=$e@seq]]]]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g" stream: "orders"}]]
[= $c1 [$live:changes-since $q {jrn: $j} [head-set]]]
[= $cur [?element "head-set" $c1/head-set]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g" stream: "orders"}]]
[= $c2 [$live:changes-since $q {jrn: $j} $cur]]
  ($c1, $c2)]
#]]
  [out-text [#
([changes [head-set [s source=jrn pos=1]] [insert pos=0 [ev seq=1]]], [changes [head-set [s source=jrn pos=2]] [insert pos=1 [ev seq=2]]])
#]]
 ]

