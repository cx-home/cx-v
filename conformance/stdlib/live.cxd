 [case id=live-067-m5-commerce-end-to-end level=core grant='eval read write'
  [tags live m5 commerce end-to-end query changes-since materialize observe adapter stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/live']
[?let [= $db [$store:open "mem://live-067-db"]]
[= $cs [$store:open "mem://live-067-ckpt"]]
[= $a [$live:adapt-poll "mem://live-067-j" "acme" "orders" $db [?quote [?for [in $r [$store:source $db2 "//order"]] [yield $r]]] "poll-1"]]
[= $h1 [$store:put-doc $db [order id=1 region=east amt=10]]]
[= $h2 [$store:put-doc $db [order id=2 region=west amt=5]]]
[= $t1 [$live:ingest $a]]
[= $rev-q [?quote [?for [in $o [$store:source $orders "//order"]] [= $amt $o@amt] [group-by $o@region] [yield [rev region=$key total=[$sum $group/amt] n=$count]]]]]
[= $rev1 [?for [in $o [$store:source $db "//order"]] [= $amt $o@amt] [group-by $o@region] [yield [rev region=$key total=[$sum $group/amt] n=$count]]]]
[= $c1 [$live:changes-since $rev-q {orders: $db} [head-set]]]
[= $dash [?element "head-set" $c1/head-set]]
[= $m [$live:materialize $cs $rev-q {orders: $db} "rev-by-region"]]
[= $sub [$live:observe [?quote [?for [in $e [$journal:source $jrn "orders"]] [yield $e]]] {jrn: $a/jslot} [head-set]]]
[= $seed [?receive from=$sub]]
[= $h3 [$store:put-doc $db [order id=3 region=east amt=7]]]
[= $t2 [$live:ingest $a]]
[= $agent-batch [?receive from=$sub]]
[= $agent-sees [$count $agent-batch/insert]]
[= $c2 [$live:changes-since $rev-q {orders: $db} $dash]]
[= $del [$store:delete-doc $db $h1]]
[= $adv1 [$live:advance $m]]
[= $adv2 [$live:advance $m]]
[= $r [$live:read $m]]
[= $fresh [?for [in $o [$store:source $db "//order"]] [= $amt $o@amt] [group-by $o@region] [yield [rev region=$key total=[$sum $group/amt] n=$count]]]]
[= $rows [?for [in $x $r/rev] [yield $x]]]
  ([query $rev1], [dashboard $c2], [agent rung=$sub@rung new=$agent-sees], [maintained $adv1 $adv2 eq=[$cx:equal $rows $fresh]], $r)]
#]]
  [out-text [#
([query ([rev region=east total=10 n=1], [rev region=west total=5 n=1])], [dashboard [changes [head-set [s source=orders pos=3]] [regroup pos=0 [rev region=east total=17 n=2]]]], [agent rung=':snapshot-diff' new=1], [maintained eq=true [advanced applied=2 recomputed=false [head-set [s source=orders pos=4]]] [advanced applied=0 recomputed=false [head-set [s source=orders pos=4]]]], [snapshot [head-set [s source=orders pos=4]] [rev region=west total=5 n=1] [rev region=east total=7 n=1]])
#]]
 ]
]
