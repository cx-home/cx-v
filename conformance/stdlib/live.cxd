 [case id=live-064-egress-ack-after-barrier level=core grant='eval read write'
  [tags live adapter egress ack barrier fabric cumulative l134 stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-fabric' :as fabric]
[?let [= $j [$journal:open "mem://live-064" "acme"]]
[= $f [$fabric:open $j]]
[= $p1 [$fabric:publish $f "out" [notify :egress.send id=1] {actor: "u" authority: "g"}]]
[= $p2 [$fabric:publish $f "out" [notify :egress.send id=2] {actor: "u" authority: "g"}]]
[= $s1 [$fabric:subscribe $f "out" :egress.send {group: "egress"}]]
[= $b1 [?receive from=$s1 max=1]]
[= $barrier1 "2xx"]
[= $a1 [?if [$eq $barrier1 "2xx"] [then [$fabric:ack $s1 1]] [else [no-ack]]]]
[= $s2 [$fabric:subscribe $f "out" :egress.send {group: "egress"}]]
[= $b2 [?receive from=$s2 max=1]]
[= $barrier2 "timeout"]
[= $a2 [?if [$eq $barrier2 "2xx"] [then [$fabric:ack $s2 2]] [else [no-ack]]]]
[= $s3 [$fabric:subscribe $f "out" :egress.send {group: "egress"}]]
[= $b3 [?receive from=$s3 max=1]]
  ([got1 [$count $b1]], [after-ack [$count $b2]], $a2, [redelivered [$count $b3]])]
#]]
  [out-text [#
([got1 1], [after-ack 1], [no-ack], [redelivered 1])
#]]
 ]

 [case id=live-065-gamma-retract-reinsert-position level=core grant='eval read write'
  [tags live materialize gamma group-order retract reinsert l94 quartet-leg4 stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/live']
[?let [= $s [$store:open "mem://live-065s"]]
[= $cs [$store:open "mem://live-065c"]]
[= $q [?quote [?for [in $o [$store:source $orders "//order"]] [group-by $o@region] [yield [rev region=$key n=$count]]]]]
[= $h1 [$store:put-doc $s [order id=1 region=east]]]
[= $h2 [$store:put-doc $s [order id=2 region=east]]]
[= $h3 [$store:put-doc $s [order id=3 region=west]]]
[= $m [$live:materialize $cs $q {orders: $s} "rev65"]]
[= $del [$store:delete-doc $s $h1]]
[= $a1 [$live:advance $m]]
[= $h4 [$store:put-doc $s [order id=4 region=east]]]
[= $a2 [$live:advance $m]]
[= $r [$live:read $m]]
[= $fresh [?for [in $o [$store:source $s "//order"]] [group-by $o@region] [yield [rev region=$key n=$count]]]]
[= $rows [?for [in $x $r/rev] [yield $x]]]
  ($a1, $a2, $r, [leg4 eq=[$cx:equal $rows $fresh]])]
#]]
  [out-text [#
([advanced applied=1 recomputed=false [head-set [s source=orders pos=4]]], [advanced applied=1 recomputed=false [head-set [s source=orders pos=5]]], [snapshot [head-set [s source=orders pos=5]] [rev region=east n=2] [rev region=west n=1]], [leg4 eq=true])
#]]
 ]

