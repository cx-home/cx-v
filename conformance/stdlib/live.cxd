 [case id=live-051-retention-pinned-by-registered-materialization level=core grant='eval read write'
  [tags live materialize journal retain retention-cover l133 negative CXER4616 stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/live']
[?let [= $j [$journal:open "mem://live-051j" "acme"]]
[= $cs [$store:open "mem://live-051c"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g"}]]
[= $e2 [$journal:append $j [b 2] {actor: "u" authority: "g"}]]
[= $snap [$journal:snapshot $j [?fn ($a $e) [+ $a 1]] 0 {signing-key: "0101010101010101010101010101010101010101010101010101010101010101" at-seq: 2}]]
[= $ret1 [$journal:retain $j {keep-after-seq: 2 snapshot: $snap}]]
[= $q [?quote [?for [in $e [$journal:source $jrn ""]] [yield [ev seq=$e@seq]]]]]
[= $m [$live:materialize $cs $q {jrn: $j} "pin"]]
  ($ret1, [$journal:retain $j {keep-after-seq: 2 snapshot: $snap}])]
#]]
  [out-text [#
([retention boundary=2 covered-by-seq=2], [err code=cx-err:CXER4616 message="E_JOURNAL_RETENTION_UNCOVERED: a registered materialization (`pin`) pins this stream's history — the retention cover rule extends to registered materializations (live modes L133); remove the registration alias before pruning"])
#]]
 ]

