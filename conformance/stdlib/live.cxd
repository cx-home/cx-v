 [case id=live-043-leg3-materialize-eq-observe level=core grant='eval read write'
  [tags live materialize observe quartet-leg3 equivalence stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/live']
[?let [= $s [$store:open "mem://live-043s"]]
[= $cs [$store:open "mem://live-043c"]]
[= $q [?quote [?for [in $o [$store:source $orders "//order"]] [yield $o]]]]
[= $m [$live:materialize $cs $q {orders: $s} "leg3"]]
[= $sub [$live:observe $q {orders: $s} [head-set]]]
[= $h1 [$store:put-doc $s [order id=1]]]
[= $h2 [$store:put-doc $s [order id=2]]]
[= $b [?receive from=$sub]]
[= $a [$live:advance $m]]
[= $r [$live:read $m]]
[= $fold [?for [in $f $b/insert] [yield [$first $f/*]]]]
[= $rows [?for [in $x $r/order] [yield $x]]]
  [leg3 rows=[$cx:equal $rows $fold] at=[$cx:equal [?element "head-set" $r/head-set] [?element "head-set" $b/head-set]]]]
#]]
  [out-text [#
[leg3 rows=true at=true]
#]]
 ]

 [case id=live-044-sum-decrements-exactly level=core grant='eval read write'
  [tags live materialize advance gamma retract sum invertible quartet-leg4 l130 stream-3]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/store']
[?lib 'cx-stdlib/live']
[?let [= $s [$store:open "mem://live-044s"]]
[= $cs [$store:open "mem://live-044c"]]
[= $q [?quote [?for [in $o [$store:source $orders "//order"]] [= $amt $o@amt] [group-by $o@region] [yield [rev region=$key total=[$sum $group/amt] n=$count]]]]]
[= $h1 [$store:put-doc $s [order id=1 region=east amt=10]]]
[= $h2 [$store:put-doc $s [order id=2 region=east amt=7]]]
[= $h3 [$store:put-doc $s [order id=3 region=west amt=5]]]
[= $m [$live:materialize $cs $q {orders: $s} "rev"]]
[= $del [$store:delete-doc $s $h2]]
[= $a [$live:advance $m]]
[= $r [$live:read $m]]
[= $fresh [?for [in $o [$store:source $s "//order"]] [= $amt $o@amt] [group-by $o@region] [yield [rev region=$key total=[$sum $group/amt] n=$count]]]]
[= $rows [?for [in $x $r/rev] [yield $x]]]
  ($a, $r, [leg4 eq=[$cx:equal $rows $fresh]])]
#]]
  [out-text [#
([advanced applied=1 recomputed=false [head-set [s source=orders pos=4]]], [snapshot [head-set [s source=orders pos=4]] [rev region=east total=10 n=1] [rev region=west total=5 n=1]], [leg4 eq=true])
#]]
 ]

