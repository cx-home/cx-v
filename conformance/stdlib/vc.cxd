 ]

 [case id=vc-019-verify-stripped-suite-tag-rejected level=core gate=enforced
  [tags vc verify unsupported-suite fail-closed downgrade stripped-tag negative crypto-agility]
  [; the credential is vc-001's golden with a GENUINELY VALID ed25519
     signature, EXCEPT the proof's type= attr is STRIPPED — the L36
     downgrade attack (crypto_agility §1.4, #691 §10): the signature stays
     valid over the proof-stripped preimage, so a verifier that defaults an
     absent suite tag to ed25519 verifies it clean and the strip goes
     undetected. The suite tag MUST be present and registry-verified BEFORE
     any signature byte is touched: absent → :unsupported-suite, never a
     default-suite attempt. ]
  [in-cx [#
[empty]
#]]
