[test-suite name=vc ring=2
  [doc [#
conformance fixtures for cx-stdlib/vc (spec/03-approved/std-lib/vc.md).
Authored at the I3 open (partition corpus audit gap G14), the authority
half of the did/vc pair. Ring 2 by the partition plan-row contract
(cx_partition.md §11 single authority model; I3 ledger census note N3) —
issue/verify/present are pure, revoke/revoked-set touch only the mem://
journal substrate, so every case is hermetic and offline.

   DETERMINISM: same golden key material as stdlib/did.cxd —
     issuer  seed-1 0102…1f20 → did-1 did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7
     subject pub-2             → did-2 did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG
   ed25519 signing is deterministic ⇒ the [proof [signature …]] values pin
   byte-for-byte. Validity window: issued-at 2026-06-16T12:00:00Z /
   expires 2026-06-16T13:00:00Z with `now` pinned per case. mem:// journals
   give the epoch-counter ts (journal.cxd convention).

   SPEC-FINDING RESOLVED (issue-739, RULED 739-1a): the §3 predicate was
   named `valid?` and was therefore UNREACHABLE — the lexicon does not
   admit `?` inside an identifier, so `[$vc:valid? …]` is a parse error
   while `[?def valid? …]` parsed fine on the definition side, leaving a
   public surface that existed only in prose. RENAMED `valid`,
   cutover-first (the old spelling is not dual-accepted). Case vc-016 flips
   from pinning the parse failure to pinning the reachable call.

   Id ranges:
     001-002  issue: full golden shape (subject≠issuer) + minimal→verify
     003-008  verify statuses: expired / not-yet-valid / bad-signature /
              tamper (real signature, altered claim) / malformed / revoked
     009-012  revocation: revoke event, attribution required, revoked-set
              fold, end-to-end issue→revoke→verify
     013      present (v1 passthrough [vp …] envelope)
     014-015  issue negatives: claim-invalid, key-invalid
     016      the `valid` predicate reached through the qualified form
              (was: the valid? unreachable-surface defect pin — issue-739)
     017      revoked-list negative control (other id stays valid)
     018      unsupported-suite fail-closed: proof type= is READ and gated
              against the signature-suite registry BEFORE any signature
              byte is touched (#702/L36) — an unknown suite is
              :unsupported-suite, never :bad-signature
     019      stripped-tag downgrade (#691 §10): an ABSENT proof type= over
              a genuinely valid signature is :unsupported-suite, never a
              default-ed25519 attempt — the tag-strip attack is detected
#]]

 [case id=vc-001-issue-full-golden-shape level=core gate=enforced
  [tags vc issue delegation proof golden]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/vc']
[?lib 'cx-stdlib/bytes']
[?let [= $claim [delegation d-recon-77 [tenant acme] [from [principal "did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7"]] [to [principal "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG"]] [capabilities [refund-duplicate]] [over "/orders"] [revocable true]]]
  [$vc:issue "did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7" [$bytes:from-hex "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"] "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG" $claim {id: "urn:uuid:fixture-vc-1", issued-at: 2026-06-16T12:00:00Z, expires: 2026-06-16T13:00:00Z}]]
#]]
  [out-text [#
[vc id=urn:uuid:fixture-vc-1 [issuer 'did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7'] [subject 'did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG'] [issued-at 2026-06-16T12:00:00Z] [expires 2026-06-16T13:00:00Z] [claim [delegation 'd-recon-77' [tenant 'acme'] [from [principal 'did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7']] [to [principal 'did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG']] [capabilities [refund-duplicate]] [over '/orders'] [revocable true]]] [proof type=Ed25519Signature2020 [verification-method 'did:key:z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7#z6MkneMkZqwqRiU5mJzSG3kDwzt9P8C59N4NGTfBLfSGE7c7'] [signature 'z5GHgTsMWEUSXVMDRyAoMG9aDVHnHAHPK3L3qzyHbMuZh7KqcciuiRVbVrs3WtaEQ4LpHVQG1YZ9WEyef35jfS2VB']]]
#]]
 ]

