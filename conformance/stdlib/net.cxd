  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/net']
[$net:addr-to-string [$net:parse-addr 'unix:/run/db.sock']]
#]]
  [out-text [#
'unix:/run/db.sock'
#]]
 ]

