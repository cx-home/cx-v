  [tags net parse-addr ipv6 pure]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/net']
[$net:parse-addr 'tcp://[::1]:8080']
#]]
  [out-text [#
[addr host='::1' port=8080 family=ipv6]
#]]
 ]

 [case id=net-004-parse-addr-udp-wildcard level=core
