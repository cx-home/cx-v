 # ── §3.5 Locale information ────────────────────────────────────────────────

 # NOTE(host-dependent): list-locales returns the resolved catalog's locale
 # sequence (~80 per §2). The spec fixes neither the exact membership nor the
 # ordering of the bundled snapshot, and §2.1 resolution can override it from
 # CX_LOCALE_DIR / system data, so no literal sequence (count or contents) is
 # assertable. Per the AUTHORING non-deterministic rule we assert a stable
 # property via a pure wrapping call instead: §4.1 guarantees is-supported is
 # true for any catalog entry, so the catalog's first entry is supported. This
 # genuinely invokes list-locales and yields the deterministic result `true`.
 # (Host-dependence of list-locales is declared in README.md "Reference
 # platform — POSIX"; this case's assertion stays as the stable pure property.)
 [case id=locale-043-list-locales-first-supported level=core
  [tags locale list-locales is-supported spec-ambiguous]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:is-supported [$first [$locale:list-locales]]]
#]]
  [out-text [#
true
#]]
 ]

 # §4.1: is-supported returns true at any fallback level.
 [case id=locale-044-is-supported-exact level=core
  [tags locale is-supported exact]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:is-supported "de-DE"]
#]]
  [out-text [#
true
#]]
 ]

 # §4.1: language match falls through — "en-GB-oxendict" → "en-GB" → "en".
 [case id=locale-045-is-supported-fallback level=core
  [tags locale is-supported fallback]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:is-supported "en-GB-oxendict"]
#]]
  [out-text [#
true
#]]
 ]

 [case id=locale-046-is-supported-tag-invalid level=core
  [tags locale is-supported CXER3501]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:is-supported "!!!"]
#]]
  [out-err [#
cx-err:CXER3501
#]]
 ]

 # NOTE(host-dependent): default-locale is impure (§3.5 — reads $LANG / Windows
 # LCID) so its literal value is environment-dependent and cannot be asserted.
 # §4.1 guarantees lookup falls back to "en-US", and is-supported is true at any
 # fallback level, so the resolved default is always a supported tag. Best
 # reading: compose default-locale through the pure is-supported predicate,
 # whose result is the stable, spec-grounded property (always true).
 # (Host-dependence of default-locale is declared in README.md "Reference
 # platform — POSIX"; this case's assertion stays as the stable pure property.)
 [case id=locale-047-default-locale-supported level=core
  [tags locale default-locale impure is-supported spec-ambiguous]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:is-supported [$locale:default-locale]]
#]]
  [out-text [#
true
#]]
 ]

 # locale-name: display "de-DE" in en-US → "German (Germany)".
 # Pinned by spec §3.5 (CLDR rendering worked example).
 [case id=locale-048-locale-name level=core
  [tags locale locale-name display]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:locale-name "de-DE" "en-US"]
#]]
  [out-text [#
'German (Germany)'
#]]
 ]

 [case id=locale-049-locale-name-tag-invalid level=core
  [tags locale locale-name CXER3501]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:locale-name "@@@" "en-US"]
#]]
  [out-err [#
cx-err:CXER3501
#]]
 ]

 # language-of "zh-Hans-CN" → "zh" (BCP 47 language subtag).
 [case id=locale-050-language-of level=core
  [tags locale language-of subtag]
  [in-cx [#
[empty]
#]]
  [in-code [#
