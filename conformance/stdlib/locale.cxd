[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/time']
[?lib 'cx-stdlib/locale']
[$locale:format-date [$time:parse-date "2026-05-26"] "fr-FR" "EEEE d MMMM yyyy"]
#]]
