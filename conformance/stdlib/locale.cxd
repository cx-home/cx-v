[test-suite name=locale ring=1
  [doc [#
conformance fixtures for cx-stdlib/locale (spec/std-lib/locale.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/locale']
   (resolver MUST be quoted) then calls [$locale:fn args]. The LAST
   expression is the rendered result. String scalars render quoted ("…");
   ints (collate -1/0/1) render bare; bools bare; atoms with leading colon
   (:ltr / :rtl); sequences in paren form (a, b, c). Date values are
   constructed via [?lib 'cx-stdlib/time'] + [time/parse-date …] since
   locale has no date constructor (the §3.3 LDML token table is shared
   between the two modules). Error cases use --- out_err with the bare
   CXER code.

   DETERMINISM: default-locale is impure (reads $LANG / Windows LCID) and
   list-locales depends on the resolved catalog snapshot; collate-key
   returns opaque UCA bytes. These are never asserted by literal value —
   see the per-case spec-ambiguous notes.

   Error codes (§5):
     CXER3500 E_LOCALE_DATA_UNAVAILABLE
     CXER3501 E_LOCALE_TAG_INVALID
     CXER3502 E_LOCALE_PATTERN_INVALID
     CXER3503 E_LOCALE_CURRENCY_INVALID
     CXER3504 E_LOCALE_NUMBER_PARSE_FAILED
#]]

 # ── §3.1 Collation ─────────────────────────────────────────────────────────

 [case id=locale-001-collate-less level=core
  [tags locale collate ordering]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate "a" "b" "en-US"]
#]]
  [out-text [#
-1
#]]
 ]

 [case id=locale-002-collate-equal level=core
  [tags locale collate ordering equal]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate "a" "a" "en-US"]
#]]
  [out-text [#
0
#]]
 ]

 [case id=locale-003-collate-greater level=core
  [tags locale collate ordering greater]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate "b" "a" "en-US"]
#]]
  [out-text [#
1
#]]
 ]

 # §4.2: collate("file10","file2","en-US") returns -1 lexicographically.
 [case id=locale-004-collate-numeric-gotcha level=core
  [tags locale collate numeric lexicographic]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate "file10" "file2" "en-US"]
#]]
  [out-text [#
-1
#]]
 ]

 [case id=locale-005-collate-tag-invalid level=core
  [tags locale collate CXER3501]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate "a" "b" "not a tag!"]
#]]
  [out-err [#
cx-err:CXER3501
#]]
 ]

 # §6: German "ä" equals "a" at primary strength (base letter only).
 [case id=locale-006-collate-opts-primary-equal level=core
  [tags locale collate-with-opts strength primary]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate-with-opts "ä" "a" {locale: "de-DE", strength: "primary"}]
#]]
  [out-text [#
0
#]]
 ]

 # §6: at tertiary (default, +case +diacritics) "ä" sorts after "a".
 [case id=locale-007-collate-opts-tertiary-after level=core
  [tags locale collate-with-opts strength tertiary]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate-with-opts "ä" "a" {locale: "de-DE", strength: "tertiary"}]
#]]
  [out-text [#
1
#]]
 ]

 # §4.2 / §6: numeric=true gives natural sort — "file2" before "file10".
 [case id=locale-008-collate-opts-numeric level=core
  [tags locale collate-with-opts numeric natural-sort]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate-with-opts "file2" "file10" {locale: "en-US", numeric: true}]
#]]
  [out-text [#
-1
#]]
 ]

 [case id=locale-009-collate-opts-tag-invalid level=core
  [tags locale collate-with-opts CXER3501]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate-with-opts "a" "b" {locale: "!!bad!!"}]
#]]
  [out-err [#
cx-err:CXER3501
#]]
 ]

 # §5 CXER3501: collate-key on a non-BCP-47 tag raises E_LOCALE_TAG_INVALID.
 [case id=locale-010-collate-key-tag-invalid level=core
  [tags locale collate-key CXER3501]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate-key "abc" "@@bad-tag@@"]
#]]
  [out-err [#
cx-err:CXER3501
#]]
 ]

