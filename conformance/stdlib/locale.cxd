 # §5 CXER3500: operation requiring locale data the bundled catalog lacks.
 # §4.1 fallback synthesizes minimal data for is-supported, but rich operations
 # (collation tables / number patterns) can still hit unavailable data.
 [case id=locale-066-collate-data-unavailable level=core
  [tags locale collate CXER3500 data-unavailable]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:collate "a" "b" "tlh-Piqd"]
#]]
  [out-err [#
cx-err:CXER3500
#]]
 ]

# 828-1a: default-locale READS AN ENVIRONMENT VARIABLE ($LANG / LC_ALL), and
 # env.md §7 states the rule flatly — "Environment-variable reads require
 # `env`". The capability-free carve-out there covers only the ambient process
 # basics "intrinsic to the running process"; an env-var read is not one, and
 # hostname/username are gated "in the same spirit". LANG not being a secret
 # does not exempt it: security.md §2.1 is a closed EFFECT-POINT table.
 # (This case carries no grant=, so the runner installs the EMPTY cap set.)
 [case id=locale-069-default-locale-requires-env level=core gate=enforced rule=EV-EFFECT-SET
  [tags locale default-locale capability env CXER0271 828]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/locale']
[$locale:default-locale]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]
]
