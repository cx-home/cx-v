    [constituents 'door/unlock door/chime']
    [reads visit]]]
  [requirements [requirement kind=functional as=resident traces=welcome [want 'to welcome a guest'] [so 'arrival is one gesture']]]]]
 [= $g [$xap:compose $door $porch]]
