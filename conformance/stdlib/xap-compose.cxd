[test-suite name=xap-compose
  [doc [#
Conformance fixtures for XAP grammar composition — the §8.1 function surface of
spec/02-working/xap_grammar_composition.md: [$xap:compose] (n feature grammars →
ONE grammar, or CXER4870 carrying every W1-W6 conflict), [$xap:compose-report]
(the never-raising tooling face), [$xap:resolve] (bare-term resolution ρ;
ambiguity is CXER4871 with candidates, never a guess), [$xap:grammar-hash]
(Tier-1 hash of the canonical composed grammar — the §3.1 equality oracle).

SPEC-FIRST: these run RED until the composition engine lands (M0) — the red
list is the implementation worklist (AUTHORING.md). Expected outputs are
hand-derived from the spec + canonical.md rendering rules; re-bless against
`cx eval` (CX_BLESS=1) when the implementation lands, per the single-oracle
rule.

Fixture families map to spec §9: 1 algebra (001-005), 2 namespace (006-007),
3 W-gate (008-016), 4 ρ-resolution (017-022), 5 N-COMPOSE-1 (021+023 as the
after/before pair), 6 N-COMPOSE-2 / runtime integration §8.2 (027-036: the
composed grammar attaches via [$xap:run {grammar: G}]; every emit then resolves
through ρ and commits the QUALIFIED intent — ambiguity is CXER4871, unknown is
CXER4872; for a derived verb the PEP evaluates the TRANSITIVE LEAF constituent
grant set — a wrapper-name grant conveys nothing, denial is CXER4850 exactly as
emitting the constituent directly would be; why-allowed answers over the same
constituent set), 7 signature derivation (024-025), 8 marine worked case (026).

Toy features are minimal-valid per feature.cxs (nouns/verbs/requirements all
present) so every input would also pass `cx validate` — fixtures never lean on
schema-invalid inputs except where the case is ABOUT invalidity (016).
#]]

  [case id=xap-compose-001-empty-identity level=core
   [tags xap-compose compose algebra identity]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $g [$xap:compose]]
 [$count $g//verb]]
#]]
   [out-text [#
0
#]]
  ]

  [case id=xap-compose-002-qualified-member level=core
   [tags xap-compose compose namespace qualification]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [frames [use frame=geo via=center]]
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs
    [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]
    [verb name=set-waypoint effect=act scope=shared consequence=reversible [intent [do :set-waypoint]] [writes viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [?let [= $g [$xap:compose $chart]]
  $g//verb[= $_@name 'chart/highlight']/@effect]]
#]]
   [out-text [#
[effect 'arrange']
#]]
  ]

  [case id=xap-compose-003-commutative level=core
   [tags xap-compose compose algebra commutativity grammar-hash]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [= $strikes
 [feature name=strikes
  [nouns [noun name=strike [field name=pos type=geo-point] [field name=at type=instant]]]
  [verbs [verb name=list-strikes effect=observe [intent [do :list-strikes]] [reads strike]]]
  [requirements [requirement kind=functional as=user traces=list-strikes [want 'to see strikes'] [so 'I avoid them']]]]]
 [= [$xap:grammar-hash [$xap:compose $chart $strikes]]
    [$xap:grammar-hash [$xap:compose $strikes $chart]]]]
#]]
   [out-text [#
true
#]]
  ]

  [case id=xap-compose-004-order-independent-nary level=core
   [tags xap-compose compose algebra associativity grammar-hash]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $a
  [feature name=a
   [nouns [noun name=an [field name=x type=int]]]
   [verbs [verb name=va effect=observe [intent [do :va]] [reads an]]]
   [requirements [requirement kind=functional as=user traces=va [want 'a'] [so 'a']]]]]
 [= $b
 [feature name=b
  [nouns [noun name=bn [field name=x type=int]]]
  [verbs [verb name=vb effect=observe [intent [do :vb]] [reads bn]]]
  [requirements [requirement kind=functional as=user traces=vb [want 'b'] [so 'b']]]]]
 [= $c
 [feature name=c
  [nouns [noun name=cn [field name=x type=int]]]
  [verbs [verb name=vc effect=observe [intent [do :vc]] [reads cn]]]
  [requirements [requirement kind=functional as=user traces=vc [want 'c'] [so 'c']]]]]
 [= [$xap:grammar-hash [$xap:compose $a $b $c]]
    [$xap:grammar-hash [$xap:compose $c $a $b]]]]
#]]
   [out-text [#
true
#]]
  ]

