  [case id=xap-compose-011-w4-mandate-exclusion-contradiction level=core
   [tags xap-compose compose w-gate w4 rules]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [= $storm-guard
 [feature name=storm-guard kind=composite
  [uses features=chart]
  [nouns [noun name=storm-marks derived=true [field name=n type=int] [from 'count of chart highlights while a storm condition holds']]]
  [verbs [verb name=watch effect=observe [intent [do :watch]] [reads storm-marks]]]
  [rules
   [rule name=must-mark kind=mandate verb='chart/highlight' when=storm [statement 'In a storm the hazard must be highlighted.']]
   [rule name=no-mark kind=exclusion verb='chart/highlight' when=storm [statement 'In a storm highlighting is forbidden.']]]
  [requirements [requirement kind=functional as=user traces=watch [want 'to watch storm marks'] [so 'I see conflicts']]]]]
 [$xap:compose $chart $storm-guard]]
#]]
   [out-err [#
cx-err:CXER4870
#]]
  ]

  [case id=xap-compose-012-w4-ordering-cycle level=core
   [tags xap-compose compose w-gate w4 ordering cycle]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=set-waypoint effect=act scope=shared consequence=reversible [intent [do :set-waypoint]] [writes viewport]]]
   [requirements [requirement kind=functional as=user traces=set-waypoint [want 'to set a waypoint'] [so 'I can navigate']]]]]
 [= $strikes
 [feature name=strikes
  [nouns [noun name=strike [field name=pos type=geo-point] [field name=at type=instant]]]
  [verbs [verb name=list-strikes effect=observe [intent [do :list-strikes]] [reads strike]]]
  [requirements [requirement kind=functional as=user traces=list-strikes [want 'to see strikes'] [so 'I avoid them']]]]]
 [= $seq-guard
 [feature name=seq-guard kind=composite
  [uses features='chart strikes']
  [nouns [noun name=plan derived=true [field name=n type=int] [from 'waypoints ordered against strike listings']]]
  [verbs [verb name=review effect=observe [intent [do :review]] [reads plan]]]
  [rules
   [rule name=o1 kind=ordering verb='chart/set-waypoint' after='strikes/list-strikes' [statement 'Check strikes before setting a waypoint.']]
   [rule name=o2 kind=ordering verb='strikes/list-strikes' after='chart/set-waypoint' [statement 'Set the waypoint before checking strikes.']]]
  [requirements [requirement kind=functional as=user traces=review [want 'to review the plan'] [so 'I trust it']]]]]
 [$xap:compose $chart $strikes $seq-guard]]
#]]
   [out-err [#
cx-err:CXER4870
#]]
  ]

