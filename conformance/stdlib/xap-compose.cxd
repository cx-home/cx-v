  [case id=xap-compose-037-resolve-closure-composes-demotes level=core
   [tags xap resolve resolver context-composition tier]
   [; #535 §3.6 — the context→composition entry applies the {resolver: …}
      closure ($context $opts); the proposal's reason travels, and the
      requested :foreground demotes to T2 foreground-propose (§20.2: a
      resolver proposal never seizes the foreground). ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $resolver [?fn ($ctx $opts)
    [?if [= [$concat '' $ctx@focus] 'orders']
      [then [$xap:surface 'order-radar' ([$xap:panel 'order-list' {}])
              {reason: 'focus=orders matches order-list affinity'}]]
      [else ()]]]]
  [= $rt [$xap:run {tenant: 'acme', resolver: $resolver}]]
  [$xap:resolve $rt [?element 'context' [?attr 'focus' 'orders']] {tier: :foreground}]]
#]]
   [out-text [#
[xap-surface name=order-radar reason='focus=orders matches order-list affinity' tier=T2 ([xap-panel component=order-list {}])]
#]]
  ]

  [case id=xap-compose-038-resolve-default-tier-peripheral level=core
   [tags xap resolve resolver tier peripheral]
   [; #535 — unrequested placement grants T3 (peripheral-ready, the §20.2
      default posture). ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $resolver [?fn ($ctx $opts)
    [$xap:surface 'radar' () {reason: 'always'}]]]
  [= $rt [$xap:run {tenant: 'acme', resolver: $resolver}]]
  [$xap:resolve $rt [?element 'context'] {}]]
#]]
   [out-text [#
[xap-surface name=radar reason=always tier=T3 ()]
#]]
  ]

  [case id=xap-compose-039-resolve-scripted-default-absence level=core
   [tags xap resolve resolver scripted absence]
   [; #535 — the :scripted default with no declared context-affinity rules
      resolves to the ABSENCE channel (nothing meets threshold), never an
      error and never a fabricated surface. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $rt [$xap:run {tenant: 'acme'}]]
  [$empty [$xap:resolve $rt [?element 'context' [?attr 'focus' 'orders']] {}]]]
#]]
   [out-text [#
true
#]]
  ]

  [case id=xap-compose-040-resolve-proposal-requires-reason level=core
   [tags xap resolve resolver reason CXER4853]
   [; #535 §19 — decisions are journaled WITH :reason; a proposal without
      one refuses with an actionable diagnostic. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $noreason [?fn ($ctx $opts) [$xap:surface 'bare' () {}]]]
  [= $rt [$xap:run {tenant: 'acme', resolver: $noreason}]]
  [$xap:resolve $rt [?element 'context'] {}]]
#]]
   [out-text [#
[err code=cx-err:CXER4853 message='E_XAP_SURFACE_INVALID: a resolver proposal must carry reason=… — the decision is journaled and auditable (xap.md §19); stamp the attr on the proposed surface']
#]]
  ]

  [case id=xap-compose-041-resolve-shape-dispatch-names-both level=core
   [tags xap resolve shape-dispatch CXER4852]
   [; #535 ask 2 — the one head carries two contracts; a first argument
      that is neither names BOTH so debugging goes to the right section. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[$xap:resolve [?element 'neither-shape'] 'term' {}]
#]]
   [out-text [#
[err code=cx-err:CXER4852 message='E_XAP: resolve is shape-dispatched on its first argument — a composed [grammar …] = §8.1 ρ term resolution (grammar, term, context?); an [xap-runtime …] handle = §3.6 context→composition (runtime, context, opts?); got neither']
#]]
  ]

  [case id=xap-compose-043-scripted-affinity-pin-composes level=core
   [tags xap resolve resolver-default affinity ramp dial]
   [; #535 PR 2 — the scripted fold end-to-end: a fresh system surfaces
      NOTHING unsolicited (§20.1 level 0 = summon-only); a §20.1 manual pin
      — an ordinary dial delegation at scope ramp/<component>/<class> with
      [setting level=N] (§21.3, one mechanism) — raises the capability to
      peripheral-suggest and the declared §3.2 affinity composes with a
      GENERATED deterministic reason. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $c [$xap:component 'rl43-orders' {bind: '/orders',
      affinity: ([affinity when="context[= $_@focus 'rl43']" class=:rl43.triage rank=1])}]]
  [= $rt [$xap:run {tenant: 'acme'}]]
  [= $fresh [$empty [$xap:resolve $rt [?element 'context' [?attr 'focus' 'rl43']] {}]]]
  [= $pin [$xap:dial $rt [from id="principal:dana"] [to id="agent:resolver"]
            [scope 'ramp/rl43-orders/rl43.triage'] [setting level=2]]]
  [= $hit [$xap:resolve $rt [?element 'context' [?attr 'focus' 'rl43']] {}]]
  [probe [fresh $fresh] [hit $hit]]]
#]]
   [out-text [#
[probe [fresh true] [hit [xap-surface name=scripted reason="scripted: rl43-orders: affinity :rl43.triage matched context[= $_@focus 'rl43'] (ramp level 2)" tier=T3 ([xap-panel component=rl43-orders {}])]]]
#]]
  ]

  [case id=xap-compose-044-scripted-t2-needs-level-3 level=core
   [tags xap resolve resolver-default ramp tier]
   [; #535 PR 2 — a T2 (foreground-propose) placement gates at ramp level 3
      (§20.1 = ramp level 3 ↔ §20.2 T2): a level-2 pin surfaces peripherally
      but gates out of :foreground; raising the pin to 3 grants T2 (the
      LAST matching dial wins — later dials adjust earlier ones). ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $c [$xap:component 'rl45-orders' {bind: '/o',
      affinity: ([affinity when="context[= $_@focus 'rl45']" class=:rl45.c rank=1])}]]
  [= $rt [$xap:run {tenant: 'acme'}]]
  [= $p2 [$xap:dial $rt [from id="principal:d"] [to id="agent:resolver"]
           [scope 'ramp/rl45-orders/rl45.c'] [setting level=2]]]
  [= $gated [$empty [$xap:resolve $rt [?element 'context' [?attr 'focus' 'rl45']] {tier: :foreground}]]]
  [= $p3 [$xap:dial $rt [from id="principal:d"] [to id="agent:resolver"]
           [scope 'ramp/rl45-orders/rl45.c'] [setting level=3]]]
  [= $t2 [$xap:resolve $rt [?element 'context' [?attr 'focus' 'rl45']] {tier: :foreground}]]
  [probe [gated $gated] [t2-tier [$concat '' $t2@tier]]]]
#]]
   [out-text [#
[probe [gated true] [t2-tier 'T2']]
#]]
  ]

  [case id=xap-compose-045-affinity-malformed-refuses level=core
   [tags xap component affinity validation CXER4852]
   [; #535 PR 2 — a malformed [affinity] clause (here the retired infix
      predicate) refuses AT DECLARATION with the engine's actionable
      diagnostic — never a silently inert rule. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[$xap:component 'rl46-bad' {affinity: ([affinity when="ctx[@x=1]" class=:c])}]
#]]
   [out-text [#
[err code=cx-err:CXER4852 message='E_XAP_COMPONENT_INVALID: affinity when="ctx[@x=1]" is not a CXPath expression: cx-err:CXER0100: infix attribute comparison `[@x=…]` in a CXPath predicate is retired — predicates are homoiconic CX code; write the prefix operator form `[= $_@x …]` (code.md §5.5.2) at line 1:15']
#]]
  ]

  [case id=xap-compose-046-resolver-default-value-ranks level=core
   [tags xap resolver-default rank dial]
   [; #535 PR 2 — [$xap:resolver-default $rules] returns a first-class
      [scripted-resolver …] value {resolver: …} accepts; the fold ranks by
      declared rank (alpha rank 1 before beta rank 2 despite declaration
      order) and a GENERAL ramp/<component> pin (no class) applies too. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $rd [$xap:resolver-default (
      [affinity component='rl47-beta'  when="context" class=:rl47 rank=2],
      [affinity component='rl47-alpha' when="context" class=:rl47 rank=1])]]
  [= $rt [$xap:run {tenant: 'acme', resolver: $rd}]]
  [= $p1 [$xap:dial $rt [from id="principal:d"] [to id="agent:resolver"] [scope 'ramp/rl47-alpha/rl47'] [setting level=2]]]
  [= $p2 [$xap:dial $rt [from id="principal:d"] [to id="agent:resolver"] [scope 'ramp/rl47-beta'] [setting level=2]]]
  [$xap:resolve $rt [?element 'context'] {}]]
#]]
   [out-text [#
[xap-surface name=scripted reason='scripted: rl47-alpha: affinity :rl47 matched context (ramp level 2); rl47-beta: affinity :rl47 matched context (ramp level 2)' tier=T3 ([xap-panel component=rl47-alpha {}], [xap-panel component=rl47-beta {}])]
#]]
  ]

  [case id=xap-compose-047-resolver-default-needs-component level=core
   [tags xap resolver-default validation CXER4852]
   [; #535 PR 2 — standalone rules carry component=… (no declaration to
      ride on); missing it refuses. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[$xap:resolver-default ([affinity when="context" class=:c])]
#]]
   [out-text [#
[err code=cx-err:CXER4852 message='E_XAP: resolver-default rules carry component=… (the standalone form has no component declaration to ride on; xap.md §3.6)']
#]]
  ]

  [case id=xap-compose-048-respond-fold-promotes-demotes level=core
   [tags xap resolve-respond ramp fold summon]
   [; #553 — the §20.1 fold end-to-end WITHOUT a pin: fresh = absence;
      opts.summon composes at level 0 (summon-only IS level 0's right,
      the organic bootstrap) with [candidate …] metadata RELOCATED to the
      journaled decision (0 in the surface); four consecutive acted-ons =
      level 2 → anticipatory surfacing; ONE dismissal drops a level (fast
      to lose) → absence again. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $c [$xap:component 'rl48-x' {bind: '/o',
      affinity: ([affinity when="context[= $_@focus 'rl48']" class=:rl48.c rank=1])}]]
  [= $rt [$xap:run {tenant: 'acme'}]]
  [= $ctx [?element 'context' [?attr 'focus' 'rl48']]]
  [= $fresh [$empty [$xap:resolve $rt $ctx {}]]]
  [= $sum [$xap:resolve $rt $ctx {summon: 'rl48-x'}]]
  [= $r1 [$xap:resolve-respond $rt 'rl48-x' :acted-on]]
  [= $r2 [$xap:resolve-respond $rt 'rl48-x' :acted-on]]
  [= $r3 [$xap:resolve-respond $rt 'rl48-x' :acted-on]]
  [= $r4 [$xap:resolve-respond $rt 'rl48-x' :acted-on]]
  [= $promoted [$xap:resolve $rt $ctx {}]]
  [= $d1 [$xap:resolve-respond $rt 'scripted' :glanced-dismissed]]
  [= $demoted [$empty [$xap:resolve $rt $ctx {}]]]
  [probe
    [fresh $fresh]
    [sum-name [$concat '' $sum@name]]
    [cand-in-surface [$count $sum//candidate]]
    [promoted-name [$concat '' $promoted@name]]
    [demoted $demoted]]]
#]]
   [out-text [#
[probe [fresh true] [sum-name 'rl48-x'] [cand-in-surface 0] [promoted-name 'scripted'] [demoted true]]
#]]
  ]

  [case id=xap-compose-049-respond-suppression-sticky level=core
   [tags xap resolve-respond ramp suppressed]
   [; #553 — :suppressed sticks at level 0 ("don't show me this"); a later
      acted-on run (re-engagement, e.g. after a fresh summon) clears it
      and re-promotes. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $c [$xap:component 'rl49-x' {bind: '/o',
      affinity: ([affinity when="context" class=:rl49.c rank=1])}]]
  [= $rt [$xap:run {tenant: 'acme'}]]
  [= $ctx [?element 'context']]
  [= $sum [$xap:resolve $rt $ctx {summon: 'rl49-x'}]]
  [= $s [$xap:resolve-respond $rt 'rl49-x' :suppressed]]
  [= $suppressed [$empty [$xap:resolve $rt $ctx {}]]]
  [= $a1 [$xap:resolve-respond $rt 'rl49-x' :acted-on]]
  [= $a2 [$xap:resolve-respond $rt 'rl49-x' :acted-on]]
  [= $a3 [$xap:resolve-respond $rt 'rl49-x' :acted-on]]
  [= $a4 [$xap:resolve-respond $rt 'rl49-x' :acted-on]]
  [= $back [$xap:resolve $rt $ctx {}]]
  [probe [suppressed $suppressed] [back-name [$concat '' $back@name]]]]
#]]
   [out-text [#
[probe [suppressed true] [back-name 'scripted']]
#]]
  ]

  [case id=xap-compose-050-respond-vocabulary-closed level=core
   [tags xap resolve-respond validation CXER4852]
   [; #553 — the response vocabulary is the closed §20.1 set; anything else
      refuses with the set named. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let
  [= $rt [$xap:run {tenant: 'acme'}]]
  [$xap:resolve-respond $rt 'whatever' :meh]]
#]]
   [out-text [#
[err code=cx-err:CXER4852 message='E_XAP: resolve-respond response must be :acted-on, :glanced-dismissed, :ignored, or :suppressed (xap.md §20.1); got "meh"']
#]]
  ]

  [case id=xap-compose-042-run-resolver-option-validates level=core
   [tags xap run resolver-option CXER4852]
   [; #535 §3.1 — {resolver: …} takes :scripted or a CX closure; the spec'd
      external-handle variant refuses loudly until it ships (never
      accept-and-ignore). ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[$xap:run {tenant: 'acme', resolver: 'not-a-closure'}]
#]]
   [out-text [#
[err code=cx-err:CXER4852 message='E_XAP: run {resolver: …} takes :scripted, a CX closure, or a [$xap:resolver-default …] value — an external resolver handle is not yet a shipped surface (xap.md §3.1/§3.6)']
#]]
  ]

  [case id=xap-compose-053-w5-from-reference-not-a-noun level=core
   [tags xap-compose compose w-gate w5 from derived-noun]
   [; #840 — W5 covers every qualified noun reference in a derived noun's
      [from …] (spec §4.1). Before this the noun parser read `name` and
      `derived` and stopped, so a composite could name a noun that does not
      exist and compose CLEAN — the one part describing its actual content
      was unvalidated free text while `uses` beside it was strict. Here
      `chart/viewport` resolves and `nosuchfeature/nothing` does not. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [= $dangling
 [feature name=dangling kind=composite
  [uses features='chart']
  [nouns [noun name=shadow derived=true [field name=n type=int]
          [from 'chart/viewport' 'nosuchfeature/nothing']]]
  [verbs [verb name=peek effect=observe [intent [do :peek]] [reads shadow]]]
  [requirements [requirement kind=functional as=user traces=peek [want 'to peek'] [so 'peeked']]]]]
 [= $r [$xap:compose-report $chart $dangling]]
 [$first [?for [in $c $r//conflict] [yield $c@detail]]]]
#]]
   [out-text [#
'[from …] reference "nosuchfeature/nothing" is not a noun of the composed grammar'
#]]
  ]

  [case id=xap-compose-054-w5-derived-noun-without-from level=core
   [tags xap-compose compose w-gate w5 from derived-noun]
   [; #840 (spec §4.1) — a `derived` noun with NO [from …] is a W5 violation:
      a derived noun that says nothing about its source is exactly the
      unchecked free text this rule replaces. Fail-closed, not tolerated. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [= $sourceless
 [feature name=sourceless kind=composite
  [uses features='chart']
  [nouns [noun name=shadow derived=true [field name=n type=int]]]
  [verbs [verb name=peek effect=observe [intent [do :peek]] [reads shadow]]]
  [requirements [requirement kind=functional as=user traces=peek [want 'to peek'] [so 'peeked']]]]]
 [= $r [$xap:compose-report $chart $sourceless]]
 [$first [?for [in $c $r//conflict] [yield $c@detail]]]]
#]]
   [out-text [#
'derived noun "sourceless/shadow" declares no [from …] source list'
#]]
  ]

  [case id=xap-compose-055-w5-from-resolving-composes-clean level=core
   [tags xap-compose compose w-gate w5 from derived-noun green]
   [; #840 — the positive side, so the check is not merely a way to fail:
      a derived noun whose [from …] references all resolve composes green.
      Note the join itself is NOT computed and NOT checked — [from …] names
      the sources only; join semantics stay unspecified (spec §4.1). ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [= $shade
 [feature name=shade kind=composite
  [uses features='chart']
  [nouns [noun name=shadow derived=true [field name=n type=int]
          [from 'chart/viewport']]]
  [verbs [verb name=peek effect=observe [intent [do :peek]] [reads shadow]]]
  [requirements [requirement kind=functional as=user traces=peek [want 'to peek'] [so 'peeked']]]]]
 [= $r [$xap:compose-report $chart $shade]]
 $r@ok]
#]]
   [out-text [#
true
#]]
  ]

  [case id=xap-compose-056-w7-write-verb-on-derived-noun-refuses level=core
   [tags xap-compose compose w-gate w7 derived-noun deriver-reserved]
   [; #865 §4.2/R8.2 — a derived noun is DERIVER-RESERVED: no grammar verb
      may declare [writes] onto it. The producer is the deriver bound at run
      assembly; a hand-rolled write verb is exactly the workaround W7 exists
      to retire. The report face carries the :w7 conflict; the enforcing
      face refuses with CXER4870 (agreement law, §8.1). ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $chart
  [feature name=chart
   [nouns [noun name=viewport singular=true [field name=center type=geo-point]]]
   [verbs [verb name=highlight effect=arrange [intent [do :highlight]] [reads viewport]]]
   [requirements [requirement kind=functional as=user traces=highlight [want 'to mark a spot'] [so 'I can find it']]]]]
 [= $shade
 [feature name=shade kind=composite
  [uses features='chart']
  [nouns [noun name=shadow derived=true [field name=n type=int]
          [from 'chart/viewport']]]
  [verbs [verb name=assert-shadow effect=act [intent [do :assert-shadow [n]]] [writes shadow]]
         [verb name=peek effect=observe [intent [do :peek]] [reads shadow]]]
  [requirements [requirement kind=functional as=user traces=peek [want 'to peek'] [so 'peeked']]]]]
 [= $r [$xap:compose-report $chart $shade]]
 [probe [ok $r@ok]
        [w7 [$count [?for [in $c $r//conflict] [where [= $c@code ':w7']] [yield $c]]]]]]
#]]
   [out-text [#
[probe [ok false] [w7 1]]
#]]
  ]

  [case id=xap-compose-057-instantiate-effective-feature level=core
   [tags xap-compose instantiate archetype refinement-contract green]
   [; #866 §4.3 — the positive shape: a pinned binding renames presentation,
      adds, tightens, selects; the effective feature carries the instance
      name, the tighten, the requalified self-references, the [selection],
      and its [instantiated-from …] provenance — and composes like any
      other feature. The pin is computed in-case (the archetype is inline),
      which is also the demonstration that of= is derivable, never magic. ]
   [; R-A1 migration: envelope → spliced children (2026-08-25) ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/hash' :as hash]
[?lib 'cx-stdlib/bytes' :as bytes]
[?let [= $arch
  [feature name=stamp version="1"
   [nouns [noun name=mark [field name=id type=text] [field name=note type=text label='Note']]]
   [verbs [verb name=press effect=act scope=shared consequence=reversible [intent [do :press [id]]] [writes mark]]
          [verb name=see effect=observe [intent [do :see]] [reads mark]]]
   [rules [rule name=see-after-press kind=ordering verb='stamp/see' after='stamp/press'
           [statement 'You can only see a mark that was pressed.']]]
   [requirements [requirement kind=functional as=user traces=press [want 'to press'] [so 'pressed']]]]]
 [= $pin [$concat "sha2-256:" [$bytes:to-hex [$hash:sha256-string [$cx:canonical $arch]]]]]
 [= $eff [$xap:instantiate $arch
   [instance name=wax-seal of=$pin
    [rename field='mark/note' label='Inscription']
    [add on=mark [field name=colour type=text]]
    [tighten verb=press consequence=irreversible]
    [select [offer verb=press] [not-offered verb=see why='Seals are inspected by the registrar.']]]]]
 [= $r [$xap:compose-report $eff]]
 [probe [name [$string $eff@name]]
        [cq [?for [in $v $eff//verb] [where [= [$string $v@name] "press"]] [yield [$string $v@consequence]]]]
        [rule [?for [in $ru $eff//rule] [yield [$string $ru@verb]]]]
        [fields [$count $eff//field]]
        [sel [$count $eff//selection]]
        [prov [$count $eff//instantiated-from]]
        [composes [$string $r@ok]]]]
#]]
   [out-text [#
[probe [name 'wax-seal'] [cq 'irreversible'] [rule 'wax-seal/see'] [fields 3] [sel 1] [prov 1] [composes 'true']]
#]]
  ]

  [case id=xap-compose-058-instantiate-repurpose-refuses level=core
   [tags xap-compose instantiate archetype repurpose refusal]
   [; #866 §4.3 — the ERP trap: an [add] colliding with an inherited name is
      giving that name a different meaning. CXER4877, no escape hatch. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/hash' :as hash]
[?lib 'cx-stdlib/bytes' :as bytes]
[?let [= $arch
  [feature name=stamp version="1"
   [nouns [noun name=mark [field name=id type=text]]]
   [verbs [verb name=press effect=act [intent [do :press [id]]] [writes mark]]]
   [requirements [requirement kind=functional as=user traces=press [want 'to press'] [so 'pressed']]]]]
 [= $pin [$concat "sha2-256:" [$bytes:to-hex [$hash:sha256-string [$cx:canonical $arch]]]]]
 [$xap:instantiate $arch
   [instance name=x of=$pin
    [add [verb name=press effect=observe [intent [do :press]]]]]]]
#]]
   [out-err [#
cx-err:CXER4877
#]]
  ]

  [case id=xap-compose-059-instantiate-loosen-refuses level=core
   [tags xap-compose instantiate archetype loosen refusal]
   [; #866 §4.3 — substitutability: one loosened instance means no consumer
      can trust any instance. A widening [tighten] refuses CXER4878. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/hash' :as hash]
[?lib 'cx-stdlib/bytes' :as bytes]
[?let [= $arch
  [feature name=stamp version="1"
   [nouns [noun name=mark [field name=id type=text]]]
   [verbs [verb name=press effect=act scope=shared consequence=irreversible [intent [do :press [id]]] [writes mark]]]
   [requirements [requirement kind=functional as=user traces=press [want 'to press'] [so 'pressed']]]]]
 [= $pin [$concat "sha2-256:" [$bytes:to-hex [$hash:sha256-string [$cx:canonical $arch]]]]]
 [$xap:instantiate $arch
   [instance name=x of=$pin
    [tighten verb=press consequence=reversible]]]]
#]]
   [out-err [#
cx-err:CXER4878
#]]
  ]

  [case id=xap-compose-060-instantiate-stale-pin-refuses level=core
   [tags xap-compose instantiate archetype pin refusal]
   [; #866 §4.3 — an instance derives from an EXACT base; a pin that does
      not match the archetype presented refuses CXER4879. Re-bless is the
      pin moving deliberately, never the base moving underneath it. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $arch
  [feature name=stamp version="1"
   [nouns [noun name=mark [field name=id type=text]]]
   [verbs [verb name=press effect=act [intent [do :press [id]]] [writes mark]]]
   [requirements [requirement kind=functional as=user traces=press [want 'to press'] [so 'pressed']]]]]
 [$xap:instantiate $arch [instance name=x of='sha2-256:0000dead' ]]]
#]]
   [out-err [#
cx-err:CXER4879
#]]
  ]

  [case id=xap-compose-061-cohesion-one-component level=core
   [tags xap-compose cohesion granularity green]
   [; #867 §4.4 — a healthy feature is ONE component: the verb reads/writes
      edges and a declared rule noun-list bind every member. Report-first:
      the instrument never refuses. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $f
  [feature name=till version="1"
   [nouns [noun name=sale [field name=id type=text]]
          [noun name=receipt [field name=sale-id type=text]]]
   [verbs [verb name=ring-up effect=act [intent [do :ring-up [id]]] [writes sale]]
          [verb name=print effect=act [intent [do :print [id]]] [writes receipt]]]
   [rules [rule name=receipt-cites-sale kind=validity nouns='receipt sale'
           [statement 'A receipt MUST cite the sale it records.']]]
   [requirements [requirement kind=functional as=clerk traces=ring-up [want 'to ring up'] [so 'rung']]]]]
 [= $r [$xap:cohesion $f]]
 [probe [n [$string $r@components]] [members [$count $r//member]] [edges [$count $r//edge]]]]
#]]
   [out-text [#
[probe [n '1'] [members 4] [edges 3]]
#]]
  ]

  [case id=xap-compose-062-cohesion-two-domains-report-two level=core
   [tags xap-compose cohesion granularity split-advisor]
   [; #867 §4.4 — two connected components are two features wearing one
      name, and the components ARE the split the gate would accept. ]
   [; R-A1 migration: envelope → spliced children (2026-08-25) ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $f
  [feature name=till-and-piano version="1"
   [nouns [noun name=sale [field name=id type=text]]
          [noun name=piano [field name=pitch type=text]]]
   [verbs [verb name=ring-up effect=act [intent [do :ring-up [id]]] [writes sale]]
          [verb name=tune effect=act [intent [do :tune]] [writes piano]]]
   [requirements [requirement kind=functional as=clerk traces=ring-up [want 'to ring up'] [so 'rung']]]]]
 [= $r [$xap:cohesion $f]]
 [probe [n [$string $r@components]]
        [split [?for [in $c $r//component]
                 [yield [part [?splice [?for [in $m $c/*] [yield [x [$string $m@name]]]]]]]]]]]
#]]
   [out-text [#
[probe [n '2'] [split [part [x 'piano'] [x 'tune']] [part [x 'sale'] [x 'ring-up']]]]
#]]
  ]

  [case id=xap-compose-063-rule-nouns-existence-checked level=core
   [tags xap-compose cohesion w-gate w5 rule-nouns]
   [; #867 §4.4 rider — declaring nouns= opts the rule into compose-time
      existence checking, exactly like the other structured targets. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?let [= $f
  [feature name=till version="1"
   [nouns [noun name=sale [field name=id type=text]]]
   [verbs [verb name=ring-up effect=act [intent [do :ring-up [id]]] [writes sale]]]
   [rules [rule name=cites kind=validity nouns='sale ghost'
           [statement 'A sale MUST cite a ghost.']]]
   [requirements [requirement kind=functional as=clerk traces=ring-up [want 'to ring up'] [so 'rung']]]]]
 [= $r [$xap:compose-report $f]]
 [probe [ok [$string $r@ok]] [n [$count $r//conflict]]]]
#]]
   [out-text [#
[probe [ok 'false'] [n 1]]
#]]
  ]
]
