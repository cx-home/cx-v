 ]
 [case id=array-108-doc-put level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:put [1, 2, 3] 2 9]
#]]
  [out-text [# [1, 9, 3] #]]
 ]
 [case id=array-109-doc-remove level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:remove [1, 2, 3] 2]
#]]
  [out-text [# [1, 3] #]]
 ]
 [case id=array-110-doc-insert-before level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:insert-before [1, 3] 2 2]
#]]
  [out-text [# [1, 2, 3] #]]
 ]
 [case id=array-111-doc-flatten level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:flatten [1, [2, [3]], 4]]
#]]
  [out-text [# (1, 2, 3, 4) #]]
 ]
 [case id=array-112-doc-join level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:join ([1, 2], [3])]
#]]
  [out-text [# [1, 2, 3] #]]
 ]
 [case id=array-113-doc-sort level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:sort [3, 1, 2]]
#]]
  [out-text [# [1, 2, 3] #]]
 ]
 [case id=array-114-doc-filter level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:filter [1, 2, 3, 4] [?fn ($x) [> $x 2]]]
#]]
  [out-text [# [3, 4] #]]
 ]
 [case id=array-115-doc-for-each level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:for-each [1, 2, 3] [?fn ($x) [* $x 10]]]
#]]
  [out-text [# [10, 20, 30] #]]
 ]
 [case id=array-116-doc-fold-left level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:fold-left [1, 2, 3] 0 [?fn ($acc $x) [+ $acc $x]]]
#]]
  [out-text [# 6 #]]
 ]
 [case id=array-117-doc-fold-right level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:fold-right [1, 2, 3] 0 [?fn ($x $acc) [- $x $acc]]]
#]]
