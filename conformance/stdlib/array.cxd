 ]
 [case id=array-107-doc-subarray level=core
  [tags array fn-doc example]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/array']
[$array:subarray [10, 20, 30, 40] 2 2]
#]]
