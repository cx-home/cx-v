 [case id=test-031-fixture-load-granted level=core gate=enforced grant='read write'
  [tags test fixture-load granted effort-b]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/test']
[?let [= $d [$io:temp-dir "cxc"]]
  [= $p [$path:join $d "fx.cx"]]
  [= $w [$io:write-file $p "[user name=\"alice\" age=30]"]]
  [?let [= $fx [$test:fixture-load $p]] $fx@name]]
#]]
  [out-text [#
'alice'
#]]
 ]

]
