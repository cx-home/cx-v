  [tags test assert-shape fail CXER2200]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/test']
[$test:assert-shape [user id="not-an-int"] [schema [field name="id" type="int" required=true]]]
#]]
  [out-err [#
cx-err:CXER2200
#]]
 ]

