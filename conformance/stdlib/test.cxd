# assert-match takes a $pattern::element matched "per [?match]". A plain
# (non-@) attribute on the pattern element is a structural-equality test
# on that attribute's value (spec/core/code.md §5.2 rule 9), so
# [user id=1] matches a value with id=1. A value structurally matching
# the pattern passes (returns null).
 [case id=test-018-assert-match-pass level=core
  [tags test assert-match happy pattern]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/test']
[$test:assert-match [user id=1] [user id=1]]
#]]
  [out-text [#
null
#]]
 ]

# assert-match failure path: a value not matching the pattern raises
# CXER2200 (§5). Here [user id=2] fails the structural-equality test on
# the plain id attribute (§5.2 rule 9) against [user id=1].
 [case id=test-019-assert-match-no-match-fails level=core
  [tags test assert-match fail CXER2200]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/test']
[$test:assert-match [user id=1] [user id=2]]
#]]
  [out-err [#
cx-err:CXER2200
#]]
 ]

# NOTE(snapshot-harness): assert-snapshot is effectful — it records/compares
# against files under __snapshots__/ resolved relative to the test
# program or $snapshot-dir (§3.1). CXER2203 fires only on a SECOND run
# whose value diverges from a previously recorded snapshot, outside
# update mode. A single eval under the runner has no pre-recorded
# snapshot and no test-program dir, so the spec-correct outcome of one
# isolated call (first-run record-and-pass vs. a missing snapshot dir) is
# not determinable from test.md. Best reading: the documented mismatch
# code CXER2203 is the stable assertion target for the divergence
# scenario; reconcile the first-run/record semantics in a snapshot-dir
# harness (see report).
# gate=pending: no snapshot store exists under the conformance runner; revisit when the test module + a snapshot-harness mode land.
 [case id=test-020-assert-snapshot-mismatch level=core gate=pending
  [tags test assert-snapshot CXER2203]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/test']
[$test:assert-snapshot [user id=1] $snapshot-key="user-shape"]
#]]
  [out-err [#
cx-err:CXER2203
#]]
 ]

