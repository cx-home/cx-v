 ]

 # §4/§6: missing CLDR ordinal data degrades soft to :other.
 [case id=i18n-044-plural-category-ordinal-degrade level=core
  [tags i18n plural-category-ordinal degrade other atom]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:plural-category-ordinal 2 "zxx"]
#]]
  [out-text [#
:other
#]]
 ]
 [case id=i18n-045-load-catalog-granted level=core gate=enforced grant='read write' packs=io
  [tags i18n load-catalog granted effort-b]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/i18n']
[?let [= $d [$io:temp-dir "cxc"]]
  [= $p [$path:join $d "cat.cx"]]
  [= $w [$io:write-file $p "[catalog default=\"en\" [entry key=\"greeting\" [msg locale=\"en\" Hello]]]"]]
  [?let [= $cat [$i18n:load-catalog $p]] $cat@default]]
#]]
  [out-text [#
'en'
#]]
 ]

]
