#]]
 ]

 # §3.4 selectordinal en example basis: place=2 → two (ordinal).
 [case id=i18n-042-plural-category-ordinal-en-two level=core
  [tags i18n plural-category-ordinal en two atom]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:plural-category-ordinal 2 "en"]
