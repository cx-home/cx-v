 ]

 # §3.4 selectordinal en example basis: place=11 → other (teens → th).
 [case id=i18n-043-plural-category-ordinal-en-other level=core
  [tags i18n plural-category-ordinal en other atom]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:plural-category-ordinal 11 "en"]
#]]
