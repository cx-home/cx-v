[test-suite name=i18n ring=1
  [doc [#
conformance fixtures for cx-stdlib/i18n (spec/std-lib/i18n.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/i18n']
   (resolver MUST be quoted) then calls [$i18n:fn args]. The LAST
   expression is the rendered result. String scalars render quoted;
   bool bare; atoms with leading colon (:one); sequences in paren form
   (a, b, c). Error fixtures use out-err with the bare CXER code.

   Grounding: every expected value comes from spec examples (§3.2, §3.3,
   §3.4, §3.5), the §6 conformance list, and the §4/§5 normative rules.
   args maps and catalog-from-map inputs use CX map-literal {"k": v} form
   (the spec's {n=5} shorthand is illustrative). Catalog values are opaque
   [catalog …] elements; cases over them assert observable results
   (resolved messages, locales, keys) rather than element rendering, except
   where the spec pins the catalog's structural shape and round-trip.
#]]

 # ── §3.1 catalog-from-map ──────────────────────────────────────────────
 [case id=i18n-001-catalog-from-map-locales level=core
  [tags i18n catalog-from-map catalog]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-locales [$i18n:catalog-from-map {"greeting": {"en": "Hello, {name}!", "fr": "Bonjour, {name} !"}}]]
#]]
  [out-text [#
(en, fr)
#]]
 ]

 [case id=i18n-002-catalog-from-map-keys level=core
  [tags i18n catalog-from-map catalog-keys]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-keys [$i18n:catalog-from-map {"greeting": {"en": "Hello, {name}!"}, "farewell": {"en": "Bye, {name}!"}}]]
#]]
  [out-text [#
(greeting, farewell)
#]]
 ]

 # default-locale fallback: spec §3.1 — the optional "default" map entry sets
 # the catalog default; resolving any locale ultimately falls through to it.
 # This case asserts the resolved message (observable), grounded in the §3.2
 # greeting example: the de→en→default chain (§2.2) reaches the "en" entry.
 [case id=i18n-003-catalog-from-map-default level=core
  [tags i18n catalog-from-map default message]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:message [$i18n:catalog-from-map {"default": "en", "greeting": {"en": "Hello, {name}!"}}] "greeting" "de" {"name": "Ada"}]
#]]
  [out-text [#
Hello, Ada!
#]]
 ]

 # ── §3.1 / §6 catalog shape (catalog-from-map returns a [catalog …]) ─────
 # §3.1/§2.1: a catalog with no declared default uses default="en". §2.2: the
 # es→en→default chain reaches the "en" entry for an absent locale, so message
 # resolution returns the §3.2-style "Hello!" — an observable, spec-pinned result.
 [case id=i18n-004-catalog-from-map-default-absent level=core
  [tags i18n catalog-from-map default edge]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:message [$i18n:catalog-from-map {"greeting": {"en": "Hello!"}}] "greeting" "es" {}]
#]]
  [out-text [#
Hello!
#]]
 ]

 # ── §3.1 load-catalog (impure, read capability §7) ──────────────────────
 # §7: load-catalog is the one capability-gated function (read). Under
 # deny-by-default (security.md §2) the effect point checks the active set and
 # raises CXER0271 before touching the filesystem, so the capability-denied
 # error is deterministic regardless of whether the path exists.
 [case id=i18n-005-load-catalog-cap-denied level=core
  [tags i18n load-catalog capability CXER0271]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:load-catalog "conformance/data/i18n/messages.cx"]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 # ── §3.1 catalog-merge (variadic, last-writer-wins §3.1/§6) ─────────────
 [case id=i18n-006-catalog-merge-last-writer level=core
  [tags i18n catalog-merge variadic]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:message [$i18n:catalog-merge [$i18n:catalog-from-map {"k": {"en": "A"}}] [$i18n:catalog-from-map {"k": {"en": "B"}}]] "k" "en" {}]
#]]
  [out-text [#
B
#]]
 ]

 # §3.1: merging zero catalogs returns [catalog default="en"]. A catalog with
 # no entries has no keys, so catalog-keys (§3.1) returns the empty sequence ().
 [case id=i18n-007-catalog-merge-zero level=core
  [tags i18n catalog-merge zero edge]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-keys [$i18n:catalog-merge]]
#]]
  [out-text [#
()
#]]
 ]

 [case id=i18n-008-catalog-merge-not-a-catalog level=core
  [tags i18n catalog-merge not-a-catalog CXER3805]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-merge [$i18n:catalog-from-map {"k": {"en": "A"}}] "not-a-catalog"]
#]]
  [out-err [#
cx-err:CXER3805
#]]
 ]

 # ── §3.1 catalog-merge-seq (programmatic companion, matches merge §6) ───
 [case id=i18n-009-catalog-merge-seq-last-writer level=core
  [tags i18n catalog-merge-seq sequence]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:message [$i18n:catalog-merge-seq ([$i18n:catalog-from-map {"k": {"en": "A"}}], [$i18n:catalog-from-map {"k": {"en": "B"}}])] "k" "en" {}]
#]]
  [out-text [#
B
#]]
 ]

 # ── §3.1 catalog-locales ────────────────────────────────────────────────
 [case id=i18n-010-catalog-locales-multi level=core
  [tags i18n catalog-locales]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-locales [$i18n:catalog-from-map {"k": {"en": "A", "ru": "B"}}]]
#]]
  [out-text [#
(en, ru)
#]]
 ]

 [case id=i18n-011-catalog-locales-not-a-catalog level=core
  [tags i18n catalog-locales not-a-catalog CXER3805]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-locales "nope"]
#]]
  [out-err [#
cx-err:CXER3805
#]]
 ]

 # ── §3.1 catalog-keys ───────────────────────────────────────────────────
 [case id=i18n-012-catalog-keys-not-a-catalog level=core
  [tags i18n catalog-keys not-a-catalog CXER3805]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/i18n']
[$i18n:catalog-keys "nope"]
