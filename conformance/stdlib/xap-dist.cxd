                      [?attr "name" "toylib"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports" [?element "def" [?attr "name" "toylib/id"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
