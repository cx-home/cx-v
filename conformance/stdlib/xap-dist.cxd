  [case id=xap-dist-042-bundle-catalog-object-and-reference-entitlement level=core
   [tags xap-dist market bundle catalog entitlement]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $bh [$store:put-doc $s [bundle name=marine-suite version=1 [member package=nmea0183 versions='0.x']]]]
 [= $al [$store:set-alias $s "marine-suite@1" $bh]]
 [= $c [$xap:pkg-catalog $s]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $vc [$xap:license-issue $pub $kp@private "principal:alice" {bundle: "marine-suite" bundle-version: "1"}]]
 [= $v [$xap:license-verify $vc "nmea0183" "0.1.0" {now: "2026-07-06T00:00:00Z" store: $s}]]
 [= $be $c//bundle]
 ($be@name, $be@version, $v@status)]
#]]
   [out-text [#
('marine-suite', '1', 'ok')
#]]
  ]

  [case id=xap-dist-043-bundle-reference-is-version-bound level=core
   [tags xap-dist market bundle entitlement fail-closed]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $b1 [$store:put-doc $s [bundle name=marine-suite version=1 [member package=nmea0183 versions='0.x']]]]
 [= $a1 [$store:set-alias $s "marine-suite@1" $b1]]
 [= $b2 [$store:put-doc $s [bundle name=marine-suite version=2 [member package=nmea0183 versions='0.x'] [member package=radar-overlay versions='*']]]]
 [= $a2 [$store:set-alias $s "marine-suite@2" $b2]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $vc [$xap:license-issue $pub $kp@private "principal:alice" {bundle: "marine-suite" bundle-version: "1"}]]
 [$xap:license-verify $vc "radar-overlay" "1.0.0" {now: "2026-07-06T00:00:00Z" store: $s}]]
#]]
   [out-err [#
cx-err:CXER4883
#]]
  ]

  [case id=xap-dist-044-markets-federate-as-data level=core
   [tags xap-dist market federation discovery]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $m1 [$store:open "mem://"]]
 [= $m2 [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $ta [$xap:pkg-tree ([entry path='a.cx' '[?def alpha scope=public pure ($x) $x]'])]]
 [= $tb [$xap:pkg-tree ([entry path='b.cx' '[?def beta scope=public pure ($x) $x]'])]]
 [= $da [?element "package" [?attr "name" "liba"] [?attr "version" "1.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "liba/alpha"]]]]]
 [= $db [?element "package" [?attr "name" "libb"] [?attr "version" "1.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "libb/beta"]]]]]
 [= $sa [$xap:pkg-seal $m1 $ta $da]]
 [= $sb [$xap:pkg-seal $m2 $tb $db]]
 [= $ma [$store:put-doc $m1 [$xap:pkg-sign [$store:get-doc $m1 $sa@manifest] $kp@private]]]
 [= $mb [$store:put-doc $m2 [$xap:pkg-sign [$store:get-doc $m2 $sb@manifest] $kp@private]]]
 [= $pa [$xap:pkg-publish $m1 "liba" "1.0.0" $ma]]
 [= $pb [$xap:pkg-publish $m2 "libb" "1.0.0" $mb]]
 [= $c1 [$xap:pkg-catalog $m1]]
 [= $c2 [$xap:pkg-catalog $m2]]
 [= $blend [?element "federated-catalog" [?splice $c1/*] [?splice $c2/*]]]
 [= $i1 [$xap:pkg-install [xap name=one-surface] $m1 "liba@1.0.0"]]
 [= $i2 [$xap:pkg-install $i1 $m2 "libb@1.0.0"]]
 ([$count $blend/package], [$count $i2/xap/libraries/library])]
#]]
   [out-text [#
(2, 2)
#]]
  ]

  [; §6.1 pkg-install enable: installing a package the deployment doc ALREADY
     names (a stage-0 path-ref row) UPDATES that row in place — one row per
     name, its unrecognized attrs (package=, status=) preserved, the pin
     attrs (version/manifest/hash) and the resolved requires closure written
     onto it. Appending a second same-name row would leave the doc ill-formed
     (two rows claiming one feature). Found converting xap-marine stage 0 → 1. ]
  [case id=xap-dist-045-install-merges-existing-feature-row level=core
   [tags xap-dist pkg-install enable lockfile stage-1]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec], [?element "entry" [?attr "path" "assets/door.md"] "x"])]]
 [= $draft [?element "package"
                       [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "door" "1.0.0" $mh]]
 [= $inst [$xap:pkg-install [xap name=demo [features [feature name=door package='./features/door' status=ready]]] $s "door@1.0.0"]]
 [= $rows [?for [in $f $inst/xap/features/feature] [yield $f]]]
 [= $row [$first $rows]]
 ([$count $rows],
  [$concat "" $row@package],
  [$concat "" $row@status],
  [= [$concat "" $row@hash] [$concat "" $sealed@hash]])]
#]]
   [out-text [#
(1, './features/door', 'ready', true)
#]]
  ]

  [; §1.2 runtime contract, lane 1 (§11.16): a feature tree carrying its
     <name>.cx code entry whose manifest declares NO [exports] fails the
     install gate — behavior must be declared to be consented to. ]
  [case id=xap-dist-046-contract-code-without-exports-rejected level=core
   [tags xap-dist pkg-install runtime-contract exports gate]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $code "[?def open-door scope=public ($x) $x]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec], [?element "entry" [?attr "path" "door.cx"] $code])]]
 [= $draft [?element "package"
                        [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "door" "1.0.0" $mh]]
 [$xap:pkg-install [xap name=demo] $s "door@1.0.0"]]
#]]
   [out-err [#
cx-err:CXER4884
#]]
  ]

  [; §1.2 runtime contract, lane 2 (§11.16): [exports] declared but the tree
     carries no <name>.cx — a listing with nothing behind it fails the gate. ]
  [case id=xap-dist-047-contract-exports-without-code-rejected level=core
   [tags xap-dist pkg-install runtime-contract exports gate]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec])]]
 [= $draft [?element "package"
                       [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports" [?element "def" [?attr "name" "door/open-door"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "door" "1.0.0" $mh]]
 [$xap:pkg-install [xap name=demo] $s "door@1.0.0"]]
#]]
   [out-err [#
cx-err:CXER4884
#]]
  ]

  [; §1.2 runtime contract, positive lane (§11.16): code entry + matching
     [exports] installs; the spec-only feature (no code, no exports) installs
     unchanged — both halves of the two-way rule. ]
  [case id=xap-dist-048-contract-declared-surface-installs level=core
   [tags xap-dist pkg-install runtime-contract exports gate]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $code "[?def readout scope=public ($store $t) [?element 'readout']]
[?def apply scope=public ($verb $intent $store) $verb]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec], [?element "entry" [?attr "path" "door.cx"] $code])]]
 [= $draft [?element "package"
                        [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports"
                          [?element "def" [?attr "name" "door/readout"]]
                    [?element "def" [?attr "name" "door/apply"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "door" "1.0.0" $mh]]
 [= $inst [$xap:pkg-install [xap name=demo] $s "door@1.0.0"]]
 ($inst@name, $inst@kind)]
#]]
   [out-text [#
('door', 'feature')
#]]
  ]

  [; §1.2 runtime contract, absent-def lane (§11.16): the manifest exports a
     def the packaged code does not define — rejected naming the def. ]
  [case id=xap-dist-049-contract-exported-def-absent-rejected level=core
   [tags xap-dist pkg-install runtime-contract exports gate]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $code "[?def readout scope=public ($store $t) [?element 'readout']]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec], [?element "entry" [?attr "path" "door.cx"] $code])]]
 [= $draft [?element "package"
                        [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports"
                          [?element "def" [?attr "name" "door/readout"]]
                    [?element "def" [?attr "name" "door/apply"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "door" "1.0.0" $mh]]
 [$xap:pkg-install [xap name=demo] $s "door@1.0.0"]]
#]]
   [out-err [#
cx-err:CXER4884
#]]
  ]

  [case id=xap-dist-050-license-verifies-after-emit-parse-roundtrip level=core
   [tags xap-dist license entitlement offline air-gap roundtrip]
   [; §5.1: "VCs verify offline by construction" — an entitlement VC written
      to a registry file and re-parsed by the consumer MUST verify exactly as
      the in-memory original does (the air-gapped fleet imports packages + VCs
      through its own registry). Guards the text-extraction/canonical-form
      path against constructed-vs-parsed node-type drift. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $vc [$xap:license-issue $pub $kp@private "principal:alice" {package: "nmea0183" versions: "1.x" kind: "perpetual"}]]
 [= $rt [$cx-parse [$cx:emit $vc]]]
 [= $vc2 [$first [?for [in $x ($rt)] [yield $x]]]]
 [= $v1 [$xap:license-verify $vc "nmea0183" "1.4.2" {now: "2026-07-06T00:00:00Z"}]]
 [= $v2 [$xap:license-verify $vc2 "nmea0183" "1.4.2" {now: "2026-07-06T00:00:00Z"}]]
 ([$concat "" $v1@status], [$concat "" $v2@status])]
#]]
   [out-text [#
('ok', 'ok')
#]]
  ]
]
