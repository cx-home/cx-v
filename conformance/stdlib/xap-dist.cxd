  [case id=xap-dist-018-install-feature-consent-is-exactly-needs level=core
   [tags xap-dist pkg-install feature consent grants]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec], [?element "entry" [?attr "path" "assets/door.md"] "x"])]]
 [= $draft [?element "package"
                       [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "needs"
                         [?element "reads" [?attr "noun" "traffic/vessel"]]
                    [?element "gateways" [?attr "kind" "nmea-serial"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "door" "1.0.0" $mh]]
 [= $rt [$xap:run {tenant: "demo"}]]
 [?let [= $inst [$xap:pkg-install [xap name=demo] $s "door@1.0.0" {runtime: $rt grantee: "agent:porter-1"}]]
  $inst/granted]]
#]]
   [out-text [#
[granted [grant capability='traffic/vessel'] [grant capability=nmea-serial]]
#]]
  ]

  [case id=xap-dist-019-install-feature-compose-conflict-rejected level=core
   [tags xap-dist pkg-install feature compose-gate w1 fail-closed]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec1 "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $spec2 "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int] [field name=alarm type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $t1 [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec1], [?element "entry" [?attr "path" "assets/door.md"] "x"])]]
 [= $t2 [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec2], [?element "entry" [?attr "path" "assets/door.md"] "y"])]]
 [= $draft [?element "package"
                         [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"]
                  [?element "publisher" [?attr "did" $pub]]]]
 [= $draft2 [?element "package"
                           [?attr "name" "door"] [?attr "version" "2.0.0"] [?attr "kind" "feature"]
                   [?element "publisher" [?attr "did" $pub]]]]
 [= $s1 [$xap:pkg-seal $s $t1 $draft]]
 [= $s2 [$xap:pkg-seal $s $t2 $draft2]]
 [= $m1 [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $s1@manifest] $kp@private]]]
 [= $m2 [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $s2@manifest] $kp@private]]]
 [= $i1 [$xap:pkg-install [xap name=demo] $s $m1]]
 [$xap:pkg-install $i1 $s $m2]]
#]]
   [out-err [#
cx-err:CXER4884
#]]
  ]

  [case id=xap-dist-020-pin-rollback-hash-identity level=core
   [tags xap-dist pkg-install pin rollback]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $spec1 "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]]
 [requirements [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]]]"]
 [= $spec2 "[feature name=door
 [nouns [noun name=door singular=true [field name=locked type=int]]]
 [verbs
  [verb name=unlock effect=act scope=shared consequence=irreversible [intent [do :unlock]] [writes door]]
  [verb name=chime effect=observe [intent [do :chime]] [reads door]]]
 [requirements
  [requirement kind=functional as=resident traces=unlock [want 'to unlock the door'] [so 'guests can enter']]
  [requirement kind=functional as=resident traces=chime [want 'to sound the chime'] [so 'arrival is announced']]]]"]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $t1 [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec1], [?element "entry" [?attr "path" "assets/door.md"] "x"])]]
 [= $t2 [$xap:pkg-tree ([?element "entry" [?attr "path" "door.feature.cxd"] $spec2], [?element "entry" [?attr "path" "assets/door.md"] "x"])]]
 [= $d1 [?element "package" [?attr "name" "door"] [?attr "version" "1.0.0"] [?attr "kind" "feature"] [?element "publisher" [?attr "did" $pub]]]]
 [= $d2 [?element "package" [?attr "name" "door"] [?attr "version" "2.0.0"] [?attr "kind" "feature"] [?element "publisher" [?attr "did" $pub]]]]
 [= $s1 [$xap:pkg-seal $s $t1 $d1]]
 [= $s2 [$xap:pkg-seal $s $t2 $d2]]
 [= $m1 [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $s1@manifest] $kp@private]]]
 [= $m2 [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $s2@manifest] $kp@private]]]
 [= $i1 [$xap:pkg-install [xap name=demo] $s $m1]]
 [= $i2 [$xap:pkg-install [xap name=demo2] $s $m2]]
 [= $i3 [$xap:pkg-install [xap name=demo3] $s $m1]]
 ([= $i1@hash $i3@hash], [= $i1@hash $i2@hash])]
#]]
   [out-text [#
(true, false)
#]]
  ]

  [case id=xap-dist-021-requires-closure-transitive level=core
   [tags xap-dist pkg-requires-closure code-plane]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tc [$xap:pkg-tree ([entry path='c.cx' 'c'])]]
 [= $dc [?element "package" [?attr "name" "libc"] [?attr "version" "1.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "libc/c"]]]]]
 [= $sc [$xap:pkg-seal $s $tc $dc]]
 [= $mc [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $sc@manifest] $kp@private]]]
 [= $pc [$xap:pkg-publish $s "libc" "1.0.0" $mc]]
 [= $tb [$xap:pkg-tree ([entry path='b.cx' 'b'])]]
 [= $db [?element "package" [?attr "name" "libb"] [?attr "version" "1.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "libb/b"]]]
               [?element "requires" [?element "require" [?attr "library" "libc"]]]]]
 [= $sb [$xap:pkg-seal $s $tb $db]]
 [= $mb [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $sb@manifest] $kp@private]]]
 [= $pb [$xap:pkg-publish $s "libb" "1.0.0" $mb]]
 [= $da [?element "package" [?attr "name" "liba"] [?attr "version" "1.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "liba/a"]]]
               [?element "requires" [?element "require" [?attr "library" "libb"]]]]]
 [= $ta [$xap:pkg-tree ([entry path='a.cx' 'a'])]]
 [= $sa [$xap:pkg-seal $s $ta $da]]
 [= $ma [$store:get-doc $s $sa@manifest]]
 [= $c [$xap:pkg-requires-closure $s $ma]]
 [$count $c/pin]]
#]]
   [out-text [#
2
#]]
  ]

