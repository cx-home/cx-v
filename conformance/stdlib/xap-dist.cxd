[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?let [= $s [$store:open "mem://"]]
 [$xap:pkg-fetch $s "nope@9.9.9"]]
#]]
   [out-err [#
cx-err:CXER4886
#]]
  ]

  [case id=xap-dist-014-publish-released-alias-immutable level=core
   [tags xap-dist pkg-publish immutability fail-closed]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([entry path='lib.cx' 'one'])]]
 [= $tree2 [$xap:pkg-tree ([entry path='lib.cx' 'two'])]]
 [= $draft [?element "package"
                       [?attr "name" "toylib"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports" [?element "def" [?attr "name" "toylib/id"]]]]]
 [= $s1 [$xap:pkg-seal $s $tree $draft]]
 [= $s2 [$xap:pkg-seal $s $tree2 $draft]]
 [= $m1 [$xap:pkg-sign [$store:get-doc $s $s1@manifest] $kp@private]]
 [= $m2 [$xap:pkg-sign [$store:get-doc $s $s2@manifest] $kp@private]]
 [= $mh1 [$store:put-doc $s $m1]]
 [= $mh2 [$store:put-doc $s $m2]]
 [= $p1 [$xap:pkg-publish $s "toylib" "0.1.0" $mh1]]
 [$xap:pkg-publish $s "toylib" "0.1.0" $mh2]]
#]]
   [out-err [#
cx-err:CXER4887
#]]
  ]

  [case id=xap-dist-015-publish-unsigned-rejected level=core
   [tags xap-dist pkg-publish signature fail-closed]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([entry path='lib.cx' 'code'])]]
 [= $draft [?element "package"
                      [?attr "name" "toylib"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports" [?element "def" [?attr "name" "toylib/id"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [$xap:pkg-publish $s "toylib" "0.1.0" $sealed@manifest]]
#]]
   [out-err [#
cx-err:CXER4880
#]]
  ]

  [case id=xap-dist-016-install-nmea-library-dogfood level=core
   [tags xap-dist pkg-install library nmea0183 dogfood n-dist-2]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?lib 'cx-stdlib/io' :as io]
[?let [= $src [$io:read-file "packages/nmea0183/nmea0183.cx"]]
 [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([?element "entry" [?attr "path" "nmea0183.cx"] $src])]]
 [= $draft [?element "package"
                       [?attr "name" "nmea0183"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports"
                         [?element "def" [?attr "name" "nmea0183/checksum"]]
                    [?element "def" [?attr "name" "nmea0183/parse"]]
                    [?element "def" [?attr "name" "nmea0183/render"]]
                    [?element "def" [?attr "name" "nmea0183/valid"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "nmea0183" "0.1.0" $mh]]
 [= $rt [$xap:run {tenant: "demo"}]]
 [= $inst [$xap:pkg-install [xap name=demo] $s "nmea0183@0.1.0" {runtime: $rt grantee: "agent:helper-1"}]]
 ($inst@name, $inst@kind, [$count $inst/granted/grant])]
#]]
   [out-text [#
('nmea0183', 'library', 0)
#]]
  ]

