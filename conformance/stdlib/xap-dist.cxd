  [case id=xap-dist-039-market-grammar-composes level=core
   [tags xap-dist market compose dogfood]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/io' :as io]
[?let [= $catd [$cx-parse [$io:read-file "market/catalog.feature.cxd"]]]
 [= $entd [$cx-parse [$io:read-file "market/entitlement.feature.cxd"]]]
 [= $comd [$cx-parse [$io:read-file "market/commerce.feature.cxd"]]]
 [= $cat $catd//feature]
 [= $ent $entd//feature]
 [= $com $comd//feature]
 [= $g [$xap:compose $cat $ent $com]]
 ([$count $g//verb], $g//verb[= $_@name 'commerce/fulfil']/@derived)]
#]]
   [out-text [#
(10, [derived true])
#]]
  ]

  [case id=xap-dist-040-market-choreography-journaled level=core
   [tags xap-dist market commerce choreography n-compose-2]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/io' :as io]
[?let [= $catd [$cx-parse [$io:read-file "market/catalog.feature.cxd"]]]
 [= $entd [$cx-parse [$io:read-file "market/entitlement.feature.cxd"]]]
 [= $comd [$cx-parse [$io:read-file "market/commerce.feature.cxd"]]]
 [= $cat $catd//feature]
 [= $ent $entd//feature]
 [= $com $comd//feature]
 [= $g [$xap:compose $cat $ent $com]]
 [= $rt [$xap:run {tenant: "market" grammar: $g}]]
 [= $d [$xap:dial $rt [from id="principal:dana"] [to id="agent:stripe-gw"] [scope 'commerce/record-settlement']]]
 [= $e1 [$xap:emit $rt [do :place-order] {actor: "principal:dana"}]]
 [= $e2 [$xap:emit $rt [do :record-settlement] {actor: "agent:stripe-gw"}]]
 [= $e3 [$xap:emit $rt [do :fulfil] {actor: "principal:dana"}]]
 ($e1, $e2, $e3)]
#]]
   [out-text [#
([event actor=principal:dana [do 'commerce/place-order']], [event actor=agent:stripe-gw [do 'commerce/record-settlement']], [event actor=principal:dana [do 'commerce/fulfil']])
#]]
  ]

