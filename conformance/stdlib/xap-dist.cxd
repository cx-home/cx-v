   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $ta [$xap:pkg-tree ([entry path='a.cx' '[?def alpha scope=public pure ($x) $x]'])]]
 [= $tb [$xap:pkg-tree ([entry path='b.cx' '[?def beta scope=public pure ($x) $x]'])]]
 [= $da [?element "package" [?attr "name" "liba"] [?attr "version" "1.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "liba/alpha"]]]]]
 [= $db [?element "package" [?attr "name" "libb"] [?attr "version" "2.0.0"] [?attr "kind" "library"]
               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "libb/beta"]]]]]
 [= $sa [$xap:pkg-seal $s $ta $da]]
 [= $sb [$xap:pkg-seal $s $tb $db]]
 [= $ma [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $sa@manifest] $kp@private]]]
 [= $mb [$store:put-doc $s [$xap:pkg-sign [$store:get-doc $s $sb@manifest] $kp@private]]]
 [= $pa [$xap:pkg-publish $s "liba" "1.0.0" $ma]]
 [= $pb [$xap:pkg-publish $s "libb" "2.0.0" $mb]]
 [= $c [$xap:pkg-catalog $s]]
 [= $names [?for [in $p $c/*] [yield $p/@name]]]
 ([$count $c/package], $names)]
#]]
   [; #438: a multi-item comprehension result inside a sequence renders as
      its paren sequence form — the pre-fix expectation carried a raw
      newline mid-sequence, which is not parseable CX. ]
   [out-text [#
(2, ('liba', 'libb'))
#]]
