               [?element "publisher" [?attr "did" $pub]]
               [?element "exports" [?element "def" [?attr "name" "libb/beta"]]]]]
 [= $sa [$xap:pkg-seal $s $ta $da]]
 [= $sb [$xap:pkg-seal $s $tb $db]]
