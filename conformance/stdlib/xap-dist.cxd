  [case id=xap-dist-010-verify-absent-content-rejected level=core
   [tags xap-dist pkg-verify content fail-closed]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $m [?element "package"
                 [?attr "name" "ghost"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
              [?attr "hash" "deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"]
              [?element "publisher" [?attr "did" $pub]]
              [?element "exports" [?element "def" [?attr "name" "ghost/id"]]]]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [$xap:pkg-verify $s $mh]]
#]]
   [out-err [#
cx-err:CXER4886
#]]
  ]

  [case id=xap-dist-011-verify-bad-attestation-rejected level=core
   [tags xap-dist pkg-verify vc fail-closed]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([entry path='lib.cx' 'code'])]]
 [= $draft [?element "package"
                      [?attr "name" "toylib"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports" [?element "def" [?attr "name" "toylib/id"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [$xap:pkg-verify $s $mh {attestations: ([not-a-vc bogus=true]) now: 2026-07-06T00:00:00Z}]]
#]]
   [out-err [#
cx-err:CXER4883
#]]
  ]

  [case id=xap-dist-012-publish-fetch-roundtrip level=core
   [tags xap-dist pkg-publish pkg-fetch alias]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-xap' :as xap]
[?lib 'cx-stdlib/store' :as store]
[?lib 'cx-stdlib/crypto' :as crypto]
[?lib 'cx-stdlib/did' :as did]
[?let [= $s [$store:open "mem://"]]
 [= $kp [$crypto:ed25519-keypair]]
 [= $pub [$did:key-create $kp@public]]
 [= $tree [$xap:pkg-tree ([entry path='lib.cx' 'code'])]]
 [= $draft [?element "package"
                      [?attr "name" "toylib"] [?attr "version" "0.1.0"] [?attr "kind" "library"]
                  [?element "publisher" [?attr "did" $pub]]
                  [?element "exports" [?element "def" [?attr "name" "toylib/id"]]]]]
 [= $sealed [$xap:pkg-seal $s $tree $draft]]
 [= $m [$store:get-doc $s $sealed@manifest]]
 [= $signed [$xap:pkg-sign $m $kp@private]]
 [= $mh [$store:put-doc $s $signed]]
 [= $p [$xap:pkg-publish $s "toylib" "0.1.0" $mh]]
 [= $f [$xap:pkg-fetch $s "toylib@0.1.0"]]
 ($p@alias, $f@name, $f@version)]
#]]
   [out-text [#
('toylib@0.1.0', 'toylib', '0.1.0')
#]]
  ]

