[test-suite name=supervise ring=1
  [doc [#
conformance fixtures for cx-stdlib/supervise
(spec/03-approved/std-lib/supervise.md §10; issue #765; RULED: SUP-1).
Each program imports the bundled module via
[?lib 'cx-stdlib/supervise' :as sup]. The LAST expression is the
rendered result.

   supervise runs named children (arity-0 callables spawned as workers)
   under a policy (strategy × intensity × backoff) and restarts them per
   child restart type. It composes [?worker]/[?monitor], fan-out
   channels (U1.11a), and cx-stdlib/sched timers — no new primitive, no
   capability (§5).

   DETERMINISM. Backoff delays, the intensity window, and attempt-reset
   ride sched's :manual clock — they fire only under
   [$sched:test-clock-advance], deterministically. Loop handshakes ride
   real worker threads, so fixtures synchronize on the EVENT stream
   (exact-count batched receives with generous deadlines — each batch
   returns the moment its count is met; the deadline is a liveness
   bound, never a sleep). Negative-space assertions ("no restart before
   the clock advances") use a short-deadline empty batch: nothing can
   arrive without a tick, so the empty result is deterministic.

   FOUR-CHANNEL MODEL: handle/status/events are present VALUES;
   CXER5090 malformed policy/spec and CXER5091 duplicate child are
   faults; stop-of-stopped is null and stop-child-of-unknown is false
   (VALUES); start-child/stop-child/events on a stopped supervisor are
   CXER5093 (status stays readable); the give-up terminal is CXER5094
   on the loop worker, observed by a parent monitor as
   [panicked … [err CXER0220 [cause [err CXER5094]]]] (SUP-1g).

   NOT HERE, by recorded rider (ledger/rulings_2026_08_20_supervise.md):
   - the wedged-child abandon arm rides the V lane
     (vcx/tests/stdlib_supervise_test.v) — on this substrate [?cancel]
     stamps the terminal at request (SUP-1f), so .cxd cannot observe a
     shutdown-window expiry;
   - the events-laggard CXER0218 arm is the standard channel STREAM_GAP
     contract, pinned by the core channel lane (SUP-1b) — supervise adds
     no gap logic.

   Id ranges:
     001-005  restart types × outcomes (permanent/transient/temporary)
     006-007  exp backoff + attempt reset (mock clock)
     008-010  strategies + intensity-counts-decisions
     011-012  give-up + tree escalation
     013-017  stop / with-open / dynamic children / status
     018-024  negatives (CXER5090/5091/5093) + status-after-stop
     025-030  the module fn-doc examples, verbatim (guide-check backing)
  #]]

  [# ── 001-005: restart types × outcomes ─────────────────────────── #]

  [case id=sup-001-permanent-panic-restart-sequence level=concurrency packs=sched
   [tags supervise restart permanent panicked events 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s001" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="a" [fn [?fn () [?let [= $m [?receive from=$c]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k [?send [die] to=$c]]
[= $e1 [?receive from=$ev max=3 deadline=8000]]
[= $_ [$sup:stop $s]]
($e0, $e1)]
#]]
   [out-text [#
(([child-started name=a attempt=0]), ([child-exited name=a reason=:panicked err-code=cx-err:CXER0100], [child-restarted name=a attempt=1 delay-ms=0], [child-started name=a attempt=1]))
#]]
  ]

  [case id=sup-002-permanent-restarts-on-done level=concurrency packs=sched
   [tags supervise restart permanent done events 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s002" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="a" [fn [?fn () [?receive from=$c]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k [?send [go] to=$c]]
[= $e1 [?receive from=$ev max=3 deadline=8000]]
[= $_ [$sup:stop $s]]
$e1]
#]]
   [out-text [#
([child-exited name=a reason=:done], [child-restarted name=a attempt=1 delay-ms=0], [child-started name=a attempt=1])
#]]
  ]

  [case id=sup-003-transient-restarts-on-panic level=concurrency packs=sched
   [tags supervise restart transient panicked 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s003" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="t" restart=:transient
           [fn [?fn () [?let [= $m [?receive from=$c]]
                         [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k [?send [die] to=$c]]
[= $e1 [?receive from=$ev max=3 deadline=8000]]
[= $_ [$sup:stop $s]]
$e1]
#]]
   [out-text [#
([child-exited name=t reason=:panicked err-code=cx-err:CXER0100], [child-restarted name=t attempt=1 delay-ms=0], [child-started name=t attempt=1])
#]]
  ]

  [case id=sup-004-transient-not-restarted-on-done level=concurrency packs=sched
   [tags supervise restart transient done negative-space status 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s004" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="t" restart=:transient [fn [?fn () [?receive from=$c]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k [?send [go] to=$c]]
[= $e1 [?receive from=$ev max=1 deadline=8000]]
[= $none [?receive from=$ev max=1 deadline=300]]
[= $st [$sup:status $s]]
[= $_ [$sup:stop $s]]
($e1, [$count $none], $st)]
#]]
   [out-text [#
(([child-exited name=t reason=:done]), 0, [supervisor-status restarts-in-window=0 [child name=t state=stopped attempts=0]])
#]]
  ]

  [case id=sup-005-temporary-never-restarted level=concurrency packs=sched
   [tags supervise restart temporary panicked negative-space 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s005" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="p" restart=:temporary
           [fn [?fn () [?let [= $m [?receive from=$c]]
                         [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k [?send [die] to=$c]]
[= $e1 [?receive from=$ev max=1 deadline=8000]]
[= $none [?receive from=$ev max=1 deadline=300]]
[= $_ [$sup:stop $s]]
($e1, [$count $none])]
#]]
   [out-text [#
(([child-exited name=p reason=:panicked err-code=cx-err:CXER0100]), 0)
#]]
  ]

  [# ── 006-007: exp backoff + attempt reset (mock clock) ─────────── #]

  [case id=sup-006-exp-backoff-100-200-mock-clock level=concurrency packs=sched
   [tags supervise backoff exp sched mock-clock negative-space 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $c [?channel name="s006" buffer=8]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=10 window=1m
                    backoff=:exp base=100ms cap=10s]
        ([child name="a" [fn [?fn () [?let [= $m [?receive from=$c]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k1 [?send [die] to=$c]]
[= $e1 [?receive from=$ev max=1 deadline=8000]]
[; the status round-trip is the ARM BARRIER: ops queue behind the
   child's terminal note in the one inbox, so the reply proves the
   backoff timer is armed before the clock advances ]
[= $_b1 [$sup:status $s]]
[= $none1 [?receive from=$ev max=1 deadline=300]]
[= $d100 [$time:duration-ms 100]]
[= $_a1 [$sched:test-clock-advance $d100]]
[= $e2 [?receive from=$ev max=2 deadline=8000]]
[= $_k2 [?send [die] to=$c]]
[= $e3 [?receive from=$ev max=1 deadline=8000]]
[= $_b2 [$sup:status $s]]
[= $_a2 [$sched:test-clock-advance $d100]]
[= $none2 [?receive from=$ev max=1 deadline=300]]
[= $_a3 [$sched:test-clock-advance $d100]]
[= $e4 [?receive from=$ev max=2 deadline=8000]]
[= $_ [$sup:stop $s]]
([nowait1 [$count $none1]], $e2, [nowait2 [$count $none2]], $e4)]
#]]
   [out-text [#
([nowait1 0], ([child-restarted name=a attempt=1 delay-ms=100], [child-started name=a attempt=1]), [nowait2 0], ([child-restarted name=a attempt=2 delay-ms=200], [child-started name=a attempt=2]))
#]]
  ]

  [case id=sup-007-attempt-reset-after-healthy-window level=concurrency packs=sched
   [tags supervise backoff window attempt-reset intensity sched mock-clock 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $c [?channel name="s007" buffer=8]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=10 window=5s
                    backoff=:exp base=100ms cap=10s]
        ([child name="a" [fn [?fn () [?let [= $m [?receive from=$c]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $_k1 [?send [die] to=$c]]
[= $e1 [?receive from=$ev max=1 deadline=8000]]
[= $_b1 [$sup:status $s]]
[= $d100 [$time:duration-ms 100]]
[= $_a1 [$sched:test-clock-advance $d100]]
[= $e2 [?receive from=$ev max=2 deadline=8000]]
[= $stA [$sup:status $s]]
[= $d6s [$time:duration-s 6]]
[= $_a2 [$sched:test-clock-advance $d6s]]
[= $stB [$sup:status $s]]
[= $_k2 [?send [die] to=$c]]
[= $e3 [?receive from=$ev max=1 deadline=8000]]
[= $_b2 [$sup:status $s]]
[= $_a3 [$sched:test-clock-advance $d100]]
[= $e4 [?receive from=$ev max=2 deadline=8000]]
[= $_ [$sup:stop $s]]
([in-window $stA@restarts-in-window], [expired $stB@restarts-in-window], $e4)]
#]]
   [out-text [#
([in-window 1], [expired 0], ([child-restarted name=a attempt=1 delay-ms=100], [child-started name=a attempt=1]))
#]]
  ]

  [# ── 008-010: strategies + intensity-counts-decisions ──────────── #]

  [case id=sup-008-one-for-all-cancel-reverse-restart-in-order level=concurrency packs=sched
   [tags supervise strategy one-for-all ordering events byte-pinned 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $ca [?channel name="s008a" buffer=4]]
[= $cb [?channel name="s008b" buffer=4]]
[= $cc [?channel name="s008c" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-all max-restarts=5]
        ([child name="a" [fn [?fn () [?receive from=$ca]]]],
         [child name="b" [fn [?fn () [?let [= $m [?receive from=$cb]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]],
         [child name="c" [fn [?fn () [?receive from=$cc]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=3 deadline=8000]]
[= $_k [?send [die] to=$cb]]
[= $e1 [?receive from=$ev max=9 deadline=8000]]
[= $_ [$sup:stop $s]]
$e1]
#]]
   [out-text [#
([child-exited name=b reason=:panicked err-code=cx-err:CXER0100], [child-exited name=c reason=:cancelled], [child-exited name=a reason=:cancelled], [child-restarted name=a attempt=1 delay-ms=0], [child-started name=a attempt=1], [child-restarted name=b attempt=1 delay-ms=0], [child-started name=b attempt=1], [child-restarted name=c attempt=1 delay-ms=0], [child-started name=c attempt=1])
#]]
  ]

  [case id=sup-009-rest-for-one-restarts-the-tail level=concurrency packs=sched
   [tags supervise strategy rest-for-one ordering events 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $ca [?channel name="s009a" buffer=4]]
[= $cb [?channel name="s009b" buffer=4]]
[= $cc [?channel name="s009c" buffer=4]]
[= $s [$sup:start [policy strategy=:rest-for-one max-restarts=5]
        ([child name="a" [fn [?fn () [?receive from=$ca]]]],
         [child name="b" [fn [?fn () [?let [= $m [?receive from=$cb]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]],
         [child name="c" [fn [?fn () [?receive from=$cc]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=3 deadline=8000]]
[= $_k [?send [die] to=$cb]]
[= $e1 [?receive from=$ev max=6 deadline=8000]]
[= $_ [$sup:stop $s]]
$e1]
#]]
   [out-text [#
([child-exited name=b reason=:panicked err-code=cx-err:CXER0100], [child-exited name=c reason=:cancelled], [child-restarted name=b attempt=1 delay-ms=0], [child-started name=b attempt=1], [child-restarted name=c attempt=1 delay-ms=0], [child-started name=c attempt=1])
#]]
  ]

  [case id=sup-010-intensity-counts-decisions-not-respawns level=concurrency packs=sched
   [tags supervise intensity one-for-all decisions status 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $ca [?channel name="s010a" buffer=4]]
[= $cb [?channel name="s010b" buffer=4]]
[= $cc [?channel name="s010c" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-all max-restarts=2]
        ([child name="a" [fn [?fn () [?receive from=$ca]]]],
         [child name="b" [fn [?fn () [?let [= $m [?receive from=$cb]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]],
         [child name="c" [fn [?fn () [?receive from=$cc]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=3 deadline=8000]]
[= $_k [?send [die] to=$cb]]
[= $e1 [?receive from=$ev max=9 deadline=8000]]
[= $st [$sup:status $s]]
[= $_ [$sup:stop $s]]
[decisions n=$st@restarts-in-window]]
#]]
   [out-text [#
[decisions n=1]
#]]
  ]

  [# ── 011-012: give-up + tree escalation ─────────────────────────── #]

  [case id=sup-011-give-up-emits-final-event-and-panics-CXER5094 level=concurrency packs=sched
   [tags supervise intensity give-up CXER5094 monitor escalation 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s011" buffer=8]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=1]
        ([child name="a" [fn [?fn () [?let [= $m [?receive from=$c]]
                                       [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $wh [?worker-handle name=$s@worker]]
[= $mon [?monitor $wh]]
[= $sp [?receive from=$mon]]
[= $_k1 [?send [die] to=$c]]
[= $e1 [?receive from=$ev max=3 deadline=8000]]
[= $_k2 [?send [die] to=$c]]
[= $e2 [?receive from=$ev max=2 deadline=8000]]
[= $term [?receive from=$mon max=1 deadline=8000]]
[= $t [$first $term]]
[= $causes $t/err/cause/*]
[= $cause [$first $causes]]
[= $code [?if [= [$count $term] 0] [then :no-terminal-within-deadline]
  [else [?if [= [$count $causes] 0] [then :terminal-without-cause] [else $cause@code]]]]]
($e2, [escalates code=$code])]
#]]
   [out-text [#
(([child-exited name=a reason=:panicked err-code=cx-err:CXER0100], [gave-up restarts=1 window-ms=5000]), [escalates code=cx-err:CXER5094])
#]]
  ]

  [case id=sup-012-tree-parent-restarts-collapsed-subtree level=concurrency packs=sched
   [tags supervise tree composition escalation CXER0220 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $cs [?channel name="s012" buffer=8]]
[= $subfn [?fn ()
    [?let [= $kids ([child name="leaf" [fn [?fn () [?let [= $m [?receive from=$cs]]
                                                     [err code=cx-err:CXER0100 message="synthetic child fault (opaque to supervise)"]]]]])]
      [= $s2 [$sup:start [policy strategy=:one-for-one max-restarts=1] $kids]]
      [= $wn [$concat "" $s2@worker]]
      [= $h [?worker-handle name=$wn]]
      [?wait-for worker=$h]]]]
[= $sP [$sup:start [policy strategy=:one-for-one max-restarts=3]
         ([child name="sub" [fn $subfn]])]]
[= $evP [$sup:events $sP]]
[= $e0 [?receive from=$evP max=1 deadline=8000]]
[= $_k1 [?send [die] to=$cs]]
[= $_k2 [?send [die] to=$cs]]
[= $e1 [?receive from=$evP max=3 deadline=12000]]
[= $st [$sup:status $sP]]
[= $r1 [$first $st/*]]
[= $_ [$sup:stop $sP]]
($e1, [subtree state=$r1@state])]
#]]
   [out-text [#
(([child-exited name=sub reason=:panicked err-code=cx-err:CXER0220], [child-restarted name=sub attempt=1 delay-ms=0], [child-started name=sub attempt=1]), [subtree state=running])
#]]
  ]

  [# ── 013-017: stop / with-open / dynamic children / status ─────── #]

  [case id=sup-013-stop-reverse-order-idempotent level=concurrency packs=sched
   [tags supervise stop ordering idempotent 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $ca [?channel name="s013a" buffer=4]]
[= $cb [?channel name="s013b" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="a" [fn [?fn () [?receive from=$ca]]]],
         [child name="b" [fn [?fn () [?receive from=$cb]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=2 deadline=8000]]
[= $r1 [$sup:stop $s]]
[= $e1 [?receive from=$ev max=2 deadline=8000]]
[= $r2 [$sup:stop $s]]
($e1, $r1, $r2)]
#]]
   [out-text [#
(([child-exited name=b reason=:cancelled], [child-exited name=a reason=:cancelled]), null, null)
#]]
  ]

  [case id=sup-014-with-open-auto-stop level=concurrency packs=sched
   [tags supervise with-open closeable on-close 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $c [?channel name="s014" buffer=4]]
[= $keep [?channel name="s014k" buffer=2]]
[= $r [?with-open [$sup:start [policy strategy=:one-for-one max-restarts=3]
                    ([child name="a" [fn [?fn () [?receive from=$c]]]])] $s
        [?let [= $ev [$sup:events $s]]
          [= $e0 [?receive from=$ev max=1 deadline=8000]]
          [= $wh [?worker-handle name=$s@worker]]
          [= $_h [?send [h $wh] to=$keep]]
          [opened events=[$count $e0]]]]]
[= $hh [?receive from=$keep max=1 deadline=8000]]
[= $h1 [$first $hh]]
[= $wh [$first $h1/*]]
[= $term [?wait-for worker=$wh]]
($r, $term)]
#]]
   [out-text [#
([opened events=1], [stopped])
#]]
  ]

  [case id=sup-015-start-child-joins-start-order-tail level=concurrency packs=sched
   [tags supervise start-child dynamic status ordering 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $ca [?channel name="s015a" buffer=4]]
[= $cb [?channel name="s015b" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="a" [fn [?fn () [?receive from=$ca]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=1 deadline=8000]]
[= $kid [child name="b" [fn [?fn () [?receive from=$cb]]]]]
[= $r [$sup:start-child $s $kid]]
[= $e1 [?receive from=$ev max=1 deadline=8000]]
[= $st [$sup:status $s]]
[= $_ [$sup:stop $s]]
($r, $e1, $st)]
#]]
   [out-text [#
([ok], ([child-started name=b attempt=0]), [supervisor-status restarts-in-window=0 [child name=a state=running attempts=0] [child name=b state=running attempts=0]])
#]]
  ]

  [case id=sup-016-stop-child-true-then-false level=concurrency packs=sched
   [tags supervise stop-child dynamic value-not-fault 765]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/supervise' :as sup]
[?let [= $ca [?channel name="s016a" buffer=4]]
[= $cb [?channel name="s016b" buffer=4]]
[= $s [$sup:start [policy strategy=:one-for-one max-restarts=3]
        ([child name="a" [fn [?fn () [?receive from=$ca]]]],
         [child name="b" [fn [?fn () [?receive from=$cb]]]])]]
[= $ev [$sup:events $s]]
[= $e0 [?receive from=$ev max=2 deadline=8000]]
[= $r1 [$sup:stop-child $s "b"]]
[= $e1 [?receive from=$ev max=1 deadline=8000]]
[= $r2 [$sup:stop-child $s "b"]]
[= $st [$sup:status $s]]
[= $_ [$sup:stop $s]]
($r1, $r2, $e1, $st)]
#]]
   [out-text [#
(true, false, ([child-exited name=b reason=:cancelled]), [supervisor-status restarts-in-window=0 [child name=a state=running attempts=0]])
#]]
  ]

  [case id=sup-017-status-snapshot-shape level=concurrency packs=sched
   [tags supervise status snapshot 765]
   [in-cx [# [empty] #]]
