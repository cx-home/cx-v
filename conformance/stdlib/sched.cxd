  [case id=sched-029-after-bad-ev-CXER4971 level=core
   [tags sched negative arg-invalid ev]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[$sched:after [$time:duration-m 10] 'not-callable']
#]]
   [out-err [#
cx-err:CXER4971
#]]
  ]

