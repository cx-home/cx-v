  [# ── 028-036: negatives ── #]

  [case id=sched-028-after-nonpositive-dur-CXER4971 level=core
   [tags sched negative arg-invalid duration]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=4]]
[$sched:after [$time:duration-m 0] $ch]]
#]]
   [out-err [#
cx-err:CXER4971
#]]
