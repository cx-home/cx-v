  [# ── 022-027: durable / restore (worker-recycle correctness) ── #]

  [case id=sched-022-durable-appends-intent level=core ring=2
   [tags sched durable journal append intent]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=4]]
[= $jr [$journal:open "mem://sched" "tenant"]]
[= $t [$sched:after [$time:duration-m 10] $ch {name: 'no-ack' durable: $jr}]]
[$journal:head $jr]]
#]]
   [out-text [#
[entry seq=1 tenant=tenant actor=sched authority='sched/durable' ts='1970-01-01T00:00:01Z' prev-hash='genesis:' payload=sha2-256:b232c7b1c7e0e9d35541ce19dd1e234da4073d0002041dfc04d11091054f6453 hash='sha2-256:830826380c4312500432e6332283fe83b2befc909f6209d6e189a2f7eb140314' [event [sched-intent [kind 'after'] [name 'no-ack'] [deadline 600000000000] [dur-ns 600000000000] [mode 'fixed-delay'] [on-missed 'skip'] [status 'pending']]]]
#]]
  ]

  [case id=sched-023-restore-rearms-bound level=core ring=2
   [tags sched restore rearmed registry worker-recycle]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=4]]
[= $jr [$journal:open "mem://sched" "tenant"]]
[= $t [$sched:after [$time:duration-m 10] $ch {name: 'win' durable: $jr}]]
[$sched:restore $jr {'win': $ch}]]
#]]
   [out-text [#
[restore-report rearmed=1 skipped=0 orphaned=0]
#]]
  ]

  [case id=sched-024-restore-rearmed-still-fires level=core
   [tags sched restore fires remaining-time]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=4]]
[= $jr [$journal:open "mem://sched" "tenant"]]
[= $t [$sched:after [$time:duration-m 10] $ch {name: 'win' durable: $jr}]]
[= $rep [$sched:restore $jr {'win': $ch}]]
[= $_ [$sched:test-clock-advance [$time:duration-m 10]]]
[?receive from=$ch]]
#]]
   [out-text [#
[tick timer=win]
#]]
  ]

  [case id=sched-025-restore-orphaned-surfaced level=core ring=2
   [tags sched restore orphaned finding not-dropped]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=4]]
[= $jr [$journal:open "mem://sched" "tenant"]]
[= $t [$sched:after [$time:duration-m 10] $ch {name: 'no-ack' durable: $jr}]]
[$sched:restore $jr {}]]
#]]
   [out-text [#
[restore-report rearmed=0 skipped=0 orphaned=1 [orphaned [orphan name=no-ack]]]
#]]
  ]

  [case id=sched-026-canceled-durable-not-rearmed level=core ring=2
   [tags sched durable cancel closed not-rearmed restore]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=4]]
[= $jr [$journal:open "mem://sched" "tenant"]]
[= $t [$sched:after [$time:duration-m 10] $ch {name: 'win' durable: $jr}]]
[= $c [$sched:cancel $t]]
[$sched:restore $jr {'win': $ch}]]
#]]
