#]]
  ]

  [# ── 017-021: on-missed catch-up (skip / coalesce / fire-all) ── #]

  [case id=sched-017-on-missed-skip-fires-once level=core
   [tags sched on-missed skip catch-up fixed-rate]
  [; #853 (§6.4.1 — construction is operand-consuming) — outcomes are collected in
     a paren SEQUENCE, not a labelling element. A computed [err] in element CHILD
     position propagates, so `[r1 $e]` would short-circuit the construction and
     destroy the evidence this case exists to show. Position carries what the
     labels carried; the full err VALUE stays asserted, so nothing is weakened. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=16]]
[= $t [$sched:every [$time:duration-m 1] $ch {mode: :fixed-rate on-missed: :skip}]]
[= $_ [$sched:test-clock-advance [$time:duration-m 5]]]
[= $a [?receive from=$ch]]
[= $b [?receive from=$ch]]
($a, $b)]
#]]
   [out-text [#
([tick timer=timer-1], [err code=cx-err:CXER0202 message='receive timed out'])
#]]
  ]

  [case id=sched-018-on-missed-coalesce-fires-once level=core
   [tags sched on-missed coalesce catch-up fixed-rate]
  [; #853 (§6.4.1 — construction is operand-consuming) — outcomes are collected in
     a paren SEQUENCE, not a labelling element. A computed [err] in element CHILD
     position propagates, so `[r1 $e]` would short-circuit the construction and
     destroy the evidence this case exists to show. Position carries what the
     labels carried; the full err VALUE stays asserted, so nothing is weakened. ]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=16]]
[= $t [$sched:every [$time:duration-m 1] $ch {mode: :fixed-rate on-missed: :coalesce}]]
[= $_ [$sched:test-clock-advance [$time:duration-m 5]]]
[= $a [?receive from=$ch]]
[= $b [?receive from=$ch]]
($a, $b)]
#]]
   [out-text [#
([tick timer=timer-1], [err code=cx-err:CXER0202 message='receive timed out'])
#]]
  ]

  [case id=sched-019-on-missed-fire-all-fires-each level=core
   [tags sched on-missed fire-all catch-up fixed-rate]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=16]]
[= $t [$sched:every [$time:duration-m 1] $ch {mode: :fixed-rate on-missed: :fire-all}]]
[= $_ [$sched:test-clock-advance [$time:duration-m 5]]]
[= $a [?receive from=$ch]]
[= $b [?receive from=$ch]]
[= $c [?receive from=$ch]]
[= $d [?receive from=$ch]]
[= $e [?receive from=$ch]]
[seq $a $b $c $d $e]]
#]]
   [out-text [#
[seq [tick timer=timer-1] [tick timer=timer-1] [tick timer=timer-1] [tick timer=timer-1] [tick timer=timer-1]]
#]]
  ]

  [case id=sched-020-recur-fire-all-catch-up level=core
   [tags sched recur on-missed fire-all single-advance]
   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=16]]
[= $r [$time:recurrence :daily '1970-01-01T00:00:00Z' 'UTC' {count: 5}]]
[= $t [$sched:recur $r $ch {on-missed: :fire-all}]]
[= $_ [$sched:test-clock-advance [$time:duration-d 30]]]
[= $a [?receive from=$ch]]
[= $b [?receive from=$ch]]
[= $c [?receive from=$ch]]
[= $d [?receive from=$ch]]
[= $e [?receive from=$ch]]
[seq [$sched:timer-state $t] $a $b $c $d $e]]
#]]
   [out-text [#
[seq 'fired' [tick timer=timer-1] [tick timer=timer-1] [tick timer=timer-1] [tick timer=timer-1] [tick timer=timer-1]]
#]]
  ]

  [case id=sched-021-recur-skip-catch-up-once level=core
   [tags sched recur on-missed skip single-advance once]
  [; #853 (§6.4.1 — construction is operand-consuming) — outcomes are collected in
