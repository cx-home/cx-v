   [in-cx [# [empty] #]]
   [in-code [#
[?lib 'cx-stdlib/sched']
[?lib 'cx-stdlib/time']
[?let [= $ch [?channel name="t" buffer=16]]
[= $r [$time:recurrence :daily '1970-01-01T00:00:00Z' 'UTC' {count: 5}]]
