#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit {b: 2, a: 1}]
#]]
  [out-text [#
'{"a":1,"b":2}'
#]]
 ]

 # emit on an atom: §4.6 enumerates atom/bytes/date/datetime (and other
 # non-JSON kinds) as non-JSON-emittable, so canonical emit raises
 # CXER3103 E_JSON_UNSUPPORTED_VALUE.
 [case id=json-024-emit-unsupported-value level=core
  [tags json emit unsupported-value error CXER3103]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit :foo]
#]]
  [out-err [#
cx-err:CXER3103
#]]
 ]

 # §2/§4.3 element round-trip via the lossless `named` encoding. §2 pins the
 # shape {"$tag","$attrs","$children"} mapping map -> JSON object (empty -> {})
 # and array -> JSON array (empty -> []); §3.2 makes canonical `emit` sort map
 # keys, fixing the order $attrs < $children < $tag. Fully spec-determined.
 [case id=json-025-emit-element-named-encoding level=core
  [tags json emit element named-encoding lossless]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit-with-opts [empty] {lossless: true}]
#]]
  [out-text [#
'{"$tag":"empty","$attrs":{},"$children":[]}'
#]]
 ]

 [case id=json-025a-emit-element-semantic-default level=core
  [tags json emit element semantic]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit [server [host x] [port 80]]]
#]]
  [out-text [#
'{"server":{"host":"x","port":80}}'
#]]
 ]

 [case id=json-025b-emit-parse-named-roundtrip level=core
  [tags json emit parse element lossless roundtrip]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse [$json:emit-with-opts [server [port 80]] {lossless: true}]]
#]]
  [out-text [#
[server [port 80]]
#]]
 ]

