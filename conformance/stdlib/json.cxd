[$json:emit-with-opts {a: 1} {indent: 2}]
#]]
  [out-text [#
'{\n  "a": 1\n}'
#]]
 ]

 [case id=json-029-emit-with-opts-sort-keys level=core
  [tags json emit-with-opts sort-keys]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit-with-opts {b: 2, a: 1} {sort-keys: true}]
#]]
