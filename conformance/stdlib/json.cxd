[test-suite name=json ring=1
  [doc [#
conformance fixtures for cx-stdlib/json (spec/std-lib/json.md §6).

   Each program imports the bundled module via [?lib 'cx-stdlib/json']
   (resolver MUST be quoted) then calls [$json:fn args]. The LAST expression
   is the rendered result.

   Rendering contract (code_eval_fixtures_test.v::render_value):
   - parse* return CXDM values: a JSON object -> CX map rendered {k: v};
     a JSON array -> CX array rendered [a, b, c]; scalars render bare
     (42, true, null, 3.14) or single-quoted for strings ('hi').
   - emit* return a STRING (JSON text). JSON uses double quotes and never
     single quotes, so the renderer single-quotes the whole result:
     emit({a: 1}) -> '{"a":1}'. Comparison is whitespace-normalised
     token-by-token, so pretty output compares by token sequence.
   - bytes-producing/consuming calls compose through cx-stdlib/bytes so the
     final result is a deterministic scalar (mirrors the bytes fixtures).
   - Error fixtures use out-err with the bare CXERNNNN code.
#]]

 # ── §3.1 parse — strict ──

 [case id=json-001-parse-int level=core
  [tags json parse scalar int]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "42"]
#]]
  [out-text [#
42
#]]
 ]

 [case id=json-002-parse-true level=core
  [tags json parse scalar bool]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "true"]
#]]
  [out-text [#
true
#]]
 ]

 [case id=json-003-parse-null level=core
  [tags json parse scalar null]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "null"]
#]]
  [out-text [#
