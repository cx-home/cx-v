true
#]]
 ]

 [case id=json-039-is-valid-malformed level=core
  [tags json is-valid predicate malformed]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:is-valid "{,}"]
#]]
  [out-text [#
false
#]]
 ]

 [case id=json-040-is-valid-strict-trailing-comma level=core
  [tags json is-valid predicate strict trailing-comma]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:is-valid "[1, 2,]"]
#]]
  [out-text [#
false
#]]
 ]
 [case id=json-041-encode-canonical-module-scaffold level=core gate=enforced
  [tags json encode module-system scaffold canonical]
  [in-cx [#
[empty]
#]]
  [in-code [#
# json:encode = CX canonical form via $format-canonical (NOT JSON); a §12.4.4
# module re-export scaffold (paired with the private encoder-not-reexported),
# not part of the json §3 surface — also exercised by conformance/code.cxd.
[?lib 'cx-stdlib/json']
[$json:encode {a: 1}]
#]]
  [out-text [#
'{a: 1}'
#]]
 ]

 [case id=json-042-all-decimal-exactness level=core gate=enforced
  [tags json parse-with-opts number-mode all-decimal exactness 17-digit 683]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[?let [= $d [$json:parse-with-opts "0.12345678901234567891" {number-mode: "all-decimal"}]]
[= $b [$json:parse-with-opts "99999999999999999999" {number-mode: "all-decimal"}]]
  ($d, [= [+ $d 0.00000000000000000009] 0.12345678901234567900], $b, [= $b [+ 99999999999999999998 1]])]
#]]
  [out-text [#
(0.12345678901234567891, true, 99999999999999999999::decimal, true)
#]]
 ]
]
