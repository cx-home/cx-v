 # §4.5 ensure-ascii escapes non-ASCII as \uXXXX. U+1234 chosen so the
 # escape (ሴ) has no hex letters and is case-insensitive.
 [case id=json-030-emit-with-opts-ensure-ascii level=core
  [tags json emit-with-opts ensure-ascii unicode]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit-with-opts "ሴ" {ensure-ascii: true}]
#]]
  [out-text [#
'"\\u1234"'
#]]
 ]

 [case id=json-031-emit-with-opts-trailing-newline level=core
  [tags json emit-with-opts trailing-newline length]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/strings']
[?lib 'cx-stdlib/json']
[?let [= $r [$json:emit-with-opts 1 {trailing-newline: true}]] [$strings:length $r]]
#]]
  [out-text [#
2
#]]
 ]

 # §4.4 nan-handling="error" raises CXER3104 when the value contains NaN.
 # non-finite unconstructible from pure CX (finite-only, code.md §6.5);
 # CXER2103/CXER3104 are FFI-boundary guards — real coverage is a
 # binding-level NaN-injection test (TODO). [/ 0.0 0.0] raises CXER0101
 # (division by zero), never yields NaN, so this case cannot exercise
 # CXER3104 from pure CX.
 [case id=json-032-emit-with-opts-nan-error level=core gate=skip
  [tags json emit-with-opts nan-handling error CXER3104]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:emit-with-opts [/ 0.0 0.0] {nan-handling: "error"}]
#]]
  [out-err [#
cx-err:CXER3104
#]]
 ]

 # ── §3.2 emit-bytes ──

 [case id=json-033-emit-bytes-utf8 level=core
  [tags json emit-bytes utf8]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[?lib 'cx-stdlib/bytes']
[$bytes:to-string-utf8 [$json:emit-bytes 42]]
#]]
  [out-text [#
'42'
#]]
 ]

