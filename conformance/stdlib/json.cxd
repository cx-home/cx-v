 ]

 [case id=json-036-parse-many-concatenated-objects level=core
  [tags json parse-many streaming object boundary]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse-many "{\"a\": 1} {\"b\": 2}"]
#]]
