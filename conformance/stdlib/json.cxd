#]]
 ]

 [case id=json-037-emit-stream-record-count level=core
  [tags json emit-stream streaming count]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[?let [= $r [$json:emit-stream (1, 2)]] [$count $r]]
#]]
  [out-text [#
2
#]]
 ]

