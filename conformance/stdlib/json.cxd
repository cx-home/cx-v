#]]
  [out-text [#
'hi'
#]]
 ]

 [case id=json-006-parse-array level=core
  [tags json parse array]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "[1, 2, 3]"]
#]]
  [out-text [#
[1, 2, 3]
#]]
 ]

 [case id=json-007-parse-object-map level=core
  [tags json parse map object]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "{\"a\": 1}"]
#]]
  [out-text [#
{a: 1}
#]]
 ]

 [case id=json-008-parse-malformed level=core
  [tags json parse error CXER3100]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "{,}"]
#]]
  [out-err [#
cx-err:CXER3100
#]]
 ]

 [case id=json-009-parse-duplicate-key-strict level=core
  [tags json parse duplicate-key error CXER3106]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "{\"a\": 1, \"a\": 2}"]
#]]
  [out-err [#
cx-err:CXER3106
#]]
 ]

 [case id=json-010-parse-int-out-of-range level=core
  [tags json parse number-out-of-range error CXER3105]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/json']
[$json:parse "99999999999999999999"]
#]]
  [out-err [#
cx-err:CXER3105
#]]
 ]

