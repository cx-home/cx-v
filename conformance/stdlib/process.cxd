[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/process']
[?lib 'cx-stdlib/strings']
[?let [= $p [$process:pipeline ([stage [argv "sh" "-c" 'echo $CXPROBE1047A; echo $CXPROBE1047B'] [opts [env {CXPROBE1047B: "stage"}]]]) env-clear=true env=[map CXPROBE1047A="pipe" CXPROBE1047B="pipe"]]] [$strings:trim $p@stdout]]
#]]
  [out-text [#
'pipe\nstage'
#]]
 ]

