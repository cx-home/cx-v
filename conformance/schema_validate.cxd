 ]

 [case id=sv-052 level=must
  [title [#S010 [?cx schema=PATH] directive in target doc, no schema source supplied#]]
  [tags schema S010]
  [in-cx [#
[?cx schema=path/to/book.cxs]
[book id='b1'
  [title 'The Stand']
]
#]]
  [schema-cxs [##]]
  [expect-codes [:S010]]
 ]

 [case id=sv-053 level=must
  [title [#S010 directive present + caller-supplied schema → directive ignored, normal validation#]]
  [tags schema S010]
  [in-cx [#
[?cx schema=ignored/path.cxs]
[book id='b1'
  [title 'The Stand']
  [author 'King']
]
#]]
  [schema-cxs [#
[schema of=book]

[book
  [attr id::string [req]]
  [elem title [card "1..1"]]
  [elem author [card "1..*"]]
]

[type title::string]
[type author::string]
#]]
  [expect-valid true]
 ]

 [case id=sv-054 level=must
  [title [#S009 multiple [?cx schema=...] directives in target doc#]]
  [tags schema S009 S010]
  [in-cx [#
[?cx schema=first.cxs]
[?cx schema=second.cxs]
[book
  [title 'X']
]
#]]
  [schema-cxs [##]]
  [expect-codes [:S009]]
 ]

 [case id=sv-055 level=must
  [title [#S010 directive after the root element still detected (mid-document position)#]]
  [tags schema S010]
  [in-cx [#
[u]
[?cx schema=after_root.cxs]
#]]
  [schema-cxs [##]]
  [expect-codes [:S010]]
 ]

 [case id=sv-056 level=must
  [title [#GG10 body :ref accepts ref element with body-position form#]]
  [tags schema S023 body-ref GG10]
  [in-cx [#
[doc
  [section #s-1
    [title T]
  ]
  [para
    [ref @s-1]
  ]
]
#]]
  [schema-cxs [#
[schema of=doc]

[doc
  [elem section [card "1..*"]]
  [elem para [card "0..*"]]
]

[section
  [elem title [card "1..1"]]
]

[type title::string]

[para]
#]]
  [expect-codes []]
 ]

 [case id=sv-057 level=must
  [title [#GG10 body :ref rejects element lacking body_ref#]]
  [tags schema S023 body-ref GG10]
  [in-cx [#
[doc
  [xref no body ref here]
]
#]]
  [schema-cxs [#
[schema of=doc]

[doc
  [elem xref [card "1..*"]]
]

[type xref::ref]
#]]
  [expect-codes [:S023]]
 ]

