 ]

 [case id=sv-051 level=must
  [title [#S007 enum bracket-form invalid value#]]
  [tags schema S007]
  [in-cx [#
[u status='unknown']
#]]
  [schema-cxs [#
[schema of=u]

[u
  [attr status::string [req] [enum active inactive pending]]
]
#]]
