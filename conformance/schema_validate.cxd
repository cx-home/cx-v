 [case id=sv-058 level=must
  [title [#schema-name directive with quoted argument accepted#]]
  [tags schema schema-name directive]
  [in-cx [#
[book id=x]
#]]
  [schema-cxs [#
[?cx schema-of book]
[?cx schema-name 'Book schema v1']

[book [attr id::string [req]]]
#]]
  [expect-valid true]
 ]

