[test-suite name=conversions ring=0
  [doc [#
# CX Conformance — conversions.md §0.2 typed-lane tests (#444 / #458)
# Version: 1.0 — 2026-07-15
# Covers: the per-type per-format rows of spec/conversions.md §0.2 —
#   JSON default (idiomatic, lossy) and lossless (`cx:type` sidecar),
#   YAML default (`!!cx:T` tags for atom/decimal/bigint, native dates,
#   `!!binary` bytes) and lossless (+ sized / temporal tags),
#   TOML default (lossy string images), and the YAML import inverses.
#
# Sections:
#   in_cx  + out_json / out_json_lossless : default vs sidecar emit
#   in_cx  + out_yaml / out_yaml_lossless : default vs tagged emit
#   in_cx  + out_toml                     : lossy TOML row
#   in_yaml + out_cx / out_json           : tag / native import inverses
#
# The JSON import inverse (sidecar consumption) lives in
# vcx/tests/conversion_lossless_test.v — the canonical strict JSON parser is
# registered from the `code` layer, which this cx-only runner cannot import.
#]]

 [case id=conv-001-typed-map-json-sidecar level=core
  [tags conversion lossless json sidecar typing]
  [title JSON lossless — typed map fields emit idiomatic values plus one cx:type sidecar]
  [in-cx [#
{status: :ok, when: 2023-01-15, at: 2023-01-15T10:00:00Z, wait: 1h30m, big: 99999999999999999999}
#]]
  [out-json [#
{"status": ":ok", "when": "2023-01-15", "at": "2023-01-15T10:00:00Z", "wait": "1h30m", "big": "99999999999999999999"}
#]]
  [out-json-lossless [#
{"status": ":ok", "when": "2023-01-15", "at": "2023-01-15T10:00:00Z", "wait": "1h30m", "big": "99999999999999999999", "cx:type": {"status": "atom", "when": "date", "at": "datetime", "wait": "duration", "big": "bigint"}}
#]]
 ]

 [case id=conv-002-typed-map-yaml-tags level=core
  [tags conversion lossless yaml tags typing]
  [title YAML — atom/decimal/bigint tag in BOTH modes, dates stay native, temporal spans tag in lossless mode only]
  [in-cx [#
{status: :ok, when: 2023-01-15, at: 2023-01-15T10:00:00Z, wait: 1h30m, big: 99999999999999999999}
#]]
  [out-yaml [#
status: !!cx:atom "ok"
when: 2023-01-15
at: 2023-01-15T10:00:00Z
wait: 1h30m
big: !!cx:bigint "99999999999999999999"
#]]
  [out-yaml-lossless [#
status: !!cx:atom "ok"
when: 2023-01-15
at: 2023-01-15T10:00:00Z
wait: !!cx:duration "1h30m"
big: !!cx:bigint "99999999999999999999"
#]]
 ]

 [case id=conv-003-decimal-element level=core
  [tags conversion lossless decimal]
  [title decimal — JSON string + sidecar, YAML !!cx:decimal in both modes, TOML lossy string]
  [in-cx [#
[score::decimal 3.14]
#]]
  [out-json [#
{"score": "3.14"}
#]]
  [; lossless = the #475 `$tag` structure envelope (conversions.md §2.2.1):
     the element shape survives, the decimal child rides the per-item
     carrier / native tag ]
  [out-json-lossless [#
{"$tag": "score", "$type": "decimal", "$children": [{"cx:decimal": "3.14"}]}
#]]
  [out-yaml [#
score: !!cx:decimal "3.14"
#]]
  [out-yaml-lossless [#
$tag: score
$type: decimal
$children:
  - !!cx:decimal "3.14"
#]]
  [out-toml [#
score = "3.14"
#]]
 ]

 [case id=conv-004-sized-numeric level=core
  [tags conversion lossless sized typing]
  [title sized numerics — native number by default; sidecar / !!cx:u16 tag preserve the width name in lossless mode]
  [in-cx [#
[port::u16 8080]
#]]
  [out-json [#
{"port": 8080}
#]]
  [; lossless: the width name rides the envelope's `$type`; the child value
     stays the native number in both lanes ]
  [out-json-lossless [#
{"$tag": "port", "$type": "u16", "$children": [8080]}
#]]
  [out-yaml [#
port: 8080
#]]
  [out-yaml-lossless [#
$tag: port
$type: u16
$children:
  - 8080
#]]
  [out-toml [#
port = 8080
#]]
 ]

 [case id=conv-005-typed-attrs-sidecar level=core
  [tags conversion lossless json attribute envelope]
  [title typed attributes — the envelope's $attr-types names them (the JSON image of XML's cx:attr-types); values keep idiomatic images]
  [in-cx [#
[event kind=:click when::date=2023-01-15]
#]]
  [out-json-lossless [#
{"$tag": "event", "$attrs": {"kind": "click", "when": "2023-01-15"}, "$attr-types": {"kind": "atom", "when": "date"}}
#]]
 ]

 [case id=conv-006-yaml-tag-import-inverse level=core
  [tags conversion lossless yaml tags import]
  [title YAML import inverse — !!cx:T tags reconstruct the typed scalars (the exact lossless-emit output re-imports)]
  [in-yaml [#
status: !!cx:atom "ok"
when: 2023-01-15
at: 2023-01-15T10:00:00Z
wait: !!cx:duration "1h30m"
big: !!cx:bigint "99999999999999999999"
score: !!cx:decimal "3.14"
width: !!cx:u16 "8080"
#]]
  [; out-cx asserts the CX-text image for the kinds canonical text can carry
    in map-value position; `score` re-renders through YAML (below) because a
    decimal keeps its type in the VALUE MODEL but canonical map-value text has
    no decimal spelling (it prints as 3.14 — same emitter limit as strings,
    see the issue filed off this wave); `width` collapses to int per
    scalar_type_from_name's documented sized-name collapse. ]
  [out-cx [#
{status: :ok, when: 2023-01-15, at: 2023-01-15T10:00:00Z, wait: 1h30m, big: 99999999999999999999, score: 3.14, width: 8080}
#]]
  [out-yaml [#
status: !!cx:atom "ok"
when: 2023-01-15
at: 2023-01-15T10:00:00Z
wait: 1h30m
big: !!cx:bigint "99999999999999999999"
score: !!cx:decimal "3.14"
width: 8080
#]]
 ]

 [case id=conv-007-yaml-native-autotyping level=core
  [tags conversion yaml import typing]
  [title YAML import auto-typing per §5.1 — dates/datetimes native, temporal spans, over-i64 bigint promotion; unknown tags preserved verbatim]
  [in-yaml [#
when: 2023-01-15
at: 2023-01-15T10:00:00Z
wait: 1h30m
big: 99999999999999999999
odd: !!python/none whatever
#]]
  [out-yaml [#
when: 2023-01-15
at: 2023-01-15T10:00:00Z
wait: 1h30m
big: !!cx:bigint "99999999999999999999"
odd: "!!python/none whatever"
#]]
 ]

 [case id=conv-008-string-shape-protection level=core
  [tags conversion yaml emit quoting typing]
  [title plain STRINGS shaped like typed scalars quote on YAML emit so the round trip keeps them strings]
  [in-cx [#
{s1: '2023-01-15', s2: '1h30m', s3: '99999999999999999999'}
#]]
  [out-yaml [#
s1: "2023-01-15"
s2: "1h30m"
s3: "99999999999999999999"
#]]
  [out-json [#
{"s1": "2023-01-15", "s2": "1h30m", "s3": "99999999999999999999"}
#]]
 ]

 [; #458 — bytes text-lane contract (conversions.md §0.2 bytes row): JSON and
    TOML default = base64 string ("no padding-stripping", §2.2); JSON lossless
    adds the cx:type sidecar; YAML = string with !!binary tag (both modes);
    MD = base64 text (one-way — MD has no type protocol, so the base64 text
    re-imports as a plain string; import gap noted on the issue). The XML lane
    (cx:type="bytes" + hex text) already conformed and is untouched.
    0x48656c6c6f is "Hello" — base64 SGVsbG8=. ]

 [case id=conv-010-bytes-default-lanes level=core
  [tags conversion bytes base64]
  [title bytes emit base64 across the text lanes — never the bare 0x hex image]
  [in-cx [#
[hash::bytes 0x48656c6c6f]
#]]
  [out-json [#
{"hash": "SGVsbG8="}
#]]
  [out-json-lossless [#
{"$tag": "hash", "$type": "bytes", "$children": [{"cx:bytes": "SGVsbG8="}]}
#]]
  [out-yaml [#
hash: !!binary "SGVsbG8="
#]]
  [out-yaml-lossless [#
$tag: hash
$type: bytes
$children:
  - !!binary "SGVsbG8="
#]]
  [out-toml [#
hash = "SGVsbG8="
#]]
  [out-md [#
<!-- [hash SGVsbG8=] -->
#]]
 ]

 [case id=conv-011-binary-tag-import-inverse level=core
  [tags conversion bytes yaml import]
  [title YAML !!binary import inverse — the tagged base64 payload reconstructs the bytes scalar (re-emits tagged)]
  [in-yaml [#
hash: !!binary "SGVsbG8="
raw: !!binary bm90LXBhZGRlZA==
#]]
  [out-yaml [#
hash: !!binary "SGVsbG8="
raw: !!binary "bm90LXBhZGRlZA=="
#]]
  [out-json [#
{"hash": "SGVsbG8=", "raw": "bm90LXBhZGRlZA=="}
#]]
 ]

 [case id=conv-012-bytes-attr level=core
  [tags conversion bytes attribute envelope]
  [title bytes-typed attribute rides the same lanes ($attr-types names it in lossless JSON; value is base64)]
  [in-cx [#
[blob sum::bytes=0x00ff10]
#]]
  [out-json-lossless [#
{"$tag": "blob", "$attrs": {"sum": "AP8Q"}, "$attr-types": {"sum": "bytes"}}
#]]
  [out-yaml [#
blob:
  sum: !!binary "AP8Q"
#]]
 ]

 [case id=conv-009-table-payload-not-dropped level=core
  [tags conversion lossless table envelope]
  [title a :table payload rides $cols/$rows in the lossless lanes — header text, row order and cell types all recoverable (§2.2.1)]
  [in-cx [#
[users [table[name::string age::int]]
  alice 30
  bob 25
]
#]]
  [out-json-lossless [#
{"$tag": "users", "$type": "table", "$cols": ["name::string", "age::int"], "$rows": [["alice", 30], ["bob", 25]]}
#]]
  [out-yaml-lossless [#
$tag: users
$type: table
$cols:
  - name::string
  - age::int
$rows:
  - - alice
    - 30
  - - bob
    - 25
#]]
 ]

 [; #473 — the CX-text mirror of conv-008: a STRING map value whose bare
    image would auto-type (number / bool / null / atom / date / datetime /
    duration / period / bigint shapes) quotes on CX emit, so the canonical
    text re-imports the same string — no silent type flip through the CX
    text lane. The imported YAML quoted scalars are plain strings in the
    value model (conv-008 proved the YAML emit side; this pins the CX emit
    side). Typed values are NOT affected: conv-006 keeps `wait: 1h30m` /
    `big: 9…9` bare for genuine duration/bigint scalars. ]

 [case id=conv-013-map-value-string-shape-cx-lane level=core
  [tags conversion emit quoting typing cx issue-473]
  [title type-shaped STRING map values quote on CX emit so the text lane re-imports them as strings]
  [in-yaml [#
i: "1937"
f: "3.14"
b: "true"
n: "null"
a: ":click"
d: "2023-01-15"
t: "2023-01-15T10:00:00Z"
w: "1h30m"
p: "3mo"
big: "99999999999999999999"
h: "0x1F"
#]]
  [out-cx [#
{i: '1937', f: '3.14', b: 'true', n: 'null', a: ':click', d: '2023-01-15', t: '2023-01-15T10:00:00Z', w: '1h30m', p: '3mo', big: '99999999999999999999', h: '0x1F'}
#]]
  [out-json [#
{"i": "1937", "f": "3.14", "b": "true", "n": "null", "a": ":click", "d": "2023-01-15", "t": "2023-01-15T10:00:00Z", "w": "1h30m", "p": "3mo", "big": "99999999999999999999", "h": "0x1F"}
#]]
 ]

 [; #475 — the `$tag` structure envelope (conversions.md §2.2.1/§2.3.1):
    element documents emit a reserved-key envelope in lossless mode so the
    element-vs-map shape, attr-vs-child distinction, mixed-content order and
    element metadata all survive CX→json|yaml→CX byte-identically
    (strict-canonical eq). The JSON import inverse lives in
    vcx/tests/conversion_lossless_test.v (the strict JSON parser is
    registered from the `code` layer this runner cannot import); the YAML
    import inverse is pinned here (conv-015/conv-016). The examples/*.cx
    corpus round-trips end-to-end in
    vcx/tests/lossless_examples_matrix_test.v. ]

 [case id=conv-014-envelope-mixed-content level=core
  [tags conversion lossless envelope mixed-content issue-475]
  [title mixed content keeps its run order in the envelope — text runs are plain strings, inline elements nest]
  [in-cx [#
[p 'seen ' [em twice] ' today']
#]]
  [out-json-lossless [#
{"$tag": "p", "$children": ["seen ", {"$tag": "em", "$children": ["twice"]}, " today"]}
#]]
  [out-yaml-lossless [#
$tag: p
$children:
  - "seen "
  - $tag: em
    $children:
      - twice
  - " today"
#]]
 ]

 [case id=conv-015-envelope-yaml-import-inverse level=core
  [tags conversion lossless envelope yaml import issue-475]
  [title YAML envelope import inverse — the exact lossless-emit output reconstructs the element document]
  [in-yaml [#
$tag: p
$children:
  - "seen "
  - $tag: em
    $children:
      - twice
  - " today"
#]]
  [out-cx [#
[p 'seen ' [em twice] ' today']
#]]
 ]

 [case id=conv-016-envelope-doc-meta-yaml-import level=core
  [tags conversion lossless envelope yaml import meta issue-475]
  [title $doc multi-root wrapper + $anchor/$merge meta reconstruct on YAML import]
  [in-yaml [#
$doc:
  - $tag: defaults
    $anchor: base
    $attrs:
      host: x
  - $tag: dev
    $merge: base
#]]
  [out-cx [#
[defaults &base host=x]
[dev *base]
#]]
 ]

 [case id=conv-017-envelope-reserved-key-escape level=core
  [tags conversion lossless envelope escaping issue-475]
  [title a user map key that looks reserved escapes behind cx:k: on lossless emit and unescapes on import]
  [in-cx [#
[m {'$tag': weird}]
#]]
  [out-json-lossless [#
{"$tag": "m", "$children": [{"cx:k:$tag": "weird"}]}
#]]
  [out-yaml-lossless [#
$tag: m
$children:
  - cx:k:$tag: weird
#]]
 ]

 [case id=conv-018-envelope-escape-yaml-import level=core
  [tags conversion lossless envelope escaping yaml import issue-475]
  [title cx:k: escape import inverse — the escaped key comes back as an ordinary map key and never reads as protocol]
  [in-yaml [#
$tag: m
$children:
  - cx:k:$tag: weird
#]]
  [out-cx [#
[m {'$tag': weird}]
#]]
 ]

# ── TOML import lane (corpus audit G7, pre-I2) ───────────────────────────
# The import surface shipped (parser_toml.v, --from=toml) with emit-only
# fixtures; these pin the import inverse. Both halves of #738 are now
# closed: the native date/datetime mapping (conv-023..026, which §6.1's
# table had already ruled — only the impl was behind) and the STRICT
# READER (conv-027..033, RULED 738-2a — malformed input is refused with
# CXER0100 instead of guessed into a best-effort tree).

 [case id=conv-019-toml-import-scalars level=core
  [tags conversion toml import]
  [title TOML import — string/int/float/bool scalars map to CX kinds (float keeps the e0 image)]
  [in-toml [#
status = "shipped"
qty = 3
total = 9.99
express = true
#]]
  [out-cx [#
{status: shipped, qty: 3, total: 9.99e0, express: true}
#]]
 ]

 [case id=conv-020-toml-import-nested-tables level=core
  [tags conversion toml import]
  [title TOML import — dotted table headers nest as CX maps]
  [in-toml [#
sku = "WIDGET-1"

[customer]
name = "Acme Retail"
tier = "gold"

[customer.address]
city = "Springfield"
#]]
  [out-cx [#
{sku: WIDGET-1, customer: {name: 'Acme Retail', tier: gold, address: {city: Springfield}}}
#]]
 ]

 [case id=conv-021-toml-import-array-of-tables level=core
  [tags conversion toml import]
  [title TOML import — [[array-of-tables]] rows become a CX array of maps]
  [in-toml [#
[[items]]
sku = "WIDGET-1"
qty = 2

[[items]]
sku = "GADGET-7"
qty = 1
#]]
  [out-cx [#
{items: [{sku: WIDGET-1, qty: 2}, {sku: GADGET-7, qty: 1}]}
#]]
 ]

 [case id=conv-022-toml-import-to-json level=core
  [tags conversion toml import json cross-format]
  [title TOML import cross-format — TOML source through the registry to idiomatic JSON]
  [in-toml [#
order = 7001
tags = ["priority", "gift"]
#]]
  [out-json [#
{
  "order": 7001,
  "tags": [
    "priority",
    "gift"
  ]
}
#]]
 ]

 [case id=conv-023-toml-import-date-native level=core
  [tags conversion toml import date issue-738]
  [title TOML date value imports as a native CX date — the §6.1 mapping table, not a string]
  [meta [#
note: RE-BLESSED (issue-738). This case pinned the SHIPPED string image
note: `{placed: '2026-08-01'}` while §6.1's mapping table already read
note: "TOML date → ScalarNode with `date` type" and §0.2 said dates stay
note: native — so the pin was recording an impl that sat below its own
note: approved table. The impl rose; the pin follows it.
note:
note: The classifiers are the SAME is_date / is_datetime the YAML import
note: lane and the CX data scanner use (one temporal grammar, [L24]), so
note: a value that is a date in one reading cannot be a string in
note: another — which is exactly the divergence this fixture used to pin.
#]]
  [in-toml [#
placed = 2026-08-01
#]]
  [out-cx [#
{placed: 2026-08-01}
#]]
 ]

 [case id=conv-024-toml-import-datetime-native level=core
  [tags conversion toml import datetime issue-738]
  [title TOML offset datetime imports as a native CX datetime (§6.1)]
  [in-toml [#
placed = 2026-08-01T07:32:00Z
#]]
  [out-cx [#
{placed: 2026-08-01T07:32:00Z}
#]]
 ]

 [case id=conv-025-toml-import-invalid-calendar-stays-text level=core
  [tags conversion toml import date negative lossless issue-738]
  [title A date-SHAPED TOML value with an impossible calendar date stays text]
  [meta [#
note: the boundary of the native mapping, pinned so "looks like a date"
note: never becomes the rule. `calendar_ok` refuses month 13 / day 45, so
note: the token classifies as text under BOTH readings — the same answer
note: the CX data scanner gives for the same bytes.
note:
note: The assertion is on the LOSSLESS JSON lane deliberately. In CX text
note: and in YAML this value's image is bare either way (a string only
note: quotes where it WOULD otherwise auto-type, and `2026-13-45` never
note: auto-types), so those projections cannot tell a date from a
note: date-shaped string — an out-cx pin here would pass whichever way
note: the impl went. The `cx:type` sidecar names the kind outright, so
note: the ABSENCE of a `placed: date` entry is the real assertion; see
note: conv-023 for the positive image it would carry.
#]]
  [in-toml [#
placed = 2026-13-45
#]]
  [out-json-lossless [#
{
  "placed": "2026-13-45"
}
#]]
 ]

 [case id=conv-026-toml-import-date-parity-with-yaml level=core
  [tags conversion toml import date yaml parity issue-738]
  [title TOML and YAML import the same date to the same CX value]
  [meta [#
note: the point of issue-738's date half: two import lanes into ONE value
note: model must not disagree about what a date is. The YAML lane already
note: mapped natively; this pins that the TOML lane now agrees, so the
note: fixture fails if either lane drifts.
#]]
  [in-toml [#
placed = 2026-08-01
shipped = 2026-08-02T09:15:00Z
#]]
  [out-cx [#
{placed: 2026-08-01, shipped: 2026-08-02T09:15:00Z}
#]]
 ]

 [case id=conv-027-toml-import-unterminated-inline-array-refused level=core
  [tags conversion toml import negative strict CXER0100 issue-738]
  [title TOML strict reader — an unterminated inline array is refused, not guessed]
  [meta [#
note: RULED 738-2a. This IS issue-738's repro. The old reader folded the
note: open bracket and the stray token into `{qty: [1, '2 bad']}` at rc=0
note: — it could not fail at all: every level ended in `or { continue }`
note: and every reader returned unconditionally.
#]]
  [in-toml [#
qty = [1, 2
bad
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=conv-028-toml-import-unterminated-inline-table-refused level=core
  [tags conversion toml import negative strict CXER0100 issue-738]
  [title TOML strict reader — an unterminated inline table is refused]
  [in-toml [#
a = {x = 1
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=conv-029-toml-import-stray-line-refused level=core
  [tags conversion toml import negative strict CXER0100 issue-738]
  [title TOML strict reader — a line that is neither comment, header, nor pair is refused]
  [in-toml [#
a = 1
bad
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=conv-030-toml-import-unterminated-table-header-refused level=core
  [tags conversion toml import negative strict CXER0100 issue-738]
  [title TOML strict reader — an unterminated table header is refused]
  [in-toml [#
[server
port = 8080
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=conv-031-toml-import-unterminated-string-refused level=core
  [tags conversion toml import negative strict CXER0100 issue-738]
  [title TOML strict reader — an unterminated quoted string is refused]
  [in-toml [#
a = "oops
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=conv-032-toml-import-duplicate-key-refused level=core
  [tags conversion toml import negative strict duplicate-key CXER0100 issue-738]
  [title TOML strict reader — a duplicate key in one table is refused]
  [meta [#
note: silently taking the LAST value is the failure mode this refusal
note: exists for: a config whose two `a =` lines disagree has no single
note: correct reading, so the reader must not pick one.
#]]
  [in-toml [#
a = 1
a = 2
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=conv-033-toml-import-repeated-key-across-aot-entries-is-legal level=core
  [tags conversion toml import strict duplicate-key array-of-tables issue-738]
  [title TOML strict reader — the SAME key in two array-of-tables entries is legal, not a duplicate]
  [meta [#
note: the boundary of the duplicate-key refusal, and the reason the scope
note: key carries the array-of-tables ORDINAL: `sku` in two successive
note: `[[items]]` entries are two different keys, while `sku` twice inside
note: ONE entry is a duplicate. Without this pin the strictness would
note: reject ordinary TOML.
#]]
  [in-toml [#
[[items]]
sku = "WIDGET-1"

[[items]]
sku = "GADGET-7"
#]]
  [out-cx [#
{items: [{sku: WIDGET-1}, {sku: GADGET-7}]}
#]]
 ]
]
