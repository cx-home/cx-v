 [case id=cmp-003-unknown-codec-rejected level=extended
  [tags data_bin compression error]
  [in-data-bin-hex [#
43 58 43 6F 6C 01 01 40 00 00 00 00    # CXCol header
63 02 30 04 6E 61 6D 65 30 30 05 73 63 6F 72 65 12  # 0x63 + 2 cols
07                                     # body_byte_len = 7
90                                     # body-tag 0x90 (compressed)
FF                                     # codec id 0xFF (unknown)
05 03                                  # uncomp_len=5, comp_len=3
DE AD BE                               # 3 frame bytes (garbage; rejected at codec-id check)
00                                     # end-of-table marker
#]]
  [expected-decode-error [#
D005: unknown compression codec id 0xff (zstd v1 = 0x01 expected)
#]]
 ]

 [case id=cmp-004-codec-id-zero-rejected-in-canonical level=extended
  [tags data_bin compression canonical]
  [in-data-bin-hex [#
43 58 43 6F 6C 01 01 40 00 00 00 00    # CXCol header
63 02 30 04 6E 61 6D 65 30 30 05 73 63 6F 72 65 12  # 0x63 + 2 cols
07                                     # body_byte_len = 7
90                                     # body-tag 0x90 (compressed)
00                                     # codec id 0x00 (reserved)
05 03                                  # uncomp_len=5, comp_len=3
DE AD BE                               # 3 frame bytes (garbage; rejected at codec-id check)
00                                     # end-of-table marker
#]]
  [expected-decode-error [#
D005: codec id 0x00 reserved; use plain body-tag 0x01 for uncompressed row groups
#]]
 ]

 [case id=cmp-005-fd-streaming-write-bounded-memory level=extended
  [tags data_bin compression streaming fd synth]
  [meta [#
chunk_at: 65536
#]]
  [synth-table-schema [#
[t [table[id::int v::string]]]
#]]
  [synth-table-rows [#
1
#]]
  [assert-streaming-write-bounded-memory [#
65536 1 100 1.50
#]]
 ]
]
