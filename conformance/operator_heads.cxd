 [; ── #983: the UNTERMINATED head at EOF — which lane raises ── ]

 [case id=oph-408-unterminated-plus-head-at-eof level=core
  [tags operator-heads issue-976 issue-983 guard eof negative CXER0100]
  [title Operator head at EOF is refused by the ELEMENT lane, not the array lane]
  [in-cx [#
[+
#]]
  [out-err [#
expected ']' got EOF (cx-err:CXER0100)
#]]
 ]

 [case id=oph-409-glued-le-bare-image-is-its-own-value level=core
  [tags operator-heads issue-976 issue-983 guard glued array roundtrip hash-pair]
  [title The bare canonical image of a glued operator head IS the quoted string it renders]
  [in-a [#
[<=x]
#]]
  [in-b [#
['<=x']
#]]
  [out-hash-eq [#
true
#]]
 ]

]
