[-1, 2]
#]]
 ]

 [case id=oph-009-alias-reference-unmoved level=core
  [tags operator-heads i1 guard alias]
  [; The GLUED `*name` spelling stays an alias reference in every
     position — only the DELIMITED `*` is an operator head. Canonical
     resolves the alias (§2.8), proving the parse route held. (out-cx is
     not pinned here: the lossless fmt emitter has a pre-existing
     body-position alias defect, tracked separately — parse and
     canonical are correct.) ]
  [in-cx [#
[x [a &n 1] [b [*n]]]
#]]
  [out-canonical [#
[x
  [a 1]
  [b
    [a 1]
  ]
]
#]]
 ]

 [case id=oph-010-empty-operator-element level=core
  [tags operator-heads i1 element empty]
  [in-cx [#
[+]
#]]
  [out-cx [#
[+]
#]]
 ]

 [; ── #976: the head alphabet is the EVALUATORs, and it is CLOSED at 18 ──
    Every head in the code/eval.v operator_element_heads set canonicalizes
    here. Five could not before: `%` and `<=` STRINGIFIED through the array
    lane (rc=0, SILENT) while `!=`, `>=` and `~` raised "expected name"
    (rc=1, loud). The silent pair is the defect that mattered — oph-301/302
    pin why. The data parser had its OWN seven-glyph copy of this alphabet;
    the evaluator set is the ruled truth and lexical.v operator_head_len is
    now its single home. ]

