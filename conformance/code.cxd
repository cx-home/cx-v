  [in-cx [#
[items
  [item id=1]
  [item id=2 bad=true]
  [item id=3]]
#]]
  [in-code [#
[?for [item $i]
      [yield [?let [= $r [$validate-item $i]]
        [?match $r
          [case [err $err] [skip id=$i@id reason=$err@code]]
          [else $r]]]]]
#]]
  [out-text [#
[ok id=1]
[skip id=2 reason=cx-err:CXER0100]
[ok id=3]
#]]
 ]

