 [case id=ev-select-fair-001-not-source-biased level=core rule=EV-SELECT-FAIR
  [tags select fairness stream-22 694 discriminator]
  [; ── EV-SELECT-FAIR (code.md §14.4): among simultaneously-ready
     cases, selection MUST NOT be deterministically biased toward
     source order. 20 trials over two always-ready channels; a
     first-ready-in-source-order engine picks case 1 every time
     (result false); a fair tiebreak picks case 2 at least once w/
     false-failure probability 2^-20. The distribution test proper is
     reference-lane-only (§11.4 partition).]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [?channel name="sf-a" buffer=32]] [= $b [?channel name="sf-b" buffer=32]]
  [?loop [= $i 0] [= $second 0]
    [?if [= $i 20]
      [then [break [> $second 0]]]
      [else
        [?let [= $s1 [?send 1 to=$a]] [= $s2 [?send 2 to=$b]]
          [?let [= $pick [?select
                           [case [from $a $m] 1]
                           [case [from $b $m] 2]]]
            [?let [= $drain [?receive from=[?if [= $pick 1] [then $b] [else $a]]]]
              [?if [= $pick 1]
                [then [continue [+ $i 1] $second]]
                [else [continue [+ $i 1] [+ $second 1]]]]]]]]]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=ev-select-fair-002-only-ready-fires level=core rule=EV-SELECT-FAIR
  [tags select fairness readiness stream-22 694]
  [; ── the pair-mate: fairness applies AMONG READY cases only — with
     exactly one ready case (the other channel empty), selection is
     deterministic; 20 trials all pick the ready case.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [?channel name="sfo-a" buffer=32]] [= $b [?channel name="sfo-b" buffer=32]]
  [?loop [= $i 0] [= $wrong 0]
    [?if [= $i 20]
      [then [break [= $wrong 0]]]
      [else
        [?let [= $s2 [?send 2 to=$b]]
          [?let [= $pick [?select
                           [case [from $a $m] 1]
                           [case [from $b $m] 2]]]
            [?if [= $pick 2]
              [then [continue [+ $i 1] $wrong]]
              [else [continue [+ $i 1] [+ $wrong 1]]]]]]]]]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=cmd-027-strict-pinned-schema-enforces level=core
  [tags def strict-mode e2-pin schema-registry stream-16 688 CXER0206]
  [; ── W5 (L64): under strict, an ELEMENT-NAME type whose name has a
     REGISTERED schema enforces by SCHEMA VALIDATION — the schema's own
     of= root subsumes the head match (Order ↔ [schema of=order]). A
     conforming order passes; one missing the required attr refuses
     CXER0206 at the call boundary. An UNPINNED element-name keeps the
     W1 head-match.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/validate']
[?def take-order [returns int] ($o::Order) 1]
[?def take-memo [returns int] ($m::Memo) 2]
[?let
[= $h [$validate:register-schema "Order" "[schema of=order mode=open]
[order [attr sku::string [req]]]"]]
[= $ok [$take-order [order sku=SKU-1]]]
[= $bad [?fallback [$take-order [order]] [recover-with [context] [code $err@code]]]]
[= $unpinned [$take-memo [Memo]]]
  [probe [ok $ok] [bad $bad] [unpinned $unpinned]]]
#]]
  [out-text [#
[probe [ok 1] [bad [code 'cx-err:CXER0206']] [unpinned 2]]
#]]
 ]

 [case id=cmd-028-strict-pipe-preexecution-flow level=core
  [tags pipe strict-mode layer-b stream-16 688 CXER0206]
  [; ── W5 (L62B): the Layer-B minimum — declared [returns]/::T flow
     across [?pipe] stages checks PRE-EXECUTION under strict: adjacent
     declared boundaries that cannot compose refuse CXER0206 BEFORE any
     stage runs (the side-effect counter proves nothing executed). A
     composing chain runs normally; undeclared boundaries are silent
     (annotations are optional — modular, declarations are the
     contract).]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def to-text [returns string] ($x::int) 'n']
[?def shout [returns string] ($s::string) $s]
[?let
[= $ok [?pipe 3 to-text shout]]
[= $bad [?fallback [?pipe 3 to-text shout to-text] [recover-with [context] [code $err@code]]]]
  [probe [ok $ok] [bad $bad]]]
#]]
  [out-text [#
[probe [ok 'n'] [bad [code 'cx-err:CXER0206']]]
#]]
 ]

