 ]

 [case id=program-table-478-001-attrs-literal level=core
  [tags table attrs elementmeta issue-478]
  [doc [#
# 478 (program lane): an ATTRIBUTED `[table[…]]`-block element literal
# inside a program parses via the data-reader seam — the attribute run
# precedes the `[table[` clause (grammar [29]/[50]), so the program
# parser re-checks for the clause opener after the attrs and delegates
# the span. The element (attrs included) evaluates to itself.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [users region=west [table[name age::int]] alice 30 bob 25]] $t]
#]]
  [out-text [#
[users region=west [table[name age::int]]
  alice 30
  bob 25
]
#]]
 ]

 [case id=program-table-478-002-attrs-dynamic-err level=core
  [tags table attrs dynamic error issue-478]
  [doc [#
# 478 (program lane, fail-closed): a DYNAMIC attribute value on a
# `[table[…]]` element literal cannot ride the data reading — the
# parser rejects it loudly rather than silently literalizing `$x`
# (the tabular form is data-only; rows have no expression production).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x west] [users region=$x [table[a]] 1]]
#]]
  [out-err [#
must be a scalar literal
#]]
 ]

 [case id=program-table-484-001-nested-literal level=core
  [tags table nested composition issue-484]
  [doc [#
# 484 (program lane): a table-bearing element literal nested inside
# another element literal parses as ordinary composition — the program
# reading's element-literal body loop detects the `[table[` clause-child
# opener on the CHILD and delegates that span to the data reader, same
# as at top level.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [wrap [users [table[name age::int]] alice 30]]] $t]
#]]
  [out-text [#
[wrap [users [table[name age::int]]
  alice 30
]]
#]]
 ]

 [case id=program-table-484-002-misplaced-opener-err level=core
  [tags table reserved-name error issue-484]
  [doc [#
# 484 (program lane, fail-closed): the reserved glued `[table[` opener
# with no enclosing element head (anonymous table) is not grammatical —
# grammar [50]'s tabular alternative requires a Name. The program
# reading delegates the span to the data reader, which rejects loudly;
# both engines converge on the rejection.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [table[name age] Ada 36]] $t]
#]]
  [out-err [#
outside ElementMeta position
#]]
 ]

