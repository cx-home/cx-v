  [order id=b total=200]]
#]]
  [in-code [#
[?for [order @id=$i @total=$t] [yield [pair id=$i total=$t]]]
#]]
  [out-text [#
[pair id=a total=15]
[pair id=b total=200]
#]]
 ]

