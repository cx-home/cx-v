 [case id=program-pvmatrix-007-doc-wildcard-toplevel level=core
  [tags cxpath pvmatrix document wildcard parse]
  [; R-A2: a document navigates as a container node — /* is its top-level
     ELEMENTS, comments skip, identical on every engine path (was CXER0001
     in the node-set lane, and the #964 refusal on any multi-node parse). ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $d [$cx:parse "[; a comment ]\n[a x=1]\n[b x=2]"]] [$count $d/*]]
#]]
  [out-text [#
2
#]]
 ]

