 [case id=program-planar-equiv-001-sigma-below-tau level=core
  [tags for where order-by planar-equivalence stream-2 L96]
  [meta [#
note: the L96 σ-pushdown-below-τ equivalence ground truth — filtering
note: before or after a stable sort yields the identical relation (the
note: rewriter applies this direction only for established-total
note: predicates; this pair pins the engine-level equivalence).
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
(
[?for [in $x (5, 3, 1, 4, 2)] [order-by $x desc] [where [= $x 4]] [yield $x]],
[?for [in $x (5, 3, 1, 4, 2)] [where [= $x 4]] [order-by $x desc] [yield $x]]
)
#]]
  [out-text [#
(4, 4)
#]]
 ]

 [case id=program-planar-equiv-002-sigma-placement level=core
  [tags for where generator planar-equivalence stream-2 L96]
  [meta [#
note: σ-placement — a filter referencing only the FIRST generator's
note: bind yields the identical relation from either side of an
note: independent second generator (Cartesian independence).
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
(
[?for [in $a (1, 2)] [in $b (10, 20)] [where [= $a 2]] [yield [p $a $b]]],
[?for [in $a (1, 2)] [where [= $a 2]] [in $b (10, 20)] [yield [p $a $b]]]
)
#]]
  [out-text [#
(([p 2 10], [p 2 20]), ([p 2 10], [p 2 20]))
#]]
 ]

