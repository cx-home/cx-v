 [; ── #319 native-stack guard (E_STACK_EXHAUSTED, §9.4/§9.5) ─────────────
    Non-tail eval recursion has no trampoline (only tail calls do), so its
    depth is bounded by the host thread stack. The evaluator probes the
    remaining headroom at every node and raises the CATCHABLE value-form
    `cx-err:CXER0272` with margin to spare — deep non-tail recursion either
    completes or raises the coded err, NEVER a SIGSEGV. The depths below are
    far past any plausible stack (1e6 levels), so the err outcome is
    deterministic across build modes; the tail-call twin MUST still complete
    (TCO trampoline regression guard, #60). Crash-shape (signal-level) and
    small-rlimit variants live in vcx/tests/eval_stack_guard_test.v — a
    SIGSEGV would kill this in-process harness. ;]

 [case id=program-stack-guard-non-tail-deep level=core
  [tags recursion stack-guard error-shape CXER0272]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def sum1 ($n)
  [?if [= $n 0]
    [then 0]
    [else [+ 1 [sum1 [- $n 1]]]]]]
[sum1 1000000]
#]]
  [out-err [#
cx-err:CXER0272
#]]
 ]

 [case id=program-stack-guard-recoverable-by-fallback level=core
  [tags recursion stack-guard fallback errors-are-values CXER0272]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def sum1 ($n)
  [?if [= $n 0]
    [then 0]
    [else [+ 1 [sum1 [- $n 1]]]]]]
[?fallback [sum1 1000000] [recover-with "recovered"]]
#]]
  [out-text [#
'recovered'
#]]
 ]

 [case id=program-stack-guard-tail-call-completes level=core
  [tags recursion stack-guard tail-call tco]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def loop ($n $acc)
  [?if [= $n 0]
    [then $acc]
    [else [loop [- $n 1] [+ $acc 1]]]]]
[loop 200000 0]
#]]
  [out-text [#
200000
#]]
 ]

 [case id=program-stack-guard-worker-thread level=concurrency
  [tags recursion stack-guard worker CXER0220 CXER0272]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?def sum1 ($n)
  [?if [= $n 0]
    [then 0]
    [else [+ 1 [sum1 [- $n 1]]]]]]
[?let [= $w [?worker name="wdeep" [body [sum1 1000000]]]] [?wait-for worker=$w]]
#]]
  [out-err [#
cx-err:CXER0272
#]]
 ]

