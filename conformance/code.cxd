 [case id=program-order-by-desc-001 level=core
  [tags for order-by desc]
  [meta [#
note: probe #35 — descending sort direction. Direction accepts
note: BOTH the bare ident (`desc` / `asc`) immediately after the key expr
note: AND the colon-clause alias (`:desc` / `:asc`) — see
note: program-order-by-desc-002-colon-alias. Ties keep source order
note: (stable sort): C and B both age=30, C precedes B as in source.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $users [u-set [u name="C" age=30] [u name="A" age=25] [u name="B" age=30]]] [?for [in $u $users//u] [order-by $u/@age desc] [yield $u/@name]]]
#]]
  [out-text [#
'C'
'B'
'A'
#]]
 ]

 [case id=program-order-by-desc-002-colon-alias level=core
  [tags for order-by desc colon-alias]
  [meta [#
note: The `:desc` colon-clause alias parses identically to the bare
note: `desc` form (every other for-comp modifier is a `:label`, so the
note: colon form reads naturally and is now accepted).
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $users [u-set [u name="C" age=30] [u name="A" age=25] [u name="B" age=30]]] [?for [in $u $users//u] [order-by $u/@age desc] [yield $u/@name]]]
#]]
  [out-text [#
'C'
'B'
'A'
#]]
 ]

 [case id=program-order-by-multikey-001 level=core
  [tags for order-by desc multi-key chained]
  [meta [#
note: probe #35 — `:then-by` does NOT exist, but a multi-key
note: sort is expressible by chaining `:order-by` clauses. Sort by the
note: SECONDARY key first, then the PRIMARY; the stable sort preserves
note: the secondary order within primary ties. Here: name asc, then age
note: desc → ties on age=30 stay name-ordered (B before C).
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $users [u-set [u name="C" age=30] [u name="A" age=25] [u name="B" age=30]]] [?for [in $u $users//u] [order-by $u/@name] [order-by $u/@age desc]
        [yield [r n=$u/@name a=$u/@age]]]]
#]]
  [out-text [#
[r n=A a=25]
[r n=B a=30]
[r n=C a=30]
#]]
 ]

 [case id=program-string-index-001 level=core
  [tags string substring char-access]
  [meta [#
note: probe #42 — char-level string access is via the
note: `substring(s, start, len)` builtin (1-indexed, XPath fn:substring
note: convention), NOT `$s[i]` subscript. Strings are scalars, not
note: sequences: `$s[1]` returns the whole string and `$s[2:4]` is empty
note: because `iterate(scalar)` yields a 1-element sequence. `substring`
note: is the blessed path for both single-char (len=1) and slice access.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $s "hello"] [$substring $s 2 3]]
#]]
  [out-text [#
'ell'
#]]
 ]

