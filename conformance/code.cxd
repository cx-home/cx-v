 [case id=program-for-group-013-orderby-then-groupby level=core
  [tags for order-by group-by barrier-composition stream-2]
  [meta [#
note: tau THEN gamma — the reverse composition. The per-frame engine
note: partitioned one frame at a time (every item its own group); the
note: frame-set pipeline groups the whole ordered set.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?for [in $x (3, 1, 2, 4)] [order-by $x] [group-by [$mod $x 2]]
  [yield [g key=$key n=$count members=[$count $group/x]]]]
#]]
  [out-text [#
[g key=1 n=2 members=2]
[g key=0 n=2 members=2]
#]]
 ]

 [case id=program-for-lambda-001-repeated-take-min level=core
