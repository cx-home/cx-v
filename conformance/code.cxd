 [case id=program-body-ascription-014-atom-number-err level=core
  [tags element ascription atom error CXER0109 issue-466]
  [; #466 item 2: ::atom demands a denotable atom name ([L40]); a number
     token fails loud in BOTH readings instead of minting an atom whose
     render `:42` would not re-parse. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [x::atom 42]] $x]
#]]
