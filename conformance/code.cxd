  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $s ([a x=1], 'str')] [$count $s/@x]]
#]]
  [out-text [#
1
#]]
 ]


 [; ── #976: operator heads reaching the EVALUATOR through the DATA parser ──
    in-cx rides cx.parse, the DATA parser, and binds as $doc. A head that
    stringifies yields an array with no Element, $doc never binds, and the
    case fails outright — which is what these would have done for `%`, `<=`,
    `!=`, `>=` and `~` before #976. The canonicalization half lives in
    conformance/operator_heads.cxd. ]

