#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/time']
[?let [= $t [$time:now]]
  [?let [= $h [$env:var "HOME"]]
    [ok]]]
#]]
  [out-text [#
[ok]
#]]
  [out-effects [#
clock:time-now
env:env-var
#]]
 ]

