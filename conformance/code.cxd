[?def boom ($x) [/ $x 0]]
[?def add1 ($x) [+ $x 1]]
[?pipe 5 boom [tap [$log:error 'must not fire']] add1]
#]]
  [out-err [#
cx-err:CXER0101
#]]
 ]

 [# ── §8.8/§9.3 [?try]/[catch]/[on-error] RETIRED (C3c): both surfaces raise
       CXER0100 — the negatives below are enforced. ── #]
 [case id=program-sap-try-01-removed-negative level=core
  [tags sap no-legacy try removed negative]
  [in-cx [# [empty] #]]
  [in-code [# [?try [/ 10 0] [catch $err 0]] #]]
  [out-err [# cx-err:CXER0100 #]]
 ]
 [case id=program-sap-try-02-on-error-removed-negative level=core
  [tags sap no-legacy on-error removed negative]
  [in-cx [# [empty] #]]
  [in-code [# [?for [in $x (1, 2)] [on-error $e skip] [yield [/ 10 $x]]] #]]
  [out-err [# cx-err:CXER0100 #]]
 ]
 [# V2: the retired per-iteration recovery clause ≡ yield-body [?match] — the migrated replacement is grounded. #]
 [case id=program-sap-try-03-onerror-equiv-match level=core
  [tags sap match per-iteration v2 grounded]
  [in-cx [# [empty] #]]
  [in-code [#
[?for [in $x (2, 0, 5)]
  [yield [?match [?let [= $r [/ 10 $x]] $r]
    [case [err $e] [skipped code=$e/@code]]
    [else $x]]]]
#]]
  [out-text [#
2
[skipped code=cx-err:CXER0101]
5
#]]
 ]

 [# ── §9.3 catchability taxonomy — every catchable class is a value-form err
       reachable by [?match] (bind-first, grounded today). ── #]
 [case id=program-sap-catch-01-arith level=core
  [tags sap catchability arithmetic grounded]
  [in-cx [# [empty] #]]
  [in-code [# [?let [= $r [/ 1 0]] [?match $r [case [err $e] [c code=$e/@code]] [else ok]]] #]]
  [out-text [# [c code=cx-err:CXER0101] #]]
 ]
 [case id=program-sap-catch-02-unbound level=core
  [tags sap catchability unbound grounded]
  [in-cx [# [empty] #]]
  [in-code [# [?let [= $r [$nope 1]] [?match $r [case [err $e] caught] [else ok]]] #]]
  [out-text [# caught #]]
 ]
 [# ── §9.1.2.1 null-totality matrix — operations on null yield a defined value
       or a clean [err], NEVER a crash (grounded today; pins the totality claim). #]
 [case id=program-sap-null-01-arith-clean-err level=core
  [tags sap null-totality arithmetic grounded]
  [in-cx [# [empty] #]]
  [in-code [# [?match [?let [= $r [+ null 5]] $r] [case [err $e] [total]] [else [also-total]]] #]]
  [out-text [# [total] #]]
 ]
 [case id=program-sap-null-02-concat-value level=core
  [tags sap null-totality string grounded]
  [in-cx [# [empty] #]]
  [in-code [# [$concat null 'x'] #]]
  [out-text [# 'nullx' #]]
 ]
 [case id=program-sap-null-03-eq level=core
  [tags sap null-totality equality grounded]
  [in-cx [# [empty] #]]
  [in-code [# [= null null] #]]
  [out-text [# true #]]
 ]
 [case id=program-sap-null-04-count level=core
  [tags sap null-totality collection grounded]
  [in-cx [# [empty] #]]
  [in-code [# [$count null] #]]
  [out-text [# 1 #]]
 ]
 [case id=program-sap-null-05-first level=core
  [tags sap null-totality collection grounded]
  [in-cx [# [empty] #]]
  [in-code [# [$first null] #]]
  [out-text [# null #]]
 ]

 [# ── §10.5.7 structured concurrency — RAII over handles + cancel-revokes-caps
       (Stage C Phase C5, D011). The single-threaded lazy-future substrate keeps
       these deterministic. NOTE: an `[err]`-pattern attr value carrying a colon
       (`cx-err:CXER0260`) MUST be quoted in a `[case]` pattern so it parses as a
       value rather than a stray `:` token (same quote convention as D008). ── #]
 [case id=program-sap-cancel-01-checkcancel-after-cancel level=core gate=enforced
  [tags sap concurrency cancel CXER0260 precedence]
  [in-cx [# [empty] #]]
  [in-code [#
[?let [= $f [?async [?check-cancel]]]
  [= $_ [?cancel $f]]
  [?match [?await $f]
    [case [err @code='cx-err:CXER0260'] [cancelled]]
    [else [other]]]]
#]]
  [out-text [# [cancelled] #]]
 ]

 [# §10.5.7.1 RAII over handles — an [?async] future handle satisfies the
    [?with-open] closeable contract; closing it cancels-and-joins. A completed
    body's value is preserved; the close is a clean exit edge. #]
 [case id=program-sap-raii-01-with-open-future level=core gate=enforced
  [tags sap concurrency raii with-open future]
  [in-cx [# [empty] #]]
  [in-code [#
[?with-open [?async [+ 21 21]] $f [?await $f]]
#]]
  [out-text [# 42 #]]
 ]

 [# §10.5.7.1 RAII over handles — a [?worker] handle satisfies the closeable
    contract; [?with-open] closes (cancels-and-joins) it on scope exit. #]
 [case id=program-sap-raii-02-with-open-worker level=core gate=enforced
  [tags sap concurrency raii with-open worker]
  [in-cx [# [empty] #]]
  [in-code [#
[?with-open [?worker name="w" body=[+ 2 3]] $w [?wait-for [worker $w]]]
#]]
  [out-text [# 5 #]]
 ]

 [# §10.5.7.2 cancellation revokes capabilities — once a task is cancelled, its
    capability set is narrowed to EMPTY for the remainder of the task. A raw
    cap-gated effect ([$env:var], cap `env`) reached with NO intervening
    cancellation point hits the revoked-cap backstop (CXER0271) even though the
    host granted the capability. (The runner grants in full; the revocation is
    in-program, proving the §6.5.1 effect system is the cancellation-safety
    substrate.) #]
 [case id=program-sap-revoke-01-cap-revoked-after-cancel level=core gate=enforced
  [tags sap concurrency cancel revoke CXER0271 capability]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?let [= $f [?async [$env:var 'HOME']]]
  [= $_ [?cancel $f]]
  [?match [?await $f]
    [case [err @code='cx-err:CXER0271'] [revoked]]
    [case [err @code='cx-err:CXER0260'] [cancelled]]
    [else [other]]]]
#]]
  [out-text [# [revoked] #]]
 ]

 [# §10.5.7.2 precedence — cancellation is checked BEFORE the capability at every
    cancellation point: a cancelled task that hits a cancellation point ([?await]
    on the cancelled future) reports the meaningful CXER0260, not CXER0271. #]
 [case id=program-sap-revoke-02-cancel-before-cap-precedence level=core gate=enforced
  [tags sap concurrency cancel revoke CXER0260 precedence]
  [in-cx [# [empty] #]]
  [in-code [#
[?let [= $f [?async [?sleep 10ms]]]
  [= $_ [?cancel $f]]
  [?match [?await $f]
    [case [err @code='cx-err:CXER0260'] [cancelled]]
    [case [err @code='cx-err:CXER0271'] [revoked]]
    [else [other]]]]
#]]
  [out-text [# [cancelled] #]]
 ]

