 [case id=program-for-group-010-m5-revenue-by-region level=core
  [tags for group-by key group aggregates stream-2 L94 m5]
  [meta [#
note: the ruled M5 skeleton (planar_algebra.md worked example) — the
note: full gamma binding set: dollar-key = partition key, dollar-count,
note: dollar-group = one [item …] per grouped frame carrying generator
note: and let binder values as named children, so aggregates navigate
note: group/NAME and atomize. First-appearance group order pinned.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $orders [orders
  [order region=east [line qty=2 price=10] [line qty=1 price=5]]
  [order region=west [line qty=3 price=4]]
  [order region=east [line qty=1 price=100]]]]
  [?for [in $o $orders/order] [in $l $o/line]
    [= $r [* $l@qty $l@price]]
    [group-by $o@region]
    [yield [row region=$key revenue=[$sum $group/r] n=$count]]]]
#]]
  [out-text [#
[row region=east revenue=125 n=3]
[row region=west revenue=12 n=1]
#]]
 ]

 [case id=program-for-group-011-top-sku level=core
  [tags for group-by order-by limit aggregates stream-2 L94 m5 barrier-composition]
  [meta [#
note: the second spec-handoff skeleton — gamma THEN tau over a group
note: aggregate THEN lambda. Pins the frame-set barrier pipeline: the
note: order-by operates ACROSS groups (the per-frame engine could
note: never order after a group-by).
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $orders [orders
  [order [line sku=aa qty=2 price=10] [line sku=bb qty=1 price=5]]
  [order [line sku=bb qty=3 price=40] [line sku=aa qty=1 price=7]]]]
  [?for [in $o $orders/order] [in $l $o/line]
    [= $rev [* $l@qty $l@price]]
    [group-by $l@sku]
    [order-by [$sum $group/rev] desc]
    [limit 1]
    [yield [top sku=$key revenue=[$sum $group/rev]]]]]
#]]
  [out-text [#
[top sku=bb revenue=125]
#]]
 ]

