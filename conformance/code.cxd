#]]
 ]

 [case id=program-cxpath-single-match-seq-004-count-predicate level=core
  [tags cxpath count node-set single-match predicate]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $d [order [item q=2] [item q=3] [item q=5]]] [$count $d/item[= $_@q 3]]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=program-cxpath-single-match-seq-005-count-no-match level=core
  [tags cxpath count node-set descendant empty]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $d [doc [rect w=3]]] [$count $d//missing]]
#]]
  [out-text [#
0
#]]
 ]

 [case id=program-cxpath-single-match-seq-006-render level=core
  [tags cxpath node-set single-match descendant render]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $d [doc [rect w=3]]] $d//rect]
#]]
  [out-text [#
[rect w=3]
#]]
 ]

 [case id=program-cxpath-single-match-seq-007-rebind-count level=core
  [tags cxpath count node-set single-match rebind]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $d [doc [rect w=3]]] [?let [= $r $d//rect] [$count $r]]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=program-field-read-uniform-001-scalar-value level=core
  [tags cxpath field-read unwrap scalar]
  [; §6.2 — the terminal labeled-field unwrap: [result [value 42]] reads 42
     (the simplest-adequate field model; reading a field returns its content). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $r [result [value 42]]] $r/value]
#]]
  [out-text [#
42
#]]
 ]

 [case id=program-field-read-uniform-002-element-value level=core
  [tags cxpath field-read unwrap element]
  [; §6.2 (owner ruling 2026-07-23, #584) — the field model is UNIFORM over
     content kinds: a field holding one element reads as that element (the
     platform's $response/body / $r/next-generator idiom). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $b [box [life [?attr 'opp' 'a'] [evidence [id 'e1'] [kind 'cro'] [val 42]]]]]
  $b/life]
#]]
  [out-text [#
[evidence [id 'e1'] [kind 'cro'] [val 42]]
#]]
 ]

 [case id=program-field-read-composition-003-count-is-content-arity level=core
  [tags cxpath field-read count node-set descendant wildcard]
  [; §6.2 (owner ruling 2026-07-23, #584 — closed by design) — count over a
     field READ aggregates the CONTENT (the inner element's arity, 3 here);
     MATCH-counting uses the node-set forms, which never unwrap: the
     descendant axis (//life = 1), a wildcard read over the parent (/* = 1),
     or $filter over the read. A fold accumulating element-valued records
     counts matches, not field contents. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $b [box [life [?attr 'opp' 'a'] [evidence [id 'e1'] [kind 'cro'] [val 42]]]]]
  [?str '{[$count $b/life]}|{[$count $b//life]}|{[$count $b/*]}|{[$count [$filter $b/life [?fn ($l) true]]]}']]
#]]
  [out-text [#
'3|1|1|1'
#]]
 ]

 [case id=program-field-read-composition-004-arity-rows level=core
  [tags cxpath field-read count]
  [; §6.2 (#584) — the arity rows of the composition table: a two-item
     field counts its 2 contents, an empty field counts 0, and a scalar
     chain read atomizes ($x/life/a → 1). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [box [life [a 1] [b 2]]]]
[?let [= $e [box [life]]]
  [?str '{[$count $x/life]}|{[$count $e/life]}|{$x/life/a}']]]
#]]
  [out-text [#
'2|0|1'
#]]
 ]

 [case id=program-construction-err-001-computed-child-propagates level=core
  [tags construction err propagation operand-consuming]
  [; §6.4.1 (#853, owner ruling 2026-08-18 "2a") — construction is
     OPERAND-CONSUMING: a positional child that EVALUATES to an [err …]
     propagates instead of being adopted as a child. Before this, the
     refusal became a node in the tree — it no longer short-circuited and
     [?match … [case [err …] …]] could not see it, which shipped as a 200 OK
     with <err code="…"> serialized into a page. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $seq [?for [in $x ("a")] [yield $x]]]
  [bar [$concat $seq "-suffix"]]]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='concat: an argument does not satisfy the builtin signature (scalar kind/type — code.md §6.5)']
#]]
 ]

 [case id=program-construction-err-002-propagation-is-transitive level=core
  [tags construction err propagation nested transitive]
  [; §6.4.1 — propagation is TRANSITIVE: the inner construction propagates,
     and the enclosing one propagates in turn, so a refusal cannot come to
     rest inside a document at any depth. This is the shape #853 actually
     reported (…</section><err …></err></div>…) — a containment rule that
     stopped at one level would still have buried it. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $seq [?for [in $x ("a")] [yield $x]]]
  [section [div [$concat $seq "-x"]]]]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='concat: an argument does not satisfy the builtin signature (scalar kind/type — code.md §6.5)']
#]]
 ]

 [case id=program-construction-err-003-literal-err-stays-data level=core
  [tags construction err literal data position]
  [; §6.4.1 — THE DISCRIMINATOR IS POSITION, NOT VALUE. A SOURCE-LITERAL
     [err …] element is data and stays data, so err-shaped documents remain
     expressible. A rule keyed on "is this value an err" would pass case 001
     and silently make this case impossible. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[foo [err code='x' message='y']]
#]]
  [out-text [#
[foo [err code=x message=y]]
#]]
 ]

 [case id=program-construction-err-004-captured-err-propagates level=core
  [tags construction err binding captured cost]
  [; §6.4.1 "the cost of this rule, stated" — a BINDING READ is an operand,
     so embedding a CAPTURED err as data no longer works: this propagates
     rather than building [report [err …]]. Pinned deliberately: the cost is
     part of the ruled semantics, not an accident, and a future change that
     makes this contain again is a semantics reversal, not a fix. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $e [err code='c' message='m']] [report $e]]
#]]
  [out-text [#
[err code=c message=m]
#]]
 ]

 [case id=program-construction-err-005-rebuild-from-parts level=core
  [tags construction err path-navigation workaround]
  [; §6.4.1 — the documented escape: to EMBED a refusal as data, build a
     fresh element from its parts. Path navigation does not propagate
     (§9.2), so @code / @message read cleanly off the captured err. This is
     the spelling the spec text points at, so it is pinned here. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $e [err code='c' message='m']] [report [code $e@code] [message $e@message]]]
#]]
  [out-text [#
[report [code 'c'] [message 'm']]
#]]
 ]

 [case id=program-construction-err-006-sequence-collects-outcomes level=core
  [tags construction err sequence collect outcomes]
  [; §6.4.1 — the collect-outcomes escape, and the contrast that makes it
     necessary: a paren SEQUENCE is not element construction and does not
     propagate, so refusals survive as members. This is what the resilience
     / scheduler cases use to assert "which call was rejected" and "fired
     exactly once" (program-cb-004, sched-017). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $e [err code='c' message='m']] ($e, 'kept', [box $e@code])]
#]]
  [out-text [#
([err code=c message=m], kept, [box 'c'])
#]]
 ]

 [case id=program-builtin-present-001-shape-table level=core
  [tags builtin present absence sequence element]
  [; §6.5 `present(value)` (#854, #849) — the presence predicate does NOT
     look inside: a CHILDLESS element is present, "" is present, a
     non-empty sequence is present. False ONLY for the absence channel
     (§9.1.2.1 (1)): the empty sequence (). This is the "some vs none"
     test of §9.1.2.3 in builtin form. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?str '{[$present ()]}|{[$present [foo]]}|{[$present [foo [kid]]]}|{[$present ""]}|{[$present ("a","b")]}|{[$present ("a")]}']
#]]
  [out-text [#
'false|true|true|true|true|true'
#]]
 ]

 [case id=program-builtin-present-002-not-exists-content-arity level=core
  [tags builtin present exists count content-arity]
  [; §6.5 — `present` and `exists` answer DIFFERENT questions and both
     answers are correct. Over a childless element `exists`/`count` report
     its CONTENT arity (0 / false — §6.2 #584, closed by design and
     UNCHANGED by this addition); `present` reports that the element is
     there. This case is the guard that #584 still stands: if a future
     change makes `exists` true here, that ruling has been reversed. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?str 'present={[$present [input]]}|exists={[$exists [input]]}|count={[$count [input]]}|empty={[$empty [input]]}']
#]]
  [out-text [#
'present=true|exists=false|count=0|empty=true'
#]]
 ]

 [case id=program-builtin-present-003-leaf-match-vs-no-match level=core
  [tags builtin present cxpath node-set first-child]
  [; §6.5 (#854, the reported regression) — the two cases `exists` cannot
     tell apart. `[$first $h/h/*]` over `[h [input] …]` yields the LEAF
     element `[input]`: a real match. `$h/nope` matched nothing: absence.
     `exists` answers false for BOTH (a leaf has no children), so every
     "did this step match" test written with it is wrong on the first row.
     `present` separates them. The last pair is the field-read path of the
     same distinction: `$h/h/input` yields the CHILDLESS ELEMENT itself
     (`[$name …]` is 'input'), so it is present even though its content
     arity is 0. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $h [box [h [input] [sel [opt]]]]]
  [?str 'match-present={[$present [$first $h/h/*]]}|match-exists={[$exists [$first $h/h/*]]}|nomatch-present={[$present $h/nope]}|nomatch-exists={[$exists $h/nope]}|field-present={[$present $h/h/input]}|field-count={[$count $h/h/input]}']]
#]]
  [out-text [#
'match-present=true|match-exists=false|nomatch-present=false|nomatch-exists=false|field-present=true|field-count=0'
#]]
 ]

 [case id=program-builtin-present-004-null-is-present level=core
  [tags builtin present null absence]
  [; §9.1.2.1 (2) — a `null` scalar is a PRESENT value, never absence, so
     `present` is true for it. The no-conflation guard in the other
     direction: absence is the empty channel, never `null`. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?str 'null={[$present null]}|absent={[$present ()]}|not-absent={[not [$present ()]]}']
#]]
  [out-text [#
'null=true|absent=false|not-absent=true'
#]]
 ]

 [case id=program-builtin-present-005-not-a-container-test level=core
  [tags builtin present container contents]
  [; §6.5 (#849) — `present` is a PRESENCE test, not a container/contents
     discriminator: an element with two children and a two-member sequence
     are both simply present. The discriminating spelling stays the
     documented `[= [?else [$name v] ""] ""]` (an element has a name; a
     multi-item sequence refuses it). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?str 'elem={[$present [c [a] [b]]]}|seq={[$present ([a],[b])]}|elem-named={[= [?else [$name [c [a] [b]]] ""] ""]}|seq-named={[= [?else [$name ([a],[b])] ""] ""]}']
#]]
  [out-text [#
'elem=true|seq=true|elem-named=false|seq-named=true'
#]]
 ]

 [case id=program-mapnode-nav-001-parsed-map-field-reads level=core
  [tags cxpath map parse roundtrip field-read]
  [; #618 — a PARSED map (cx.MapNode) reads its keys exactly like the
     runtime __cx_map__ twin: /key and .key both yield the value. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $p [$cx:parse "{label: 'sum-2', count: 2}"]]
  [?str '{[?else $p/count 0]}|{[?else $p.count 0]}|{$p/label}']]
#]]
  [out-text [#
'2|2|sum-2'
#]]
 ]

 [case id=program-mapnode-nav-002-equal-navigates-equal level=core
  [tags cxpath map parse equal]
  [; #618 — the #587 invariant extended to maps: two $cx:equal maps (one
     runtime-built, one parsed) navigate identically. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $m {label: 'x', count: 2}]
      [= $p [$cx:parse [$cx:serialize $m]]]
  [?str '{[$cx:equal $m $p]}|{[= [?else $m/count 0] [?else $p/count 0]]}']]
#]]
  [out-text [#
'true|true'
#]]
 ]

 [case id=program-mapnode-nav-003-nested-and-descendant level=core
  [tags cxpath map parse descendant]
  [; #618 — nested parsed maps chain via the map-key DOT form ($p.a.b),
     exactly as runtime maps do ($m/a/b is 0 on BOTH lanes — slash-chain
     over maps is not the map-read form; parity, not new semantics), and
     the descendant axis walks THROUGH a parsed map value into elements
     it holds. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $p [$cx:parse "{a: {b: 7}}"]]
      [= $w [$cx:parse "[w {k: [item n=1]}]"]]
  [?str '{[?else $p.a.b 0]}|{[$count $w//item]}']]
#]]
  [out-text [#
'7|1'
#]]
 ]

 [case id=program-descendant-seq-roundtrip-001-equal-navigates-equal level=core
  [tags cxpath descendant sequence roundtrip serialize parse equal]
  [; #587 — two $cx:equal values MUST navigate identically. A sequence-valued
     element body built by the runtime ([?for/yield] → the seq marker) and its
     serialize→parse twin (a parsed paren-sequence body) are equal; the //
     descendant axis walks THROUGH the sequence in both lanes. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let
  [= $seq [w [?for [in $x (1,2,3)] [yield [item n=$x]]]]]
  [= $rt [$cx:parse [$cx:serialize $seq]]]
  [?str 'equal={[$cx:equal $seq $rt]} inmem={[$count $seq//item]} rt={[$count $rt//item]}']]
#]]
  [out-text [#
'equal=true inmem=3 rt=3'
#]]
 ]

 [case id=program-descendant-seq-roundtrip-002-double-roundtrip level=core
  [tags cxpath descendant sequence roundtrip serialize parse]
  [; #587 — axis fidelity survives a SECOND canonical round-trip: parse of
     the parsed lane's own canonical text navigates identically too. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let
  [= $seq [w [?for [in $x (1,2,3)] [yield [item n=$x]]]]]
  [= $rt [$cx:parse [$cx:serialize $seq]]]
  [= $rt2 [$cx:parse [$cx:serialize $rt]]]
  [?str '{[$count $rt2//item]}={[$cx:equal $rt $rt2]}']]
#]]
  [out-text [#
'3=true'
#]]
 ]

 [case id=program-descendant-seq-roundtrip-003-child-axis-unchanged level=core
  [tags cxpath child sequence roundtrip]
  [; #587 pinned 0|0 here (envelope opaque to child in both lanes). R-A1
     migration (2026-08-25): [?for] in element content contributes one
     REAL child per yield, so this program never builds an envelope — the
     child axis sees 3, and the reparsed lane agrees (the #587/#847
     equal-values-navigate-identically invariant HOLDS, at the new value).
     The parsed paren-seq envelope's child-opacity stays pinned by
     program-pvmatrix-036. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let
  [= $seq [w [?for [in $x (1,2,3)] [yield [item n=$x]]]]]
  [= $rt [$cx:parse [$cx:serialize $seq]]]
  [?str '{[$count $seq/item]}|{[$count $rt/item]}']]
#]]
  [out-text [#
'3|3'
#]]
 ]

 [case id=program-descendant-seq-roundtrip-004-doc-query-lane level=core
  [tags cxpath descendant sequence document path-expr]
  [; #587 — the same fidelity for the DOCUMENT path engine: a parsed doc
     whose element body is a paren-sequence yields its items to //. ]
  [in-cx [#
[w ([item n=1], [item n=2], [item n=3])]
#]]
  [in-code [#
[$count //item]
#]]
  [out-text [#
3
#]]
 ]

 # ── N-ary prefix arithmetic + logical/comparison operators (code.md §6.5) ──
 # CX is Lisp-1 homoiconic: + - * / and and/or fold over the FULL operand
 # list; comparisons are binary. Scalar arithmetic (+ - * /) is STRICT and
 # type-strict, and is DISTINCT from sequence aggregation ($sum/$max/$min/$avg).

 [case id=program-arith-add-unary level=core
  [tags arithmetic operator n-ary]
  [in-cx [#
[empty]
#]]
  [in-code [#
[+ 5]
#]]
  [out-text [#
5
#]]
 ]

 [case id=program-arith-add-binary level=core
  [tags arithmetic operator n-ary]
  [in-cx [#
[empty]
#]]
  [in-code [#
[+ 2 3]
#]]
  [out-text [#
5
#]]
 ]

 [case id=program-arith-add-nary-5 level=core
  [tags arithmetic operator n-ary]
  [in-cx [#
[empty]
#]]
  [in-code [#
[+ 1 2 3 4 5]
#]]
  [out-text [#
15
#]]
 ]

