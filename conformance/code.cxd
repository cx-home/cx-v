#]]
  [out-err [#
cx-err:CXER0109
#]]
 ]

 [case id=program-attr-ascription-006-malformed-err level=core
  [tags element attribute ascription error CXER0109 issue-466]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e n::int=abc]] $x]
#]]
  [out-err [#
cx-err:CXER0109
#]]
 ]

 [case id=program-attr-ascription-007-array-type-err level=core
  [tags element attribute ascription array-type error CXER0100 issue-466]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e n::int[]=1]] $x]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-attr-ascription-008-atom-typed-read level=core
  [tags element attribute ascription atom cxpath issue-466]
  [; The @n read produces the TYPED value (cxdm §2.4): an atom, equal to
     :busy and not to the string "busy" (no atom↔string coercion, §5.1). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e n::atom=busy]] [= $x@n :busy]]
#]]
  [out-text [#
true
#]]
 ]

 [case id=program-attr-ascription-009-decimal-hex-err level=core
  [tags element attribute ascription decimal hex error CXER0109 issue-466]
  [; OWNER RULING (#466 item 3): hex under ::decimal REJECTS loudly
     (CXER0109) — decimal is a base-10 value type; hex there is a
     mistake (M-ERR-2 fail-loud). Supersedes the former verbatim pin;
     same outcome in the data reading (extended.cxd 016g). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e n::decimal=0x2a]] $x]
#]]
  [out-err [#
cx-err:CXER0109
#]]
 ]

 [case id=program-attr-ascription-010-element-directive level=core
  [tags element attribute ascription computed-name issue-466]
  [; The [?element] body grammar is identical to the static element body
     (grammar [127s]), so the typed attribute parses there too. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?element "svc" port::u16=8080 [child 1]]
#]]
  [out-text [#
[svc port::u16=8080 [child 1]]
#]]
 ]

