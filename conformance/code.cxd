#]]
  [in-code [#
[?for [in $x (1, 2, 3, 4, 5, 6)] [group-by [$mod $x 2]]
  [yield [g key=$key count=$count sum=[$sum $group/x] max=[$max $group/x] min=[$min $group/x] avg=[$avg $group/x] distinct=[$count [$distinct $group/x]]]]]
