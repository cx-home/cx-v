[ignored]
#]]
  [in-code [#
[?let [= $s ([a x=1], [a x=2])] [$count $s[= $_@x 2]]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=program-pvmatrix-005-element-predicate-direct level=core
  [tags cxpath pvmatrix predicate element]
  [; R-A3: a predicate on any non-collection focus binds $_ to the focus. ]
