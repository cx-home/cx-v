note: code.md section 7.4 — [lazy] MUST NOT be combined with [order-by]
note: or [group-by]; materialising barriers contradict lazy evaluation.
note: Parse-time refusal, previously spec'd but never pinned.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?for [in $x (3, 1)] [lazy] [order-by $x] [yield $x]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

