 [case id=program-pvmatrix-026-construct-seq-refused level=core
  [tags pvmatrix construction sequence refusal splice]
  [; R-A1 (#847-1a, #961): a non-empty sequence VALUE never becomes element
     content — refused loudly at construction, naming [?splice]. Was a
     silent grouping envelope answering /violation with 0. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $vs ([violation kind=a], [violation kind=b])] [violations $vs]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-pvmatrix-027-construct-splice-adopts level=core
  [tags pvmatrix construction sequence splice child]
  [; The sound idiom: [?splice] adopts the members as children and the
     child axis sees them — the #961 program, written correctly, answers 2. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $vs ([violation kind=a], [violation kind=b])]
 [?let [= $bag [violations [?splice $vs]]]
  [$count $bag/violation]]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=program-pvmatrix-028-construct-for-contributes level=core
  [tags pvmatrix construction for yield contribution]
  [; R-A1: [?for] in a multi-sibling slot contributes one sibling per
     yield — the directive's defined contribution, not a value being
     auto-spliced. The child axis sees the yields. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $t [c [?for [in $x ('A', 'B')] [yield [x $x]]]]] [$count $t/x]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=program-pvmatrix-029-construct-absence-contributes-nothing level=core
  [tags pvmatrix construction absence null-totality]
  [; R-A1: absence contributes no child (was adopted as a visible empty
     sequence child — [$count …/*] answered 1). ]
