#]]
 ]

 [case id=program-render-sequence-literal-in-element-body level=core
  [tags render sequence-literal mixed-content regression-2026-05-22 parsed-lane]
  [; R-A1 migration: PIVOTED TO THE PARSED LANE (2026-08-25). The pin is
     that a sequence sitting in an element body RENDERS as a paren sequence
     — no __cx_seq__ marker leak in the result image. R-A1 (#847-1a) refuses
     the runtime construction [item ('a', 'b', 'c')] at eval, so that value
     is no longer constructible by evaluation; the PARSED shape still is, so
     the same document now arrives via [$cx:parse] of the identical source
     text and the original render assertion is kept verbatim against it. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[$cx:parse "[item ('a', 'b', 'c')]"]
#]]
  [out-text [#
[item (a, b, c)]
#]]
 ]

