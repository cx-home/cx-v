            [email active=false alice@old.com]]]
  [user [name Bob]
    [emails [email active=true b@x.com]]]]
#]]
  [in-code [#
[?for [user $u]
      [in $e $u/emails/email]
      [where [= $e@active true]]
      [yield [link [name $u/name] [addr $e]]]]
#]]
