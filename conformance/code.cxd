 [; #438 (2026-07-14): ONE canonical spelling for an empty item inside a
    rendered sequence. The program reading preserves sequence rank (cxdm
    §2 MODE FORK SEQ-NEST), so a sequence may legitimately hold empty
    items — and each renders as the literal empty sequence, never as a
    bare hole between commas. Pre-fix the multi-value/absence wrapper
    (the empty result an empty comprehension or a no-branch conditional
    produces) rendered as the EMPTY STRING in item position while a
    literal empty-sequence item rendered as its paren form: two empties,
    two spellings, and the emitted text did not re-parse as CX
    (bijectivity, canonical.md §1). Post-fix every rendered collection
    item uses the paren sequence form — the same convention element-body
    position has used since program-conc-018. ]

 [case id=program-render-seq-empty-item-001-one-spelling level=core
  [tags render sequence empty absence bijective issue-438]
  [in-cx [#
[empty]
#]]
  [in-code [#
([?if false [then 1] [else ()]],
 [?for [in $x ()] [yield $x]],
 [?if true [then ()] [else 1]],
 ())
#]]
  [out-text [#
((), (), (), ())
#]]
 ]

 [case id=program-render-seq-empty-item-002-nested level=core
  [tags render sequence empty absence nested issue-438]
  [in-cx [#
[empty]
#]]
  [in-code [#
(1, ([?for [in $x ()] [yield $x]], ()))
#]]
  [out-text [#
(1, ((), ()))
#]]
 ]

 [case id=program-render-seq-empty-item-003-single level=core
  [tags render sequence empty absence single issue-438]
  [; A 1-item sequence whose item is a COMPUTED empty spells exactly like
     the literal — pre-fix this printed a bare paren pair that was really
     an open paren, a hole, and a close paren. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
([?for [in $x ()] [yield $x]])
#]]
  [out-text [#
(())
#]]
 ]

 [; ── #466 program-reading attribute ascription `name::T=value` ──────────
    The PROGRAM element literal shares the D3 typed-attribute production
    with the DATA reading (grammar [55]; lexicon [L50] — the annotation is
    valid in attribute position and OVERRIDES §9 auto-typing). Pre-#466
    every case below was a parse error ("unexpected token '::' in
    expression position"). Coercion is checked (M-ERR-2/D-H): malformed →
    CXER0109; array annotation → CXER0100 (scalar-only attributes, D2). ]

 [case id=program-attr-ascription-001-sized-u16 level=core
  [tags element attribute ascription sized-int issue-466]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e n::u16=8080]] $x]
#]]
  [out-text [#
[e n::u16=8080]
#]]
 ]

 [case id=program-attr-ascription-002-int-hex-coerce level=core
  [tags element attribute ascription int hex issue-466]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e n::int=0x2a]] $x]
#]]
  [out-text [#
[e n=42]
#]]
 ]

 [case id=program-attr-ascription-003-bytes-src-verbatim level=core
  [tags element attribute ascription bytes hex issue-466]
  [; The ascription coerces the ORIGINAL token (ProgramLiteral.src), so
     the hex spelling survives — the attr-position dual of #457. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [e h::bytes=0x3a7bd3e2]] $x]
#]]
  [out-text [#
[e h::bytes=0x3a7bd3e2]
#]]
 ]

 [case id=program-attr-ascription-004-computed-value level=core
  [tags element attribute ascription binding issue-466]
  [; A computed ($-bound) value coerces under the ascription too — a
     program-only surface with no data-reading counterpart. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $p 8080] [e n::u16=$p]]
#]]
  [out-text [#
[e n::u16=8080]
#]]
 ]

 [case id=program-attr-ascription-005-computed-range-err level=core
  [tags element attribute ascription error CXER0109 issue-466]
  [in-cx [#
[empty]
#]]
  [in-code [#
