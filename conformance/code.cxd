 [# program-sap-pipe-06: a tap runs its side effect and the value passes through.
    `$fields` is a NAMED param ([153c] `$fields={}`), so the fields map is
    supplied as the named arg `fields={v: _}` — the threaded value is bound
    to `_` (so `{v: _}` = `{v: 6}`); no append (the stage already places the
    value via `_`). #]
 [case id=program-sap-pipe-06-tap-passes level=core
  [tags sap pipe tap observe]
  [in-cx [# [empty] #]]
  [in-code [#
[?lib 'cx-stdlib/log']
[?def add1 ($x) [+ $x 1]]
[?pipe 5 add1 [tap [$log:info 'saw' fields={v: _}]] add1]
#]]
  [out-text [# 7 #]]
 ]
 [case id=program-sap-pipe-07-tap-error-survives level=core
  [tags sap pipe tap never-derail]
  [in-cx [# [empty] #]]
  [in-code [#
[?def add1 ($x) [+ $x 1]]
[?def boom ($x) [/ $x 0]]
[?pipe 5 add1 [tap [$boom _]] add1]
#]]
  [out-text [# 7 #]]
 ]
 [case id=program-sap-pipe-08-skip-on-err level=core
  [tags sap pipe short-circuit railway]
  [in-cx [# [empty] #]]
  [in-code [#
[?def boom ($x) [/ $x 0]]
[?def add1 ($x) [+ $x 1]]
[?pipe 5 boom add1]
#]]
  [out-err [#
cx-err:CXER0101
#]]
 ]
 [case id=program-sap-pipe-09-tap-skipped-after-err level=core
  [tags sap pipe tap skip-after-err]
  [in-cx [# [empty] #]]
  [in-code [#
