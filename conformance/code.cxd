 [case id=cmd-001-command-effects-declared-cap-allowed level=core grant='read'
  [tags def command effects narrowing stream-6 678]
  [meta [#
note: L109/L110 (commands_effects, RULED (a) 2026-08-05) — a [?def] with
note: an [effects] clause is a command; the declared set narrows the
note: active capability set for the body. A declared capability that the
note: caller granted stays usable.
#]]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?lib 'cx-stdlib/path' as=path]
[?def canon impure [effects [read]] ($p) [$path:canonical $p]]
[$canon '/']
#]]
  [out-text [#
'/'
#]]
 ]

 [case id=cmd-002-command-effects-undeclared-cap-denied level=core grant='read random'
  [tags def command effects narrowing denial CXER0271 stream-6 678]
  [meta [#
note: THE L110 enforcement fixture — checked AND enforced, never
note: advisory. The caller grants read+random, but the command declares
note: only [effects [read]]: the body reaching a random effect point is
note: a capability denial AT the effect point, exactly the
note: [?with-caps]-like narrowing the ruling names.
#]]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?lib 'cx-stdlib/uuid' as=uuid]
[?def stamp impure [effects [read]] () [$uuid:v4]]
[$stamp]
#]]
  [out-err [#
cx-err:CXER0271
#]]
 ]

 [case id=cmd-003-pure-nonempty-effects-contradiction level=core
  [tags def command effects purity static-contradiction CXER0239 stream-6 678]
  [meta [#
note: L109 — pure + non-empty [effects] is a STATIC contradiction by the
note: effect-totality theorem (code.md 6.5.1): a checker-accepted pure
note: body provably reaches no effect point, so a non-empty declaration
note: is unsatisfiable. E_COMMAND_CONTRACT, cx-err:CXER0239.
#]]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?def f pure [effects [read]] ($x) $x]
[$f 1]
#]]
  [out-err [#
cx-err:CXER0239
#]]
 ]

 [case id=cmd-004-pure-empty-effects-legal level=core
  [tags def command effects purity empty-set stream-6 678]
  [meta [#
note: the empty [effects] is the one form compatible with pure — a
note: declared-no-gated-effect command. Still a command (the
note: discriminator is clause PRESENCE), still callable.
#]]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?def double-cmd pure [effects] ($x) [* $x 2]]
[$double-cmd 2]
#]]
  [out-text [#
4
#]]
 ]

 [case id=cmd-005-effects-unknown-capability-fail-closed level=core
  [tags def command effects unknown-cap fail-closed CXER0274 stream-6 678 713]
  [meta [#
note: an unknown capability name in [effects] gets the SAME fail-closed
note: refusal as a typo d host grant (E_CAP_UNKNOWN, cx-err:CXER0274,
note: the #713/L114 posture) — one code wherever a capability name is
note: spelled. Never a silent no-op declaration.
#]]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?def f impure [effects [bogus]] () 1]
[$f]
#]]
  [out-err [#
cx-err:CXER0274
#]]
 ]

 [case id=cmd-006-compensates-unknown-target level=core
