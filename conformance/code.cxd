 [; ── Table sequence view (D22, #404) — code.md §6.6 D22 / §7 "Table
    sources". A :table-bearing element atomizes to its row sequence
    (ordered maps, typed cells) for [?for] sources, slices, and the
    sequence built-ins; CXPath does NOT navigate into rows. ;]

 [case id=program-table-d22-001-forcomp-typed-filter level=core
  [tags table d22 for comprehension where typed]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?for [in $u $input//users] [in $r $u] [where [> $r.age 26]] [yield $r.name]]
#]]
  [out-text [#
'alice'
#]]
 ]

 [case id=program-table-d22-002-col-label-slice level=core
  [tags table d22 slice column-label]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[*, "name"]]
#]]
  [out-text [#
('alice', 'bob')
#]]
 ]

 [case id=program-table-d22-003-cell-typed level=core
  [tags table d22 slice column-label cell]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[1, "age"]]
#]]
  [out-text [#
30
#]]
 ]

 [case id=program-table-d22-004-label-range level=core
  [tags table d22 slice column-label range]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[1:2, "name":"age"]]
#]]
  [out-text [#
(('alice', 30), ('bob', 25))
#]]
 ]

 [case id=program-table-d22-005-row-full-axis level=core
  [tags table d22 slice row map]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] [out [a $t[2, *]] [b $t[2]]]]
#]]
  [out-text [#
[out [a {name: 'bob', age: 25}] [b {name: 'bob', age: 25}]]
#]]
 ]

 [case id=program-table-d22-006-seq-builtins level=core
  [tags table d22 count first last empty]
  [in-cx [#
[data
 [users [table[name::string age::int]]
  alice 30
  bob 25
 ]
 [log [table[id::int]]
 ]]
#]]
  [in-code [#
[?let [= $t [$first $input//users]]
 [?let [= $l [$first $input//log]]
  [out [n [$count $t]] [f [$first $t]] [z [$last $t]]
       [ln [$count $l]] [le [$empty $l]]
       [liter [?for [in $r $l] [yield $r]]]]]]
#]]
  [out-text [#
[out [n 2] [f {name: 'alice', age: 30}] [z {name: 'bob', age: 25}] [ln 0] [le true] [liter ()]]
#]]
 ]

 [case id=program-table-d22-007-cxpath-unchanged level=core
  [tags table d22 cxpath negative]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] [out [a $t//row] [b [$count $t/*]]]]
#]]
  [out-text [#
[out [a ()] [b 0]]
#]]
 ]

 [case id=program-table-d22-008-orderby level=core
  [tags table d22 for order-by]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?for [in $u $input//users] [in $r $u] [order-by $r.age] [yield $r.name]]
#]]
  [out-text [#
'bob'
'alice'
#]]
 ]

 [case id=program-table-d22-009-null-cell-bool-guard level=core
