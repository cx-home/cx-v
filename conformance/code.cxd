 [case id=program-cxpath-011-namespace-wildcard-any-namespace level=core
  [tags cxpath namespace-wildcard nodetest]
  [in-cx [#
[doc xmlns:xhtml=http://www.w3.org/1999/xhtml xmlns:svg=http://www.w3.org/2000/svg
  [xhtml:user "Alice"]
  [svg:user "Bob"]
  [user "Charlie"]]
#]]
