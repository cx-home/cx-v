 ]


 [case id=cxtape-001-trace-document-format-round-trip level=core
  [tags debug tape cx-trace format round-trip g9 stream-14 686 D-DBG]
  [meta [#
note: the D-DBG ruled adoption's FORMAT half (debug.md §6a; corpus
note: audit G9): the tape is a versioned CX DOCUMENT — a §6a-shaped
note: [cx-trace] parses, round-trips (serialize∘parse equal), keeps a
note: stable Tier-1 address, and its step ids read positionally. The
note: COMPLETENESS invariant (all nondeterminism recorded) requires
note: the v1 RECORDER, which has no shipped surface — that half lands
note: WITH the recorder (the no-surface verdict, recorded in the
note: stream-14 ledger; the format can no longer drift meanwhile).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $tape [cx-trace version=1
  [seed clock="2026-08-14T00:00:00Z" rng=42 [env]]
  [event step=1 effect=http-get [result [response status=200]]]
  [event step=2 effect=receive [result 42]]]]
      [= $rt [$cx:parse [$cx:serialize $tape]]]
  [probe [version $tape@version]
         [steps [?for [in $e $tape/event] [yield $e@step]]]
         [round-trip [$cx:equal $tape $rt]]
         [hash-stable [$eq [$cx:hash $tape] [$cx:hash $rt]]]]]
#]]
  [out-text [#
[probe [version 1] [steps 1 2] [round-trip true] [hash-stable true]]
#]]
 ]


 [case id=program-slot-singleton-001-sequence-fills-slot level=core
  [tags cxpath map array sequence singleton slot round-trip 810 stream-14 686]
  [meta [#
note: #810 RULED (a) — a lone paren group filling a collection SLOT
note: (map value / array item) is a SEQUENCE LITERAL even without a
note: comma: a slot has no prose lane, so the body-text comma
note: disambiguator does not apply. The canonical singleton emission
note: (x) now re-parses to the singleton sequence it came from —
note: serialize∘parse identity + cx:hash totality hold; the value
note: stays DISTINCT from its item (('x') never collapses to 'x').
note: The spec already permitted this ([53] BodyItem admits
note: CollectionLiteral; [L86] MapEntry value is a BodyItem; cxdm
note: preserves sequence-as-item inside containers) — the parser was
note: below spec.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $m {req: ('x')}]
      [= $rt [$cx:parse [$cx:serialize $m]]]
      [= $mi {req: (7)}]
      [= $nested {a: {b: ('x')}}]
      [= $arr [((2)), 5]]
  [probe [faithful [$cx:equal $m $rt]]
         [hash-total [$exists [$cx:hash $m]]]
         [int-too [$cx:equal $mi [$cx:parse [$cx:serialize $mi]]]]
         [nested-too [$cx:equal $nested [$cx:parse [$cx:serialize $nested]]]]
         [arr-slot [$cx:equal $arr [$cx:parse [$cx:serialize $arr]]]]
         [distinct [$cx:equal [?let [= $p [$cx:parse "{req: (7)}"]] $p.req] 7]]]]
#]]
  [out-text [#
[probe [faithful true] [hash-total true] [int-too true] [nested-too true] [arr-slot true] [distinct false]]
#]]
 ]

 [case id=program-slot-singleton-002-prose-refusals-preserved level=core
  [tags cxpath map slot prose refusal 810 stream-14 686]
  [meta [#
note: the #810 fix is NARROW: mixed content in a map value stays
note: refused exactly as before (the lone group must FILL the slot);
note: prose parens in element body text keep the comma disambiguator.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?fallback [$count [$cx:parse "{k: hello (world) tail}"]] [recover-with :still-refused]]
#]]
  [out-text [#
:still-refused
#]]
 ]

 [case id=cmd-025-tier2-alpha-renaming-invariant level=core
