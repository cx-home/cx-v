[?def ship-order impure [effects] ($order-id::string) [shipped $order-id]]
[$cx:propose ship-order {order-id: 'o-9', quantity: 3} {}]
#]]
  [out-err [#
cx-err:CXER4111
#]]
 ]



 [case id=ev-let-001-sequential-binding-discriminator level=core rule=EV-LET-SEQ
  [tags let sequential discriminator witness stream-14 686 stream-22 694 EV-LET-SEQ]
  [meta [#
note: the let-vs-let* discriminator (EV-LET-SEQ: sequential — each
note: binding sees prior bindings): $y binds the INNER $x (1), never
note: the outer shadow (9) — a parallel-let would answer y=9; a
note: no-visibility let would refuse unbound.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x 9]
  [?let [= $x 1] [= $y $x]
    [pair x=$x y=$y]]]
#]]
  [out-text [#
[pair x=1 y=1]
#]]
 ]

 [case id=ev-pull-006-drop-pulls-skips-plus-yields level=core rule=EV-PULL
  [tags iterator pull drop witness stream-14 686 stream-22 694 EV-PULL]
  [meta [#
note: the per-combinator pull matrix, drop's row: [?drop 2] over a
note: mapped 5-source pulls ALL 5 (the 2 skipped are pulled to be
note: skipped + the 3 yielded) — drop documents its skip-pulls; the
note: yielded count stays 3.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $out [?drop 2 [?map (1, 2, 3, 4, 5) [using [?fn $x [?let [= $c [?test-counter name=pd op=inc]] [* $x 10]]]]]]]
  [?let [= $forced [$count $out]]
    ([?test-counter name=pd op=read], $forced)]]
#]]
  [out-text [#
(5, 3)
#]]
 ]

 [case id=ev-async-006-spawned-body-runs-exactly-once level=async
  [tags async fire-and-forget scheduling witness stream-14 686 stream-22 694 814]
  [meta [#
note: an [?async] body runs EXACTLY ONCE — the counter reads 1 after the
note: await, not 0 (never spawned) and not 2 (spawned eagerly AND re-run
note: on demand). That is the in-program-observable half of
note: EV-ASYNC-SPAWN (code.md §10.5.1).
note:
note: WHAT THIS CASE DELIBERATELY NO LONGER ASSERTS (#814). It used to
note: spawn the counter, await an UNRELATED future, and require the
note: counter to have already reached 1 — "has run by the time another
note: await completes". §10.5.1 does not promise that. It promises the
note: body runs to a terminal state BEFORE TOP-LEVEL PROGRAM RETURN, which
note: says nothing about where some other await lands relative to it. The
note: old shape therefore measured scheduler luck: green on a quiet
note: machine, red under the parallel gate's compile storm, and it
note: poisoned full-union runs on loaded machines.
note:
note: The guarantee it was reaching for is real and is now pinned where it
note: is actually observable — AFTER the program returns, in
note: eval_semantics_umbrella_test.v
note: (test_fire_and_forget_completes_before_top_level_return). A
note: conformance case compares a program's VALUE, and no program value
note: can witness what is guaranteed only once that value has been
note: produced.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $f [?async [?test-counter name=ff op=inc]]] [= $x [?await $f]] [= $seen [?test-counter name=ff op=read]] [ran value=$x times=$seen]]
#]]
  [out-text [#
[ran value=1 times=1]
#]]
 ]

 [case id=ev-park-001-mock-clock-deadline-order level=async
  [tags async sleep mock parking deadline-order witness stream-14 686 stream-22 694]
  [; R-A1 migration: envelope → spliced children (2026-08-25) ]
  [meta [#
note: mock-clock parking across CONCURRENT futures: the 100ms future
note: wakes FIRST (order counter 1), the 500ms future second (2) —
note: parked futures wake in DEADLINE order under the mock clock,
note: deterministically, regardless of spawn order.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $slow [?async [?let [= $s [?sleep 500ms mock]] [?let [= $o [?test-counter name=order op=inc]] (:slow, $o)]]]]
      [= $fast [?async [?let [= $s [?sleep 100ms mock]] [?let [= $o [?test-counter name=order op=inc]] (:fast, $o)]]]]
  [park [slow [?splice [?await $slow]]] [fast [?splice [?await $fast]]]]]
#]]
  [out-text [#
[park [slow :slow 2] [fast :fast 1]]
#]]
 ]

