 [# ── §8.2 [?match] — bind-first GROUNDED; inline scrutinee advisory. ── #]
 [case id=program-sap-match-01-catch-bindfirst level=core
  [tags sap match v1a grounded]
  [in-cx [# [empty] #]]
  [in-code [#
[?let [= $r [/ 10 0]]
  [?match $r
    [case [err $e] [recovered code=$e/@code]]
    [else $r]]]
#]]
  [out-text [# [recovered code=cx-err:CXER0101] #]]
 ]
