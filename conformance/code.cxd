#]]
 ]

 [case id=program-map-114-equality-kind-strict level=core
  [tags map equality keys kind identity issue-927]
  [title map equality is key-KIND-strict (cxdm §5.3/§2.6) — an int key 1 and a string key '1' are different key sets]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $z 0] ([= {1: 'x'} {'1': 'x'}], [= {true: 1} {'true': 1}], [= {7: a} {7: a}])]
#]]
  [out-text [#
(false, false, true)
#]]
 ]

 [case id=program-map-115-equality-order-independent level=core
