cx-err:CXER0239
#]]
 ]

 [case id=cmd-007-compensates-valid-pairing level=core grant='read'
  [tags def command compensates pairing stream-6 678]
  [meta [#
note: valid pairing — the target precedes its pairing def at program
note: (script) top level (code.md 12.2.7; module level is
note: order-independent via the 12.5 two-pass). Both are commands.
#]]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?lib 'cx-stdlib/path' as=path]
[?def undo-canon impure [effects [read]] ($p) [$path:canonical $p]]
[?def do-canon impure [effects [read]] [compensates undo-canon] ($p) [$path:canonical $p]]
[$do-canon '/']
#]]
  [out-text [#
'/'
#]]
 ]

 [case id=cmd-008-compensates-non-command-target level=core
  [tags def command compensates non-command CXER0239 stream-6 678]
  [meta [#
note: the compensates target EXISTS but carries no [effects] clause —
note: not a command, so the pairing is the static contract violation
note: cx-err:CXER0239 (a compensating action must itself be a command).
#]]
  [in-cx [#
[doc]
#]]
