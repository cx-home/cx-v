 [case id=program-cxpath-001-path-value-basic level=core
  [tags cxpath path-value selection]
  [in-cx [#
[users
  [user [name Alice] [email a@x.com]]
  [user [name Bob]   [email b@x.com]]]
#]]
  [in-code [#
//user
#]]
  [out-text [#
[user [name 'Alice'] [email 'a@x.com']]
[user [name 'Bob'] [email 'b@x.com']]
#]]
 ]

 [case id=program-cxpath-002-attribute-predicate level=core
  [tags cxpath predicate attribute]
  [in-cx [#
[users
  [user active=true  [name Alice]]
  [user active=false [name Bob]]
  [user active=true  [name Carol]]]
#]]
  [in-code [#
//user[= $_@active true]
#]]
  [out-text [#
[user active=true [name 'Alice']]
[user active=true [name 'Carol']]
#]]
 ]

