# ── Wall-clock and wasm gate-39 fixtures (deferred) ─────────────────────────
#
# Per conformance gates 39.1 / 39.4 / 39.6 / 39.7, fixtures that
# observe **wall-clock** behaviour need harness extensions that the
# in_code / out_text equality-matcher above does not provide:
#
#   - 39.1 wall-clock observable: assert ≥ 450ms elapsed for bare [?sleep 500ms].
#     Needs a `--- min_elapsed_ms` / `--- max_elapsed_ms` matcher.
#   - 39.4 wall-clock cancellation: assert CXER0260 observed within 50ms
#     of [?cancel]. Needs a multi-event harness (issue cancel mid-sleep).
#   - 39.6 wasm CXER0270: needs a `--- host-mode wasm-no-opt-in` selector
#     so the fixture runs against libcx-wasm without the
#     _cx_wasm_set_wall_sleep(true) opt-in.
#   - 39.7 par-map + wall-clock sleep: timing assertion + par-map SIGSEGV
# prerequisite.
#
# Filed as a separate work item: extend the conformance harness with
# wall-clock and host-mode selectors, then add the four fixtures above.
# The mock-clock surface (gates 39.2 / 39.3 / 39.5 / 39.8) is fully
# covered by program-sleep-001 through program-sleep-009 above.

# ── [?str] compile-time string interpolation (spec/core/code.md §8.12) ──────
#
# `[?str]` was admitted to core 2026-05-31 (spec/core/code.md §8.12;
# grammar.ebnf [127r] StrDirective + [127r1] InterpString; §4.1 registry;
# governance.md §12.1). The program parser scans the opaque string-literal
# content for `{…}` binding-path holes (`{{`/`}}` = literal braces; an
# unbalanced brace, empty hole, or non-path / call hole → CXER0100 at parse
# time); the evaluator resolves each hole in the enclosing lexical
# environment and renders its scalar value to text.
#]]
 ]

 [case id=program-str-001-binding level=core
  [tags str string-interpolation binding]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $name "Ann"] [?str "Hi {$name}"]]
#]]
  [out-text [#
'Hi Ann'
#]]
 ]

 [case id=program-str-002-path level=core
  [tags str string-interpolation binding-path]
  [in-cx [#
[u [email "a@b"]]
#]]
  [in-code [#
[?let [= $u //u] [?str "email={$u/email}"]]
#]]
  [out-text [#
'email=a@b'
#]]
 ]

