 [# ── program-delivery-001…005: the delivery.md §8 cross-surface lanes
      (#762; RULED: U1.1a–U1.15a, U2.1a). Per-surface lanes live in each
      module's suite; these pin the CROSS-surface obligations: the
      cross-mechanism select, the degenerate-cursor doctrine, instance
      conformance (§4 attrs + the one close contract), the coalescing
      structural pair, and the bus dispatch-boundary negative. ─────── #]

 [case id=program-delivery-001-cross-mechanism-select level=core eval-ring=2 grant='read write'
  [tags delivery select cross-mechanism channel fabric u1-5a u1-15a 762]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-fabric' :as fabric]
[?let [= $j [$journal:open "mem://del-001" "acme"]]
[= $f [$fabric:open $j]]
[= $fs [$fabric:subscribe $f "orders" :o.p {group: "g1"}]]
[= $ch [?channel name="del1" buffer=2]]
[= $sel1 [?select [case [from $ch $m] [chan $m]] [case [from $fs $e] [fab seq=$e/@seq]] [case [timeout 0] [idle]]]]
[= $p1 [$fabric:publish $f "orders" [do :o.p id=1] {actor: "u" authority: "g"}]]
[= $sel2 [?select [case [from $ch $m] [chan $m]] [case [from $fs $e] [fab seq=$e/@seq]] [case [timeout 0] [idle]]]]
[= $s1 [?send [job 7] to=$ch]]
[= $sel3 [?select [case [from $ch $m] [chan $m]] [case [from $fs $e] [fab seq=$e/@seq]] [case [timeout 0] [idle]]]]
  ($sel1, $sel2, $sel3)]
#]]
  [out-text [#
([idle], [fab seq=1], [chan [job 7]])
#]]
 ]

 [case id=program-delivery-002-degenerate-cursor-roundtrip level=core eval-ring=2 grant='eval read write'
  [tags delivery cursor degenerate head-set doctrine u1-6a 762]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/live']
[?let [= $j [$journal:open "mem://del-002" "acme"]]
[= $e1 [$journal:append $j [a 1] {actor: "u" authority: "g" stream: "s"}]]
[= $e2 [$journal:append $j [a 2] {actor: "u" authority: "g" stream: "s"}]]
[= $scalar [$journal:subscribe $j {stream: "s" from: 1}]]
[= $r [?receive from=$scalar]]
[= $q [?quote [?for [in $e [$journal:source $jrn "s"]] [yield [ev seq=$e@seq]]]]]
[= $c [$live:changes-since $q {jrn: $j} [head-set [s source="jrn" pos=1]]]]
[= $hs-row [$first [?for [in $fr $c/insert] [yield [$first $fr/*]]]]]
  ([scalar-form seq=$r/@seq], [headset-form $hs-row], [agree eq=[$cx:equal $r/@seq $hs-row/@seq]])]
#]]
  [out-text [#
([scalar-form seq=2], [headset-form [ev seq=2]], [agree eq=true])
#]]
 ]

 [case id=program-delivery-003-instance-conformance level=core eval-ring=2 grant='read write'
  [tags delivery contract attrs closeable fabric-sub watch u1-2a 762]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/journal']
[?lib 'cx-stdlib/io']
[?lib 'cx-fabric' :as fabric]
[?let [= $j [$journal:open "mem://del-003" "acme"]]
[= $f [$fabric:open $j]]
[= $s [$fabric:subscribe $f "orders" :o.p {group: "g1"}]]
[= $w [$io:watch "/tmp"]]
[= $fs [fsub rung=$s@rung sharing=$s@sharing flow=$s@flow retention=$s@retention]]
[= $ws [wsub rung=$w@rung sharing=$w@sharing flow=$w@flow retention=$w@retention]]
[= $cf [?close $s]]
[= $cw [?close $w]]
[= $post [?receive from=$s max=1]]
  ($fs, $ws, $cf, $cw, $post@code)]
#]]
  [out-text [#
([fsub rung=':complete-ordered' sharing=group flow=pull retention=full], [wsub rung=':coalesced-rescan' sharing=independent flow=pull retention=none], [ok], [ok], 'cx-err:CXER4921')
#]]
 ]

 [case id=program-delivery-004-coalescing-structural-pair level=core
  [tags delivery retention window latest coalesce structural u1-11a 762]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $win [?channel name="delw" sharing=independent retention=window keep=5]]
[= $lat [?channel name="dell" sharing=independent retention=latest]]
[= $ws [?subscribe from=$win]]
[= $ls [?subscribe from=$lat]]
[= $w1 [?send [v 1] to=$win]] [= $w2 [?send [v 2] to=$win]] [= $w3 [?send [v 3] to=$win]]
[= $l1 [?send [v 1] to=$lat]] [= $l2 [?send [v 2] to=$lat]] [= $l3 [?send [v 3] to=$lat]]
[= $wb [?receive from=$ws max=9 deadline=0]]
[= $lv [?receive from=$ls]]
[= $lq [?try-receive from=$ls]]
  ([window n=[$count $wb]], [latest $lv], [drained $lq@code])]
#]]
  [out-text [#
([window n=3], [latest [v 3]], [drained 'cx-err:CXER0202'])
#]]
 ]

