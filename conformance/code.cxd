 ]

 [case id=program-cxpath-012-namespace-wildcard-prefix-any-local level=core
  [tags cxpath namespace-wildcard nodetest]
  [in-cx [#
[doc xmlns:xhtml=http://www.w3.org/1999/xhtml xmlns:svg=http://www.w3.org/2000/svg
  [xhtml:user "Alice"]
  [svg:user "Bob"]
  [user "Charlie"]]
#]]
  [in-code [#
//xhtml:*
#]]
  [out-text [#
[xhtml:user 'Alice']
#]]
 ]

 [; Absolute ('/'-rooted) PathExpr per grammar [130] `'/' StepList` (#391):
    anchored at the DOCUMENT node, so the head step's child axis holds
    exactly the root element. Previously the program parser rejected the
    form outright ("unexpected token '/' in expression position") while
    the same bytes parsed in a data reading — the #391 mode-flip repro 3. ]

 [case id=program-cxpath-013-absolute-root-chain level=core
  [tags cxpath absolute-path issue-391]
  [in-cx [#
[users
  [user [name Alice] [email a@x.com]]
  [user [name Bob]   [email b@x.com]]]
#]]
  [in-code [#
/users/user/name
#]]
  [out-text [#
[name 'Alice']
[name 'Bob']
#]]
 ]

