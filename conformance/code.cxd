     integer — the bigint carrier's home turf. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [x::bigint 123456789012345678901]] $x]
#]]
  [out-text [#
[x::bigint 123456789012345678901]
#]]
 ]

