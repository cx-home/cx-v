 [case id=program-pvmatrix-035-map-predicate-per-entry level=core
  [tags pvmatrix map predicate entries]
  [; R-A3: a map's items are its entries; a direct predicate binds $_ per
     entry (entries materialize as [key value] elements). The count is 2
     ONLY under per-entry binding — were $_ the whole map, one focus would
     survive and the count would be 1. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $m {host: 'h', port: 5432}] [$count $m[> [$count $_] 0]]]
#]]
  [out-text [#
2
#]]
 ]

 [case id=program-pvmatrix-036-parsed-paren-seq-opaque level=core
  [tags pvmatrix data-lane paren-sequence opaque settled]
  [; Regression pin for the SETTLED #587/#847 cells: parsed data keeps its
     paren-sequence child — /name opaque (0), // through (2), /* sees the
     sequence node (1). Unchanged by R-A1..R-A6, pinned so the construction
     refusal is never "fixed" into the data lane. ]
  [in-cx [#
[bag ([v k=1], [v k=2])]
#]]
  [in-code [#
[list [$count $doc/v] [$count $doc//v] [$count $doc/*]]
#]]
  [out-text [#
[list 0 2 1]
#]]
 ]

 [case id=program-pvmatrix-037-data-root-binding level=core
  [tags pvmatrix data-lane doc root-binding]
  [; R-A2 binding contract: $doc is the root ELEMENT when the file has
     exactly one top-level element; leading comments neither count against
     uniqueness nor join the bound value. The platform's $doc/field idiom. ]
  [in-cx [#
[; leading comment ]
[users [user name=a] [user name=b]]
#]]
  [in-code [#
[$count $doc/user]
#]]
  [out-text [#
2
#]]
 ]

 [case id=program-pvmatrix-041-loop-carriers-positional level=core
  [tags pvmatrix loop continue break carrier positional]
  [; R-A1's loop-carrier exemption: [continue]/[break] carry one value per
     expression — an ABSENT value rides as the empty sequence and a
     SEQUENCE value rides whole, or the positional rebind would shift
     every later binding. Pins a 3-binding loop threading an absence and
     a sequence through one rebind cycle. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $u [user [tag 'a']]]
 [?loop [= $none $u/nothing] [= $seq ('x', 'y')] [= $n 0]
   [?if [= $n 0]
     [then [continue $u/nothing ('x', 'y') [+ $n 1]]]
     [else [break [list [$count $none] [$count $seq] $n]]]]]]
#]]
  [out-text [#
[list 0 2 1]
#]]
 ]

 [case id=program-pvmatrix-040-dispatching-head-consumes-seq-arg level=core
  [tags pvmatrix construction dispatch operator sequence argument]
  [; R-A1's dispatch boundary: a dispatching form ($-head call, operator
     head, closure) consumes an operand-produced sequence as an ARGUMENT —
     the refusal is only for plain construction (pvmatrix-026). ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $doc [order [line qty=2 price=10] [line qty=1 price=20] [line qty=3 price=5]]]
  [$sum $doc/line/@price]]
#]]
  [out-text [#
35
#]]
 ]

 [case id=program-pvmatrix-039-literal-seq-body-is-data level=core
  [tags pvmatrix construction sequence literal position parity]
  [; R-A1's position discriminator (the #853 literal-err principle): a
     SOURCE-LITERAL paren sequence in element content constructs the
     envelope the data reading gives those bytes — child-opaque, //
     through — while an evaluated operand yielding a sequence refuses
     (pvmatrix-026). Cross-parser parity pins the same bytes agree. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $t [pair ([v k=1], [v k=2])]]
  [list [$count $t/v] [$count $t//v] [$count $t/*]]]
#]]
  [out-text [#
[list 0 2 1]
#]]
 ]

 [case id=program-pvmatrix-038-seq-nonelement-skips level=core
  [tags pvmatrix distribution sequence non-element skip]
  [; code.md step-distribution row 4, pinned: a non-element member skips —
