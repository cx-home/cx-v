 [case id=program-async-016-await-positional-atom-refused level=async
  [tags async await arg-validation fail-loud CXER0100
   issue-793]
  [meta [#
note: `:timeout 2ms` is the WRONG spelling (the labeled `timeout=2ms` is
note: the one code.md §10.5.2 defines). It used to parse as two EXTRA
note: positional slots that the engine dropped, so the bounded await the
note: author wrote ran as an unbounded one — a spelling mistake silently
note: became a behavior change. Unknown arguments are refused loud.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $f [?async 1]] [?await $f :timeout 2ms]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-async-017-await-unknown-label-refused level=async
  [tags async await arg-validation fail-loud CXER0100
   issue-793]
  [meta [#
note: the same fail-open class through the labeled door: a MISSPELLED
note: label was dropped exactly like an unknown positional, so
note: `timeuot=` awaited forever. [?await] defines one label, `timeout=`.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $f [?async 1]] [?await $f timeuot=2ms]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-async-018-await-all-rejects-timeout level=async
  [tags await-all arg-validation fail-loud CXER0100
   issue-793]
  [meta [#
note: the barrier family (-all / -any / -race) awaits UNBOUNDED by
note: §10.5.2 — it defines no `timeout=`. Accepting-then-ignoring one
note: would promise a deadline the engine never applies, so it refuses.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $a [?async 1]] [= $b [?async 2]] [?await-all ($a, $b) timeout=1s]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-async-019-await-race-extra-positional-refused level=async
  [tags await-race arg-validation fail-loud CXER0100
   issue-793]
  [meta [#
note: the refusal is the FAMILY's, not one verb's — the barrier verbs
note: share the argument check, so an extra positional is refused on
note: await-race exactly as on await.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $a [?async 1]] [= $b [?async 2]] [?await-race ($a, $b) $a]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

