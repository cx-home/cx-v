#]]
  [out-text [#
[magic::bytes 0x89504e470d0a1a0a]
#]]
 ]

 [case id=program-bytes-ascription-003-long-hex level=core
  [tags type-annotation bytes hex long issue-457]
  [in-cx [#
[empty]
#]]
