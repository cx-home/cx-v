3
#]]
 ]

 [case id=program-pvmatrix-004-seq-predicate-direct level=core
  [tags cxpath pvmatrix predicate sequence]
  [; R-A6(iv): a predicate directly on a bound collection binds $_ per
     member (was: parses, then CXER0001 unbound variable $_). ]
