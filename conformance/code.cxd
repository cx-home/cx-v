 [; ── Table sequence view (D22, #404) — code.md §6.6 D22 / §7 "Table
    sources". A :table-bearing element atomizes to its row sequence
    (ordered maps, typed cells) for [?for] sources, slices, and the
    sequence built-ins; CXPath does NOT navigate into rows. ;]

 [case id=program-table-d22-001-forcomp-typed-filter level=core
  [tags table d22 for comprehension where typed]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?for [in $u $input//users] [in $r $u] [where [> $r.age 26]] [yield $r.name]]
#]]
  [out-text [#
'alice'
#]]
 ]

 [case id=program-table-d22-002-col-label-slice level=core
  [tags table d22 slice column-label]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[*, "name"]]
#]]
  [out-text [#
(alice, bob)
#]]
 ]

 [case id=program-table-d22-003-cell-typed level=core
  [tags table d22 slice column-label cell]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[1, "age"]]
#]]
  [out-text [#
30
#]]
 ]

 [case id=program-table-d22-004-label-range level=core
  [tags table d22 slice column-label range]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[1:2, "name":"age"]]
#]]
  [out-text [#
((alice, 30), (bob, 25))
#]]
 ]

 [case id=program-table-d22-005-row-full-axis level=core
  [tags table d22 slice row map]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] [out [a $t[2, *]] [b $t[2]]]]
#]]
  [out-text [#
[out [a {name: bob, age: 25}] [b {name: bob, age: 25}]]
#]]
 ]

 [case id=program-table-d22-006-seq-builtins level=core
  [tags table d22 count first last empty]
  [in-cx [#
[data
 [users [table[name::string age::int]]
  alice 30
  bob 25
 ]
 [log [table[id::int]]
 ]]
#]]
  [in-code [#
[?let [= $t [$first $input//users]]
 [?let [= $l [$first $input//log]]
  [out [n [$count $t]] [f [$first $t]] [z [$last $t]]
       [ln [$count $l]] [le [$empty $l]]
       [liter [?for [in $r $l] [yield $r]]]]]]
#]]
  [out-text [#
[out [n 2] [f {name: alice, age: 30}] [z {name: bob, age: 25}] [ln 0] [le true] [liter]]
#]]
 ]

 [case id=program-table-d22-007-cxpath-unchanged level=core
  [tags table d22 cxpath negative]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] [out [a $t//row] [b [$count $t/*]]]]
#]]
  [out-text [#
[out [a] [b 0]]
#]]
 ]

 [case id=program-table-d22-008-orderby level=core
  [tags table d22 for order-by]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?for [in $u $input//users] [in $r $u] [order-by $r.age] [yield $r.name]]
#]]
  [out-text [#
'bob'
'alice'
#]]
 ]

 [case id=program-table-d22-009-null-cell-bool-guard level=core
  [tags table d22 null bool where]
  [in-cx [#
[people [table[name::string age::int active::bool]]
 alice 30 true
 bob null false
]
#]]
  [in-code [#
[?let [= $p [$first $input//people]]
 [out [a $p[2, "age"]] [b [?for [in $r $p] [where $r.active] [yield $r.name]]]]]
#]]
  [out-text [#
[out [a null] [b 'alice']]
#]]
 ]

 [case id=program-table-d22-010-positional-col-err level=core
  [tags table d22 slice map error]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]] $t[1, 2]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-table-d22-011-map-row-collabel level=core
  [tags table d22 slice column-label map-row]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $rows ([?to-map (("name", "A"), ("age", 1))], [?to-map (("name", "B"), ("age", 2))])]
 $rows[*, "name"]]
#]]
  [out-text [#
(A, B)
#]]
 ]

 [case id=program-table-d22-012-row-vs-column-lanes level=core
  [tags table d22 transparency row-lane column-lane l92 689]
  [; ── §9 pair family (runtime_representation.md L92): row-iteration
     and column-iteration over ONE input answer identically — the
     representation (row walk vs column slice) is invisible in the
     result. ;]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
 carol 41
 dan 19
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]]
  [= $rows [?for [in $r $t] [yield $r.age]]]
  [r [rowsum [$sum $rows]] [colsum [$sum $t[*, "age"]]]]]
#]]
  [out-text [#
[r [rowsum 115] [colsum 115]]
#]]
 ]

 [case id=ev-pull-004-take-over-map-table-source level=core rule=EV-PULL
  [tags table d22 iterator pull ev-pull l92 689 710]
  [; ── EV-PULL over a TABLE source (§9 L92 effect-count probe):
     [?take 2] over [?map $t …] invokes the transform EXACTLY twice —
     the demand-driven engine constructs row views on pull, never
     up-front (the W2 batch-[?for] walk and the W1 pull core jointly). ;]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
 carol 41
 dan 19
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]]
  [= $out [?take 2 [?map $t [using [?fn $r [?let [= $c [?test-counter name=tblpull op=inc]] $r.age]]]]]]
  [= $n [$count $out]]
  ([?test-counter name=tblpull op=read], $n)]
#]]
  [out-text [#
(2, 2)
#]]
 ]

 [case id=ev-pull-005-filter-until-satisfied-table-source level=core rule=EV-PULL
  [tags table d22 iterator pull ev-pull filter l92 689 710]
  [; ── EV-PULL over a TABLE source, filter arm: [?take 1] over
     [?filter $t …] pulls rows until the FIRST satisfying row (ages
     30/25/41/19 with [> age 30] → 3 predicate invocations), never the
     whole table. ;]
  [in-cx [#
[users [table[name::string age::int]]
 alice 30
 bob 25
 carol 41
 dan 19
]
#]]
  [in-code [#
[?let [= $t [$first $input//users]]
  [= $out [?take 1 [?filter $t [using [?fn $r [?let [= $c [?test-counter name=tblf op=inc]] [> $r.age 30]]]]]]]
  [= $n [$count $out]]
  ([?test-counter name=tblf op=read], $n)]
#]]
  [out-text [#
(3, 1)
#]]
 ]

 [case id=ev-budget-001-exactly-at-floor level=core rule=EV-BUDGET
  [tags iterator pull ev-budget floor l92 689 710]
  [; ── EV-BUDGET (code.md §Evaluation): the iterator force budget is
     FLOORED — implementations MUST accept ≥ 1,000,000 pulls before
     the guard may fire (limits ship with floors, never bare
     numbers). Exactly-at-the-floor succeeds; firing above the floor
     is permitted, so no negative twin exists. Ruled into W7
     acceptance by the I5 audit (Q6a). ;]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$count [?take 1000000 [$range 1 *]]]
#]]
  [out-text [#
1000000
#]]
 ]

 [case id=program-par-001-width-cap-fail-loud level=core
  [tags par width cap CXER0153 805]
  [; ── §7.3: an explicit [par N] beyond the 64×ncpu sanity cap is the
     FAIL-LOUD refusal CXER0153 (E_PAR_WIDTH_TOO_LARGE) — never a
     silent clamp. 999999 exceeds 64×ncpu on any real host (ncpu
     would need to exceed 15,624); the pinned token is the CODE (the
     message names the host's own cap). Covers the last uncited §7.3
     code (gate-4 repair, #805). ;]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?for [in $x (1, 2)] [par 999999] [yield $x]]
#]]
  [out-err [#
cx-err:CXER0153
#]]
 ]

 [case id=program-const-001-body-failed level=core
  [tags const eager CXER0215 805]
  [; ── §12.5.2: a [?const] whose initializer RAISES at load surfaces
     the typed CXER0215 (E_CONST_BODY_FAILED) naming the const —
     the unbound-variable body rides the throwing channel the wrap
     covers. Covers the last uncited module-range code (gate-4
     repair, #805). ;]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?const boom $nope]
$boom
#]]
  [out-err [#
cx-err:CXER0215
#]]
 ]

 [case id=program-table-478-001-attrs-literal level=core
  [tags table attrs elementmeta issue-478]
  [doc [#
# 478 (program lane): an ATTRIBUTED `[table[…]]`-block element literal
# inside a program parses via the data-reader seam — the attribute run
# precedes the `[table[` clause (grammar [29]/[50]), so the program
# parser re-checks for the clause opener after the attrs and delegates
# the span. The element (attrs included) evaluates to itself.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [users region=west [table[name age::int]] alice 30 bob 25]] $t]
#]]
  [out-text [#
[users region=west [table[name age::int]]
  alice 30
  bob 25
]
#]]
 ]

 [case id=program-table-478-002-attrs-dynamic-err level=core
  [tags table attrs dynamic error issue-478]
  [doc [#
# 478 (program lane, fail-closed): a DYNAMIC attribute value on a
# `[table[…]]` element literal cannot ride the data reading — the
# parser rejects it loudly rather than silently literalizing `$x`
# (the tabular form is data-only; rows have no expression production).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x west] [users region=$x [table[a]] 1]]
#]]
  [out-err [#
must be a scalar literal
#]]
 ]

 [case id=program-table-484-001-nested-literal level=core
  [tags table nested composition issue-484]
  [doc [#
# 484 (program lane): a table-bearing element literal nested inside
# another element literal parses as ordinary composition — the program
# reading's element-literal body loop detects the `[table[` clause-child
# opener on the CHILD and delegates that span to the data reader, same
# as at top level.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [wrap [users [table[name age::int]] alice 30]]] $t]
#]]
  [out-text [#
[wrap [users [table[name age::int]]
  alice 30
]]
#]]
 ]

 [case id=program-table-484-002-misplaced-opener-err level=core
  [tags table reserved-name error issue-484]
  [doc [#
# 484 (program lane, fail-closed): the reserved glued `[table[` opener
# with no enclosing element head (anonymous table) is not grammatical —
# grammar [50]'s tabular alternative requires a Name. The program
# reading delegates the span to the data reader, which rejects loudly;
# both engines converge on the rejection.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $t [table[name age] Ada 36]] $t]
#]]
  [out-err [#
outside ElementMeta position
#]]
 ]

