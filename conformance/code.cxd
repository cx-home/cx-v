 [case id=program-cxpath-bind-005-shadow-and-restore level=core
  [tags cxpath bind step-binding shadowing issue-434]
  [in-cx [#
[teams
  [team name="alpha" [member] [member] [member]]
  [team name="beta" [member]]]
#]]
  [in-code [#
[?let [= $t "outer"]
 [pair
  [n [$count //team (bind $t)/member[>= [$count $t/member] 3]]]
  [restored $t]]]
#]]
  [out-text [#
[pair [n 3] [restored 'outer']]
#]]
 ]

