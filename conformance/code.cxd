#]]
  [out-text [#
[sig::bytes 0x3a7bd3e23a7bd3e23a]
#]]
 ]

 [case id=program-bytes-ascription-004-typed-array level=core
  [tags type-annotation bytes hex typed-array issue-457]
  [in-cx [#
[empty]
#]]
  [in-code [#
[hashes::bytes[] 0x3a7bd3e2 0xdeadbeef]
