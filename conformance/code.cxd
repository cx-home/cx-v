 [case id=program-builtin-badarg-001-absence-named level=core
  [tags builtin dispatch bad-argument absence CXER0100]
  [; #536 — a recognized builtin whose argument is absence surfaces a real
     CXER0100 diagnostic NAMING THE ARGUMENT, never `no callable "concat"`. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $c [x]] [$concat '' $c@nope]]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='concat: argument 2 is absence (the empty sequence) — a single scalar (or a node atomizing to one) is required; bind it or default it with [?else] first (code.md §6.5)']
#]]
 ]

 [case id=program-builtin-badarg-002-sequence-named level=core
  [tags builtin dispatch bad-argument sequence CXER0100]
  [; #536 — a multi-item sequence in a scalar slot is named per-argument,
     never misdiagnosed as an unknown callable. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $seq ([a], [b])] [$concat '' $seq]]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='concat: argument 2 is a 2-item sequence — a single scalar (or a node atomizing to one) is required; bind it or default it with [?else] first (code.md §6.5)']
#]]
 ]

 [case id=program-builtin-badarg-003-arity-named level=core
  [tags builtin dispatch bad-argument arity CXER0100]
  [; #536 — an arity mismatch on a recognized builtin reports the expected
     range, never `no callable`. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$substring 'abc']
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='substring: expected 2–3 argument(s), got 1 (code.md §6.5)']
#]]
 ]

 [case id=program-builtin-badarg-004-scalar-stringify level=core
  [tags builtin dispatch string-builtin coercion]
  [; §6.5 string-builtin argument rule — a non-string SCALAR stringifies via
     the canonical scalar printer ([$upper 5] is '5', not an argument error). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$upper 5]
#]]
  [out-text [#
'5'
#]]
 ]

 [case id=program-builtin-case-locale-audit-001-upper-simple level=core
  [tags builtin string upper unicode locale-audit L105 stream-5]
  [; L105 locale audit — the §6.5 pure `upper` applies Unicode DEFAULT
     casing (simple 1:1 mapping), never host locale: accented Latin and
     Greek map; ß is NOT expanded at this tier (full-mapping ß→SS lives
     on the strings module surface, strings-003). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$upper 'héllo ώρα straße']
#]]
  [out-text [#
'HÉLLO ΏΡΑ STRAßE'
#]]
 ]

 [case id=program-builtin-case-locale-audit-002-lower-simple level=core
  [tags builtin string lower unicode locale-audit L105 stream-5]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$lower 'HÉLLO ΏΡΑ']
#]]
  [out-text [#
'héllo ώρα'
#]]
 ]

 [case id=program-builtin-case-locale-audit-003-turkish-trap level=core
  [tags builtin string case locale-audit turkish L105 stream-5]
  [; L105 — Unicode default casing, never host locale: under tr_TR libc
     casing 'i'→'İ' and 'I'→'ı'; the pure builtins MUST give the default
     mapping on every host. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$concat [$upper 'i'] [$lower 'I']]
#]]
  [out-text [#
'Ii'
#]]
 ]

 [case id=program-call-inline-element-arg-001 level=core
  [tags call dispatch inline-element directive-argument]
  [; #540 — an inline [?element NAME-EXPR …] constructor is a valid positional
     argument to a bareword def call: the call applies; it does NOT silently
     fall through to data construction. ]
  [; R-A1 migration: envelope → spliced children (2026-08-25) ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def render scope=public pure ($fmt $e) [rendered [fmt $fmt] $e]]
[render 'cx' [?element 'batch' [?splice ([entry seq=1], [entry seq=2])]]]
#]]
  [out-text [#
[rendered [fmt 'cx'] [batch [entry seq=1] [entry seq=2]]]
#]]
 ]

 [case id=program-collection-kind-001-filter-first level=core
  [tags builtin collection-kind filter first iterator]
  [; #529 — [$filter] returns an eager IteratorNode; [$first] destructures
     it like nth/count do, never silently returning the whole collection. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $lit ([e x=1], [e x=2])]
  [= $filtered [$filter $lit [?fn ($s) true]]]
  [$first $filtered]]
#]]
  [out-text [#
[e x=1]
#]]
 ]

 [case id=program-collection-kind-002-positional-matrix level=core
  [tags builtin collection-kind filter last head tail reverse iterator]
  [; #529 — the whole positional family over an iterator input: last takes
     the final item, head the first, tail drops one, reverse reorders
     (before the fix: last/head passed the collection through whole, tail
     was empty, reverse was unreversed — all silent). ]
  [; R-A1 migration: envelope → spliced children (2026-08-25) ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $flt [$filter ([e x=1], [e x=2], [e x=3]) [?fn ($s) true]]]
  [probe
    [last [$last $flt]] [head [$head $flt]]
    [tail [?splice [$tail $flt]]] [rev [?splice [$reverse $flt]]]]]
#]]
  [out-text [#
[probe [last [e x=3]] [head [e x=1]] [tail [e x=2] [e x=3]] [rev [e x=3] [e x=2] [e x=1]]]
#]]
 ]

 [case id=program-collection-kind-003-fp-map-iterator level=core
  [tags builtin collection-kind filter fp map iterator]
  [; #529 — fp_classify treats an IteratorNode as the SEQUENCE instance:
     [$fp:map [$filter …] f] maps over the items (before: the iterator
     classified as a bare scalar and the whole collection became one
     singleton Some — the kind taint that propagated through fp:map). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/fp' :as fp]
[?let [= $flt [$filter ([e x=1], [e x=2]) [?fn ($s) true]]]
  [$first [$fp:map $flt [?fn ($v) [?element 'seen' [?attr 'x' [$concat '' $v@x]]]]]]]
#]]
  [out-text [#
[seen x='1']
#]]
 ]

 [case id=program-loop-001-accumulate-break level=core
  [tags loop break continue bindings]
  [; §8.15 (#550) — declared loop bindings rebind via [continue V…]
     (positional, all of them); [break V] exits with V as the loop's value. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?loop [= $i 1] [= $acc 0]
  [?if [> $i 5] [then [break $acc]]
    [else [continue [+ $i 1] [+ $acc $i]]]]]
#]]
  [out-text [#
15
#]]
 ]

 [case id=program-loop-002-bare-continue level=core
  [tags loop continue bare]
  [; §8.15 — a single-binding countdown: [continue V] rebinds it each
     pass until the exit condition takes the [break …] branch. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?loop [= $n 3]
  [?if [= $n 0] [then [break 'done']]
    [else [continue [- $n 1]]]]]
#]]
  [out-text [#
'done'
#]]
 ]

 [case id=program-loop-003-bare-break-unit level=core
  [tags loop break unit null]
  [; §8.15 — a bare [break] exits with null (a present unit, §9.1.2.1 2b). ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?loop [break]]
#]]
  [out-text [#
null
#]]
 ]

 [case id=program-loop-004-forgot-exit-raises level=core
  [tags loop tail-contract CXER0100]
  [; §8.15 — the ALL-EXPLICIT tail contract: a body value that is neither
     [break …] nor [continue …] raises — the Clojure forgot-to-recur
     silent-exit foot-gun is a diagnostic here, never a wrong answer. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?loop [= $i 0] 42]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-loop-005-continue-arity-raises level=core
  [tags loop continue arity CXER0100]
  [; §8.15 — [continue V…] rebinds ALL declared bindings positionally, or
     none (bare); a partial rebind raises with the counts named. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?loop [= $a 1] [= $b 2] [continue 9]]
#]]
