 [# §10.5.4 cooperative cancellation in a pure loop: the worker's only exit is
    observing the cancel signal — [?check-cancel] in the take-while predicate
    (or the [?for] iteration-boundary cancellation point) reports CXER0260
    once [?cancel] lands. Deterministic by construction: the body CANNOT run
    to completion before the cancel, so [?wait-for] always surfaces the
    WORKER_CANCELLED chain regardless of scheduling (the earlier finite-loop
    shape raced the cancel under load — 2026-07-04 cold-gate flake). #]
 [case id=program-conc-020-check-cancel-pure-loop level=concurrency
  [tags cancel check-cancel CXER0260]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $w [?worker name="w20"
              [body [?for [in $i [$range 1 *]]
                     [take-while [?match [?check-cancel] [case [err @code="cx-err:CXER0260"] false] [else true]]]
                     [yield $i]]]]] [= $_ [?cancel worker=$w]] [?wait-for worker=$w]]
#]]
  [out-text [#
[err code=cx-err:CXER0221 message='worker cancelled' [cause [err code=cx-err:CXER0260 message='operation cancelled']]]
#]]
 ]

