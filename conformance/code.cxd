 [case id=program-fizzbuzz-shapes-rosetta level=core
  [tags corpus rosetta fizzbuzz]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?for [in $n [$range 1 15]] [yield
  [?match true
    [when [and [= [$mod $n 3] 0] [= [$mod $n 5] 0]] :fizzbuzz]
    [when [= [$mod $n 3] 0] :fizz]
    [when [= [$mod $n 5] 0] :buzz]
    [else $n]]]]
#]]
  [out-text [#
1
2
:fizz
4
:buzz
:fizz
7
8
:fizz
:buzz
11
:fizz
13
14
:fizzbuzz
#]]
 ]

