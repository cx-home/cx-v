  [title $-leading / colon-bearing string map keys quote when the map is the top-level result]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?to-map (("$tag", weird), ("cx:seq", v2), (plain, ok))]
#]]
  [out-text [#
{'$tag': weird, 'cx:seq': v2, plain: ok}
#]]
 ]

