 [case id=program-pvmatrix-015-pred-eq-atomizes level=core
  [tags cxpath pvmatrix predicate atomization compare]
  [; R-A3 companion (settled 2026-05-31 rule): comparison atomizes — an
     element with single scalar/text content compares as that value, so the
     dominant value-predicate idiom holds WITHOUT the field collapse. ]
  [in-cx [#
[doc [user [name ada] [tag]] [user [name bo] [tag]]]
#]]
  [in-code [#
[$count $doc/user[= $_/name 'ada']]
#]]
  [out-text [#
1
#]]
 ]

