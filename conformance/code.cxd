min-samples=1 name="cb-004" [?test-always-err]]] [= $third [?circuit-breaker threshold=0.0 window=60s reset=30s
min-samples=1 name="cb-004" [?test-always-err]]] ($first, $second, $third)]
#]]
  [out-text [#
([err code=test-failure message='test failure'], [err code=test-failure message='test failure'], [err code=cx-err:CXER0150 message='circuit breaker open' [until [instant 61s]]])
#]]
 ]

