note: from the pure-flow table AND an unclassified head ABORTED the
note: body scan — so a declared-pure for-map def with an impure call
note: anywhere in its body registered and ran.
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?lib 'cx-stdlib/random']
[?def leak pure ($xs) [?for-map [in $x $xs] [yield-map $x [$random:int 1 9]]]]
[$leak (1, 2)]
#]]
