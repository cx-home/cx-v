 [case id=program-for-010-recursion-depth level=core
  [tags def recursion if]
  [in-cx [#
[node
  [node
    [node leaf]
    [node leaf]]
  [node leaf]]
#]]
  [in-code [#
[?def depth ($n)
      [?if [$empty $n/*]
                 [then 1]
                 [else [+ 1 [$max [?for [in $c $n/*] [yield [$depth $c]]]]]]]]
[$depth $input]
#]]
  [out-text [#
3
#]]
 ]

