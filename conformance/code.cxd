 [case id=program-pvmatrix-012-pred-count-zero level=core
  [tags cxpath pvmatrix predicate count nodeset]
  [; R-A3 (#966): predicate-rooted paths are node-set forms — no field
     collapse, so [$count $_/tag] is a MATCH count. bo has one tag; nobody
     has zero (was: bo matched count 0 via the collapse). ]
  [in-cx [#
[doc [user name=ada [tag] [tag]] [user name=bo [tag]]]
#]]
  [in-code [#
[$count $doc/user[= [$count $_/tag] 0]]
#]]
  [out-text [#
0
#]]
 ]

 [case id=program-pvmatrix-013-pred-count-one level=core
  [tags cxpath pvmatrix predicate count nodeset]
  [; R-A3 (#966): count == 1 selects bo, who has exactly one tag (was 0). ]
  [in-cx [#
[doc [user name=ada [tag] [tag]] [user name=bo [tag]]]
#]]
  [in-code [#
[$count $doc/user[= [$count $_/tag] 1]]
#]]
  [out-text [#
1
#]]
 ]

 [case id=program-pvmatrix-014-pred-count-two level=core
