 [case id=program-cb-003-half-open-after-reset level=resilience
  [tags circuit-breaker half-open reset]
  [; #853 (§6.4.1 — construction is operand-consuming) — outcomes are collected in
     a paren SEQUENCE, not a labelling element. A computed [err] in element CHILD
     position propagates, so `[r1 $e]` would short-circuit the construction and
     destroy the evidence this case exists to show. Position carries what the
     labels carried; the full err VALUE stays asserted, so nothing is weakened. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $a [?circuit-breaker threshold=0.0 window=60s reset=30s
                             min-samples=1 name="cb-003" [?test-err-then-ok err-count=1 ok-value=probe-ok]]] [= $_ [?test-clock advance=31s]] [= $b [?circuit-breaker threshold=0.0 window=60s reset=30s
min-samples=1 name="cb-003" [?test-err-then-ok err-count=1 ok-value=probe-ok]]] ($a, $b)]
#]]
  [out-text [#
([err code=test-failure message='test failure'], probe-ok)
#]]
 ]

