 # The `[$sum]` aggregate accumulates in checked int64 (math.md §4.1),
 # uniform with the `[+ …]` operator path: i64-max + 1 overflows → CXER3000
 # (silent wrap would be a correctness hole). A float operand routes to the
 # f64 path (no overflow trap), as for `[+]`.
 [case id=program-num-aggregate-sum-overflow level=core
  [tags aggregate sum overflow CXER3000 checked]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (9223372036854775807, 1)]
#]]
  [out-err [#
cx-err:CXER3000
#]]
 ]

 [; ── CO-14: the aggregates adopt the heads' numeric discipline ──────────
    #1046. The residue of #1017: `[+ 39.98 1.5e0]` refused while
    `[$sum (39.98, 1.5e0)]` returned an f64 — §6.5's "any float promotes the
    result to float" row predates decimal's promotion to a full semantic
    kind, so the aggregates were the last numeric surface still bridging
    decimal↔float silently. That silent bridge IS #1017's defect, and one
    numeric discipline everywhere is the orthogonality objective, so the
    fold rules are now the heads' rules verbatim: exact end-to-end, no
    bridge, `[cast]` the only crossing. The pair 001/002 is the same mix in
    both operand orders — the refusal is decided by the operand that
    COMPLETES the mix, never by which one arrived first. ]
 [case id=program-num-aggregate-co14-001-sum-decimal-float-unbridged level=core
  [tags aggregate sum decimal float CXER0100 exact-family L44 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (39.98, 1.5e0)]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [case id=program-num-aggregate-co14-002-sum-float-first-same-refusal level=core
  [tags aggregate sum decimal float CXER0100 order-independence CO-14]
  [; The float arrives FIRST here, so the f64 lane is already running when
     the decimal lands. Pre-fix that lane simply absorbed it (`4.148e1`,
     identical to 001's answer — the bridge was order-blind in the wrong
     direction). The refusal must be order-blind in the right one. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (1.5e0, 39.98)]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [case id=program-num-aggregate-co14-003-max-decimal-float-unbridged level=core
  [tags aggregate max decimal float CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$max (39.98, 1.5e0)]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$max: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [case id=program-num-aggregate-co14-004-min-decimal-float-unbridged level=core
  [tags aggregate min decimal float CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$min (39.98, 1.5e0)]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$min: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [case id=program-num-aggregate-co14-005-avg-decimal-float-unbridged level=core
  [tags aggregate avg decimal float CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg (39.98, 1.5e0)]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$avg: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; The bigint half of the same mix. This one lost data rather than merely
    changing kind: pre-fix it answered `9.223372036854776e18` — the f64 lane
    SATURATED an over-i64 value, so the operand that motivated bigint's
    existence was the operand the aggregate destroyed. ]
 [case id=program-num-aggregate-co14-006-sum-bigint-float-unbridged level=core
  [tags aggregate sum bigint float CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (9223372036854775808, 1.5e0)]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; The multi-arg surface is the same fold (§6.5: `[$min 5 3 8]` ≡
    `[$min (5, 3, 8)]`), so it refuses identically — one implementation
    behind both spellings (#598). ]
 [case id=program-num-aggregate-co14-007-sum-multiarg-unbridged level=core
  [tags aggregate sum multi-arg decimal float CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum 39.98 1.5e0]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; ── the other direction: exact stays exact ─────────────────────────────
    `[$sum (a, b)]` must agree with `[+ a b]` on the ANSWER, not just on the
    error. 39.98 is what exact base-10 gives; f64 gives 39.980000000000004. ]
 [case id=program-num-aggregate-co14-008-sum-decimal-exact level=core
  [tags aggregate sum decimal exact-family L44 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (19.99, 19.99)]
#]]
  [out-text [#
39.98
#]]
 ]

 [; int embeds losslessly in BOTH lanes, so which lane a mix runs in is
    decided by the non-int kind — and the two answers differ in kind, which
    is exactly why the aggregate may not choose for the user. ]
 [case id=program-num-aggregate-co14-009-sum-int-decimal-exact level=core
  [tags aggregate sum int decimal exact-family CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (1, 2, 3.0)]
#]]
  [out-text [#
6.0
#]]
 ]

 [case id=program-num-aggregate-co14-010-sum-int-float-still-promotes level=core
  [tags aggregate sum int float promotion unchanged CO-14]
  [; The promotion §6.5 rules and CO-14 did NOT touch: int↔float is a
     lossless widening, not a bridge across the exactness boundary. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (1, 2, 3.0e0)]
#]]
  [out-text [#
6.0e0
#]]
 ]

 [case id=program-num-aggregate-co14-011-sum-bigint-no-saturation level=core
  [tags aggregate sum bigint exact-family CO-14]
  [; The successor of i64-max+1, exact. The int lane would overflow
     (CXER3000) and the f64 lane would round; the exact lane does neither. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (9223372036854775808, 1)]
#]]
  [out-text [#
9223372036854775809
#]]
 ]

 [case id=program-num-aggregate-co14-012-max-returns-own-kind level=core
  [tags aggregate max decimal exact-family scale CO-14]
  [; The winner comes back in its own kind, scale intact — `19.99`, not
     `1.999e1`. Scale is data (cents-precision), so a decimal that merely
     PASSES THROUGH an aggregate must not lose it. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$max (19.99, 2.50)]
#]]
  [out-text [#
19.99
#]]
 ]

 [case id=program-num-aggregate-co14-013-min-returns-own-kind level=core
  [tags aggregate min decimal exact-family scale CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$min (19.99, 2.50)]
#]]
  [out-text [#
2.50
#]]
 ]

 [; ── $avg over exact operands ───────────────────────────────────────────
    The mean is the exact SUM divided by the count through the very
    cx_exact_div `/` folds with, so `[$avg xs]` and `[/ [$sum xs] [$count xs]]`
    agree by construction — kind AND scale. `[/ 3.00 2]` is `1.500`, so this
    is `1.500`. Pre-fix `avg` could not see a decimal at all: it ran a
    private i64/f64/string match, and a decimal's base-10 image IS a V
    string, so it fell into the fn:number leniency arm and came back
    `1.5e0` — #1017's defect, in the one aggregate #1017 did not reach. ]
 [case id=program-num-aggregate-co14-014-avg-decimal-exact level=core
  [tags aggregate avg decimal exact-family division L44 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg (1.00, 2.00)]
#]]
  [out-text [#
1.500
#]]
 ]

 [case id=program-num-aggregate-co14-015-avg-decimal-mean-of-equals level=core
  [tags aggregate avg decimal exact-family CO-14]
  [; The mean of a value with itself is that value — pre-fix `1.999e1`. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg (19.99, 19.99)]
#]]
  [out-text [#
19.990
#]]
 ]

 [case id=program-num-aggregate-co14-016-avg-bigint-no-saturation level=core
  [tags aggregate avg bigint exact-family CO-14]
  [; Two over-i64 values two apart: the exact mean is the value between
     them. Pre-fix the f64 lane saturated it to `9.223372036854776e18`. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg (9223372036854775808, 9223372036854775810)]
#]]
  [out-text [#
9223372036854775809.0
#]]
 ]

 [; ── THE RESERVED CELL, NOW RULED (CO-14 reserved → CO-17 rules) ────────
    5.00 ÷ 3 does not terminate. CO-14 could not settle what `avg` should do
    there — a 1-argument aggregate has nowhere to carry a precision + mode —
    so it RESERVED the cell and this row pinned the float promotion `avg`
    had always had, marked as the row that must change when #1044 ruled.
    #1044 has ruled (CO-17): the core lane REFUSES BY NAME rather than
    defaulting, and the refusal names $math:div-decimal — the one ruled
    precision+mode context — so a caller who needs a quotient here is told
    exactly where to go. The float is GONE from this cell: it was the last
    place an exact fold silently produced a binary float.
    This row and its 017a operator twin below now AGREE, which is the point:
    `[$avg xs]` and `[/ [$sum xs] [$count xs]]` agree on the refusal exactly
    as they already agreed on the answer. ]
 [case id=program-num-aggregate-co14-017-avg-nonterminating-refuses level=core
  [tags aggregate avg decimal non-terminating CXER3002 div-decimal CO-14 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg (1.00, 2.00, 2.00)]
#]]
  [out-text [#
[err code=cx-err:CXER3002 message='$avg: non-terminating exact division — supply an explicit rounding context (precision + mode) with [$math:div-decimal a b {precision: N mode: :half-up}] (L44)']
#]]
 ]

 [; 017's operator twin — the SAME division written through `/`. Under CO-14
    these two rows were the BOUNDARY between what was ruled (the fold) and
    what was not (the rounding), and the gap between them was pinned so it
    could not drift closed by accident. CO-17 closes it deliberately: both
    refuse, and both name the context. Only the head differs in the message,
    which is exactly what "one implementation, all spellings" (#598) means. ]
 [case id=program-num-aggregate-co14-017a-operator-refuses-nonterminating level=core
  [tags arithmetic operator decimal division non-terminating CXER3002 L44 CO-14 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[/ [+ 1.00 2.00 2.00] 3]
#]]
  [out-text [#
[err code=cx-err:CXER3002 message='/: non-terminating exact division — supply an explicit rounding context (precision + mode) with [$math:div-decimal a b {precision: N mode: :half-up}] (L44)']
#]]
 ]

 [case id=program-num-aggregate-co14-018-avg-multiarg level=core
  [tags aggregate avg multi-arg builtin dispatch CO-14]
  [; §6.5 says all four aggregates take positional scalars as well as one
     sequence, but `avg` alone rejected them ("an argument does not satisfy
     the builtin signature") — it was the one aggregate not sharing the
     sum/min/max argument shape. Sharing the classifier fixed both. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg 10 20 30]
#]]
  [out-text [#
2.0e1
#]]
 ]

 [case id=program-num-aggregate-co14-019-avg-int-stays-float level=core
  [tags aggregate avg int float unchanged CO-14]
  [; The unchanged half: with no exact operand, `avg` is a float mean
     exactly as §6.5 has always said. ]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$avg (10, 20, 30)]
#]]
  [out-text [#
2.0e1
#]]
 ]

 [; ── fn:number string-leniency meets the discipline ─────────────────────
    The aggregates keep XPath's string-leniency, and the two halves of it
    land on opposite sides of the exact boundary by what fn:number
    PRODUCES: an integer-valued string is an int and embeds losslessly; a
    fractional one is a double, and a double is the refused mix. ]
 [case id=program-num-aggregate-co14-020-int-string-embeds level=core
  [tags aggregate sum decimal string-leniency fn-number CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (19.99, "5")]
#]]
  [out-text [#
24.99
#]]
 ]

 [case id=program-num-aggregate-co14-021-fractional-string-refused level=core
  [tags aggregate sum decimal string-leniency fn-number CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum (19.99, "1.5")]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; ── the node-set surface ───────────────────────────────────────────────
    `[$sum $doc//@value]` is the aggregate's headline use, and it is where a
    money column actually lives. Both directions over real attributes. ]
 [case id=program-num-aggregate-co14-022-nodeset-decimal-exact level=core
  [tags aggregate sum nodeset cxpath decimal exact-family CO-14]
  [in-cx [#
[items
  [i v::decimal=19.99]
  [i v::decimal=19.99]]
#]]
  [in-code [#
[$sum $doc//i@v]
#]]
  [out-text [#
39.98
#]]
 ]

 [case id=program-num-aggregate-co14-023-nodeset-mixed-refuses level=core
  [tags aggregate sum nodeset cxpath decimal float CXER0100 CO-14]
  [; One float-typed attribute in a decimal column refuses the whole fold
     rather than quietly re-typing the column. ]
  [in-cx [#
[items
  [i v::decimal=19.99]
  [i v=1.5e0]]
#]]
  [in-code [#
[$sum $doc//i@v]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; ── streamed and materialized agree ────────────────────────────────────
    The refusal short-circuits at the operand that completes the mix, so a
    lazy source stops being pulled the moment the verdict is fixed. That is
    an optimisation, never a semantic: these two rows are the generator
    twins of 008 and 001 and must answer identically. ]
 [case id=program-num-aggregate-co14-024-streamed-exact-matches level=core
  [tags aggregate sum decimal generator streaming CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum [?for [in $x (19.99, 19.99)] [yield $x]]]
#]]
  [out-text [#
39.98
#]]
 ]

 [case id=program-num-aggregate-co14-025-streamed-refusal-matches level=core
  [tags aggregate sum decimal float generator streaming CXER0100 CO-14]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$sum [?for [in $x (39.98, 1.5e0)] [yield $x]]]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$sum: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; ══ #1044 / CO-17 — $div and $idiv join the exact lane ══════════════════
    The last two arithmetic builtins still refusing the exact family with
    #38's "argument 1 is not numeric". That refusal was never a rule: it
    was the placeholder for an exact path that did not exist yet, and
    `%`/`[$mod]` (#1016) and the aggregates (#1046) have already retired
    their copies of it. Every row below was red-proven against the pre-fix
    binary, where all of them read `div: argument 1 is not numeric` /
    `idiv: argument 1 is not numeric`. ]

 [; The whole point of the ruling: `[$div a b]` is a SECOND SPELLING of the
    exact `/` fold, not a second implementation of it, so the two cannot
    disagree on kind, scale, or refusal (#598). These rows pin the equality
    itself rather than a transcribed literal — a divergence in EITHER
    direction breaks them. ]
 [case id=program-num-div-co17-001-agrees-with-operator level=core
  [tags numeric div operator decimal exact-family L44 CO-17 598]
  [in-cx [#
[empty]
#]]
  [in-code [#
([= [$div 1.00 8] [/ 1.00 8]], [= [$div 39.98 2.00] [/ 39.98 2.00]])
#]]
  [out-text [#
(true, true)
#]]
 ]

 [; The cx_exact_div scale convention CO-17 names, transcribed once so the
    convention itself is visible: 1.00 ÷ 8 strips three 2s from the
    denominator, so the quotient carries scale 3 + 2 = 5. Trailing zeros are
    data — this is 0.12500, not 0.125. ]
 [case id=program-num-div-co17-002-terminating-is-exact-decimal level=core
  [tags numeric div decimal exact-family scale L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
([$div 1.00 8], [$div 39.98 2.00], [$div -1.00 8])
#]]
  [out-text [#
(0.12500, 19.99000, -0.12500)
#]]
 ]

 [; THE RULED REFUSAL. A non-terminating exact quotient has no exact decimal
    image and L44 §5 will not pick a scale and a mode for the caller, so the
    core lane refuses BY NAME — naming $math:div-decimal, the one ruled
    precision+mode context, so the caller is told where to go rather than
    handed a hidden default. ]
 [case id=program-num-div-co17-003-nonterminating-refuses-by-name level=core
  [tags numeric div decimal non-terminating CXER3002 div-decimal L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$div 1.00 3]
#]]
  [out-text [#
[err code=cx-err:CXER3002 message='$div: non-terminating exact division — supply an explicit rounding context (precision + mode) with [$math:div-decimal a b {precision: N mode: :half-up}] (L44)']
#]]
 ]

 [; The refusal is not a dead end: the context it names ANSWERS the very
    division that was refused. This row is the other half of 003 — read
    together they are the whole ruling, the refusal and its remedy. ]
 [case id=program-num-div-co17-004-named-context-answers-it level=core
  [tags numeric div decimal non-terminating div-decimal rounding-context CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/math']
[$math:div-decimal 1.00 3 {precision: 4 mode: :half-up}]
#]]
  [out-text [#
0.3333
#]]
 ]

 [; bigint operands take the same lane — exact when the quotient terminates,
    the named refusal when it does not. Neither cell may saturate into an
    f64, which is what the pre-fix "not numeric" refusal was guarding
    against by refusing outright. ]
 [case id=program-num-div-co17-005-bigint-terminating level=core
  [tags numeric div bigint exact-family no-saturation L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$div 10000000000000000000 4]
#]]
  [out-text [#
2500000000000000000.00
#]]
 ]

 [case id=program-num-div-co17-006-bigint-nonterminating-refuses level=core
  [tags numeric div bigint non-terminating CXER3002 L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$div 10000000000000000000 3]
#]]
  [out-text [#
[err code=cx-err:CXER3002 message='$div: non-terminating exact division — supply an explicit rounding context (precision + mode) with [$math:div-decimal a b {precision: N mode: :half-up}] (L44)']
#]]
 ]

 [; No silent bridge, here either — `[cast]` is the only decimal↔float
    crossing, and `[$div]` refuses the mix with the same code and message
    the heads and the aggregates raise. ]
 [case id=program-num-div-co17-007-decimal-float-unbridged level=core
  [tags numeric div decimal float unbridged CXER0100 L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$div 1.00 1.5e0]
#]]
  [out-text [#
[err code=cx-err:CXER0100 message='$div: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; Divide-by-zero stays CXER0101 in the exact lane — it is an arithmetic
    trap, never a rounding question, so it must not be absorbed into the
    CXER3002 refusal above. ]
 [case id=program-num-div-co17-008-exact-divide-by-zero level=core
  [tags numeric div idiv decimal divide-by-zero CXER0101 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
([$div 1.00 0], [$idiv 1.00 0])
#]]
  [out-text [#
([err code=cx-err:CXER0101 message='division by zero'], [err code=cx-err:CXER0101 message='division by zero'])
#]]
 ]

 [; The UNCHANGED half. CO-17 rules the exact family only: §6.5's int/int
    and int/float rows for `div` are untouched, so `[$div 7 2]` is still the
    integer 3 and not the exact 3.5 the decimal lane would give. ]
 [case id=program-num-div-co17-009-int-rows-unchanged level=core
  [tags numeric div int float unchanged CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
([$div 7 2], [$div 7 2.0e0])
#]]
  [out-text [#
(3, 3.5e0)
#]]
 ]

 [; ── $idiv over the exact family ────────────────────────────────────────
    §6.5 already says what `idiv` MEANS — integer division truncating
    toward zero, regardless of operand kinds — so the exact lane had only
    to compute it, not to invent it. CXER3002 cannot arise: an integral
    quotient always terminates, so `idiv` never needs the rounding context
    `div` must ask for. Result kind is the exact family's integral
    representation: int while it fits i64, bigint past it. ]
 [case id=program-num-idiv-co17-010-decimal-integral-quotient level=core
  [tags numeric idiv decimal exact-family truncation L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
([$idiv 10.00 3], [$idiv 39.98 2.00], [$idiv -10.00 3])
#]]
  [out-text [#
(3, 19, -3)
#]]
 ]

 [; `[$idiv 10.00 3]` answers where `[$div 10.00 3]` refuses, and that is
    not an inconsistency — it is the difference between asking for the
    integral quotient (always exact) and asking for the full one (not
    representable here). This row pins the pair so neither drifts onto the
    other's rule. ]
 [case id=program-num-idiv-co17-011-answers-where-div-refuses level=core
  [tags numeric idiv div decimal non-terminating boundary CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$idiv 10.00 3]
#]]
  [out-text [#
3
#]]
 ]

 [; The divmod identity — `a = b × idiv(a,b) + mod(a,b)` — over exact
    operands, both halves truncating toward zero. `%` got its exact lane in
    #1016 and `idiv` gets its complement here, so this holds by
    construction rather than by coincidence; it is the check that the two
    lanes agree on which way the truncation goes. ]
 [case id=program-num-idiv-co17-012-divmod-identity-holds level=core
  [tags numeric idiv mod decimal exact-family identity L44 CO-17 1016]
  [in-cx [#
[empty]
#]]
  [in-code [#
([= 10.00 [+ [* [$idiv 10.00 3] 3] [% 10.00 3]]], [= -10.00 [+ [* [$idiv -10.00 3] 3] [% -10.00 3]]])
#]]
  [out-text [#
(true, true)
#]]
 ]

 [; The quotient exceeds i64, so it comes back bigint rather than a
    saturated i64 — L44's no-silent-saturation rule, and the reason the
    result kind is "int while it fits" and not "int". ]
 [case id=program-num-idiv-co17-013-over-i64-quotient-is-bigint level=core
  [tags numeric idiv bigint no-saturation exact-family L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$idiv 100000000000000000000 2]
#]]
  [out-text [#
50000000000000000000
#]]
 ]

 [; The v0.17.0 audit's silent band (version-literal-ok): strconv.parse_int
    SATURATES out-of-range input instead of erroring, so every integral image
    in (i64.max, 2^64) came back as a clamped i64.max — co17-013's operand sat
    one binade ABOVE the band, so the suite was green while L44's
    no-silent-saturation rule was violated. These pin the band itself, for
    each verb that narrows an exact integral image to int-or-bigint. ]
 [case id=program-num-idiv-band-quotient-is-bigint level=core
  [tags numeric idiv bigint no-saturation band exact-family L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$idiv 20000000000000000000 2]
#]]
  [out-text [#
10000000000000000000
#]]
 ]

 [case id=program-num-floor-band-is-bigint level=core
  [tags numeric floor bigint no-saturation band exact-family L44]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$floor 10000000000000000000.5]
#]]
  [out-text [#
10000000000000000000
#]]
 ]

 [case id=program-num-ceiling-band-is-bigint level=core
  [tags numeric ceiling bigint no-saturation band exact-family L44]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$ceiling 10000000000000000000.5]
#]]
  [out-text [#
10000000000000000001
#]]
 ]

 [case id=program-num-idiv-band-divmod-identity level=core
  [tags numeric idiv mod divmod-identity band bigint exact-family L44 CO-17]
  [in-cx [#
[empty]
#]]
  [in-code [#
[= 10000000000000000000 [+ [* 1 [$idiv 10000000000000000000 1]] [% 10000000000000000000 1]]]
#]]
  [out-text [#
true
#]]
 ]

 [; The int-only lane is CHECKED, like `[+ i i]`: the one int ÷ int cell whose
    quotient leaves i64 (MIN ÷ -1 = 2^63) refuses CXER3000 — before this pin
    it answered a saturated i64.max, and |MIN| answered MIN itself. `/` is true
    division, so its cell answers the exactly-representable float 2^63 instead. ]
 [case id=program-num-idiv-int-min-neg1-refuses level=core
  [tags numeric idiv int overflow CXER3000 checked L44]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$idiv -9223372036854775808 -1]
#]]
  [out-err [#
cx-err:CXER3000
#]]
 ]

 [case id=program-num-div-int-min-neg1-refuses level=core
  [tags numeric div int overflow CXER3000 checked L44]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$div -9223372036854775808 -1]
#]]
  [out-err [#
cx-err:CXER3000
#]]
 ]

 [case id=program-num-abs-int-min-refuses level=core
  [tags numeric abs int overflow CXER3000 checked L44]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$abs -9223372036854775808]
#]]
  [out-err [#
cx-err:CXER3000
#]]
 ]

 [case id=program-num-divide-int-min-neg1-is-float level=core
  [tags numeric divide int no-saturation true-division L44]
  [in-cx [#
[empty]
#]]
  [in-code [#
[/ -9223372036854775808 -1]
#]]
  [out-text [#
9.223372036854776e18
#]]
 ]

 [; int ÷ int computes in i64, never through f64: past 2^53 the float route
    rounded the DIVIDEND before dividing, so an exact odd operand answered the
    wrong integer with exit 0. ]
 [case id=program-num-div-int-past-2p53-is-exact level=core
  [tags numeric div int precision exact L44]
  [in-cx [#
[empty]
#]]
