[err code=cx-err:CXER0100 message='$idiv: decimal/bigint arithmetic admits only int/bigint/decimal operands — [cast] is the only decimal↔float bridge (L44)']
#]]
 ]

 [; The unchanged half for `idiv`: no exact operand, no change. ]
 [case id=program-num-idiv-co17-015-int-row-unchanged level=core
