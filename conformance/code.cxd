 [case id=program-for-fail-fast-002-par-err-short-circuit level=core
  [tags for fail-fast par err short-circuit stream-2 grammar-129r]
  [meta [#
note: under [par], [fail-fast] short-circuits on the FIRST observed
note: err (stop dispatching queued items, discard in-flight) instead
note: of the default earliest-input-index surfacing. One err in the
note: input keeps the result deterministic.
#]]
  [in-cx [#
[ignored]
#]]
