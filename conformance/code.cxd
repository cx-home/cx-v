 [case id=program-cxpath-pred-attr-type-test level=core
  [tags cxpath binding-path predicate attr-type-test issue-772]
  [meta [#
note: #772 — `[@name::T]` (§5.2 rule 14, the predicate position): the
note: attribute must exist AND its value's kind must be T. The parser
note: previously dropped the type name, degrading every type-test
note: predicate to an existence test (type-blind, matched any @age).
#]]
  [in-cx [#
[people
  [x age::int=5]
  [x age=n]
  [x]]
#]]
  [in-code [#
[r [$count $doc/x[@age::int]] [$count $doc/x[@age::string]] [$count $doc/x[@age]]]
#]]
  [out-text [#
[r 1 1 2]
#]]
 ]

