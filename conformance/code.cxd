  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $rs ([webhook path="/a"], [webhook path="/b"])]
  [?for [in $r $rs] [where [= [$concat '' $r@path] '/a']] [yield $r]]]
#]]
