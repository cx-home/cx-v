  [in-cx [#
[empty]
#]]
  [in-code [#
[?def dbl ($x) [* $x 2]]
[?if [$iterate $dbl 1] [then "t"] [else "f"]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

