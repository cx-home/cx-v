 [# datetime ranges step by a duration literal. Datetime endpoints are sourced
    from in-cx data (datetime literals do not lex in code-expression position;
    the spec form `[$range $t0 $t1 24h]` binds $t0/$t1 from data or time builtins). #]
 [case id=program-gen-range-datetime-001-duration-step level=core
  [tags range datetime duration step count]
  [in-cx [# [span [from 2026-01-01T00:00:00Z] [to 2026-01-03T00:00:00Z]] #]]
  [in-code [# [$count [$range $doc/from $doc/to 24h]] #]]
  [out-text [# 3 #]]
 ]
