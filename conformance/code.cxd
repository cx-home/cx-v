[?for [in $x (1, 2, 3, 4)] [par 2] [fail-fast] [where [?if [= $x 3] [then [/ 1 0]] [else true]]] [yield [n $x]]]
#]]
  [out-text [#
[err code=cx-err:CXER0101 message='division by zero']
#]]
 ]

