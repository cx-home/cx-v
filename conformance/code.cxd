1
#]]
 ]

 [case id=program-pvmatrix-009-doc-single-root-wildcard level=core
  [tags cxpath pvmatrix document parse single-root]
  [; R-A2: single-root parse results answer /* with the root element — the
     retired fast-path unwrap answered with the root's CHILDREN on the bare
     lane and refused on the count lane. One value, one answer. ]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $d [$cx:parse "[root [item x=1]]"]] [$count $d/*]]
#]]
