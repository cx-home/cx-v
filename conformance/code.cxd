  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $x [x::bigint 0x2a]] $x]
#]]
  [out-err [#
cx-err:CXER0109
#]]
 ]

 [case id=program-body-ascription-012-period-typed level=core
