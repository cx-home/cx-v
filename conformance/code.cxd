  [in-cx [#
[people [table[name::string age::int active::bool]]
 alice 30 true
 bob null false
]
#]]
  [in-code [#
[?let [= $p [$first $input//people]]
 [out [a $p[2, "age"]] [b [?for [in $r $p] [where $r.active] [yield $r.name]]]]]
#]]
  [out-text [#
[out [a null] [b ('alice')]]
#]]
 ]

