 [case id=cxast-001-command-def-projects-structured level=core
  [tags cx-module ast projection def command effects params stream-18 690 L146]
  [meta [#
note: [$cx:ast SOURCE] — the declaration-AST projection (modules/cx.md
note: §2.2). A command def projects with STRUCTURED params (kind/name/
note: type + default PRESENCE), the [152d-h] clauses (effects items,
note: requires, idempotent), returns, scope, and purity. This is the
note: structured input the agent-tool projection (x/tools.cx) consumes —
note: the def head + params are data-layer text runs, unreachable by
note: CXPath, so the AST lane is THE lane (stream-18 W1 probe program).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $src """
[?def refund-order scope=public impure [effects [write] [net]] [returns element] ($order-id::string $amount::decimal) [refunded $order-id]]
[?def archive-order scope=public impure [idempotent] [effects [write]] [requires cap:orders/archive] ($opts::map {}) [archived]]
"""]
      [= $j [$cx:ast $src]]
      [= $a [$contains $j '"type":"DefNode","name":"refund-order"']]
      [= $b [$contains $j '"effects":[{"cap":"write"},{"cap":"net"}]']]
      [= $c [$contains $j '{"kind":"positional","name":"order-id","type":"string"']]
      [= $d [$contains $j '"default":"{}"']]
      [= $e [$contains $j '"requires":["cap:orders/archive"]']]
      [= $f [$contains $j '"idempotent":true']]
      [= $g [$contains $j '"returns":"element"']]
  [?str '{$a}|{$b}|{$c}|{$d}|{$e}|{$f}|{$g}']]
#]]
  [out-text [#
'true|true|true|true|true|true|true'
#]]
 ]

 [case id=cxast-002-effects-presence-is-the-discriminator level=core
  [tags cx-module ast projection def command discriminator stream-18 690 L146]
  [meta [#
note: clause PRESENCE discriminates commands (stream 6): a pure def
note: with no [effects] clause OMITS the field entirely; a zero-item
note: [effects] clause projects as an EMPTY array (still a command).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $lookup [$cx:ast '[?def lookup-order scope=public ($id::string) [order $id]]']]
      [= $touch  [$cx:ast '[?def touch impure [effects] ($x::string) [t $x]]']]
      [= $a [$contains $lookup '"effects"']]
      [= $b [$contains $touch '"effects":[]']]
      [= $c [$contains $lookup '"purity":"pure"']]
  [?str '{$a}|{$b}|{$c}']]
#]]
  [out-text [#
'false|true|true'
#]]
 ]

 [case id=cxast-003-declaration-free-source-empty-program level=core
  [tags cx-module ast projection empty docs stream-18 690 L146]
  [meta [#
note: a source with no declarations AND no plain elements projects as
note: the bare Program object — every array is omitted when empty (the
note: ast.md omit-when-absent convention), never emitted as []. A plain
note: element rides the docs lane instead (cxast-006).
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $a [$cx:ast "# only a comment"]]
      [= $b [$cx:ast '[just-data [x 1]]']]
  [?str '{$a}|{$b}']]
#]]
  [out-text [#
'{"type":"Program"}|{"type":"Program","docs":["[just-data [x 1]]"]}'
#]]
 ]

 [case id=cxast-004-non-string-arg-refused level=core
  [tags cx-module ast projection error CXER0100 stream-18 690 L146]
  [meta [#
note: cx:ast takes a SOURCE STRING only. A value focus is refused —
note: canonical serialization quotes directive-head text runs, which
note: is not program-parseable source; silent coercion would project
note: an empty Program and hide the mistake.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:ast 42]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=cxast-006-docs-lane-verbatim-spans level=core
  [tags cx-module ast projection docs fn-doc spans stream-18 690 L146]
  [meta [#
note: the docs lane (modules/cx.md §2.2): top-level PLAIN element
note: spans ride the Program projection as VERBATIM source strings —
note: each parses cleanly as DATA on its own. This is THE doc lane for
note: the agent-tool projection and the doc-freshness gate: a
note: whole-module data parse degrades on program-bearing def bodies
note: (the stream-18 W5 finding); the spans lane is immune.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?let [= $src """
[fn-doc name=refund-order [summary '''Refund.''']]
[?def refund-order scope=public impure [effects] ($x::string) [r $x]]
[module-doc name=m [scope '''s''']]
"""]
      [= $j [$cx:ast $src]]
      [= $a [$contains $j '"docs":["[fn-doc name=refund-order [summary \'\'\'Refund.\'\'\']]"']]
  [?str '{$a}']]
#]]
  [out-text [#
'true'
#]]
 ]

 [case id=cxast-005-malformed-def-refused level=core
  [tags cx-module ast projection error CXER4100 stream-18 690 L146]
  [meta [#
note: a [?def] span that does not parse is CXER4100 (malformed CX
note: source) — loud, never a silently-skipped declaration.
#]]
  [in-cx [#
[empty]
#]]
  [in-code [#
[$cx:ast '[?def ($x) [no-name]]']
#]]
  [out-err [#
cx-err:CXER4100
#]]
 ]

 [case id=pred-017-purity-unclassified-builtin level=core gate=pending
  # gate=pending: this fixture predates the §6.5 bare-head=data invariant.
  # CXER0234 (E_PURITY_UNCLASSIFIED_BUILTIN) is "a reference to a BUILTIN
  # missing from the closed purity table" — but a bare `[no-such-builtin-name]`
  # head is DATA construction, not a builtin reference (a builtin call is
  # `[$name …]`, and `[$no-such-builtin-name]` is "no callable", never 0234).
  # Since the purity table is closed AND complete, CXER0234 is unreachable
  # from conformant user code — it is an internal table-completeness guard,
  # belonging in an impl unit test, not a user-facing conformance fixture.
  [tags def purity unclassified-builtin CXER0234 gate-34.10]
  [in-cx [#
[doc]
#]]
  [in-code [#
[?def f () [no-such-builtin-name]]
[f]
#]]
  [out-err [#
cx-err:CXER0234

## Fixtures (core — `cast` builtin per `spec/core/code.md` §6.5 P6)

The `cast` builtin (locked 2026-05-23) provides explicit kind-coercion
in lieu of a `to-int` / `to-float` family. Surface forms:

| Surface | Notes |
|---|---|
| `[cast value :type-tag]` | Canonical form — `cast` is a reserved operator head; the type-tag is an atom literal (e.g. `[cast "42" :int]`). |
| `cast(value, :type-tag)` | Signature notation only (arity/arguments) — NOT a call surface; the paren form is admitted only as a predicate FunctionCall (`spec/core/code.md` §6.3/§6.5). |

Target kinds: `:int`, `:float`, `:string`, `:bool`, `:atom`.
Compound type expressions (`[or T1 T2]`, `[sequence T]`) are
reserved for a follow-on iteration.

Invalid coercions (parse failure, unknown kind, null source) yield
an `[err code='cx-err:CXER0290' …]` value per the err-value-propagation
convention (§9.2).
#]]
 ]

