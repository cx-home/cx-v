  [user active=true age=22 name=Bob]
  [user active=false age=40 name=Carol]]
#]]
  [in-code [#
$doc/user[and [= $_@active true] [> $_@age 25]]
#]]
  [out-text [#
[user active=true age=30 name=Alice]
