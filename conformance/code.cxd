  [tags for where take nested planar-equivalence order-barrier stream-2 L96]
  [meta [#
note: the σ-across-λ ORDER BARRIER ground truth — filtering OUTSIDE a
note: nested [take 5] (7 already truncated away → empty) is a different
note: relation than filtering INSIDE (7 survives): the two spellings
note: are NOT equivalent, which is exactly why the rewriter refuses to
note: push σ through λ (L96: order-fixing barriers).
#]]
  [in-cx [#
[ignored]
#]]
  [in-code [#
(
[?for [in $y [?for [in $x [$range 1 10]] [take 5] [yield $x]]] [where [= $y 7]] [yield $y]],
[?for [in $y [?for [in $x [$range 1 10]] [where [= $x 7]] [take 5] [yield $x]]] [yield $y]]
)
#]]
  [out-text [#
((), 7)
#]]
 ]

