 [case id=cmd-025-type-language-full-grammar level=core
  [tags def type-language returns stream-16 688 706 L65]
  [; ── stream 16 W1 (L65/#706): TypeExpr covers the FULL [155]-[158]
     grammar — any/number/iterator/document/the node family/refinements
     all parse structurally; [iterator T] joins [or]/[sequence] as a
     bracket head; a structural parse failure at a [returns] clause is a
     LOUD def-time diagnostic, never a silently-dropped slot.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def takes-doc [returns document] ($d::document) $d]
[?def takes-iter [returns [iterator int]] ($xs) [$iterate $xs]]
[?def takes-num [returns number] ($n::number) $n]
[?def union-ret [returns [or int string]] ($x) $x]
[?let
[= $ok1 [$takes-num 5]]
[= $ok2 [$takes-num 2.5e0]]
[= $u1 [$union-ret 7]]
[= $u2 [$union-ret "s"]]
[= $bad [?fallback [?def broken [returns [zap int]] ($x) $x] [recover-with [context] [code $err@code]]]]
  [probe [n1 $ok1] [n2 $ok2] [u1 $u1] [u2 $u2] [malformed $bad]]]
#]]
  [out-text [#
[probe [n1 5] [n2 2.5e0] [u1 7] [u2 's'] [malformed [code 'cx-err:CXER0100']]]
#]]
 ]

 [case id=cmd-026-strict-structural-checks level=core
  [tags def strict-mode type-language stream-16 688 706 CXER0206 CXER0207]
  [; ── under --strict the COMPLETED checker enforces structurally: a
     union return admits exactly its members (a bool return against
     [or int string] refuses 0207); a [sequence int] parameter checks
     every item (a mixed sequence refuses 0206); temporals check by
     KIND (a string is not a datetime — the largest silent-pass class
     closed); number admits int and float.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?def union-ret [returns [or int string]] ($x) $x]
[?def sums [returns int] ($xs::[sequence int]) [$sum $xs]]
[?def stamps [returns datetime] ($t::datetime) $t]
[?let
[= $ok [$sums (1, 2, 3)]]
[= $bad-ret [?fallback [$union-ret true] [recover-with [context] [code $err@code]]]]
[= $bad-seq [?fallback [$sums (1, "two", 3)] [recover-with [context] [code $err@code]]]]
[= $ok-dt [$stamps 2026-08-13T00:00:00Z]]
[= $bad-dt [?fallback [$stamps "2026-08-13"] [recover-with [context] [code $err@code]]]]
  [probe [sum $ok] [union-refuses $bad-ret] [seq-refuses $bad-seq] [dt $ok-dt] [dt-refuses $bad-dt]]]
#]]
  [out-text [#
[probe [sum 6] [union-refuses [code 'cx-err:CXER0207']] [seq-refuses [code 'cx-err:CXER0206']] [dt 2026-08-13T00:00:00Z] [dt-refuses [code 'cx-err:CXER0206']]]
#]]
 ]

 [case id=eff-trace-001-order-observed level=core rule=EV-EFFECT-SET
  [tags effects out-effects trace stream-22 694]
  [; ── the out-effects channel (stream 22 W1): the ordered
     admitted-effect-point trace — one capability:resource line per
     effect the gate admits, exact in order AND count. This case and
     its reversed twin form the channel's own discriminator pair: an
     unordered (multiset) reading grades both identically; the ordered
     reading tells them apart.]
  [in-cx [#
[empty]
#]]
  [in-code [#
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/time']
[?let [= $h [$env:var "HOME"]]
  [?let [= $t [$time:now]]
    [ok]]]
#]]
  [out-text [#
[ok]
#]]
  [out-effects [#
env:env-var
clock:time-now
#]]
 ]

