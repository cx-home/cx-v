 [; #923 (RULED: BC-1): a bare attribute value is ONE ws-delimited RUN
    auto-typed by the data core — the program reading of the bytes IS the
    data reading. `host=0.0.0.0` used to truncate to float 0.0 and spill
    `.0.0` as two phantom body items at rc=0 (the #917 silent-mangle class
    in attribute position).

    ADDRESS MOVEMENT, #991 (RULED: CO-12): `when` now images BARE. This
    case was the deviation-1 defect standing in plain sight — it asserted
    in one line that `$e@when` IS a `date` and that the same attribute
    images as `when='2026-01-01'`, a spelling that re-parses as a STRING.
    Both halves passed because the emitter was a FIXED POINT: re-emitting
    the wrongly-typed value reproduced the same text. The `date` half was
    always right; the image half has been corrected to match it, and the
    case now says what its own title claims — the program reading of the
    bytes IS the data reading, image included. ]
 [case id=program-attr-bare-001-run-is-the-string level=core
  [tags attr bare-value run parity issue-923 991 co-12]
  [title multi-dot / ident-run / date bare attr values read as the data reading reads them]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $e [server host=0.0.0.0 tls=true ver=v1.2.3 when=2026-01-01]] ($e, [?match $e@host [case $v::string str] [else other]], [?match $e@when [case $v::date date] [else other]])]
#]]
  [out-text [#
([server host='0.0.0.0' tls=true ver='v1.2.3' when=2026-01-01], str, date)
#]]
 ]

 [case id=program-attr-bare-002-run-shapes level=core
  [tags attr bare-value run parity issue-923]
  [title runs the program lexer used to refuse loudly (1a, 1:2, urn:x:y) are the data reading's strings]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $e [e a=1-2 b=1a c=1:2 d=urn:x:y]] $e]
#]]
  [out-text [#
[e a='1-2' b='1a' c='1:2' d=urn:x:y]
#]]
 ]

 [case id=program-attr-bare-003-slash-run-refuses-loud level=core
  [tags attr bare-value run cxpath refusal issue-923]
  [title a /-bearing run whose prefix is not a path head refuses with the quote-the-value hint — never a silent mangle]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $z 0] [e a=1.2.3/x]]
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=program-attr-bare-004-pattern-parity level=core
  [tags attr bare-value pattern match issue-923]
  [title pattern attr tests read bare runs exactly as construction does — string vs string, capture carries the run]
  [in-cx [#
[ignored]
#]]
  [in-code [#
[?let [= $e [server host=0.0.0.0]] ([?match $e [case [server host=0.0.0.0] hit] [else miss]], [?match $e [case [server @host=$v] $v] [else miss]])]
#]]
  [out-text [#
(hit, '0.0.0.0')
#]]
 ]

