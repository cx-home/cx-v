[test-suite name=binding-api ring=0
  [doc [#
# Binding API Parity Fixtures — Layer-1 conformance contract
#
# Normative reference: spec/bindings.md §4.1.
# Gate: 28.6 (Layer-1 byte-identical parity across V/Python/Go/Rust).
#
# Each fixture asserts that an identical Layer-1 method invocation
# produces byte-identical output across every supported binding. The
# Layer-1 contract is "same call → same bytes." Drift on any fixture
# blocks the release.
#
# Fixture format (per spec/bindings.md §4.1):
#   --- in_cx       input document, canonical CX
#   --- call        binding-agnostic Layer-1 invocation
#   --- out_text    expected result, canonical CX (for non-error cases)
#   --- out_err     expected error code (for error cases)
#   --- options     fixture-level options (optional)
#
# Call mini-syntax:
#   doc.<method>(<args>)             — method on root Doc
#   doc.<method>(<args>).<chain>()   — chained call; intermediate is Layer-1 typed
#   cx.<Constructor>(<args>)         — Action constructor for doc.modify
#
# Bindings provide a small harness that translates the call line into
# their host syntax (case-adjusts method names, constructs Action
# values). Translation is mechanical — no language-specific behavior
# escapes into the fixture.

# ═════════════════════════════════════════════════════════════════
# §1. parse / bytes / hash / equals — core round-trip
# ═════════════════════════════════════════════════════════════════
#]]

 [case id=binding-api-001-parse-empty-root
  [in-cx [#
[root]
#]]
  [call [#
doc.bytes()
#]]
  [out-text [#
[root]
#]]
 ]

 [case id=binding-api-002-parse-attribute
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
doc.bytes()
#]]
  [out-text [#
[user id=1 name=Alice]
#]]
 ]

 [case id=binding-api-003-hash-determinism
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
doc.hash()
#]]
  [out-text [#
"sha2-256:<deterministic-32-bytes-hex>"
#]]
 ]

 [case id=binding-api-004-equals-canonical-form
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
doc.equals(doc.parse(doc.bytes()))
#]]
  [out-text [#
true
#]]
 ]

 [case id=binding-api-005-equals-attribute-order-significant
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
# bindings.md §4: equals = CANONICAL-BYTES equality, and canonical.md
# ("Attribute order is never a normalization axis") preserves source
# insertion order — so a reordered document is NOT equal. Corrected
# 2026-08-05 during the G1 identity-hash fixture work: the original
# expectation (true) contradicted both specs and predated any binding
# implementation (0/49 verified).
doc.equals(doc.parse('[user name="Alice" id=1]'))
#]]
  [out-text [#
false

# ═════════════════════════════════════════════════════════════════
# §2. eval — wraps cx_code_eval
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-010-eval-simple-literal ring=1
  [in-cx [#
[root]
#]]
  [call [#
doc.eval("42")
#]]
  [out-text [#
42
#]]
 ]

 [case id=binding-api-011-eval-against-doc-binding ring=1
  [in-cx [#
[users [user id=1 name="Alice"] [user id=2 name="Bob"]]
#]]
  [call [#
doc.eval("count(//user)")
#]]
  [out-text [#
2
#]]
 ]

 [case id=binding-api-012-eval-error-code-propagates ring=1
  [in-cx [#
[root]
#]]
  [call [#
doc.eval("[?unknown-directive]")
#]]
  [out-err [#
cx-err:CXER0100

# ═════════════════════════════════════════════════════════════════
# §3. select_all — CXPath path-value
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-020-select-all-basic ring=1
  [in-cx [#
[users [user id=1] [user id=2] [user id=3]]
#]]
  [call [#
doc.select_all("//user")
#]]
  [out-text [#
[user id=1]
[user id=2]
[user id=3]
#]]
 ]

 [case id=binding-api-021-select-all-with-predicate ring=1
  [in-cx [#
[users [user id=1 active=true] [user id=2 active=false] [user id=3 active=true]]
#]]
  [call [#
doc.select_all("//user[= $_@active true]")
#]]
  [out-text [#
[user id=1 active=true]
[user id=3 active=true]
#]]
 ]

 [case id=binding-api-022-select-all-attribute ring=1
  [in-cx [#
[users [user email="a@x.com"] [user email="b@x.com"]]
#]]
  [call [#
doc.select_all("//user/@email")
#]]
  [out-text [#
"a@x.com"
"b@x.com"
#]]
 ]

 [case id=binding-api-023-select-all-empty-result ring=1
  [in-cx [#
[users]
#]]
  [call [#
doc.select_all("//user")
#]]
  [out-text [##]]
 ]

 [case id=binding-api-024-select-all-axis-following-sibling ring=1
  [in-cx [#
[doc [item n=1] [item n=2] [item n=3]]
#]]
  [call [#
doc.select_all("//item[1]/following-sibling::item")
#]]
  [out-text [#
[item n=2]
[item n=3]
#]]
 ]

 [case id=binding-api-025-select-all-positional-predicate ring=1
  [in-cx [#
[doc [item n=1] [item n=2] [item n=3]]
#]]
  [call [#
doc.select_all("//item[2]")
#]]
  [out-text [#
[item n=2]
#]]
 ]

 [case id=binding-api-026-select-all-malformed-cxpath ring=1
  [in-cx [#
[root]
#]]
  [call [#
doc.select_all("//user[")
#]]
  [out-err [#
cx-err:CXER0100

# ═════════════════════════════════════════════════════════════════
# §4. select — first match
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-030-select-first-match ring=1
  [in-cx [#
[users [user id=1 name="Alice"] [user id=2 name="Bob"]]
#]]
  [call [#
doc.select("//user")
#]]
  [out-text [#
[user id=1 name=Alice]
#]]
 ]

 [case id=binding-api-031-select-no-match-returns-null ring=1
  [in-cx [#
[users]
#]]
  [call [#
doc.select("//user")
#]]
  [out-text [#
()

# ═════════════════════════════════════════════════════════════════
# §5. modify — pure-functional updates
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-040-modify-set ring=1
  [in-cx [#
[users [user id=1 name="Alice"]]
#]]
  [call [#
doc.modify("//user[= $_@id 1]/@name", cx.Set("Alpha")).bytes()
#]]
  [out-text [#
[users
  [user id=1 name=Alpha]
]
#]]
 ]

 [case id=binding-api-041-modify-delete ring=1
  [in-cx [#
[users [user id=1] [user id=2 banned=true] [user id=3]]
#]]
  [call [#
doc.modify("//user[= $_@banned true]", cx.Delete()).bytes()
#]]
  [out-text [#
[users
  [user id=1]
  [user id=3]
]
#]]
 ]

 [case id=binding-api-042-modify-rename ring=1
  [in-cx [#
[doc [widget a=1] [widget b=2]]
#]]
  [call [#
doc.modify("//widget", cx.Rename("component")).bytes()
#]]
  [out-text [#
[doc
  [component a=1]
  [component b=2]
]
#]]
 ]

 [case id=binding-api-043-modify-set-attr ring=1
  [in-cx [#
[doc [user id=1]]
#]]
  [call [#
doc.modify("//user", cx.SetAttr("status", "verified")).bytes()
#]]
  [out-text [#
[doc
  [user id=1 status=verified]
]
#]]
 ]

 [case id=binding-api-044-modify-delete-attr ring=1
  [in-cx [#
[doc [user id=1 temp="x"]]
#]]
  [call [#
doc.modify("//user", cx.DeleteAttr("temp")).bytes()
#]]
  [out-text [#
[doc
  [user id=1]
]
#]]
 ]

 [case id=binding-api-045-modify-append ring=1
  [in-cx [#
[doc [section id="intro" [para "First."]]]
#]]
  [call [#
doc.modify("//section", cx.Append('[para "Second."]')).bytes()
#]]
  [out-text [#
[doc
  [section id=intro
    [para First.]
    [para Second.]
  ]
]
#]]
 ]

 [case id=binding-api-046-modify-prepend ring=1
  [in-cx [#
[doc [section id="intro" [para "Body."]]]
#]]
  [call [#
doc.modify("//section", cx.Prepend('[para "Lead."]')).bytes()
#]]
  [out-text [#
[doc
  [section id=intro
    [para Lead.]
    [para Body.]
  ]
]
#]]
 ]

 [case id=binding-api-047-modify-insert-before ring=1
  [in-cx [#
[doc [item n=1] [item n=2]]
#]]
  [call [#
doc.modify("//item[= $_@n 2]", cx.InsertBefore('[item n="1.5"]')).bytes()
#]]
  [out-text [#
[doc
  [item n=1]
  [item n='1.5']
  [item n=2]
]
#]]
 ]

 [case id=binding-api-048-modify-insert-after ring=1
  [in-cx [#
[doc [item n=1] [item n=2]]
#]]
  [call [#
doc.modify("//item[= $_@n 1]", cx.InsertAfter('[item n="1.5"]')).bytes()
#]]
  [out-text [#
[doc
  [item n=1]
  [item n='1.5']
  [item n=2]
]
#]]
 ]

 [case id=binding-api-049-modify-replace ring=1
  [in-cx [#
[doc [user id=1 name="old"]]
#]]
  [call [#
doc.modify("//user", cx.Replace('[user id=1 name="new" email="n@x.org"]')).bytes()
#]]
  [out-text [#
[doc
  [user id=1 name=new email=n@x.org]
]
#]]
 ]

 [case id=binding-api-050-modify-zero-match-no-op ring=1
  [in-cx [#
[users [user id=1]]
#]]
  [call [#
doc.equals(doc.modify("//nonexistent", cx.Set("x")))
#]]
  [out-text [#
true
#]]
 ]

 [case id=binding-api-051-modify-multi-match ring=1
  [in-cx [#
[users [user id=1] [user id=2] [user id=3]]
#]]
  [call [#
doc.modify("//user", cx.SetAttr("seen", true)).bytes()
#]]
  [out-text [#
[users
  [user id=1 seen=true]
  [user id=2 seen=true]
  [user id=3 seen=true]
]
#]]
 ]

 [case id=binding-api-052-modify-set-attr-on-attribute-focus-error ring=1
  [in-cx [#
[doc [user id=1 name="A"]]
#]]
  [call [#
doc.modify("//user/@name", cx.SetAttr("status", "v"))
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=binding-api-053-modify-original-doc-unchanged ring=1
  [in-cx [#
[users [user id=1 name="Alice"]]
#]]
  [call [#
{ before: doc.bytes(); modified: doc.modify("//user/@name", cx.Set("Bob")); same: doc.bytes() == before; }
#]]
  [out-text [#
true

# ═════════════════════════════════════════════════════════════════
# §6. find_all — name-only convenience
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-060-find-all-by-name
  [in-cx [#
[users [user id=1] [group id=2] [user id=3]]
#]]
  [call [#
doc.find_all("user")
#]]
  [out-text [#
[user id=1]
[user id=3]
#]]
 ]

 [case id=binding-api-061-find-all-no-match
  [in-cx [#
[users [user id=1]]
#]]
  [call [#
doc.find_all("nonexistent")
#]]
  [out-text [#
# ═════════════════════════════════════════════════════════════════
# §7. root / name / attr / attrs / children / body / kind
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-070-root-name
  [in-cx [#
[users [user id=1]]
#]]
  [call [#
doc.root().name()
#]]
  [out-text [#
"users"
#]]
 ]

 [case id=binding-api-071-attr-by-name
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
doc.root().attr("name")
#]]
  [out-text [#
"Alice"
#]]
 ]

 [case id=binding-api-072-attr-not-present
  [in-cx [#
[user id=1]
#]]
  [call [#
doc.root().attr("name")
#]]
  [out-text [#
()
#]]
 ]

 [case id=binding-api-073-attrs-map
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
doc.root().attrs()
#]]
