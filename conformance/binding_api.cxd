"Hello, world."
#]]
 ]

 [case id=binding-api-076-kind-element
  [in-cx [#
[user id=1]
#]]
  [call [#
doc.root().kind()
#]]
  [out-text [#
"element"
#]]
 ]

 [case id=binding-api-077-kind-on-selected-attribute ring=1
  [in-cx [#
[user id=1]
#]]
  [call [#
doc.select("//user/@id").kind()
#]]
  [out-text [#
"scalar"

# ═════════════════════════════════════════════════════════════════
# §8. Chaining + composition
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-080-select-then-attr ring=1
  [in-cx [#
[users [user id=1 name="Alice"] [user id=2 name="Bob"]]
#]]
  [call [#
doc.select("//user[= $_@id 2]").attr("name")
#]]
  [out-text [#
"Bob"
#]]
 ]

 [case id=binding-api-081-modify-chain ring=1
  [in-cx [#
[doc [user id=1 name="old" banned=true]]
#]]
  [call [#
doc.modify("//user/@name", cx.Set("new")).modify("//user", cx.DeleteAttr("banned")).bytes()
#]]
  [out-text [#
[doc
  [user id=1 name=new]
]
#]]
 ]

 [case id=binding-api-082-select-all-count ring=1
  [in-cx [#
[doc [item n=1] [item n=2] [item n=3]]
#]]
  [call [#
doc.select_all("//item").count()
#]]
  [out-text [#
3

# ═════════════════════════════════════════════════════════════════
# §9. Error matrix — every Layer-1 error code surfaces with identical code
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-090-parse-error-malformed-cx
  [in-cx [#
[users [user id=1
#]]
  [call [#
# Note: this fixture's in_cx itself is malformed; the binding-side
# parse() must raise CXER0100 with no segfault, no panic.
doc
#]]
  [out-err [#
cx-err:CXER0100
#]]
 ]

 [case id=binding-api-091-modify-using-type-mismatch ring=1
  [in-cx [#
[users [user id=1 name="Alice"]]
#]]
  [call [#
doc.modify("//user", cx.Using(lambda n: n + 1))
#]]
  [out-err [#
cx-err:CXER0104

# ═════════════════════════════════════════════════════════════════
# §10. Stability — identical input → identical hash across bindings
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-100-hash-canonical-stability
  [in-cx [#
[users [user id=1 name="Alice"]]
#]]
  [call [#
doc.hash()
#]]
  [out-text [#
"sha256:<v0.8.0-stable-hex>"
#]]
 ]

 [case id=binding-api-101-hash-attribute-order-significant
  [in-cx [#
[user id=1 name="Alice"]
#]]
  [call [#
# Same correction as binding-api-005: hash = SHA-256 over canonical
# bytes (bindings.md §4), attribute order is never normalized
# (canonical.md), so reordering CHANGES the digest. Verified against
# the shipped cx_text_hash 2026-08-05 (the two documents produce
# distinct digests). Pinned as a pair case in identity_hash.cxd too.
doc.hash() == doc.parse('[user name="Alice" id=1]').hash()
#]]
  [out-text [#
false

# ═════════════════════════════════════════════════════════════════
# §11. Init / thread registration sanity (negative tests)
# ═════════════════════════════════════════════════════════════════
#]]
 ]

 [case id=binding-api-110-thread-register-required ring=1
  [in-cx [#
[users [user id=1]]
#]]
  [call [#
spawn { doc.select_all("//user") }
#]]
  [out-text [#
[user id=1]

# ═════════════════════════════════════════════════════════════════
# End of binding API parity suite. 49 fixtures (17 ring=0, 32 ring=1
# per-case — evaluation-dependent select/modify/eval cases elevate; the
# suite default stays ring=0 for the parse/emit/hash/equals/find/accessor
# surface).
#
# Status at -dev fixture-authoring milestone: 0/49 verified
# against any binding (Phase 4.2 deliverable; needs Phase 2 V impl +
# Phase 3 binding retargets).
# ═════════════════════════════════════════════════════════════════
#]]
 ]

# ═════════════════════════════════════════════════════════════════
# §12. I1 promoted kinds (L48) — decimal scale + bigint survive Layer-1
# ═════════════════════════════════════════════════════════════════

 [case id=binding-api-111-decimal-bigint-emit
  [in-cx [#
[order price=19.99 qty=99999999999999999999999 note=1.50]
#]]
  [call [#
doc.bytes()
#]]
  [out-text [#
[order price=19.99 qty=99999999999999999999999 note=1.50]
#]]
 ]

 [case id=binding-api-112-decimal-bigint-hash
  [in-cx [#
[order price=19.99 qty=99999999999999999999999 note=1.50]
#]]
  [call [#
doc.hash()
#]]
  [out-text [#
"sha2-256:93bb9787754a93d7118346336fc962eae5e87645452192623e3ae58a42c0c002"
#]]
 ]
]
