[data::bytes SGVsbG8=]
#]]
 ]

 [case id=017-anchor-define level=extended
  [tags anchor parse-ast]
  [in-cx [#
[defaults &def timeout=30 retries=3]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "defaults",
      "anchor": "def",
      "attrs": [
        {"name": "timeout", "value": 30, "dataType": "int"},
        {"name": "retries", "value": 3, "dataType": "int"}
      ]
    }
  ]
}
#]]
  [out-xml [#
<defaults cx:anchor="def" timeout="30" retries="3"/>
#]]
  [out-cx [#
[defaults &def timeout=30 retries=3]
#]]
 ]

 [case id=018-alias-node level=extended
  [tags alias parse-ast]
  [in-cx [#
[defaults &def timeout=30]
[*def]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "defaults",
      "anchor": "def",
      "attrs": [{"name": "timeout", "value": 30, "dataType": "int"}]
    },
    {
      "type": "Alias",
      "name": "def"
    }
  ]
}
#]]
  [out-xml [#
<defaults cx:anchor="def" timeout="30"/>
<cx:alias name="def"/>
#]]
  [out-cx [#
[defaults &def timeout=30]
[*def]
#]]
 ]

 [case id=019-anchor-merge level=extended
  [tags anchor merge parse-ast]
  [in-cx [#
[defaults &def timeout=30 retries=3]
[production *def host=prod.example.com retries=5]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "defaults",
      "anchor": "def",
      "attrs": [
        {"name": "timeout", "value": 30, "dataType": "int"},
        {"name": "retries", "value": 3, "dataType": "int"}
      ]
    },
    {
      "type": "Element",
      "name": "production",
      "merge": "def",
      "attrs": [
        {"name": "host", "value": "prod.example.com"},
        {"name": "retries", "value": 5, "dataType": "int"}
      ]
    }
  ]
}
#]]
  [out-xml [#
<defaults cx:anchor="def" timeout="30" retries="3"/>
<production cx:merge="def" host="prod.example.com" retries="5"/>
#]]
  [out-cx [#
[defaults &def timeout=30 retries=3]
[production *def host=prod.example.com retries=5]
#]]
 ]

 [case id=020-multidoc level=extended
  [tags multidoc document]
  [in-cx [#
[doc1
  [item a]
]
---
[doc2
  [item b]
]
#]]
  [out-ast [#
[
  {
    "type": "Document",
    "elements": [
      {
        "type": "Element",
        "name": "doc1",
        "items": [
          {
            "type": "Element",
            "name": "item",
            "items": [{"type": "Text", "value": "a"}]
          }
        ]
      }
    ]
  },
  {
    "type": "Document",
    "elements": [
      {
        "type": "Element",
        "name": "doc2",
        "items": [
          {
            "type": "Element",
            "name": "item",
            "items": [{"type": "Text", "value": "b"}]
          }
        ]
      }
    ]
  }
]
#]]
  [out-xml [#
<doc1>
  <item>a</item>
</doc1>
---
<doc2>
  <item>b</item>
</doc2>
#]]
  [out-cx [#
[doc1
  [item a]
]
---
[doc2
  [item b]
]
#]]
 ]

 [case id=021-typed-object level=extended
  [tags scalar typed object]
  [in-cx [#
[person
  [name Alice]
  [age 30]
  [active true]
  [score 9.5]
]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "person",
      "items": [
        {
          "type": "Element",
          "name": "name",
          "items": [{"type": "Text", "value": "Alice"}]
        },
        {
          "type": "Element",
          "name": "age",
          "items": [{"type": "Scalar", "dataType": "int", "value": 30}]
        },
        {
          "type": "Element",
          "name": "active",
          "items": [{"type": "Scalar", "dataType": "bool", "value": true}]
        },
        {
          "type": "Element",
          "name": "score",
          "items": [{"type": "Scalar", "dataType": "float", "value": 9.5}]
        }
      ]
    }
  ]
}
#]]
  [out-xml [#
<person>
  <name>Alice</name>
  <age>30</age>
  <active>true</active>
  <score>9.5</score>
</person>
#]]
  [out-cx [#
[person
  [name Alice]
  [age 30]
  [active true]
  [score 9.5]
]
#]]
 ]

 [case id=022-semantic-scalar level=extended
  [tags semantic json scalar]
  [in-cx [#
[port::int 8080]
#]]
  [out-json [#
{"port": 8080}
#]]
 ]

 [case id=023-semantic-nested level=extended
  [tags semantic json nested]
  [in-cx [#
[config
  [host localhost]
  [port::int 8080]
  [debug false]
]
#]]
  [out-json [#
{"config": {"host": "localhost", "port": 8080, "debug": false}}
#]]
 ]

 [case id=024-semantic-array-elements level=extended
  [tags semantic json array repeated]
  [in-cx [#
[users
  [user [name Alice]]
  [user [name Bob]]
]
#]]
  [out-json [#
{"users": {"user": [{"name": "Alice"}, {"name": "Bob"}]}}
#]]
 ]

 [case id=025-semantic-multi-root level=extended
  [tags semantic json multi-root]
  [in-cx [#
[host localhost]
[port::int 8080]
#]]
  [out-json [#
{"host": "localhost", "port": 8080}
#]]
 ]

 [case id=026-semantic-array-type level=extended
  [tags semantic json array-type]
  [in-cx [#
[tags::string[] admin user]
#]]
  [out-json [#
{"tags": ["admin", "user"]}
#]]
 ]

 [case id=027-attr-autotyping level=extended
  [tags attribute autotype typed-attr]
  [in-cx [#
[server host=localhost port=8080 debug=false]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "server",
      "attrs": [
        {"name": "host", "value": "localhost"},
        {"name": "port", "value": 8080, "dataType": "int"},
        {"name": "debug", "value": false, "dataType": "bool"}
      ]
    }
  ]
}
#]]
  [out-xml [#
<server host="localhost" port="8080" debug="false"/>
#]]
  [out-cx [#
[server host=localhost port=8080 debug=false]
#]]
  [out-json [#
{"server": {"debug": false, "host": "localhost", "port": 8080}}
#]]
 ]

 [case id=028-auto-array level=extended
  [tags array autotype typed-list]
  # @CHOICE-1 §9-one-layer: a whitespace scalar run is a TYPED LIST of discrete
  # typed children — NOT a `T[]` auto-array. No element cx:type; XML uses the
  # per-item `<cx:int>` carrier (distinct from the explicit `::T[]` `<item>` form).
  [in-cx [#
[scores 10 20 30]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "scores",
      "items": [
        {"type": "Scalar", "dataType": "int", "value": 10},
        {"type": "Scalar", "dataType": "int", "value": 20},
        {"type": "Scalar", "dataType": "int", "value": 30}
      ]
    }
  ]
}
#]]
  [out-xml [#
<scores><cx:int>10</cx:int><cx:int>20</cx:int><cx:int>30</cx:int></scores>
#]]
  [out-cx [#
[scores 10 20 30]
#]]
  [out-json [#
{"scores": [10, 20, 30]}
#]]
 ]

 [case id=029-inferred-array level=extended
  [tags array inferred-type type-annotation]
  # @CHOICE-1 §9-one-layer: the inferred-array annotation `::[]` KEEPS its `[]`
  # marker and each item keeps its OWN auto-type — heterogeneous, no concrete-type
  # inference, no int→float promotion (M-TYPED-ARRAY-2 / P2-INFERARR). Distinct
  # from an explicit `::T[]` (a uniform `T[]`) and from a whitespace typed list.
  [in-cx [#
[data::[] 1 2.5 3]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "data",
      "dataType": "[]",
      "items": [
        {"type": "Scalar", "dataType": "int", "value": 1},
        {"type": "Scalar", "dataType": "float", "value": 2.5},
        {"type": "Scalar", "dataType": "int", "value": 3}
      ]
    }
  ]
}
#]]
  [out-cx [#
[data::[] 1 2.5 3]
#]]
 ]

 [case id=034-empty-array level=extended
  [tags array empty type-annotation]
  [in-cx [#
[tags::string[]]
#]]
