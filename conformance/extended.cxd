[flags::bool[] true false true]
#]]
 ]

 [case id=038-triple-quoted level=extended
  [tags triple-quoted string multiline]
  [in-cx [#
[desc '''
  hello
  world
''']
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "desc",
      "items": [{"type": "Text", "value": "hello\nworld"}]
    }
  ]
}
#]]
  [out-cx [#
[desc 'hello
world']
#]]
  [out-xml [#
<desc>hello
world</desc>
#]]
 ]

 [case id=039-block-content level=extended
  [tags block-content mixed-content]
  [in-cx [#
[p [|hello world|]]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "p",
      "items": [
        {
          "type": "BlockContent",
          "items": [{"type": "Text", "value": "hello world"}]
        }
      ]
    }
  ]
}
#]]
  [out-xml [#
<p><cx:block>hello world</cx:block></p>
#]]
  [out-cx [#
[p [|hello world|]]
#]]
 ]

 [case id=040-interpolation-simple level=extended
  [tags cx interpolation]
  [in-cx [#
[?=@name]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {"type": "Interpolation", "expr": "@name"}
  ]
}
#]]
  [out-cx [#
[?=@name]
#]]
 ]

 [case id=041-interpolation-nested-brackets level=extended
  [tags cx interpolation bracket-balance]
  [in-cx [#
[p [?=//service[@port=8080]/@host]]
#]]
  [out-cx [#
[p [?=//service[@port=8080]/@host]]
#]]
 ]

 [case id=042-eval-directive-single-slot level=extended
  [tags cx eval-directive body-item]
  [in-cx [#
[?if [cond]]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "EvalDirective",
      "name": "if",
      "items": [
        {"type": "Element", "name": "cond"}
      ]
    }
  ]
}
#]]
  [out-cx [#
[?if [cond]]
#]]
 ]

 [case id=043-eval-directive-three-slot level=extended
  [tags cx eval-directive]
  [in-cx [#
[?if [cond] [then [yes]] [else [no]]]
#]]
  [out-cx [#
[?if [cond] [then [yes]] [else [no]]]
#]]
 ]

