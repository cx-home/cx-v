[p Version 3.0]
#]]
 ]

 [case id=010-no-autotype-quoted level=extended
  [tags scalar autotype text quoted]
  [in-cx [#
[status 'true']
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "status",
      "items": [{"type": "Text", "value": "true"}]
    }
  ]
}
#]]
  [out-xml [#
<status>true</status>
#]]
  [out-cx [#
[status 'true']
#]]
 ]

 [case id=011-no-autotype-child-element level=extended
  [tags scalar autotype element mixed-content]
  [- @CHOICE-1 / mixed-content (cxdm §1.2): a typed scalar token beside a
     child element is a DISCRETE TYPED CHILD (not merged into untyped text).
     `42` here is an int Scalar sibling of `[x]`, matching the program reader.
     (The legacy id "no-autotype" predates @CHOICE-1; kept for ref stability.) ]
  [in-cx [#
[root 42 [x]]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "root",
      "items": [
        {"type": "Scalar", "dataType": "int", "value": 42},
        {"type": "Element", "name": "x"}
      ]
    }
  ]
}
#]]
  [out-xml [#
<root><cx:int>42</cx:int><x/></root>
#]]
  [out-cx [#
[root 42 [x]]
#]]
 ]

 [case id=012-explicit-type-int level=extended
  [tags scalar explicit type xml]
  [in-cx [#
[age::int 30]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "age",
      "dataType": "int",
      "items": [{"type": "Scalar", "dataType": "int", "value": 30}]
    }
  ]
}
#]]
  [out-xml [#
<age cx:type="int">30</age>
#]]
  [out-cx [#
[age::int 30]
#]]
 ]

 [case id=013-explicit-type-string-overrides level=extended
  [tags scalar explicit type string]
  [in-cx [#
[zip::string 90210]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "zip",
      "dataType": "string",
      "items": [{"type": "Scalar", "dataType": "string", "value": "90210"}]
    }
  ]
}
#]]
  [out-xml [#
<zip cx:type="string">90210</zip>
#]]
