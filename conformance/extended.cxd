 [case id=009-no-autotype-multi-token level=extended
  [tags scalar autotype text]
  [in-cx [#
[p Version 3.0]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "p",
      "items": [{"type": "Text", "value": "Version 3.0"}]
    }
  ]
}
#]]
  [out-xml [#
<p>Version 3.0</p>
#]]
