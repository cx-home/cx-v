[zip::string 90210]
#]]
 ]

 [case id=014-explicit-type-array level=extended
  [tags scalar array type]
  [in-cx [#
[tags::string[] admin user guest]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "tags",
      "dataType": "string[]",
      "items": [
        {"type": "Scalar", "dataType": "string", "value": "admin"},
        {"type": "Scalar", "dataType": "string", "value": "user"},
        {"type": "Scalar", "dataType": "string", "value": "guest"}
      ]
    }
  ]
}
#]]
  [out-xml [#
<tags cx:type="string[]"><item>admin</item><item>user</item><item>guest</item></tags>
#]]
  [out-cx [#
[tags::string[] admin user guest]
#]]
 ]

 [case id=015-explicit-type-int-array level=extended
  [tags scalar array type int]
  [in-cx [#
[scores::int[] 10 20 30]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "scores",
      "dataType": "int[]",
      "items": [
        {"type": "Scalar", "dataType": "int", "value": 10},
        {"type": "Scalar", "dataType": "int", "value": 20},
        {"type": "Scalar", "dataType": "int", "value": 30}
      ]
    }
  ]
}
#]]
  [out-xml [#
<scores cx:type="int[]"><item>10</item><item>20</item><item>30</item></scores>
#]]
  [out-cx [#
[scores::int[] 10 20 30]
#]]
 ]

 [case id=016-scalar-bytes level=extended
  [tags scalar bytes explicit]
  [in-cx [#
[data::bytes SGVsbG8=]
#]]
