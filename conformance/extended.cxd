#]]
 ]

 [case id=037-bool-array level=extended
  [tags array bool type-annotation]
  [in-cx [#
[flags::bool[] true false true]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "flags",
      "dataType": "bool[]",
      "items": [
        {"type": "Scalar", "dataType": "bool", "value": true},
        {"type": "Scalar", "dataType": "bool", "value": false},
        {"type": "Scalar", "dataType": "bool", "value": true}
      ]
    }
  ]
}
#]]
  [out-xml [#
<flags cx:type="bool[]"><item>true</item><item>false</item><item>true</item></flags>
#]]
