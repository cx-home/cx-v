{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "data",
      "dataType": "bytes",
      "items": [{"type": "Scalar", "dataType": "bytes", "value": "SGVsbG8="}]
    }
  ]
}
#]]
  [out-xml [#
<data cx:type="bytes">SGVsbG8=</data>
#]]
