[test-suite name=extended
  [doc [#
# CX Conformance — Extended Tests
# Version: 1.0 — 2026-04-19
# Covers: Scalar (auto-typed and explicit), TypeAnnotation, arrays,
#         Alias, Anchor, Merge, MultiDoc.
#]]

 [case id=001-scalar-int level=extended
  [tags scalar autotype int]
  [in-cx [#
[age 30]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "age",
      "items": [{"type": "Scalar", "dataType": "int", "value": 30}]
    }
  ]
}
#]]
  [out-xml [#
<age>30</age>
#]]
  [out-cx [#
[age 30]
#]]
 ]

 [case id=002-scalar-hex-int level=extended
  [tags scalar autotype int hex]
  [in-cx [#
[flags 0xFF]
#]]
  [out-ast [#
{
  "type": "Document",
  "elements": [
    {
      "type": "Element",
      "name": "flags",
      "items": [{"type": "Scalar", "dataType": "int", "value": 255}]
    }
  ]
}
#]]
  [out-xml [#
<flags>255</flags>
#]]
  [out-cx [#
[flags 255]
#]]
 ]

