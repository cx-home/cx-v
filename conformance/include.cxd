[test-suite name=include ring=0
  [doc [#
# CX Include Resolution Conformance Suite
# Version: 1.0 — 2026-05-18
# [Provenance note, recovered 2026-08-05 (corpus audit n27): the GG1/
#  GG5 labels below came from the retired spec/v0_7_0_status.md
#  worksheet (deleted with the v0.8.0 reshape), and "spec/include.md"
#  was folded away in the spec reorg — the normative contract is now
#  split across core/code.md ("[?cx include]", parse-time splice) and
#  core/cxdm.md (the E901–E911 Include data-parse codes). The labels
#  are kept only because fixture tags carry them.]
#
# Cross-binding byte-identity discipline for the [?cx include]
# resolver. Fixtures use:
#   --- include_root         — sentinel: runner materializes a temp
#                              dir and passes it as the resolver root
#   --- file_<rel/path>      — content for <root>/<rel/path> (created
#                              before the resolver runs)
#   --- in_cx                — the entry-document text
#   --- out_cx               — expected resolved document text
#   --- out_err              — substring of an E9xx parse error code
#
# Status:
#
#   Engine (vcx/cx/include.v):   fully implemented per GG1
#   V regression tests:          15 tests in vcx/tests/include_test.v
#                                cover splice / nested / diamond / E901
#                                / E902 / E903 / E904 / E905 / E906 /
#                                E908 / E911 / XMLDecl discard /
#                                empty-root pass-through / U7 sandbox
#                                (file restored by #421 after collateral
#                                deletion in the phase-7 POC cleanup)
#   CX-level wrapper:            4 tests in vcx/tests/cx_module_test.v
#                                cover DD18 cx:resolve-includes
#   C ABI:                       cx_to_cx_with_include_root +
#                                cx_to_data_bin_with_include_root
#                                exports per GG3
#   conformance fixtures:        inc-001..inc-003 below cover the
#                                no-resolution baseline (no FFI temp-dir
#                                interaction); run by the vcx conform gate
#                                (`make -C vcx conform-include`, wired
#                                into `make conform` per #421 — the suite
#                                had been authored but never wired, so the
#                                gate stayed silently green).
#                                The resolution fixture cases live in
#                                vcx/tests/include_test.v; cross-binding
#                                parity ships when per-binding runners
#                                adopt the `--- include_root` +
#                                `--- file_<path>` section convention
#                                this file documents.
#]]

 [case id=inc-001-empty-root-preserves-directive level=core
  [tags include passthrough GG5]
  [in-cx [#
[?cx include=defaults.cx]
#]]
  [out-cx [#
[?cx include=defaults.cx]
#]]
 ]

 [; #421 regression guards for the wider [?cx ...] PI/config namespace the
    include directive rides on (grammar CXDirective, production 34): with no
    include root supplied, EVERY [?cx ...] directive - include or config - is
    preserved verbatim by the data reading (code.md include semantics:
    resolution is opt-in; CX to CX with resolution disabled preserves
    directives). An unknown key on a [?cx ...] directive is legal CXAttr
    surface (the CXDirective production admits any attr list; the layer that
    consumes each attr is selected by attr name) and rides along untouched. ]

 [case id=inc-002-bare-config-pi-passthrough level=core
  [tags cx-directive config passthrough issue-421]
  [in-cx [#
[?cx version=1.0]
[config [a 1]]
#]]
  [out-cx [#
[?cx version=1.0]
[config
  [a 1]
]
#]]
 ]

 [case id=inc-003-unknown-cx-key-refused level=core
  [tags cx-directive unknown-key fail-closed CXP-1 grammar-34]
  [in-cx [#
[?cx bogus=1]
[config [a 1]]
#]]
  [out-err [#
unknown [?cx] pragma key
#]]
 ]
]
