 [case id=ttp-012-f16-exact-pair level=core
  [tags table transparency repr-pair f16 807 af2-e]
  [meta [#
chunk_at: 2
note: #807 class (e), RE-PINNED to the arc-3 ruling (packet §10,
note: 2026-08-14): a cell that does not round-trip exactly through
note: the declared reduced width REFUSES loudly at encode (never
note: silently approximated — the shortest-round-trip renderer was
note: REJECTED: it masks the approximation behind the original
note: spelling). The refusal is pinned in the width-refusal V family
note: (codecs_formats_umbrella_test.v) beside the Q4a integer
note: contracts; THIS case pins the green half — exactly-representable
note: f16 cells are render-parity across every lane
note: (9.99755859375e-2 IS the f16 value nearest 0.1).
#]]
  [in-cx [#
[t [table[h::f16]]
  9.99755859375e-2
  1.5e0
]
#]]
  [repr-pair [#
1
#]]
  [out-cx [#
[t [table[h::f16]]
  9.99755859375e-2
  1.5e0
]
#]]
  [out-hash [#
sha2-256:988fdfe1272ac919aa07f5ce717a105d304b862d4da7f1b95ffb24d74abe88fa
#]]
 ]

 [case id=ttp-013-mixed-collection-cell-pair level=core
  [tags table transparency repr-pair mixed 0x81 807 af2-c]
  [meta [#
note: plain lane only — the strict 0x63 lane REFUSES collection cells
note: BY DESIGN (route through 0x60). ENFORCED since the remainder
note: landing (arc-2, packet §10, 2026-08-14): the 0x82 declared-name
note: annotation rides the 0x81 escape too, so m::int keeps its
note: declared kind (the honest totality escape keeps the VALUES
note: exact — json projection agrees).
#]]
  [in-cx [#
[t [table[m::int]]
  1
  ['a', 'b']
  3
]
#]]
  [repr-pair [#
plain
#]]
  [out-cx [#
[t [table[m::int]]
  1
  ['a', 'b']
  3
]
#]]
  [out-hash [#
sha2-256:ed4ffcf48c8542b47394262e50412381c01393b2eb556f87c5c74b0a39f7769e
#]]
 ]

 [case id=ttp-020-decode-vector-nullable-int level=core
  [tags table transparency decode-vector nullable 0x80 l89]
  [meta [#
note: §3.10.5 decode vector — 0x80 wrapper, inner 0x13 int64, bitmap
note: 0x02 (row 1 null), packed non-nulls (1, 3). The rendered column
note: type REFINES from the inner code (n::int, never bare n).
#]]
  [in-data-bin-hex [#
43 58 43 6f 6c 01 01 40 00 00 00 00      # CXCol header
50 01 30 01 74                           # map{1} key 't'
60 01 30 01 6e 80                        # 0x60, col 'n' code 0x80
03                                       # 3 rows
13                                       # inner code int64
02                                       # null bitmap: row 1
01 00 00 00 00 00 00 00                  # 1
03 00 00 00 00 00 00 00                  # 3
#]]
  [out-cx [#
[t [table[n::int]]
  1
  null
  3
]
#]]
 ]

 [case id=ttp-021-decode-vector-dictionary-atom level=core
  [tags table transparency decode-vector dictionary atom 0x62 l89]
  [in-data-bin-hex [#
43 58 43 6f 6c 01 01 40 00 00 00 00      # CXCol header
50 01 30 01 74                           # map{1} key 't'
62 01 30 06 73 74 61 74 75 73 70         # 0x62, col 'status' atom
04 01                                    # 4 rows; dict flag
02 30 02 6f 6b 30 03 65 72 72            # 2 distinct: 'ok', 'err'
00 01 00 00                              # row indexes
#]]
  [out-cx [#
[t [table[status::atom]]
  :ok
  :err
  :ok
  :ok
]
#]]
 ]

 [case id=ttp-022-decode-vector-mixed level=core
  [tags table transparency decode-vector mixed 0x81 l89]
  [meta [#
note: §3.10.6 vector — 0x81 per-row tagged; the bytes carry no
note: declared-type name, so the honest render is the untyped column.
#]]
  [in-data-bin-hex [#
43 58 43 6f 6c 01 01 40 00 00 00 00      # CXCol header
50 01 30 01 74                           # map{1} key 't'
60 01 30 01 6d 81                        # 0x60, col 'm' code 0x81
03                                       # 3 rows
10 01                                    # int8 1
40 02 30 01 61 30 01 62                  # array['a','b']
10 03                                    # int8 3
#]]
  [out-cx [#
[t [table[m]]
  1
  ['a', 'b']
  3
]
#]]
 ]

 [case id=ttp-023-corrupt-dictionary-index-refuses level=core
  [tags table transparency decode-vector dictionary negative 0x62 engagement-witness]
  [meta [#
note: the 0x62 NEGATIVE engagement witness — a row index at or past
note: the distinct count refuses loudly, never reads out of range.
#]]
  [in-data-bin-hex [#
43 58 43 6f 6c 01 01 40 00 00 00 00      # CXCol header
50 01 30 01 74                           # map{1} key 't'
62 01 30 06 73 74 61 74 75 73 70         # 0x62, col 'status' atom
04 01                                    # 4 rows; dict flag
02 30 02 6f 6b 30 03 65 72 72            # 2 distinct: 'ok', 'err'
00 01 00 05                              # LAST index 5 >= 2 distinct
#]]
  [expected-decode-error [#
dictionary index 5 out of range (2 distinct)
#]]
 ]
]
