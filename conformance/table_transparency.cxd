 ]

 [case id=ttp-004-atom-dictionary-pair level=core
  [tags table transparency repr-pair dictionary atom 0x62 l89 engagement-witness]
  [meta [#
chunk_at: 2
note: the [out-data-bin-plain-hex] byte pin IS the 0x62 engagement
note: witness — atom columns dictionary-encode BY CONSTRUCTION. The
note: canonical TEXT lane renders atom cells :ok since #794 landed
note: (the #795 batch, RULED 790-1a era) — the wire bytes were always
note: transparent to it (dict values carry the bare names).
#]]
  [in-cx [#
[t [table[status::atom]]
  :ok
  :err
  :ok
  :ok
]
#]]
  [repr-pair [#
1
#]]
  [out-cx [#
[t [table[status::atom]]
  :ok
  :err
  :ok
  :ok
]
#]]
  [out-hash [#
sha2-256:708ddade839b53a504dc24ce990245a1b5321e611cca714cbccd385c69b4a8a1
#]]
  [out-data-bin-plain-hex [#
43 58 43 6f 6c 01 01 40 00 00 00 00   # CXCol header
50 01 30 01 74                        # map{1} key 't'
62 01                                 # 0x62 dict-table, 1 col
30 06 73 74 61 74 75 73 70            # col 'status', code 0x70 atom
04                                    # 4 rows
01                                    # col 0: dict flag 0x01
02 30 02 6f 6b 30 03 65 72 72         # 2 distinct: 'ok', 'err'
00 01 00 00                           # row indexes
#]]
 ]

