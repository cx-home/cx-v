 [case id=ttp-009-header-alias-drift-pair level=core
  [tags table transparency repr-pair 807 af2-c]
  [meta [#
chunk_at: 2
note: #807 class (c), ENFORCED since the remainder landing (arc-2,
note: packet §10, 2026-08-14): the 0x82 col-spec annotation carries
note: the DECLARED spelling when it differs from the code's default
note: render — v::f64 never drifts to v::float, s::string never drops
note: to bare s. Text canonicalization of aliases was REJECTED (it
note: would move every ::f64 document's Tier-1 address and erase the
note: declared-width vocabulary).
#]]
  [in-cx [#
[t [table[v::f64 s::string]]
  1.5e0 x
  2.5e0 y
]
#]]
  [repr-pair [#
1
#]]
  [out-cx [#
[t [table[v::f64 s::string]]
  1.5e0 x
  2.5e0 y
]
#]]
  [out-hash [#
sha2-256:1e8c6aaff7d425b2835b8e1d5c727fadf2030a563ef02a160175fb32a11fdc59
#]]
 ]

 [case id=ttp-010-datetime-offset-render-pair level=core
  [tags table transparency repr-pair datetime offset 807 af2-d]
  [meta [#
chunk_at: 2
note: #807 class (d), ENFORCED since the remainder landing (arc-2,
note: packet §10, 2026-08-14): the §3.6.1 wire form's offset_minutes
note: field now rides the TRANSPORT (unix_nanos stays UTC-normalized)
note: so the +02:00 render survives both binary lanes; the Tier-1
note: hash agreed all along (STRICT canonical normalizes, and strict
note: canonicalization runs through text). ch-007 re-pinned as
note: ch-007-chunked-datetime-offset-rides-transport.
#]]
  [in-cx [#
[t [table[w::datetime]]
  2026-01-01T23:00:00+02:00
  2026-01-02T00:00:00Z
]
#]]
  [repr-pair [#
1
#]]
  [out-cx [#
[t [table[w::datetime]]
  '2026-01-01T23:00:00+02:00'
  '2026-01-02T00:00:00Z'
]
#]]
  [out-hash [#
sha2-256:43cb061ac46a6fd03762957e638a7f1d0b3b6a3785a8328cc8e4cbfe9c03b79e
#]]
 ]

