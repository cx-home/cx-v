[test-suite name=table-transparency ring=0
  [doc [#
# CX Conformance — §9 representation-transparency pair family
# (runtime_representation.md L92; stream 17 W7; the M5 ledger substrate).
#
# THE CONTRACT (L86): representation is transparent — the same table as
# (a) CX text, (b) 0x60 data-bin, (c) 0x63 chunked, (d) Arrow round-trip
# renders identical out-cx, projects identical out-json, and hashes
# identical out-hash. The [repr-pair] section drives lanes (b)+(c) in
# conformance_run.v against the SAME expected sections the direct lane
# (a) uses; lane (d) rides data_bin_arrow_run.v over the same sections
# (it needs libcx_arrow at build time). The chunked lane additionally
# witnesses `from_chunked` NEVER-SERIALIZED: re-encoding the
# chunked-decoded value on the plain lane is byte-identical to the
# direct plain encode (provenance is not a value property).
#
# GATE MODEL: default enforced. The #807 render-parity family (I5
# audit AF-2 classes c/d/e + the 0x81 declared-kind drop) rode here as
# gate=advisory pins until the remainder landed under the packet §10
# arc-2/arc-3 rulings (2026-08-14): declared-name carriage (the 0x82
# col-spec annotation), datetime-offset transport carriage, and the
# f16/f32 exactness refusal (arc-3 — the shortest-round-trip renderer
# was REJECTED as approximation-masking). The advisory→enforced flip
# is EXECUTED: every case in this suite is enforced.
#
# Lane (d) rides [repr-pair-arrow] on the cases whose column types the
# Arrow bridge maps today (int/string/float/bool/date/datetime/bytes +
# nullable via validity bitmaps; the named-table root rides
# ArrowSchema.name both directions since W7). The u*/f16/f32 widths of
# ttp-002 are NOT in the bridge's format map yet — an honest bridge
# limitation, named here rather than silently skipped.
#
# Decode vectors (ttp-020…): [in-data-bin-hex] + [out-cx] with no
# expected error pin the DECODER against hand-blessed §3.10.x bytes,
# independent of the encoder (clean-room witnesses). The corrupt
# dictionary-index vector is the 0x62 negative. The 0x62
# [out-data-bin-plain-hex] pin on ttp-004 is the dictionary encoder's
# engagement witness (atoms dictionary-encode BY CONSTRUCTION — that
# seam cannot go quietly dead while the byte pin holds).
#
# The secret-column force-node negative of §9 lives V-side where
# secrets exist as runtime values: the W3b store-columnar promotion
# negative (vcx/platform) + the cx-035 stdlib refusal row — data
# documents have no secret literal to spell here.
#
# Row-iteration vs column-iteration over one input and the EV-PULL
# effect-count probes over table sources are EVAL-lane rows and live in
# code.cxd (the d22 family + rule=EV-PULL corpus query), same input
# shape as ttp-001.
#]]

 [case id=ttp-001-core-pair level=core
  [tags table transparency repr-pair pair-family l92 689]
  [meta [#
chunk_at: 2
#]]
  [in-cx [#
[t [table[id::int name score::float active::bool]]
  1 alice 1.5e0 true
  2 bob 2.5e0 false
]
#]]
  [repr-pair [#
1
#]]
  [repr-pair-arrow [#
1
#]]
  [out-cx [#
[t [table[id::int name score::float active::bool]]
  1 alice 1.5e0 true
  2 bob 2.5e0 false
]
#]]
  [out-json [#
{
  "t": [
    {
      "id": 1,
      "name": "alice",
      "score": 1.5e0,
      "active": true
    },
    {
      "id": 2,
      "name": "bob",
      "score": 2.5e0,
      "active": false
    }
  ]
}
#]]
  [out-hash [#
sha2-256:290a32c35eb862c90bb0dc0e7da2383bb70e88f055cc286670506069326aa0ff
#]]
 ]

