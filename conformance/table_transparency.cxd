[t [table[n::int]]
  1
  null
  3
]
#]]
  [repr-pair [#
1
#]]
  [repr-pair-arrow [#
1
#]]
  [out-cx [#
[t [table[n::int]]
  1
  null
  3
]
#]]
  [out-json [#
{
  "t": [
    {
      "n": 1
    },
    {
      "n": null
    },
    {
      "n": 3
    }
  ]
}
#]]
  [out-hash [#
sha2-256:1919fbed49b7dc8a9801ce2b74f0ff2b4fd5e2d7f1815d6b54c6246c56d226b7
#]]
 ]

