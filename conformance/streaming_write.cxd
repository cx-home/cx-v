[test-suite name=streaming-write
  [doc [#
# CX Conformance — streaming-write API
# Version: 0.3 — 2026-05-10 (JSON + YAML AST-shape emit, Phase 7.74j)
# Version: 0.2 — 2026-05-10 (XML emit + Tier-1 binding wrappers, Phase 7.74h)
# Version: 0.1 — 2026-05-10 (V core impl landed in Phase 7.74g)
# Covers: spec/streaming.md §6,, spec/abi.md §2.15.
#
# scope (per spec/streaming.md §6.6 ): CX + XML + JSON +
# YAML output formats implemented end-to-end. JSON and YAML use the
# **AST shape** locked in §6.6.1 (every event maps to its canonical
# AST node — same shape as `cx_to_ast_json`). TOML returns W009
# for the entire format (structural mismatch — §6.6.2); adopters use
# the non-streaming `cx_to_toml` surface for that format. (Markdown is
# not a CX format at all — ruling D-B — and has no writer target.)
#
# Negative-validation fixtures (W001-W013) are exhaustive at —
# adopters can rely on the W-code namespace as a stable contract.
#
# Fixture shape:
#   --- events
#       a sequence of newline-separated event statements. Each
#       statement is a single line with one of these forms:
#         StartDoc
#         EndDoc
#         StartElement <name> [anchor=<a>] [data_type=<t>] [merge=<m>]
#         EndElement   <name>
#         Text         "<value>"
#         Scalar       <type>:<value>
#         Comment      "<value>"
#         PI           <target> [data="<value>"]
#         EntityRef    <name>
#         RawText      "<value>"
#         Alias        <name>
#         StartTable   <col_spec_hex>
#         RowGroup     <payload_hex>
#         EndTable
#   --- format
#       cx | xml | json | yaml | toml
#   --- expect_ok
#       expected output bytes (CX text or hex form per format).
#   --- expect_err
#       expected W-code prefix (W001-W013); when present, expect_ok is absent.

# ── Positive: minimal greet doc ───────────────────────────────────────────────
#]]

 [case id=sw-001-cx-minimal level=core
  [tags streaming-write cx happy]
  [format [#
cx
#]]
  [events [#
StartDoc
StartElement greet
Text "hello"
EndElement greet
EndDoc
#]]
  [expect-ok [#
[greet
  hello
]

# ── Positive: minimal XML emit ────────────────────────────────────────────────
#
# Asserts the XML emit lifts out of the W009 stub (Phase 7.74h). Runners
# check `expect_ok_contains` substrings instead of byte-exact match because
# pretty-printing whitespace is not yet pinned for XML.
#]]
 ]

 [case id=sw-001b-xml-minimal level=core
  [tags streaming-write xml happy]
  [format [#
xml
#]]
  [events [#
StartDoc
StartElement greet
Text "hello"
EndElement greet
EndDoc
#]]
  [expect-ok-contains [#
<?xml version="1.0"?>
<greet>
hello
</greet>

# ── Negative: W001 double StartDoc ────────────────────────────────────────────
#]]
 ]

 [case id=sw-002-w001-double-start-doc level=core
  [tags streaming-write w001]
  [format [#
cx
#]]
  [events [#
StartDoc
StartDoc
#]]
  [expect-err [#
W001

# ── Negative: W002 event before StartDoc ──────────────────────────────────────
#]]
 ]

 [case id=sw-003-w002-text-before-start-doc level=core
  [tags streaming-write w002]
  [format [#
cx
#]]
  [events [#
Text "premature"
#]]
  [expect-err [#
W002

# ── Negative: W003 event after EndDoc ─────────────────────────────────────────
#]]
 ]

 [case id=sw-004-w003-text-after-end-doc level=core
  [tags streaming-write w003]
  [format [#
cx
#]]
  [events [#
StartDoc
EndDoc
Text "post"
#]]
  [expect-err [#
W003

# ── Negative: W004 EndDoc with unclosed element ───────────────────────────────
#]]
 ]

 [case id=sw-005-w004-unclosed-element level=core
  [tags streaming-write w004]
  [format [#
cx
#]]
  [events [#
StartDoc
StartElement open
EndDoc
#]]
  [expect-err [#
W004

# ── Negative: W005 EndElement name mismatch ───────────────────────────────────
#]]
 ]

 [case id=sw-006-w005-end-element-mismatch level=core
  [tags streaming-write w005]
  [format [#
cx
#]]
  [events [#
StartDoc
StartElement greet
EndElement farewell
#]]
  [expect-err [#
W005

# ── Negative: W006 EndElement without StartElement ────────────────────────────
#]]
 ]

 [case id=sw-007-w006-orphan-end-element level=core
  [tags streaming-write w006]
  [format [#
cx
#]]
  [events [#
StartDoc
EndElement orphan
#]]
  [expect-err [#
W006

# ── Negative: W008 invalid data_type on Scalar ────────────────────────────────
#]]
 ]

 [case id=sw-008-w008-invalid-data-type level=core
  [tags streaming-write w008]
  [format [#
cx
#]]
  [events [#
StartDoc
Scalar not_a_type:42
#]]
  [expect-err [#
W008

# ── Negative: W009 chunked-table on json ──────────────────────────────────────
#
# Phase 7.74j: JSON's StartDoc now emits the AST Document opener
# (`{"type":"Document","elements":[`); the chunked-table-on-non-cx
# rejection still fires at the first StartTable emit. Per §6.6.2 this
# rejection is normative and stays W009 indefinitely — CXCol is the
# canonical hashable origin for tabular data; non-CX formats reach
# tabular data via the analytics-bridge, not through document-format
# projection.
#]]
 ]

 [case id=sw-009-w009-chunked-on-json level=core
  [tags streaming-write w009 chunked]
  [format [#
json
#]]
  [events [#
StartDoc
StartTable 01000000010000007812
#]]
  [expect-err [#
W009

# ── Negative: W012 RowGroup without StartTable ────────────────────────────────
#]]
 ]

 [case id=sw-010-w012-orphan-row-group level=core
  [tags streaming-write w012]
  [format [#
cx
#]]
  [events [#
StartDoc
RowGroup 01
#]]
  [expect-err [#
W012

# ── Negative: W013 EndTable without StartTable ────────────────────────────────
#]]
 ]

 [case id=sw-011-w013-orphan-end-table level=core
  [tags streaming-write w013]
  [format [#
cx
#]]
  [events [#
StartDoc
EndTable
#]]
  [expect-err [#
W013

# Note: W007 (invalid event field) and W010 (nested StartTable) are
# covered by the V core test suite; cross-binding fixture coverage
# lands when the per-binding wrappers ship (Python / Go EventWriter
# in the next phase).
#
# W011 (shape engine not yet implemented) is open-time only — covered
# by the V core test, no event fixture needed.

# ── Positive: minimal JSON AST emit (Phase 7.74j) ─────────────────────────────
#
# Per spec/streaming.md §6.6.1, JSON streaming-write produces the
# canonical AST shape (same as `cx_to_ast_json`). Compact (no
# pretty-print) so output is byte-deterministic across bindings.
# "items":[] is always emitted per §6.6.1 to keep the writer
# stream-local without per-element lookahead.
#]]
 ]

 [case id=sw-012-json-minimal level=core
  [tags streaming-write json happy ast-shape]
  [format [#
json
#]]
  [events [#
StartDoc
StartElement greet
Text "hello"
EndElement greet
EndDoc
#]]
  [expect-ok [#
{"type":"Document","elements":[{"type":"Element","name":"greet","items":[{"type":"Text","value":"hello"}]}]}

# ── Positive: JSON AST emit with attrs + nested elements ──────────────────────
#]]
 ]

 [case id=sw-013-json-attrs-nested level=core
  [tags streaming-write json happy ast-shape attrs]
  [format [#
json
#]]
  [events [#
StartDoc
StartElement greet
StartElement msg
Text "world"
EndElement msg
EndElement greet
EndDoc
#]]
  [expect-ok [#
{"type":"Document","elements":[{"type":"Element","name":"greet","items":[{"type":"Element","name":"msg","items":[{"type":"Text","value":"world"}]}]}]}

# ── Positive: JSON AST emit preserves Comment (Phase 7.74j §6.6.1) ────────────
#
# Per §6.6, Comment is lifted from W009 to "AST Comment" in JSON
# because the AST shape carries Comments losslessly.
#]]
 ]

 [case id=sw-014-json-comment-preserved level=core
  [tags streaming-write json happy comment]
  [format [#
json
#]]
  [events [#
StartDoc
Comment " note "
StartElement x
EndElement x
EndDoc
#]]
  [expect-ok [#
{"type":"Document","elements":[{"type":"Comment","value":" note "},{"type":"Element","name":"x","items":[]}]}

# ── Positive: minimal YAML AST emit (Phase 7.74j) ─────────────────────────────
#
# YAML AST shape mirrors JSON AST shape in YAML syntax. Always-quoted
# string values keep the emit byte-deterministic; adopters who want
# unquoted/idiomatic YAML use the non-streaming `cx_to_yaml` surface.
# Substring match (expect_ok_contains) — full YAML byte form may
# vary on trailing-newline / empty-items handling and is not pinned
# normatively in.
#]]
 ]

 [case id=sw-015-yaml-minimal level=core
  [tags streaming-write yaml happy ast-shape]
  [format [#
yaml
#]]
  [events [#
StartDoc
StartElement greet
Text "hello"
EndElement greet
EndDoc
#]]
  [expect-ok-contains [#
type: Document
elements:
  - type: Element
    name: "greet"
    items:
      - type: Text
        value: "hello"

# ── Negative: W009 for TOML output (structural mismatch per §6.6.2) ───────────
#]]
 ]

 [case id=sw-016-w009-toml-structural-mismatch level=core
  [tags streaming-write w009 toml]
  [format [#
toml
#]]
  [events [#
StartDoc
#]]
  [expect-err [#
W009

# ── Wiring: in-memory writer round-trip via cx_events_writer_* ────────────────
#
# Runners that consume this file should:
#   1. Open a writer via cx_events_writer_open(format).
#   2. Iterate the `events` block, calling the matching emit symbol per
#      line (start_doc / end_doc / start_element_with_len / etc.).
#   3. On `expect_err`: assert the next emit returns a non-NULL diagnostic
#      whose return-value text starts with the expected W-code.
#   4. On `expect_ok`: assert close_get_bytes() returns exactly the
#      declared bytes (or a format-equivalent canonical form for non-cx
#      formats — equivalence rules to be specified when those formats
#      ship).
#]]
 ]
]
