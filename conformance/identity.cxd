[test-suite name=identity ring=0
  [doc [#
# CX Conformance — ID/IDREF tests
# Version: 1.0 — 2026-05-08
# Covers: spec/core/cxdm.md "Identity (ID / IDREF)" (ID declarations,
#         attribute-value references, CXPath [#id] predicate,
#         round-trip).
#
# [Provenance note, recovered 2026-08-05 (corpus audit D-ID / n27):
#  this header originally cited a spec/decisions/ ADR; ADRs are
#  retired — the normative home is cxdm.md's Identity section, and the
#  D1/D3/D6/D7 labels below are that retired decision's item numbers,
#  kept because the corpus audit's D-ID gap row uses them.]
#
# v0 scope (per cxdm.md "Identity"): document-scope only. Claim state
# re-verified against the shipped engine 2026-08-20 (#709) — the four
# labels are the retired decision's item numbers, kept because the
# corpus audit's D-ID gap row uses them:
#
#   D7 canonical-form ID renaming — SHIPPED. Strict canonical rewrites
#     IDs to deterministic `id-N`, depth-first in source order
#     (canonical.md "Strict canonical" / §2.7b, stream 12).
#   D1 [ref @id] body-position node form — SHIPPED as syntax. It parses
#     and round-trips: [root [user #ada] [post [ref @ada]]] survives
#     CX → CX intact (probe-verified). What is NOT shipped is
#     RESOLUTION — the reader carries the reference, it does not
#     dereference it; that half stays open.
#   D6 cross-format ID round-trip — PARTIAL, and the split is the
#     lossless flag: default JSON keeps an @ref's VALUE but drops the
#     #id declaration (probe: one 'ada' survives, the declaration is
#     gone); --lossless keeps both. So the mapping exists on the
#     lossless lane only; the default lossy projections still lose the
#     declaration side.
#   D3 include-time ID merging — genuinely open, unchanged.
#
# Verification: parse `in_cx`, re-emit through emit_cx, compare
# against `out_cx`. Mismatch on parse OR mismatch on round-trip
# fails.
#]]

 [case id=id-001-declaration-only level=core
  [tags identity declaration]
  [in-cx [#
[user #u-1 name=alice]
#]]
  [out-cx [#
[user #u-1 name=alice]
#]]
 ]

 [case id=id-002-declaration-with-anchor level=core
  [tags identity declaration anchor]
  [in-cx [#
[item &a #u-1 v=42]
#]]
  [out-cx [#
[item &a #u-1 v=42]
#]]
 ]

 [case id=id-003-attribute-value-reference level=core
  [tags identity reference]
  [in-cx [#
[users
  [user #u-1 name=alice]
  [reviewer assigned-to=@u-1]
]
#]]
  [out-cx [#
[users
  [user #u-1 name=alice]
  [reviewer assigned-to=@u-1]
]
#]]
 ]

 [case id=id-004-forward-reference-resolves level=core
  [tags identity reference forward]
  [in-cx [#
[users
  [reviewer assigned-to=@u-1]
  [user #u-1 name=alice]
]
#]]
  [out-cx [#
[users
  [reviewer assigned-to=@u-1]
  [user #u-1 name=alice]
]
#]]
 ]

 [case id=id-005-quoted-at-literal-round-trips level=core
  [tags identity reference quoting]
  [in-cx [#
[item label='@literal']
#]]
  [out-cx [#
[item label='@literal']
#]]
 ]

 [case id=id-006-multiple-ids-no-collision level=core
  [tags identity declaration]
  [in-cx [#
[a #x v=1]
[b #y v=2]
[c #z v=3]
#]]
  [out-cx [#
[a #x v=1]
[b #y v=2]
[c #z v=3]
#]]
 ]

 [case id=id-007-ref-in-nested-element level=core
  [tags identity reference nested]
  [in-cx [#
[doc
  [users
    [user #u-1 name=alice]
  ]
  [reviews
    [review target=@u-1 score=5]
  ]
]
#]]
  [out-cx [#
[doc
  [users
    [user #u-1 name=alice]
  ]
  [reviews
    [review target=@u-1 score=5]
  ]
]
#]]
 ]

 [case id=id-008-id-with-hyphens-and-digits level=core
  [tags identity declaration charset]
  [in-cx [#
[user #user-42 name=alice]
[reviewer assigned-to=@user-42]
#]]
  [out-cx [#
[user #user-42 name=alice]
[reviewer assigned-to=@user-42]
#]]
 ]

 [case id=id-009-multiple-refs-to-same-id level=core
  [tags identity reference multiple]
  [in-cx [#
[users
  [user #u-1 name=alice]
  [reviewer assigned-to=@u-1]
  [approver checked-by=@u-1]
]
#]]
  [out-cx [#
[users
  [user #u-1 name=alice]
  [reviewer assigned-to=@u-1]
  [approver checked-by=@u-1]
]
#]]
 ]

 [case id=id-010-xml-emit-id-as-xml-id level=core
  [tags identity xml roundtrip]
  [in-cx [#
[user #u-1 name=alice]
#]]
  [out-xml [#
<user xml:id="u-1" name="alice"/>
#]]
 ]

 [case id=id-011-xml-parse-xml-id-to-hash level=core
  [tags identity xml roundtrip]
  [in-xml [#
<user xml:id="u-1" name="alice"/>
#]]
  [out-cx [#
[user #u-1 name=alice]
#]]
 ]

 [case id=id-012-xml-emit-ref-as-plain-attr level=core
  [tags identity reference xml]
  [in-cx [#
[users [user #u-1 name=alice] [reviewer assigned-to=@u-1]]
#]]
  [out-xml [#
<users>
  <user xml:id="u-1" name="alice"/>
  <reviewer assigned-to="u-1"/>
</users>
#]]
 ]

 [case id=id-013-xml-parse-marks-matching-attr-as-ref level=core
  [tags identity reference xml]
  [in-xml [#
<users>
  <user xml:id="u-1" name="alice"/>
  <reviewer assigned-to="u-1"/>
</users>
#]]
  [out-cx [#
[users
  [user #u-1 name=alice]
  [reviewer assigned-to=@u-1]
]
#]]
 ]

 [case id=id-014-xml-roundtrip-nested-ids-and-refs level=core
  [tags identity xml nested roundtrip]
  [in-cx [#
[doc
  [users
    [user #u-1 name=alice]
    [user #u-2 name=bob]
  ]
  [reviews
    [review target=@u-1 score=5]
    [review target=@u-2 score=4]
  ]
]
#]]
  [out-xml [#
<doc>
  <users>
    <user xml:id="u-1" name="alice"/>
    <user xml:id="u-2" name="bob"/>
  </users>
  <reviews>
    <review target="u-1" score="5"/>
    <review target="u-2" score="4"/>
  </reviews>
</doc>
#]]
 ]

 [case id=id-015-canonical-renames-in-document-order level=core
  [tags identity canonical]
  [in-cx [#
[users
  [user #alice name=Alice]
  [user #bob name=Bob]
  [reviewer assigned-to=@alice]
  [reviewer assigned-to=@bob]
]
#]]
  [out-canonical [#
[users
  [user #id-1 name=Alice]
  [user #id-2 name=Bob]
  [reviewer assigned-to=@id-1]
  [reviewer assigned-to=@id-2]
]
#]]
 ]

 [case id=id-016-canonical-spelling-independent-hash level=core
  [tags identity canonical]
  [in-cx [#
[users
  [user #zzz name=Alice]
  [user #aaa name=Bob]
  [reviewer assigned-to=@zzz]
  [reviewer assigned-to=@aaa]
]
#]]
  [out-canonical [#
[users
  [user #id-1 name=Alice]
  [user #id-2 name=Bob]
  [reviewer assigned-to=@id-1]
  [reviewer assigned-to=@id-2]
]
#]]
 ]

 [case id=id-017-canonical-forward-reference-renamed level=core
  [tags identity canonical forward]
  [in-cx [#
[doc
  [pointer to=@target]
  [thing #target value=42]
]
#]]
  [out-canonical [#
[doc
  [pointer to=@id-1]
  [thing #id-1 value=42]
]
#]]
 ]

 [case id=id-018-body-position-ref-round-trips level=core
  [tags identity reference body-position]
  [in-cx [#
[doc
  [thing #t-1 v=42]
  [para See [ref @t-1] for details.]
]
#]]
  [out-cx [#
[doc
  [thing #t-1 v=42]
  [para 'See ' [ref @t-1] ' for details.']
]
#]]
 ]

 [case id=id-019-body-position-ref-canonical-rename level=core
  [tags identity reference body-position canonical]
  [in-cx [#
[doc
  [thing #target v=42]
  [para See [ref @target] for details.]
]
#]]
  [out-canonical [#
[doc
  [thing #id-1 v=42]
  [para 'See ' [ref @id-1] ' for details.']
]
#]]
 ]

 [case id=id-020-body-position-ref-non-conforming-rejected level=core
  [tags identity reference body-position strict-reservation GG12]
  [in-cx [#
[doc [ref note=hi]]
#]]
  [out-err [#
E207
#]]
 ]

 [case id=id-021-body-ref-xml-emits-cx-body-ref-attribute level=core
  [tags identity reference body-position xml round-trip]
  [in-cx [#
[doc
  [section #s-1
    [title Intro]
  ]
  [para See [ref @s-1] for context.]
]
#]]
  [out-xml [#
<doc>
  <section xml:id="s-1">
    <title>Intro</title>
  </section>
  <para>See <ref cx:body-ref="s-1"/> for context.</para>
</doc>
#]]
 ]

 [case id=id-022-body-ref-xml-import-reconstructs-body-position-form level=core
  [tags identity reference body-position xml import]
  [in-xml [#
<doc>
  <section xml:id="s-1">
    <title>Intro</title>
  </section>
  <para>See <ref cx:body-ref="s-1"/> for context.</para>
</doc>
#]]
  [out-cx [#
[doc
  [section #s-1
    [title Intro]
  ]
  [para 'See ' [ref @s-1] ' for context.']
]
#]]
 ]

 [case id=id-023-body-ref-json-semantic-emit level=extended
  [tags identity reference body-position json semantic]
  [in-cx [#
[doc [section #s-1 [title T]] [para [ref @s-1]]]
#]]
  [out-json [#
{
  "doc": {
    "section": {
      "title": "T"
    },
    "para": {
      "ref": {
        "$ref": "s-1"
      }
    }
  }
}
#]]
 ]

 [; ── #82 Tier-1 identity: type-driven order-semantics ──────────────────
    Strict canonical = Tier-1 content-address (canonical.md §1.4 / §1.2).
    Unordered constructs (map keys) normalize → collide; ordered constructs
    (sequences, arrays, element attributes) preserve → stay distinct;
    presentation (comments) is stripped → collides. out_canonical equality
    IS Tier-1 hash equality (hash = SHA-256 of these bytes). The hash-level
    collision/non-collision is additionally proven in
    vcx/tests/identity_tier1_order_semantics_test.v. ;]

 [case id=id-024-map-key-order-normalized-a level=core
  [tags identity canonical order-semantics map]
  [in-cx [#
[rec {b: 2, a: 1}]
#]]
  [out-canonical [#
[rec {a: 1, b: 2}]
#]]
 ]

 [case id=id-025-map-key-order-normalized-b level=core
  [tags identity canonical order-semantics map]
  [in-cx [#
[rec {a: 1, b: 2}]
#]]
  [out-canonical [#
[rec {a: 1, b: 2}]
#]]
 ]

 [case id=id-026-sequence-order-preserved-a level=core
  [tags identity canonical order-semantics sequence]
  [in-cx [#
[r (2, 1)]
#]]
  [out-canonical [#
[r (2, 1)]
#]]
 ]

 [case id=id-027-sequence-order-preserved-b level=core
  [tags identity canonical order-semantics sequence]
  [in-cx [#
[r (1, 2)]
#]]
  [out-canonical [#
[r (1, 2)]
#]]
 ]

 [case id=id-028-array-order-preserved level=core
  [tags identity canonical order-semantics array]
  [in-cx [#
[r::int [3, 1, 2]]
#]]
  [out-canonical [#
[r::int [3, 1, 2]]
#]]
 ]

 [case id=id-029-attr-order-preserved-a level=core
  [tags identity canonical order-semantics attribute]
  [in-cx [#
[rec b=2 a=1]
#]]
  [out-canonical [#
[rec b=2 a=1]
#]]
 ]

 [case id=id-030-attr-order-preserved-b level=core
  [tags identity canonical order-semantics attribute]
  [in-cx [#
[rec a=1 b=2]
#]]
  [out-canonical [#
[rec a=1 b=2]
#]]
 ]

 [case id=id-031-comment-stripped-from-identity level=core
  [tags identity canonical order-semantics comment]
  [in-cx [#
[; identity ignores comments ;]
[rec a=1]
#]]
  [out-canonical [#
[rec a=1]
#]]
 ]

 [case id=id-032-anchor-stripped-from-identity level=core
  [tags identity canonical anchor]
  [in-cx [#
[item &a v=42]
#]]
  [out-canonical [#
[item v=42]
#]]
 ]

 [case id=id-033-alias-expands-to-anchored-content level=core
  [tags identity canonical anchor alias]
  [in-cx [#
[root [defaults &def timeout=30 retries=3] [*def]]
#]]
  [out-canonical [#
[root
  [defaults timeout=30 retries=3]
  [defaults timeout=30 retries=3]
]
#]]
 ]

 [case id=id-034-alias-equivalent-to-inline level=core
  [tags identity canonical anchor alias]
  [in-cx [#
[root [defaults timeout=30 retries=3] [defaults timeout=30 retries=3]]
#]]
  [out-canonical [#
[root
  [defaults timeout=30 retries=3]
  [defaults timeout=30 retries=3]
]
#]]
 ]

 [case id=id-035-merge-inlines-with-host-override level=core
  [tags identity canonical anchor merge]
  [in-cx [#
[root [defaults &def timeout=30 retries=3] [production *def host=prod retries=5]]
#]]
  [out-canonical [#
[root
  [defaults timeout=30 retries=3]
  [production timeout=30 retries=5 host=prod]
]
#]]
 ]

 [case id=id-036-merge-equivalent-to-inline level=core
  [tags identity canonical anchor merge]
  [in-cx [#
[root [defaults timeout=30 retries=3] [production timeout=30 retries=5 host=prod]]
#]]
  [out-canonical [#
[root
  [defaults timeout=30 retries=3]
  [production timeout=30 retries=5 host=prod]
]
#]]
 ]
]
