## Fixtures (tree — Tree View JSON)

Tree fixtures use `view: tree`. Each `:expected` is a JSON object
conforming to the tree-node contract (every node has `{kind, loc}`;
optional `name` / `value` / `children` per the optional-field
rules). The runner validates: tree shape, kind discriminator,
`loc.start < loc.end`, and `loc` offsets resolve to substrings of
`source`.
#]]
 ]

 [case id=tree-001-element-kind
  [tags tree element basic]
  [meta [#
view: tree
kind: data
#]]
  [source [#
[user]
#]]
  [expected [#
{"kind":"element","name":"user","loc":{"start":0,"end":6}}
#]]
 ]

 [case id=tree-002-attribute-kind
  [tags tree attribute scalar-value]
  [meta [#
view: tree
kind: data
#]]
  [source [#
[user id=1]
#]]
  [expected [#
{
  "kind": "element",
  "name": "user",
  "loc": {"start": 0, "end": 11},
  "children": [
    {"kind": "attribute", "name": "id", "value": 1,
     "loc": {"start": 6, "end": 10}}
  ]
}
#]]
 ]

 [case id=tree-003-text-kind
  [tags tree text leaf]
  [meta [#
view: tree
kind: data
#]]
  [source [#
[name 'alice']
#]]
  [expected [#
{
  "kind": "element",
  "name": "name",
  "loc": {"start": 0, "end": 14},
  "children": [
    {"kind": "text", "value": "alice",
     "loc": {"start": 6, "end": 13}}
  ]
}
#]]
 ]

 [case id=tree-004-directive-kind
  [tags tree directive code]
  [meta [#
view: tree
kind: code
#]]
  [source [#
[?for [in $x /a] [yield $x]]
#]]
  [expected [#
{
  "kind": "directive",
  "name": "for",
  "loc": {"start": 0, "end": 28}
}
#]]
 ]

 [case id=tree-005-scalar-kind
  [tags tree scalar bare]
  [meta [#
view: tree
kind: data
#]]
  [source [#
42
#]]
  [expected [#
{
  "kind": "scalar",
  "value": 42,
  "loc": {"start": 0, "end": 2}
}
#]]
 ]

 [case id=tree-006-path-kind
  [tags tree path cxpath]
  [meta [#
view: tree
kind: code
#]]
  [source [#
/users/user
#]]
  [expected [#
{
  "kind": "path",
  "value": "/users/user",
  "loc": {"start": 0, "end": 11}
}

