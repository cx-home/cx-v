#]]
 ]

 [case id=full-data-erd-document-root level=full
  [tags full erd document-root occurrence-badge value-enumeration]
  [meta [#
view: graph
kind: data
#]]
  [source [#
[users [user id=1]]
#]]
  [expected [#
erDiagram
  DOCUMENT {
    int node_count
    int type_count
    int max_depth
    string source_path
  }
  users ||--|| user : has
  users {
    string note "appears 1× depth 0"
  }
