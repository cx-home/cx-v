#]]
  [expected [#
flowchart TD
  input([INPUT])
  output([OUTPUT])
  start([entry])
  done([exit])
  lh{{"for $x :in //xs/x"}}
  lb["$x"]
  lh -- "binds $x" --> lb
  lb --> lh
  start --> lh
  lh --> done
  input --> start
  done --> output
  y1["yield #1"]
  lh --> y1
  b_x((("$x")))
  b_x -. "resolves" .-> lb
#]]
 ]

