  m -- "2" --> a2["'tue'"]
  m -- "3" --> a3["'wed'"]
  m -- "4" --> a4["'thu'"]
  m -- "5" --> a5["'fri'"]
  m -- "6" --> a6["'sat'"]
  m -- "7" --> a7["'sun'"]
  m -- "else" --> a8["'unknown'"]
