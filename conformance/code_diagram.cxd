## Fixtures (seq — sequence-shape code source SEQ mode)
#]]
 ]

 [case id=seq-001-worker-basic
  [tags seq worker activation]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?worker name="task" [ok value="done"]]
#]]
  [expected [#
sequenceDiagram
  participant task
#]]
 ]

 [case id=seq-002-worker-channel-pair
  [tags seq worker channel send receive]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?let [= $ch [?channel name="jobs" buffer=4]] [?let [= $_ [?worker name="producer" [?send 1 to=$ch]]] [?worker name="consumer" [?receive from=$ch]]]]
#]]
  [expected [#
sequenceDiagram
  participant jobs
  participant producer
  participant consumer
  producer ->>+ jobs : 1
  jobs -->>- consumer : msg
#]]
 ]

 [case id=seq-003-http-service
  [tags seq http-service resource client]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?http-service name="hello" :on http [resource [get "/"] [response status=200 [body "hi"]]]]
#]]
  [expected [#
sequenceDiagram
  participant hello
  participant client
  client ->>+ hello : GET /
  hello -->>- client : response
#]]
 ]

 [case id=seq-004-select-alt
  [tags seq select alt timeout]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?let [= $ch1 [?channel name="a" buffer=1]] [?select [case [from $ch1 $v] [ok value=$v]] [case [timeout 50ms] [err code="timeout"]]]]
#]]
  [expected [#
sequenceDiagram
  participant a
  participant main
  alt msg from a
    a ->> main : msg
  else timeout (50ms)
    main ->> main : timeout (50ms)
  end
#]]
 ]

 [case id=seq-005-multiple-receivers-same-channel
  [tags seq activation channel-fan-out safety]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?let [= $ch [?channel name="ch" buffer=2]] [?let [= $_a [?worker name="wa" [?let [= $m [?receive from=$ch]] [ok value=$m]]]] [?worker name="wb" [?let [= $m [?receive from=$ch]] [ok value=$m]]]]]
#]]
  [expected [#
sequenceDiagram
  participant ch
  participant wa
  participant wb
  activate wa
  ch -->> wa : msg
  Note over wa : [ok]
  deactivate wa
  activate wb
  ch -->> wb : msg
  Note over wb : [ok]
  deactivate wb

