[?def greet ($name) [concat "hi " $name]]
[?def main () [greet "world"]]
#]]
  [expected [#
flowchart TD
  input([INPUT])
  output([OUTPUT])
  subgraph greet
    gs[/"def greet"/]
    ge([exit])
    gb["[concat 'hi ' $name]"]
  end
  subgraph main
    ms[/"def main"/]
    me([exit])
    mb["[greet 'world']"]
  end
  gs --> gb
  gb --> ge
  ms --> mb
  mb --> me
  ms -. "call" .-> gs
#]]
 ]

