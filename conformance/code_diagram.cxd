  a3 --> done
  a4 --> done
  a5 --> done
  a6 --> done
  a7 --> done
  a8 --> done
#]]
 ]

 [case id=cfg-006-for-containing-if
  [tags cfg for if nested]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?for [in $u /users/user]
  [yield [?if $u@active [then $u] [else 'skip']]]
]
#]]
  [expected [#
flowchart TD
  start([entry]) --> lh{{"for $u :in /users/user"}}
  lh -- "binds $u" --> i{"if $u@active"}
  i -- "true" --> t["$u"]
  i -- "false" --> e["'skip'"]
  t --> lh
  e --> lh
  lh --> done([exit])
#]]
 ]

 [case id=cfg-007-def-simple-body
  [tags cfg def subgraph]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?def greet ($name) [concat 'hello ' $name]]
#]]
  [expected [#
flowchart TD
  subgraph greet
    gs[/"def greet"/]
    ge([exit])
    gb["[concat 'hello ' $name]"]
  gs --> gb
  gb --> ge
  end
#]]
 ]

 [case id=cfg-008-def-recursion
  [tags cfg def recursion self-edge]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?def countdown ($n) [?if [= $n 0] [then 'done'] [else [countdown [- $n 1]]]]]
#]]
  [expected [#
flowchart TD
  subgraph countdown
    cs[/"def countdown"/]
    ce([exit])
  ci{"if [= $n 0]"}
  ct["'done'"]
  ci -- "true" --> ct
  ct --> ce
  cr["[countdown [- $n 1]]"]
  ci -- "false" --> cr
  cr --> cs
  cs --> ci
  end
#]]
 ]

 [case id=cfg-009-modify-three-actions
  [tags cfg modify update-block]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?modify /users/user[1]
  [set-attr status 'active']
  [delete-attr temp]
  [append [tag 'vip']]
]
#]]
  [expected [#
flowchart TD
  start([entry]) --> u["modify @ /users/user[1] | set | delete | append"]
  u --> done([exit])
#]]
 ]

 [case id=cfg-010-mixed-def-and-main
  [tags cfg def main two-subgraphs]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?def classify ($age) [?match $age [case 13 'teen'] [else 'adult']]]
[?for [in $u (1, 2, 3)] [yield [classify $u]]]
#]]
  [expected [#
flowchart TD
  subgraph classify
    cs[/"def classify"/]
    ce([exit])
  cm{"match $age"}
  ct1["'teen'"]
  cm -- "13" --> ct1
  ct1 --> ce
  ct2["'adult'"]
  cm -- "else" --> ct2
  ct2 --> ce
  cs --> cm
  end
  start([entry])
  done([exit])
  lh{{"for $u :in <lit>"}}
  lb["[classify $u]"]
  lb --> lh
  lh -- "binds $u" --> lb
  start --> lh
  lh --> done

