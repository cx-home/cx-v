## Fixtures (cfg — code-source CFG mode)
#]]
 ]

 [case id=cfg-001-bare-for
  [tags cfg for loop-box]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?for [in $u /users/user] [yield $u]]
#]]
  [expected [#
flowchart TD
  start([entry]) --> lh{{"for $u :in /users/user"}}
  lh -- "binds $u" --> lb["$u"]
  lb --> lh
  lh --> done([exit])
#]]
 ]

 [case id=cfg-002-if-then-else
  [tags cfg if diamond]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?if $x [then 'big'] [else 'small']]
#]]
  [expected [#
flowchart TD
  start([entry]) --> i{"if $x"}
  i -- "true" --> t["'big'"]
  i -- "false" --> e["'small'"]
  t --> done([exit])
  e --> done
#]]
 ]

 [case id=cfg-003-match-two-arms
  [tags cfg match dispatcher 2-arm]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?match $x
  [case 1 'one']
  [else  'other']
]
#]]
  [expected [#
flowchart TD
  start([entry]) --> m{"match $x"}
  m -- "1" --> a1["'one'"]
  m -- "else" --> a2["'other'"]
  a1 --> done([exit])
  a2 --> done
#]]
 ]

 [case id=cfg-004-match-three-arms
  [tags cfg match dispatcher 3-arm]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?match $age
  [case '< 13' 'child']
  [case '< 18' 'teen']
  [else        'adult']
]
#]]
  [expected [#
flowchart TD
  start([entry]) --> m{"match $age"}
  m -- "< 13" --> a1["'child'"]
  m -- "< 18" --> a2["'teen'"]
  m -- "else" --> a3["'adult'"]
  a1 --> done([exit])
  a2 --> done
  a3 --> done
#]]
 ]

 [case id=cfg-005-match-eight-arms
  [tags cfg match dispatcher 8-arm]
  [meta [#
view: graph
kind: code
#]]
