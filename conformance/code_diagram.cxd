#]]
  [expected [#
flowchart TD
  input([INPUT])
  output([OUTPUT])
  start([entry])
  done([exit])
  i{"if true"}
  t["1"]
  e["0"]
  i -- "true" --> t
  t --> done
  i -- "false" --> e
  e --> done
  start --> i
  input --> start
  done --> output
#]]
 ]

 [case id=full-code-cfg-yield-enumeration level=full
