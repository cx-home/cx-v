 [case id=full-code-cfg-terminals level=full
  [tags full cfg input-output yield-enum binding-bridge]
  [meta [#
view: graph
kind: code
#]]
  [source [#
[?for [in $u /users/user] [yield $u]]
#]]
  [expected [#
flowchart TD
  input([INPUT])
  output([OUTPUT])
  start([entry])
  done([exit])
  lh{{"for $u :in //users/user"}}
  lb["$u"]
  lh -- "binds $u" --> lb
  lb --> lh
  start --> lh
  lh --> done
  input --> start
  done --> output
  y1["yield #1"]
  lh --> y1
  b_u((("$u")))
  b_u -. "resolves" .-> lb
#]]
 ]

